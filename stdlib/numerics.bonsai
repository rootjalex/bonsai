element Float = f32;
element Half = f16;
element vec2f = vector[Float, 2];
element vec3f = vector[Float, 3];
element vec4f = vector[Float, 4];
element vec3h = vector[Half, 3];

func sqlen<F : IFloat>(v : vector[F, 3]) -> F = sum(v * v);

func prod_diff<F : IFloat>(a : F, b : F, c : F, d : F) -> F {
    cd = c * d;
    diff = fma(a, b, -cd);
    err = fma(-c, d, cd);
    return diff + err;
}

// A scalar times a vector, added to a vector, fused per component. This is what
// a C++ compiler with contraction on makes of `a * b + c` where b and c are
// vectors, and pbrt writes several of those.
func fma3(a : Float, b : vec3f, c : vec3f) -> vec3f =
    fma(vec3f{a, a, a}, b, c);

// The same difference of products with vectors in the second and fourth
// places, which is how a triangle's partial derivatives are written: two scalar
// weights against two edge vectors, and the cancellation the fma protects
// against is per component.
func prod_diff3(a : Float, b : vec3f, c : Float, d : vec3f) -> vec3f {
    cd = c * d;
    diff = fma(vec3f{a, a, a}, b, -cd);
    err = fma(vec3f{-c, -c, -c}, d, cd);
    return diff + err;
}

// The dot product, its square and the normalization built on them, as a C++
// compiler with contraction on computes them.
//
// `x*a + y*b + z*c` is three multiplies and two adds as written, and a compiler
// with contraction on turns each add together with a multiply feeding it into
// one fused multiply-add, which rounds once where the pair rounds twice. Which
// multiply gets fused into which add is what has to be reproduced, and the rule
// is: in `p*q + r*s` the first product is fused and the second is the addend.
// So `(x*a + y*b) + z*c` becomes `fma(z, c, fma(x, a, y*b))` -- checked against
// pbrt's own answers by `apps/pbrt/scene_dump --print-shading` rather than
// reasoned about, because the alternative groupings differ in the last bit and
// a last bit is the whole difference between reproducing something and merely
// resembling it.
//
// The `dot` intrinsic fuses nothing. Use these where the answer has to be a
// particular compiler's answer, and `dot` where it only has to be right.
func dot_(a : vec3f, b : vec3f) -> Float =
    fma(a.z, b.z, fma(a.x, b.x, a.y * b.y));

func sqlen_(v : vec3f) -> Float = dot_(v, v);

func unit_vector_(v : vec3f) -> vec3f = v / sqrt(sqlen_(v));

// TODO(ajr): need nested generics for generic here.
func cross_(v0 : vec3f, v1 : vec3f) -> vec3f {
    return {prod_diff[[Float]](v0.y, v1.z, v0.z, v1.y), prod_diff[[Float]](v0.z, v1.x, v0.x, v1.z), prod_diff[[Float]](v0.x, v1.y, v0.y, v1.x)};
}

// The standard bound on the accumulated rounding of n floating point
// operations: a result computed in n steps is within a factor of 1 +/- gamma(n)
// of the exact one. This is Higham's gamma, and pbrt's.
//
// The unit is the unit roundoff -- the largest relative error a single rounding
// can introduce, which is half the gap between one and the next representable
// number. `eps` is that gap, so the unit roundoff is half of it. Using eps
// itself would state a bound twice as wide as the arithmetic can actually be
// wrong by, which for a test that asks "could this have been a hit?" is the
// difference between an answer and a shrug.
//
// TODO(ajr): need generics eps for generic here.
func unit_roundoff() -> Float = 0.5 * eps[[Float]]();
func gamma(n : i32) -> Float =
    (cast[[Float]](n) * unit_roundoff()) / (1 - cast[[Float]](n) * unit_roundoff());

func linear_to_gamma_f(l : Float) -> Float {
    if (l > 0) {
        return sqrt(l);
    }
    return 0;
}

func linear_to_gamma_v(l : vec3f) -> vec3f {
    return {linear_to_gamma_f(l.x), linear_to_gamma_f(l.y), linear_to_gamma_f(l.z)};
}

func near_zero(v : vec3f) -> bool {
    // Return true if the vector is close to zero in all dimensions.
    s = 1e-8;
    return (abs(v[0]) < s) & (abs(v[1]) < s) & (abs(v[2]) < s);
}

func reflect(v : vec3f, n : vec3f) {
    return v  - 2.0 * dot(v, n) * n;
}

func len_squared(v : vec3f) -> Float {
    return sum(v * v);
}

func refract(uv : vec3f, n : vec3f, etai_over_etat : Float) {
    cos_theta = min(dot(-uv, n), 1.0);
    r_out_perp = etai_over_etat * (uv + cos_theta * n);
    r_out_parallel = -sqrt(abs(1.0 - len_squared(r_out_perp))) * n;
    return r_out_perp + r_out_parallel;
}

func unit_vector(v : vec3f) = v / norm(v);

// Schlick's approximation for reflectance
func reflectance(cos_theta : Float, refract_idx : Float) -> Float {
    r0 = (1 - refract_idx) / (1 + refract_idx);
    r1 = r0 * r0;
    return r1 + (1 - r1) * pow(1 - cos_theta, 5.0);
}

func degrees_to_radians(degrees : Float) {
    return (degrees * 3.1415926535897932385) / 180.0;
}

func clamp(x : vec3f, low : Float, high : Float) -> vec3f {
    return min(max(x, low), high);
}
