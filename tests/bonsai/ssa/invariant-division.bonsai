//! flags: -p ssa

// Division by an invariant integer using multiplication (Granlund &
// Montgomery, PLDI 1994; see SSA/InvariantDivision.h), as the SSA pipeline
// leaves it: for a gang, and not for a scalar.
//
// `digits` peels the base-b digits of an index, dividing by `b` once per
// digit, and `b` does not change while the loop runs. What to read for in the
// golden:
//
//   * `digits` is what the vectorized `run` calls, so it is a gang's: at its
//     top, before the loop, `div_multiplier(b)` and the two shifts of the
//     round-up method from `clz(b - 1)`, computed once where the divisor is;
//     in the loop body no division, `next` a `mulhi` by the multiplier, a
//     subtraction, two shifts and an addition; `limit`, the one division by
//     `b` outside the loop, using the same multiplier since it is there. The
//     rewrite runs before the vectorizer, on the function whose copy becomes
//     the gang, which is why the scalar `digits` shows it too.
//   * The gang `digits$gang8` divides by a `b` each lane has its own of, and
//     the same arithmetic widens: the multiplier is a vector taken once per
//     lane before the loop, and the loop body is vector multiplies and
//     shifts where it would be eight scalar divisions.
//   * `digits16`, which divides by a base read from a `u16` table -- pbrt's
//     primes, none above 7919 -- `digits32`, which divides by a `u32`, and
//     `permuted_digits`, `digits` with a call in the loop body (pbrt's
//     Owen-scrambled radical inverse permutes each digit through a
//     function), are reached by nothing vectorized: scalar wherever they
//     run, and their divisions stay divisions. Until 2026-10-02 they had
//     multipliers like `digits`; the user's rule is that a scalar division
//     by a non-constant is not optimized -- the multiplier costs a division
//     twice as wide, which on the GPU was a 128-bit division expanded into
//     a loop, 78% of a material kernel (apps/pbrt/PLAN.md) -- and the
//     multiplier is for what a vector unit cannot do, divide every lane at
//     once. A gang's per-lane multipliers of bounded divisors like
//     `digits16`'s are done by double division; see
//     vectorize-bounded-multiplier.bonsai.
//   * The divisions by the constant `4u` in `quarters` are a shift and a
//     mask, in scalar code too (see divide-by-constant.bonsai for the
//     constant case in full).
func digits(n : u64, b : u64) -> u64 {
    v : mut u64 = n;
    r : mut u64 = 0u;
    limit = 0xffffffffffffffff / b - b;
    while (v != 0u) && (r < limit) {
        next = v / b;
        r = r * b + (v - next * b);
        v = next;
    }
    return r;
}

func [[noinline]] scramble(digit : u64, salt : u64) -> u64 = (digit * 3u + salt) % 7u;

func permuted_digits(n : u64, b : u64) -> u64 {
    v : mut u64 = n;
    r : mut u64 = 0u;
    limit = 0xffffffffffffffff / b - b;
    while (v != 0u) && (r < limit) {
        next = v / b;
        r = r * b + scramble(v - next * b, r);
        v = next;
    }
    return r;
}

func digits16(n : u64, bases : array[u16, 8], i : i32) -> u64 {
    b : u64 = cast[[u64]](bases[i]);
    v : mut u64 = n;
    r : mut u64 = 0u;
    while v != 0u {
        next = v / b;
        r = r * b + (v - next * b);
        v = next;
    }
    return r;
}

func digits32(n : u32, b : u32) -> u32 {
    v : mut u32 = n;
    r : mut u32 = 0u;
    while v != 0u {
        next = v / b;
        r = r * b + (v - next * b);
        v = next;
    }
    return r;
}

func quarters(n : u64) -> u64 {
    total : mut u64 = 0u;
    v : mut u64 = n;
    while v != 0u {
        total = total + (v % 4u);
        v = v / 4u;
    }
    return total;
}

func [[export]] run(out : mut array[u64, 8], bases : array[u64, 8]) -> void {
    parfor i in 0:8 {
        out[i] = digits(cast[[u64]](i) * 1000003u, bases[i]);
    }
}

schedule {
    run.vectorize(i);
}
