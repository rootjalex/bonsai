//! flags: -p ssa

// Division by an invariant integer using multiplication (Granlund &
// Montgomery, PLDI 1994; see SSA/InvariantDivision.h), as the SSA pipeline
// leaves it.
//
// `digits` peels the base-b digits of an index, dividing by `b` once per
// digit, and `b` does not change while the loop runs. What to read for in the
// golden:
//
//   * At the top of `digits`, before the loop: `div_multiplier(b)`, and the
//     two shifts of the round-up method from `clz(b - 1)` -- computed once,
//     where the divisor is.
//   * In the loop body: no division. `next` is a `mulhi` by the multiplier,
//     a subtraction, two shifts and an addition.
//   * `limit`, the one division by `b` outside the loop, uses the same
//     multiplier, since it is there.
//   * The vectorized gang divides by a `b` each lane has its own of, and the
//     same arithmetic widens to the gang: the multiplier is a vector, taken
//     once per lane before the loop, and the loop body is vector multiplies
//     and shifts where it was eight scalar divisions.
//   * The divisions by the constant `4u` in `quarters` are a shift and a
//     mask (see divide-by-constant.bonsai for the constant case in full).
//   * `digits16` divides by a base read from a `u16` table -- pbrt's primes,
//     none above 7919 -- and `digits32` by a `u32`, and both keep the
//     `div_multiplier` intrinsic all the same: on a scalar the multiplier is
//     one hardware division twice the width, and nothing beats that. A
//     gang's per-lane multipliers of such divisors are the ones done by
//     double division instead; see vectorize-bounded-multiplier.bonsai.
//   * `permuted_digits` is `digits` with a call in the loop body -- pbrt's
//     Owen-scrambled radical inverse permutes each digit through a function
//     -- so the loop's values pass through the call's continuation block on
//     their way back to the header. The divisor is still the one defined
//     before the loop, and the golden shows the same multiplier at the top
//     and no division in the loop. (The tracer once stopped at the
//     continuation, took its argument for a definition of its own, and left
//     both divisions as they were.)
func digits(n : u64, b : u64) -> u64 {
    v : mut u64 = n;
    r : mut u64 = 0u;
    limit = 0xffffffffffffffff / b - b;
    while (v != 0u) && (r < limit) {
        next = v / b;
        r = r * b + (v - next * b);
        v = next;
    }
    return r;
}

func [[noinline]] scramble(digit : u64, salt : u64) -> u64 = (digit * 3u + salt) % 7u;

func permuted_digits(n : u64, b : u64) -> u64 {
    v : mut u64 = n;
    r : mut u64 = 0u;
    limit = 0xffffffffffffffff / b - b;
    while (v != 0u) && (r < limit) {
        next = v / b;
        r = r * b + scramble(v - next * b, r);
        v = next;
    }
    return r;
}

func digits16(n : u64, bases : array[u16, 8], i : i32) -> u64 {
    b : u64 = cast[[u64]](bases[i]);
    v : mut u64 = n;
    r : mut u64 = 0u;
    while v != 0u {
        next = v / b;
        r = r * b + (v - next * b);
        v = next;
    }
    return r;
}

func digits32(n : u32, b : u32) -> u32 {
    v : mut u32 = n;
    r : mut u32 = 0u;
    while v != 0u {
        next = v / b;
        r = r * b + (v - next * b);
        v = next;
    }
    return r;
}

func quarters(n : u64) -> u64 {
    total : mut u64 = 0u;
    v : mut u64 = n;
    while v != 0u {
        total = total + (v % 4u);
        v = v / 4u;
    }
    return total;
}

func [[export]] run(out : mut array[u64, 8], bases : array[u64, 8]) -> void {
    parfor i in 0:8 {
        out[i] = digits(cast[[u64]](i) * 1000003u, bases[i]);
    }
}

schedule {
    run.vectorize(i);
}
