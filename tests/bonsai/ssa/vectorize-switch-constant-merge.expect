type Blob = struct Blob{ tag : u8; _pad : [[packed]] u8x15; payload : [[packed]] u32x8 }
type Float = f32
type Half = f16
type Split = struct Split{ lo : i32; hi : i32 }
type Whole = struct Whole{ x : f32 }
type Wide = struct Wide{ v : f32x3; neg : bool }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func make_blob(v : f32, i : i32) -> Blob {
  let @23 = mulhi(i, 1431655766) in
  let @24 = @23 >> 31 in
  let @25 = reinterpret_cast<u32>(@24) in
  let @26 = @25 >> 31u in
  let @27 = reinterpret_cast<i32>(@26) in
  let @28 = @23 + @27 in
  let @29 = @28 * 3 in
  let _t19 = i - @29 in
  let @1 = _t19 == 0 in
  if (@1) {
    let @2 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
    let @3 = reinterpret_cast<u32>(v) in
    let @4 = build<[[packed]] u32x8>(@3, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
    let @5 = build<Blob>(0u, @2, @4) in
    return @5
  } else {
    let @6 = _t19 == 1 in
    if (@6) {
      let @7 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
      let @8 = reinterpret_cast<u32>(i) in
      let @9 = i * 10 in
      let @10 = reinterpret_cast<u32>(@9) in
      let @11 = build<[[packed]] u32x8>(@8, @10, 0u, 0u, 0u, 0u, 0u, 0u) in
      let @12 = build<Blob>(1u, @7, @11) in
      return @12
    } else {
      let @13 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
      let @14 = reinterpret_cast<u32>(v) in
      let @15 = 2f * v in
      let @16 = reinterpret_cast<u32>(@15) in
      let @17 = 3f * v in
      let @18 = reinterpret_cast<u32>(@17) in
      let @19 = v < 0f in
      let @20 = cast<u32>(@19) in
      let @21 = build<[[packed]] u32x8>(@14, @16, @18, 0u, @20, 0u, 0u, 0u) in
      let @22 = build<Blob>(2u, @13, @21) in
      return @22
    }
  }
}

func never(b : Blob) -> bool {
  let @0 = b.tag in
  switch (@0) {
  case 0: { // Blob.Whole of never
    return false
  } break;
  case 1: { // Blob.Split of never
    return false
  } break;
  default: { // Blob.Wide of never
    return false
  }
  }
}

func weigh(b : Blob, k : f32) -> f32 {
  let @0 = b.tag in
  let never$r6 = false in
  if (never$r6) {
    return 0f
  } else {
    let @2 = k * 2f in
    return @2
  }
}

func [[export]] weigh_all(a : f32[8], out : mut f32[8]) -> void {
  let _t28 = a[ramp(0, 1, 8)] in
  let @183 = f32x8(2f) in
  let @27 = _t28 * @183 in
  let i = ramp(0, 1, 8) in
  let weigh$r8 = @27 in
  out[ramp(0, 1, 8)] = weigh$r8
  return
}


schedule host {
    weigh_all.vectorize(i)

}
