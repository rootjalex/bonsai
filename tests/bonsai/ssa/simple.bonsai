//! flags: -p ssa

// The basic shapes the SSA builder and the relooper have to round trip:
// straight line code, an if/else with a value flowing out of both arms, a
// mutable local, and a recursive call.
func afoo(a : f32) {
    return a + 1.0;
}

func bfoo(a : f32) {
    if (a < 0.0) {
        return a + 1.0;
    } else {
        return a;
    }
}

func cfoo(a : f32) {
    b : mut f32 = 0.0;
    if (a < 0.0) {
        b = 1.0;
    } else {
        b = 0.0;
    }
    return b;
}

func color(out : mut array[f32, 8], i : i8, a : f32) -> void {
    if (a < 0.0) {
        color(out, i, a + 1.0);
        return;
    } else {
        out[i] = a;
        return;
    }
}
