//! flags: -p ssa

// A child's box read at the children loop's counter, out of a node that
// holds its children's boxes by component -- Embree's AABBNode<8>: lower_x
// of all eight children, then upper_x, ... -- where the children are not
// what is vectorized: the scalar any hit over the loopified traversal, which
// is the shape the packet traversal has once the rays are the gang
// (apps/rtq/schedules/packet16.bonsai). The program and the layout are
// any-hit-prefetch.bonsai's; the schedule neither vectorizes the children
// nor sorts them, so the node's children are tested one at a time, in a
// loop, each against its own box.
//
// What to read for, in the children loop: the node's `lo` and `hi`, which
// the layout builds from the row's six vectors, are not indexed at
// `children`. Each component's lane is a scalar `load` through a `gep`
// into the row's own vector, `reinterpret_cast<const f32[8]>((&row.
// lower_x))[children]`, and the child's box is built from the six scalars
// (SSA/Simplify.cpp, the ExtractIdx rule for a vector of vectors, over the
// rule for a lane of a stored vector). Before, `build<f32x3x8>(lower_x,
// lower_y, lower_z)[children]` reached the backend as a lane of each
// component vector at a run-time index, which LLVM reads through the stack:
// six stores and six loads a child, where Embree's `node->lower_x[i]` is a
// load. The LLVM is golden-diffed in backends/llvm/child-bounds-at-lane.
// bonsai, and the same read runs in correctness/cpp/bvh4_ptr_arena_children.
// bonsai against known answers.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

schedule {
    tree[[Triangle]] BVH8 =
    | Interior(children : array[BVH8, 8], lo hi : vector[vec3f, 8])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH8;

    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 8];
                lower_x : vector[f32, 8];
                upper_x : vector[f32, 8];
                lower_y : vector[f32, 8];
                upper_y : vector[f32, 8];
                lower_z : vector[f32, 8];
                upper_z : vector[f32, 8];
                lo = vector[vec3f, 8]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 8]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    occluded.loopify(64);
}
