func exact(a : f32[64], out : mut f32[64]) -> void {
  parfor io in [0:64:16] {
    parfor ii in [0:16:1] {
      let @3 = io + ii in
      let i = @3 in
      let @0 = a[i] in
      let @1 = @0 * 2f in
      out[i] = @1
      continue
    }
    continue
  }
  return
}

func scale(n : i32, a : f32[n], out : mut f32[n]) -> void {
  parfor io in [0:n:16] {
    let @3 = n in
    parfor ii in [0:16:1] {
      let @4 = io + ii in
      let @5 = @4 < @3 in
      if (@5) {
        let i = @4 in
        let @0 = a[i] in
        let @1 = @0 * 2f in
        out[i] = @1
        continue
      } else {
        continue
      }
    }
    continue
  }
  return
}


schedule host {
    exact.split(i, io, ii, (i32)16, 1)
    scale.split(i, io, ii, (i32)16, 1)

}
