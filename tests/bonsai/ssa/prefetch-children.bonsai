//! flags: -p ssa

// The prefetch directive on a node's children: the tree and schedule of
// tiled-leaf-vectorized.bonsai with `trace.prefetch(tris.Interior.children)`.
// Embree brings every hit child's node into L1 as it extracts it from the
// node, before the sort and the pushes (`BVH::prefetch`, four `prefetcht0`
// for a BVH8 node, kernels/bvh/bvh_traverser1.h), so that a child popped
// later is in cache; Halide's `prefetch(g, at, from, offset)` places a
// prefetch in loop `at` for what iteration `from + offset` will touch. Here
// the loop is the children's test, named by the field, and what is fetched
// is the storage each hit child refers to, which the layout knows exactly
// (see ir::Prefetch in IR/Schedule.h).
//
// What to read for. In the children's gang, after the four-wide test, a
// `prefetch` of each hit child's storage: the reference's low bits choose
// between the arms as a visit of it would (Lower/Layouts.cpp,
// LowerReferencePrefetches) -- the node row `group1_row[ref >> 4]` for an
// interior child, the first tile of a leaf's range for a leaf, `group0_prims[
// ((ref >> 4) << 2) >> 2]` -- and both arms fetch the widest arm's bytes,
// `160u`, a tile's. Linearized, each arm sits behind a `reduce<any>` of its
// mask -- the hit mask narrowed by the kind -- since a prefetch is an
// effect, and the prefetch carries that mask as its third operand
// (SSA/Linearize.cpp predicates it with the stores); its address is one
// per lane, `&group1_row[<vector of rows>]`, and the backend takes the
// lanes one at a time (CodeGen_LLVM::emit_prefetch; backends/llvm/
// prefetch-children.bonsai). Nothing is computed from it: in SSA the
// instruction has no name, as a store has none, and the Stmt form printed
// here binds it to a fresh `_effectN` that nothing reads.
import stdlib/numerics;

element Ray {
    o : vec3f;
    tnear : Float;
    d : vec3f;
    tfar : Float;
}

element Triangle {
    v0 : vec3f;
    e1 : vec3f;
    e2 : vec3f;
    primID : u32;
}

element AABB {
    low, high : vec3f;
}

element FInterval {
    low, high : Float;
}

func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    rdir = 1.0 / r.d;
    org_rdir = r.o * rdir;
    dirIsNeg = rdir < 0.0;
    near = select(dirIsNeg, b.high, b.low);
    far = select(dirIsNeg, b.low, b.high);
    tNearV = near * rdir - org_rdir;
    tFarV = far * rdir - org_rdir;
    tNear = max(max(tNearV.x, tNearV.y), max(tNearV.z, r.tnear));
    tFar = min(min(tFarV.x, tFarV.y), min(tFarV.z, r.tfar));
    if tNear <= tFar {
        return FInterval{tNear, tFar};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

func contains(r : Ray, b : AABB) -> bool = false;

element TriangleHit {
    t, u, v : Float;
}

func intersectsp_ray_tri(r : Ray, tri : Triangle) -> option[TriangleHit] {
    Ng = cross(tri.e2, tri.e1);
    C = tri.v0 - r.o;
    R = cross(C, r.d);
    den = dot(Ng, r.d);
    absDen = abs(den);
    sgnDen = reinterpret[[u32]](den) & 2147483648u;
    U = reinterpret[[Float]](reinterpret[[u32]](dot(R, tri.e2)) ^ sgnDen);
    V = reinterpret[[Float]](reinterpret[[u32]](dot(R, tri.e1)) ^ sgnDen);
    if !(den != 0.0 && U >= 0.0 && V >= 0.0 && U + V <= absDen) {
        return {};
    }
    T = reinterpret[[Float]](reinterpret[[u32]](dot(Ng, C)) ^ sgnDen);
    if !(absDen * r.tnear < T && T <= absDen * r.tfar) {
        return {};
    }
    rcpAbsDen = 1.0 / absDen;
    return TriangleHit{T * rcpAbsDen, U * rcpAbsDen, V * rcpAbsDen};
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](intersectsp_ray_tri(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return -inf;
}

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                v0 : vec3f;
                e1 : vec3f;
                e2 : vec3f;
                primID : u32;
            };
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    // Embree: every hit child's storage into L1 as the node's test finds
    // it, before the sort and the pushes (BVH::prefetch).
    trace.prefetch(tris.Interior.children);
}
