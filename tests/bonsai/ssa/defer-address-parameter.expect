type Entry_q = struct Entry_q{ k : i32; acc : i32; dst : (i32*) }
type Queue_q = struct Queue_q{ count : u32; k : i32[]; acc : i32[]; dst : (i32*)[] }

func fill(k : i32, acc : i32, dst : mut (i32*), _queue_q : mut (Queue_q*)) -> void {
  let @0 = k <= 0 in
  if (@0) {
    dst += acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @3 = build<Entry_q>(@1, @2, dst) in
    let @6 = atomic_add((&(*_queue_q).count), 1u) in
    let @8 = (*_queue_q).k in
    @8[@6] = @1
    let @11 = (*_queue_q).acc in
    @11[@6] = @2
    let @14 = (*_queue_q).dst in
    @14[@6] = dst
    return
  }
}

func grid(sums : mut i32[3]) -> void {
  q!round : mut u32
  total!expanded : mut i32[3]
  parfor y!prologue in [0:3:1] {
    total!expanded[y] = 0
    continue
  }
  q_k_0 : mut i32[12]
  q_acc_0 : mut i32[12]
  q_dst_0 : mut (i32*)[12]
  q_k_1 : mut i32[12]
  q_acc_1 : mut i32[12]
  q_dst_1 : mut (i32*)[12]
  q_queue : mut Queue_q[2]
  let @8 = build<Queue_q>(0u, q_k_0, q_acc_0, q_dst_0) in
  q_queue[0u] = @8
  let @10 = build<Queue_q>(0u, q_k_1, q_acc_1, q_dst_1) in
  q_queue[1u] = @10
  parfor k in [0:12:1] {
    let @33 = k >> 31 in
    let @34 = reinterpret_cast<u32>(@33) in
    let @35 = @34 >> 30u in
    let @36 = reinterpret_cast<i32>(@35) in
    let @37 = k + @36 in
    let @6 = @37 >> 2 in
    let @44 = @6 * 4 in
    let @7 = k - @44 in
    let y = @6 in
    let x = @7 in
    let total = (&total!expanded[y]) in
    let @0 = y + x in
    let @13 = build<Entry_q>(@0, 0, total) in
    let @47 = atomic_add((&q_queue[0u].count), 1u) in
    let @49 = q_queue[0u].k in
    @49[@47] = @0
    let @52 = q_queue[0u].acc in
    @52[@47] = 0
    let @55 = q_queue[0u].dst in
    @55[@47] = total
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @16 = (*q!round) & 1u in
    let @18 = q_queue[(*q!round) & 1u].count in
    let @20 = @16 ^ 1u in
    q_queue[@20].count = 0u
    parfor q in [0u:@18:1u] {
      let @21 = (&q_queue[@20]) in
      let @25 = q_queue[@16].k in
      let @26 = @25[q] in
      let @28 = q_queue[@16].acc in
      let @29 = @28[q] in
      let @31 = q_queue[@16].dst in
      let @32 = @31[q] in
      fill(@26, @29, @32, @21)
      continue
    }
    let @15 = (*q!round) + 1u in
    q!round = @15
  }
  parfor y!epilogue in [0:3:1] {
    let total = (&total!expanded[y]) in
    let y = y in
    let @1 = (*total) in
    sums[y] = @1
    continue
  }
  return
}


schedule {
    q = grid.queue(root);
    fill.defer(fill, q)
    grid.reorder(y, x)
        .reorder(x, y)
        .collapse(y, x, k)
        .defer(fill, q)

}
