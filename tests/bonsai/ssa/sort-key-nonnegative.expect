  | Leaf(data : Triangle[]) with data = data
    occluded.loopify((i32)64)
    trace.sort(tris.Interior, |i : u32, r : struct Ray{ o : f32x3; tnear : f32; d : f32x3; tfar : f32 }, lo : f32x3x4, hi : f32x3x4| distmin(r, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
         .loopify((i32)64)
    trace_raw.sort(tris.Interior, |i : u32, r : struct Ray{ o : f32x3; tnear : f32; d : f32x3; tfar : f32 }, lo : f32x3x4, hi : f32x3x4| distmin(r, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
             .loopify((i32)64)

}
