type Entry_q = struct Entry_q{ k : i32; acc : i32; _slot : i32 }
type Queue_q = struct Queue_q{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }

func grid(out : mut i32[12], sums : mut i32[3]) -> void {
  q!round : mut u32
  total!expanded : mut i32[3]
  parfor y!prologue in [0:3:1] {
    total!expanded[y] = 0
    continue
  }
  q_result : mut i32[12]
  q_k_0 : mut i32[12]
  q_acc_0 : mut i32[12]
  q__slot_0 : mut i32[12]
  q_k_1 : mut i32[12]
  q_acc_1 : mut i32[12]
  q__slot_1 : mut i32[12]
  q_queue : mut Queue_q[2]
  let @13 = build<Queue_q>(0u, q_k_0, q_acc_0, q__slot_0) in
  q_queue[0u] = @13
  let @15 = build<Queue_q>(0u, q_k_1, q_acc_1, q__slot_1) in
  q_queue[1u] = @15
  parfor k in [0:12:1] {
    let @46 = k >> 31 in
    let @47 = reinterpret_cast<u32>(@46) in
    let @48 = @47 >> 30u in
    let @49 = reinterpret_cast<i32>(@48) in
    let @50 = k + @49 in
    let @10 = @50 >> 2 in
    let @57 = @10 * 4 in
    let @11 = k - @57 in
    let y = @10 in
    let x = @11 in
    let total = (&total!expanded[y]) in
    let @0 = y + x in
    let @18 = build<Entry_q>(@0, 0, k) in
    let @71 = atomic_add((&q_queue[0u].count), 1u) in
    let @73 = q_queue[0u].k in
    @73[@71] = @0
    let @76 = q_queue[0u].acc in
    @76[@71] = 0
    let @79 = q_queue[0u]._slot in
    @79[@71] = k
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @22 = (*q!round) & 1u in
    let @24 = q_queue[(*q!round) & 1u].count in
    let @26 = @22 ^ 1u in
    q_queue[@26].count = 0u
    parfor q in [0u:@24:1u] {
      let @27 = (&q_queue[@26]) in
      let @31 = q_queue[@22].k in
      let @32 = @31[q] in
      let @34 = q_queue[@22].acc in
      let @35 = @34[q] in
      let @37 = q_queue[@22]._slot in
      let @38 = @37[q] in
      walk(@32, @35, @27, (&q_result[@38]), @38)
      continue
    }
    let @21 = (*q!round) + 1u in
    q!round = @21
  }
  parfor q_rest in [0:12:1] {
    let @41 = q_result[q_rest] in
    let @58 = q_rest >> 31 in
    let @59 = reinterpret_cast<u32>(@58) in
    let @60 = @59 >> 30u in
    let @61 = reinterpret_cast<i32>(@60) in
    let @62 = q_rest + @61 in
    let @42 = @62 >> 2 in
    let @69 = @42 * 4 in
    let @43 = q_rest - @69 in
    let @1 = @41 in
    let y = @42 in
    let x = @43 in
    let total = (&total!expanded[@42]) in
    let v = @1 in
    let @2 = y << 2 in
    let @3 = @2 + x in
    out[@3] = v
    total += v
    continue
  }
  parfor y!epilogue in [0:3:1] {
    let total = (&total!expanded[y]) in
    let y = y in
    let @5 = (*total) in
    sums[y] = @5
    continue
  }
  return
}

func walk(k : i32, acc : i32, _queue_q : mut (Queue_q*), _result_q : mut (i32*), _slot_q : i32) -> void {
  let @0 = k <= 0 in
  if (@0) {
    _result_q = acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @4 = build<Entry_q>(@1, @2, _slot_q) in
    let @7 = atomic_add((&(*_queue_q).count), 1u) in
    let @9 = (*_queue_q).k in
    @9[@7] = @1
    let @12 = (*_queue_q).acc in
    @12[@7] = @2
    let @15 = (*_queue_q)._slot in
    @15[@7] = _slot_q
    return
  }
}


schedule {
    q = grid.queue(root);
    grid.reorder(y, x)
        .reorder(x, y)
        .collapse(y, x, k)
        .defer(walk, q)
    walk.defer(walk, q)

}
