type Entry_q = struct Entry_q{ k : i32; acc : i32; _slot : i32 }
type Queue_q = struct Queue_q{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }

func grid(out : mut i32[12], sums : mut i32[3]) -> void {
  q!round : mut u32
  total!expanded : mut i32[3]
  parfor y!prologue in [0:3:1] {
    total!expanded[y] = 0
    continue
  }
  q_result : mut i32[12]
  q_k_0 : mut i32[12]
  q_acc_0 : mut i32[12]
  q__slot_0 : mut i32[12]
  q_k_1 : mut i32[12]
  q_acc_1 : mut i32[12]
  q__slot_1 : mut i32[12]
  q_queue : mut Queue_q[2]
  let @13 = build<Queue_q>(0u, q_k_0, q_acc_0, q__slot_0) in
  q_queue[0u] = @13
  let @15 = build<Queue_q>(0u, q_k_1, q_acc_1, q__slot_1) in
  q_queue[1u] = @15
  parfor k in [0:12:1] {
    let @45 = k >> 31 in
    let @46 = reinterpret_cast<u32>(@45) in
    let @47 = @46 >> 30u in
    let @48 = reinterpret_cast<i32>(@47) in
    let @49 = k + @48 in
    let @10 = @49 >> 2 in
    let @56 = @10 * 4 in
    let @11 = k - @56 in
    let y = @10 in
    let x = @11 in
    let total = (&total!expanded[y]) in
    let @0 = y + x in
    let @18 = build<Entry_q>(@0, 0, k) in
    let @71 = atomic_add((&q_queue[0u].count), 1u) in
    let @73 = q_queue[0u].k in
    @73[@71] = @0
    let @76 = q_queue[0u].acc in
    @76[@71] = 0
    let @79 = q_queue[0u]._slot in
    @79[@71] = k
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @21 = (*q!round) & 1u in
    let @23 = q_queue[(*q!round) & 1u].count in
    let @25 = @21 ^ 1u in
    q_queue[@25].count = 0u
    parfor q in [0u:@23:1u] {
      let @26 = (&q_queue[@25]) in
      let @30 = q_queue[@21].k in
      let @31 = @30[q] in
      let @33 = q_queue[@21].acc in
      let @34 = @33[q] in
      let @36 = q_queue[@21]._slot in
      let @37 = @36[q] in
      walk(@31, @34, @26, (&q_result[@37]), @37)
      continue
    }
    let @20 = (*q!round) + 1u in
    q!round = @20
  }
  parfor q_rest in [0:12:1] {
    let @40 = q_result[q_rest] in
    let @57 = q_rest >> 31 in
    let @58 = reinterpret_cast<u32>(@57) in
    let @59 = @58 >> 30u in
    let @60 = reinterpret_cast<i32>(@59) in
    let @61 = q_rest + @60 in
    let @41 = @61 >> 2 in
    let @68 = @41 * 4 in
    let @42 = q_rest - @68 in
    let @1 = @40 in
    let y = @41 in
    let x = @42 in
    let total = (&total!expanded[@41]) in
    let v = @1 in
    let @2 = y << 2 in
    let @3 = @2 + x in
    out[@3] = v
    total += v
    continue
  }
  parfor y!epilogue in [0:3:1] {
    let total = (&total!expanded[y]) in
    let y = y in
    let @5 = (*total) in
    sums[y] = @5
    continue
  }
  return
}

func walk(k : i32, acc : i32, _queue_q : mut (Queue_q*), _result_q : mut (i32*), _slot_q : i32) -> void {
  let @0 = k <= 0 in
  if (@0) {
    _result_q = acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @4 = build<Entry_q>(@1, @2, _slot_q) in
    let @7 = atomic_add((&(*_queue_q).count), 1u) in
    let @9 = (*_queue_q).k in
    @9[@7] = @1
    let @12 = (*_queue_q).acc in
    @12[@7] = @2
    let @15 = (*_queue_q)._slot in
    @15[@7] = _slot_q
    return
  }
}


schedule {
    q = grid.queue(root);
    grid.reorder(y, x)
        .reorder(x, y)
        .collapse(y, x, k)
        .defer(walk, q)
    walk.defer(walk, q)

}
