//! flags: -p ssa

// `loopify()` on a recursion that runs through a function that spawns.
// `step` hands its next round to `route`, and `route` spawns `tally` into
// the reducer before handing the round back; so `route` is copied into
// `step` at its call (SSA/Rewrite.cpp, inline_call, as ssa/loopify-mutual
// shows), and the copy's return becomes a plain jump to the call's
// continuation: a return joins nothing (docs/parallel-semantics.md,
// section 1), so the spawns are outstanding until `main`'s `join;`, which
// waits for every call its activity spawned through `step` and `route`
// alike, before `seen` is read. What to look for: `route!inl0`'s blocks
// inside `step`, the `spawn tally(...)` among them, the tail call become
// the loop's back edge carrying `n` and `acc` round, no join inside
// `step`, and the `join` in `main` between the two prints. (Until 10-25 a
// return joined, the copy's return became a `join` on the way to the
// continuation, and the walk to the tail call had to see through it.)
// correctness/llvm/loopify-spawn-mutual runs it.
import stdlib/numerics;

func tally(x : Float, seen : reduce(+) Float) -> void {
    seen += x;
    return;
}

func step(n : i32, acc : Float, seen : reduce(+) Float) -> Float {
    if n == 0 {
        return acc;
    }
    return route(n, acc + 1.0, seen);
}

func route(n : i32, acc : Float, seen : reduce(+) Float) -> Float {
    spawn tally(acc, seen);
    return step(n - 1, acc * 2.0, seen);
}

func main() -> i32 {
    seen : reduce(+) Float = 0.0;
    r = step(4, 0.0, seen);
    print(r);
    join;
    print(seen);
    return 0;
}

schedule {
    step.loopify();
}
