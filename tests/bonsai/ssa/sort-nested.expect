         .sort(Instance.blas.Interior, |i : u8, ray : struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }, axis : u8| select((f32x3((f32)1) / ray.d)[axis] < (f32)0, (f32)1 - cast<f32>(i), cast<f32>(i)))
         .loopify((i32)64)

}
