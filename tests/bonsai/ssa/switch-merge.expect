func _unexported_Blob_Wide(v : f32x3, neg : bool) -> Blob {
  let @0 = build<Wide>(v, neg) in
  let @1 = Blob_payload{.Wide = @0} in
  let @2 = build<Blob>(2u, @1) in
  return @2
}

func [[export]] weigh(b : (Blob*), k : f32) -> f32 {
  acc : mut f32
  acc = k
  let @0 = (*b) in
  let @1 = @0.tag in
  switch (@1) {
  case 0: {
    let @2 = (*b) in
    let @3 = @2.payload in
    let @4 = @3.Whole in
    let x = @4.x in
    let @6 = (*acc) in
    let @7 = x * 2f in
    let @8 = @6 + @7 in
    acc = @8
  } break;
  case 1: {
    let @9 = (*b) in
    let @10 = @9.payload in
    let _t76 = @10.Split in
    let lo = _t76.lo in
    let hi = _t76.hi in
    let @14 = lo + hi in
    let @15 = cast<f32>(@14) in
    return @15
  } break;
  default: {
  }
  }
  let @16 = (*acc) in
  let @17 = @16 * 3f in
  return @17
}


