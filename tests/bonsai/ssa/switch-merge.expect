type Blob = struct Blob{ tag : u8; _pad : [[packed]] u8x15; payload : [[packed]] u32x8 }
type Float = f32
type Half = f16
type Split = struct Split{ lo : i32; hi : i32 }
type Whole = struct Whole{ x : f32 }
type Wide = struct Wide{ v : f32x3; neg : bool }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Blob_Split(_ret0 : mut (Blob*), lo : i32, hi : i32) -> void {
  let @0 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(lo) in
  let @2 = reinterpret_cast<u32>(hi) in
  let @3 = build<[[packed]] u32x8>(@1, @2, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @4 = build<Blob>(1u, @0, @3) in
  _ret0 = @4
  return
}

func [[export]] Blob_Whole(_ret1 : mut (Blob*), x : f32) -> void {
  let @0 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(x) in
  let @2 = build<[[packed]] u32x8>(@1, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @3 = build<Blob>(0u, @0, @2) in
  _ret1 = @3
  return
}

func [[export]] Blob_Wide(_ret2 : mut (Blob*), v : f32x3, neg : bool) -> void {
  let @0 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @1 = v[0u] in
  let @2 = reinterpret_cast<u32>(@1) in
  let @3 = v[1u] in
  let @4 = reinterpret_cast<u32>(@3) in
  let @5 = v[2u] in
  let @6 = reinterpret_cast<u32>(@5) in
  let @7 = cast<u32>(neg) in
  let @8 = build<[[packed]] u32x8>(@2, @4, @6, 0u, @7, 0u, 0u, 0u) in
  let @9 = build<Blob>(2u, @0, @8) in
  _ret2 = @9
  return
}

func _unexported_Blob_Split(lo : i32, hi : i32) -> Blob {
  let @0 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(lo) in
  let @2 = reinterpret_cast<u32>(hi) in
  let @3 = build<[[packed]] u32x8>(@1, @2, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @4 = build<Blob>(1u, @0, @3) in
  return @4
}

func _unexported_Blob_Whole(x : f32) -> Blob {
  let @0 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(x) in
  let @2 = build<[[packed]] u32x8>(@1, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @3 = build<Blob>(0u, @0, @2) in
  return @3
}

func _unexported_Blob_Wide(v : f32x3, neg : bool) -> Blob {
  let @0 = build<[[packed]] u8x15>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u) in
  let @1 = v[0u] in
  let @2 = reinterpret_cast<u32>(@1) in
  let @3 = v[1u] in
  let @4 = reinterpret_cast<u32>(@3) in
  let @5 = v[2u] in
  let @6 = reinterpret_cast<u32>(@5) in
  let @7 = cast<u32>(neg) in
  let @8 = build<[[packed]] u32x8>(@2, @4, @6, 0u, @7, 0u, 0u, 0u) in
  let @9 = build<Blob>(2u, @0, @8) in
  return @9
}

func [[export]] weigh(b : (Blob*), k : f32) -> f32 {
  acc : mut f32
  acc = k
  let @0 = (*b) in
  let @1 = @0.tag in
  switch (@1) {
  case 0: {
    let @2 = (*b) in
    let @3 = @2.payload in
    let @4 = @3[0u] in
    let x = reinterpret_cast<f32>(@4) in
    let @6 = (*acc) in
    let @7 = x * 2f in
    let @8 = @6 + @7 in
    acc = @8
  } break;
  case 1: {
    let @9 = (*b) in
    let _t26 = @9.payload in
    let @11 = _t26[0u] in
    let lo = reinterpret_cast<i32>(@11) in
    let @13 = _t26[1u] in
    let hi = reinterpret_cast<i32>(@13) in
    let @15 = lo + hi in
    let @16 = cast<f32>(@15) in
    return @16
  } break;
  default: {
  }
  }
  let @17 = (*acc) in
  let @18 = @17 * 3f in
  return @18
}


