type Blob = struct Blob{ tag : u8; payload : union Blob_payload{ Whole : struct Whole{ x : f32 }; Split : struct Split{ lo : i32; hi : i32 }; Wide : struct Wide{ v : f32x3; neg : bool } } }
type Float = f32
type Half = f16
type Split = struct Split{ lo : i32; hi : i32 }
type Whole = struct Whole{ x : f32 }
type Wide = struct Wide{ v : f32x3; neg : bool }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Blob_Split(_ret0 : mut (Blob*), lo : i32, hi : i32) -> void {
  let @0 = build<Split>(lo, hi) in
  let @1 = Blob_payload{.Split = @0} in
  let @2 = build<Blob>(1u, @1) in
  _ret0 = @2
  return
}

func [[export]] Blob_Whole(_ret1 : mut (Blob*), x : f32) -> void {
  let @0 = build<Whole>(x) in
  let @1 = Blob_payload{.Whole = @0} in
  let @2 = build<Blob>(0u, @1) in
  _ret1 = @2
  return
}

func [[export]] Blob_Wide(_ret2 : mut (Blob*), v : f32x3, neg : bool) -> void {
  let @0 = build<Wide>(v, neg) in
  let @1 = Blob_payload{.Wide = @0} in
  let @2 = build<Blob>(2u, @1) in
  _ret2 = @2
