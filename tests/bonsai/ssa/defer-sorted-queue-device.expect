type Entry_rays = struct Entry_rays{ x : f32; n : i32; _sort_key : u64 }
type Float = f32
type Half = f16
type Queue_rays = struct Queue_rays{ count : u32; x : f32[]; n : i32[]; _sort_key : u64[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

extern func bonsai_cuda_round_guard(round : u32, count : (u32*)) -> u32;

func run(values : f32[40], total : mut (f32*)) -> void {
  rays!round : mut u32
  alloc rays_x_0 : mut f32[40] device
  alloc rays_n_0 : mut i32[40] device
  alloc rays__sort_key_0 : mut u64[40] device
  alloc rays_x_1 : mut f32[40] device
  alloc rays_n_1 : mut i32[40] device
  alloc rays__sort_key_1 : mut u64[40] device
  alloc rays__perm : mut u32[40] device
  alloc rays_queue : mut Queue_rays[2] device
  let @5 = build<Queue_rays>(0u, rays_x_0, rays_n_0, rays__sort_key_0) in
  rays_queue[0u] = @5
  let @7 = build<Queue_rays>(0u, rays_x_1, rays_n_1, rays__sort_key_1) in
  rays_queue[1u] = @7
  parfor i in [0:40:1] {
    let _t22 = values[i] in
    let @41 = i >> 31 in
    let @42 = reinterpret_cast<u32>(@41) in
    let @43 = @42 >> 31u in
    let @44 = reinterpret_cast<i32>(@43) in
    let @45 = i + @44 in
    let @46 = @45 >> 1 in
    let @47 = @46 * 2 in
    let @1 = i - @47 in
    let @2 = _t22 * 4f in
    let @3 = cast<i32>(@2) in
    let @4 = cast<u64>(@3) in
    let @10 = build<Entry_rays>(_t22, @1, @4) in
    let @54 = atomic_add((&rays_queue[0u].count), 1u) in
    let @56 = rays_queue[0u].x in
    @56[@54] = _t22
    let @59 = rays_queue[0u].n in
    @59[@54] = @1
    let @62 = rays_queue[0u]._sort_key in
    @62[@54] = @4
    continue
  }
  rays!round = 0u
  do {
    let @13 = (*rays!round) & 1u in
    let @14 = rays_queue[@13] in
    let @15 = @14.count in
    let @48 = bonsai_cuda_round_guard((*rays!round), (&rays_queue[@13].count)) in
    let @49 = @48 == 0u in
    if (@49) {
      return
    } else {
      let @17 = @13 ^ 1u in
      rays_queue[@17].count = 0u
      let @22 = rays_queue[@13]._sort_key in
      let @23 = sort_indices(@22, rays__perm, @15, 64u) in
      let @35 = cast<u32>(40) in
      parfor rays in [0u:@35:1u] {
        let @18 = (&rays_queue[@17]) in
        let @38 = (&rays_queue[@13].count) in
        let @39 = (*@38) in
        let @40 = rays < @39 in
        if (@40) {
          let @24 = rays__perm[rays] in
          let @27 = rays_queue[@13].x in
          let @28 = @27[@24] in
          let @30 = rays_queue[@13].n in
          let @31 = @30[@24] in
          let @33 = rays_queue[@13]._sort_key in
          let @34 = @33[@24] in
          step(@28, @31, total, @34, @18)
          continue
        } else {
          continue
        }
      }
      let @12 = (*rays!round) + 1u in
      rays!round = @12
      continue
    }
  } while (true)
}

func step(x : f32, n : i32, total : mut (f32*), _sort_key : u64, _queue_rays : mut (Queue_rays*)) -> void {
  atomic total += x
  let @0 = n == 0 in
  if (@0) {
    return
  } else {
    let @1 = n - 1 in
    let @2 = x * 4f in
    let @3 = cast<i32>(@2) in
    let @4 = cast<u64>(@3) in
    let @5 = build<Entry_rays>(x, @1, @4) in
    let @8 = atomic_add((&(*_queue_rays).count), 1u) in
    let @10 = (*_queue_rays).x in
    @10[@8] = x
    let @13 = (*_queue_rays).n in
    @13[@8] = @1
    let @16 = (*_queue_rays)._sort_key in
    @16[@8] = @4
    return
  }
}


schedule {
    rays = run.queue(root, DeviceGlobal);
    run.sort(step, |x : f32| cast<i32>(x * (f32)4))
       .defer(step, rays)
       .bind(i, GPUThread)
       .bind(rays, GPUThread)
    step.defer(step, rays)

}
