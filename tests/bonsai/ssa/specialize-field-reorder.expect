type Clamp = struct Clamp{ floor : f32 }
type Float = f32
type Half = f16
type Mode = struct Mode{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x2 }
type Sum = struct Sum{ scale : f32; doubled : bool }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Mode_Clamp(_ret0 : mut (Mode*), floor : f32) -> void {
  let @0 = build<[[packed]] u8x3>(0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(floor) in
  let @2 = build<[[packed]] u32x2>(@1, 0u) in
  let @3 = build<Mode>(1u, @0, @2) in
  _ret0 = @3
  return
}

func [[export]] Mode_Sum(_ret1 : mut (Mode*), scale : f32, doubled : bool) -> void {
  let @0 = build<[[packed]] u8x3>(0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(scale) in
  let @2 = cast<u32>(doubled) in
  let @3 = build<[[packed]] u32x2>(@1, @2) in
  let @4 = build<Mode>(0u, @0, @3) in
  _ret1 = @4
  return
}

func [[noinline]] apply(mode : Mode, x : f32) -> f32 {
  scaled$r0 : mut f32
  let @0 = mode.tag in
  switch (@0) {
  case 0: { // Mode.Sum of apply
    let _t0 = mode.payload in
    let @2 = _t0[0u] in
    let scale = reinterpret_cast<f32>(@2) in
    let @4 = _t0[1u] in
    let @5 = @4 >> 0u in
    let @6 = @5 & 255u in
    let doubled = @6 != 0u in
    if (doubled) {
      let @8 = x * scale in
      let @9 = @8 * 2f in
      scaled$r0 = @9
    } else {
      let @10 = x * scale in
      scaled$r0 = @10
    }
    return (*scaled$r0)
  } break;
  default: { // Mode.Clamp of apply
    let @12 = mode.payload in
    let @13 = @12[0u] in
    let floor = reinterpret_cast<f32>(@13) in
    let @15 = max(x, floor) in
    return @15
  }
  }
}

func [[noinline]] apply!Clamp(mode : Mode, x : f32) -> f32 {
  let @16 = mode._pad in
  let _t0 = mode.payload in
  let mode!Clamp = build<Mode>(1u, @16, _t0) in
  let @13 = _t0[0u] in
  let floor = reinterpret_cast<f32>(@13) in
  let @15 = max(x, floor) in
  return @15
}

func [[noinline]] apply!Sum(mode : Mode, x : f32) -> f32 {
  scaled$r0 : mut f32
  let @16 = mode._pad in
  let _t0 = mode.payload in
  let mode!Sum = build<Mode>(0u, @16, _t0) in
  let @2 = _t0[0u] in
  let scale = reinterpret_cast<f32>(@2) in
  let @4 = _t0[1u] in
  let @5 = @4 >> 0u in
  let @6 = @5 & 255u in
  let doubled = @6 != 0u in
  if (doubled) {
    let @8 = x * scale in
    let @9 = @8 * 2f in
    scaled$r0 = @9
  } else {
    let @10 = x * scale in
    scaled$r0 = @10
  }
  return (*scaled$r0)
}

func [[noinline]] apply!Sum!False(mode : Mode, x : f32) -> f32 {
  let @17 = mode._pad in
  let @18 = mode.payload in
  let @19 = @18[0u] in
  let @20 = @18[1u] in
  let @21 = @20 & 4294967040u in
  let _t0 = build<[[packed]] u32x2>(@19, @21) in
  let mode!False = build<Mode>(0u, @17, _t0) in
  let mode!Sum = mode!False in
  let scale = reinterpret_cast<f32>(@19) in
  let @10 = x * scale in
  return @10
}

func [[noinline]] apply!Sum!True(mode : Mode, x : f32) -> f32 {
  let @17 = mode._pad in
  let @18 = mode.payload in
  let @19 = @18[0u] in
  let @20 = @18[1u] in
  let @21 = @20 & 4294967040u in
  let @22 = @21 | 1u in
  let _t0 = build<[[packed]] u32x2>(@19, @22) in
  let mode!True = build<Mode>(0u, @17, _t0) in
  let mode!Sum = mode!True in
  let scale = reinterpret_cast<f32>(@19) in
  let @8 = x * scale in
  let @9 = @8 * 2f in
  return @9
}

func [[export]] run(mode : (Mode*), values : f32[8], out : mut f32[32], sums : mut f32[4]) -> void {
  let @20 = (*mode).tag in
  switch (@20) {
  case 0: {
    let @50 = (*mode).payload in
    let @51 = @50[1u] in
    let @52 = @51 & 255u in
    let @53 = @52 != 0u in
    if (@53) {
      let @62 = (*mode) in
      let @63 = @62._pad in
      let @64 = @62.payload in
      let @65 = @64[0u] in
      let @66 = @64[1u] in
      let @67 = @66 & 4294967040u in
      let @68 = @67 | 1u in
      let @69 = build<[[packed]] u32x2>(@65, @68) in
      let @70 = build<Mode>(0u, @63, @69) in
      parfor i!Sum!True!prologue in [0:4:1] {
        sums[i!Sum!True] = 0f
        continue
      }
      parfor j!Sum!True in [0:8:1] {
        parfor i!Sum!True in [0:4:1] {
          let @48 = values[j!Sum!True] in
          let @3 = apply!Sum!True(@70, @48) in
          let @39 = i!Sum!True << 3 in
          let @40 = @39 + j!Sum!True in
          out[@40] = @3
          continue
        }
        continue
      }
    } else {
      let @54 = (*mode) in
      let @55 = @54._pad in
      let @56 = @54.payload in
      let @57 = @56[0u] in
      let @58 = @56[1u] in
      let @59 = @58 & 4294967040u in
      let @60 = build<[[packed]] u32x2>(@57, @59) in
      let @61 = build<Mode>(0u, @55, @60) in
      parfor i!Sum!False!prologue in [0:4:1] {
        sums[i!Sum!False] = 0f
        continue
      }
      parfor j!Sum!False in [0:8:1] {
        parfor i!Sum!False in [0:4:1] {
          let @38 = values[j!Sum!False] in
          let @3 = apply!Sum!False(@61, @38) in
          let @29 = i!Sum!False << 3 in
          let @30 = @29 + j!Sum!False in
          out[@30] = @3
          continue
        }
        continue
      }
    }
  } break;
  default: {
    parfor i!Clamp in [0:4:1] {
      let @25 = (*mode) in
      let @26 = @25._pad in
      let @27 = @25.payload in
      let @28 = build<Mode>(1u, @26, @27) in
      sums[i!Clamp] = 0f
      parfor j!Clamp in [0:8:1] {
        let @18 = values[j!Clamp] in
        let @3 = apply!Clamp(@28, @18) in
        let @13 = i!Clamp << 3 in
        let @14 = @13 + j!Clamp in
        out[@14] = @3
        continue
      }
      continue
    }
  }
  }
  return
}

func scaled(x : f32, scale : f32, doubled : bool) -> f32 {
  if (doubled) {
    let @0 = x * scale in
    let @1 = @0 * 2f in
    return @1
  } else {
    let @2 = x * scale in
    return @2
  }
}


schedule {
    run.specialize(mode)
       .specialize(Sum::doubled)
       .reorder(i!Sum, j!Sum)

}
