func pick(x : f32, t : f32[4]) -> f32 {
  acc : mut f32
  let @0 = 2f < x in
  if (@0) {
    let @1 = square_plus(x) in
    let @2 = @1 < 20f in
    if (@2) {
      acc = x
    } else {
      acc = 0f
    }
  } else {
    acc = 0f
  }
  let @3 = 1f < x in
  if (@3) {
    let @4 = tabled(x, t) in
    let @5 = @4 < 0.6f in
    if (@5) {
      let @7 = (*acc) + 1f in
      acc = @7
    }
  }
  return (*acc)
}

