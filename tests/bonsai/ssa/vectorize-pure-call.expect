    } else {
      acc = 0f
    }
  } else {
    acc = 0f
  }
  let @3 = 1f < x in
  if (@3) {
    let @4 = tabled(x, t) in
    let @5 = @4 < 0.6f in
    if (@5) {
      let @7 = (*acc) + 1f in
      acc = @7
    }
  }
  return (*acc)
}

