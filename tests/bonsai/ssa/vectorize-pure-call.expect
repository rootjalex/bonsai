func pick(x : f32, t : f32[4]) -> f32 {
  acc : mut f32
  let @0 = 2f < x in
  if (@0) {
    let @1 = square_plus(x) in
    let @9 = reinterpret_cast<i32>(@1) in
    let @10 = reinterpret_cast<i32>(20f) in
    let @11 = @9 < @10 in
    if (@11) {
