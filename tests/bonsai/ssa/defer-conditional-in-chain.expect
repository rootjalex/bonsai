; === ssa postschedule ===
; --- main ---
func main(): 
  out = alloc<f32[8]>()
  @0 = make_struct<f32[8]>((f32)0, (f32)0, (f32)0, (f32)0, (f32)0, (f32)0, (f32)0, (f32)0)
  store out @0
  @1 = make_struct<f32[8]>((f32)1, (f32)2, (f32)3, (f32)4, (f32)5, (f32)6, (f32)7, (f32)8)
  call run(@1, out) !run_call_cont_0(out)

!run_call_cont_0(out : f32[8]): // preds: main
  print(out)
  ret (i32)0

; --- run ---
; storage q.acc : f32 as q_acc_slots
; storage q.rest.w : f32 as q_rest_w
func run(values : f32[8], out : f32[8]): 
  q_acc_slots = alloca<f32[8]> scratch()
  q_rest_w = alloca<f32[8]> scratch()
  q__slot = alloca<i32[8]> scratch()
  q_queue = alloca<(Queue_q*)> scratch()
  @6 = make_struct<Queue_q>((u32)0, q__slot)
  store q_queue @6
  parfor i (i32)0:(i32)8:(i32)1 !par_body_0(values, out, q_acc_slots, q_rest_w, q_queue) q!drain(q_queue, values, q__slot, q_acc_slots, q_rest_w, out)

!par_body_0(i : i32, values : f32[8], out : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], q_queue : (Queue_q*)): // preds: run
  @5 = gep(q_acc_slots, i)
  store @5 (f32)0
  _t22 = extract_idx(values, i)
  w = add(_t22, (f32)1)
  @7 = gep(q_rest_w, i)
  store @7 w
  callc step(_t22, @5, q_queue, i) !step_deferred_3(@5, w, out, i)

!step_deferred_3(@30 : bool, acc : (f32*), w : f32, out : f32[8], i : i32): // preds: !par_body_0
  dispatch @30 [!step_call_cont_2!inline(acc, w, out, i), q!end()]

!step_call_cont_2!inline(acc : (f32*), w : f32, out : f32[8], i : i32): // preds: !step_deferred_3
  @31 = load(acc)
  @32 = add(@31, w)
  @33 = gep(out, i)
  store @33 @32
  yield

!par_cont_1(): // preds: q_rest!exit
  ret

!step_call_cont_2(acc : (f32*), w : f32, out : f32[8], i : i32): // preds: q_rest!run
  @2 = load(acc)
  @3 = add(@2, w)
  @4 = gep(out, i)
  store @4 @3
  yield

q!end(): // preds: !step_deferred_3
  yield

q!drain(q_queue : (Queue_q*), values : f32[8], q__slot : i32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8]): // preds: run
  @8 = load(q_queue)
  @9 = load_field(@8, (u32)0)
  parfor q (u32)0:@9:(u32)1 q!run(values, q__slot, q_acc_slots) q!exit(q_queue, q_acc_slots, q_rest_w, out)

q!run(q : u32, values : f32[8], q__slot : i32[8], q_acc_slots : f32[8]): // preds: q!drain
  @10 = extract_idx(q__slot, q)
  @11 = extract_idx(values, @10)
  @12 = gep(q_acc_slots, @10)
  call step!work!k(@11, @12) q!ran()

q!ran(): // preds: q!run
  yield

q!exit(q_queue : (Queue_q*), q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8]): // preds: q!drain
  @13 = field.ptr(q_queue, (u32)0)
  store @13 (u32)0
  jmp q_rest(q_acc_slots, q_rest_w, out)

q_rest(q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8]): // preds: q!exit
  parfor q_rest (i32)0:(i32)8:(i32)1 q_rest!run(q_acc_slots, q_rest_w, out) q_rest!exit()

q_rest!run(q_rest : i32, q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8]): // preds: q_rest
  @14 = gep(q_acc_slots, q_rest)
  @15 = gep(q_rest_w, q_rest)
  @16 = load(@15)
  jmp !step_call_cont_2(@14, @16, out, q_rest)

q_rest!exit(): // preds: q_rest
  jmp !par_cont_1()

; --- step ---
func step(x : f32, acc : (f32*), _queue_q : (Queue_q*), _slot_q : i32): 
  @0 = lt((f32)4, x)
  dispatch @0 [!merge_1(), !then_0(x, acc, _slot_q, _queue_q)]

!then_0(x : f32, acc : (f32*), _slot_q : i32, _queue_q : (Queue_q*)): // preds: step
  @1 = make_struct<Entry_q>(_slot_q)
  @2 = push _queue_q @1
  ret (bool)1

!merge_1(): // preds: step
  ret (bool)0

; --- step!after ---
func step!after(): 
  jmp !merge_1!after()

!merge_1!after(): // preds: step!after
  ret

; --- step!work!k ---
func step!work!k(x : f32, acc : (f32*)): 
  call work(x, acc) step!work!k!ran()

step!work!k!ran(): // preds: step!work!k
  call step!after() step!work!k!done()

step!work!k!done(): // preds: step!work!k!ran
  ret

; --- work ---
func work(x : f32, acc : (f32*)): 
  @0 = mul(x, (f32)0.5)
  acc.add acc @0
  ret

type Entry_q = struct Entry_q{ _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func main() -> i32 {
  alloc out : mut f32[8]
  let @0 = build<f32[8]>(0f, 0f, 0f, 0f, 0f, 0f, 0f, 0f) in
  out = @0
  let @1 = build<f32[8]>(1f, 2f, 3f, 4f, 5f, 6f, 7f, 8f) in
  run(@1, out)
  print(out)
  return 0
}

func run(values : f32[8], out : mut f32[8]) -> void {
  q_acc_slots : mut f32[8]
  q_rest_w : mut f32[8]
  q__slot : mut i32[8]
  q_queue : mut Queue_q
  let @6 = build<Queue_q>(0u, q__slot) in
  q_queue = @6
  parfor i in [0:8:1] {
    q_acc_slots[i] = 0f
    let _t22 = values[i] in
    let w = _t22 + 1f in
    q_rest_w[i] = w
    if (step(_t22, (&q_acc_slots[i]), q_queue, i)) {
      continue
    } else {
      let acc = (&q_acc_slots[i]) in
      let @31 = (*acc) in
      let @32 = @31 + w in
      out[i] = @32
      continue
    }
  }
  let @8 = (*q_queue) in
  let @9 = @8.count in
  parfor q in [0u:@9:1u] {
    let @10 = q__slot[q] in
    let @11 = values[@10] in
    step!work!k(@11, (&q_acc_slots[@10]))
    continue
  }
  q_queue.count = 0u
  parfor q_rest in [0:8:1] {
    let @16 = q_rest_w[q_rest] in
    let acc = (&q_acc_slots[q_rest]) in
    let w = @16 in
    let i = q_rest in
    let @2 = (*acc) in
    let @3 = @2 + w in
    out[i] = @3
    continue
  }
  return
}

func step(x : f32, acc : mut (f32*), _queue_q : mut (Queue_q*), _slot_q : i32) -> bool {
  let @0 = 4f < x in
  if (@0) {
    let @1 = build<Entry_q>(_slot_q) in
    let @4 = atomic_add((&(*_queue_q).count), 1u) in
    let @6 = (*_queue_q)._slot in
    @6[@4] = _slot_q
    return true
  } else {
    return false
  }
}

func step!after() -> void {
  return
}

func step!work!k(x : f32, acc : mut (f32*)) -> void {
  work(x, acc)
  step!after()
  return
}

func work(x : f32, acc : mut (f32*)) -> void {
  let @0 = x * 0.5f in
  acc += @0
  return
}


schedule {
    q = run.queue(root);
    step.defer(work, q)

}
