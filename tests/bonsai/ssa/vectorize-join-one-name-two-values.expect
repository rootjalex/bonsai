func [[export]] run(a : f32[8], flag : bool, out : mut f32[8]) -> void {
  let @0 = a[ramp(0, 1, 8)] in
  let @1 = walk$gang8_v0(@0, flag) in
  let i = ramp(0, 1, 8) in
  out[ramp(0, 1, 8)] = @1
  return
}

func [[export]] run_flat(a : f32[8], flag1 : bool, flag2 : bool, out : mut f32[8]) -> void {
  y$i6 : mut f32x8
  let x$i6 = a[ramp(0, 1, 8)] in
  if (flag1) {
    let @13 = f32x8(3f) in
    let @1 = x$i6 * @13 in
    y$i6 = @1
  } else {
    y$i6 = x$i6
