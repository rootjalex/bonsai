type Entry_rays = struct Entry_rays{ x : f32; n : i32 }
type Float = f32
type Half = f16
type Queue_rays = struct Queue_rays{ count : u32; x : f32[]; n : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[12], counts : u32[1], out : mut f32[4], done : mut f32[4]) -> void {
  parfor i in [0u:4u:1u] {
    rays!round : mut u32
    let m = counts[0] in
    rays_x_0 : mut f32[m]
    rays_n_0 : mut i32[m]
    rays_x_1 : mut f32[m]
    rays_n_1 : mut i32[m]
    rays_queue : mut Queue_rays[2]
    let @9 = build<Queue_rays>(0u, rays_x_0, rays_n_0) in
    rays_queue[0u] = @9
    let @11 = build<Queue_rays>(0u, rays_x_1, rays_n_1) in
    rays_queue[1u] = @11
    parfor j in [0u:m:1u] {
      let @1 = i * 3u in
      let @2 = @1 + j in
      let @3 = values[@2] in
      let @4 = cast<i32>(j) in
      let @14 = build<Entry_rays>(@3, @4) in
      let @33 = atomic_add((&rays_queue[0u].count), 1u) in
      let @35 = rays_queue[0u].x in
      @35[@33] = @3
      let @38 = rays_queue[0u].n in
      @38[@33] = @4
      continue
    }
    rays!round = 0u
    while (!(rays_queue[(*rays!round) & 1u].count == 0u)) {
      let @17 = (*rays!round) & 1u in
      let @19 = rays_queue[(*rays!round) & 1u].count in
      let @21 = @17 ^ 1u in
      rays_queue[@21].count = 0u
      parfor rays in [0u:@19:1u] {
        let @22 = (&rays_queue[@21]) in
        let @26 = rays_queue[@17].x in
        let @27 = @26[rays] in
        let @29 = rays_queue[@17].n in
        let @30 = @29[rays] in
        step(@27, @30, i, out, @22)
        continue
      }
      let @16 = (*rays!round) + 1u in
      rays!round = @16
    }
    parfor rays_rest in [0u:m:1u] {
      let @5 = done[i] in
      let @6 = @5 + 1f in
      done[i] = @6
      continue
    }
    continue
  }
  return
}

func step(x : f32, n : i32, i : u32, out : mut f32[4], _queue_rays : mut (Queue_rays*)) -> void {
  let @0 = out[i] in
  let @1 = @0 + x in
  out[i] = @1
  let @3 = n == 0 in
  if (@3) {
    return
  } else {
    let @4 = n - 1 in
    let @5 = build<Entry_rays>(x, @4) in
    let @8 = atomic_add((&(*_queue_rays).count), 1u) in
    let @10 = (*_queue_rays).x in
    @10[@8] = x
    let @13 = (*_queue_rays).n in
    @13[@8] = @4
    return
  }
}


schedule {
    rays = run.queue(i);
    run.defer(step, rays)
       .bind(i, CPUThread)
    step.defer(step, rays)

}
