//! flags: -p ssa

// The arena layout of lower/arena-rows.bonsai under the schedule of
// tiled-leaf-vectorized.bonsai: the node test four-wide over the children
// of a row read as element zero of an array of its shape at the offset, the
// leaf's tiles four-wide through the run that begins where the row does,
// the stack, and the prefetch of the hit children.
//
// What to read for. The children's gang reads the node's bounds through
// one address, `&tris.group0_arena[(tris_ref >> 4u) * 16u]` reinterpreted
// as an array of rows and indexed at zero, the same loads as the two-array
// layout makes; the leaf reads tile `_idx1` of the run at the row's
// address. The prefetch of a hit child is one statement with no switch on
// the kind: a node's row and a leaf's first tile are at the same address,
// the reference's upper bits, so Lower/Layouts.cpp
// (LowerReferencePrefetches) finds every arm's address the same -- `&a[0]`
// being `a` -- and fetches it once, the widest arm's bytes (144, a tile's),
// as Embree's BVH::prefetch does without asking what the reference points
// at. The hit an argmin keeps is the pair of the leaf's byte offset and the
// element's index in its run.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris(ref : u32 = 0u) {
        bytes : u32;
        indirect group arena[bytes] { byte : u8; };
        switch ref[0:3] {
            0 => Interior from arena[ref[4:31] * 16u] {
                children : vector[u32, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:31] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, (ref[0:3] - 8u) * 4u);
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    trace.prefetch(tris.Interior.children);
}
