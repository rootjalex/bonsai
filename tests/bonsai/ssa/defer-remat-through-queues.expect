type Entry_hits = struct Entry_hits{ depth : i32; _slot : i32 }
type Entry_rays = struct Entry_rays{ depth : i32; _slot : i32 }
type Float = f32
type Half = f16
type Queue_hits = struct Queue_hits{ count : u32; depth : i32[]; _slot : i32[] }
type Queue_rays = struct Queue_rays{ count : u32; depth : i32[]; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func render(max_depth : i32, film : mut f32[8]) -> void {
  rays!round : mut u32
  rays_rad_slots : mut f32[8]
  rays_depth : mut i32[8]
  rays__slot : mut i32[8]
  rays_queue : mut Queue_rays
  let @5 = build<Queue_rays>(0u, rays_depth, rays__slot) in
  rays_queue = @5
  hits_depth : mut i32[8]
  hits__slot : mut i32[8]
  hits_queue : mut Queue_hits
  parfor p in [0:8:1] {
    rays_rad_slots[p] = 0f
    let @27 = p < 4 in
    let @28 = p - 4 in
    let @0 = select(@27, p, @28) in
    let @1 = @0 + 1 in
    let @6 = build<Entry_rays>(0, p) in
    let @45 = atomic_add((&(*rays_queue).count), 1u) in
    let @47 = (*rays_queue).depth in
    @47[@45] = 0
    let @50 = (*rays_queue)._slot in
    @50[@45] = p
    continue
  }
  rays!round = 0u
  while (!((*rays_queue).count == 0u)) {
    let @9 = (*rays_queue).count in
    let @18 = build<Queue_hits>(0u, hits_depth, hits__slot) in
    hits_queue = @18
    parfor rays in [0u:@9:1u] {
      let @12 = rays__slot[rays] in
      let @29 = @12 >> 31 in
      let @30 = reinterpret_cast<u32>(@29) in
      let @31 = @30 >> 30u in
      let @32 = reinterpret_cast<i32>(@31) in
      let @33 = @12 + @32 in
      let @34 = @33 >> 2 in
      let @35 = @34 * 4 in
      let @13 = @12 - @35 in
      let @14 = @13 + 1 in
      let @15 = rays_depth[rays] in
      step(@14, @15, @12, max_depth, (&rays_rad_slots[@12]), rays_queue, @12, hits_queue, @12)
      continue
    }
    rays_queue.count = 0u
    let @19 = (*hits_queue) in
    let @20 = @19.count in
    parfor hits in [0u:@20:1u] {
      let @21 = hits__slot[hits] in
      let @36 = @21 >> 31 in
      let @37 = reinterpret_cast<u32>(@36) in
      let @38 = @37 >> 30u in
      let @39 = reinterpret_cast<i32>(@38) in
      let @40 = @21 + @39 in
      let @41 = @40 >> 2 in
      let @42 = @41 * 4 in
      let @22 = @21 - @42 in
      let @23 = @22 + 1 in
      let @24 = hits_depth[hits] in
      shade(@23, @24, undef, max_depth, (&rays_rad_slots[@21]), rays_queue, @21)
      continue
    }
    hits_queue.count = 0u
    let @7 = (*rays!round) + 1u in
    rays!round = @7
  }
  parfor rays_rest in [0:8:1] {
    let rad = (&rays_rad_slots[rays_rest]) in
    let p = rays_rest in
    let @2 = (*rad) in
    film[p] = @2
    continue
  }
  return
}

func shade(x : i32, depth : i32, p : i32, max_depth : i32, rad : mut (f32*), _queue_rays : mut (Queue_rays*), _slot_rays : i32) -> void {
  let _t22 = depth + 1 in
  let @1 = x * _t22 in
  let @2 = cast<f32>(@1) in
  rad += @2
  let @3 = max_depth <= _t22 in
  if (@3) {
    return
  } else {
    let @4 = build<Entry_rays>(_t22, _slot_rays) in
    let @7 = atomic_add((&(*_queue_rays).count), 1u) in
    let @9 = (*_queue_rays).depth in
    @9[@7] = _t22
    let @12 = (*_queue_rays)._slot in
    @12[@7] = _slot_rays
    return
  }
}

func step(x : i32, depth : i32, p : i32, max_depth : i32, rad : mut (f32*), _queue_rays : mut (Queue_rays*), _slot_rays : i32, _queue_hits : mut (Queue_hits*), _slot_hits : i32) -> void {
  let @0 = p + depth in
  let @4 = mulhi(@0, 1431655766) in
  let @5 = @4 >> 31 in
  let @6 = reinterpret_cast<u32>(@5) in
  let @7 = @6 >> 31u in
  let @8 = reinterpret_cast<i32>(@7) in
  let @9 = @4 + @8 in
  let @10 = @9 * 3 in
  let @1 = @0 - @10 in
  let @2 = @1 == 0 in
  if (@2) {
    rad += 0.5f
    return
  } else {
    let @3 = build<Entry_hits>(depth, _slot_hits) in
    let @13 = atomic_add((&(*_queue_hits).count), 1u) in
    let @15 = (*_queue_hits).depth in
    @15[@13] = depth
    let @18 = (*_queue_hits)._slot in
    @18[@13] = _slot_hits
    return
  }
}


schedule {
    hits = render.queue(root);
    rays = render.queue(root);
    render.defer(step, rays)
    shade.defer(step, rays)
    step.defer(shade, hits)

}
