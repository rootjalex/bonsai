type Entry_queue = struct Entry_queue{ i : i32; acc : f32 }
type Queue_queue = struct Queue_queue{ count : u32; i : i32[]; acc : f32[] }
type Saved_stupid_sum = struct Saved_stupid_sum{ saved : bool; value : f32 }

func compute(n : i32, a : f32[n], res : mut (f32*)) -> void {
  queue!round : mut u32
  queue_i_0 : mut i32[1]
  queue_acc_0 : mut f32[1]
  queue_i_1 : mut i32[1]
  queue_acc_1 : mut f32[1]
  queue_queue : mut Queue_queue[2]
  let @1 = build<Queue_queue>(0u, queue_i_0, queue_acc_0) in
  queue_queue[0u] = @1
  let @3 = build<Queue_queue>(0u, queue_i_1, queue_acc_1) in
  queue_queue[1u] = @3
  let @6 = stupid_sum(0, n, a, 0f, (&queue_queue[0u])) in
  let @7 = @6.saved in
  let @8 = @6.value in
  if (!@7) {
    let @0 = @8 in
    res = @0
  }
  queue!round = 0u
  while (!(queue_queue[(*queue!round) & 1u].count == 0u)) {
    let @10 = (*queue!round) & 1u in
    let @12 = queue_queue[(*queue!round) & 1u].count in
    let @14 = @10 ^ 1u in
    queue_queue[@14].count = 0u
    parfor queue in [0u:@12:1u] {
      let @15 = (&queue_queue[@14]) in
      let @19 = queue_queue[@10].i in
      let @20 = @19[queue] in
      let @22 = queue_queue[@10].acc in
      let @23 = @22[queue] in
      let @24 = stupid_sum(@20, n, a, @23, @15) in
      let @25 = @24.saved in
      let @26 = @24.value in
      if (@25) {
        continue
      } else {
        let @0 = @26 in
        res = @0
        continue
      }
    }
    let @9 = (*queue!round) + 1u in
    queue!round = @9
  }
  return
}

func [[noinline]] stupid_sum(i : i32, n : i32, a : f32[n], acc : f32, _queue_queue : mut (Queue_queue*)) -> Saved_stupid_sum {
  let @0 = i == n in
  if (@0) {
    let @5 = build<Saved_stupid_sum>(false, acc) in
    return @5
  } else {
    let @1 = i + 1 in
    let @2 = a[i] in
    let @3 = acc + @2 in
    let @6 = build<Entry_queue>(@1, @3) in
    let @10 = atomic_add((&(*_queue_queue).count), 1u) in
    let @12 = (*_queue_queue).i in
    @12[@10] = @1
    let @15 = (*_queue_queue).acc in
    @15[@10] = @3
    let @8 = build<Saved_stupid_sum>(true, undef) in
    return @8
  }
}


schedule host {
    queue = compute.queue(root);
    stupid_sum.defer(stupid_sum, queue)

}
