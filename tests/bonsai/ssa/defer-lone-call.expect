type Entry_queue = struct Entry_queue{ i : i32; acc : f32; _slot : u32 }
type Queue_queue = struct Queue_queue{ count : u32; i : i32[]; acc : f32[]; _slot : u32[] }

func compute(n : i32, a : f32[n], res : mut (f32*)) -> void {
  queue!round : mut u32
  queue_ran : mut u8[1]
  let @1 = fill_bytes(queue_ran, 0u, 1u) in
  queue_result : mut f32[1]
  queue_i_0 : mut i32[1]
  queue_acc_0 : mut f32[1]
  queue__slot_0 : mut u32[1]
  queue_i_1 : mut i32[1]
  queue_acc_1 : mut f32[1]
  queue__slot_1 : mut u32[1]
  queue_queue : mut Queue_queue[2]
  let @3 = build<Queue_queue>(0u, queue_i_0, queue_acc_0, queue__slot_0) in
  queue_queue[0u] = @3
  let @5 = build<Queue_queue>(0u, queue_i_1, queue_acc_1, queue__slot_1) in
  queue_queue[1u] = @5
  let @8 = stupid_sum(0, n, a, 0f, (&queue_queue[0u]), (&queue_result[0u]), 0u) in
  let @9 = res in
  let @10 = @8.set in
  let @11 = @8.value in
  if (@10) {
    let @0 = @11 in
    res = @0
    return
  } else {
    queue_ran[0u] = 1u
    queue!round = 0u
    while (!(queue_queue[(*queue!round) & 1u].count == 0u)) {
      let @14 = (*queue!round) & 1u in
      let @16 = queue_queue[(*queue!round) & 1u].count in
      let @18 = @14 ^ 1u in
      queue_queue[@18].count = 0u
      parfor queue in [0u:@16:1u] {
        let @19 = (&queue_queue[@18]) in
        let @23 = queue_queue[@14].i in
        let @24 = @23[queue] in
        let @26 = queue_queue[@14].acc in
        let @27 = @26[queue] in
        let @29 = queue_queue[@14]._slot in
        let @30 = @29[queue] in
        stupid_sum(@24, n, a, @27, @19, (&queue_result[@30]), @30)
        continue
      }
      let @13 = (*queue!round) + 1u in
      queue!round = @13
    }
    parfor queue_rest in [0u:1u:1u] {
      let @35 = queue_result[queue_rest] in
      let @37 = queue_ran[queue_rest] in
      switch (@37) {
      case 0: {
        continue
      } break;
      default: {
        let @32 = @35 in
        let @33 = res in
        @33 = @32
        continue
      }
      }
    }
    return
  }
}

func stupid_sum(i : i32, n : i32, a : f32[n], acc : f32, _queue_queue : mut (Queue_queue*), _result_queue : mut (f32*), _slot_queue : u32) -> _option_queue {
  let @0 = i == n in
  if (@0) {
    _result_queue = acc
    let @5 = build<_option_queue>(acc, true) in
    return @5
  } else {
    let @1 = i + 1 in
    let @2 = a[i] in
    let @3 = acc + @2 in
    let @6 = build<Entry_queue>(@1, @3, _slot_queue) in
    let @7 = build<_option_queue>(undef, false) in
    let @10 = atomic_add((&(*_queue_queue).count), 1u) in
    let @12 = (*_queue_queue).i in
    @12[@10] = @1
    let @15 = (*_queue_queue).acc in
    @15[@10] = @3
    let @18 = (*_queue_queue)._slot in
    @18[@10] = _slot_queue
    return @7
  }
}


schedule {
    queue = compute.queue(root);
    stupid_sum.defer(stupid_sum, queue)

}
