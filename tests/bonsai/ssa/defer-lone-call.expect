type Entry_queue = struct Entry_queue{ i : i32; acc : f32; _result : (f32*) }
type Queue_queue = struct Queue_queue{ count : u32; i : i32[]; acc : f32[]; _result : (f32*)[] }

func compute(n : i32, a : f32[n], res : mut (f32*)) -> void {
  queue!round : mut u32
  queue_result : mut f32[1]
  queue_i_0 : mut i32[1]
  queue_acc_0 : mut f32[1]
  queue__result_0 : mut (f32*)[1]
  queue_i_1 : mut i32[1]
  queue_acc_1 : mut f32[1]
  queue__result_1 : mut (f32*)[1]
  queue_queue : mut Queue_queue[2]
  let @1 = build<Queue_queue>(0u, queue_i_0, queue_acc_0, queue__result_0) in
  queue_queue[0u] = @1
  let @3 = build<Queue_queue>(0u, queue_i_1, queue_acc_1, queue__result_1) in
  queue_queue[1u] = @3
  stupid_sum(0, n, a, 0f, (&queue_queue[0u]), (&queue_result[0u]))
  queue!round = 0u
  while (!(queue_queue[(*queue!round) & 1u].count == 0u)) {
    let @8 = (*queue!round) & 1u in
    let @10 = queue_queue[(*queue!round) & 1u].count in
    let @12 = @8 ^ 1u in
    queue_queue[@12].count = 0u
    parfor queue in [0u:@10:1u] {
      let @13 = (&queue_queue[@12]) in
      let @17 = queue_queue[@8].i in
      let @18 = @17[queue] in
      let @20 = queue_queue[@8].acc in
      let @21 = @20[queue] in
      let @23 = queue_queue[@8]._result in
      let @24 = @23[queue] in
      stupid_sum(@18, n, a, @21, @13, @24)
      continue
    }
    let @7 = (*queue!round) + 1u in
    queue!round = @7
  }
  parfor queue_rest in [0u:1u:1u] {
    let @26 = queue_result[queue_rest] in
    let @0 = @26 in
    res = @0
    continue
  }
  return
}

func [[noinline]] stupid_sum(i : i32, n : i32, a : f32[n], acc : f32, _queue_queue : mut (Queue_queue*), _result_queue : mut (f32*)) -> void {
  let @0 = i == n in
  if (@0) {
    _result_queue = acc
    return
  } else {
    let @1 = i + 1 in
    let @2 = a[i] in
    let @3 = acc + @2 in
    let @5 = build<Entry_queue>(@1, @3, _result_queue) in
    let @8 = atomic_add((&(*_queue_queue).count), 1u) in
    let @10 = (*_queue_queue).i in
    @10[@8] = @1
    let @13 = (*_queue_queue).acc in
    @13[@8] = @3
    let @16 = (*_queue_queue)._result in
    @16[@8] = _result_queue
    return
  }
}


schedule host {
    queue = compute.queue(root);
    stupid_sum.defer(stupid_sum, queue)

}
