type Entry_sums = struct Entry_sums{ n : i32; acc : i32; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }

func run(n : i32, out : mut i32[n]) -> void {
  let @5 = n * 4 in
  alloc sums_ran : mut u8[@5]
  alloc sums_result : mut i32[@5]
  alloc sums_n_0 : mut i32[@5]
  alloc sums_acc_0 : mut i32[@5]
  alloc sums__slot_0 : mut i32[@5]
  alloc sums_n_1 : mut i32[@5]
  alloc sums_acc_1 : mut i32[@5]
  alloc sums__slot_1 : mut i32[@5]
  sums_queue : mut Queue_sums[2]
  parfor r in [0:2:1] {
    sums!round : mut u32
    let @6 = fill_bytes(sums_ran, 0u, @5) in
    let @10 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__slot_0) in
    sums_queue[0u] = @10
    let @12 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__slot_1) in
    sums_queue[1u] = @12
    parfor i in [0:n:1] {
      parfor j in [0:4:1] {
        let @0 = i + j in
        let @7 = i * 4 in
        let @8 = @7 + j in
        let @15 = tally(@0, r, (&sums_queue[0u]), (&sums_result[@8]), @8) in
        let @16 = out in
        let @17 = i in
        let @18 = @15.set in
        let @19 = @15.value in
        if (@18) {
          let @1 = @19 in
          let v = @1 in
          let @2 = out[i] in
          let @3 = @2 + v in
          out[i] = @3
          continue
        } else {
          sums_ran[@8] = 1u
          continue
        }
      }
      continue
    }
    sums!round = 0u
    while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
      let @22 = (*sums!round) & 1u in
      let @24 = sums_queue[(*sums!round) & 1u].count in
      let @26 = @22 ^ 1u in
      sums_queue[@26].count = 0u
      parfor sums in [0u:@24:1u] {
        let @27 = (&sums_queue[@26]) in
        let @31 = sums_queue[@22].n in
        let @32 = @31[sums] in
        let @34 = sums_queue[@22].acc in
        let @35 = @34[sums] in
        let @37 = sums_queue[@22]._slot in
        let @38 = @37[sums] in
        tally(@32, @35, @27, (&sums_result[@38]), @38)
        continue
      }
      let @21 = (*sums!round) + 1u in
      sums!round = @21
    }
    parfor sums_rest in [0:@5:1] {
      let @47 = sums_result[sums_rest] in
      let @51 = sums_rest >> 31 in
      let @52 = reinterpret_cast<u32>(@51) in
      let @53 = @52 >> 30u in
      let @54 = reinterpret_cast<i32>(@53) in
      let @55 = sums_rest + @54 in
      let @48 = @55 >> 2 in
      let @50 = sums_ran[sums_rest] in
      switch (@50) {
      case 0: {
        continue
      } break;
      default: {
        let @43 = @47 in
        let @44 = out in
        let @45 = @48 in
        let v = @43 in
        let @40 = @44[@45] in
        let @41 = @40 + v in
        @44[@45] = @41
        continue
      }
      }
    }
    continue
  }
  free(sums_ran)
  free(sums_result)
  free(sums_n_0)
  free(sums_acc_0)
  free(sums__slot_0)
  free(sums_n_1)
  free(sums_acc_1)
  free(sums__slot_1)
  return
}

func tally(n : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  let @0 = n <= 0 in
  if (@0) {
    _result_sums = acc
    let @4 = build<_option_sums>(acc, true) in
    return @4
  } else {
    let @1 = n - 1 in
    let @2 = acc + n in
    let @5 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @6 = build<_option_sums>(undef, false) in
    let @9 = atomic_add((&(*_queue_sums).count), 1u) in
    let @11 = (*_queue_sums).n in
    @11[@9] = @1
    let @14 = (*_queue_sums).acc in
    @14[@9] = @2
    let @17 = (*_queue_sums)._slot in
    @17[@9] = _slot_sums
    return @6
  }
}


schedule {
    sums = run.queue(r);
    tally.defer(tally, sums)

}
