func [[export]] countdown(n : u32) -> u32 {
  i : mut u32
  steps : mut u32
  i = n
  steps = 0u
  while (0u < (*i)) {
    let @3 = (*i) - 1u in
    let @5 = (*steps) + 1u in
    i = @3
    steps = @5
  }
  return (*steps)
}

func [[export]] doubling(n : u32) -> u32 {
  total : mut u32
  total = 1u
  do {
    let @1 = (*total) << 1u in
    let @3 = @1 < n in
    total = @1
  } while (@3)
  return @1
}


