func divergent(a : f32[8], out : mut f32[8]) -> void {
  let _t1 = a[ramp(0, 1, 8)] in
  let @8 = f32x8(0f) in
  let @1 = _t1 < @8 in
  let @12 = !@1 in
  let @6 = reduce<any>(@1) in
  if (@6) {
    masked_store(out[ramp(0, 1, 8)], @8, @1)
  }
  let @5 = reduce<any>(@12) in
  if (@5) {
    masked_store(out[ramp(0, 1, 8)], _t1, @12)
  }
  return
}

func nested(a : f32[8], out : mut f32[8]) -> void {
  let _t3 = a[ramp(0, 1, 8)] in
  let @13 = f32x8(0f) in
  let @1 = _t3 < @13 in
  let @9 = reduce<any>(@1) in
  if (@9) {
    let @16 = f32x8(-5f) in
    let @2 = _t3 < @16 in
    let @22 = !@2 in
    let @7 = @1 && @22 in
    let @8 = @1 && @2 in
    let @11 = reduce<any>(@8) in
    if (@11) {
      let @19 = f32x8(-2f) in
      masked_store(out[ramp(0, 1, 8)], @19, @8)
    }
    let @10 = reduce<any>(@7) in
    if (@10) {
      let @20 = f32x8(-1f) in
      masked_store(out[ramp(0, 1, 8)], @20, @7)
    }
  }
  return
}

func one_sided(a : f32[8], out : mut f32[8]) -> void {
  let _t5 = a[ramp(0, 1, 8)] in
  let @7 = f32x8(0f) in
  let @1 = @7 < _t5 in
  let @5 = reduce<any>(@1) in
  if (@5) {
    let @10 = f32x8(10f) in
    let @2 = _t5 * @10 in
    masked_store(out[ramp(0, 1, 8)], @2, @1)
  }
  return
}

func uniform_outer(a : f32[8], flag : f32, out : mut f32[8]) -> void {
  let @0 = flag < 0f in
  if (@0) {
    let @10 = f32x8(0f) in
    out[ramp(0, 1, 8)] = @10
  } else {
    let @2 = a[ramp(0, 1, 8)] in
    let @11 = f32x8(0f) in
    let @3 = @2 < @11 in
    let @16 = !@3 in
    let @8 = reduce<any>(@3) in
    if (@8) {
      let @14 = f32x8(1f) in
      masked_store(out[ramp(0, 1, 8)], @14, @3)
    }
    let @7 = reduce<any>(@16) in
    if (@7) {
      let @15 = f32x8(2f) in
      masked_store(out[ramp(0, 1, 8)], @15, @16)
    }
  }
  return
}


schedule {
    divergent.vectorize(i)
    nested.vectorize(i)
    one_sided.vectorize(i)
    uniform_outer.vectorize(i)

}
