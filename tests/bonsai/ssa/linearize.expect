func divergent(a : f32[8], out : mut f32[8]) -> void {
  let _t1 = a[ramp(0, 1, 8)] in
  let @6 = f32x8(0f) in
  let @1 = _t1 < @6 in
  let @7 = boolx8(false) in
  let @8 = boolx8(true) in
  let @4 = select(@1, @7, @8) in
  let @9 = f32x8(0f) in
  masked_store(out[ramp(0, 1, 8)], @9, @1)
  masked_store(out[ramp(0, 1, 8)], _t1, @4)
  return
}

func nested(a : f32[8], out : mut f32[8]) -> void {
  let _t3 = a[ramp(0, 1, 8)] in
  let @10 = f32x8(0f) in
  let @1 = _t3 < @10 in
  let @11 = boolx8(false) in
  let @12 = boolx8(true) in
  let @5 = select(@1, @11, @12) in
  let @13 = f32x8(-5f) in
  let @2 = _t3 < @13 in
  let @14 = boolx8(false) in
  let @15 = boolx8(true) in
  let @6 = select(@2, @14, @15) in
  let @7 = @1 && @6 in
  let @8 = @1 && @2 in
  let @16 = f32x8(-2f) in
  masked_store(out[ramp(0, 1, 8)], @16, @8)
  let @17 = f32x8(-1f) in
  masked_store(out[ramp(0, 1, 8)], @17, @7)
  return
}

func one_sided(a : f32[8], out : mut f32[8]) -> void {
  let _t5 = a[ramp(0, 1, 8)] in
  let @6 = f32x8(0f) in
  let @1 = @6 < _t5 in
  let @7 = boolx8(false) in
  let @8 = boolx8(true) in
  let @4 = select(@1, @7, @8) in
  let @9 = f32x8(10f) in
  let @2 = _t5 * @9 in
  masked_store(out[ramp(0, 1, 8)], @2, @1)
  return
}

func uniform_outer(a : f32[8], flag : f32, out : mut f32[8]) -> void {
  let @0 = flag < 0f in
  if (@0) {
    let @8 = f32x8(0f) in
    out[ramp(0, 1, 8)] = @8
  } else {
    let @2 = a[ramp(0, 1, 8)] in
    let @9 = f32x8(0f) in
    let @3 = @2 < @9 in
    let @10 = boolx8(false) in
    let @11 = boolx8(true) in
    let @6 = select(@3, @10, @11) in
    let @12 = f32x8(1f) in
    masked_store(out[ramp(0, 1, 8)], @12, @3)
    let @13 = f32x8(2f) in
    masked_store(out[ramp(0, 1, 8)], @13, @6)
  }
  return
}


schedule host {
    divergent.vectorize(i)
    nested.vectorize(i)
    one_sided.vectorize(i)
    uniform_outer.vectorize(i)

}
