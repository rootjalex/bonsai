type Float = f32
type Half = f16
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func main() -> i32 {
  total : mut f32
  total = 0f
  alloc counts : mut f32[8]
  let @0 = build<f32[8]>(0f, 0f, 0f, 0f, 0f, 0f, 0f, 0f) in
  counts = @0
  let @1 = build<f32[8]>(1f, 4f, 9f, 11f, 2f, 15f, 3f, 20f) in
  run(@1, total, counts)
  let @2 = (*total) in
  print(@2)
  print(counts)
  return 0
}

func run(values : f32[8], total : mut (f32*), counts : mut f32[8]) -> void {
  n : mut f32
  parfor i in [0:8:1] {
    n = 0f
    let @0 = values[i] in
    step(@0, total, n)
    let @1 = (*n) in
    counts[i] = @1
    continue
  }
  return
}

func step(x : f32, total : mut (f32*), n : mut (f32*)) -> void {
  let @0 = wet(x, total) in
  n += @0
  total += x
  return
}

func wet(x : f32, total : mut (f32*)) -> f32 {
  let @0 = x * 0.5f in
  total += @0
  return 1f
}


