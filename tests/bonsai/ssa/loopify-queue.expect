func visit(node : i32, out : mut i32[16], depth : i32) -> void {
  !stack : mut i32[64]
  !stack0 : mut i32[64]
  !count : mut u32
  !stack[0u] = node
  !stack0[0u] = depth
  !count = 1u
  while ((*!count) != 0u) {
    let @9 = (*!count) in
    let @10 = @9 - 1u in
    !count = @10
    let @11 = !stack[@10] in
    let @12 = !stack0[@10] in
    let node!top = @11 in
    let depth!top = @12 in
    let @0 = depth!top <= 0 in
    if (!@0) {
      out[node!top] = depth!top
      let _t0 = node!top << 1 in
      let _t1 = depth!top - 1 in
      let @13 = (*!count) in
      !stack[@13] = _t0
      !stack0[@13] = _t1
      let @16 = @13 + 1u in
      !count = @16
      let @4 = _t0 + 1 in
      let @17 = (*!count) in
      !stack[@17] = @4
      !stack0[@17] = _t1
      let @20 = @17 + 1u in
      !count = @20
    }
  }
  return
}


schedule host {
    visit.loopify((i32)64)

}
