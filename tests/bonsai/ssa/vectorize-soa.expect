type vec3f = f32x3

func components(inp : f32x3[8], out : mut f32[8]) -> void {
  let @8 = reinterpret_cast<f32[]>(inp) in
  let @9 = sizeof(f32x3) in
  let @10 = sizeof(f32) in
  let @11 = @9 / @10 in
  let @25 = i32x8(@11) in
  let @12 = ramp(0, 1, 8) * @25 in
  let @26 = i32x8(0) in
  let @13 = @12 + @26 in
  let @14 = @8[@13] in
  let @27 = i32x8(1) in
  let @15 = @12 + @27 in
  let @16 = @8[@15] in
  let @28 = i32x8(2) in
  let @17 = @12 + @28 in
  let @18 = @8[@17] in
  let @1 = f32x3(2f) in
  let @19 = @1[0u] in
  let @29 = f32x8(@19) in
  let @20 = @14 * @29 in
  let @21 = @1[1u] in
  let @30 = f32x8(@21) in
  let @22 = @16 * @30 in
  let @23 = @1[2u] in
  let @31 = f32x8(@23) in
  let @24 = @18 * @31 in
  let @5 = @20 + @24 in
  out[ramp(0, 1, 8)] = @5
  return
}

func length_squared(v : f32x3) -> f32 {
  let @0 = v[0u] in
  let @1 = v[0u] in
  let @2 = @0 * @1 in
  let @3 = v[1u] in
  let @4 = v[1u] in
  let @5 = @3 * @4 in
  let @6 = @2 + @5 in
  let @7 = v[2u] in
  let @8 = v[2u] in
  let @9 = @7 * @8 in
  let @10 = @6 + @9 in
  return @10
}

func through_a_call(inp : f32x3[8], out : mut f32[8]) -> void {
  let @19 = reinterpret_cast<f32[]>(inp) in
  let @20 = sizeof(f32x3) in
  let @21 = sizeof(f32) in
  let @22 = @20 / @21 in
  let @85 = i32x8(@22) in
  let @23 = ramp(0, 1, 8) * @85 in
  let @86 = i32x8(0) in
  let @24 = @23 + @86 in
  let @25 = @19[@24] in
  let @87 = i32x8(1) in
  let @26 = @23 + @87 in
  let @27 = @19[@26] in
  let @88 = i32x8(2) in
  let @28 = @23 + @88 in
  let @29 = @19[@28] in
  let @30 = reinterpret_cast<f32[]>(inp) in
  let @31 = sizeof(f32x3) in
  let @32 = sizeof(f32) in
  let @33 = @31 / @32 in
  let @89 = i32x8(@33) in
  let @34 = ramp(0, 1, 8) * @89 in
  let @90 = i32x8(0) in
  let @35 = @34 + @90 in
  let @36 = @30[@35] in
  let @91 = i32x8(1) in
  let @37 = @34 + @91 in
  let @38 = @30[@37] in
  let @92 = i32x8(2) in
  let @39 = @34 + @92 in
  let @40 = @30[@39] in
  let @4 = @25 * @36 in
  let @41 = reinterpret_cast<f32[]>(inp) in
  let @42 = sizeof(f32x3) in
  let @43 = sizeof(f32) in
  let @44 = @42 / @43 in
  let @93 = i32x8(@44) in
  let @45 = ramp(0, 1, 8) * @93 in
  let @94 = i32x8(0) in
  let @46 = @45 + @94 in
  let @47 = @41[@46] in
  let @95 = i32x8(1) in
  let @48 = @45 + @95 in
  let @49 = @41[@48] in
  let @96 = i32x8(2) in
  let @50 = @45 + @96 in
  let @51 = @41[@50] in
  let @52 = reinterpret_cast<f32[]>(inp) in
  let @53 = sizeof(f32x3) in
  let @54 = sizeof(f32) in
  let @55 = @53 / @54 in
  let @97 = i32x8(@55) in
  let @56 = ramp(0, 1, 8) * @97 in
  let @98 = i32x8(0) in
  let @57 = @56 + @98 in
  let @58 = @52[@57] in
  let @99 = i32x8(1) in
  let @59 = @56 + @99 in
  let @60 = @52[@59] in
  let @100 = i32x8(2) in
  let @61 = @56 + @100 in
  let @62 = @52[@61] in
  let @9 = @49 * @60 in
  let @10 = @4 + @9 in
  let @63 = reinterpret_cast<f32[]>(inp) in
  let @64 = sizeof(f32x3) in
  let @65 = sizeof(f32) in
  let @66 = @64 / @65 in
  let @101 = i32x8(@66) in
  let @67 = ramp(0, 1, 8) * @101 in
  let @102 = i32x8(0) in
  let @68 = @67 + @102 in
  let @69 = @63[@68] in
  let @103 = i32x8(1) in
  let @70 = @67 + @103 in
  let @71 = @63[@70] in
  let @104 = i32x8(2) in
  let @72 = @67 + @104 in
  let @73 = @63[@72] in
  let @74 = reinterpret_cast<f32[]>(inp) in
  let @75 = sizeof(f32x3) in
  let @76 = sizeof(f32) in
  let @77 = @75 / @76 in
  let @105 = i32x8(@77) in
  let @78 = ramp(0, 1, 8) * @105 in
  let @106 = i32x8(0) in
  let @79 = @78 + @106 in
  let @80 = @74[@79] in
  let @107 = i32x8(1) in
  let @81 = @78 + @107 in
  let @82 = @74[@81] in
  let @108 = i32x8(2) in
  let @83 = @78 + @108 in
  let @84 = @74[@83] in
  let @15 = @73 * @84 in
  let @16 = @10 + @15 in
  out[ramp(0, 1, 8)] = @16
  return
}

func uniform_meets_varying(inp : f32x3[8], origin : f32x3, out : mut f32[8]) -> void {
  let @9 = reinterpret_cast<f32[]>(inp) in
  let @10 = sizeof(f32x3) in
  let @11 = sizeof(f32) in
  let @12 = @10 / @11 in
  let @26 = i32x8(@12) in
  let @13 = ramp(0, 1, 8) * @26 in
  let @27 = i32x8(0) in
  let @14 = @13 + @27 in
  let @15 = @9[@14] in
  let @28 = i32x8(1) in
  let @16 = @13 + @28 in
  let @17 = @9[@16] in
  let @29 = i32x8(2) in
  let @18 = @13 + @29 in
  let @19 = @9[@18] in
  let @20 = origin[0u] in
  let @30 = f32x8(@20) in
  let @21 = @15 - @30 in
  let @22 = origin[1u] in
  let @31 = f32x8(@22) in
  let @23 = @17 - @31 in
  let @24 = origin[2u] in
  let @32 = f32x8(@24) in
  let @25 = @19 - @32 in
  let @4 = @21 + @23 in
  let @6 = @4 + @25 in
  out[ramp(0, 1, 8)] = @6
  return
}


schedule host {
    components.vectorize(i)
    through_a_call.vectorize(i)
    uniform_meets_varying.vectorize(i)

}
