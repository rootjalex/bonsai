type vec3f = f32x3

func components(inp : f32x3[8], out : mut f32[8]) -> void {
  let @8 = reinterpret_cast<f32[]>(inp) in
  let @9 = sizeof(f32x3) in
  let @10 = sizeof(f32) in
  let @11 = @9 / @10 in
  let @25 = i32x8(@11) in
  let @12 = ramp(0, 1, 8) * @25 in
  let @26 = i32x8(0) in
  let @13 = @12 + @26 in
  let @14 = @8[@13] in
  let @27 = i32x8(1) in
  let @15 = @12 + @27 in
  let @16 = @8[@15] in
  let @28 = i32x8(2) in
  let @17 = @12 + @28 in
  let @18 = @8[@17] in
  let @1 = f32x3(2f) in
  let @19 = @1[0u] in
  let @29 = f32x8(@19) in
  let @20 = @14 * @29 in
  let @21 = @1[1u] in
  let @30 = f32x8(@21) in
  let @22 = @16 * @30 in
  let @23 = @1[2u] in
  let @31 = f32x8(@23) in
  let @24 = @18 * @31 in
  let @5 = @20 + @24 in
  out[ramp(0, 1, 8)] = @5
  return
}

func length_squared(v : f32x3) -> f32 {
  let _t2 = v[0u] in
  let _t4 = v[1u] in
  let _t6 = v[2u] in
  let @3 = _t2 * _t2 in
  let @4 = _t4 * _t4 in
  let @5 = @3 + @4 in
  let @6 = _t6 * _t6 in
  let @7 = @5 + @6 in
  return @7
}

func through_a_call(inp : f32x3[8], out : mut f32[8]) -> void {
  let @12 = reinterpret_cast<f32[]>(inp) in
  let @13 = sizeof(f32x3) in
  let @14 = sizeof(f32) in
  let @15 = @13 / @14 in
  let @23 = i32x8(@15) in
  let @16 = ramp(0, 1, 8) * @23 in
  let @24 = i32x8(0) in
  let @17 = @16 + @24 in
  let @18 = @12[@17] in
  let @25 = i32x8(1) in
  let @19 = @16 + @25 in
  let @20 = @12[@19] in
  let @26 = i32x8(2) in
  let @21 = @16 + @26 in
  let @22 = @12[@21] in
  let @4 = @18 * @18 in
  let @5 = @20 * @20 in
  let @6 = @4 + @5 in
  let @7 = @22 * @22 in
  let @8 = @6 + @7 in
  out[ramp(0, 1, 8)] = @8
  return
}

func uniform_meets_varying(inp : f32x3[8], origin : f32x3, out : mut f32[8]) -> void {
  let @9 = reinterpret_cast<f32[]>(inp) in
  let @10 = sizeof(f32x3) in
  let @11 = sizeof(f32) in
  let @12 = @10 / @11 in
  let @26 = i32x8(@12) in
  let @13 = ramp(0, 1, 8) * @26 in
  let @27 = i32x8(0) in
  let @14 = @13 + @27 in
  let @15 = @9[@14] in
  let @28 = i32x8(1) in
  let @16 = @13 + @28 in
  let @17 = @9[@16] in
  let @29 = i32x8(2) in
  let @18 = @13 + @29 in
  let @19 = @9[@18] in
  let @20 = origin[0u] in
  let @30 = f32x8(@20) in
  let @21 = @15 - @30 in
  let @22 = origin[1u] in
  let @31 = f32x8(@22) in
  let @23 = @17 - @31 in
  let @24 = origin[2u] in
  let @32 = f32x8(@24) in
  let @25 = @19 - @32 in
  let @4 = @21 + @23 in
  let @6 = @4 + @25 in
  out[ramp(0, 1, 8)] = @6
  return
}


schedule host {
    components.vectorize(i)
    through_a_call.vectorize(i)
    uniform_meets_varying.vectorize(i)

}
