//! flags: -p ssa

// The sorted traversal of child-volumes-sorted.bonsai over a node of eight
// children, Embree's BVH8. The switch on the count of hits has the arms the
// four-wide node has -- none, one, and two to four hits, each sorting its
// constant count of keys as scalars and pushing the far children one by one
// -- and a last arm the four-wide node has no use for, five hits and up,
// where the count is not a constant: Batcher's bitonic network over all
// eight lanes of the keys with the misses' made infinite out of the hits'
// way (`select(mask, keys, 0x7f800000 | lane)`), the children and their
// carried bounds taken out by the sorted order with one `permute` each, and
// the hits that wait written to the stack with one compacting store
// (`compress_store_whole`) under the mask of the last `hits` lanes but the
// nearest, which is descended into from lane 7:
//
//     default:
//       <bitonic network, descending>
//       <children, bounds> = permute(.., sorted & 7)
//       compress_store_whole(!stack[!count], children, <lanes 8-hits .. 6>)
//       !count += hits - 1
//       tris_ref!top = children[7u]
//
// That is the shape loopify reads as a SortedRun (SSA/SortRecursion.h), and
// Embree's own fallback for five or more hits (bvh_traverser1.h,
// traverseClosestHitAVX512VL8): the keys sorted descending and the stack
// written in a loop. For its sake the stack is allocated a vector of slack
// past its 64 entries (`!stack : mut u32[72]`), where the four-wide node's
// stacks, whose every arm pushes scalars, have none.
//
// The one-hit arm differs from the four-wide node's too: an eight-lane mask
// is a byte, so the one lane it has on is its trailing zeros counted
// (`ctz(reinterpret_cast<u8>(@198))`, Embree's `bsf`) rather than lane 0 of
// a compress, and the child is read off the node's row at that lane
// (`reinterpret_cast<const u32[8]>((&@142[@143].children))[@347]`, Embree's
// `node->child(r)`), the layout being storage nothing writes; its bound is
// that lane of the distances computed (SSA/Simplify.cpp, the ExtractIdx
// rules).
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

// The distance at which the ray enters a box, and infinity where it misses:
// a sort key that puts the children the ray misses last.
func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH8 =
    | Interior(children : array[BVH8, 8], lo hi : vector[vec3f, 8])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH8;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 8];
            lo : vector[vec3f, 8];
            hi : vector[vec3f, 8];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
}
