func clip(x : f32) -> f32 {
  y : mut f32
  let @0 = x < 0f in
  if (@0) {
    return 0f
  } else {
    let @1 = x * 2f in
    let @3 = 10f < @1 in
    if (@3) {
      y = 10f
    } else {
      y = @1
    }
    let @5 = (*y) + 1f in
    return @5
  }
}

func [[export]] clip_all(inp : f32[8], out : mut f32[8]) -> void {
  let x$i0 = inp[ramp(0, 1, 8)] in
  let @16 = f32x8(0f) in
  let @1 = x$i0 < @16 in
  let @26 = !@1 in
  let @19 = f32x8(2f) in
  let @2 = x$i0 * @19 in
  let @20 = f32x8(10f) in
  let @4 = @20 < @2 in
  let @24 = f32x8(1f) in
  let @28 = select(@4, @20, @2) in
  let @29 = @28 + @24 in
  let @30 = select(@26, @29, @16) in
  out[ramp(0, 1, 8)] = @30
  return
}


schedule {
    clip_all.vectorize(i)

}
