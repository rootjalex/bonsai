type Intersection = struct Intersection{ value : f32; miss : bool }
type Ray = struct Ray{ data : f32 }
type Tree = f32

func bounce(is : Intersection, ray : Ray) -> Ray {
  let @0 = is.value in
  let @1 = ray.data in
  let @2 = @0 - @1 in
  let @3 = build<Ray>(@2) in
  return @3
}

func brdf_eval(is : Intersection, ray : Ray) -> f32 {
  let @0 = is.value in
  return @0
}

func color(t : f32, ray : Ray, output : mut f32[], i : i32) -> void {
  let _t0 = ray.data in
  let @1 = t * _t0 in
  let @2 = t < _t0 in
  let _t4 = build<Intersection>(@1, @2) in
  let @4 = _t4.miss in
  if (@4) {
    output[i] += _t0
    return
  } else {
    let _t6 = _t4.value in
    output[i] += _t6
    let @8 = _t6 - _t0 in
    let @9 = build<Ray>(@8) in
    color(t, @9, output, i)
    return
  }
}

func isect(t : f32, ray : Ray) -> Intersection {
  let _t9 = ray.data in
  let @1 = t * _t9 in
  let @2 = t < _t9 in
  let @3 = build<Intersection>(@1, @2) in
  return @3
}

func sky_color(ray : Ray) -> f32 {
  let @0 = ray.data in
  return @0
}

func trace(t : f32, n : i32, output : mut f32[n], crays : Ray[n]) -> void {
  parfor i in [0:n:1] {
    let ray = crays[i] in
    color(t, ray, output, i)
    continue
  }
  return
}


