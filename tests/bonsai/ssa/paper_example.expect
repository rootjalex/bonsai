type Intersection = struct Intersection{ value : f32; miss : bool }
type Ray = struct Ray{ data : f32 }
type Tree = f32

func bounce(is : (Intersection*), ray : (Ray*)) -> Ray {
  let @0 = (*is) in
  let @1 = @0.value in
  let @2 = (*ray) in
  let @3 = @2.data in
  let @4 = @1 - @3 in
  let @5 = build<Ray>(@4) in
  return @5
}

func brdf_eval(is : (Intersection*), ray : (Ray*)) -> f32 {
  let @0 = (*is) in
  let @1 = @0.value in
  return @1
}

func color(t : f32, ray : (Ray*), output : mut f32[], i : i32) -> void {
  let @0 = (*ray) in
  let @1 = @0.data in
  let @2 = t * @1 in
  let @3 = (*ray) in
  let @4 = @3.data in
  let @5 = t < @4 in
  let is = build<Intersection>(@2, @5) in
  let @7 = is.miss in
  if (@7) {
    let @8 = (*ray) in
    let @9 = @8.data in
    output[i] += @9
    return
  } else {
    let @11 = is.value in
    output[i] += @11
    let @13 = is.value in
    let @14 = (*ray) in
    let @15 = @14.data in
    let @16 = @13 - @15 in
    let @17 = build<Ray>(@16) in
    let @18 = (&@17) in
    color(t, @18, output, i)
    return
  }
}

func isect(t : f32, ray : (Ray*)) -> Intersection {
  let @0 = (*ray) in
  let @1 = @0.data in
  let @2 = t * @1 in
  let @3 = (*ray) in
  let @4 = @3.data in
  let @5 = t < @4 in
  let @6 = build<Intersection>(@2, @5) in
  return @6
}

func sky_color(ray : (Ray*)) -> f32 {
  let @0 = (*ray) in
  let @1 = @0.data in
  return @1
}

func trace(t : f32, n : i32, output : mut f32[n], crays : Ray[n]) -> void {
  parfor i in [0:n:1] {
    let ray = crays[i] in
    let @1 = (&ray) in
    color(t, @1, output, i)
    continue
  }
  return
}


