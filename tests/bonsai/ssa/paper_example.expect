type Intersection = struct Intersection{ value : f32; miss : bool }
type Ray = struct Ray{ data : f32 }
type Tree = f32

func bounce(is : Intersection, ray : Ray) -> Ray {
  let @0 = is.value in
  let @1 = ray.data in
  let @2 = @0 - @1 in
  let @3 = build<Ray>(@2) in
  return @3
}

func brdf_eval(is : Intersection, ray : Ray) -> f32 {
  let @0 = is.value in
  return @0
}

func color(t : f32, ray : Ray, output : mut f32[], i : i32) -> void {
  let @0 = ray.data in
  let @1 = t * @0 in
  let @2 = ray.data in
  let @3 = t < @2 in
  let is = build<Intersection>(@1, @3) in
  let @5 = is.miss in
  if (@5) {
    let @6 = ray.data in
    output[i] += @6
    return
  } else {
    let @8 = is.value in
    output[i] += @8
    let @10 = is.value in
    let @11 = ray.data in
    let @12 = @10 - @11 in
    let @13 = build<Ray>(@12) in
    color(t, @13, output, i)
    return
  }
}

func isect(t : f32, ray : Ray) -> Intersection {
  let @0 = ray.data in
  let @1 = t * @0 in
  let @2 = ray.data in
  let @3 = t < @2 in
  let @4 = build<Intersection>(@1, @3) in
  return @4
}

func sky_color(ray : Ray) -> f32 {
  let @0 = ray.data in
  return @0
}

func trace(t : f32, n : i32, output : mut f32[n], crays : Ray[n]) -> void {
  parfor i in [0:n:1] {
    let ray = crays[i] in
    color(t, ray, output, i)
    continue
  }
  return
}


