type A = struct A{ x : f32 }
type B = struct B{ y : f32; z : f32 }
type Blob = struct Blob{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x2 }
type Float = f32
type Holder = struct Holder{ which : u32; scale : f32 }

extern blobs : struct Blob{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x2 }[]

func [[export]] Blob_A(_ret0 : mut (Blob*), x : f32) -> void {
  let @0 = build<[[packed]] u8x3>(0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(x) in
  let @2 = build<[[packed]] u32x2>(@1, 0u) in
  let @3 = build<Blob>(0u, @0, @2) in
  _ret0 = @3
  return
}

func [[export]] Blob_B(_ret1 : mut (Blob*), y : f32, z : f32) -> void {
  let @0 = build<[[packed]] u8x3>(0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(y) in
  let @2 = reinterpret_cast<u32>(z) in
  let @3 = build<[[packed]] u32x2>(@1, @2) in
  let @4 = build<Blob>(1u, @0, @3) in
  _ret1 = @4
  return
}

func doubled(v : f32, n : i32) -> f32 {
  let @0 = n <= 0 in
  if (@0) {
    return v
  } else {
    let @1 = v + v in
    let @2 = n - 1 in
    let @3 = doubled(@1, @2) in
    return @3
  }
}

func [[noinline]] pick(b : Blob, k : f32) -> f32 {
  let @0 = b.tag in
  switch (@0) {
  case 0: { // Blob.A of pick
    let @1 = b.payload in
    let @2 = @1[0u] in
    let x = reinterpret_cast<f32>(@2) in
    let @4 = x * k in
    return @4
  } break;
  default: { // Blob.B of pick
    let _t2 = b.payload in
    let @6 = _t2[0u] in
    let y = reinterpret_cast<f32>(@6) in
    let @8 = _t2[1u] in
    let z = reinterpret_cast<f32>(@8) in
    let @10 = y + z in
    let @11 = @10 * k in
    return @11
  }
  }
}

func [[export]] weigh(hs : Holder[], i : u32, blobs : Blob[]) -> f32 {
  let h = hs[i] in
  let @1 = h.which in
  let @2 = blobs[@1] in
  let @3 = h.scale in
  let @4 = doubled(@3, 3) in
  let @5 = pick(@2, @4) in
  return @5
}


