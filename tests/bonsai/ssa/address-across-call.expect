type A = struct A{ x : f32 }
type B = struct B{ y : f32; z : f32 }
type Blob = struct Blob{ tag : u8; payload : union Blob_payload{ A : struct A{ x : f32 }; B : struct B{ y : f32; z : f32 } } }
type Float = f32
type Holder = struct Holder{ which : u32; scale : f32 }

extern blobs : struct Blob{ tag : u8; payload : union Blob_payload{ A : struct A{ x : f32 }; B : struct B{ y : f32; z : f32 } } }[]

func [[export]] Blob_A(_ret0 : mut (Blob*), x : f32) -> void {
  let @0 = build<A>(x) in
  let @1 = Blob_payload{.A = @0} in
  let @2 = build<Blob>(0u, @1) in
  _ret0 = @2
  return
}

func [[export]] Blob_B(_ret1 : mut (Blob*), y : f32, z : f32) -> void {
  let @0 = build<B>(y, z) in
  let @1 = Blob_payload{.B = @0} in
  let @2 = build<Blob>(1u, @1) in
  _ret1 = @2
  return
}

func _unexported_Blob_A(x : f32) -> Blob {
  let @0 = build<A>(x) in
  let @1 = Blob_payload{.A = @0} in
  let @2 = build<Blob>(0u, @1) in
  return @2
}

func _unexported_Blob_B(y : f32, z : f32) -> Blob {
  let @0 = build<B>(y, z) in
  let @1 = Blob_payload{.B = @0} in
  let @2 = build<Blob>(1u, @1) in
  return @2
}

func doubled(v : f32, n : i32) -> f32 {
  let @0 = n <= 0 in
  if (@0) {
    return v
  } else {
    let @1 = v + v in
    let @2 = n - 1 in
    let @3 = doubled(@1, @2) in
    return @3
  }
}

func [[noinline]] pick(b : Blob, k : f32) -> f32 {
  let @0 = b.tag in
  switch (@0) {
  case 0: {
    let @1 = b.payload in
    let @2 = @1.A in
    let x = @2.x in
    let @4 = x * k in
    return @4
  } break;
  default: {
    let @5 = b.payload in
    let _t7 = @5.B in
    let y = _t7.y in
    let z = _t7.z in
    let @9 = y + z in
    let @10 = @9 * k in
    return @10
  }
  }
}

func [[export]] weigh(hs : Holder[], i : u32, blobs : Blob[]) -> f32 {
  let h = hs[i] in
  let @1 = h.which in
  let @2 = blobs[@1] in
  let @3 = h.scale in
  let @4 = doubled(@3, 3) in
  let @5 = pick(@2, @4) in
  return @5
}


