func route(n : i32, acc : i32) -> i32 {
  let @0 = 1000 < acc in
  if (@0) {
    return acc
  } else {
    let @1 = n - 1 in
    let @2 = step(@1, acc) in
    return @2
  }
}

func [[export]] run(n : i32) -> i32 {
  let @0 = step(n, 0) in
  let @1 = route(n, 0) in
  let @2 = @0 + @1 in
  return @2
}

func step(n : i32, acc : i32) -> i32 {
  n!loop : mut i32
  acc!loop : mut i32
  which : mut u32
  acc!loop!0 : mut i32
  acc!inl0!1 : mut i32
  n!loop = n
  acc!loop = acc
  do {
    let @0 = (*n!loop) == 0 in
    if (@0) {
      which = 0u
      acc!loop!0 = (*acc!loop)
      acc!inl0!1 = undef
    } else {
      let @1 = (*acc!loop) + (*n!loop) in
      let acc!inl0 = @1 in
      let @3 = 1000 < acc!inl0 in
      if (@3) {
        which = 1u
        acc!loop!0 = undef
        acc!inl0!1 = acc!inl0
      } else {
        let @4 = (*n!loop) - 1 in
        n!loop = @4
        acc!loop = acc!inl0
        continue
      }
    }
    break
  } while (true)
  let _effect0 = reconverge() in
  switch ((*which)) {
  case 0: { // if of step
    acc!loop = (*acc!loop!0)
    return (*acc!loop)
  } break;
  default: { // if of route
    let acc!inl0 = (*acc!inl0!1) in
    let @2 = (*acc!inl0!1) in
    return @2
  }
  }
}


schedule {
    step.loopify()

}
