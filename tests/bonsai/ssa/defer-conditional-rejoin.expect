; === ssa postschedule ===
; --- run ---
; storage q.acc : f32 as q_acc_slots
; storage q.bonus : f32 as q_bonus_slots
; storage q.rest.w : f32 as q_rest_w
; storage q.ran : u8 as q_ran
func run(values : f32[8], out : f32[8]): 
  q_acc_slots = alloca<f32[8]> scratch()
  q_bonus_slots = alloca<f32[8]> scratch()
  q_rest_w = alloca<f32[8]> scratch()
  q_ran = alloca<u8[8]> scratch()
  @10 = fill_bytes(q_ran, (u8)0, (i32)8)
  q__slot = alloca<i32[8]> scratch()
  q_queue = alloca<(Queue_q*)> scratch()
  @11 = make_struct<Queue_q>((u32)0, q__slot)
  store q_queue @11
  parfor i (i32)0:(i32)8:(i32)1 !par_body_0(values, out, q_acc_slots, q_bonus_slots, q_rest_w, q_ran, q_queue) q!drain(q_queue, values, q__slot, q_acc_slots, q_bonus_slots, q_rest_w, out, q_ran)

!par_body_0(i : i32, values : f32[8], out : f32[8], q_acc_slots : f32[8], q_bonus_slots : f32[8], q_rest_w : f32[8], q_ran : u8[8], q_queue : (Queue_q*)): // preds: run
  @8 = gep(q_acc_slots, i)
  store @8 (f32)0
  @9 = gep(q_bonus_slots, i)
  store @9 (f32)0
  _t22 = extract_idx(values, i)
  w = add(_t22, (f32)1)
  @2 = lt((f32)4, _t22)
  dispatch @2 [!merge_3(@8, w, @9, out, i), !then_2(_t22, @8, @9, w, out, i, q_rest_w, q_ran, q_queue)]

!par_cont_1(): // preds: q_rest!exit
  ret

!then_2(_t22 : f32, acc : (f32*), bonus : (f32*), w : f32, out : f32[8], i : i32, q_rest_w : f32[8], q_ran : u8[8], q_queue : (Queue_q*)): // preds: !par_body_0
  @12 = gep(q_rest_w, i)
  store @12 w
  @13 = gep(q_ran, i)
  store @13 (u8)1
  call step(_t22, acc, q_queue, i) q!end()

!merge_3(acc : (f32*), w : f32, bonus : (f32*), out : f32[8], i : i32): // preds: !par_body_0
  @3 = load(acc)
  @4 = add(@3, w)
  @5 = load(bonus)
  @6 = add(@4, @5)
  @7 = gep(out, i)
  store @7 @6
  yield

q!end(): // preds: !then_2
  yield

q!drain(q_queue : (Queue_q*), values : f32[8], q__slot : i32[8], q_acc_slots : f32[8], q_bonus_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: run
  @14 = load(q_queue)
  @15 = load_field(@14, (u32)0)
  parfor q (u32)0:@15:(u32)1 q!run(values, q__slot, q_acc_slots) q!exit(q_queue, q_bonus_slots, q_acc_slots, q_rest_w, out, q_ran)

q!run(q : u32, values : f32[8], q__slot : i32[8], q_acc_slots : f32[8]): // preds: q!drain
  @16 = extract_idx(q__slot, q)
  @17 = extract_idx(values, @16)
  @18 = gep(q_acc_slots, @16)
  call work(@17, @18) q!ran()

q!ran(): // preds: q!run
  yield

q!exit(q_queue : (Queue_q*), q_bonus_slots : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: q!drain
  @19 = field.ptr(q_queue, (u32)0)
  store @19 (u32)0
  jmp q_rest(q_bonus_slots, q_acc_slots, q_rest_w, out, q_ran)

!step_call_cont_4!rest(@25 : (f32*), @26 : (f32*), @27 : f32, @28 : f32[8], @29 : i32): // preds: q_rest!run
  store @25 (f32)100
  jmp !merge_3!rest(@26, @27, @25, @28, @29)

!merge_3!rest(@30 : (f32*), @31 : f32, @32 : (f32*), @33 : f32[8], @34 : i32): // preds: !step_call_cont_4!rest
  @20 = load(@30)
  @21 = add(@20, @31)
  @22 = load(@32)
  @23 = add(@21, @22)
  @24 = gep(@33, @34)
  store @24 @23
  yield

q_rest(q_bonus_slots : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: q!exit
  parfor q_rest (i32)0:(i32)8:(i32)1 q_rest!run(q_bonus_slots, q_acc_slots, q_rest_w, out, q_ran) q_rest!exit()

q_rest!run(q_rest : i32, q_bonus_slots : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: q_rest
  @35 = gep(q_bonus_slots, q_rest)
  @36 = gep(q_acc_slots, q_rest)
  @37 = gep(q_rest_w, q_rest)
  @38 = load(@37)
  @39 = gep(q_ran, q_rest)
  @40 = load(@39)
  dispatch @40 [q_rest!skip(), !step_call_cont_4!rest(@35, @36, @38, out, q_rest)]

q_rest!exit(): // preds: q_rest
  jmp !par_cont_1()

q_rest!skip(): // preds: q_rest!run
  yield

; --- step ---
func step(x : f32, acc : (f32*), _queue_q : (Queue_q*), _slot_q : i32): 
  @0 = make_struct<Entry_q>(_slot_q)
  @1 = push _queue_q @0
  ret

; --- work ---
func work(x : f32, acc : (f32*)): 
  @0 = mul(x, (f32)0.5)
  acc.add acc @0
  ret

type Entry_q = struct Entry_q{ _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q_acc_slots : mut f32[8]
  q_bonus_slots : mut f32[8]
  q_rest_w : mut f32[8]
  q_ran : mut u8[8]
  let @10 = fill_bytes(q_ran, 0u, 8) in
  q__slot : mut i32[8]
  q_queue : mut Queue_q
  let @11 = build<Queue_q>(0u, q__slot) in
  q_queue = @11
  parfor i in [0:8:1] {
    q_acc_slots[i] = 0f
    q_bonus_slots[i] = 0f
    let _t22 = values[i] in
    let w = _t22 + 1f in
    let @2 = 4f < _t22 in
    if (@2) {
      let acc = (&q_acc_slots[i]) in
      let bonus = (&q_bonus_slots[i]) in
      q_rest_w[i] = w
      q_ran[i] = 1u
      step(_t22, acc, q_queue, i)
      continue
    } else {
      let acc = (&q_acc_slots[i]) in
      let bonus = (&q_bonus_slots[i]) in
      let @3 = (*acc) in
      let @4 = @3 + w in
      let @5 = (*bonus) in
      let @6 = @4 + @5 in
      out[i] = @6
      continue
    }
  }
  let @14 = (*q_queue) in
  let @15 = @14.count in
  parfor q in [0u:@15:1u] {
    let @16 = q__slot[q] in
    let @17 = values[@16] in
    work(@17, (&q_acc_slots[@16]))
    continue
  }
  q_queue.count = 0u
  parfor q_rest in [0:8:1] {
    let @38 = q_rest_w[q_rest] in
    let @40 = q_ran[q_rest] in
    switch (@40) {
    case 0: {
      continue
    } break;
    default: {
      let @25 = (&q_bonus_slots[q_rest]) in
      let @26 = (&q_acc_slots[q_rest]) in
      let @27 = @38 in
      let @28 = out in
      let @29 = q_rest in
      @25 = 100f
      let @30 = (&q_acc_slots[q_rest]) in
      let @31 = @38 in
      let @32 = (&q_bonus_slots[q_rest]) in
      let @33 = out in
      let @34 = q_rest in
      let @20 = (*@30) in
      let @21 = @20 + @31 in
      let @22 = (*@32) in
      let @23 = @21 + @22 in
      @33[@34] = @23
      continue
    }
    }
  }
  return
}

func step(x : f32, acc : mut (f32*), _queue_q : mut (Queue_q*), _slot_q : i32) -> void {
  let @0 = build<Entry_q>(_slot_q) in
  let @3 = atomic_add((&(*_queue_q).count), 1u) in
  let @5 = (*_queue_q)._slot in
  @5[@3] = _slot_q
  return
}

func work(x : f32, acc : mut (f32*)) -> void {
  let @0 = x * 0.5f in
  acc += @0
  return
}


schedule {
    q = run.queue(root);
    step.defer(work, q)

}
