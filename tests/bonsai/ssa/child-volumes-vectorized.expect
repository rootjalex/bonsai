schedule {
    tris : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    trace.sort(tris.Interior, |i : u32, r : struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }, lo : f32x3x4, hi : f32x3x4| entry(r, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
         .vectorize(tris.Interior.children)
         .loopify((i32)64)

}
