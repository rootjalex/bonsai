func find_interval(n : i32, cdf : f32[], base : i32, u : f32) -> i32 {
  size : mut i32
  first : mut i32
  let _t0 = n - 2 in
  size = _t0
  first = 1
  while (0 < (*size)) {
    let half = (*size) >> 1 in
    let middle = (*first) + half in
    let @7 = base + middle in
    let @8 = cdf[@7] in
    let found = @8 <= u in
    let @10 = middle + 1 in
    let @12 = select(found, @10, (*first)) in
    let @14 = half + 1 in
    let @15 = (*size) - @14 in
    let @16 = select(found, @15, half) in
    size = @16
    first = @12
  }
  let @18 = (*first) - 1 in
  let @19 = max(@18, 0) in
  let @20 = min(@19, _t0) in
  return @20
}

