    let @225 = f32x8(2f) in
    let @30 = @29 * @225 in
    @30!skip = @30
  } else {
    @30!skip = @228
  }
  let @72 = select(@66, (*@38!skip), (*@58!skip)) in
  let @73 = select(@65, (*@30!skip), @72) in
  out[ramp(0, 1, 8)] = @73
  return
}


schedule host {
    weigh_all.vectorize(i)

}
