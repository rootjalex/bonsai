type Entry_q = struct Entry_q{ x : f32; total : (f32*) }
type Entry_q_done = struct Entry_q_done{ total : (f32*); i : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; x : f32[]; total : (f32*)[] }
type Queue_q_done = struct Queue_q_done{ count : u32; total : (f32*)[]; i : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q_total_slots : mut f32[8]
  q_x : mut f32[8]
  q_total : mut (f32*)[8]
  q_queue : mut Queue_q
  let @4 = build<Queue_q>(0u, q_x, q_total) in
  q_queue = @4
  q_done_total : mut (f32*)[8]
  q_done_i : mut i32[8]
  q_done_queue : mut Queue_q_done
  let @11 = build<Queue_q_done>(0u, q_done_total, q_done_i) in
  q_done_queue = @11
  parfor i in [0:8:1] {
    q_total_slots[i] = 0f
    let @0 = values[i] in
    step(@0, (&q_total_slots[i]), q_queue)
    let total = (&q_total_slots[i]) in
    let @12 = build<Entry_q_done>(total, i) in
    let @19 = atomic_add((&(*q_done_queue).count), 1u) in
    let @21 = (*q_done_queue).total in
    @21[@19] = total
    let @24 = (*q_done_queue).i in
    @24[@19] = i
    continue
  }
  let @5 = (*q_queue) in
  let @6 = @5.count in
  parfor q in [0u:@6:1u] {
    let @7 = q_x[q] in
    let @9 = q_total[q] in
    let @8 = shade(@7) in
    @9 += @8
    continue
  }
  q_queue.count = 0u
  let @14 = (*q_done_queue) in
  let @15 = @14.count in
  parfor q_done in [0u:@15:1u] {
    let @16 = q_done_total[q_done] in
    let @17 = q_done_i[q_done] in
    let total = @16 in
    let i = @17 in
    let @1 = (*total) in
    out[i] = @1
    continue
  }
  return
}

func [[noinline]] shade(x : f32) -> f32 {
  let @0 = x * 2f in
  return @0
}

func [[noinline]] step(x : f32, total : mut (f32*), _queue_q : mut (Queue_q*)) -> void {
  let @1 = build<Entry_q>(x, total) in
  let @4 = atomic_add((&(*_queue_q).count), 1u) in
  let @6 = (*_queue_q).x in
  @6[@4] = x
  let @9 = (*_queue_q).total in
  @9[@4] = total
  total += x
  return
}


schedule host {
    q = run.queue(root);
    step.defer(shade, q)

}
