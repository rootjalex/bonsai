    acc!skip0 = @15
  } else {
    acc!skip0 = (*acc!skip)
  }
  let @12 = (*@10!join) || @8 in
  let @23 = f32x8(1f) in
  let @7 = (*acc!skip0) + @23 in
  let @16 = select(@12, @7, (*!ret!skip)) in
  return @16
}

func [[export]] weigh_all(a : f32[8], out : mut f32[8]) -> void {
  let @0 = a[ramp(0, 1, 8)] in
  let @1 = weigh$gang8_v0(@0) in
  let i = ramp(0, 1, 8) in
