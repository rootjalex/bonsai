func [[noinline]] scale(x : f32, k : f32) -> f32 {
  let @0 = x * k in
  return @0
}

func [[noinline]] scale$gang8_v0$masked(x : f32x8, k : f32, !mask : boolx8) -> f32x8 {
  let @1 = f32x8(k) in
  let @0 = x * @1 in
  return @0
}

func weigh(x : f32) -> f32 {
  acc : mut f32
  let @0 = 2f < x in
  if (@0) {
    let @1 = scale(x, 3f) in
    let @3 = 20f < @1 in
    if (@3) {
      return @1
    } else {
      acc = @1
    }
  } else {
    let @5 = scale(x, 5f) in
    acc = @5
  }
  let @7 = (*acc) + 1f in
  return @7
}

