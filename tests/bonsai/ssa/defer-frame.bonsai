//! flags: -p ssa

// The producer's own state in the entry (see correctness/llvm/defer-frame for
// the run). The result of the deferred recursion is written to `out[i]` by
// the caller, after the call, and `i` is the parfor's index, gone by the time
// the drain runs the entry.
//
// What to read for: the record -- `sums_rest_i`, the iteration's `i`,
// written by the producer before its call; `sums_result`, the recursion's
// value, written by `tally` where it ends through the `_result_sums` slot
// address it is handed and the entry carries -- and the pass `sums_rest`
// after the rounds, which runs `out[i] = value` once per iteration with
// both. The producer's iteration ends at the call, `tally` returns nothing,
// and the drain runs an entry and goes on.
func tally(n : i32, acc : i32) -> i32 {
  if (n <= 0) {
    return acc;
  }
  return tally(n - 1, acc + n);
}

func run(out : mut array[i32, 8]) -> void {
  parfor i in 0:8 {
    out[i] = tally(i, 0);
  }
  return;
}

schedule {
  sums = run.queue(root);
  tally.defer(tally, sums);
}
