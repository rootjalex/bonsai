//! flags: -p ssa

// The producer's own state in the entry (see correctness/llvm/defer-frame for
// the run). The result of the deferred recursion is written to `out[i]` by
// the caller, after the call, and `i` is the parfor's index, gone by the time
// the drain runs the entry.
//
// What to read for: the entry has a field `i` beside the callee's `n` and
// `acc`, which the callee leaves alone; `tally` returns a `Saved_` of flag,
// slot and value; after its call the producer tests the flag and, when it
// saved, writes `i` into the slot's entry before ending the iteration; and
// the drain does the same for an entry that saves again, copying the `i` it
// carried in, and otherwise runs `out[i] = value` with the entry's `i`.
func tally(n : i32, acc : i32) -> i32 {
  if (n <= 0) {
    return acc;
  }
  return tally(n - 1, acc + n);
}

func run(out : mut array[i32, 8]) -> void {
  parfor i in 0:8 {
    out[i] = tally(i, 0);
  }
  return;
}

schedule {
  sums = run.queue(root);
  tally.defer(tally, sums);
}
