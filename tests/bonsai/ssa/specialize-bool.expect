type Float = f32
type Half = f16
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func pick(flag : bool, x : f32) -> f32 {
  if (flag) {
    let @0 = x * 2f in
    return @0
  } else {
    let @1 = x + 1f in
    return @1
  }
}

func [[export]] run(flag : bool, values : f32[8], out : mut f32[8]) -> void {
  if (flag) {
    parfor i!True in [0:8:1] {
      let @14 = values[i!True] in
      let @16 = @14 * 2f in
      out[i!True] = @16
      continue
    }
  } else {
    parfor i!False in [0:8:1] {
      let @8 = values[i!False] in
      let @5 = @8 + 1f in
      out[i!False] = @5
      continue
    }
  }
  return
}


schedule {
    run.specialize(flag)
       .bind(i, CPUThread)

}
