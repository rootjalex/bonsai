func route(n : i32, acc : i32, out : mut i32[8], i : i32) -> void {
  let @0 = 20 < acc in
  if (@0) {
    out[i] = -1
    return
  } else {
    let @2 = n - 1 in
    step(@2, acc, out, i)
    return
  }
}

func step(n : i32, acc : i32, out : mut i32[8], i : i32) -> void {
  n!loop : mut i32
  acc!loop : mut i32
  n!loop = n
  acc!loop = acc
  while (!((*n!loop) <= 0)) {
    let @2 = (*acc!loop) + (*n!loop) in
    let acc!inl0 = @2 in
    let @3 = 20 < acc!inl0 in
    if (@3) {
      out[i] = -1
      return
    } else {
      let @5 = (*n!loop) - 1 in
      n!loop = @5
      acc!loop = acc!inl0
    }
  }
  out[i] = (*acc!loop)
  return
}

func step$gang8_v0_v3(n : i32x8, acc : i32, out : mut i32[8], i : i32x8) -> void {
  n!loop!loop : mut i32x8
  acc!loop!loop : mut i32x8
  !live : mut boolx8
  !exit.then_0!inl0 : mut boolx8
  !exit.then_0 : mut boolx8
  !track.then_0.0 : mut i32x8
  let @42 = i32x8(acc) in
  let @43 = boolx8(true) in
  let @44 = boolx8(false) in
  n!loop!loop = n
  acc!loop!loop = @42
  !live = @43
  !exit.then_0!inl0 = @44
  !exit.then_0 = @44
  !track.then_0.0 = undef
  while (reduce<any>((*!live))) {
    let @28 = i32x8(0) in
    let @0 = (*n!loop!loop) <= @28 in
    let @46 = !@0 in
    let @8 = (*!live) && @46 in
    let @9 = (*!live) && @0 in
    let @17 = select(@9, @44, (*!live)) in
    let @22 = select(@9, @43, (*!exit.then_0)) in
    let @25 = select(@9, (*acc!loop!loop), (*!track.then_0.0)) in
    let @2 = (*acc!loop!loop) + (*n!loop!loop) in
    let @33 = i32x8(20) in
    let @3 = @33 < @2 in
    let @47 = !@3 in
    let @11 = @8 && @47 in
    let @12 = @8 && @3 in
    let @18 = select(@12, @44, @17) in
    let @20 = select(@12, @43, (*!exit.then_0!inl0)) in
    let @23 = select(@12, (*!exit.then_0), @22) in
    let @26 = select(@12, (*!track.then_0.0), @25) in
    let @38 = i32x8(1) in
    let @5 = (*n!loop!loop) - @38 in
    let @16 = select(@11, @2, (*acc!loop!loop)) in
    let @48 = select(@11, @43, @18) in
    let @21 = select(@11, (*!exit.then_0!inl0), @20) in
    let @24 = select(@11, (*!exit.then_0), @23) in
    let @27 = select(@11, (*!track.then_0.0), @26) in
    n!loop!loop = @5
    acc!loop!loop = @16
    !live = @48
    !exit.then_0!inl0 = @21
    !exit.then_0 = @24
    !track.then_0.0 = @27
  }
  let @49 = !(*!exit.then_0!inl0) in
  let @15 = reduce<any>((*!exit.then_0!inl0)) in
  if (@15) {
    let @41 = i32x8(-1) in
    masked_store(out[i], @41, (*!exit.then_0!inl0))
  }
  let @14 = reduce<any>(@49) in
  if (@14) {
    masked_store(out[i], (*!track.then_0.0), @49)
  }
  return
}

func triangles(n : i32[8], out : mut i32[8]) -> void {
  let @0 = n[ramp(0, 1, 8)] in
  step$gang8_v0_v3(@0, 0, out, ramp(0, 1, 8))
  return
}


schedule {
    step.loopify()
    triangles.vectorize(i)

}
