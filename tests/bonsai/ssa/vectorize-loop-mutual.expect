func route(n : i32, acc : i32, out : mut i32[8], i : i32) -> void {
  let @0 = 20 < acc in
  if (@0) {
    out[i] = -1
    return
  } else {
    let @2 = n - 1 in
    step(@2, acc, out, i)
    return
  }
}

func step(n : i32, acc : i32, out : mut i32[8], i : i32) -> void {
  n!loop : mut i32
  acc!loop : mut i32
  which : mut u32
  slot0 : mut i32
  n!loop = n
  acc!loop = acc
  do {
    let @0 = (*n!loop) <= 0 in
    if (@0) {
      which = 0u
      slot0 = (*acc!loop)
    } else {
      let @2 = (*acc!loop) + (*n!loop) in
      let acc!inl0 = @2 in
      let @3 = 20 < acc!inl0 in
      if (@3) {
        which = 1u
        slot0 = 0
      } else {
        let @5 = (*n!loop) - 1 in
        n!loop = @5
        acc!loop = acc!inl0
        continue
      }
    }
    break
  } while (true)
  let _effect0 = reconverge() in
  switch ((*which)) {
  case 0: { // if of step
    acc!loop = (*slot0)
    out[i] = (*acc!loop)
    return
  } break;
  default: { // if of route
    out[i] = -1
    return
  }
  }
}

func step$gang8_v0_v3(n : i32x8, acc : i32, out : mut i32[8], i : i32x8) -> void {
  n!loop!loop : mut i32x8
  acc!loop!loop : mut i32x8
  !live : mut boolx8
  !exit.step!exit : mut boolx8
  !track.step!exit.0 : mut u32x8
  !track.step!exit.1 : mut i32x8
  let @47 = i32x8(acc) in
  let @48 = boolx8(true) in
  let @49 = boolx8(false) in
  n!loop!loop = n
  acc!loop!loop = @47
  !live = @48
  !exit.step!exit = @49
  !track.step!exit.0 = undef
  !track.step!exit.1 = undef
  while (reduce<any>((*!live))) {
    let @30 = i32x8(0) in
    let @0 = (*n!loop!loop) <= @30 in
    let @50 = !@0 in
    let @8 = (*!live) && @50 in
    let @9 = (*!live) && @0 in
    let @18 = select(@9, @49, (*!live)) in
    let @21 = select(@9, @48, (*!exit.step!exit)) in
    let @35 = u32x8(0u) in
    let @24 = select(@9, @35, (*!track.step!exit.0)) in
    let @27 = select(@9, (*acc!loop!loop), (*!track.step!exit.1)) in
    let @2 = (*acc!loop!loop) + (*n!loop!loop) in
    let @36 = i32x8(20) in
    let @3 = @36 < @2 in
    let @51 = !@3 in
    let @11 = @8 && @51 in
    let @12 = @8 && @3 in
    let @19 = select(@12, @49, @18) in
    let @22 = select(@12, @48, @21) in
    let @41 = u32x8(1u) in
    let @25 = select(@12, @41, @24) in
    let @28 = select(@12, @30, @27) in
    let @43 = i32x8(1) in
    let @5 = (*n!loop!loop) - @43 in
    let @17 = select(@11, @2, (*acc!loop!loop)) in
    let @52 = select(@11, @48, @19) in
    let @23 = select(@11, (*!exit.step!exit), @22) in
    let @26 = select(@11, (*!track.step!exit.0), @25) in
    let @29 = select(@11, (*!track.step!exit.1), @28) in
    n!loop!loop = @5
    acc!loop!loop = @17
    !live = @52
    !exit.step!exit = @23
    !track.step!exit.0 = @26
    !track.step!exit.1 = @29
  }
  let _effect1 = reconverge() in
  let @44 = u32x8(0u) in
  let @13 = (*!track.step!exit.0) == @44 in
  let @14 = (*!track.step!exit.0) != @44 in
  let @16 = reduce<any>(@14) in
  if (@16) {
    let @46 = i32x8(-1) in
    masked_store(out[i], @46, @14)
  }
  let @15 = reduce<any>(@13) in
  if (@15) {
    masked_store(out[i], (*!track.step!exit.1), @13)
  }
  return
}

func triangles(n : i32[8], out : mut i32[8]) -> void {
  let @0 = n[ramp(0, 1, 8)] in
  step$gang8_v0_v3(@0, 0, out, ramp(0, 1, 8))
  return
}


schedule {
    step.loopify()
    triangles.vectorize(i)

}
