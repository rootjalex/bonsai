type Deep = struct Deep{ max_depth : i32 }
type Entry_sums = struct Entry_sums{ n : i32; acc : i32; _slot : i32 }
type Limits = struct Limits{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x1 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }
type Shallow = struct Shallow{ max_depth : i32 }

func [[export]] Limits_Deep(_ret0 : mut (Limits*), max_depth : i32) -> void {
  let @0 = build<[[packed]] u8x3>(0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(max_depth) in
  let @2 = build<[[packed]] u32x1>(@1) in
  let @3 = build<Limits>(1u, @0, @2) in
  _ret0 = @3
  return
}

func [[export]] Limits_Shallow(_ret1 : mut (Limits*), max_depth : i32) -> void {
  let @0 = build<[[packed]] u8x3>(0u, 0u, 0u) in
  let @1 = reinterpret_cast<u32>(max_depth) in
  let @2 = build<[[packed]] u32x1>(@1) in
  let @3 = build<Limits>(0u, @0, @2) in
  _ret1 = @3
  return
}

func [[export]] run(out : mut i32[8], limits : (Limits*)) -> void {
  sums!round : mut u32
  let @43 = (*limits).tag in
  switch (@43) {
  case 0: {
    let @52 = (*limits) in
    let @53 = @52.payload in
    let @54 = @53[0u] in
    let @55 = reinterpret_cast<i32>(@54) in
    sums_@25_slots : mut i32[8]
    sums_result : mut i32[8]
    sums_n_0 : mut i32[8]
    sums_acc_0 : mut i32[8]
    sums__slot_0 : mut i32[8]
    sums_n_1 : mut i32[8]
    sums_acc_1 : mut i32[8]
    sums__slot_1 : mut i32[8]
    sums_queue : mut Queue_sums[2]
    let @58 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__slot_0) in
    sums_queue[0u] = @58
    let @60 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__slot_1) in
    sums_queue[1u] = @60
    parfor i!Shallow in [0:8:1] {
      let @44 = (*limits) in
      let @45 = @44._pad in
      let @46 = @44.payload in
      let @47 = build<Limits>(0u, @45, @46) in
      let @25 = (&sums_@25_slots[i!Shallow]) in
      let @16 = @46[0u] in
      let @17 = reinterpret_cast<i32>(@16) in
      tally(i!Shallow, 0, @17, (&sums_queue[0u]), (&sums_result[i!Shallow]), i!Shallow)
      continue
    }
    sums!round = 0u
    while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
      let @64 = (*sums!round) & 1u in
      let @66 = sums_queue[(*sums!round) & 1u].count in
      let @68 = @64 ^ 1u in
      sums_queue[@68].count = 0u
      parfor sums in [0u:@66:1u] {
        let @69 = (&sums_queue[@68]) in
        let @73 = sums_queue[@64].n in
        let @74 = @73[sums] in
        let @76 = sums_queue[@64].acc in
        let @77 = @76[sums] in
        let @79 = sums_queue[@64]._slot in
        let @80 = @79[sums] in
        tally(@74, @77, @55, @69, (&sums_result[@80]), @80)
        continue
      }
      let @63 = (*sums!round) + 1u in
      sums!round = @63
    }
    parfor sums_rest in [0:8:1] {
      let @83 = sums_result[sums_rest] in
      let @6 = @83 in
      let @25 = (&sums_@25_slots[sums_rest]) in
      let i!Shallow = sums_rest in
      @25 = @6
      let @23 = (*@25) in
      out[i!Shallow] = @23
      continue
    }
  } break;
  default: {
    parfor i!Deep in [0:8:1] {
      let @48 = (*limits) in
      let @49 = @48._pad in
      let @50 = @48.payload in
      let @51 = build<Limits>(1u, @49, @50) in
      let @34 = @50[0u] in
      let @35 = reinterpret_cast<i32>(@34) in
      let @36 = @35 << 1 in
      out[i!Deep] = @36
      continue
    }
  }
  }
  return
}

func [[noinline]] tally(n : i32, acc : i32, max_depth : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> void {
  let @0 = max_depth <= n in
  if (@0) {
    _result_sums = acc
    return
  } else {
    let @1 = n + 1 in
    let @2 = acc + n in
    let @4 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).n in
    @9[@7] = @1
    let @12 = (*_queue_sums).acc in
    @12[@7] = @2
    let @15 = (*_queue_sums)._slot in
    @15[@7] = _slot_sums
    return
  }
}


schedule host {
    sums = run.queue(root);
    run.specialize(limits)
    tally.defer(tally, sums)

}
