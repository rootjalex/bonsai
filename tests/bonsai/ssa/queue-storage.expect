    let @18 = counts_queue[(*counts!round) & 1u].count in
    let @20 = @16 ^ 1u in
    counts_queue[@20].count = 0u
    parfor counts in [0u:@18:1u] {
      let @21 = (&counts_queue[@20]) in
      let @25 = counts_queue[@16].k in
      let @26 = @25[counts] in
      let @28 = counts_queue[@16].acc in
      let @29 = @28[counts] in
