      continue
    }
    }
  }
  free(counts_ran)
  free(counts_result)
  free(counts_k_0)
  free(counts_acc_0)
  free(counts__slot_0)
  free(counts_k_1)
  free(counts_acc_1)
  free(counts__slot_1)
  free(counts_queue)
