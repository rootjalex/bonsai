type Entry_counts = struct Entry_counts{ k : i32; acc : i32; _slot : i32 }
type Entry_sums = struct Entry_sums{ k : i32; acc : i32; _slot : i32 }
type Entry_tally = struct Entry_tally{ k : i32; acc : i32; _slot : i32 }
type Queue_counts = struct Queue_counts{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }
type Queue_sums = struct Queue_sums{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }
type Queue_tally = struct Queue_tally{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }

extern func bonsai_cuda_round_guard(round : u32, count : (u32*)) -> u32;

func climb(k : i32, acc : i32, _queue_counts : mut (Queue_counts*), _result_counts : mut (i32*), _slot_counts : i32) -> _option_counts {
  let @0 = k <= 0 in
  if (@0) {
    _result_counts = acc
    let @4 = build<_option_counts>(acc, true) in
    return @4
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @5 = build<Entry_counts>(@1, @2, _slot_counts) in
    let @6 = build<_option_counts>(undef, false) in
    let @9 = atomic_add((&(*_queue_counts).count), 1u) in
    let @11 = (*_queue_counts).k in
    @11[@9] = @1
    let @14 = (*_queue_counts).acc in
    @14[@9] = @2
    let @17 = (*_queue_counts)._slot in
    @17[@9] = _slot_counts
    return @6
  }
}

func crawl(k : i32, acc : i32, _queue_tally : mut (Queue_tally*), _result_tally : mut (i32*), _slot_tally : i32) -> _option_tally {
  let @0 = k <= 0 in
  if (@0) {
    _result_tally = acc
    let @4 = build<_option_tally>(acc, true) in
    return @4
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @5 = build<Entry_tally>(@1, @2, _slot_tally) in
    let @6 = build<_option_tally>(undef, false) in
    let @9 = atomic_add((&(*_queue_tally).count), 1u) in
    let @11 = (*_queue_tally).k in
    @11[@9] = @1
    let @14 = (*_queue_tally).acc in
    @14[@9] = @2
    let @17 = (*_queue_tally)._slot in
    @17[@9] = _slot_tally
    return @6
  }
}

func [[export]] exported_run(out : mut i32[8], tally_k_0 : mut i32[8], tally_acc_0 : mut i32[8], tally__slot_0 : mut i32[8], tally_k_1 : mut i32[8], tally_acc_1 : mut i32[8], tally__slot_1 : mut i32[8]) -> void {
  tally!round : mut u32
  alloc tally_ran : mut u8[8] device
  let @2 = fill_bytes(tally_ran, 0u, 8u) in
  alloc tally_result : mut i32[8] device
  alloc tally_queue : mut Queue_tally[2] device
  let @4 = build<Queue_tally>(0u, tally_k_0, tally_acc_0, tally__slot_0) in
  tally_queue[0u] = @4
  let @6 = build<Queue_tally>(0u, tally_k_1, tally_acc_1, tally__slot_1) in
  tally_queue[1u] = @6
  parfor i in [0:8:1] {
    let @9 = crawl(i, 0, (&tally_queue[0u]), (&tally_result[i]), i) in
    let @10 = out in
    let @11 = i in
    let @12 = @9.set in
    let @13 = @9.value in
    if (@12) {
      let @0 = @13 in
      out[i] = @0
      continue
    } else {
      tally_ran[i] = 1u
      continue
    }
  }
  tally!round = 0u
  do {
    let @16 = (*tally!round) & 1u in
    let @47 = bonsai_cuda_round_guard((*tally!round), (&tally_queue[@16].count)) in
    let @48 = @47 == 0u in
    if (@48) {
      break
    } else {
      let @20 = @16 ^ 1u in
      tally_queue[@20].count = 0u
      parfor tally in [0u:8u:1u] {
        let @21 = (&tally_queue[@20]) in
        let @44 = (&tally_queue[@16].count) in
        let @45 = (*@44) in
        let @46 = tally < @45 in
        if (@46) {
          let @25 = tally_queue[@16].k in
          let @26 = @25[tally] in
          let @28 = tally_queue[@16].acc in
          let @29 = @28[tally] in
          let @31 = tally_queue[@16]._slot in
          let @32 = @31[tally] in
          crawl(@26, @29, @21, (&tally_result[@32]), @32)
          continue
        } else {
          continue
        }
      }
      let @15 = (*tally!round) + 1u in
      tally!round = @15
      continue
    }
  } while (true)
  parfor tally_rest in [0:8:1] {
    let @39 = tally_result[tally_rest] in
    let @41 = tally_ran[tally_rest] in
    switch (@41) {
    case 0: {
      continue
    } break;
    default: {
      let @35 = @39 in
      let @36 = out in
      let @37 = tally_rest in
      @36[@37] = @35
      continue
    }
    }
  }
  return
}

