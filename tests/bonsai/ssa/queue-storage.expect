}

func walk(k : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  let @0 = k <= 0 in
  if (@0) {
    _result_sums = acc
    let @4 = build<_option_sums>(acc, true) in
    return @4
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @5 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @6 = build<_option_sums>(undef, false) in
    let @9 = atomic_add((&(*_queue_sums).count), 1u) in
    let @11 = (*_queue_sums).k in
    @11[@9] = @1
    let @14 = (*_queue_sums).acc in
    @14[@9] = @2
    let @17 = (*_queue_sums)._slot in
    @17[@9] = _slot_sums
    return @6
  }
}


schedule {
    counts = hosted.queue(root, Heap);
    sums = run.queue(root, DeviceGlobal);
    tally = exported_run.queue(root, (i32)8, ExternDevice);
    climb.defer(climb, counts)
    crawl.defer(crawl, tally)
    exported_run.bind(i, GPUThread)
                .bind(tally, GPUThread)
                .bind(tally_rest, GPUThread)
    run.bind(i, GPUThread)
       .bind(sums, GPUThread)
       .bind(sums_rest, GPUThread)
    walk.defer(walk, sums)

}
