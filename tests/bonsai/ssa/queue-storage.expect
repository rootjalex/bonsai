type Entry_counts = struct Entry_counts{ k : i32; acc : i32; _slot : i32 }
type Entry_sums = struct Entry_sums{ k : i32; acc : i32; _slot : i32 }
type Entry_tally = struct Entry_tally{ k : i32; acc : i32; _slot : i32 }
type Queue_counts = struct Queue_counts{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }
type Queue_sums = struct Queue_sums{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }
type Queue_tally = struct Queue_tally{ count : u32; k : i32[]; acc : i32[]; _slot : i32[] }

extern func bonsai_cuda_round_guard(round : u32, count : (u32*)) -> u32;

func climb(k : i32, acc : i32, _queue_counts : mut (Queue_counts*), _result_counts : mut (i32*), _slot_counts : i32) -> void {
  let @0 = k <= 0 in
  if (@0) {
    _result_counts = acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @4 = build<Entry_counts>(@1, @2, _slot_counts) in
    let @7 = atomic_add((&(*_queue_counts).count), 1u) in
    let @9 = (*_queue_counts).k in
    @9[@7] = @1
    let @12 = (*_queue_counts).acc in
    @12[@7] = @2
    let @15 = (*_queue_counts)._slot in
    @15[@7] = _slot_counts
    return
  }
}

func crawl(k : i32, acc : i32, _queue_tally : mut (Queue_tally*), _result_tally : mut (i32*), _slot_tally : i32) -> void {
  let @0 = k <= 0 in
  if (@0) {
    _result_tally = acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @4 = build<Entry_tally>(@1, @2, _slot_tally) in
    let @7 = atomic_add((&(*_queue_tally).count), 1u) in
    let @9 = (*_queue_tally).k in
    @9[@7] = @1
    let @12 = (*_queue_tally).acc in
    @12[@7] = @2
    let @15 = (*_queue_tally)._slot in
    @15[@7] = _slot_tally
    return
  }
}

func [[export]] exported_run(out : mut i32[8], tally_k_0 : mut i32[8], tally_acc_0 : mut i32[8], tally__slot_0 : mut i32[8], tally_k_1 : mut i32[8], tally_acc_1 : mut i32[8], tally__slot_1 : mut i32[8]) -> void {
  tally!round : mut u32
  tally_result : mut i32[8]
  alloc tally_queue : mut Queue_tally[2] device
  let @3 = build<Queue_tally>(0u, tally_k_0, tally_acc_0, tally__slot_0) in
  tally_queue[0u] = @3
  let @5 = build<Queue_tally>(0u, tally_k_1, tally_acc_1, tally__slot_1) in
  tally_queue[1u] = @5
  parfor i in [0:8:1] {
    crawl(i, 0, (&tally_queue[0u]), (&tally_result[i]), i)
    continue
  }
  tally!round = 0u
  do {
    let @9 = (*tally!round) & 1u in
    let @34 = bonsai_cuda_round_guard((*tally!round), (&tally_queue[@9].count)) in
    let @35 = @34 == 0u in
    if (@35) {
      break
    } else {
      let @13 = @9 ^ 1u in
      tally_queue[@13].count = 0u
      parfor tally in [0u:8u:1u] {
        let @14 = (&tally_queue[@13]) in
        let @31 = (&tally_queue[@9].count) in
        let @32 = (*@31) in
        let @33 = tally < @32 in
        if (@33) {
          let @18 = tally_queue[@9].k in
          let @19 = @18[tally] in
          let @21 = tally_queue[@9].acc in
          let @22 = @21[tally] in
          let @24 = tally_queue[@9]._slot in
          let @25 = @24[tally] in
          crawl(@19, @22, @14, (&tally_result[@25]), @25)
          continue
        } else {
          continue
        }
      }
      let @8 = (*tally!round) + 1u in
      tally!round = @8
      continue
    }
  } while (true)
  parfor tally_rest in [0:8:1] {
    let @28 = tally_result[tally_rest] in
    let @0 = @28 in
    let i = tally_rest in
    out[i] = @0
    continue
  }
  return
}

func hosted(out : mut i32[8]) -> void {
  counts!round : mut u32
  counts_result : mut i32[8]
  alloc counts_k_0 : mut i32[8]
  alloc counts_acc_0 : mut i32[8]
  alloc counts__slot_0 : mut i32[8]
  alloc counts_k_1 : mut i32[8]
  alloc counts_acc_1 : mut i32[8]
  alloc counts__slot_1 : mut i32[8]
  alloc counts_queue : mut Queue_counts[2]
  let @3 = build<Queue_counts>(0u, counts_k_0, counts_acc_0, counts__slot_0) in
  counts_queue[0u] = @3
  let @5 = build<Queue_counts>(0u, counts_k_1, counts_acc_1, counts__slot_1) in
  counts_queue[1u] = @5
  parfor i in [0:8:1] {
    climb(i, 0, (&counts_queue[0u]), (&counts_result[i]), i)
    continue
  }
  counts!round = 0u
  while (!(counts_queue[(*counts!round) & 1u].count == 0u)) {
    let @9 = (*counts!round) & 1u in
    let @11 = counts_queue[(*counts!round) & 1u].count in
    let @13 = @9 ^ 1u in
    counts_queue[@13].count = 0u
    parfor counts in [0u:@11:1u] {
      let @14 = (&counts_queue[@13]) in
      let @18 = counts_queue[@9].k in
      let @19 = @18[counts] in
      let @21 = counts_queue[@9].acc in
      let @22 = @21[counts] in
      let @24 = counts_queue[@9]._slot in
      let @25 = @24[counts] in
      climb(@19, @22, @14, (&counts_result[@25]), @25)
      continue
    }
    let @8 = (*counts!round) + 1u in
    counts!round = @8
  }
  parfor counts_rest in [0:8:1] {
    let @28 = counts_result[counts_rest] in
    let @0 = @28 in
    let i = counts_rest in
    out[i] = @0
    continue
  }
  free(counts_k_0)
  free(counts_acc_0)
  free(counts__slot_0)
  free(counts_k_1)
  free(counts_acc_1)
  free(counts__slot_1)
  free(counts_queue)
  return
}

func main() -> i32 {
  alloc out : mut i32[8]
  let @0 = build<i32[8]>(-1, -1, -1, -1, -1, -1, -1, -1) in
  out = @0
  run(out)
  hosted(out)
  print(out)
  return 0
}

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_result : mut i32[8]
  alloc sums_k_0 : mut i32[8] device
  alloc sums_acc_0 : mut i32[8] device
  alloc sums__slot_0 : mut i32[8] device
  alloc sums_k_1 : mut i32[8] device
  alloc sums_acc_1 : mut i32[8] device
  alloc sums__slot_1 : mut i32[8] device
  alloc sums_queue : mut Queue_sums[2] device
  let @3 = build<Queue_sums>(0u, sums_k_0, sums_acc_0, sums__slot_0) in
  sums_queue[0u] = @3
  let @5 = build<Queue_sums>(0u, sums_k_1, sums_acc_1, sums__slot_1) in
  sums_queue[1u] = @5
  parfor i in [0:8:1] {
    walk(i, 0, (&sums_queue[0u]), (&sums_result[i]), i)
    continue
  }
  sums!round = 0u
  do {
    let @9 = (*sums!round) & 1u in
    let @35 = bonsai_cuda_round_guard((*sums!round), (&sums_queue[@9].count)) in
    let @36 = @35 == 0u in
    if (@36) {
      break
    } else {
      let @13 = @9 ^ 1u in
      sums_queue[@13].count = 0u
      let @29 = cast<u32>(8) in
      parfor sums in [0u:@29:1u] {
        let @14 = (&sums_queue[@13]) in
        let @32 = (&sums_queue[@9].count) in
        let @33 = (*@32) in
        let @34 = sums < @33 in
        if (@34) {
          let @18 = sums_queue[@9].k in
          let @19 = @18[sums] in
          let @21 = sums_queue[@9].acc in
          let @22 = @21[sums] in
          let @24 = sums_queue[@9]._slot in
          let @25 = @24[sums] in
          walk(@19, @22, @14, (&sums_result[@25]), @25)
          continue
        } else {
          continue
        }
      }
      let @8 = (*sums!round) + 1u in
      sums!round = @8
      continue
    }
  } while (true)
  parfor sums_rest in [0:8:1] {
    let @28 = sums_result[sums_rest] in
    let @0 = @28 in
    let i = sums_rest in
    out[i] = @0
    continue
  }
  return
}

func walk(k : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> void {
  let @0 = k <= 0 in
  if (@0) {
    _result_sums = acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @4 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).k in
    @9[@7] = @1
    let @12 = (*_queue_sums).acc in
    @12[@7] = @2
    let @15 = (*_queue_sums)._slot in
    @15[@7] = _slot_sums
    return
  }
}


schedule {
    counts = hosted.queue(root, Heap);
    sums = run.queue(root, DeviceGlobal);
    tally = exported_run.queue(root, (i32)8, ExternDevice);
    climb.defer(climb, counts)
    crawl.defer(crawl, tally)
    exported_run.bind(i, GPUThread)
                .bind(tally, GPUThread)
                .bind(tally_rest, GPUThread)
    run.bind(i, GPUThread)
       .bind(sums, GPUThread)
       .bind(sums_rest, GPUThread)
    walk.defer(walk, sums)

}
