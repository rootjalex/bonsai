//! flags: -p ssa

// A match whose arms fall out of it into what follows: a switch with a merge.
//
// A match is a switch on the tag (see Lower/ADTs.cpp): one N-way dispatch in
// the SSA form rather than a chain of two-way tests, and the relooper brings
// the switch back from the dispatch (see SSA/CodeGen_Stmt.cpp). The arms here
// are the three kinds a merge has to cope with -- one that falls through with
// a value for what follows, one that returns and so never reaches the merge,
// and one with nothing left in it once its dead statement is eliminated,
// whose edge goes straight there.
import stdlib/numerics;

element Blob =
    | Whole(x : f32)
    | Split(lo : i32, hi : i32)
    | Wide(v : vec3f, neg : bool);

func [[export]] weigh(b : Blob, k : f32) -> f32 {
    acc : mut = k;
    match b {
        Whole(x) => { acc = acc + x * 2.0; }
        Split(lo, hi) => return cast[[f32]](lo + hi);
        Wide(v, neg) => { unused = v.x; }
    }
    return acc * 3.0;
}
