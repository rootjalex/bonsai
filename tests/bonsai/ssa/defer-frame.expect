type Entry_sums = struct Entry_sums{ n : i32; acc : i32; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_ran : mut u8[8]
  let @2 = fill_bytes(sums_ran, 0u, 8) in
  sums_result : mut i32[8]
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums__slot_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums__slot_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @4 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__slot_0) in
  sums_queue[0u] = @4
  let @6 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__slot_1) in
  sums_queue[1u] = @6
  parfor i in [0:8:1] {
    let @9 = tally(i, 0, (&sums_queue[0u]), (&sums_result[i]), i) in
    let @10 = out in
    let @11 = i in
    let @12 = @9.set in
    let @13 = @9.value in
    if (@12) {
      let @0 = @13 in
      out[i] = @0
      continue
    } else {
      sums_ran[i] = 1u
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @16 = (*sums!round) & 1u in
    let @18 = sums_queue[(*sums!round) & 1u].count in
    let @20 = @16 ^ 1u in
    sums_queue[@20].count = 0u
    parfor sums in [0u:@18:1u] {
      let @21 = (&sums_queue[@20]) in
      let @25 = sums_queue[@16].n in
      let @26 = @25[sums] in
      let @28 = sums_queue[@16].acc in
      let @29 = @28[sums] in
      let @31 = sums_queue[@16]._slot in
      let @32 = @31[sums] in
      tally(@26, @29, @21, (&sums_result[@32]), @32)
      continue
    }
    let @15 = (*sums!round) + 1u in
    sums!round = @15
  }
  parfor sums_rest in [0:8:1] {
    let @39 = sums_result[sums_rest] in
    let @41 = sums_ran[sums_rest] in
    switch (@41) {
    case 0: {
      continue
    } break;
    default: {
      let @35 = @39 in
      let @36 = out in
      let @37 = sums_rest in
      @36[@37] = @35
      continue
    }
    }
  }
  return
}

func tally(n : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  let @0 = n <= 0 in
  if (@0) {
    _result_sums = acc
    let @4 = build<_option_sums>(acc, true) in
    return @4
  } else {
    let @1 = n - 1 in
    let @2 = acc + n in
    let @5 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @6 = build<_option_sums>(undef, false) in
    let @9 = atomic_add((&(*_queue_sums).count), 1u) in
    let @11 = (*_queue_sums).n in
    @11[@9] = @1
    let @14 = (*_queue_sums).acc in
    @14[@9] = @2
    let @17 = (*_queue_sums)._slot in
    @17[@9] = _slot_sums
    return @6
  }
}


schedule {
    sums = run.queue(root);
    tally.defer(tally, sums)

}
