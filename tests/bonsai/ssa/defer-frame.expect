type Entry_sums = struct Entry_sums{ n : i32; acc : i32; _result : (i32*) }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _result : (i32*)[] }

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_result : mut i32[8]
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums__result_0 : mut (i32*)[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums__result_1 : mut (i32*)[8]
  sums_queue : mut Queue_sums[2]
  let @2 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__result_0) in
  sums_queue[0u] = @2
  let @4 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__result_1) in
  sums_queue[1u] = @4
  parfor i in [0:8:1] {
    tally(i, 0, (&sums_queue[0u]), (&sums_result[i]))
    continue
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @9 = (*sums!round) & 1u in
    let @11 = sums_queue[(*sums!round) & 1u].count in
    let @13 = @9 ^ 1u in
    sums_queue[@13].count = 0u
    parfor sums in [0u:@11:1u] {
      let @14 = (&sums_queue[@13]) in
      let @18 = sums_queue[@9].n in
      let @19 = @18[sums] in
      let @21 = sums_queue[@9].acc in
      let @22 = @21[sums] in
      let @24 = sums_queue[@9]._result in
      let @25 = @24[sums] in
      tally(@19, @22, @14, @25)
      continue
    }
    let @8 = (*sums!round) + 1u in
    sums!round = @8
  }
  parfor sums_rest in [0:8:1] {
    let @27 = sums_result[sums_rest] in
    let @0 = @27 in
    let i = sums_rest in
    out[i] = @0
    continue
  }
  return
}

func [[noinline]] tally(n : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*)) -> void {
  let @0 = n <= 0 in
  if (@0) {
    _result_sums = acc
    return
  } else {
    let @1 = n - 1 in
    let @2 = acc + n in
    let @4 = build<Entry_sums>(@1, @2, _result_sums) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).n in
    @9[@7] = @1
    let @12 = (*_queue_sums).acc in
    @12[@7] = @2
    let @15 = (*_queue_sums)._result in
    @15[@7] = _result_sums
    return
  }
}


schedule host {
    sums = run.queue(root);
    tally.defer(tally, sums)

}
