//! flags: -p ssa

// child-volumes-sorted-two.bonsai with its children loop unrolled: FCPW's
// scalar BVH traversal (bvh.inl, processSubtreeForClosestPoint) as it is
// written -- the left child's box read off its row and tested, then the
// right child's, each test tightening the far corner's bound and recording
// its hit as its bit of the mask and its distance as its carried bound;
// then the two ordered by one comparison of the keys, the farther pushed
// and the nearer entered -- from the same tree declaration and three
// directives: `unroll(tris.Interior.children)`, then the sort and the stack.
//
// What to read for: no `parfor children` and no `[children]`; the first
// copy's reads at lane 0 and the second's at lane 1 of the layout's pairs
// (`lo = vector[vec3f, 2]{...}`) folded to the child's own row's fields
// (SSA/Simplify.h, fold_built_lanes, once the directives have run); the
// mask's two bits each written once, at a constant shift; and the run read
// at lanes 0 and 1, which the two-lane sort orders as scalars
// (SSA/SortRecursion.cpp). The carried bounds stay an array of two written
// at constant indices and read back after the copies -- a local aggregate
// the backend scalarizes (SROA), which SSA/PromoteAllocas.h does not.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

// The distance at which the ray enters a box, and infinity where it misses:
// a sort key that puts the child the ray misses last.
func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    // The nearer child first by the distance at which the ray enters its
    // box (the sort comes first on a function, as every schedule's does),
    // the two children's tests written out, and the recursion on a stack.
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               entry(r, AABB{lo[i], hi[i]}))
         .unroll(tris.Interior.children)
         .loopify(64);
}
