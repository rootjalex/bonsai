//! flags: -p ssa

// A leaf of tiles tested four lanes at a time: the tree of
// lower/tiled-elements.bonsai -- node rows holding the children's bounds,
// leaves of tiles of four triangles with every field a vector over the four
// -- with the loop over a leaf's triangles vectorized,
// `trace.vectorize(tris.Leaf.data)`, beside the loop over a node's children.
// Embree's `TriangleMIntersector1Moeller<4>`: a Triangle4 block's four
// triangles tested as four lanes, and the nearest of the lanes that hit taken.
//
// What to read for. The loop over a leaf's triangles is a loop over its
// tiles with a loop over the four lanes of each inside, named for the field
// (Lower/ForEachs.cpp), and the lanes' loop is the gang: each field of the
// tile is read whole -- `cast<f32x3x4>(tile.p0)` reinterpreted as the gang's
// per-lane `vec3f`, no lane picked -- and the triangle test is four-wide
// arithmetic. The argmin's update, `_best0 argmin= (t, ref)` per element, is
// one reduction across the lanes: the keys of the lanes that hit (the rest
// infinite) folded to their minimum, the first lane holding it found, its
// reference taken, and one argmin accumulate of the pair into the running
// best, made if any lane hit (see widen_region in SSA/Vectorize.cpp).
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                p0 : vec3f;
                p1 : vec3f;
                p2 : vec3f;
            };
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
}
