type Entry_rays = struct Entry_rays{ x : f32; n : i32 }
type Float = f32
type Half = f16
type Queue_rays = struct Queue_rays{ count : u32; x : f32[]; n : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[10], counts : u32[1], out : mut f32[16], total : mut (f32*)) -> void {
  let @0 = counts[0] in
  rays_queue : mut Queue_rays[2]
  parfor io in [0u:@0:4u] {
    rays!round : mut u32
    let @6 = @0 in
    let @9 = 4u * 3u in
    rays_ran : mut u8[@9]
    let @10 = fill_bytes(rays_ran, 0u, @9) in
    rays_x_0 : mut f32[@9]
    rays_n_0 : mut i32[@9]
    rays_x_1 : mut f32[@9]
    rays_n_1 : mut i32[@9]
    let @13 = build<Queue_rays>(0u, rays_x_0, rays_n_0) in
    rays_queue[0u] = @13
    let @15 = build<Queue_rays>(0u, rays_x_1, rays_n_1) in
    rays_queue[1u] = @15
    parfor ii in [0u:4u:1u] {
      let @7 = io + ii in
      let @8 = @7 < @6 in
      if (@8) {
        let i = @7 in
        parfor j in [0u:3u:1u] {
          let @1 = values[i] in
          let @2 = cast<i32>(j) in
          let @11 = ii * 3u in
          let @12 = @11 + j in
          rays_ran[@12] = 1u
          let @19 = build<Entry_rays>(@1, @2) in
          let @43 = atomic_add((&rays_queue[0u].count), 1u) in
          let @45 = rays_queue[0u].x in
          @45[@43] = @1
          let @48 = rays_queue[0u].n in
          @48[@43] = @2
          continue
        }
        continue
      } else {
        continue
      }
    }
    rays!round = 0u
    while (!(rays_queue[(*rays!round) & 1u].count == 0u)) {
      let @23 = (*rays!round) & 1u in
      let @25 = rays_queue[(*rays!round) & 1u].count in
      let @27 = @23 ^ 1u in
      rays_queue[@27].count = 0u
      parfor rays in [0u:@25:1u] {
        let @28 = (&rays_queue[@27]) in
        let @32 = rays_queue[@23].x in
        let @33 = @32[rays] in
        let @35 = rays_queue[@23].n in
        let @36 = @35[rays] in
        step(@33, @36, total, @28)
        continue
      }
      let @22 = (*rays!round) + 1u in
      rays!round = @22
    }
    parfor rays_rest in [0u:@9:1u] {
      let @41 = mulhi(rays_rest, 2863311531u) in
      let @37 = @41 >> 1u in
      let @38 = io + @37 in
      let @40 = rays_ran[rays_rest] in
      switch (@40) {
      case 0: {
        continue
      } break;
      default: {
        let i = @38 in
        let @3 = out[i] in
        let @4 = @3 + 1f in
        out[i] = @4
        continue
      }
      }
    }
    continue
  }
  return
}

func step(x : f32, n : i32, total : mut (f32*), _queue_rays : mut (Queue_rays*)) -> void {
  total += x
  let @0 = n == 0 in
  if (@0) {
    return
  } else {
    let @1 = n - 1 in
    let @2 = build<Entry_rays>(x, @1) in
    let @5 = atomic_add((&(*_queue_rays).count), 1u) in
    let @7 = (*_queue_rays).x in
    @7[@5] = x
    let @10 = (*_queue_rays).n in
    @10[@5] = @1
    return
  }
}


schedule {
    rays = run.queue(io);
    run.split(i, io, ii, (i32)4, 1)
       .defer(step, rays)
    step.defer(step, rays)

}
