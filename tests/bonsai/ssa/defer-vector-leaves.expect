type Entry_sums = struct Entry_sums{ n : i32; p : f32x3; s : f32x4; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; p : [[packed]] f32x3[]; s : f32x4[]; _slot : i32[] }
type f32x3 = f32x3
type f32x4 = f32x4

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  let @6 = build<f32x4>(1f, 1f, 1f, 1f) in
  sums_ran : mut u8[8]
  let @7 = fill_bytes(sums_ran, 0u, 8) in
  sums_result : mut f32[8]
  sums_n_0 : mut i32[8]
  sums_p_0 : mut [[packed]] f32x3[8]
  sums_s_0 : mut f32x4[8]
  sums__slot_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_p_1 : mut [[packed]] f32x3[8]
  sums_s_1 : mut f32x4[8]
  sums__slot_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @9 = build<Queue_sums>(0u, sums_n_0, sums_p_0, sums_s_0, sums__slot_0) in
  sums_queue[0u] = @9
  let @11 = build<Queue_sums>(0u, sums_n_1, sums_p_1, sums_s_1, sums__slot_1) in
  sums_queue[1u] = @11
  parfor i in [0:8:1] {
    let @0 = cast<f32>(i) in
    let @1 = build<f32x3>(@0, 0f, 0f) in
    let @2 = build<f32x4>(1f, 1f, 1f, 1f) in
    let @14 = walk(i, @1, @2, (&sums_queue[0u]), (&sums_result[i]), i) in
    let @15 = out in
    let @16 = i in
    let @17 = @14.set in
    let @18 = @14.value in
    if (@17) {
      let @3 = @18 in
      let @4 = cast<i32>(@3) in
      out[i] = @4
      continue
    } else {
      sums_ran[i] = 1u
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @21 = (*sums!round) & 1u in
    let @23 = sums_queue[(*sums!round) & 1u].count in
    let @25 = @21 ^ 1u in
    sums_queue[@25].count = 0u
    parfor sums in [0u:@23:1u] {
      let @26 = (&sums_queue[@25]) in
      let @30 = sums_queue[@21].n in
      let @31 = @30[sums] in
      let @33 = sums_queue[@21].p in
      let @34 = @33[sums] in
      let @35 = cast<f32x3>(@34) in
      let @37 = sums_queue[@21].s in
      let @38 = @37[sums] in
      let @40 = sums_queue[@21]._slot in
      let @41 = @40[sums] in
      walk(@31, @35, @38, @26, (&sums_result[@41]), @41)
      continue
    }
    let @20 = (*sums!round) + 1u in
    sums!round = @20
  }
  parfor sums_rest in [0:8:1] {
    let @49 = sums_result[sums_rest] in
    let @51 = sums_ran[sums_rest] in
    switch (@51) {
    case 0: {
      continue
    } break;
    default: {
      let @45 = @49 in
      let @46 = out in
      let @47 = sums_rest in
      let @43 = cast<i32>(@45) in
      @46[@47] = @43
      continue
    }
    }
  }
  return
}

func walk(n : i32, p : f32x3, s : f32x4, _queue_sums : mut (Queue_sums*), _result_sums : mut (f32*), _slot_sums : i32) -> _option_sums {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = p[0] in
    let @2 = p[1] in
    let @3 = @1 + @2 in
    let @4 = p[2] in
    let @5 = @3 + @4 in
    let @6 = s[0] in
    let @7 = @5 + @6 in
    let @8 = s[1] in
    let @9 = @7 + @8 in
    let @10 = s[2] in
    let @11 = @9 + @10 in
    let @12 = s[3] in
    let @13 = @11 + @12 in
    _result_sums = @13
    let @20 = build<_option_sums>(@13, true) in
    return @20
  } else {
    let @14 = n - 1 in
    let @15 = build<f32x3>(1f, 2f, 3f) in
    let @16 = p + @15 in
    let @17 = f32x4(2f) in
    let @18 = s * @17 in
    let @21 = build<Entry_sums>(@14, @16, @18, _slot_sums) in
    let @22 = build<_option_sums>(undef, false) in
    let @25 = atomic_add((&(*_queue_sums).count), 1u) in
    let @26 = cast<[[packed]] f32x3>(@16) in
    let @28 = (*_queue_sums).n in
    @28[@25] = @14
    let @31 = (*_queue_sums).p in
    @31[@25] = @26
    let @34 = (*_queue_sums).s in
    @34[@25] = @18
    let @37 = (*_queue_sums)._slot in
    @37[@25] = _slot_sums
    return @22
  }
}


schedule {
    sums = run.queue(root);
    walk.defer(walk, sums)

}
