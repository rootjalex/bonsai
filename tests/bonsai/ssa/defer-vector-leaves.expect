type Entry_sums = struct Entry_sums{ n : i32; p : f32x3; s : f32x4; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; p : [[packed]] f32x3[]; s : [[packed]] f32x4[]; _slot : i32[] }
type f32x3 = f32x3
type f32x4 = f32x4

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  let @6 = build<f32x4>(1f, 1f, 1f, 1f) in
  sums_result : mut f32[8]
  sums_n_0 : mut i32[8]
  sums_p_0 : mut [[packed]] f32x3[8]
  sums_s_0 : mut [[packed]] f32x4[8]
  sums__slot_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_p_1 : mut [[packed]] f32x3[8]
  sums_s_1 : mut [[packed]] f32x4[8]
  sums__slot_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @8 = build<Queue_sums>(0u, sums_n_0, sums_p_0, sums_s_0, sums__slot_0) in
  sums_queue[0u] = @8
  let @10 = build<Queue_sums>(0u, sums_n_1, sums_p_1, sums_s_1, sums__slot_1) in
  sums_queue[1u] = @10
  parfor i in [0:8:1] {
    let @0 = cast<f32>(i) in
    let @1 = build<f32x3>(@0, 0f, 0f) in
    let @2 = build<f32x4>(1f, 1f, 1f, 1f) in
    walk(i, @1, @2, (&sums_queue[0u]), (&sums_result[i]), i)
    continue
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @14 = (*sums!round) & 1u in
    let @16 = sums_queue[(*sums!round) & 1u].count in
    let @18 = @14 ^ 1u in
    sums_queue[@18].count = 0u
    parfor sums in [0u:@16:1u] {
      let @19 = (&sums_queue[@18]) in
      let @23 = sums_queue[@14].n in
      let @24 = @23[sums] in
      let @26 = sums_queue[@14].p in
      let @27 = @26[sums] in
      let @28 = cast<f32x3>(@27) in
      let @30 = sums_queue[@14].s in
      let @31 = @30[sums] in
      let @32 = cast<f32x4>(@31) in
      let @34 = sums_queue[@14]._slot in
      let @35 = @34[sums] in
      walk(@24, @28, @32, @19, (&sums_result[@35]), @35)
      continue
    }
    let @13 = (*sums!round) + 1u in
    sums!round = @13
  }
  parfor sums_rest in [0:8:1] {
    let @38 = sums_result[sums_rest] in
    let @3 = @38 in
    let i = sums_rest in
    let @4 = cast<i32>(@3) in
    out[i] = @4
    continue
  }
  return
}

func walk(n : i32, p : f32x3, s : f32x4, _queue_sums : mut (Queue_sums*), _result_sums : mut (f32*), _slot_sums : i32) -> void {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = p[0] in
    let @2 = p[1] in
    let @3 = @1 + @2 in
    let @4 = p[2] in
    let @5 = @3 + @4 in
    let @6 = s[0] in
    let @7 = @5 + @6 in
    let @8 = s[1] in
    let @9 = @7 + @8 in
    let @10 = s[2] in
    let @11 = @9 + @10 in
    let @12 = s[3] in
    let @13 = @11 + @12 in
    _result_sums = @13
    return
  } else {
    let @14 = n - 1 in
    let @15 = build<f32x3>(1f, 2f, 3f) in
    let @16 = p + @15 in
    let @17 = f32x4(2f) in
    let @18 = s * @17 in
    let @20 = build<Entry_sums>(@14, @16, @18, _slot_sums) in
    let @23 = atomic_add((&(*_queue_sums).count), 1u) in
    let @24 = cast<[[packed]] f32x3>(@16) in
    let @25 = cast<[[packed]] f32x4>(@18) in
    let @27 = (*_queue_sums).n in
    @27[@23] = @14
    let @30 = (*_queue_sums).p in
    @30[@23] = @24
    let @33 = (*_queue_sums).s in
    @33[@23] = @25
    let @36 = (*_queue_sums)._slot in
    @36[@23] = _slot_sums
    return
  }
}


schedule {
    sums = run.queue(root);
    walk.defer(walk, sums)

}
