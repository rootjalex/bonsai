func _traverse_array0(a : i32[4]) -> i32[4] {
  alloc _alloc0 : mut i32[4]
  parfor _i0 in [0:4:1] {
    let @0 = a[_i0] in
    let @1 = @0 << 1 in
    _alloc0[_i0] = @1
    continue
  }
  return _alloc0
