func capped_triangles(n : i32[8], out : mut i32[8]) -> void {
  let @0 = n[ramp(0, 1, 8)] in
  walk$gang8_v0_v3(@0, 0, out, ramp(0, 1, 8))
  return
}

func sum_to(n : i32, acc : i32, out : mut i32[8], i : i32) -> void {
  n!loop : mut i32
  acc!loop : mut i32
  n!loop = n
  acc!loop = acc
  while (!((*n!loop) <= 0)) {
    let @2 = (*n!loop) - 1 in
    let @3 = (*acc!loop) + (*n!loop) in
    n!loop = @2
    acc!loop = @3
  }
  out[i] = (*acc!loop)
  return
}

func sum_to$gang8_v0_v3(n : i32x8, acc : i32, out : mut i32[8], i : i32x8) -> void {
  n!loop!loop : mut i32x8
  acc!loop!loop : mut i32x8
  !live : mut boolx8
  !exit.then_0 : mut boolx8
  !track.then_0.0 : mut i32x8
  let @22 = i32x8(acc) in
  let @23 = boolx8(true) in
  let @24 = boolx8(false) in
  n!loop!loop = n
  acc!loop!loop = @22
  !live = @23
  !exit.then_0 = @24
  !track.then_0.0 = undef
  while (reduce<any>((*!live))) {
    let @16 = i32x8(0) in
    let @0 = (*n!loop!loop) <= @16 in
    let @25 = !@0 in
    let @6 = (*!live) && @25 in
    let @7 = (*!live) && @0 in
    let @10 = select(@7, @24, (*!live)) in
    let @12 = select(@7, @23, (*!exit.then_0)) in
    let @14 = select(@7, (*acc!loop!loop), (*!track.then_0.0)) in
    let @21 = i32x8(1) in
    let @2 = (*n!loop!loop) - @21 in
    let @3 = (*acc!loop!loop) + (*n!loop!loop) in
    let @8 = select(@6, @2, (*n!loop!loop)) in
    let @9 = select(@6, @3, (*acc!loop!loop)) in
    let @26 = select(@6, @23, @10) in
    let @13 = select(@6, (*!exit.then_0), @12) in
    let @15 = select(@6, (*!track.then_0.0), @14) in
    n!loop!loop = @8
    acc!loop!loop = @9
    !live = @26
    !exit.then_0 = @13
    !track.then_0.0 = @15
  }
  out[i] = (*!track.then_0.0)
  return
}

func triangles(n : i32[8], out : mut i32[8]) -> void {
  let @0 = n[ramp(0, 1, 8)] in
  sum_to$gang8_v0_v3(@0, 0, out, ramp(0, 1, 8))
  return
}

func walk(n : i32, acc : i32, out : mut i32[8], i : i32) -> void {
  n!loop : mut i32
  acc!loop : mut i32
  n!loop = n
  acc!loop = acc
  while (!((*n!loop) <= 0)) {
    let @2 = 20 < (*acc!loop) in
    if (@2) {
      out[i] = -1
      return
    } else {
      let @4 = (*n!loop) - 1 in
      let @5 = (*acc!loop) + (*n!loop) in
      n!loop = @4
      acc!loop = @5
    }
  }
  out[i] = (*acc!loop)
  return
}

func walk$gang8_v0_v3(n : i32x8, acc : i32, out : mut i32[8], i : i32x8) -> void {
  n!loop!loop : mut i32x8
  acc!loop!loop : mut i32x8
  !live : mut boolx8
  !exit.then_2 : mut boolx8
  !exit.then_0 : mut boolx8
  !track.then_0.0 : mut i32x8
  let @43 = i32x8(acc) in
  let @44 = boolx8(true) in
  let @45 = boolx8(false) in
  n!loop!loop = n
  acc!loop!loop = @43
  !live = @44
  !exit.then_2 = @45
  !exit.then_0 = @45
  !track.then_0.0 = undef
  while (reduce<any>((*!live))) {
    let @29 = i32x8(0) in
    let @0 = (*n!loop!loop) <= @29 in
    let @47 = !@0 in
    let @8 = (*!live) && @47 in
    let @9 = (*!live) && @0 in
    let @18 = select(@9, @45, (*!live)) in
    let @23 = select(@9, @44, (*!exit.then_0)) in
    let @26 = select(@9, (*acc!loop!loop), (*!track.then_0.0)) in
    let @34 = i32x8(20) in
    let @2 = @34 < (*acc!loop!loop) in
    let @48 = !@2 in
    let @11 = @8 && @48 in
    let @12 = @8 && @2 in
    let @19 = select(@12, @45, @18) in
    let @21 = select(@12, @44, (*!exit.then_2)) in
    let @24 = select(@12, (*!exit.then_0), @23) in
    let @27 = select(@12, (*!track.then_0.0), @26) in
    let @39 = i32x8(1) in
    let @4 = (*n!loop!loop) - @39 in
    let @5 = (*acc!loop!loop) + (*n!loop!loop) in
    let @16 = select(@11, @4, (*n!loop!loop)) in
    let @17 = select(@11, @5, (*acc!loop!loop)) in
    let @49 = select(@11, @44, @19) in
    let @22 = select(@11, (*!exit.then_2), @21) in
    let @25 = select(@11, (*!exit.then_0), @24) in
    let @28 = select(@11, (*!track.then_0.0), @27) in
    n!loop!loop = @16
    acc!loop!loop = @17
    !live = @49
    !exit.then_2 = @22
    !exit.then_0 = @25
    !track.then_0.0 = @28
  }
  let @50 = !(*!exit.then_2) in
  let @15 = reduce<any>((*!exit.then_2)) in
  if (@15) {
    let @42 = i32x8(-1) in
    masked_store(out[i], @42, (*!exit.then_2))
  }
  let @14 = reduce<any>(@50) in
  if (@14) {
    masked_store(out[i], (*!track.then_0.0), @50)
