type Entry_sums = struct Entry_sums{ n : i32; acc : i32; span : struct Span{ lo : i32; hi : i32; step : i32 }; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; span_lo : i32[]; span_hi : i32[]; span_step : i32[]; _slot : i32[] }
type Span = struct Span{ lo : i32; hi : i32; step : i32 }

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_ran : mut u8[8]
  let @4 = fill_bytes(sums_ran, 0u, 8) in
  sums_result : mut i32[8]
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums_span_hi_0 : mut i32[8]
  sums_span_step_0 : mut i32[8]
  sums__slot_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums_span_hi_1 : mut i32[8]
  sums_span_step_1 : mut i32[8]
  sums__slot_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @6 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, undef, sums_span_hi_0, sums_span_step_0, sums__slot_0) in
  sums_queue[0u] = @6
  let @8 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, undef, sums_span_hi_1, sums_span_step_1, sums__slot_1) in
  sums_queue[1u] = @8
  parfor i in [0:8:1] {
    let @0 = i + 1 in
    let s = build<Span>(i, 10, @0) in
    let @11 = walk(i, 0, s, (&sums_queue[0u]), (&sums_result[i]), i) in
    let @12 = out in
    let @13 = i in
    let @14 = @11.set in
    let @15 = @11.value in
    if (@14) {
      let @2 = @15 in
      out[i] = @2
      continue
    } else {
      sums_ran[i] = 1u
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @18 = (*sums!round) & 1u in
    let @20 = sums_queue[(*sums!round) & 1u].count in
    let @22 = @18 ^ 1u in
    sums_queue[@22].count = 0u
    parfor sums in [0u:@20:1u] {
      let @23 = (&sums_queue[@22]) in
      let @27 = sums_queue[@18].n in
      let @28 = @27[sums] in
      let @30 = sums_queue[@18].acc in
      let @31 = @30[sums] in
      let @33 = sums_queue[@18].span_hi in
      let @34 = @33[sums] in
      let @36 = sums_queue[@18].span_step in
      let @37 = @36[sums] in
      let @38 = build<Span>(undef, @34, @37) in
      let @40 = sums_queue[@18]._slot in
      let @41 = @40[sums] in
      walk(@28, @31, @38, @23, (&sums_result[@41]), @41)
      continue
    }
    let @17 = (*sums!round) + 1u in
    sums!round = @17
  }
  parfor sums_rest in [0:8:1] {
    let @48 = sums_result[sums_rest] in
    let @50 = sums_ran[sums_rest] in
    switch (@50) {
    case 0: {
      continue
    } break;
    default: {
      let @44 = @48 in
      let @45 = out in
      let @46 = sums_rest in
      @45[@46] = @44
      continue
    }
    }
  }
  return
}

func walk(n : i32, acc : i32, span : Span, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  let _t0 = span.hi in
  let @1 = _t0 <= n in
  if (@1) {
    _result_sums = acc
    let @7 = build<_option_sums>(acc, true) in
    return @7
  } else {
    let _t2 = span.step in
    let next = build<Span>(n, _t0, _t2) in
    let @4 = n + _t2 in
    let @5 = acc + n in
    let @8 = build<Entry_sums>(@4, @5, next, _slot_sums) in
    let @9 = build<_option_sums>(undef, false) in
    let @12 = atomic_add((&(*_queue_sums).count), 1u) in
    let @14 = (*_queue_sums).n in
    @14[@12] = @4
    let @17 = (*_queue_sums).acc in
    @17[@12] = @5
    let @20 = (*_queue_sums).span_hi in
    @20[@12] = _t0
    let @23 = (*_queue_sums).span_step in
    @23[@12] = _t2
    let @26 = (*_queue_sums)._slot in
    @26[@12] = _slot_sums
    return @9
  }
}


schedule {
    sums = run.queue(root);
    walk.defer(walk, sums)

}
