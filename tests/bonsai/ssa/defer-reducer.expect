type Entry_q = struct Entry_q{ x : f32; n : i32; _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; x : f32[]; n : i32[]; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q!round : mut u32
  q_total_slots : mut f32[8]
  q_x_0 : mut f32[8]
  q_n_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_x_1 : mut f32[8]
  q_n_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @5 = build<Queue_q>(0u, q_x_0, q_n_0, q__slot_0) in
  q_queue[0u] = @5
  let @7 = build<Queue_q>(0u, q_x_1, q_n_1, q__slot_1) in
  q_queue[1u] = @7
  parfor i in [0:8:1] {
    q_total_slots[i] = 0f
    let @0 = values[i] in
    let @30 = i >> 31 in
    let @31 = reinterpret_cast<u32>(@30) in
    let @32 = @31 >> 30u in
    let @33 = reinterpret_cast<i32>(@32) in
    let @34 = i + @33 in
    let @35 = @34 >> 2 in
    let @36 = @35 * 4 in
    let @1 = i - @36 in
    step(@0, @1, (&q_total_slots[i]), (&q_queue[0u]), i)
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @11 = (*q!round) & 1u in
    let @13 = q_queue[(*q!round) & 1u].count in
    let @15 = @11 ^ 1u in
    q_queue[@15].count = 0u
    parfor q in [0u:@13:1u] {
      let @16 = (&q_queue[@15]) in
      let @20 = q_queue[@11].x in
      let @21 = @20[q] in
      let @23 = q_queue[@11].n in
      let @24 = @23[q] in
      let @26 = q_queue[@11]._slot in
      let @27 = @26[q] in
      step(@21, @24, (&q_total_slots[@27]), @16, @27)
      continue
    }
    let @10 = (*q!round) + 1u in
    q!round = @10
  }
  parfor q_rest in [0:8:1] {
    let total = (&q_total_slots[q_rest]) in
    let i = q_rest in
    let @2 = (*total) in
    out[i] = @2
    continue
  }
  return
}

func [[noinline]] step(x : f32, n : i32, total : mut (f32*), _queue_q : mut (Queue_q*), _slot_q : i32) -> void {
  total += x
  let @0 = n == 0 in
  if (@0) {
    return
  } else {
    let @1 = x * 0.5f in
    let @2 = n - 1 in
    let @3 = build<Entry_q>(@1, @2, _slot_q) in
    let @6 = atomic_add((&(*_queue_q).count), 1u) in
    let @8 = (*_queue_q).x in
    @8[@6] = @1
    let @11 = (*_queue_q).n in
    @11[@6] = @2
    let @14 = (*_queue_q)._slot in
    @14[@6] = _slot_q
    return
  }
}


schedule host {
    q = run.queue(root);
    step.defer(step, q)

}
