type Entry_q = struct Entry_q{ x : f32; n : i32; _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; x : f32[]; n : i32[]; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q!round : mut u32
  q_total_slots : mut f32[8]
  q_ran : mut u8[8]
  let @5 = fill_bytes(q_ran, 0u, 8) in
  q_x_0 : mut f32[8]
  q_n_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_x_1 : mut f32[8]
  q_n_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @6 = build<Queue_q>(0u, q_x_0, q_n_0, q__slot_0) in
  q_queue[0u] = @6
  let @8 = build<Queue_q>(0u, q_x_1, q_n_1, q__slot_1) in
  q_queue[1u] = @8
  parfor i in [0:8:1] {
    q_total_slots[i] = 0f
    let @0 = values[i] in
    let @43 = i < 4 in
    let @44 = i - 4 in
    let @1 = select(@43, i, @44) in
    let @11 = step(@0, @1, (&q_total_slots[i]), (&q_queue[0u]), i) in
    let @12 = (&q_total_slots[i]) in
    let @13 = out in
    let @14 = i in
    if (@11) {
      q_ran[i] = 1u
      continue
    } else {
      let total = (&q_total_slots[i]) in
      let @2 = (*total) in
      out[i] = @2
      continue
    }
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @17 = (*q!round) & 1u in
    let @19 = q_queue[(*q!round) & 1u].count in
    let @21 = @17 ^ 1u in
    q_queue[@21].count = 0u
    parfor q in [0u:@19:1u] {
      let @22 = (&q_queue[@21]) in
      let @26 = q_queue[@17].x in
      let @27 = @26[q] in
      let @29 = q_queue[@17].n in
      let @30 = @29[q] in
      let @32 = q_queue[@17]._slot in
      let @33 = @32[q] in
      step(@27, @30, (&q_total_slots[@33]), @22, @33)
      continue
    }
    let @16 = (*q!round) + 1u in
    q!round = @16
  }
  parfor q_rest in [0:8:1] {
    let @42 = q_ran[q_rest] in
    switch (@42) {
    case 0: {
      continue
    } break;
    default: {
      let @37 = (&q_total_slots[q_rest]) in
      let @38 = out in
      let @39 = q_rest in
      let @35 = (*@37) in
      @38[@39] = @35
      continue
    }
    }
  }
  return
}

func step(x : f32, n : i32, total : mut (f32*), _queue_q : mut (Queue_q*), _slot_q : i32) -> bool {
  total += x
  let @0 = n == 0 in
  if (@0) {
    return false
  } else {
    let @1 = x * 0.5f in
    let @2 = n - 1 in
    let @3 = build<Entry_q>(@1, @2, _slot_q) in
    let @6 = atomic_add((&(*_queue_q).count), 1u) in
    let @8 = (*_queue_q).x in
    @8[@6] = @1
    let @11 = (*_queue_q).n in
    @11[@6] = @2
    let @14 = (*_queue_q)._slot in
    @14[@6] = _slot_q
    return true
  }
}


schedule {
    q = run.queue(root);
    step.defer(step, q)

}
