//! flags: -p ssa

// A deferred call under a nest of two producer loops whose inner bound is
// read inside the outer loop's body: `m = counts[0]` is a value of the
// iteration of `i`, and the queue, owned by the function, is sized before
// `i` by a copy of that read settled there (SSA/Defer.cpp, materialize).
// The pass over the record after the drain -- the continuation `out[i] =
// out[i] + 1.0`, run once per slot -- gets `i` back from the slot by
// dividing by the inner loop's trip count, and has to divide by that
// settled copy: the loop's own bound is out of scope where the pass runs.
// The golden shows the rest pass (`rays_rest!run`) dividing by the copy
// made before the `i` loop. The execution twin is
// correctness/llvm/defer-nest-inner-bound.
import stdlib/numerics;

func step(x : Float, n : i32, total : reduce(+) Float) -> void {
    total += x;
    if n == 0 {
        return;
    }
    step(x, n - 1, total);
    return;
}

func run(values : array[Float, 12], counts : array[u32, 1],
         out : mut array[Float, 4], total : reduce(+) Float) -> void {
    parfor i in 0u:4u {
        m = counts[0];
        parfor j in 0u:m {
            step(values[i * 3u + j], cast[[i32]](j), total);
            out[i] = out[i] + 1.0;
        }
    }
    return;
}

schedule {
    rays = run.queue(root);
    run.defer(step, rays);
    step.defer(step, rays);
}
