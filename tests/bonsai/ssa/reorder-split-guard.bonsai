//! flags: -p ssa

// reorder() through a split's tail guard. `split(i, io, ii, 4, true)` cuts
// the ten iterations of `i` into chunks of four with `if i < 10` around the
// body, so the `j` loop sits one block inside `ii`'s body; `reorder(ii, j)`
// then puts `j` outside `ii`, and the guard follows the body inward
// (SSA/ReorderLoops.cpp, "A tail guard between the two loops"). The golden
// shows the three places the guard lands: the prologue loop's body
// dispatching on it between the tail and the guarded block that zeroes
// `out[i]` and stores the expanded `base`; the new inner body dispatching
// on a recomputed copy before it enters the old `j` body; the epilogue
// loop likewise, when there is one. The execution twin is
// correctness/llvm/reorder-split-guard.
import stdlib/numerics;

func run(values : array[i32, 10], out : mut array[i32, 10]) -> void {
    parfor i in 0u:10u {
        base = values[i] * 2;
        out[i] = 0;
        parfor j in 0u:3u {
            out[i] = out[i] + base + cast[[i32]](j);
        }
    }
    return;
}

schedule {
    run.split(i, io, ii, 4, true);
    run.reorder(ii, j);
}
