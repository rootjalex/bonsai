; === ssa postschedule ===
; --- run ---
; storage q.acc : f32 as q_acc_slots
; storage q.rest.w : f32 as q_rest_w
; storage q.ran : u8 as q_ran
; storage q.result : f32 as q_result
func run(values : f32[8], out : f32[8]): 
  q_acc_slots = alloca<f32[8]> scratch()
  q_rest_w = alloca<f32[8]> scratch()
  q_ran = alloca<u8[8]> scratch()
  @8 = fill_bytes(q_ran, (u8)0, (i32)8)
  q_result = alloca<f32[8]> scratch()
  q__slot = alloca<i32[8]> scratch()
  q_queue = alloca<(Queue_q*)> scratch()
  @10 = make_struct<Queue_q>((u32)0, q__slot)
  store q_queue @10
  parfor i (i32)0:(i32)8:(i32)1 !par_body_0(values, out, q_acc_slots, q_result, q_rest_w, q_queue, q_ran) q!drain(q_queue, values, q__slot, q_acc_slots, q_result, q_rest_w, out, q_ran)

!par_body_0(i : i32, values : f32[8], out : f32[8], q_acc_slots : f32[8], q_result : f32[8], q_rest_w : f32[8], q_queue : (Queue_q*), q_ran : u8[8]): // preds: run
  @7 = gep(q_acc_slots, i)
  store @7 (f32)0
  _t22 = extract_idx(values, i)
  w = add(_t22, (f32)1)
  @9 = gep(q_result, i)
  @11 = gep(q_rest_w, i)
  store @11 w
  callc step(_t22, @7, q_queue, @9, i) q!deferred(@7, w, out, i, q_ran, i)

!par_cont_1(): // preds: q_rest!exit
  ret

!step_call_cont_2(@2 : f32, acc : (f32*), w : f32, out : f32[8], i : i32): // preds: q!deferred
  s = set(@2)
  @3 = load(acc)
  @4 = add(s, @3)
  @5 = add(@4, w)
  @6 = gep(out, i)
  store @6 @5
  yield

q!deferred(@12 : _option_q, @13 : (f32*), @14 : f32, @15 : f32[8], @16 : i32, q_ran : u8[8], i : i32): // preds: !par_body_0
  @17 = load_field(@12, (u32)1)
  @18 = load_field(@12, (u32)0)
  dispatch @17 [q!end(q_ran, i), !step_call_cont_2(@18, @13, @14, @15, @16)]

q!end(q_ran : u8[8], i : i32): // preds: q!deferred
  @19 = gep(q_ran, i)
  store @19 (u8)1
  yield

q!drain(q_queue : (Queue_q*), values : f32[8], q__slot : i32[8], q_acc_slots : f32[8], q_result : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: run
  @20 = load(q_queue)
  @21 = load_field(@20, (u32)0)
  parfor q (u32)0:@21:(u32)1 q!run(values, q__slot, q_acc_slots, q_result) q!exit(q_queue, q_result, q_acc_slots, q_rest_w, out, q_ran)

q!run(q : u32, values : f32[8], q__slot : i32[8], q_acc_slots : f32[8], q_result : f32[8]): // preds: q!drain
  @22 = extract_idx(q__slot, q)
  @23 = extract_idx(values, @22)
  @24 = gep(q_acc_slots, @22)
  @26 = gep(q_result, @22)
  callc step!work!k(@23, @24) q!ran(@26)

q!ran(@25 : f32, @26 : (f32*)): // preds: q!run
  store @26 @25
  yield

q!exit(q_queue : (Queue_q*), q_result : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: q!drain
  @27 = field.ptr(q_queue, (u32)0)
  store @27 (u32)0
  jmp q_rest(q_result, q_acc_slots, q_rest_w, out, q_ran)

!step_call_cont_2!rest(@32 : f32, @33 : (f32*), @34 : f32, @35 : f32[8], @36 : i32): // preds: q_rest!run
  s = set(@32)
  @28 = load(@33)
  @29 = add(s, @28)
  @30 = add(@29, @34)
  @31 = gep(@35, @36)
  store @31 @30
  yield

q_rest(q_result : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: q!exit
  parfor q_rest (i32)0:(i32)8:(i32)1 q_rest!run(q_result, q_acc_slots, q_rest_w, out, q_ran) q_rest!exit()

q_rest!run(q_rest : i32, q_result : f32[8], q_acc_slots : f32[8], q_rest_w : f32[8], out : f32[8], q_ran : u8[8]): // preds: q_rest
  @37 = gep(q_result, q_rest)
  @38 = load(@37)
  @39 = gep(q_acc_slots, q_rest)
  @40 = gep(q_rest_w, q_rest)
  @41 = load(@40)
  @42 = gep(q_ran, q_rest)
  @43 = load(@42)
  dispatch @43 [q_rest!skip(), !step_call_cont_2!rest(@38, @39, @41, out, q_rest)]

q_rest!exit(): // preds: q_rest
  jmp !par_cont_1()

q_rest!skip(): // preds: q_rest!run
  yield

; --- step ---
func step(x : f32, acc : (f32*), _queue_q : (Queue_q*), _result_q : (f32*), _slot_q : i32): 
  @0 = lt((f32)4, x)
  dispatch @0 [!merge_1(_result_q), !then_0(x, acc, _slot_q, _queue_q)]

!then_0(x : f32, acc : (f32*), _slot_q : i32, _queue_q : (Queue_q*)): // preds: step
  @4 = make_struct<Entry_q>(_slot_q)
  @5 = make_struct<_option_q>((f32)undef, (bool)0)
  defer _queue_q @4 ret @5

!merge_1(_result_q : (f32*)): // preds: step
  store _result_q (f32)-1
  @3 = make_struct<_option_q>((f32)-1, (bool)1)
  ret @3

; --- step!after ---
func step!after(@1 : f32, acc : (f32*)): 
  r = set(@1)
  acc.add acc r
  @2 = add(r, (f32)1)
  ret @2

; --- step!work!k ---
func step!work!k(x : f32, acc : (f32*)): 
  callc work(x) step!work!k!ran(acc)

step!work!k!ran($work : f32, acc : (f32*)): // preds: step!work!k
  callc step!after($work, acc) step!work!k!done()

step!work!k!done($k : f32): // preds: step!work!k!ran
  ret $k

; --- work ---
func work(x : f32): 
  @0 = mul(x, (f32)0.5)
  ret @0

type Entry_q = struct Entry_q{ _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q_acc_slots : mut f32[8]
  q_rest_w : mut f32[8]
  q_ran : mut u8[8]
  let @8 = fill_bytes(q_ran, 0u, 8) in
  q_result : mut f32[8]
  q__slot : mut i32[8]
  q_queue : mut Queue_q
  let @10 = build<Queue_q>(0u, q__slot) in
  q_queue = @10
  parfor i in [0:8:1] {
    q_acc_slots[i] = 0f
    let _t22 = values[i] in
    let w = _t22 + 1f in
    q_rest_w[i] = w
    let @12 = step(_t22, (&q_acc_slots[i]), q_queue, (&q_result[i]), i) in
    let @13 = (&q_acc_slots[i]) in
    let @14 = w in
    let @15 = out in
    let @16 = i in
    let @17 = @12.set in
    let @18 = @12.value in
    if (@17) {
      let @2 = @18 in
      let acc = (&q_acc_slots[i]) in
      let s = @2 in
      let @3 = (*acc) in
      let @4 = s + @3 in
      let @5 = @4 + w in
      out[i] = @5
      continue
    } else {
      q_ran[i] = 1u
      continue
    }
  }
  let @20 = (*q_queue) in
  let @21 = @20.count in
  parfor q in [0u:@21:1u] {
    let @22 = q__slot[q] in
    let @23 = values[@22] in
    let @25 = step!work!k(@23, (&q_acc_slots[@22])) in
    let @26 = (&q_result[@22]) in
    @26 = @25
    continue
  }
  q_queue.count = 0u
  parfor q_rest in [0:8:1] {
    let @38 = q_result[q_rest] in
    let @41 = q_rest_w[q_rest] in
    let @43 = q_ran[q_rest] in
    switch (@43) {
    case 0: {
      continue
    } break;
    default: {
      let @32 = @38 in
      let @33 = (&q_acc_slots[q_rest]) in
      let @34 = @41 in
      let @35 = out in
      let @36 = q_rest in
      let s = @32 in
      let @28 = (*@33) in
      let @29 = s + @28 in
      let @30 = @29 + @34 in
      @35[@36] = @30
      continue
    }
    }
  }
  return
}

func step(x : f32, acc : mut (f32*), _queue_q : mut (Queue_q*), _result_q : mut (f32*), _slot_q : i32) -> _option_q {
  let @0 = 4f < x in
  if (@0) {
    let @4 = build<Entry_q>(_slot_q) in
    let @5 = build<_option_q>(undef, false) in
    let @8 = atomic_add((&(*_queue_q).count), 1u) in
    let @10 = (*_queue_q)._slot in
    @10[@8] = _slot_q
    return @5
  } else {
    _result_q = -1f
    let @3 = build<_option_q>(-1f, true) in
    return @3
  }
}

func step!after(@1 : f32, acc : mut (f32*)) -> f32 {
  let r = @1 in
  acc += r
  let @2 = r + 1f in
  return @2
}

func step!work!k(x : f32, acc : mut (f32*)) -> f32 {
  let $work = work(x) in
  let $k = step!after($work, acc) in
  return $k
}

func work(x : f32) -> f32 {
  let @0 = x * 0.5f in
  return @0
}


schedule {
    q = run.queue(root);
    step.defer(work, q)

}
