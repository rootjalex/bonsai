func shade!Matte(s : Surface, f : Finish, x : f32, total : mut (f32*)) -> void {
  let @10 = s._pad in
  let @11 = s.payload in
  let s!Matte = build<Surface>(0u, @10, @11) in
  let @2 = @11[0u] in
  let a = reinterpret_cast<f32>(@2) in
  let @4 = a * x in
