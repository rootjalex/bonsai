    return @4
  } else {
    let @5 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @6 = reinterpret_cast<u32>(x) in
    let @7 = build<[[packed]] u32x1>(@6) in
    let @8 = build<Surface>(1u, @5, @7) in
    return @8
  }
}

func finish_of(x : f32) -> Finish {
  let @0 = x < 15f in
  if (@0) {
    let @1 = build<[[packed]] u8x3>(0u, 0u, 0u) in
