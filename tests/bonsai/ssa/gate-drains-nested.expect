func run(values : f32[8], total : mut (f32*), surface_arms : u64, fuzz_finish_arms : u64) -> void {
  hits!Matte_s_payload_x : mut u32[8]
  hits!Matte_x : mut f32[8]
  hits!Fuzz!Flat_s_payload_x : mut u32[8]
  hits!Fuzz!Gloss_s_payload_x : mut u32[8]
  hits_queue : mut Queue_hits[3]
  let @1 = build<Queue_hits>(0u, undef, hits!Matte_s_payload_x, undef, hits!Matte_x) in
  hits_queue[0u] = @1
  let @3 = build<Queue_hits>(0u, undef, hits!Fuzz!Flat_s_payload_x, undef, undef) in
  hits_queue[1u] = @3
  let @5 = build<Queue_hits>(0u, undef, hits!Fuzz!Gloss_s_payload_x, undef, undef) in
  hits_queue[2u] = @5
  parfor i in [0:8:1] {
    let @0 = values[i] in
    step(@0, total, hits_queue)
    continue
  }
  let @8 = hits_queue[0u] in
  let @9 = @8.count in
  let @52 = surface_arms >> 0u in
  let @53 = @52 & 1u in
  let @54 = @53 != 0u in
  if (@54) {
    parfor hits!Matte in [0u:@9:1u] {
      let @11 = build<[[packed]] u8x3>(0u, 0u, 0u) in
      let @13 = hits_queue[0u].s_payload_x in
      let @14 = @13[hits!Matte] in
      let @15 = build<[[packed]] u32x1>(@14) in
      let @16 = build<Surface>(undef, @11, @15) in
      let @18 = hits_queue[0u].x in
      let @19 = @18[hits!Matte] in
      shade!Matte(@16, undef, @19, total)
      continue
    }
  }
  let @21 = hits_queue[1u] in
  let @22 = @21.count in
  let @55 = fuzz_finish_arms >> 0u in
  let @56 = @55 & 1u in
  let @57 = @56 != 0u in
  let @58 = surface_arms >> 1u in
  let @59 = @58 & 1u in
  let @60 = @59 != 0u in
  let @61 = @57 && @60 in
  if (@61) {
    parfor hits!Fuzz!Flat in [0u:@22:1u] {
      let @24 = build<[[packed]] u8x3>(0u, 0u, 0u) in
      let @26 = hits_queue[1u].s_payload_x in
      let @27 = @26[hits!Fuzz!Flat] in
      let @28 = build<[[packed]] u32x1>(@27) in
      let @29 = build<Surface>(undef, @24, @28) in
      let @31 = build<[[packed]] u32x0>() in
      let @32 = build<Finish>(undef, @24, @31) in
      shade!Fuzz!Flat(@29, @32, undef, total)
      continue
    }
  }
  let @34 = hits_queue[2u] in
  let @35 = @34.count in
  let @62 = fuzz_finish_arms >> 1u in
  let @63 = @62 & 1u in
  let @64 = @63 != 0u in
  let @68 = @64 && @60 in
  if (@68) {
    parfor hits!Fuzz!Gloss in [0u:@35:1u] {
      let @37 = build<[[packed]] u8x3>(0u, 0u, 0u) in
      let @39 = hits_queue[2u].s_payload_x in
      let @40 = @39[hits!Fuzz!Gloss] in
      let @41 = build<[[packed]] u32x1>(@40) in
      let @42 = build<Surface>(undef, @37, @41) in
      let @44 = build<[[packed]] u32x0>() in
      let @45 = build<Finish>(undef, @37, @44) in
      shade!Fuzz!Gloss(@42, @45, undef, total)
      continue
    }
  }
  hits_queue[0u].count = 0u
  hits_queue[1u].count = 0u
  hits_queue[2u].count = 0u
  return
}

func shade(s : Surface, f : Finish, x : f32, total : mut (f32*)) -> void {
  let @0 = s.tag in
  switch (@0) {
  case 0: { // Surface.Matte of shade
    let @1 = s.payload in
    let @2 = @1[0u] in
    let a = reinterpret_cast<f32>(@2) in
    let @4 = a * x in
    total += @4
  } break;
  default: { // Surface.Fuzz of shade
    let @5 = s.payload in
    let @6 = @5[0u] in
    let a$1 = reinterpret_cast<f32>(@6) in
    let @8 = f.tag in
    switch (@8) {
    case 0: { // Finish.Flat of shade
      total += a$1
    } break;
    default: { // Finish.Gloss of shade
      let @9 = a$1 * 2f in
      total += @9
    }
    }
  }
  }
  return
}

