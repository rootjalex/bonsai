type Entry_hits = struct Entry_hits{ s : struct Surface{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x1 }; f : struct Finish{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x0 }; x : f32 }
