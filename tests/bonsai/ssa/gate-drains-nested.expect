  default: {
    let @17 = (*finish_of$r7) in
    let @16 = (*classify$r6) in
    let @22 = @17.tag in
    switch (@22) {
    case 0: {
      let @52 = atomic_add((&_queue_hits[1u].count), 1u) in
      let @59 = (*classify$r6).payload in
