type Flat = struct Flat{  }
type Float = f32
type Fuzz = struct Fuzz{ a : f32 }
type Gloss = struct Gloss{  }
type Half = f16
type Matte = struct Matte{ a : f32 }
type Queue_hits = struct Queue_hits{ count : u32; s_tag : u8[]; s_payload_x : u32[]; f_tag : u8[]; x : f32[] }
type Surface = struct Surface{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x1 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func classify(x : f32) -> Surface {
  let @0 = x < 10f in
  if (@0) {
    let @1 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @2 = reinterpret_cast<u32>(x) in
    let @3 = build<[[packed]] u32x1>(@2) in
