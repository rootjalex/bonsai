type Entry_q = struct Entry_q{ x : f32; n : i32; _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; x : f32[]; n : i32[]; _slot : i32[] }
type Record = struct Record{ p : f32x3; w : f32; hits : i32; seen : bool }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q!round : mut u32
  q_rec_seen_slots : mut bool[8]
  q_rec_hits_slots : mut i32[8]
  q_rec_p_slots : mut [[packed]] f32x3[8]
  q_x_0 : mut f32[8]
  q_n_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_x_1 : mut f32[8]
  q_n_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @16 = build<Queue_q>(0u, q_x_0, q_n_0, q__slot_0) in
  q_queue[0u] = @16
  let @18 = build<Queue_q>(0u, q_x_1, q_n_1, q__slot_1) in
  q_queue[1u] = @18
  parfor i in [0:8:1] {
    let _t22 = values[i] in
    let @1 = build<f32x3>(_t22, 0f, 1f) in
    let @59 = cast<[[packed]] f32x3>(@1) in
    q_rec_p_slots[i] = @59
    q_rec_hits_slots[i] = 0
    q_rec_seen_slots[i] = false
    let @41 = i < 4 in
    let @42 = i - 4 in
    let @3 = select(@41, i, @42) in
    step(_t22, @3, (&q_rec_p_slots[i]), (&q_rec_hits_slots[i]), (&q_rec_seen_slots[i]), (&q_queue[0u]), i)
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @22 = (*q!round) & 1u in
    let @24 = q_queue[(*q!round) & 1u].count in
    let @26 = @22 ^ 1u in
    q_queue[@26].count = 0u
    parfor q in [0u:@24:1u] {
      let @27 = (&q_queue[@26]) in
      let @31 = q_queue[@22].x in
      let @32 = @31[q] in
      let @34 = q_queue[@22].n in
      let @35 = @34[q] in
      let @37 = q_queue[@22]._slot in
      let @38 = @37[q] in
      step(@32, @35, (&q_rec_p_slots[@38]), (&q_rec_hits_slots[@38]), (&q_rec_seen_slots[@38]), @27, @38)
      continue
    }
    let @21 = (*q!round) + 1u in
    q!round = @21
  }
  parfor q_rest in [0:8:1] {
    let i = q_rest in
    let rec!arg_p = (&q_rec_p_slots[q_rest]) in
    let rec!arg_hits = (&q_rec_hits_slots[q_rest]) in
    let rec!arg_seen = (&q_rec_seen_slots[q_rest]) in
    let @55 = (*rec!arg_seen) in
    let @56 = (*rec!arg_hits) in
    let @8 = cast<f32>(@56) in
    let @57 = (*rec!arg_p) in
    let @58 = cast<f32x3>(@57) in
    let @11 = @58[0u] in
    let @12 = @8 + @11 in
    let @13 = select(@55, @12, 0f) in
    out[i] = @13
    continue
  }
  return
}

func step(x : f32, n : i32, rec_p : mut ([[packed]] f32x3*), rec_hits : mut (i32*), rec_seen : mut (bool*), _queue_q : mut (Queue_q*), _slot_q : i32) -> void {
  let @10 = (*rec_hits) in
  let @2 = @10 + 1 in
  rec_hits = @2
  let @4 = n == 0 in
  if (@4) {
    rec_seen = true
    return
  } else {
    let @6 = x * 0.5f in
    let @7 = n - 1 in
    let @8 = build<Entry_q>(@6, @7, _slot_q) in
    let @12 = atomic_add((&(*_queue_q).count), 1u) in
    let @14 = (*_queue_q).x in
    @14[@12] = @6
    let @17 = (*_queue_q).n in
    @17[@12] = @7
    let @20 = (*_queue_q)._slot in
    @20[@12] = _slot_q
    return
  }
}


schedule {
    q = run.queue(root);
    step.defer(step, q)

}
