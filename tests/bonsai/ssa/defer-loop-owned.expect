type Entry_paths = struct Entry_paths{ s : i32; depth : i32; acc : i32 }
type Queue_paths = struct Queue_paths{ count : u32; s : i32[]; depth : i32[]; acc : i32[] }

func render(out : mut i32[16]) -> void {
  parfor p in [0:4:1] {
    paths!round : mut u32
    paths_s_0 : mut i32[4]
    paths_depth_0 : mut i32[4]
    paths_acc_0 : mut i32[4]
    paths_s_1 : mut i32[4]
    paths_depth_1 : mut i32[4]
    paths_acc_1 : mut i32[4]
    paths_queue : mut Queue_paths[2]
    let @0 = build<Queue_paths>(0u, paths_s_0, paths_depth_0, paths_acc_0) in
    paths_queue[0u] = @0
    let @2 = build<Queue_paths>(0u, paths_s_1, paths_depth_1, paths_acc_1) in
    paths_queue[1u] = @2
    parfor s in [0:4:1] {
      let @5 = walk(p, s, s, 0, out, (&paths_queue[0u])) in
      if (@5) {
        continue
      } else {
        continue
      }
    }
    paths!round = 0u
    while (!(paths_queue[(*paths!round) & 1u].count == 0u)) {
      let @7 = (*paths!round) & 1u in
      let @9 = paths_queue[(*paths!round) & 1u].count in
      let @11 = @7 ^ 1u in
      paths_queue[@11].count = 0u
      parfor paths in [0u:@9:1u] {
        let @16 = paths_queue[@7].s in
        let @17 = @16[paths] in
        let @19 = paths_queue[@7].depth in
        let @20 = @19[paths] in
        let @22 = paths_queue[@7].acc in
        let @23 = @22[paths] in
        let @25 = walk(p, @17, @20, @23, out, (&paths_queue[@11])) in
        if (@25) {
          continue
        } else {
          continue
        }
      }
      let @6 = (*paths!round) + 1u in
      paths!round = @6
    }
    continue
  }
  return
}

func [[noinline]] walk(p : i32, s : i32, depth : i32, acc : i32, out : mut i32[16], _queue_paths : mut (Queue_paths*)) -> bool {
  let @0 = depth == 0 in
  if (@0) {
    let @1 = p << 2 in
    let @2 = @1 + s in
    out[@2] = acc
    return false
  } else {
    let @4 = depth - 1 in
    let @5 = acc + depth in
    let @6 = build<Entry_paths>(s, @4, @5) in
    let @9 = atomic_add((&(*_queue_paths).count), 1u) in
    let @11 = (*_queue_paths).s in
    @11[@9] = s
    let @14 = (*_queue_paths).depth in
    @14[@9] = @4
    let @17 = (*_queue_paths).acc in
    @17[@9] = @5
    return true
  }
}


schedule host {
    paths = render.queue(p);
    walk.defer(walk, paths)

}
