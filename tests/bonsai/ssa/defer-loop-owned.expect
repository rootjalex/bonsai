type Entry_paths = struct Entry_paths{ s : i32; depth : i32; acc : i32 }
type Queue_paths = struct Queue_paths{ count : u32; s : i32[]; depth : i32[]; acc : i32[] }

func render(out : mut i32[16]) -> void {
  parfor p in [0:4:1] {
    paths!round : mut u32
    paths_s_0 : mut i32[4]
    paths_depth_0 : mut i32[4]
    paths_acc_0 : mut i32[4]
    paths_s_1 : mut i32[4]
    paths_depth_1 : mut i32[4]
    paths_acc_1 : mut i32[4]
    paths_queue : mut Queue_paths[2]
    let @0 = build<Queue_paths>(0u, paths_s_0, paths_depth_0, paths_acc_0) in
    paths_queue[0u] = @0
    let @2 = build<Queue_paths>(0u, paths_s_1, paths_depth_1, paths_acc_1) in
    paths_queue[1u] = @2
    parfor s in [0:4:1] {
      walk(p, s, s, 0, out, (&paths_queue[0u]))
      continue
    }
    paths!round = 0u
    while (!(paths_queue[(*paths!round) & 1u].count == 0u)) {
      let @6 = (*paths!round) & 1u in
      let @8 = paths_queue[(*paths!round) & 1u].count in
      let @10 = @6 ^ 1u in
      paths_queue[@10].count = 0u
      parfor paths in [0u:@8:1u] {
        let @11 = (&paths_queue[@10]) in
        let @15 = paths_queue[@6].s in
        let @16 = @15[paths] in
        let @18 = paths_queue[@6].depth in
        let @19 = @18[paths] in
        let @21 = paths_queue[@6].acc in
        let @22 = @21[paths] in
        walk(p, @16, @19, @22, out, @11)
        continue
      }
      let @5 = (*paths!round) + 1u in
      paths!round = @5
    }
    continue
  }
  return
}

func [[noinline]] walk(p : i32, s : i32, depth : i32, acc : i32, out : mut i32[16], _queue_paths : mut (Queue_paths*)) -> void {
  let @0 = depth == 0 in
  if (@0) {
    let @1 = p << 2 in
    let @2 = @1 + s in
    out[@2] = acc
    return
  } else {
    let @4 = depth - 1 in
    let @5 = acc + depth in
    let @6 = build<Entry_paths>(s, @4, @5) in
    let @9 = atomic_add((&(*_queue_paths).count), 1u) in
    let @11 = (*_queue_paths).s in
    @11[@9] = s
    let @14 = (*_queue_paths).depth in
    @14[@9] = @4
    let @17 = (*_queue_paths).acc in
    @17[@9] = @5
    return
  }
}


schedule host {
    paths = render.queue(p);
    walk.defer(walk, paths)

}
