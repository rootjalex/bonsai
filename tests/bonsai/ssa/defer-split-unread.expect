type Entry_hits = struct Entry_hits{ @0 : struct Kind{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x1 }; extra : f32; _slot : i32 }
type Float = f32
type Half = f16
type Kind = struct Kind{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x1 }
type Large = struct Large{ x : f32 }
type Queue_hits = struct Queue_hits{ count : u32; @0_tag : u8[]; @0_payload_x : u32[]; extra : f32[]; _slot : i32[] }
type Small = struct Small{ x : f32 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[noinline]] classify(x : f32) -> Kind {
  let @0 = x < 10f in
  if (@0) {
    let @1 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @2 = reinterpret_cast<u32>(x) in
    let @3 = build<[[packed]] u32x1>(@2) in
    let @4 = build<Kind>(0u, @1, @3) in
    return @4
  } else {
    let @5 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @6 = reinterpret_cast<u32>(x) in
    let @7 = build<[[packed]] u32x1>(@6) in
    let @8 = build<Kind>(1u, @5, @7) in
    return @8
  }
}

func run(values : f32[8], k : f32, out : mut f32[8]) -> void {
  hits_result : mut f32[8]
  hits!Small_@0_tag : mut u8[8]
  hits!Small_@0_payload_x : mut u32[8]
  hits!Small__slot : mut i32[8]
  hits!Large_@0_tag : mut u8[8]
  hits!Large_@0_payload_x : mut u32[8]
  hits!Large_extra : mut f32[8]
  hits!Large__slot : mut i32[8]
  hits_queue : mut Queue_hits[2]
  let @6 = build<Queue_hits>(0u, hits!Small_@0_tag, hits!Small_@0_payload_x, undef, hits!Small__slot) in
  hits_queue[0u] = @6
  let @8 = build<Queue_hits>(0u, hits!Large_@0_tag, hits!Large_@0_payload_x, hits!Large_extra, hits!Large__slot) in
  hits_queue[1u] = @8
  parfor i in [0:8:1] {
    let @0 = values[i] in
    let @1 = 7 - i in
    let @2 = values[@1] in
    step(@0, k, @2, hits_queue, (&hits_result[i]), i)
    continue
  }
  let @11 = hits_queue[0u] in
  let @12 = @11.count in
  parfor hits!Small in [0u:@12:1u] {
    let @15 = hits_queue[0u].@0_tag in
    let @16 = @15[hits!Small] in
    let @17 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @19 = hits_queue[0u].@0_payload_x in
    let @20 = @19[hits!Small] in
    let @21 = build<[[packed]] u32x1>(@20) in
    let @22 = build<Kind>(@16, @17, @21) in
    let @25 = hits_queue[0u]._slot in
    let @26 = @25[hits!Small] in
    let @23 = step!after!Small(@22, k, undef) in
    let @27 = (&hits_result[@26]) in
    @27 = @23
    continue
  }
  let @29 = hits_queue[1u] in
  let @30 = @29.count in
  parfor hits!Large in [0u:@30:1u] {
    let @33 = hits_queue[1u].@0_tag in
    let @34 = @33[hits!Large] in
    let @35 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @37 = hits_queue[1u].@0_payload_x in
    let @38 = @37[hits!Large] in
    let @39 = build<[[packed]] u32x1>(@38) in
    let @40 = build<Kind>(@34, @35, @39) in
    let @42 = hits_queue[1u].extra in
    let @43 = @42[hits!Large] in
    let @46 = hits_queue[1u]._slot in
    let @47 = @46[hits!Large] in
    let @44 = step!after!Large(@40, k, @43) in
    let @48 = (&hits_result[@47]) in
    @48 = @44
    continue
  }
  hits_queue[0u].count = 0u
  hits_queue[1u].count = 0u
  parfor hits_rest in [0:8:1] {
    let @54 = hits_result[hits_rest] in
    let @3 = @54 in
    let i = hits_rest in
    out[i] = @3
    continue
  }
  return
}

func [[noinline]] step(x : f32, k : f32, extra : f32, _queue_hits : mut Queue_hits[2], _result_hits : mut (f32*), _slot_hits : i32) -> void {
  let @0 = classify(x) in
  let @11 = build<Entry_hits>(@0, extra, _slot_hits) in
  let @12 = @0.tag in
  switch (@12) {
  case 0: {
    let @18 = atomic_add((&_queue_hits[0u].count), 1u) in
    let @20 = @0.tag in
    let @25 = @0.payload in
    let @26 = @25[0u] in
    let @30 = _queue_hits[0u].@0_tag in
    @30[@18] = @20
    let @33 = _queue_hits[0u].@0_payload_x in
    @33[@18] = @26
    let @36 = _queue_hits[0u]._slot in
    @36[@18] = _slot_hits
    return
  } break;
  default: {
    let @39 = atomic_add((&_queue_hits[1u].count), 1u) in
    let @41 = @0.tag in
    let @46 = @0.payload in
    let @47 = @46[0u] in
    let @51 = _queue_hits[1u].@0_tag in
    @51[@39] = @41
    let @54 = _queue_hits[1u].@0_payload_x in
    @54[@39] = @47
    let @57 = _queue_hits[1u].extra in
    @57[@39] = extra
    let @60 = _queue_hits[1u]._slot in
    @60[@39] = _slot_hits
    return
  }
  }
}

func [[noinline]] step!after(@0 : Kind, k : f32, extra : f32) -> f32 {
  let kind = @0 in
  let @1 = kind.tag in
  switch (@1) {
  case 0: { // Kind.Small of step
    let @2 = kind.payload in
    let @3 = @2[0u] in
    let v = reinterpret_cast<f32>(@3) in
    let @5 = v + k in
    return @5
  } break;
  default: { // Kind.Large of step
    let @6 = kind.payload in
    let @7 = @6[0u] in
    let v$1 = reinterpret_cast<f32>(@7) in
    let @9 = v$1 * k in
    let @10 = @9 + extra in
    return @10
  }
  }
}

func [[noinline]] step!after!Large(@0 : Kind, k : f32, extra : f32) -> f32 {
  let kind = @0 in
  let @11 = kind._pad in
  let @12 = kind.payload in
  let kind!Large = build<Kind>(1u, @11, @12) in
  let @7 = @12[0u] in
  let v$1 = reinterpret_cast<f32>(@7) in
  let @9 = v$1 * k in
  let @10 = @9 + extra in
  return @10
}

func [[noinline]] step!after!Small(@0 : Kind, k : f32, extra : f32) -> f32 {
  let kind = @0 in
  let @11 = kind._pad in
  let @12 = kind.payload in
  let kind!Small = build<Kind>(0u, @11, @12) in
  let @3 = @12[0u] in
  let v = reinterpret_cast<f32>(@3) in
  let @5 = v + k in
  return @5
}


schedule host {
    hits = run.queue(root);
    step.stage(classify, hits)

}
