type Entry_q = struct Entry_q{ @0 : f32; i : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; @0 : f32[]; i : i32[] }
type Saved_step!after = struct Saved_step!after{ saved : bool; slot : u32; value : f32 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], k : f32, out : mut f32[8]) -> void {
  q_@0 : mut f32[8]
  q_i : mut i32[8]
  q_queue : mut Queue_q
  let @3 = build<Queue_q>(0u, q_@0, q_i) in
  q_queue = @3
  parfor i in [0:8:1] {
    let @0 = values[i] in
    let @4 = step(@0, k, q_queue) in
    let @5 = @4.saved in
    let @6 = @4.value in
    if (@5) {
      let @7 = @4.slot in
      q_i[@7] = i
      continue
    } else {
      let @1 = @6 in
      out[i] = @1
      continue
    }
  }
  let @10 = (*q_queue) in
  let @11 = @10.count in
  parfor q in [0u:@11:1u] {
    let @12 = q_@0[q] in
    let @14 = q_i[q] in
    let @13 = step!after(@12, k) in
    let @1 = @13 in
    let i = @14 in
    out[i] = @1
    continue
  }
  q_queue.count = 0u
  return
}

func [[noinline]] step(x : f32, k : f32, _queue_q : mut (Queue_q*)) -> Saved_step!after {
  let @0 = work(x) in
  let @2 = build<Entry_q>(@0, undef) in
  let @6 = atomic_add((&(*_queue_q).count), 1u) in
  let @8 = (*_queue_q).@0 in
  @8[@6] = @0
  let @4 = build<Saved_step!after>(true, @6, undef) in
  return @4
}

func [[noinline]] step!after(@0 : f32, k : f32) -> f32 {
  let r = @0 in
  let @1 = r + k in
  return @1
}

func [[noinline]] work(x : f32) -> f32 {
  let @0 = x * 2f in
  return @0
}


schedule host {
    q = run.queue(root);
    step.stage(work, q)

}
