type Entry_q = struct Entry_q{ @0 : f32; _result : (f32*) }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; @0 : f32[]; _result : (f32*)[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], k : f32, out : mut f32[8]) -> void {
  q_result : mut f32[8]
  q_@0 : mut f32[8]
  q__result : mut (f32*)[8]
  q_queue : mut Queue_q
  let @3 = build<Queue_q>(0u, q_@0, q__result) in
  q_queue = @3
  parfor i in [0:8:1] {
    let @0 = values[i] in
    step(@0, k, q_queue, (&q_result[i]))
    continue
  }
  let @5 = (*q_queue) in
  let @6 = @5.count in
  parfor q in [0u:@6:1u] {
    let @7 = q_@0[q] in
    let @9 = q__result[q] in
    let @8 = step!after(@7, k) in
    @9 = @8
    continue
  }
  q_queue.count = 0u
  parfor q_rest in [0:8:1] {
    let @12 = q_result[q_rest] in
    let @1 = @12 in
    let i = q_rest in
    out[i] = @1
    continue
  }
  return
}

func [[noinline]] step(x : f32, k : f32, _queue_q : mut (Queue_q*), _result_q : mut (f32*)) -> void {
  let @0 = work(x) in
  let @2 = build<Entry_q>(@0, _result_q) in
  let @5 = atomic_add((&(*_queue_q).count), 1u) in
  let @7 = (*_queue_q).@0 in
  @7[@5] = @0
  let @10 = (*_queue_q)._result in
  @10[@5] = _result_q
  return
}

func [[noinline]] step!after(@0 : f32, k : f32) -> f32 {
  let r = @0 in
  let @1 = r + k in
  return @1
}

func [[noinline]] work(x : f32) -> f32 {
  let @0 = x * 2f in
  return @0
}


schedule host {
    q = run.queue(root);
    step.stage(work, q)

}
