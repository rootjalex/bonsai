func bar(a : f32) -> f32 {
  let @0 = a - 1f in
  return @0
}

func color(a : f32, b : f32) -> f32 {
  c : mut f32
  c = 0f
  let @0 = b < 0f in
  if (@0) {
    c = 2f
  }
  let @1 = (*c) in
  let @2 = bar(a) in
  let @3 = b + @2 in
  let @4 = @3 + 1f in
  let @5 = @1 * @4 in
  let @6 = a + @5 in
  return @6
}

func foo(a : f32) -> f32 {
  let @0 = a + 1f in
  return @0
}


