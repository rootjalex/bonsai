  let @112 = @1[0u] in
  let @113 = @0.!0 in
  let @139 = f32x4(@112) in
  let @114 = @139 - @113 in
  let @115 = @1[1u] in
  let @116 = @0.!1 in
  let @140 = f32x4(@115) in
  let @117 = @140 - @116 in
  let @118 = @1[2u] in
  let @119 = @0.!2 in
  let @141 = f32x4(@118) in
  let @120 = @141 - @119 in
  let @3 = q.p in
  let @4 = tri.v0 in
  let @121 = @3[0u] in
  let @122 = @4.!0 in
  let @142 = f32x4(@121) in
  let @123 = @142 - @122 in
  let @124 = @3[1u] in
  let @125 = @4.!1 in
  let @143 = f32x4(@124) in
  let @126 = @143 - @125 in
  let @127 = @3[2u] in
  let @128 = @4.!2 in
  let @144 = f32x4(@127) in
  let @129 = @144 - @128 in
  let @8 = @114 * @123 in
  let @11 = @117 * @126 in
  let @12 = @8 + @11 in
  let @15 = @120 * @129 in
  let d1 = @12 + @15 in
  let ac = tri.e2 in
  let @18 = ac.!0 in
  let @20 = @18 * @123 in
  let @21 = ac.!1 in
  let @23 = @21 * @126 in
  let @24 = @20 + @23 in
  let @25 = ac.!2 in
  let @27 = @25 * @129 in
  let d2 = @24 + @27 in
  let @145 = f32x4(0f) in
  let @29 = d1 <= @145 in
  let @146 = boolx4(false) in
  let @158 = !@29 in
  let @106 = reduce<any>(@29) in
  if (@106) {
    let @30 = d2 <= @145 in
    let @159 = !@30 in
    let @96 = @29 && @159 in
    let @97 = @29 && @30 in
    let @107 = reduce<any>(@97) in
    if (@107) {
      let @33 = @123 * @123 in
      let @36 = @126 * @126 in
      let @37 = @33 + @36 in
      let @40 = @129 * @129 in
      let @41 = @37 + @40 in
      !ret!skip = @41
    } else {
      !ret!skip = undef
    }
    @96!join = @96
    !ret!skip0 = (*!ret!skip)
  } else {
    @96!join = @146
    !ret!skip0 = undef
  }
  let @98 = (*@96!join) || @158 in
  let @130 = @123 - @114 in
  let @131 = @126 - @117 in
  let @132 = @129 - @120 in
  let @45 = @114 * @130 in
  let @48 = @117 * @131 in
  let @49 = @45 + @48 in
  let @52 = @120 * @132 in
  let d3 = @49 + @52 in
  let @56 = @18 * @130 in
  let @59 = @21 * @131 in
  let @60 = @56 + @59 in
  let @63 = @25 * @132 in
  let d4 = @60 + @63 in
  let @65 = @145 <= d3 in
  let @160 = !@65 in
  let @100 = @98 && @160 in
  let @101 = @98 && @65 in
  let @108 = reduce<any>(@101) in
  if (@108) {
    let @66 = d4 <= d3 in
    let @161 = !@66 in
    let @103 = @101 && @161 in
    let @104 = @101 && @66 in
    let @109 = reduce<any>(@104) in
    if (@109) {
      let @69 = @130 * @130 in
      let @72 = @131 * @131 in
      let @73 = @69 + @72 in
      let @76 = @132 * @132 in
      let @77 = @73 + @76 in
      let @110 = select(@104, @77, (*!ret!skip0)) in
      !ret!skip1 = @110
    } else {
