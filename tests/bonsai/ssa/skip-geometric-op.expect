  let @11 = @117 * @126 in
  let @12 = @8 + @11 in
  let @15 = @120 * @129 in
  let d1 = @12 + @15 in
  let ac = tri.e2 in
  let @18 = ac.!0 in
  let @20 = @18 * @123 in
  let @21 = ac.!1 in
  let @23 = @21 * @126 in
  let @24 = @20 + @23 in
  let @25 = ac.!2 in
  let @27 = @25 * @129 in
  let d2 = @24 + @27 in
  let @145 = f32x4(0f) in
  let @29 = d1 <= @145 in
  let @146 = boolx4(false) in
  let @158 = !@29 in
  let @106 = reduce<any>(@29) in
  if (@106) {
    let @30 = d2 <= @145 in
    let @159 = !@30 in
    let @96 = @29 && @159 in
    let @97 = @29 && @30 in
    let @107 = reduce<any>(@97) in
    if (@107) {
      let @33 = @123 * @123 in
      let @36 = @126 * @126 in
      let @37 = @33 + @36 in
      let @40 = @129 * @129 in
      let @41 = @37 + @40 in
      !ret!skip = @41
    } else {
      !ret!skip = undef
    }
    @96!join = @96
    !ret!skip0 = (*!ret!skip)
  } else {
    @96!join = @146
    !ret!skip0 = undef
  }
  let @98 = (*@96!join) || @158 in
  let @130 = @123 - @114 in
  let @131 = @126 - @117 in
  let @132 = @129 - @120 in
  let @45 = @114 * @130 in
  let @48 = @117 * @131 in
  let @49 = @45 + @48 in
  let @52 = @120 * @132 in
  let d3 = @49 + @52 in
  let @56 = @18 * @130 in
  let @59 = @21 * @131 in
  let @60 = @56 + @59 in
  let @63 = @25 * @132 in
  let d4 = @60 + @63 in
  let @65 = @145 <= d3 in
  let @160 = !@65 in
  let @100 = @98 && @160 in
  let @101 = @98 && @65 in
  let @108 = reduce<any>(@101) in
  if (@108) {
    let @66 = d4 <= d3 in
    let @161 = !@66 in
    let @103 = @101 && @161 in
    let @104 = @101 && @66 in
    let @109 = reduce<any>(@104) in
    if (@109) {
      let @69 = @130 * @130 in
      let @72 = @131 * @131 in
      let @73 = @69 + @72 in
      let @76 = @132 * @132 in
      let @77 = @73 + @76 in
      let @110 = select(@104, @77, (*!ret!skip0)) in
      !ret!skip1 = @110
    } else {
      !ret!skip1 = (*!ret!skip0)
    }
    @103!join = @103
    !ret!skip2 = (*!ret!skip1)
  } else {
    @103!join = @146
    !ret!skip2 = (*!ret!skip0)
  }
  let @105 = @100 || (*@103!join) in
  let @78 = d1 - d3 in
  let v = d1 / @78 in
  let @133 = @114 * v in
  let @134 = @117 * v in
  let @135 = @120 * v in
  let @136 = @123 - @133 in
  let @137 = @126 - @134 in
  let @138 = @129 - @135 in
  let @85 = @136 * @136 in
  let @88 = @137 * @137 in
  let @89 = @85 + @88 in
  let @92 = @138 * @138 in
  let @93 = @89 + @92 in
  let @111 = select(@105, @93, (*!ret!skip2)) in
  return @111
}


schedule {
    tris : tree[[struct Triangle{ v0 : f32x3; e1 : f32x3; e2 : f32x3; primID : u32 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    closest.sort(tris.Interior, |i : u32, q : struct Point{ p : f32x3 }, lo : f32x3x4, hi : f32x3x4| distmin(q, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
           .vectorize(tris.Interior.children)
           .vectorize(tris.Leaf.data)
           .loopify((i32)64)

}
