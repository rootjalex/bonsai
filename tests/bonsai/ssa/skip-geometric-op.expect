    !ret!skip2 = (*!ret!skip1)
  } else {
    @103!join = @146
    !ret!skip2 = (*!ret!skip0)
  }
  let @105 = @100 || (*@103!join) in
  let @78 = d1 - d3 in
  let v = d1 / @78 in
  let @133 = @114 * v in
  let @134 = @117 * v in
  let @135 = @120 * v in
  let @136 = @123 - @133 in
  let @137 = @126 - @134 in
  let @138 = @129 - @135 in
  let @85 = @136 * @136 in
  let @88 = @137 * @137 in
  let @89 = @85 + @88 in
  let @92 = @138 * @138 in
  let @93 = @89 + @92 in
  let @111 = select(@105, @93, (*!ret!skip2)) in
  return @111
}


schedule {
    tris : tree[[struct Triangle{ v0 : f32x3; e1 : f32x3; e2 : f32x3; primID : u32 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    closest.sort(tris.Interior, |i : u32, q : struct Point{ p : f32x3 }, lo : f32x3x4, hi : f32x3x4| distmin(q, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
           .vectorize(tris.Interior.children)
           .vectorize(tris.Leaf.data)
           .loopify((i32)64)

}
