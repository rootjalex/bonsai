  let @115 = @136 - @114 in
  let @116 = @1.!2 in
  let @117 = @136 - @116 in
  let @4 = q.p in
  let @5 = tri.v0 in
  let @118 = @4[0u] in
  let @119 = @5.!0 in
  let @139 = f32x4(@118) in
  let @120 = @139 - @119 in
  let @121 = @4[1u] in
  let @122 = @5.!1 in
  let @140 = f32x4(@121) in
  let @123 = @140 - @122 in
  let @124 = @4[2u] in
  let @125 = @5.!2 in
  let @141 = f32x4(@124) in
  let @126 = @141 - @125 in
  let @9 = @113 * @120 in
  let @12 = @115 * @123 in
  let @13 = @9 + @12 in
  let @16 = @117 * @126 in
  let d1 = @13 + @16 in
  let @142 = f32x4(0f) in
  let @18 = d1 <= @142 in
  let @143 = boolx4(false) in
  let @155 = !@18 in
  let @106 = reduce<any>(@18) in
  if (@106) {
    let @19 = ac.!0 in
    let @21 = @19 * @120 in
    let @22 = ac.!1 in
    let @24 = @22 * @123 in
    let @25 = @21 + @24 in
    let @26 = ac.!2 in
    let @28 = @26 * @126 in
    let d2 = @25 + @28 in
    let @30 = d2 <= @142 in
    let @156 = !@30 in
    let @96 = @18 && @156 in
    let @97 = @18 && @30 in
    let @107 = reduce<any>(@97) in
    if (@107) {
      let @33 = @120 * @120 in
      let @36 = @123 * @123 in
      let @37 = @33 + @36 in
      let @40 = @126 * @126 in
      let @41 = @37 + @40 in
      !ret!skip = @41
    } else {
      !ret!skip = undef
    }
    @96!join = @96
    !ret!skip0 = (*!ret!skip)
  } else {
    @96!join = @143
    !ret!skip0 = undef
  }
  let @98 = (*@96!join) || @155 in
  let @127 = @120 - @113 in
  let @128 = @123 - @115 in
  let @129 = @126 - @117 in
  let @45 = @113 * @127 in
  let @48 = @115 * @128 in
  let @49 = @45 + @48 in
  let @52 = @117 * @129 in
  let d3 = @49 + @52 in
  let @54 = @142 <= d3 in
  let @157 = !@54 in
  let @100 = @98 && @157 in
  let @101 = @98 && @54 in
  let @108 = reduce<any>(@101) in
  if (@108) {
    let @55 = ac.!0 in
    let @57 = @55 * @127 in
    let @58 = ac.!1 in
    let @60 = @58 * @128 in
    let @61 = @57 + @60 in
    let @62 = ac.!2 in
    let @64 = @62 * @129 in
    let d4 = @61 + @64 in
    let @66 = d4 <= d3 in
    let @158 = !@66 in
    let @103 = @101 && @158 in
    let @104 = @101 && @66 in
    let @109 = reduce<any>(@104) in
    if (@109) {
      let @69 = @127 * @127 in
      let @72 = @128 * @128 in
      let @73 = @69 + @72 in
      let @76 = @129 * @129 in
      let @77 = @73 + @76 in
      let @110 = select(@104, @77, (*!ret!skip0)) in
      !ret!skip1 = @110
    } else {
      !ret!skip1 = (*!ret!skip0)
    }
    @103!join = @103
    !ret!skip2 = (*!ret!skip1)
  } else {
    @103!join = @143
    !ret!skip2 = (*!ret!skip0)
  }
  let @105 = @100 || (*@103!join) in
  let @78 = d1 - d3 in
  let v = d1 / @78 in
  let @130 = @113 * v in
  let @131 = @115 * v in
  let @132 = @117 * v in
  let @133 = @120 - @130 in
  let @134 = @123 - @131 in
  let @135 = @126 - @132 in
  let @85 = @133 * @133 in
  let @88 = @134 * @134 in
  let @89 = @85 + @88 in
  let @92 = @135 * @135 in
  let @93 = @89 + @92 in
  let @111 = select(@105, @93, (*!ret!skip2)) in
  return @111
}


schedule {
    tris : tree[[struct Triangle{ v0 : f32x3; e1 : f32x3; e2 : f32x3; primID : u32 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    closest.sort(tris.Interior, |i : u32, q : struct Point{ p : f32x3 }, lo : f32x3x4, hi : f32x3x4| distmin(q, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
           .vectorize(tris.Interior.children)
           .vectorize(tris.Leaf.data)
           .loopify((i32)64)

}
