//! flags: -p ssa

// The program of vectorize-sorted-traversal.bonsai with the schedule the other
// way round: the gang is made first, and the traversal is put on a stack
// afterwards. That order says something different, and the golden shows what.
//
// Loopified and then vectorized, the traversal is a loop every lane walks at
// its own pace: each lane's current node is its own, the stack is one per
// lane (`u16x8[64]`), and every read of a node is a gather. Vectorized and
// then loopified, the recursion is made by the gang as a whole -- the lanes
// share one node and carry a mask of which of them reached it -- and it is
// that recursion loopify puts on a stack. What to look for:
//
//   * the traversal's node parameter stays a scalar `u16`, so its bounds and
//     children are one load each, broadcast where a lane's own ray meets
//     them; only the ray tests are per lane;
//   * the stack is two: `!stack` of `u16` nodes and one of `bool8` masks, the
//     mask being what varies between the recursive calls besides the node;
//   * the sort decides once for the gang, by a vote: the lanes' comparison of
//     their keys is counted (`popcount`) over the lanes that are on, and the
//     children are swapped when the majority says so -- rather than each lane
//     picking its own order, which a shared node cannot express.
//
// This is a packet traversal (Wald, Slusallek, Benthin & Wagner 2001) written
// as the composition of two schedule directives.
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/sphere;
import stdlib/triangle;

element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle);

func distmin(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmin(r, s);
        Tri(t) => return distmin(r, t);
    }
}

func distmax(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmax(r, s);
        Tri(t) => return distmax(r, t);
    }
}

func intersects(r : Ray, sh : Shape) -> bool {
    match sh {
        Sph(s) => return intersects(r, s);
        Tri(t) => return intersects(r, t);
    }
}

extern shapes : set[Shape];

func trace(r : Ray) =
    argmin(|sh : Shape| distmin(r, sh),
           filter(|sh : Shape| intersects(r, sh) && distmin(r, sh) > 0.001,
                  shapes));

func hit_z(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    s = *h;
    match s {
        Sph(sp) => return sp.center.z;
        Tri(t) => return t.p2.z;
    }
}

func [[export]] hit_z_all(rs : array[Ray, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = hit_z(rs[i]);
    }
    return;
}

schedule {
    tree[[Shape]] ShapeBVH(center : vec3f, radius : Float)
        with Sphere(center, radius) =
    | Interior(left : ShapeBVH, right : ShapeBVH, axis : u8)
    | Leaf(data : array[Shape]) with data = data;

    shapes : ShapeBVH;

    layout shapes {
        pCount : u32;
        prims : array[Shape, pCount];
        nCount : u32;
        group[nCount] index : u16 {
            center : vec3f;
            radius : Float;
            nPrims : u8;
            axis : u8;
            switch nPrims {
                0 => Interior { offset : u16; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u16; data = range(prims, pOffset, cast[[u16]](nPrims)); };
            };
        };
    };

    // The gang first, then the stack: see the comment at the top.
    hit_z_all.vectorize(i);
    trace.sort(shapes.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
}
