func finish(x : f32, n : i32) -> f32 {
  let @0 = x * 0.5f in
  let @1 = cast<f32>(n) in
  let @2 = @0 + @1 in
  return @2
}

func [[noinline]] halve(v : mut (f32*)) -> f32 {
  let @0 = (*v) in
  let @1 = @0 * 0.5f in
  v = @1
  let @2 = (*v) in
  return @2
}

func main() -> i32 {
  let @0 = step(3, 1f, 100f) in
  print(@0)
  let @1 = step(5, 1f, 4f) in
  print(@1)
  let @2 = step(5, 10f, 4f) in
  print(@2)
  let @3 = twice(3, 1f) in
  print(@3)
  let @4 = twice(5, 60f) in
  print(@4)
  let @5 = shared(3, 1f, 2) in
  print(@5)
  let @6 = shared(4, 20f, 3) in
  print(@6)
  let @7 = pick(3, 1f) in
  print(@7)
  let @8 = pick(4, 20f) in
  print(@8)
  return 0
}

func pick(i : i32, x : f32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  t : mut f32
  i!loop = i
  x!loop = x
  do {
    let @0 = (*i!loop) <= 0 in
    if (@0) {
      return (*x!loop)
    } else {
      t = 0f
      let y = (*x!loop) * 1.5f in
      put(t, y)
      let @2 = 50f < y in
      if (@2) {
        break
      } else {
        let @4 = (*i!loop) - 1 in
        i!loop = @4
        x!loop = y
        continue
      }
    }
  } while (true)
  let @3 = halve(t) in
  return @3
}

func [[noinline]] put(out : mut (f32*), v : f32) -> void {
  out = v
  return
}

func scale(a : f32, b : f32, k : i32) -> f32 {
  let @0 = a + b in
  let @1 = cast<f32>(k) in
  let @2 = @0 * @1 in
  return @2
}

func shared(i : i32, x : f32, k : i32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  i!loop = i
  x!loop = x
  while (!((*i!loop) <= 0)) {
    let y = (*x!loop) * 1.5f in
    let @5 = 50f < y in
    if (@5) {
      let @6 = (*x!loop) + y in
      let @7 = cast<f32>(k) in
      let @8 = @6 * @7 in
      return @8
    } else {
      let @9 = (*i!loop) - 1 in
      i!loop = @9
      x!loop = y
    }
  }
  let @1 = (*x!loop) * 0.5f in
  let @2 = cast<f32>((*i!loop)) in
  let @3 = @1 + @2 in
  return @3
}

func step(i : i32, x : f32, limit : f32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  i!loop = i
  x!loop = x
  while (!((*i!loop) <= 0)) {
    let y = (*x!loop) * 1.5f in
    let @5 = limit < y in
    if (@5) {
      return 0f
    } else {
      let @6 = limit * 0.5f in
      let @7 = @6 < y in
      if (@7) {
        x!loop = y
        let @1 = (*x!loop) * 0.5f in
        let @2 = cast<f32>((*i!loop)) in
        let @3 = @1 + @2 in
        return @3
      } else {
        let @11 = (*i!loop) - 1 in
        i!loop = @11
        x!loop = y
      }
    }
  }
  let @1 = (*x!loop) * 0.5f in
  let @2 = cast<f32>((*i!loop)) in
  let @3 = @1 + @2 in
  return @3
}

func twice(i : i32, x : f32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  i!loop = i
  x!loop = x
  while (!((*i!loop) <= 0)) {
    let y = (*x!loop) * 1.5f in
    let @5 = 100f < y in
    if (@5) {
      x!loop = y
      let @1 = (*x!loop) * 0.5f in
      let @2 = cast<f32>((*i!loop)) in
      let @3 = @1 + @2 in
      return @3
    } else {
      let @9 = (*i!loop) - 1 in
      i!loop = @9
      x!loop = y
    }
  }
  let @1 = (*x!loop) * 0.5f in
  let @2 = cast<f32>((*i!loop)) in
  let @3 = @1 + @2 in
  return @3
}


schedule {
    pick.loopify()
    shared.loopify()
    step.loopify()
    twice.loopify()

}
