func finish(x : f32, n : i32) -> f32 {
  let @0 = x * 0.5f in
  let @1 = cast<f32>(n) in
  let @2 = @0 + @1 in
  return @2
}

func main() -> i32 {
  let @0 = step(3, 1f, 100f) in
  print(@0)
  let @1 = step(5, 1f, 4f) in
  print(@1)
  let @2 = step(5, 10f, 4f) in
  print(@2)
  let @3 = twice(3, 1f) in
  print(@3)
  let @4 = twice(5, 60f) in
  print(@4)
  let @5 = shared(3, 1f, 2) in
  print(@5)
  let @6 = shared(4, 20f, 3) in
  print(@6)
  return 0
}

func scale(a : f32, b : f32, k : i32) -> f32 {
  let @0 = a + b in
  let @1 = cast<f32>(k) in
  let @2 = @0 * @1 in
  return @2
}

func shared(i : i32, x : f32, k : i32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  which : mut u32
  slot1 : mut i32
  slot2 : mut f32
  i!loop = i
  x!loop = x
  do {
    let @0 = (*i!loop) <= 0 in
    if (@0) {
      which = 0u
      slot1 = (*i!loop)
      slot2 = 0f
    } else {
      let y = (*x!loop) * 1.5f in
      let @5 = 50f < y in
      if (@5) {
        which = 1u
        slot1 = 0
        slot2 = y
      } else {
        let @9 = (*i!loop) - 1 in
        i!loop = @9
        x!loop = y
        continue
      }
    }
    break
  } while (true)
  let slot0 = (*x!loop) in
  let _effect0 = reconverge() in
  switch ((*which)) {
  case 0: { // if of shared
    x!loop = slot0
    i!loop = (*slot1)
    let @1 = (*x!loop) * 0.5f in
    let @2 = cast<f32>((*i!loop)) in
    let @3 = @1 + @2 in
    return @3
  } break;
  default: { // if of shared
    x!loop = slot0
    let y = (*slot2) in
    let @6 = (*x!loop) + y in
    let @7 = cast<f32>(k) in
    let @8 = @6 * @7 in
    return @8
  }
  }
}

func step(i : i32, x : f32, limit : f32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  which : mut u32
  slot0 : mut f32
  slot1 : mut i32
  i!loop = i
  x!loop = x
  do {
    let @0 = (*i!loop) <= 0 in
    if (@0) {
      which = 0u
      slot0 = (*x!loop)
      slot1 = (*i!loop)
    } else {
      let y = (*x!loop) * 1.5f in
      let @5 = limit < y in
      if (@5) {
        which = 1u
        slot0 = 0f
        slot1 = 0
      } else {
        let @6 = limit * 0.5f in
        let @7 = @6 < y in
        if (@7) {
          which = 0u
          slot0 = y
          slot1 = (*i!loop)
        } else {
          let @11 = (*i!loop) - 1 in
          i!loop = @11
          x!loop = y
          continue
        }
      }
    }
    break
  } while (true)
  let _effect1 = reconverge() in
  switch ((*which)) {
  case 0: { // if of step
    x!loop = (*slot0)
    i!loop = (*slot1)
    let @1 = (*x!loop) * 0.5f in
    let @2 = cast<f32>((*i!loop)) in
    let @3 = @1 + @2 in
    return @3
  } break;
  default: { // if of step
    return 0f
  }
  }
}

func twice(i : i32, x : f32) -> f32 {
  i!loop : mut i32
  x!loop : mut f32
  i!loop = i
  x!loop = x
  while (!((*i!loop) <= 0)) {
    let y = (*x!loop) * 1.5f in
    let @5 = 100f < y in
    if (@5) {
      x!loop = y
      let @1 = (*x!loop) * 0.5f in
      let @2 = cast<f32>((*i!loop)) in
      let @3 = @1 + @2 in
      return @3
    } else {
      let @9 = (*i!loop) - 1 in
      i!loop = @9
      x!loop = y
    }
  }
  let @1 = (*x!loop) * 0.5f in
  let @2 = cast<f32>((*i!loop)) in
  let @3 = @1 + @2 in
  return @3
}


schedule {
    shared.loopify()
    step.loopify()
    twice.loopify()

}
