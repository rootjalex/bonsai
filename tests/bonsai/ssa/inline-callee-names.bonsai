//! flags: -p ssa

// A gang callee's names do not leak into the function it is copied into.
// The slab test here is FCPW's (apps/rtq/metrics/fcpw.bonsai): every
// intermediate a `let` of a three-vector -- `t0`, `t1`, `tNear`, `tFar` --
// and its two tests one conjunction, `tMin <= tMax && proper`. Vectorized
// over the children, it is a pure straight-line variant, which the
// vectorizer copies into the traversal at each call (SSA/Vectorize.cpp
// inline_pure_variants): once as the children's test and once inside the
// `distmin` that is their bound.
//
// A `let` of a fresh value renames the value's instruction to the `let`'s
// name (`t1 = (b.high - r.o) * rinvD` is one multiply, named `t1`), and the
// block's table of names used to keep the old `@N` beside it. The copy
// carried that table into the caller (SSA/Rewrite.cpp inline_call), where
// `@N` named the caller's own instruction -- a component of the children's
// `lo` -- and the simplifier, which takes what an instruction's name
// denotes from that table (SSA/Simplify.cpp remember), handed the callee's
// `t1` out for it: the box the children's test received was a lane of the
// slab test's own output, and the program did not compile. The rename
// drops the old name (SSA/SSA.cpp Block::make_instruction), and a copy
// brings only the names it defines (inline_call).
//
// What to read for. In `_recloop_func0`'s children arm, the six
// `cast<f32x4>` of the row's `lower_*` and `upper_*` fields are built into
// the two `f32x3x4` and the `AABB$v4` the `distmin` call takes, and the
// inlined slab test computes from those same six casts: `@9 <= @26` is
// `proper`, the differences from the ray's origin and the products with
// its reciprocal direction follow, and the test's two conjuncts meet in
// the mask the call runs under. No `t1`, `t0`, `tNear` or `tMin` -- the
// callee's names -- appears anywhere in the function.
import stdlib/aabb;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

element FInterval {
    low, high : Float;
}

func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    proper = b.low.x <= b.high.x;
    rinvD = vec3f{1.0, 1.0, 1.0} / r.d;
    t0 = (b.low - r.o) * rinvD;
    t1 = (b.high - r.o) * rinvD;
    tNear = min(t0, t1);
    tFar = max(t0, t1);
    tMin = max(0.0, max(max(tNear.x, tNear.y), tNear.z));
    tMax = min(r.tmax, min(min(tFar.x, tFar.y), tFar.z));
    if tMin <= tMax && proper {
        return FInterval{tMin, tMax};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

func contains(r : Ray, b : AABB) -> bool = false;

element TriangleHit {
    t, u, v : Float;
}

// enoki's reciprocal: the machine's estimate, then `2r - (r m) r`.
func rcp_fcpw(m : Float) -> Float {
    r = rcp_approx(m);
    t0 = r + r;
    t1 = r * m;
    return t0 - t1 * r;
}

func intersectsp_ray_tri(r : Ray, tri : Triangle) -> option[TriangleHit] {
    epsilon : Float = 1.1920929e-7;
    v1 = tri.p1 - tri.p0;
    v2 = tri.p2 - tri.p0;
    p = cross(r.d, v2);
    det = dot(v1, p);
    if !(abs(det) > epsilon) {
        return {};
    }
    invDet = rcp_fcpw(det);
    s = r.o - tri.p0;
    v = dot(s, p) * invDet;
    if !(v >= 0.0 && v <= 1.0) {
        return {};
    }
    q = cross(s, v1);
    w = dot(r.d, q) * invDet;
    if !(w >= 0.0 && v + w <= 1.0) {
        return {};
    }
    d = dot(v2, q) * invDet;
    if !(d >= 0.0 && d <= r.tmax) {
        return {};
    }
    return TriangleHit{d, v, w};
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](intersectsp_ray_tri(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return -inf;
}

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                p0 : vec3f;
                p1 : vec3f;
                p2 : vec3f;
            };
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.vectorize(tris.Interior.children);
}
