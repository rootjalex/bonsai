type Float = f32
type Half = f16
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] sum_some(a : f32[8], sums : mut f32x3[2]) -> void {
  let _t24 = a[ramp(0, 1, 8)] in
  let @11 = f32x8(2f) in
  let @1 = @11 * _t24 in
  let @12 = f32x8(3f) in
  let @2 = @12 * _t24 in
  let @13 = f32x8(0f) in
  let @4 = @13 < _t24 in
  let @14 = boolx8(false) in
  let @15 = boolx8(true) in
  let @7 = select(@4, @14, @15) in
  let @9 = build<f32x3$v8>(_t24, @1, @2) in
  let @16 = @9.!0 in
  let @17 = f32x8(0f) in
  let @18 = select(@4, @16, @17) in
  let @19 = reduce<+>(@18) in
  let @20 = @9.!1 in
  let @21 = f32x8(0f) in
  let @22 = select(@4, @20, @21) in
  let @23 = reduce<+>(@22) in
  let @24 = @9.!2 in
  let @25 = f32x8(0f) in
  let @26 = select(@4, @24, @25) in
  let @27 = reduce<+>(@26) in
  let @28 = build<f32x3>(@19, @23, @27) in
  let @29 = reduce<any>(@4) in
  if (@29) {
    atomic sums[0] += @28
  }
  let @10 = build<f32x3$v8>(_t24, @1, @2) in
  let @30 = @10.!0 in
  let @31 = f32x8(0f) in
  let @32 = select(@4, @30, @31) in
  let @33 = reduce<+>(@32) in
  let @34 = @10.!1 in
  let @35 = f32x8(0f) in
  let @36 = select(@4, @34, @35) in
  let @37 = reduce<+>(@36) in
  let @38 = @10.!2 in
  let @39 = f32x8(0f) in
  let @40 = select(@4, @38, @39) in
  let @41 = reduce<+>(@40) in
  let @42 = build<f32x3>(@33, @37, @41) in
  let @43 = reduce<any>(@4) in
  if (@43) {
    sums[1] += @42
  }
  return
}


schedule host {
    sum_some.vectorize(i)

}
