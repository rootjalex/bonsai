type Float = f32
type Half = f16
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] sum_some(a : f32[8], sums : mut f32x3[2]) -> void {
  let _t22 = a[ramp(0, 1, 8)] in
  let @12 = f32x8(0f) in
  let @1 = @12 < _t22 in
  let @8 = reduce<any>(@1) in
  if (@8) {
    let @15 = f32x8(2f) in
    let @2 = @15 * _t22 in
    let @16 = f32x8(3f) in
    let @3 = @16 * _t22 in
    let @19 = select(@1, _t22, @12) in
    let @20 = reduce<+>(@19) in
    let @23 = select(@1, @2, @12) in
    let @24 = reduce<+>(@23) in
    let @27 = select(@1, @3, @12) in
    let @28 = reduce<+>(@27) in
    let @29 = build<f32x3>(@20, @24, @28) in
    if (@8) {
      atomic sums[0] += @29
    }
    if (@8) {
      sums[1] += @29
    }
  }
  return
}


schedule {
    sum_some.vectorize(i)

}
