type Entry_q = struct Entry_q{ n : i32; acc : i32; neg : i32; twice : i32; _slot : i32 }
type Entry_sums = struct Entry_sums{ n : i32; acc : i32; _slot : i32 }
type Queue_q = struct Queue_q{ count : u32; n : i32[]; acc : i32[]; neg : i32[]; twice : i32[]; _slot : i32[] }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_ran : mut u8[8]
  let @2 = fill_bytes(sums_ran, 0u, 8) in
  sums_result : mut i32[8]
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums__slot_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums__slot_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @4 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__slot_0) in
  sums_queue[0u] = @4
  let @6 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__slot_1) in
  sums_queue[1u] = @6
  parfor i in [0:8:1] {
    let @9 = tally(i, 0, 0, 0, (&sums_queue[0u]), (&sums_result[i]), i) in
    let @10 = out in
    let @11 = i in
    let @12 = @9.set in
    let @13 = @9.value in
    if (@12) {
      let @0 = @13 in
      out[i] = @0
      continue
    } else {
      sums_ran[i] = 1u
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @16 = (*sums!round) & 1u in
    let @18 = sums_queue[(*sums!round) & 1u].count in
    let @20 = @16 ^ 1u in
    sums_queue[@20].count = 0u
    parfor sums in [0u:@18:1u] {
      let @21 = (&sums_queue[@20]) in
      let @25 = sums_queue[@16].n in
      let @26 = @25[sums] in
      let @28 = sums_queue[@16].acc in
      let @29 = @28[sums] in
      let @30 = 0 - @29 in
      let @31 = @29 << 1 in
      let @33 = sums_queue[@16]._slot in
      let @34 = @33[sums] in
      tally(@26, @29, @30, @31, @21, (&sums_result[@34]), @34)
      continue
    }
    let @15 = (*sums!round) + 1u in
    sums!round = @15
  }
  parfor sums_rest in [0:8:1] {
    let @41 = sums_result[sums_rest] in
    let @43 = sums_ran[sums_rest] in
    switch (@43) {
    case 0: {
      continue
    } break;
    default: {
      let @37 = @41 in
      let @38 = out in
      let @39 = sums_rest in
      @38[@39] = @37
      continue
    }
    }
  }
  return
}

func run2(out : mut i32[8]) -> void {
  q!round : mut u32
  q_result : mut i32[8]
  q_n_0 : mut i32[8]
  q_acc_0 : mut i32[8]
  q_neg_0 : mut i32[8]
  q_twice_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_n_1 : mut i32[8]
  q_acc_1 : mut i32[8]
  q_neg_1 : mut i32[8]
  q_twice_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @3 = build<Queue_q>(0u, q_n_0, q_acc_0, q_neg_0, q_twice_0, q__slot_0) in
  q_queue[0u] = @3
  let @5 = build<Queue_q>(0u, q_n_1, q_acc_1, q_neg_1, q_twice_1, q__slot_1) in
  q_queue[1u] = @5
  parfor i in [0:8:1] {
    let @8 = build<Entry_q>(i, 0, 0, 0, i) in
    let @39 = atomic_add((&q_queue[0u].count), 1u) in
    let @41 = q_queue[0u].n in
    @41[@39] = i
    let @44 = q_queue[0u].acc in
    @44[@39] = 0
    let @47 = q_queue[0u].neg in
    @47[@39] = 0
    let @50 = q_queue[0u].twice in
    @50[@39] = 0
    let @53 = q_queue[0u]._slot in
    @53[@39] = i
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @11 = (*q!round) & 1u in
    let @13 = q_queue[(*q!round) & 1u].count in
    let @15 = @11 ^ 1u in
    q_queue[@15].count = 0u
    parfor q in [0u:@13:1u] {
      let @16 = (&q_queue[@15]) in
      let @20 = q_queue[@11].n in
      let @21 = @20[q] in
      let @23 = q_queue[@11].acc in
      let @24 = @23[q] in
      let @26 = q_queue[@11].neg in
      let @27 = @26[q] in
      let @29 = q_queue[@11].twice in
      let @30 = @29[q] in
      let @32 = q_queue[@11]._slot in
      let @33 = @32[q] in
      walk(@21, @24, @27, @30, @16, (&q_result[@33]), @33)
      continue
    }
    let @10 = (*q!round) + 1u in
    q!round = @10
  }
  parfor q_rest in [0:8:1] {
    let @36 = q_result[q_rest] in
    let @0 = @36 in
    let i = q_rest in
    out[i] = @0
    continue
  }
  return
}

func tally(n : i32, acc : i32, neg : i32, twice : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = acc + neg in
    let @2 = @1 + twice in
    _result_sums = @2
    let @8 = build<_option_sums>(@2, true) in
    return @8
  } else {
    let _t0 = acc + n in
    let @4 = n - 1 in
    let @5 = 0 - _t0 in
    let @6 = _t0 << 1 in
    let @9 = build<Entry_sums>(@4, _t0, _slot_sums) in
    let @10 = build<_option_sums>(undef, false) in
    let @13 = atomic_add((&(*_queue_sums).count), 1u) in
    let @15 = (*_queue_sums).n in
    @15[@13] = @4
    let @18 = (*_queue_sums).acc in
    @18[@13] = _t0
    let @21 = (*_queue_sums)._slot in
    @21[@13] = _slot_sums
    return @10
  }
}

func walk(n : i32, acc : i32, neg : i32, twice : i32, _queue_q : mut (Queue_q*), _result_q : mut (i32*), _slot_q : i32) -> void {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = acc + neg in
    let @2 = @1 + twice in
    _result_q = @2
    return
  } else {
    let _t3 = acc + n in
    let @4 = n - 1 in
    let @5 = 0 - _t3 in
    let @6 = _t3 << 1 in
    let @8 = build<Entry_q>(@4, _t3, @5, @6, _slot_q) in
    let @11 = atomic_add((&(*_queue_q).count), 1u) in
    let @13 = (*_queue_q).n in
    @13[@11] = @4
    let @16 = (*_queue_q).acc in
    @16[@11] = _t3
    let @19 = (*_queue_q).neg in
    @19[@11] = @5
    let @22 = (*_queue_q).twice in
    @22[@11] = @6
    let @25 = (*_queue_q)._slot in
    @25[@11] = _slot_q
    return
  }
}


schedule {
    q = run2.queue(root);
    sums = run.queue(root);
    run2.defer(walk, q)
    tally.defer(tally, sums)
    walk.defer(walk, q)

}
