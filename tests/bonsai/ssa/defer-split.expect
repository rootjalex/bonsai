  }
  let @9 = hits_queue[0u] in
  let @10 = @9.count in
  parfor hits!Small in [0u:@10:1u] {
    let @13 = hits_queue[0u].@0_tag in
    let @14 = @13[hits!Small] in
    let @15 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @17 = hits_queue[0u].@0_payload_x in
    let @18 = @17[hits!Small] in
    let @19 = build<[[packed]] u32x1>(@18) in
    let @20 = build<Kind>(@14, @15, @19) in
    let @23 = hits_queue[0u]._slot in
    let @24 = @23[hits!Small] in
    let @21 = step!after!Small(@20, k) in
    let @25 = (&hits_result[@24]) in
    @25 = @21
    continue
  }
  let @27 = hits_queue[1u] in
  let @28 = @27.count in
  parfor hits!Large in [0u:@28:1u] {
    let @31 = hits_queue[1u].@0_tag in
    let @32 = @31[hits!Large] in
    let @33 = build<[[packed]] u8x3>(0u, 0u, 0u) in
    let @35 = hits_queue[1u].@0_payload_x in
    let @36 = @35[hits!Large] in
    let @37 = build<[[packed]] u32x1>(@36) in
    let @38 = build<Kind>(@32, @33, @37) in
    let @41 = hits_queue[1u]._slot in
    let @42 = @41[hits!Large] in
    let @39 = step!after!Large(@38, k) in
    let @43 = (&hits_result[@42]) in
    @43 = @39
    continue
  }
  hits_queue[0u].count = 0u
  hits_queue[1u].count = 0u
  parfor hits_rest in [0:8:1] {
    let @49 = hits_result[hits_rest] in
    let @1 = @49 in
    let i = hits_rest in
    out[i] = @1
