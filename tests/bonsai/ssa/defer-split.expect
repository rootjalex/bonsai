  return
}

func [[noinline]] step(x : f32, k : f32, _queue_hits : mut Queue_hits[2], _result_hits : mut (f32*), _slot_hits : i32) -> void {
  let @0 = classify(x) in
  let @10 = build<Entry_hits>(@0, _slot_hits) in
  let @11 = @0.tag in
  switch (@11) {
  case 0: {
    let @17 = atomic_add((&_queue_hits[0u].count), 1u) in
    let @19 = @0.tag in
    let @24 = @0.payload in
    let @25 = @24[0u] in
    let @28 = _queue_hits[0u].@0_tag in
    @28[@17] = @19
    let @31 = _queue_hits[0u].@0_payload_x in
    @31[@17] = @25
    let @34 = _queue_hits[0u]._slot in
    @34[@17] = _slot_hits
    return
  } break;
  default: {
    let @37 = atomic_add((&_queue_hits[1u].count), 1u) in
    let @39 = @0.tag in
    let @44 = @0.payload in
    let @45 = @44[0u] in
    let @48 = _queue_hits[1u].@0_tag in
    @48[@37] = @39
