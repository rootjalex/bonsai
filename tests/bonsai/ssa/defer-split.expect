    @51[@37] = @45
    let @54 = _queue_hits[1u]._slot in
    @54[@37] = _slot_hits
    return
  }
  }
}

func [[noinline]] step!after(@0 : Kind, k : f32) -> f32 {
  let kind = @0 in
  let @1 = kind.tag in
  switch (@1) {
  case 0: { // Kind.Small of step
    let @2 = kind.payload in
    let @3 = @2[0u] in
    let v = reinterpret_cast<f32>(@3) in
    let @5 = v + k in
