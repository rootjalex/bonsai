func digits(ns : u64[8], bases : u16[8], out : mut u64[8]) -> void {
  v!loop : mut u64x8
  r!loop : mut u64x8
  !live : mut boolx8
  !exit.while_end_4 : mut boolx8
  !track.while_end_4.2 : mut u64x8
  let @0 = ns[ramp(0, 1, 8)] in
  let @1 = bases[ramp(0, 1, 8)] in
  let b = cast<u64x8>(@1) in
  let @59 = u64x8(0u) in
  let @36 = b == @59 in
  let @60 = u64x8(1u) in
  let @37 = select(@36, @60, b) in
  let @38 = @37 - @60 in
  let @39 = clz(@38) in
  let @62 = u64x8(64u) in
  let @40 = @62 - @39 in
  let @41 = @40 == @62 in
  let @42 = @60 << @40 in
  let @43 = select(@41, @59, @42) in
  let @44 = @43 - @37 in
  let @45 = cast<f64x8>(@37) in
  let @66 = u64x8(32u) in
  let @46 = @44 << @66 in
  let @47 = cast<f64x8>(@46) in
  let @48 = @47 / @45 in
  let @49 = cast<u64x8>(@48) in
  let @50 = @49 * @37 in
  let @51 = @46 - @50 in
  let @52 = @51 << @66 in
  let @53 = cast<f64x8>(@52) in
  let @54 = @53 / @45 in
  let @55 = cast<u64x8>(@54) in
  let @56 = @49 << @66 in
  let @57 = @56 + @55 in
  let @58 = @57 + @60 in
  let @15 = @58 + @59 in
  let @16 = b - @60 in
  let @17 = clz(@16) in
  let @18 = @62 - @17 in
  let @19 = min(@18, @60) in
  let @20 = max(@18, @60) in
  let @21 = @20 - @60 in
  let @82 = boolx8(true) in
  let @83 = boolx8(false) in
  v!loop = @0
  r!loop = @59
  !live = @82
  !exit.while_end_4 = @83
  !track.while_end_4.2 = undef
  while (reduce<any>((*!live))) {
    let @4 = (*v!loop) != @59 in
    let @84 = !@4 in
    let @28 = (*!live) && @84 in
    let @29 = (*!live) && @4 in
    let @22 = mulhi(@15, (*v!loop)) in
    let @23 = (*v!loop) - @22 in
    let @24 = @23 >> @19 in
    let @25 = @22 + @24 in
    let next = @25 >> @21 in
    let @8 = (*r!loop) * b in
    let @10 = next * b in
    let @11 = (*v!loop) - @10 in
    let @12 = @8 + @11 in
    let @30 = select(@29, @12, (*r!loop)) in
    let @31 = select(@28, (*r!loop), @30) in
    let @32 = select(@28, @83, (*!live)) in
    let @33 = select(@28, @82, (*!exit.while_end_4)) in
    let @34 = select(@28, (*r!loop), (*!track.while_end_4.2)) in
    v!loop = next
    r!loop = @31
    !live = @32
    !exit.while_end_4 = @33
    !track.while_end_4.2 = @34
  }
  out[ramp(0, 1, 8)] = (*!track.while_end_4.2)
  return
}

func wide(ns : u64[8], bases : u64[8], out : mut u64[8]) -> void {
  v!loop : mut u64x8
  r!loop : mut u64x8
  !live : mut boolx8
  !exit.while_end_4 : mut boolx8
  !track.while_end_4.2 : mut u64x8
  let @0 = ns[ramp(0, 1, 8)] in
  let b = bases[ramp(0, 1, 8)] in
  let @14 = div_multiplier(b) in
  let @35 = u64x8(1u) in
  let @15 = b - @35 in
  let @16 = clz(@15) in
  let @36 = u64x8(64u) in
  let @17 = @36 - @16 in
  let @18 = min(@17, @35) in
  let @19 = max(@17, @35) in
  let @20 = @19 - @35 in
  let @45 = u64x8(0u) in
  let @46 = boolx8(true) in
  let @47 = boolx8(false) in
  v!loop = @0
  r!loop = @45
  !live = @46
  !exit.while_end_4 = @47
  !track.while_end_4.2 = undef
  while (reduce<any>((*!live))) {
    let @3 = (*v!loop) != @45 in
    let @48 = !@3 in
    let @27 = (*!live) && @48 in
    let @28 = (*!live) && @3 in
    let @21 = mulhi(@14, (*v!loop)) in
    let @22 = (*v!loop) - @21 in
    let @23 = @22 >> @18 in
    let @24 = @21 + @23 in
    let next = @24 >> @20 in
    let @7 = (*r!loop) * b in
    let @9 = next * b in
    let @10 = (*v!loop) - @9 in
    let @11 = @7 + @10 in
    let @29 = select(@28, @11, (*r!loop)) in
    let @30 = select(@27, (*r!loop), @29) in
    let @31 = select(@27, @47, (*!live)) in
    let @32 = select(@27, @46, (*!exit.while_end_4)) in
    let @33 = select(@27, (*r!loop), (*!track.while_end_4.2)) in
    v!loop = next
    r!loop = @30
    !live = @31
    !exit.while_end_4 = @32
    !track.while_end_4.2 = @33
  }
  out[ramp(0, 1, 8)] = (*!track.while_end_4.2)
  return
}


schedule {
    digits.vectorize(i)
    wide.vectorize(i)

}
