func digits(ns : u64[8], bases : u16[8], out : mut u64[8]) -> void {
  v!loop : mut u64x8
  r!loop : mut u64x8
  !live : mut boolx8
  !exit.while_end_4 : mut boolx8
  !track.while_end_4.2 : mut u64x8
  let @0 = ns[ramp(0, 1, 8)] in
  let @1 = bases[ramp(0, 1, 8)] in
  let b = cast<u64x8>(@1) in
  let @61 = u64x8(0u) in
  let @38 = b == @61 in
  let @62 = u64x8(1u) in
  let @39 = select(@38, @62, b) in
  let @40 = @39 - @62 in
  let @41 = clz(@40) in
  let @64 = u64x8(64u) in
  let @42 = @64 - @41 in
  let @43 = @42 == @64 in
  let @44 = @62 << @42 in
  let @45 = select(@43, @61, @44) in
  let @46 = @45 - @39 in
  let @47 = cast<f64x8>(@39) in
  let @68 = u64x8(32u) in
  let @48 = @46 << @68 in
  let @49 = cast<f64x8>(@48) in
  let @50 = @49 / @47 in
  let @51 = cast<u64x8>(@50) in
  let @52 = @51 * @39 in
  let @53 = @48 - @52 in
  let @54 = @53 << @68 in
  let @55 = cast<f64x8>(@54) in
  let @56 = @55 / @47 in
  let @57 = cast<u64x8>(@56) in
  let @58 = @51 << @68 in
  let @59 = @58 + @57 in
  let @60 = @59 + @62 in
  let @15 = @60 + @61 in
  let @16 = b - @62 in
  let @17 = clz(@16) in
  let @18 = @64 - @17 in
  let @19 = min(@18, @62) in
  let @20 = max(@18, @62) in
  let @21 = @20 - @62 in
  let @84 = boolx8(true) in
  let @85 = boolx8(false) in
  v!loop = @0
  r!loop = @61
  !live = @84
  !exit.while_end_4 = @85
  !track.while_end_4.2 = undef
  while (reduce<any>((*!live))) {
    let @4 = (*v!loop) != @61 in
    let @86 = !@4 in
    let @28 = (*!live) && @86 in
    let @29 = (*!live) && @4 in
    let @22 = mulhi(@15, (*v!loop)) in
    let @23 = (*v!loop) - @22 in
    let @24 = @23 >> @19 in
    let @25 = @22 + @24 in
    let next = @25 >> @21 in
    let @8 = (*r!loop) * b in
    let @10 = next * b in
    let @11 = (*v!loop) - @10 in
    let @12 = @8 + @11 in
    let @30 = select(@29, next, (*v!loop)) in
    let @32 = select(@29, @12, (*r!loop)) in
    let @31 = select(@28, (*v!loop), @30) in
    let @33 = select(@28, (*r!loop), @32) in
    let @34 = select(@28, @85, (*!live)) in
    let @35 = select(@28, @84, (*!exit.while_end_4)) in
    let @36 = select(@28, (*r!loop), (*!track.while_end_4.2)) in
    v!loop = @31
    r!loop = @33
    !live = @34
    !exit.while_end_4 = @35
    !track.while_end_4.2 = @36
  }
  out[ramp(0, 1, 8)] = (*!track.while_end_4.2)
  return
}

func wide(ns : u64[8], bases : u64[8], out : mut u64[8]) -> void {
  v!loop : mut u64x8
  r!loop : mut u64x8
  !live : mut boolx8
  !exit.while_end_4 : mut boolx8
  !track.while_end_4.2 : mut u64x8
  let @0 = ns[ramp(0, 1, 8)] in
  let b = bases[ramp(0, 1, 8)] in
  let @14 = div_multiplier(b) in
  let @37 = u64x8(1u) in
  let @15 = b - @37 in
  let @16 = clz(@15) in
  let @38 = u64x8(64u) in
  let @17 = @38 - @16 in
  let @18 = min(@17, @37) in
  let @19 = max(@17, @37) in
  let @20 = @19 - @37 in
  let @47 = u64x8(0u) in
  let @48 = boolx8(true) in
  let @49 = boolx8(false) in
  v!loop = @0
  r!loop = @47
  !live = @48
  !exit.while_end_4 = @49
  !track.while_end_4.2 = undef
  while (reduce<any>((*!live))) {
    let @3 = (*v!loop) != @47 in
    let @50 = !@3 in
    let @27 = (*!live) && @50 in
    let @28 = (*!live) && @3 in
    let @21 = mulhi(@14, (*v!loop)) in
    let @22 = (*v!loop) - @21 in
    let @23 = @22 >> @18 in
    let @24 = @21 + @23 in
    let next = @24 >> @20 in
    let @7 = (*r!loop) * b in
    let @9 = next * b in
    let @10 = (*v!loop) - @9 in
    let @11 = @7 + @10 in
    let @29 = select(@28, next, (*v!loop)) in
    let @31 = select(@28, @11, (*r!loop)) in
    let @30 = select(@27, (*v!loop), @29) in
    let @32 = select(@27, (*r!loop), @31) in
    let @33 = select(@27, @49, (*!live)) in
    let @34 = select(@27, @48, (*!exit.while_end_4)) in
    let @35 = select(@27, (*r!loop), (*!track.while_end_4.2)) in
    v!loop = @30
    r!loop = @32
    !live = @33
    !exit.while_end_4 = @34
    !track.while_end_4.2 = @35
  }
  out[ramp(0, 1, 8)] = (*!track.while_end_4.2)
  return
}


schedule {
    digits.vectorize(i)
    wide.vectorize(i)

}
