//! flags: -p ssa

// A packet traversal over rows reached by address, and the element each
// lane's hit names read through its own pointer afterwards: bvh4_ptr_arena
// .bonsai's program, scene and tree (tests/bonsai/correctness/cpp) --
// Embree's NodeRef as an address with the kind in its low four bits, looked
// up in a `ptr group`, the children's boxes in the parent's row, Triangle4
// tiles -- with the rays traced in gangs of eight, the gang made before the
// traversal is sorted and put on its stack (bvh4_ptr_arena_packet.bonsai:
// one node for the gang, the children ordered by the majority's vote, one
// stack of nodes and masks). The traversal's own reads are the gang's, at
// one address; what differs between the lanes is the best hit each lane
// leaves the walk with -- a reference, the tile's address and the lane's
// slot in it -- and `hit_code` dereferences it for the wall's corner.
//
// What to read for. The hit's reference widens to one array handle per lane
// (Type::is_reference_per_lane, `const _tree_layout..[]x8`): the tile's
// address is `gep` on it, one pointer per lane (`(const ...*)x8`,
// PtrTo::make's per-lane place), the corner's field a `field.ptr` of that,
// and each load through it carries the block's mask as its second operand
// (SSA/Linearize.cpp, the predication of side effects; Deref::mask), so a
// lane that is off -- the tail gang's lanes past the batch, which hold no
// hit -- reads through no handle it never held. Before 2026-10-29 the
// address of an element of a per-lane handle was refused ("which is not an
// array", SSA/CodeGen_Stmt.cpp) and the loads through it ran unmasked.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

// What a ray hit, as one number the driver can compare: the wall's x plus a
// thousand times its lane's z, or -1 for nothing.
func hit_code(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    t = *h;
    return t.p0.x + 1000.0 * (t.p0.z + 1.0);
}

func [[export]] trace_all(n : u32, rs : array[Ray, n], out : mut array[f32, n]) {
    parfor i in 0u:n {
        out[i] = hit_code(rs[i]);
    }
    return;
}

func [[export]] occluded_all(n : u32, rs : array[Ray, n], out : mut array[i32, n]) {
    parfor i in 0u:n {
        out[i] = cast[[i32]](occluded(rs[i]));
    }
    return;
}

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    // The gang first, then the order and the stack: a packet traversal.
    trace_all.split(i, i_gang, i_lane, 8, true)
             .vectorize(i_lane);
    occluded_all.split(i, i_gang, i_lane, 8, true)
                .vectorize(i_lane);
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    occluded.loopify(64);
}
