//! flags: -p ssa

// The sort key's sign flip, and the fact that removes it. A nearest-first
// traversal orders a node's hit children by the distance at which the ray
// enters each box, as the float's bits read as an integer with the lane in
// the low bits (Embree's `distance_i`): integers order as the floats do
// only for non-negative floats, so a key that may be negative first has its
// magnitude bits flipped where the sign is set -- three instructions on the
// chain from the node test to the next node's address.
//
// Embree never flips, because its traversal clamps the ray's segment to
// [0, inf) at entry (TravRay: `tnear = max(tnear, 0)`) and a box's entry
// distance is `max(.., tnear)`. `trace` does the same -- with a clamp that
// leaves a non-negative number, `select(tnear > 0, tnear, 0)`, where
// Embree's std::max would hand a NaN or a negative zero through and rests
// on asserting the ray valid instead -- `trace_raw` does not, and the
// compiler tells them apart (SSA/ConstantIntervals.h: what every value
// lies between and whether it is a number with its sign clear, carried
// from the clamp in `trace` through the traversal function's parameter,
// the ray's field, the box test's `max`, the option the box test returns
// through its slot, `distmin`'s own slot and the keys array, to the sort).
// What to look for in the two traversal functions' sorted runs: `trace`'s
// keys go `reinterpret<i32x4>` straight to `& -4 | lane`; `trace_raw`'s
// have the `shr 31`, `& 0x7fffffff` and `xor` between.
//
// correctness/cpp/sort_key_nonnegative.bonsai runs both: the clamped query
// never reports a hit behind the ray's origin, the raw one does for a
// negative `tnear`, as Embree's `tnear < t` would.
import stdlib/aabb;
import stdlib/numerics;

element Ray {
    o : vec3f;
    tnear : Float;
    d : vec3f;
    tfar : Float;
}

element Triangle {
    p0 : vec3f;
    p1 : vec3f;
    p2 : vec3f;
}

element FInterval {
    low, high : Float;
}

func zero_fix(d : vec3f) -> vec3f {
    tiny : Float = 1e-18;
    return select(abs(d) < tiny, vec3f{tiny, tiny, tiny}, d);
}

// Embree's reciprocal: the machine's estimate and one Newton step.
func rcp_embree(a : vec3f) -> vec3f {
    r = rcp_approx(a);
    return r + r * (1.0 - a * r);
}

// The slab test with the interval clamped to the ray's segment, as Embree's
// intersectNode does it: `tNear = max(tNearX, tNearY, tNearZ, tnear)`.
func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    rdir = rcp_embree(zero_fix(r.d));
    org_rdir = r.o * rdir;
    dirIsNeg = rdir < 0.0;
    near = select(dirIsNeg, b.high, b.low);
    far = select(dirIsNeg, b.low, b.high);
    tNearV = near * rdir - org_rdir;
    tFarV = far * rdir - org_rdir;
    tNear = max(max(tNearV.x, tNearV.y), max(tNearV.z, r.tnear));
    tFar = min(min(tFarV.x, tFarV.y), min(tFarV.z, r.tfar));
    if tNear <= tFar {
        return FInterval{tNear, tFar};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

func contains(r : Ray, b : AABB) -> bool = false;

// Moeller-Trumbore, a hit at `t` counting where `tnear < t <= tfar`.
func hit_distance(r : Ray, tri : Triangle) -> option[Float] {
    e1 = tri.p1 - tri.p0;
    e2 = tri.p2 - tri.p0;
    p = cross(r.d, e2);
    den = dot(e1, p);
    if abs(den) < 1e-12 {
        return {};
    }
    inv = 1.0 / den;
    s = r.o - tri.p0;
    u = dot(s, p) * inv;
    if u < 0.0 || u > 1.0 {
        return {};
    }
    q = cross(s, e1);
    v = dot(r.d, q) * inv;
    if v < 0.0 || u + v > 1.0 {
        return {};
    }
    t = dot(e2, q) * inv;
    if !(r.tnear < t && t <= r.tfar) {
        return {};
    }
    return t;
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](hit_distance(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = hit_distance(r, tri);
    if hit {
        return *hit;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = hit_distance(r, tri);
    if hit {
        return *hit;
    }
    return -inf;
}

extern tris : set[Triangle];

// The ray as Embree's traversal reads it: its segment clamped to [0, inf).
// Not Embree's `max(tnear, 0)`, which is std::max and hands a NaN or a
// negative zero through, but a clamp that leaves a non-negative number, so
// that the analysis can say so of the key (apps/rtq/rtq.bonsai).
func clamped(r : Ray) -> Ray = Ray{r.o, select(r.tnear > 0.0, r.tnear, 0.0), r.d,
                                  select(r.tfar > 0.0, r.tfar, 0.0)};

func [[export]] trace(r0 : Ray) -> option[Triangle] {
    r = clamped(r0);
    return argmin(|t : Triangle| distmin(r, t),
                  filter(|t : Triangle| intersects(r, t), tris));
}

// The same query on the ray as given, whose keys may be negative.
func [[export]] trace_raw(r : Ray) -> option[Triangle] {
    return argmin(|t : Triangle| distmin(r, t),
                  filter(|t : Triangle| intersects(r, t), tris));
}

func [[export]] occluded(r0 : Ray) -> bool {
    r = clamped(r0);
    return any(|t : Triangle| intersects(r, t), tris);
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lo : vector[vec3f, 4];
            hi : vector[vec3f, 4];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    trace_raw.sort(tris.Interior,
                   |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
                   distmin(r, AABB{lo[i], hi[i]}))
             .loopify(64);
    occluded.loopify(64);
}
