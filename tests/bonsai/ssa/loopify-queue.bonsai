//! flags: -p ssa

// The IR `loopify(N)` produces: a branching recursion turned into a loop over
// an explicit stack (SSA/QueueRecursion.h).
//
// What to read for in the golden:
//
//   * `!stack` and `!stack0`, one per parameter the recursion changes. `out`
//     is the same at every node, so it stays a parameter rather than being
//     pushed sixteen times over.
//   * `node!top` and `depth!top`, the node being visited, and `!live`, the
//     loop's condition: `while ((*!live))`. The root is the first node, and
//     the stack starts empty.
//   * no call to `visit` anywhere in `visit`. The two calls here are a chain
//     rather than one `from`, so the first is written to the stack and the
//     count stepped, and the second -- the last thing the node does -- simply
//     becomes the next node. A node with nothing left to do takes the top of
//     the stack, or ends the loop when there is none.
func visit(node : i32, out : mut array[i32, 16], depth : i32) -> void {
  if (depth <= 0) {
    return;
  }
  out[node] = depth;
  visit(node * 2, out, depth - 1);
  visit(node * 2 + 1, out, depth - 1);
  return;
}

schedule {
  visit.loopify(64);
}
