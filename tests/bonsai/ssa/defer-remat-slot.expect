  let @7 = build<Queue_q2>(0u, q2_n_1, q2_acc_1, q2_x_1, q2__slot_1) in
  q2_queue[1u] = @7
  parfor i in [0:8:1] {
    let @46 = i < 4 in
    let @47 = i - 4 in
    let @0 = select(@46, i, @47) in
    let @10 = drift(i, 0, @0, (&q2_queue[0u]), (&q2_result[i]), i) in
    let @11 = out in
    let @12 = i in
    let @13 = @10.set in
    let @14 = @10.value in
    if (@13) {
      let @1 = @14 in
      out[i] = @1
