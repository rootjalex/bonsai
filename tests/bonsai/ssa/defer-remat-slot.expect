  q2_x_1 : mut i32[8]
  q2__slot_1 : mut i32[8]
  q2_queue : mut Queue_q2[2]
  let @5 = build<Queue_q2>(0u, q2_n_0, q2_acc_0, q2_x_0, q2__slot_0) in
