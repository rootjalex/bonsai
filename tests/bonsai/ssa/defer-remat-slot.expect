type Entry_q = struct Entry_q{ n : i32; acc : i32; _slot : i32 }
type Entry_q2 = struct Entry_q2{ n : i32; acc : i32; x : i32; _slot : i32 }
type Queue_q = struct Queue_q{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }
type Queue_q2 = struct Queue_q2{ count : u32; n : i32[]; acc : i32[]; x : i32[]; _slot : i32[] }

func drift(n : i32, acc : i32, x : i32, _queue_q2 : mut (Queue_q2*), _result_q2 : mut (i32*), _slot_q2 : i32) -> void {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = acc + x in
    _result_q2 = @1
    return
  } else {
    let @2 = n - 1 in
    let @3 = acc + x in
    let @4 = x + 1 in
    let @6 = build<Entry_q2>(@2, @3, @4, _slot_q2) in
    let @9 = atomic_add((&(*_queue_q2).count), 1u) in
    let @11 = (*_queue_q2).n in
    @11[@9] = @2
    let @14 = (*_queue_q2).acc in
    @14[@9] = @3
    let @17 = (*_queue_q2).x in
    @17[@9] = @4
    let @20 = (*_queue_q2)._slot in
    @20[@9] = _slot_q2
    return
  }
}

func run(out : mut i32[8]) -> void {
  q!round : mut u32
  q_result : mut i32[8]
  q_n_0 : mut i32[8]
  q_acc_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_n_1 : mut i32[8]
  q_acc_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @5 = build<Queue_q>(0u, q_n_0, q_acc_0, q__slot_0) in
  q_queue[0u] = @5
  let @7 = build<Queue_q>(0u, q_n_1, q_acc_1, q__slot_1) in
  q_queue[1u] = @7
  parfor i in [0:8:1] {
    let @33 = i < 4 in
    let @34 = i - 4 in
    let @0 = select(@33, i, @34) in
    let @1 = select(@33, 0, 1) in
    tally(i, 0, @0, @1, (&q_queue[0u]), (&q_result[i]), i)
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @11 = (*q!round) & 1u in
    let @13 = q_queue[(*q!round) & 1u].count in
    let @15 = @11 ^ 1u in
    q_queue[@15].count = 0u
    parfor q in [0u:@13:1u] {
      let @16 = (&q_queue[@15]) in
      let @20 = q_queue[@11].n in
      let @21 = @20[q] in
      let @23 = q_queue[@11].acc in
      let @24 = @23[q] in
      let @26 = q_queue[@11]._slot in
      let @27 = @26[q] in
      let @36 = @27 >> 31 in
      let @37 = reinterpret_cast<u32>(@36) in
      let @38 = @37 >> 30u in
      let @39 = reinterpret_cast<i32>(@38) in
      let @40 = @27 + @39 in
      let @41 = @40 >> 2 in
      let @42 = @41 * 4 in
      let @28 = @27 - @42 in
      tally(@21, @24, @28, @41, @16, (&q_result[@27]), @27)
      continue
    }
    let @10 = (*q!round) + 1u in
    q!round = @10
  }
  parfor q_rest in [0:8:1] {
    let @32 = q_result[q_rest] in
    let @2 = @32 in
    let i = q_rest in
    out[i] = @2
    continue
  }
  return
}

func run2(out : mut i32[8]) -> void {
  q2!round : mut u32
  q2_result : mut i32[8]
  q2_n_0 : mut i32[8]
  q2_acc_0 : mut i32[8]
  q2_x_0 : mut i32[8]
  q2__slot_0 : mut i32[8]
  q2_n_1 : mut i32[8]
  q2_acc_1 : mut i32[8]
  q2_x_1 : mut i32[8]
  q2__slot_1 : mut i32[8]
  q2_queue : mut Queue_q2[2]
  let @4 = build<Queue_q2>(0u, q2_n_0, q2_acc_0, q2_x_0, q2__slot_0) in
  q2_queue[0u] = @4
  let @6 = build<Queue_q2>(0u, q2_n_1, q2_acc_1, q2_x_1, q2__slot_1) in
  q2_queue[1u] = @6
  parfor i in [0:8:1] {
    let @33 = i < 4 in
    let @34 = i - 4 in
    let @0 = select(@33, i, @34) in
    drift(i, 0, @0, (&q2_queue[0u]), (&q2_result[i]), i)
    continue
  }
  q2!round = 0u
  while (!(q2_queue[(*q2!round) & 1u].count == 0u)) {
    let @10 = (*q2!round) & 1u in
    let @12 = q2_queue[(*q2!round) & 1u].count in
    let @14 = @10 ^ 1u in
    q2_queue[@14].count = 0u
    parfor q2 in [0u:@12:1u] {
      let @15 = (&q2_queue[@14]) in
      let @19 = q2_queue[@10].n in
      let @20 = @19[q2] in
      let @22 = q2_queue[@10].acc in
      let @23 = @22[q2] in
      let @25 = q2_queue[@10].x in
      let @26 = @25[q2] in
      let @28 = q2_queue[@10]._slot in
      let @29 = @28[q2] in
      drift(@20, @23, @26, @15, (&q2_result[@29]), @29)
      continue
    }
    let @9 = (*q2!round) + 1u in
    q2!round = @9
  }
  parfor q2_rest in [0:8:1] {
    let @32 = q2_result[q2_rest] in
    let @1 = @32 in
    let i = q2_rest in
    out[i] = @1
    continue
  }
  return
}

func tally(n : i32, acc : i32, x : i32, y : i32, _queue_q : mut (Queue_q*), _result_q : mut (i32*), _slot_q : i32) -> void {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = x * 10 in
    let @2 = acc + @1 in
    let @3 = @2 + y in
    _result_q = @3
    return
  } else {
    let @4 = n - 1 in
    let @5 = acc + n in
    let @7 = build<Entry_q>(@4, @5, _slot_q) in
    let @10 = atomic_add((&(*_queue_q).count), 1u) in
    let @12 = (*_queue_q).n in
    @12[@10] = @4
    let @15 = (*_queue_q).acc in
    @15[@10] = @5
    let @18 = (*_queue_q)._slot in
    @18[@10] = _slot_q
    return
  }
}


schedule {
    q = run.queue(root);
    q2 = run2.queue(root);
    drift.defer(drift, q2)
    tally.defer(tally, q)

}
