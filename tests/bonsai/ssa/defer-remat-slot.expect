type Entry_q = struct Entry_q{ n : i32; acc : i32; _slot : i32 }
type Entry_q2 = struct Entry_q2{ n : i32; acc : i32; x : i32; _slot : i32 }
type Queue_q = struct Queue_q{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }
type Queue_q2 = struct Queue_q2{ count : u32; n : i32[]; acc : i32[]; x : i32[]; _slot : i32[] }

func drift(n : i32, acc : i32, x : i32, _queue_q2 : mut (Queue_q2*), _result_q2 : mut (i32*), _slot_q2 : i32) -> _option_q2 {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = acc + x in
    _result_q2 = @1
    let @6 = build<_option_q2>(@1, true) in
    return @6
  } else {
    let @2 = n - 1 in
    let @3 = acc + x in
    let @4 = x + 1 in
    let @7 = build<Entry_q2>(@2, @3, @4, _slot_q2) in
    let @8 = build<_option_q2>(undef, false) in
    let @11 = atomic_add((&(*_queue_q2).count), 1u) in
    let @13 = (*_queue_q2).n in
    @13[@11] = @2
    let @16 = (*_queue_q2).acc in
    @16[@11] = @3
    let @19 = (*_queue_q2).x in
    @19[@11] = @4
    let @22 = (*_queue_q2)._slot in
    @22[@11] = _slot_q2
    return @8
  }
}

func run(out : mut i32[8]) -> void {
  q!round : mut u32
  q_ran : mut u8[8]
  let @4 = fill_bytes(q_ran, 0u, 8) in
  q_result : mut i32[8]
  q_n_0 : mut i32[8]
  q_acc_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_n_1 : mut i32[8]
  q_acc_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @6 = build<Queue_q>(0u, q_n_0, q_acc_0, q__slot_0) in
  q_queue[0u] = @6
  let @8 = build<Queue_q>(0u, q_n_1, q_acc_1, q__slot_1) in
  q_queue[1u] = @8
  parfor i in [0:8:1] {
    let @46 = i < 4 in
    let @47 = i - 4 in
    let @0 = select(@46, i, @47) in
    let @1 = select(@46, 0, 1) in
    let @11 = tally(i, 0, @0, @1, (&q_queue[0u]), (&q_result[i]), i) in
    let @12 = out in
    let @13 = i in
    let @14 = @11.set in
    let @15 = @11.value in
    if (@14) {
      let @2 = @15 in
      out[i] = @2
      continue
    } else {
      q_ran[i] = 1u
      continue
    }
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @18 = (*q!round) & 1u in
    let @20 = q_queue[(*q!round) & 1u].count in
    let @22 = @18 ^ 1u in
    q_queue[@22].count = 0u
    parfor q in [0u:@20:1u] {
      let @23 = (&q_queue[@22]) in
      let @27 = q_queue[@18].n in
      let @28 = @27[q] in
      let @30 = q_queue[@18].acc in
      let @31 = @30[q] in
      let @33 = q_queue[@18]._slot in
      let @34 = @33[q] in
      let @49 = @34 >> 31 in
      let @50 = reinterpret_cast<u32>(@49) in
      let @51 = @50 >> 30u in
      let @52 = reinterpret_cast<i32>(@51) in
      let @53 = @34 + @52 in
      let @54 = @53 >> 2 in
      let @55 = @54 * 4 in
      let @35 = @34 - @55 in
      tally(@28, @31, @35, @54, @23, (&q_result[@34]), @34)
      continue
    }
    let @17 = (*q!round) + 1u in
    q!round = @17
  }
  parfor q_rest in [0:8:1] {
    let @43 = q_result[q_rest] in
    let @45 = q_ran[q_rest] in
    switch (@45) {
    case 0: {
      continue
    } break;
    default: {
      let @39 = @43 in
      let @40 = out in
      let @41 = q_rest in
      @40[@41] = @39
      continue
    }
    }
  }
  return
}

