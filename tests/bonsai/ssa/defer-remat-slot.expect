    let @19 = q2_queue[(*q2!round) & 1u].count in
    let @21 = @17 ^ 1u in
    q2_queue[@21].count = 0u
    parfor q2 in [0u:@19:1u] {
      let @22 = (&q2_queue[@21]) in
      let @26 = q2_queue[@17].n in
      let @27 = @26[q2] in
      let @29 = q2_queue[@17].acc in
      let @30 = @29[q2] in
      let @32 = q2_queue[@17].x in
      let @33 = @32[q2] in
      let @35 = q2_queue[@17]._slot in
      let @36 = @35[q2] in
      drift(@27, @30, @33, @22, (&q2_result[@36]), @36)
      continue
    }
    let @16 = (*q2!round) + 1u in
    q2!round = @16
  }
  parfor q2_rest in [0:8:1] {
    let @43 = q2_result[q2_rest] in
    let @45 = q2_ran[q2_rest] in
    switch (@45) {
    case 0: {
      continue
    } break;
    default: {
      let @39 = @43 in
      let @40 = out in
      let @41 = q2_rest in
      @40[@41] = @39
      continue
    }
    }
  }
  return
}

func tally(n : i32, acc : i32, x : i32, y : i32, _queue_q : mut (Queue_q*), _result_q : mut (i32*), _slot_q : i32) -> _option_q {
  let @0 = n <= 0 in
  if (@0) {
    let @1 = x * 10 in
    let @2 = acc + @1 in
    let @3 = @2 + y in
    _result_q = @3
    let @7 = build<_option_q>(@3, true) in
    return @7
  } else {
    let @4 = n - 1 in
    let @5 = acc + n in
    let @8 = build<Entry_q>(@4, @5, _slot_q) in
    let @9 = build<_option_q>(undef, false) in
    let @12 = atomic_add((&(*_queue_q).count), 1u) in
    let @14 = (*_queue_q).n in
    @14[@12] = @4
    let @17 = (*_queue_q).acc in
    @17[@12] = @5
    let @20 = (*_queue_q)._slot in
    @20[@12] = _slot_q
    return @9
  }
}


schedule {
    q = run.queue(root);
    q2 = run2.queue(root);
    drift.defer(drift, q2)
    tally.defer(tally, q)

}
