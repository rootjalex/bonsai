  | Interior(children : (const BVH8&)[8], lo : f32x3x8, hi : f32x3x8) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    trace.sort(tris.Interior, |i : u32, r : struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }, lo : f32x3x8, hi : f32x3x8| entry(r, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
         .loopify((i32)64)

}
