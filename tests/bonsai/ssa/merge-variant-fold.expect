type Clamp = struct Clamp{ floor : f32 }
type Float = f32
type Half = f16
type Mode = struct Mode{ tag : u8; _pad : [[packed]] u8x3; payload : [[packed]] u32x1 }
type Sum = struct Sum{ scale : f32 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func pick(x : f32, flip : bool) -> f32 {
  m$payload1 : mut [[packed]] u32x1
  let @0 = reinterpret_cast<u32>(x) in
  let @1 = build<[[packed]] u32x1>(@0) in
  if (flip) {
    let @2 = -0f - x in
    let @3 = reinterpret_cast<u32>(@2) in
    let @4 = build<[[packed]] u32x1>(@3) in
    m$payload1 = @4
  } else {
    m$payload1 = @1
  }
  let m$tag0 = 0u in
  switch (m$tag0) {
  case 0: { // Mode.Sum of pick
    let @7 = (*m$payload1)[0u] in
    let scale = reinterpret_cast<f32>(@7) in
    let @9 = scale * 2f in
    return @9
  } break;
  default: { // Mode.Clamp of pick
    let @11 = (*m$payload1)[0u] in
    let floor = reinterpret_cast<f32>(@11) in
    let @13 = max(x, floor) in
    return @13
  }
  }
}

func [[export]] run(values : f32[8], flips : bool[8], out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    m$i6$payload1 : mut [[packed]] u32x1
    pick$r6 : mut f32
    let x$i6 = values[i] in
    let @1 = reinterpret_cast<u32>(x$i6) in
    let @2 = build<[[packed]] u32x1>(@1) in
    let flip$i6 = flips[i] in
    if (flip$i6) {
      let @4 = -0f - x$i6 in
      let @5 = reinterpret_cast<u32>(@4) in
      let @6 = build<[[packed]] u32x1>(@5) in
      m$i6$payload1 = @6
    } else {
      m$i6$payload1 = @2
    }
    let m$i6$tag0 = 0u in
    switch (m$i6$tag0) {
    case 0: { // Mode.Sum of pick
      let @9 = (*m$i6$payload1)[0u] in
      let scale$i6 = reinterpret_cast<f32>(@9) in
      let @11 = scale$i6 * 2f in
      pick$r6 = @11
    } break;
    default: { // Mode.Clamp of pick
      let @13 = (*m$i6$payload1)[0u] in
      let floor$i6 = reinterpret_cast<f32>(@13) in
      let @15 = max(x$i6, floor$i6) in
      pick$r6 = @15
    }
    }
    out[i] = (*pick$r6)
    continue
  }
  return
}


