; === ssa postschedule ===
; --- run ---
; storage q.acc : f32 as q_acc_slots
func run(values : f32[8], out : f32[8]): 
  q_acc_slots = alloca<f32[8]> scratch()
  q_x_0 = alloca<f32[8]> scratch()
  q_n_0 = alloca<i32[8]> scratch()
  q__slot_0 = alloca<i32[8]> scratch()
  q_x_1 = alloca<f32[8]> scratch()
  q_n_1 = alloca<i32[8]> scratch()
  q__slot_1 = alloca<i32[8]> scratch()
  q_queue = alloca<Queue_q[2]> scratch()
  @4 = make_struct<Queue_q>((u32)0, q_x_0, q_n_0, q__slot_0)
  @5 = gep(q_queue, (u32)0)
  store @5 @4
  @6 = make_struct<Queue_q>((u32)0, q_x_1, q_n_1, q__slot_1)
  @7 = gep(q_queue, (u32)1)
  store @7 @6
  parfor i (i32)0:(i32)8:(i32)1 !par_body_0(values, out, q_acc_slots, q_queue) q!drain(q_queue, q_acc_slots, out)

!par_body_0(i : i32, values : f32[8], out : f32[8], q_acc_slots : f32[8], q_queue : Queue_q[2]): // preds: run
  @3 = gep(q_acc_slots, i)
  store @3 (f32)0
  @0 = extract_idx(values, i)
  @8 = gep(q_queue, (u32)0)
  @9 = make_struct<Entry_q>(@0, (i32)3, i)
  defer @8 @9 yield

!par_cont_1(): // preds: q_rest!exit
  ret

!step_call_cont_2(acc : (f32*), out : f32[8], i : i32): // preds: q_rest!run
  @1 = load(acc)
  @2 = gep(out, i)
  store @2 @1
  yield

q!drain(q_queue : Queue_q[2], q_acc_slots : f32[8], out : f32[8]): // preds: run
  jmp q!round((u32)0, q_queue, q_acc_slots, out)

q!run(q : u32, @12 : u32, q_queue : Queue_q[2], q_acc_slots : f32[8], @17 : (Queue_q*)): // preds: q!batch
  @19 = gep(q_queue, @12)
  @20 = field.ptr(@19, (u32)1)
  @21 = load(@20)
  @22 = extract_idx(@21, q)
  @23 = field.ptr(@19, (u32)2)
  @24 = load(@23)
  @25 = extract_idx(@24, q)
  @26 = field.ptr(@19, (u32)3)
  @27 = load(@26)
  @28 = extract_idx(@27, q)
  @29 = gep(q_acc_slots, @28)
  call step(@22, @25, @29, @17, @28) q!ran()

q!ran(): // preds: q!run
  yield

q!exit(q_acc_slots : f32[8], out : f32[8]): // preds: q!round
  jmp q_rest(q_acc_slots, out)

q!round(q!round : u32, q_queue : Queue_q[2], q_acc_slots : f32[8], out : f32[8]): // preds: q!drain, q!next
  @12 = bwand(q!round, (u32)1)
  @13 = extract_idx(q_queue, @12)
  @14 = load_field(@13, (u32)0)
  @15 = eq(@14, (u32)0)
  dispatch @15 [q!batch(q!round, q_queue, @12, @14, q_acc_slots, out), q!exit(q_acc_slots, out)]

q!batch(q!round : u32, q_queue : Queue_q[2], @12 : u32, @14 : u32, q_acc_slots : f32[8], out : f32[8]): // preds: q!round
  @16 = xor(@12, (u32)1)
  @17 = gep(q_queue, @16)
  @18 = field.ptr(@17, (u32)0)
  store @18 (u32)0
  parfor q (u32)0:@14:(u32)1 q!run(@12, q_queue, q_acc_slots, @17) q!next(q!round, q_queue, q_acc_slots, out)

q!next(q!round : u32, q_queue : Queue_q[2], q_acc_slots : f32[8], out : f32[8]): // preds: q!batch
  @11 = add(q!round, (u32)1)
  jmp q!round(@11, q_queue, q_acc_slots, out)

q_rest(q_acc_slots : f32[8], out : f32[8]): // preds: q!exit
  parfor q_rest (i32)0:(i32)8:(i32)1 q_rest!run(q_acc_slots, out) q_rest!exit()

q_rest!run(q_rest : i32, q_acc_slots : f32[8], out : f32[8]): // preds: q_rest
  @30 = gep(q_acc_slots, q_rest)
  jmp !step_call_cont_2(@30, out, q_rest)

q_rest!exit(): // preds: q_rest
  jmp !par_cont_1()

; --- step ---
func step(x : f32, n : i32, acc : (f32*), _queue_q : (Queue_q*), _slot_q : i32): 
  acc.add acc x
  @0 = lt((i32)0, n)
  dispatch @0 [!merge_1(), !then_0(x, n, acc, _slot_q, _queue_q)]

!then_0(x : f32, n : i32, acc : (f32*), _slot_q : i32, _queue_q : (Queue_q*)): // preds: step
  @1 = mul(x, (f32)0.5)
  @2 = sub(n, (i32)1)
  @3 = make_struct<Entry_q>(@1, @2, _slot_q)
  defer _queue_q @3

!merge_1(): // preds: step
  ret

type Entry_q = struct Entry_q{ x : f32; n : i32; _slot : i32 }
type Float = f32
type Half = f16
type Queue_q = struct Queue_q{ count : u32; x : f32[]; n : i32[]; _slot : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[8], out : mut f32[8]) -> void {
  q!round : mut u32
  q_acc_slots : mut f32[8]
  q_x_0 : mut f32[8]
  q_n_0 : mut i32[8]
  q__slot_0 : mut i32[8]
  q_x_1 : mut f32[8]
  q_n_1 : mut i32[8]
  q__slot_1 : mut i32[8]
  q_queue : mut Queue_q[2]
  let @4 = build<Queue_q>(0u, q_x_0, q_n_0, q__slot_0) in
  q_queue[0u] = @4
  let @6 = build<Queue_q>(0u, q_x_1, q_n_1, q__slot_1) in
  q_queue[1u] = @6
  parfor i in [0:8:1] {
    q_acc_slots[i] = 0f
    let @0 = values[i] in
    let @9 = build<Entry_q>(@0, 3, i) in
    let @33 = atomic_add((&q_queue[0u].count), 1u) in
    let @35 = q_queue[0u].x in
    @35[@33] = @0
    let @38 = q_queue[0u].n in
    @38[@33] = 3
    let @41 = q_queue[0u]._slot in
    @41[@33] = i
    continue
  }
  q!round = 0u
  while (!(q_queue[(*q!round) & 1u].count == 0u)) {
    let @12 = (*q!round) & 1u in
    let @14 = q_queue[(*q!round) & 1u].count in
    let @16 = @12 ^ 1u in
    q_queue[@16].count = 0u
    parfor q in [0u:@14:1u] {
      let @17 = (&q_queue[@16]) in
      let @21 = q_queue[@12].x in
      let @22 = @21[q] in
      let @24 = q_queue[@12].n in
      let @25 = @24[q] in
      let @27 = q_queue[@12]._slot in
      let @28 = @27[q] in
      step(@22, @25, (&q_acc_slots[@28]), @17, @28)
      continue
    }
    let @11 = (*q!round) + 1u in
    q!round = @11
  }
  parfor q_rest in [0:8:1] {
    let acc = (&q_acc_slots[q_rest]) in
    let i = q_rest in
    let @1 = (*acc) in
    out[i] = @1
    continue
  }
  return
}

func step(x : f32, n : i32, acc : mut (f32*), _queue_q : mut (Queue_q*), _slot_q : i32) -> void {
  acc += x
  let @0 = 0 < n in
  if (@0) {
    let @1 = x * 0.5f in
    let @2 = n - 1 in
    let @3 = build<Entry_q>(@1, @2, _slot_q) in
    let @6 = atomic_add((&(*_queue_q).count), 1u) in
    let @8 = (*_queue_q).x in
    @8[@6] = @1
    let @11 = (*_queue_q).n in
    @11[@6] = @2
    let @14 = (*_queue_q)._slot in
    @14[@6] = _slot_q
    return
  } else {
    return
  }
}


schedule {
    q = run.queue(root);
    run.defer(step, q)
    step.defer(step, q)

}
