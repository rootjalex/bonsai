; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

%struct.Pair = type { float, float }

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @clamp_low(float noundef %x, float noundef %lo) local_unnamed_addr #0 {
clamp_low_entry:
  %0 = fcmp olt float %x, %lo
  %1 = fmul float %x, 2.000000e+00
  %y.0 = select i1 %0, float %lo, float %1
  ret float %y.0
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @running_total(float noundef %a, float noundef %b) local_unnamed_addr #0 {
running_total_entry:
  %0 = fadd float %a, %b
  %1 = fmul float %0, 2.000000e+00
  ret float %1
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: read)
define %struct.Pair @swap_fields(ptr nocapture noundef nonnull readonly %p) local_unnamed_addr #1 {
swap_fields_entry:
  %deref_temp.unpack = load float, ptr %p, align 4
  %deref_temp.elt3 = getelementptr inbounds i8, ptr %p, i64 4
  %deref_temp.unpack4 = load float, ptr %deref_temp.elt3, align 4
  %deref_temp2.fca.0.insert = insertvalue %struct.Pair poison, float %deref_temp.unpack4, 0
  %deref_temp2.fca.1.insert = insertvalue %struct.Pair %deref_temp2.fca.0.insert, float %deref_temp.unpack, 1
  ret %struct.Pair %deref_temp2.fca.1.insert
}

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
attributes #1 = { mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: read) }
