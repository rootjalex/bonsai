; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @clamp_low(float noundef %x, float noundef %lo) local_unnamed_addr #0 {
clamp_low:
  %0 = fcmp olt float %x, %lo
  %1 = fmul float %x, 2.000000e+00
  %y4.sroa.speculated = select i1 %0, float %lo, float %1
  ret float %y4.sroa.speculated
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @running_total(float noundef %a, float noundef %b) local_unnamed_addr #0 {
running_total:
  %0 = fadd float %a, %b
  %1 = fmul float %0, 2.000000e+00
  ret float %1
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite)
define void @swap_fields(ptr nofree noundef nonnull writeonly captures(none) initializes((0, 8)) %_ret0, ptr noundef nonnull readonly captures(none) %p) local_unnamed_addr #1 {
swap_fields:
  %0 = load <2 x float>, ptr %p, align 4
  %1 = shufflevector <2 x float> %0, <2 x float> poison, <2 x i32> <i32 1, i32 0>
  store <2 x float> %1, ptr %_ret0, align 4
  ret void
}

