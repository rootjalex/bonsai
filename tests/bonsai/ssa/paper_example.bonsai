//! flags: -p ssa

// The example from the paper, carried through SSA form and back.
//
// It exercises taking addresses: Lower/Mutability.cpp rewrites struct and
// `mut` parameters into pointers and wraps every matching call argument in a
// PtrTo, so a program with struct-taking functions cannot reach SSA form
// without a case for it. Those come back out as the `(&...)` below -- an
// address, not storage. Which of the two an address turns out to need is left
// to code generation, which can often answer it without copying anything; see
// Op::AddressOf in include/SSA/SSA.h.

// Trivial examples for now;
element Tree = f32;
element Ray {
    data : f32;
}

element Intersection {
    value : f32;
    miss : bool;
}

func isect(t : Tree, ray : Ray) -> Intersection {
    return Intersection{t * ray.data, t < ray.data};
}

func sky_color(ray : Ray) {
    return ray.data;
}

func brdf_eval(is : Intersection, ray : Ray) {
    return is.value;
}

// The bounced ray, which is what `color` recurses on -- so a Ray, not the
// scalar it is built from. This used to return `is.value - ray.data` and be
// passed straight to a Ray parameter, which nothing caught: a call in
// statement position was checked for argument count and mutability but not
// for argument types, so it only failed much later, in code generation, and
// as a mismatch between pointers rather than between values.
func bounce(is : Intersection, ray : Ray) -> Ray {
    return Ray{is.value - ray.data};
}

func color(t : Tree, ray : Ray, output : mut array[f32], i : i32) -> void {
    is = isect(t, ray);

    if is.miss {
        output[i] += sky_color(ray);
        return;
    }

    output[i] += brdf_eval(is, ray);

    color(t, bounce(is, ray), output, i);
}

func trace(t : Tree, n : i32, output : mut array[f32, n], crays : array[Ray, n]) {
  parfor i in 0:n {
    ray = crays[i];
    color(t, ray, output, i);
  }
  return;
}
