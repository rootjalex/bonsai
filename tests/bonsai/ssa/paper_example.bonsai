//! flags: -p ssa

// The example from the paper, carried through SSA form and back.
//
// It exercises taking addresses: Lower/Mutability.cpp rewrites struct and
// `mut` parameters into pointers and wraps every matching call argument in a
// PtrTo, so a program with struct-taking functions cannot reach SSA form
// without a case for it. Values that have no address of their own get a stack
// slot to point at, which is what the allocas below are.

// Trivial examples for now;
element Tree = f32;
element Ray {
    data : f32;
}

element Intersection {
    value : f32;
    miss : bool;
}

func isect(t : Tree, ray : Ray) -> Intersection {
    return Intersection{t * ray.data, t < ray.data};
}

func sky_color(ray : Ray) {
    return ray.data;
}

func brdf_eval(is : Intersection, ray : Ray) {
    return is.value;
}

func bounce(is : Intersection, ray : Ray) {
    return is.value - ray.data;
}

func color(t : Tree, ray : Ray, output : mut array[f32], i : i32) -> void {
    is = isect(t, ray);

    if is.miss {
        output[i] += sky_color(ray);
        return;
    }

    output[i] += brdf_eval(is, ray);

    color(t, bounce(is, ray), output, i);
}

func trace(t : Tree, n : i32, output : mut array[f32, n], crays : array[Ray, n]) {
  parfor i in 0:n {
    ray = crays[i];
    color(t, ray, output, i);
  }
  return;
}
