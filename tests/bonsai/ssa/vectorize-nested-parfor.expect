func uniform(n : i32, a : i32[n], out : mut i32[n]) -> void {
  parfor io in [0:n:8] {
    @8 : mut i32
    i : mut i32x8
    s : mut i32x8
    let @5 = n in
    let @33 = i32x8(@5) in
    let @7 = ramp(io, 1, 8) < @33 in
    let @12 = reduce<any>(@7) in
    if (@12) {
      let @36 = i32x8(0) in
      @8 = 0
      i = ramp(io, 1, 8)
      s = @36
      while ((*@8) < 3) {
        let @14 = div_multiplier(n) in
        let @15 = n < 0 in
        let @16 = 0 - n in
        let @17 = select(@15, @16, n) in
        let @18 = @17 - 1 in
        let @19 = clz(@18) in
        let @20 = 32 - @19 in
        let @21 = max(@20, 1) in
        let @22 = @21 - 1 in
        let @37 = i32x8((*@8)) in
        let @0 = (*i) + @37 in
        let @38 = i32x8(@14) in
        let @23 = mulhi(@38, @0) in
        let @24 = @23 + @0 in
        let @39 = i32x8(@22) in
        let @25 = @24 >> @39 in
        let @26 = @25 < @36 in
        let @41 = i32x8(1) in
        let @27 = @25 + @41 in
        let @28 = select(@26, @27, @25) in
        let @29 = @36 - @28 in
        let @43 = boolx8(@15) in
        let @30 = select(@43, @29, @28) in
        let @44 = i32x8(n) in
        let @31 = @30 * @44 in
        let @1 = @0 - @31 in
        let @2 = masked_extract(a[@1], @7) in
        let @47 = (*s) + @2 in
        let @10 = (*@8) + 1 in
        @8 = @10
        s = @47
      }
      masked_store(out[(*i)], (*s), @7)
    }
    continue
  }
  return
}

func varying(n : i32, a : i32[n], out : mut i32[n]) -> void {
  parfor io in [0:n:8] {
    @18!loop : mut i32
    !live : mut boolx8
    !exit.par_cont_3 : mut boolx8
    s : mut i32x8
    @18!loop!skip : mut i32
    let @7 = n in
    let @50 = i32x8(@7) in
    let @9 = ramp(io, 1, 8) < @50 in
    let @51 = boolx8(false) in
    let @52 = boolx8(true) in
    let @26 = reduce<any>(@9) in
    if (@26) {
      let @53 = i32x8(0) in
      let @54 = i32x8(31) in
      let @10 = ramp(io, 1, 8) >> @54 in
      let @11 = reinterpret_cast<u32x8>(@10) in
      let @55 = u32x8(30u) in
      let @12 = @11 >> @55 in
      let @13 = reinterpret_cast<i32x8>(@12) in
      let @14 = ramp(io, 1, 8) + @13 in
      let @56 = i32x8(2) in
      let @15 = @14 >> @56 in
      let @57 = i32x8(4) in
      let @16 = @15 * @57 in
      let @0 = ramp(io, 1, 8) - @16 in
      let @58 = i32x8(1) in
      let @1 = @0 + @58 in
      @18!loop = 0
      !live = @9
      !exit.par_cont_3 = @51
      s = @53
      while (reduce<any>((*!live))) {
        let @59 = i32x8((*@18!loop)) in
        let @19 = @59 < @1 in
        let @75 = !@19 in
        let @24 = (*!live) && @75 in
        let @25 = (*!live) && @19 in
        let @27 = reduce<any>(@25) in
        if (@27) {
          let @31 = div_multiplier(n) in
          let @32 = n < 0 in
          let @33 = 0 - n in
          let @34 = select(@32, @33, n) in
          let @35 = @34 - 1 in
          let @36 = clz(@35) in
          let @37 = 32 - @36 in
          let @38 = max(@37, 1) in
          let @39 = @38 - 1 in
          let @76 = (*@18!loop) + io in
          let @63 = i32x8(@31) in
          let @40 = mulhi(@63, ramp(@76, 1, 8)) in
          let @41 = @40 + ramp(@76, 1, 8) in
          let @64 = i32x8(@39) in
          let @42 = @41 >> @64 in
          let @43 = @42 < @53 in
          let @44 = @42 + @58 in
          let @45 = select(@43, @44, @42) in
          let @46 = @53 - @45 in
          let @68 = boolx8(@32) in
          let @47 = select(@68, @46, @45) in
          let @69 = i32x8(n) in
          let @48 = @47 * @69 in
          let @3 = ramp(@76, 1, 8) - @48 in
          let @4 = masked_extract(a[@3], @25) in
          let @78 = (*s) + @4 in
          let @20 = (*@18!loop) + 1 in
          @18!loop!skip = @20
          s = @78
        } else {
          @18!loop!skip = undef
        }
        let @28 = select(@24, @51, (*!live)) in
        let @29 = select(@24, @52, (*!exit.par_cont_3)) in
        @18!loop = (*@18!loop!skip)
        !live = @28
        !exit.par_cont_3 = @29
      }
      masked_store(out[ramp(io, 1, 8)], (*s), @9)
    }
    continue
  }
  return
}


schedule {
    uniform.split(i, io, ii, (i32)8, 1)
           .vectorize(ii)
    varying.split(i, io, ii, (i32)8, 1)
           .vectorize(ii)

}
