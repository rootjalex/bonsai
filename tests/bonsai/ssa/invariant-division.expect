func digits(n : u64, b : u64) -> u64 {
  let @16 = div_multiplier(b) in
  let @17 = b - 1u in
  let @18 = clz(@17) in
  let @19 = 64u - @18 in
  let @20 = min(@19, 1u) in
  let @21 = max(@19, 1u) in
  let @22 = @21 - 1u in
  v : mut u64
  v = n
  r : mut u64
  r = 0u
  let @27 = mulhi(@16, 18446744073709551615u) in
  let @28 = 18446744073709551615u - @27 in
  let @29 = @28 >> @20 in
  let @30 = @27 + @29 in
  let @0 = @30 >> @22 in
  let limit = @0 - b in
  while (((*v) != 0u) && ((*r) < limit)) {
    let @7 = (*v) in
    let @23 = mulhi(@16, @7) in
    let @24 = @7 - @23 in
    let @25 = @24 >> @20 in
    let @26 = @23 + @25 in
    let next = @26 >> @22 in
    let @9 = (*r) in
    let @10 = @9 * b in
    let @11 = (*v) in
    let @12 = next * b in
    let @13 = @11 - @12 in
    let @14 = @10 + @13 in
    r = @14
    v = next
  }
  let @15 = (*r) in
  return @15
}

