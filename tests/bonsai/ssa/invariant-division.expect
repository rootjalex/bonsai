func digits(n : u64, b : u64) -> u64 {
  let @16 = div_multiplier(b) in
  let @17 = b - 1u in
  let @18 = clz(@17) in
  let @19 = 64u - @18 in
  let @20 = min(@19, 1u) in
  let @21 = max(@19, 1u) in
  let @22 = @21 - 1u in
  v : mut u64
  v = n
  r : mut u64
  r = 0u
  let @27 = mulhi(@16, 18446744073709551615u) in
  let @28 = 18446744073709551615u - @27 in
  let @29 = @28 >> @20 in
  let @30 = @27 + @29 in
  let @0 = @30 >> @22 in
  let limit = @0 - b in
  while (((*v) != 0u) && ((*r) < limit)) {
    let @7 = (*v) in
    let @23 = mulhi(@16, @7) in
    let @24 = @7 - @23 in
    let @25 = @24 >> @20 in
    let @26 = @23 + @25 in
    let next = @26 >> @22 in
    let @9 = (*r) in
    let @10 = @9 * b in
    let @11 = (*v) in
    let @12 = next * b in
    let @13 = @11 - @12 in
    let @14 = @10 + @13 in
    r = @14
    v = next
  }
  let @15 = (*r) in
  return @15
}

func digits$gang8_v0_v1(n : u64x8, b : u64x8) -> u64x8 {
  v!loop : mut u64x8
  r!loop : mut u64x8
  !live : mut boolx8
  !exit.while_end_2 : mut boolx8
  !track.while_end_2.0 : mut u64x8
  let @16 = div_multiplier(b) in
  let @42 = u64x8(1u) in
  let @17 = b - @42 in
  let @18 = clz(@17) in
  let @43 = u64x8(64u) in
  let @19 = @43 - @18 in
  let @44 = u64x8(1u) in
  let @20 = min(@19, @44) in
  let @45 = u64x8(1u) in
  let @21 = max(@19, @45) in
  let @46 = u64x8(1u) in
  let @22 = @21 - @46 in
  let @47 = u64x8(18446744073709551615u) in
  let @27 = mulhi(@16, @47) in
  let @48 = u64x8(18446744073709551615u) in
  let @28 = @48 - @27 in
  let @29 = @28 >> @20 in
  let @30 = @27 + @29 in
  let @0 = @30 >> @22 in
  let limit = @0 - b in
  let @54 = u64x8(0u) in
  let @55 = boolx8(true) in
  let @56 = boolx8(false) in
  v!loop = n
  r!loop = @54
  !live = @55
  !exit.while_end_2 = @56
  !track.while_end_2.0 = undef
  while (reduce<any>((*!live))) {
    let @49 = u64x8(0u) in
    let @3 = (*v!loop) != @49 in
    let @5 = (*r!loop) < limit in
    let @6 = @3 && @5 in
    let @50 = boolx8(false) in
    let @51 = boolx8(true) in
    let @32 = select(@6, @50, @51) in
    let @33 = (*!live) && @32 in
    let @34 = (*!live) && @6 in
    let @23 = mulhi(@16, (*v!loop)) in
    let @24 = (*v!loop) - @23 in
    let @25 = @24 >> @20 in
    let @26 = @23 + @25 in
    let next = @26 >> @22 in
    let @10 = (*r!loop) * b in
    let @12 = next * b in
    let @13 = (*v!loop) - @12 in
    let @14 = @10 + @13 in
    let @35 = select(@34, next, (*v!loop)) in
    let @37 = select(@34, @14, (*r!loop)) in
    let @36 = select(@33, (*v!loop), @35) in
    let @38 = select(@33, (*r!loop), @37) in
    let @52 = boolx8(false) in
    let @39 = select(@33, @52, (*!live)) in
    let @53 = boolx8(true) in
    let @40 = select(@33, @53, (*!exit.while_end_2)) in
    let @41 = select(@33, (*r!loop), (*!track.while_end_2.0)) in
    v!loop = @36
    r!loop = @38
    !live = @39
    !exit.while_end_2 = @40
    !track.while_end_2.0 = @41
  }
  return (*!track.while_end_2.0)
}

func permuted_digits(n : u64, b : u64) -> u64 {
  let @18 = div_multiplier(b) in
  let @19 = b - 1u in
  let @20 = clz(@19) in
  let @21 = 64u - @20 in
  let @22 = min(@21, 1u) in
  let @23 = max(@21, 1u) in
  let @24 = @23 - 1u in
  v : mut u64
  v = n
  r : mut u64
  r = 0u
  let @29 = mulhi(@18, 18446744073709551615u) in
  let @30 = 18446744073709551615u - @29 in
  let @31 = @30 >> @22 in
  let @32 = @29 + @31 in
  let @0 = @32 >> @24 in
  let limit = @0 - b in
  while (((*v) != 0u) && ((*r) < limit)) {
    let @7 = (*v) in
    let @25 = mulhi(@18, @7) in
    let @26 = @7 - @25 in
    let @27 = @26 >> @22 in
    let @28 = @25 + @27 in
    let next = @28 >> @24 in
    let @9 = (*r) in
    let @10 = @9 * b in
    let @11 = (*v) in
    let @12 = next * b in
    let @13 = @11 - @12 in
    let @14 = (*r) in
    let @15 = scramble(@13, @14) in
    let @16 = @10 + @15 in
    r = @16
    v = next
  }
  let @17 = (*r) in
  return @17
}

func quarters(n : u64) -> u64 {
  total : mut u64
  total = 0u
  v : mut u64
  v = n
  while ((*v) != 0u) {
    let @2 = (*total) in
    let @3 = (*v) in
    let @4 = @3 & 3u in
    let @5 = @2 + @4 in
    total = @5
    let @6 = (*v) in
    let @7 = @6 >> 2u in
    v = @7
  }
  let @8 = (*total) in
  return @8
}

func [[export]] run(out : mut u64[8], bases : u64[8]) -> void {
  let @0 = cast<u64x8>(ramp(0, 1, 8)) in
  let @6 = u64x8(1000003u) in
  let @1 = @0 * @6 in
  let @2 = bases[ramp(0, 1, 8)] in
  let @3 = digits$gang8_v0_v1(@1, @2) in
  let i = ramp(0, 1, 8) in
  out[ramp(0, 1, 8)] = @3
  return
}

func [[noinline]] scramble(digit : u64, salt : u64) -> u64 {
  let @0 = digit * 3u in
  let @1 = @0 + salt in
  let @3 = mulhi(@1, 2635249153387078803u) in
  let @4 = @1 - @3 in
  let @5 = @4 >> 1u in
  let @6 = @5 + @3 in
  let @7 = @6 >> 2u in
  let @8 = @7 * 7u in
  let @2 = @1 - @8 in
  return @2
}


schedule host {
    run.vectorize(i)

}
