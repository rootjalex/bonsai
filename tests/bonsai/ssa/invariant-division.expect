func quarters(n : u64) -> u64 {
  total : mut u64
  total = 0u
  v : mut u64
  v = n
  while ((*v) != 0u) {
    let @2 = (*total) in
    let @3 = (*v) in
    let @4 = @3 & 3u in
    let @5 = @2 + @4 in
    total = @5
    let @6 = (*v) in
    let @7 = @6 / 4u in
    v = @7
  }
  let @8 = (*total) in
  return @8
}

