      let @26 = @23 + @25 in
      let next = @26 >> @22 in
      let @10 = (*r!loop) * b in
      let @12 = next * b in
      let @13 = (*v!loop) - @12 in
      let @14 = @10 + @13 in
      next!skip = next
      @14!skip = @14
    } else {
