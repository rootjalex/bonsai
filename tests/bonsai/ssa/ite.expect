func eager(y : i32, a : i32, b : i32) -> i32 {
  let @0 = y != 0 in
  let @1 = select(@0, a, b) in
  return @1
}

func lazy(y : i32) -> i32 {
  let @0 = y != 0 in
  if (@0) {
    let !ite_0 = 100 / y in
  } else {
    let !ite_0 = -1 in
  }
  let !ite_0 = !ite_0 in
  return !ite_0
}

func run(out : mut i32[2], y : i32, a : i32, b : i32) -> void {
  let _t0 = y != 0 in
  if (_t0) {
    let !ite_0 = 100 / y in
  } else {
    let !ite_0 = -1 in
  }
  let !ite_0 = !ite_0 in
  out[0] = !ite_0
