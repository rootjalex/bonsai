type Entry_sums = struct Entry_sums{ n : i32; acc : i32; i : i32 }
type Queue_sums = struct Queue_sums{ count : u32; data : struct Entry_sums{ n : i32; acc : i32; i : i32 }[] }

func [[noinline]] fill(n : i32, acc : i32, out : mut i32[8], i : i32, _queue_sums : mut (Queue_sums*)) -> bool {
  let @0 = n <= 0 in
  if (@0) {
    out[i] = acc
    return false
  } else {
    let @2 = n - 1 in
    let @3 = acc + n in
    let @4 = build<Entry_sums>(@2, @3, i) in
    let @7 = (*_queue_sums) in
    let @8 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = @7.data in
    @9[@8].n = @2
    @9[@8].acc = @3
    @9[@8].i = i
    return true
  }
}

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_entries_0 : mut Entry_sums[8]
  sums_entries_1 : mut Entry_sums[8]
  sums_queue : mut Queue_sums[2]
  let @0 = build<Queue_sums>(0u, sums_entries_0) in
  sums_queue[0u] = @0
  let @2 = build<Queue_sums>(0u, sums_entries_1) in
  sums_queue[1u] = @2
  parfor i in [0:8:1] {
    let @5 = fill(i, 0, out, i, (&sums_queue[0u])) in
    if (@5) {
      continue
    } else {
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @7 = (*sums!round) & 1u in
    let @9 = sums_queue[(*sums!round) & 1u].count in
    let @11 = @7 ^ 1u in
    sums_queue[@11].count = 0u
    parfor sums in [0u:@9:1u] {
      let @14 = sums_queue[@7] in
      let @15 = @14.data in
      let @16 = @15[sums] in
      let @17 = @16.n in
      let @18 = @16.acc in
      let @19 = @16.i in
      let @21 = fill(@17, @18, out, @19, (&sums_queue[@11])) in
      if (@21) {
        continue
      } else {
        continue
      }
    }
    let @6 = (*sums!round) + 1u in
    sums!round = @6
  }
  return
}


schedule host {
    sums = run.queue(root);
    fill.defer(fill, sums)

}
