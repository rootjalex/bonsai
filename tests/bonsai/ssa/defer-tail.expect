type Entry_sums = struct Entry_sums{ n : i32; acc : i32; i : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; i : i32[] }

func [[noinline]] fill(n : i32, acc : i32, out : mut i32[8], i : i32, _queue_sums : mut (Queue_sums*)) -> void {
  let @0 = n <= 0 in
  if (@0) {
    out[i] = acc
    return
  } else {
    let @2 = n - 1 in
    let @3 = acc + n in
    let @4 = build<Entry_sums>(@2, @3, i) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).n in
    @9[@7] = @2
    let @12 = (*_queue_sums).acc in
    @12[@7] = @3
    let @15 = (*_queue_sums).i in
    @15[@7] = i
    return
  }
}

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums_i_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums_i_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @0 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums_i_0) in
  sums_queue[0u] = @0
  let @2 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums_i_1) in
  sums_queue[1u] = @2
  parfor i in [0:8:1] {
    fill(i, 0, out, i, (&sums_queue[0u]))
    continue
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @6 = (*sums!round) & 1u in
    let @8 = sums_queue[(*sums!round) & 1u].count in
    let @10 = @6 ^ 1u in
    sums_queue[@10].count = 0u
    parfor sums in [0u:@8:1u] {
      let @11 = (&sums_queue[@10]) in
      let @15 = sums_queue[@6].n in
      let @16 = @15[sums] in
      let @18 = sums_queue[@6].acc in
      let @19 = @18[sums] in
      let @21 = sums_queue[@6].i in
      let @22 = @21[sums] in
      fill(@16, @19, out, @22, @11)
      continue
    }
    let @5 = (*sums!round) + 1u in
    sums!round = @5
  }
  return
}


schedule host {
    sums = run.queue(root);
    fill.defer(fill, sums)

}
