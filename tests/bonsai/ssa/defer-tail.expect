type Entry_sums = struct Entry_sums{ n : i32; acc : i32; i : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; i : i32[] }

func [[noinline]] fill(n : i32, acc : i32, out : mut i32[8], i : i32, _queue_sums : mut (Queue_sums*)) -> bool {
  let @0 = n <= 0 in
  if (@0) {
    out[i] = acc
    return false
  } else {
    let @2 = n - 1 in
    let @3 = acc + n in
    let @4 = build<Entry_sums>(@2, @3, i) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).n in
    @9[@7] = @2
    let @12 = (*_queue_sums).acc in
    @12[@7] = @3
    let @15 = (*_queue_sums).i in
    @15[@7] = i
    return true
  }
}

func run(out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums_i_0 : mut i32[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums_i_1 : mut i32[8]
  sums_queue : mut Queue_sums[2]
  let @0 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums_i_0) in
  sums_queue[0u] = @0
  let @2 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums_i_1) in
  sums_queue[1u] = @2
  parfor i in [0:8:1] {
    let @5 = fill(i, 0, out, i, (&sums_queue[0u])) in
    if (@5) {
      continue
    } else {
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @7 = (*sums!round) & 1u in
    let @9 = sums_queue[(*sums!round) & 1u].count in
    let @11 = @7 ^ 1u in
    sums_queue[@11].count = 0u
    parfor sums in [0u:@9:1u] {
      let @16 = sums_queue[@7].n in
      let @17 = @16[sums] in
      let @19 = sums_queue[@7].acc in
      let @20 = @19[sums] in
      let @22 = sums_queue[@7].i in
      let @23 = @22[sums] in
      let @25 = fill(@17, @20, out, @23, (&sums_queue[@11])) in
      if (@25) {
        continue
      } else {
        continue
      }
    }
    let @6 = (*sums!round) + 1u in
    sums!round = @6
  }
  return
}


schedule host {
    sums = run.queue(root);
    fill.defer(fill, sums)

}
