        if (flag) {
          let @11 = 13f < z in
          if (@11) {
            let @33 = reinterpret_cast<i32>(15f) in
            let @34 = reinterpret_cast<i32>(z) in
            let @35 = @33 < @34 in
            let @13 = select(@35, 2u, 3u) in
            let w = tab[@13] in
            let @15 = z + w in
            let @16 = 15f < @15 in
            if (@16) {
              let @17 = z * 0.25f in
              let @18 = (*found!loop) + 2f in
              let @19 = (*wave!loop) + 1 in
              x!loop = @17
              found!loop = @18
              wave!loop = @19
              continue
            } else {
              let @21 = (*found!loop) - 1f in
              return @21
            }
          }
        }
        let @22 = z - 4f in
        let @23 = (*found!loop) + 1f in
        let @24 = (*wave!loop) + 1 in
        x!loop = @22
        found!loop = @23
        wave!loop = @24
      } else {
        let @26 = y + 3f in
        let @27 = (*found!loop) + 0.5f in
        let @28 = (*wave!loop) + 1 in
        x!loop = @26
        found!loop = @27
        wave!loop = @28
      }
    }
  }
  return (*found!loop)
}

