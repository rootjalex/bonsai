    let @1 = work((*x!loop)) in
    let y = @1 * 0.25f in
    let @3 = 20f < y in
    if (@3) {
      let @4 = (*found!loop) + y in
      return @4
    } else {
      let @5 = 0.5f < y in
      if (@5) {
        let @6 = work(y) in
        let @30 = reinterpret_cast<i32>(10f) in
        let @31 = reinterpret_cast<i32>(y) in
        let @32 = @30 < @31 in
        let @8 = cast<u32>(@32) in
