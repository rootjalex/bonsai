//! flags: -p ssa

// A node that bounds its children rather than itself, sorted and put on a
// stack: Embree's traversal of a BVH whose nodes hold their children's boxes.
//
// lower/child-volumes.bonsai is the tree lowering's half: a loop over the
// node's children computes a mask, and the `from` carries it. This is what
// the schedule makes of it. The sort's keys go into the same loop -- one
// pass over the children computes what the parent tests and what it orders
// by, which is one loop for a schedule to vectorize into Embree's test of
// all the children at once:
//
//     _mask1 : mut bool[4]
//     _keys0 : mut f32[4]
//     parfor children in [0u:4u:1u] {
//       _mask1[children] = <the ray meets child i's box, nearer than the best>
//       _keys0[children] = entry(r, build<AABB>(lo[children], hi[children]))
//     }
//
// The sort orders the four children by the distance at which the ray enters
// each box, and only the children hit: the mask, the keys and the children
// are the lanes of one vector each, so the run is sorted as those vectors
// (SSA/SortRecursion.cpp, sort_lanes). The misses' keys are made infinite,
// the keys become integers that order as the floats do with the lane in the
// low bits -- Embree's `distance_i` -- the hits' keys are packed to the
// front (`compress`), and a `switch` on their count (`reduce<+>` of the
// mask) picks the network, as Embree's traverseClosestHit does: nothing
// for one hit, the shortest network of two or three inputs for those, and
// for four the bitonic network over all the lanes of the unpacked keys,
// each layer a `shuffle`, a `min`, a `max` and a `select`. Every case
// leaves the keys in one shape (`slice(.., 3, -1, 4)` reverses the packed
// ones into it): descending, the misses in the first lanes and the hits
// from the farthest to the nearest in the last. The children and the
// carried bounds do not follow the keys through the network; they are taken
// out once by the lane in each sorted key's low bits (`permute`). Then
// loopify puts the run on a stack with one compacting store:
//
//     if (hits != 0) {
//       compress_store(!stack[!count], <sorted children>, <lanes 4-hits .. 2>)
//       !count += hits - 1
//       tris_ref!top = <lane 3, the nearest>
//     }                                   -- and otherwise the pop
//
// a child whose box the ray missed is neither descended into nor pushed, and
// no push is a branch. That is Embree's BVHNIntersector1 -- intersect the
// node's children, sort the hits by distance, push them and continue with
// the nearest -- as the composition of a tree declaration and two
// directives.
//
// What is not here: Embree also carries each pushed child's entry distance
// on the stack and drops a popped entry whose distance is beyond the best
// hit found since (`if (stackPtr->dist > ray.tfar) continue`). A popped child
// here is visited: its own children are tested against the tightened best
// and all fail, so the pruning happens, one level later than Embree's.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

// The distance at which the ray enters a box, and infinity where it misses:
// a sort key that puts the children the ray misses last.
func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lo : vector[vec3f, 4];
            hi : vector[vec3f, 4];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    // Nearest child first: the key is the distance at which the ray enters
    // child i's box, which the parent holds -- `i` is the children's loop
    // index, in the loop's type, and the key is computed in that loop.
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
}
