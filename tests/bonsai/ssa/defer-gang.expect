type Entry_sums = struct Entry_sums{ n : i32; acc : i32; i : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; i : i32[] }

func run(out : mut i32[40]) -> void {
  sums!round : mut u32
  sums_n_0 : mut i32[40]
  sums_acc_0 : mut i32[40]
  sums_i_0 : mut i32[40]
  sums_n_1 : mut i32[40]
  sums_acc_1 : mut i32[40]
  sums_i_1 : mut i32[40]
  sums_queue : mut Queue_sums[2]
  let @1 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums_i_0) in
  sums_queue[0u] = @1
  let @3 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums_i_1) in
  sums_queue[1u] = @3
  parfor i in [0:40:1] {
    let @30 = mulhi(i, -1840700269) in
    let @31 = @30 + i in
    let @32 = @31 >> 2 in
    let @33 = @32 >> 31 in
    let @34 = reinterpret_cast<u32>(@33) in
    let @35 = @34 >> 31u in
    let @36 = reinterpret_cast<i32>(@35) in
    let @37 = @32 + @36 in
    let @38 = @37 * 7 in
    let @0 = i - @38 in
    let @6 = walk(@0, 0, out, i, (&sums_queue[0u])) in
    if (@6) {
      continue
    } else {
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @8 = (*sums!round) & 1u in
    let @10 = sums_queue[(*sums!round) & 1u].count in
    let @12 = @8 ^ 1u in
    sums_queue[@12].count = 0u
    parfor sums_gang in [0u:@10:16u] {
      let @27 = sums_queue[(*sums!round) & 1u].count in
      let @46 = u32x16(@27) in
      let @29 = ramp(sums_gang, 1u, 16) < @46 in
      let @43 = reduce<any>(@29) in
      if (@43) {
        let @17 = sums_queue[@8].n in
        let @18 = masked_extract(@17[ramp(sums_gang, 1u, 16)], @29) in
        let @20 = sums_queue[@8].acc in
        let @21 = masked_extract(@20[ramp(sums_gang, 1u, 16)], @29) in
        let @23 = sums_queue[@8].i in
        let @24 = masked_extract(@23[ramp(sums_gang, 1u, 16)], @29) in
        let @26 = walk$gang16_v0_v1_v3$masked(@18, @21, out, @24, (&sums_queue[@12]), @29) in
      }
      continue
    }
    let @7 = (*sums!round) + 1u in
    sums!round = @7
  }
  return
}

func [[noinline]] walk(n : i32, acc : i32, out : mut i32[40], i : i32, _queue_sums : mut (Queue_sums*)) -> bool {
  let @0 = n <= 0 in
  if (@0) {
    out[i] = acc
    return false
  } else {
    let @2 = n - 1 in
    let @3 = acc + n in
    let @4 = build<Entry_sums>(@2, @3, i) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).n in
    @9[@7] = @2
    let @12 = (*_queue_sums).acc in
    @12[@7] = @3
    let @15 = (*_queue_sums).i in
    @15[@7] = i
    return true
  }
}

func [[noinline]] walk$gang16_v0_v1_v3$masked(n : i32x16, acc : i32x16, out : mut i32[40], i : i32x16, _queue_sums : mut (Queue_sums*), !mask : boolx16) -> boolx16 {
  !ret!skip : mut boolx16
  let @12 = i32x16(0) in
  let @0 = n <= @12 in
  let @13 = boolx16(false) in
  let @14 = boolx16(true) in
  let @6 = select(@0, @13, @14) in
  let @7 = !mask && @6 in
  let @8 = !mask && @0 in
  let @10 = reduce<any>(@8) in
  if (@10) {
    masked_store(out[i], acc, @8)
  }
  let @9 = reduce<any>(@7) in
  let @18 = boolx16(false) in
  if (@9) {
    let @15 = i32x16(1) in
    let @2 = n - @15 in
    let @3 = acc + n in
    let @4 = build<Entry_sums$v16>(@2, @3, i) in
    let @20 = reduce<+>(cast<u32x16>(@7)) in
    let @21 = atomic_add((&(*_queue_sums).count), @20) in
    let @23 = (*_queue_sums).n in
    compress_store(@23[@21], @2, @7)
    let @26 = (*_queue_sums).acc in
    compress_store(@26[@21], @3, @7)
    let @29 = (*_queue_sums).i in
    compress_store(@29[@21], i, @7)
    let @16 = boolx16(true) in
    let @17 = boolx16(false) in
    let @11 = select(@7, @16, @17) in
    !ret!skip = @11
  } else {
    !ret!skip = @18
  }
  return (*!ret!skip)
}


schedule host {
    sums = run.queue(root);
    run.split(sums, sums_gang, sums_lane, (i32)16, 1)
       .vectorize(sums_lane)
    walk.defer(walk, sums)

}
