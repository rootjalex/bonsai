//! flags: -p ssa

// The pointer layout of lower/ptr-arena-rows.bonsai under the schedule of
// arena-rows-vectorized.bonsai: references that are addresses with the kind
// in their low bits, Embree's NodeRef as it is, looked up in a `ptr group`.
//
// What to read for. The children's gang reads the node's bounds through
// the reference itself reinterpreted as an array of rows and indexed at
// zero -- no arena base added, no bits masked, since an interior node's
// kind bits are zero; a leaf's run of tiles begins at `(tris_ref >> 4u) *
// 16u`, the kind taken off. The prefetch of a hit child is one statement
// with no switch on the kind, of the reference itself: the arms' addresses
// differ only in the low bits an arm clears, which name the same cache line
// (Lower/Layouts.cpp, LowerReferencePrefetches), as Embree's BVH::prefetch
// fetches through the NodeRef with its kind bits in place. The walk begins
// at `root`, read off the layout's struct. The hit an argmin keeps is the
// pair of the leaf's address and the element's index in its run.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    trace.prefetch(tris.Interior.children);
}
