type Entry_sums = struct Entry_sums{ n : i32; acc : i32; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _slot : i32[] }

func run(n : i32, out : mut i32[n]) -> void {
  alloc sums_ran : mut u8[n]
  alloc sums_result : mut i32[n]
  alloc sums_n_0 : mut i32[n]
  alloc sums_acc_0 : mut i32[n]
  alloc sums__slot_0 : mut i32[n]
  alloc sums_n_1 : mut i32[n]
  alloc sums_acc_1 : mut i32[n]
  alloc sums__slot_1 : mut i32[n]
  sums_queue : mut Queue_sums[2]
  parfor r in [0:2:1] {
    sums!round : mut u32
    let @4 = fill_bytes(sums_ran, 0u, n) in
    let @6 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__slot_0) in
    sums_queue[0u] = @6
    let @8 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__slot_1) in
    sums_queue[1u] = @8
    parfor i in [0:n:1] {
      let @11 = tally(i, r, (&sums_queue[0u]), (&sums_result[i]), i) in
      let @12 = out in
      let @13 = i in
      let @14 = @11.set in
      let @15 = @11.value in
      if (@14) {
        let @0 = @15 in
        let v = @0 in
        let @1 = out[i] in
        let @2 = @1 + v in
        out[i] = @2
        continue
      } else {
        sums_ran[i] = 1u
        continue
      }
    }
    sums!round = 0u
    while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
      let @18 = (*sums!round) & 1u in
      let @20 = sums_queue[(*sums!round) & 1u].count in
      let @22 = @18 ^ 1u in
      sums_queue[@22].count = 0u
      parfor sums in [0u:@20:1u] {
        let @23 = (&sums_queue[@22]) in
        let @27 = sums_queue[@18].n in
        let @28 = @27[sums] in
        let @30 = sums_queue[@18].acc in
        let @31 = @30[sums] in
        let @33 = sums_queue[@18]._slot in
        let @34 = @33[sums] in
        tally(@28, @31, @23, (&sums_result[@34]), @34)
        continue
      }
      let @17 = (*sums!round) + 1u in
      sums!round = @17
    }
    parfor sums_rest in [0:n:1] {
      let @43 = sums_result[sums_rest] in
      let @45 = sums_ran[sums_rest] in
      switch (@45) {
      case 0: {
        continue
      } break;
      default: {
        let @39 = @43 in
        let @40 = out in
        let @41 = sums_rest in
        let v = @39 in
        let @36 = @40[@41] in
        let @37 = @36 + v in
        @40[@41] = @37
        continue
      }
      }
    }
    continue
  }
  free(sums_ran)
  free(sums_result)
  free(sums_n_0)
  free(sums_acc_0)
  free(sums__slot_0)
  free(sums_n_1)
  free(sums_acc_1)
  free(sums__slot_1)
  return
}

func tally(n : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  let @0 = n <= 0 in
  if (@0) {
    _result_sums = acc
    let @4 = build<_option_sums>(acc, true) in
    return @4
  } else {
    let @1 = n - 1 in
    let @2 = acc + n in
    let @5 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @6 = build<_option_sums>(undef, false) in
    let @9 = atomic_add((&(*_queue_sums).count), 1u) in
    let @11 = (*_queue_sums).n in
    @11[@9] = @1
    let @14 = (*_queue_sums).acc in
    @14[@9] = @2
    let @17 = (*_queue_sums)._slot in
    @17[@9] = _slot_sums
    return @6
  }
}


schedule {
    sums = run.queue(r);
    tally.defer(tally, sums)

}
