type Entry_rays = struct Entry_rays{ x : f32; n : i32 }
type Float = f32
type Half = f16
type Queue_rays = struct Queue_rays{ count : u32; x : f32[]; n : i32[] }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func run(values : f32[12], counts : u32[1], out : mut f32[4], total : mut (f32*)) -> void {
  rays!round : mut u32
  let @8 = counts[0] in
  let @9 = 4u * @8 in
  alloc rays_x_0 : mut f32[@9]
  alloc rays_n_0 : mut i32[@9]
  alloc rays_x_1 : mut f32[@9]
  alloc rays_n_1 : mut i32[@9]
  rays_queue : mut Queue_rays[2]
  let @12 = build<Queue_rays>(0u, rays_x_0, rays_n_0) in
  rays_queue[0u] = @12
  let @14 = build<Queue_rays>(0u, rays_x_1, rays_n_1) in
  rays_queue[1u] = @14
  parfor i in [0u:4u:1u] {
    let m = counts[0] in
    parfor j in [0u:m:1u] {
      let @1 = i * 3u in
      let @2 = @1 + j in
      let @3 = values[@2] in
      let @4 = cast<i32>(j) in
      let @17 = build<Entry_rays>(@3, @4) in
      let @37 = atomic_add((&rays_queue[0u].count), 1u) in
      let @39 = rays_queue[0u].x in
      @39[@37] = @3
      let @42 = rays_queue[0u].n in
      @42[@37] = @4
      continue
    }
    continue
  }
  rays!round = 0u
  while (!(rays_queue[(*rays!round) & 1u].count == 0u)) {
    let @21 = (*rays!round) & 1u in
    let @23 = rays_queue[(*rays!round) & 1u].count in
    let @25 = @21 ^ 1u in
    rays_queue[@25].count = 0u
    parfor rays in [0u:@23:1u] {
      let @26 = (&rays_queue[@25]) in
      let @30 = rays_queue[@21].x in
      let @31 = @30[rays] in
      let @33 = rays_queue[@21].n in
      let @34 = @33[rays] in
      step(@31, @34, total, @26)
      continue
    }
    let @20 = (*rays!round) + 1u in
    rays!round = @20
  }
  parfor rays_rest in [0u:@9:1u] {
    let @35 = rays_rest / @8 in
    let i = @35 in
    let @5 = out[i] in
    let @6 = @5 + 1f in
    out[i] = @6
    continue
  }
  free(rays_x_0)
  free(rays_n_0)
  free(rays_x_1)
  free(rays_n_1)
  return
}

func step(x : f32, n : i32, total : mut (f32*), _queue_rays : mut (Queue_rays*)) -> void {
  total += x
  let @0 = n == 0 in
  if (@0) {
    return
  } else {
    let @1 = n - 1 in
    let @2 = build<Entry_rays>(x, @1) in
    let @5 = atomic_add((&(*_queue_rays).count), 1u) in
    let @7 = (*_queue_rays).x in
    @7[@5] = x
    let @10 = (*_queue_rays).n in
    @10[@5] = @1
    return
  }
}


schedule {
    rays = run.queue(root);
    run.defer(step, rays)
    step.defer(step, rays)

}
