  let @31 = r.d in
  let @32 = @31[2u] in
  let @33 = f32x3(@32) in
  let @34 = @30 * @33 in
  let d = @29 + @34 in
  let @36 = r.tmax in
  let out = build<Ray>(o, d, @36) in
  return out
}


schedule host {
    trace.loopify((i32)64)

}
