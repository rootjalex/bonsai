//! flags: -p ssa --dump-ssa-postschedule

// The names a `let` keeps through an unroll, as the block graph. A `let`
// whose value is not an instruction of its own -- here `k`, bound to the
// result of a call no inliner copies in (`[[noinline]]`), which reaches the
// continuation block as an argument -- is a Set instruction carrying the
// program's name (SSA/SSA.cpp, Block::make_instruction). When the children
// loop is unrolled, each copy of the body gets its own Set, and the copies
// live side by side in one function, the second dominated by the first.
//
// What to read for: the two copies' Sets under ONE name, `k$iN = set(...)`
// in each (clone_region, SSA/Defer.cpp, keeps a Set's name in every copy:
// the relooper binds the program's name, the copy's scope keeps it apart,
// and the defer rewrite finds a copied continuation's values by it), and
// the two children's keys written as two values. Until 2026-10-25 the
// simplifier's value numbering keyed an instruction by its operands'
// NAMES (SSA/Simplify.cpp, key_of) and found a value by walking the
// dominators, so wherever a Set's consumer had no other operand of its
// own -- `k * s` with `s` shared by the copies -- the second copy's was
// taken for the first's: both children's keys became one value, the swap
// of the two vanished, and a traversal that was to enter the nearer child
// first entered the left one always (found as a 25% loss and a changed tie
// pattern on the silhouette query of apps/rtq's cone hierarchy, where an
// alias a layout's split had left behind -- `b$low = _t67129`, a Set of a
// block argument, not behind a call -- played the part of `k`). The
// numbering now keys an operand by the instruction itself. Here the Sets
// sit in the call's continuation, which the numbering's walk does not
// cross, so this program never merged; what it pins is the shape -- two
// Sets of one name, one per copy, two keys -- that the numbering has to
// tell apart, the alias form being one no source program can write.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/point;
import stdlib/triangle;

extern tris : set[Triangle];

// Not copied in, so that its result is a value the let names rather than
// an instruction the let renames.
func [[noinline]] half(x : Float) -> Float = x * 0.5;

// The child's key: half its box distance, scaled by a factor of one made
// from the query point, so that the key's last operation reads the Set and
// a value both copies share (the factor, invariant over the children).
func key(p : Point, lo : vec3f, hi : vec3f) -> Float {
    k = half(distmin(p, AABB{lo, hi}));
    s = p.vec.x * 0.0 + 1.0;
    return k * s;
}

func [[export]] closest(p : Point) = argmin(|t : Triangle| distmin(p, t), tris);

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    closest.sort(tris.Interior,
                 |i : u32, p : Point, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                 key(p, lo[i], hi[i]))
           .unroll(tris.Interior.children)
           .loopify(64);
}
