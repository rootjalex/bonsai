//! flags: -p ssa -b ptx --dump-ssa-final -o tests/bonsai/ssa/blocks/record-hoist
//! commands: rm $<>/record-hoist

// What a hit program can know from its hit-group record alone is computed
// once per record by the driver and read off the record (SSA/RecordHoist.h):
// the program over a mesh whose triangles are stored nowhere (backends/ptx/
// rtcore-holder-reference) reads a triangle's corners through the mesh's
// `first_vertex` and `first_index`, two loads at the record's mesh. What
// to look for in the final SSA: `_RTRecord` with the two hoisted fields
// `_1_h0` and `_1_h1` after `_1_mesh`; the any-hit, intersection and
// hit-side trace functions with `triangle_of` and `corner` copied in and
// the two loads replaced by `load_field(<record>, 4)` and `(.., 5)`, no
// read of `mesh_first_vertex` or `mesh_first_index` left in them; and the
// filler, `bonsai_rt_record_fill`, taking those two arrays as parameters
// and computing the two fields in the Mesh arm from the arm's mesh index
// (zeros in the Solo arm), the match's function copied into it so that the
// arms are its own blocks. Each value is one field however many programs
// compute it.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element TriRef {
    mesh : u32;
    tri : u32;
}

extern mesh_first_index : array[u32];
extern mesh_first_vertex : array[u32];
extern indices : array[u32];
extern positions : array[vec3f];

func corner(t : TriRef, c : u32) -> vec3f =
    positions[mesh_first_vertex[t.mesh] +
              indices[mesh_first_index[t.mesh] + 3u * t.tri + c]];

func triangle_of(t : TriRef) -> Triangle {
    out : Triangle = {corner(t, 0u), corner(t, 1u), corner(t, 2u)};
    return out;
}

element Prim =
    | Solo(tri : Triangle)
    | Mesh(mesh : u32, tris : set[TriRef]);

func geometry(p : Prim) -> set[Triangle] =
    match p {
        Solo(tri) => set[Triangle]{tri},
        Mesh(mesh, tris) => map(|t : TriRef| triangle_of(t), tris)
    };

element Prim with extent = |p| geometry(p).AABB;

func mesh_of(p : Prim) -> i32 {
    match p {
        Solo(tri) => return -1;
        Mesh(mesh, tris) => return cast[[i32]](mesh);
    }
}

extern near : array[f32, 1];
extern prims : set[Prim];

func trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, tri),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, tri) && distmin(r, tri) > near[0],
                  flatten(|p : Prim| geometry(p), prims)));

func [[export]] render(n : i32, rays : array[Ray, n],
                       hit_x : mut array[f32], hit_mesh : mut array[i32]) -> void {
    parfor i in 0:n {
        r = rays[i];
        found = trace(r);
        if found {
            hit = *found;
            hit_x[i] = hit[1].p0.x;
            hit_mesh[i] = mesh_of(hit[0]);
        } else {
            hit_x[i] = -1.0;
            hit_mesh[i] = -2;
        }
    }
    return;
}

schedule {
    layout Prim = tagged_index;
    prims : OptixTree;
    Mesh.tris : OptixTree from mesh_tris;
    layout prims {
        group mesh_tris (h : Mesh, k : u32) { mesh = h.mesh; tri = k; };
        pCount : u32;
        elems : array[Prim, pCount];
    };
    trace.bind(RTCore);
    render.bind(i, OptixThread);
}
