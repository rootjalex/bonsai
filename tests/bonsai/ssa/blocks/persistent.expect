; === ssa preschedule ===
; --- scale ---
func scale(n : i32, a : f32[n], out : f32[n]): 
  parfor i (i32)0:n:(i32)1 !par_body_0(a, out) !par_cont_1()

!par_body_0(i : i32, a : f32[n], out : f32[n]): // preds: scale
  @0 = extract_idx(a, i)
  @1 = mul(@0, (f32)2)
  @2 = gep(out, i)
  store @2 @1
  yield

!par_cont_1(): // preds: scale
  ret

; === ssa postschedule ===
; --- scale ---
func scale(n : i32, a : f32[n], out : f32[n]): 
  i!counter = alloca<(i32*)>()
  store i!counter (i32)0
  parfor w (i32)0:(i32)4:(i32)1 !par_body_0_fetch_w(a, out, i!counter, n) !par_cont_1()

!par_body_0_fetch_w(w : i32, a : f32[n], out : f32[n], @3 : (i32*), @4 : i32): // preds: scale
  @7 = atomic.add(@3, (i32)1)
  jmp !par_body_0_head_w(@7, a, out, @3, @4)

!par_body_0_head_w(@5 : i32, a : f32[n], out : f32[n], @3 : (i32*), @4 : i32): // preds: !par_body_0_fetch_w, !par_body_0_next_w
  @6 = lt(@5, @4)
  dispatch @6 [!par_body_0_done_w(), !par_body_0(@5, a, out, @3, @4)]

!par_body_0_done_w(): // preds: !par_body_0_head_w
  yield

!par_body_0_next_w(a : f32[n], out : f32[n], @3 : (i32*), @4 : i32): // preds: !par_body_0
  @8 = atomic.add(@3, (i32)1)
  jmp !par_body_0_head_w(@8, a, out, @3, @4)

!par_body_0(i : i32, a : f32[n], out : f32[n], @3 : (i32*), @4 : i32): // preds: !par_body_0_head_w
  @0 = extract_idx(a, i)
  @1 = mul(@0, (f32)2)
  @2 = gep(out, i)
  store @2 @1
  jmp !par_body_0_next_w(a, out, @3, @4)

!par_cont_1(): // preds: scale
  ret

func scale(n : i32, a : f32[n], out : mut f32[n]) -> void {
  i!counter : mut i32
  i!counter = 0
  parfor w in [0:4:1] {
    @5 : mut i32
    let @3 = i!counter in
    let @4 = n in
    let @7 = atomic_add(@3, 1) in
    @5 = @7
    while ((*@5) < @4) {
      let i = (*@5) in
      let @0 = a[i] in
      let @1 = @0 * 2f in
      out[i] = @1
      let @8 = atomic_add(@3, 1) in
      @5 = @8
    }
    continue
  }
  return
}


schedule {
    scale.persistent(i, w, (i32)4)

}
