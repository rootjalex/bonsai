//! flags: -p ssa

// `sort()` on a branching recursion: the schedule gives each branch of the
// `from` a key, and the traversal visits them in ascending order of it.
//
// This is the front-to-back BVH traversal every ray tracer wants. The key here
// is pbrt's rule -- if the ray points down the axis the node was split on,
// visit the second child first -- written as `select(dir < 0, 1 - i, i)`, so
// branch 0 gets the smaller key exactly when the ray reaches it first.
//
// Three things to look for in the golden. The reordering is a run of
// `select`s over *node indices*, not over subtree values: it happens after the
// layout has turned a branch into a number, which is the whole reason it is an
// SSA rewrite and not part of Lower/Sorts.cpp. The selects are on `!c` and
// nothing else: the network compared `cast(c)` with `cast(!c)`, and
// SSA/Simplify.h knows that a number made from a bool is below another only
// for false below true, so the whole comparison folds to the negated
// condition -- pbrt's `if (dirIsNeg[node->axis])`, with no compare left. And
// the sorted branches are pushed onto the stack in reverse, because the stack
// is last-in-first-out and the branch with the smallest key has to be the one
// the next pop takes.
import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles));

schedule {
    tree[[Triangle]] TriangleBVH(low high : vec3f) with AABB(low, high) =
    | Interior(left : TriangleBVH, right : TriangleBVH, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    triangles : TriangleBVH;

    layout triangles {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            high : vec3f;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u32; data = range(prims, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };

    trace.sort(triangles.Interior, |i : u8, ray : Ray, axis : u8| select((1 / ray.d)[axis] < 0, 1 - i, i))
         .loopify(64);
}
