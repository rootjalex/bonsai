//! flags: -p ssa

// One buffer for a ray queue no drain pushes onto while it is read. The
// trace kernel `trace_step` hands every hit to `shade_step`, deferred onto
// `hits`, and `shade_step` pushes the next ray onto `rays`: nothing the rays
// drain runs pushes onto rays -- the one call that would, trace_step's call
// of shade_step, is a push onto hits, run by the hits drain after the rays
// pass -- so the queue is one buffer whose count is read for the pass and
// reset before it, and the hits drain fills it again for the next round
// (QueueSpec::drain_pushes_self; pbrt keeps two, `rayQueues[depth & 1]`,
// which the rounds do not need once every kernel is a drain of its own).
//
// What to read for: `rays_queue : mut Queue_rays`, one queue, not an
// array of two indexed by the round's parity; the round header reads its
// count and the batch resets it before the pass.
import stdlib/numerics;

func shade_step(x : i32, depth : i32, total : reduce(+) i32) -> void {
    total += 2 * x;
    trace_step(x + 1, depth - 1, total);
    return;
}

func trace_step(x : i32, depth : i32, total : reduce(+) i32) -> void {
    if depth == 0 {
        return;
    }
    total += x;
    shade_step(x, depth, total);
    return;
}

func run(a : array[i32, 4], total : reduce(+) i32) -> void {
    parfor i in 0:4 {
        trace_step(a[i], 3, total);
    }
    return;
}

schedule {
    rays = run.queue(root);
    run.defer(trace_step, rays);
    shade_step.defer(trace_step, rays);
    hits = run.queue(root);
    trace_step.defer(shade_step, hits);
}
