//! flags: -p ssa

// A parfor round tripping through SSA form: it becomes a ParFor terminator
// with a body region ending in Yield, which structurize() has to turn back
// into a parfor statement. (Compiling one to machine code needs a schedule --
// see known-limitation-parfor-codegen.bonsai.)
func bar(i : i32, a : mut array[i32]) {
    a[i] = i / 2;
    return;
}

func fiz(i : i32, a : mut array[i32]) {
    a[i] = i * 3;
    return;
}

func foo(i : i32, a : mut array[i32]) {
    if i % 3 == 0 {
        bar(i, a);
    } else {
        fiz(i, a);
    }
    return;
}

func example(n : i32, a : mut array[i32, n]) {
    parfor i in 0:n {
        foo(i, a);
    }
    return;
}
