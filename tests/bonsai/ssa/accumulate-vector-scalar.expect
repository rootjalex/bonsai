type Float = f32
type Half = f16
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] run(a : f32x3[4], s : f32, out : mut f32x3[4]) -> void {
  i : mut i32
  i = 0
  while ((*i) < 4) {
    let @1 = a[(*i)] in
    let @2 = scaled(@1, s) in
    out[(*i)] = @2
    let @4 = (*i) + 1 in
    i = @4
  }
  return
}

func [[noinline]] scaled(v : f32x3, s : f32) -> f32x3 {
  let @0 = f32x3(s) in
  let @4 = v * @0 in
  let @5 = @4 + @0 in
  let @2 = f32x3(-1f) in
  let @6 = @5 + @2 in
  return @6
}


