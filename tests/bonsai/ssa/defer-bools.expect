type Entry_sums = struct Entry_sums{ n : i32; acc : i32; odd : bool; big : bool; neg : bool; _slot : i32 }
type Queue_sums = struct Queue_sums{ count : u32; n : i32[]; acc : i32[]; _slot : i32[]; _bits0 : u8[] }

func run(flags : mut i32[8], out : mut i32[8]) -> void {
  sums!round : mut u32
  sums_ran : mut u8[8]
  let @7 = fill_bytes(sums_ran, 0u, 8) in
  sums_result : mut i32[8]
  sums_n_0 : mut i32[8]
  sums_acc_0 : mut i32[8]
  sums__slot_0 : mut i32[8]
  sums__bits0_0 : mut u8[8]
  sums_n_1 : mut i32[8]
  sums_acc_1 : mut i32[8]
  sums__slot_1 : mut i32[8]
  sums__bits0_1 : mut u8[8]
  sums_queue : mut Queue_sums[2]
  let @9 = build<Queue_sums>(0u, sums_n_0, sums_acc_0, sums__slot_0, sums__bits0_0) in
  sums_queue[0u] = @9
  let @11 = build<Queue_sums>(0u, sums_n_1, sums_acc_1, sums__slot_1, sums__bits0_1) in
  sums_queue[1u] = @11
  parfor i in [0:8:1] {
    let f = flags[i] in
    let @56 = f >> 31 in
    let @57 = reinterpret_cast<u32>(@56) in
    let @58 = @57 >> 31u in
    let @59 = reinterpret_cast<i32>(@58) in
    let @60 = f + @59 in
    let @61 = @60 >> 1 in
    let @62 = @61 * 2 in
    let @1 = f - @62 in
    let @2 = @1 == 1 in
    let @3 = 4 < f in
    let @4 = f == 3 in
    let @14 = walk(i, 0, @2, @3, @4, (&sums_queue[0u]), (&sums_result[i]), i) in
    let @15 = out in
    let @16 = i in
    let @17 = @14.set in
    let @18 = @14.value in
    if (@17) {
      let @5 = @18 in
      out[i] = @5
      continue
    } else {
      sums_ran[i] = 1u
      continue
    }
  }
  sums!round = 0u
  while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
    let @21 = (*sums!round) & 1u in
    let @23 = sums_queue[(*sums!round) & 1u].count in
    let @25 = @21 ^ 1u in
    sums_queue[@25].count = 0u
    parfor sums in [0u:@23:1u] {
      let @26 = (&sums_queue[@25]) in
      let @30 = sums_queue[@21].n in
      let @31 = @30[sums] in
      let @33 = sums_queue[@21].acc in
      let @34 = @33[sums] in
      let @36 = sums_queue[@21]._bits0 in
      let @37 = @36[sums] in
      let @38 = @37 & 1u in
      let @39 = @38 != 0u in
      let @40 = @37 & 2u in
      let @41 = @40 != 0u in
      let @42 = @37 & 4u in
      let @43 = @42 != 0u in
      let @45 = sums_queue[@21]._slot in
      let @46 = @45[sums] in
      walk(@31, @34, @39, @41, @43, @26, (&sums_result[@46]), @46)
      continue
    }
    let @20 = (*sums!round) + 1u in
    sums!round = @20
  }
  parfor sums_rest in [0:8:1] {
    let @53 = sums_result[sums_rest] in
    let @55 = sums_ran[sums_rest] in
    switch (@55) {
    case 0: {
      continue
    } break;
    default: {
      let @49 = @53 in
      let @50 = out in
      let @51 = sums_rest in
      @50[@51] = @49
      continue
    }
    }
  }
  return
}

func walk(n : i32, acc : i32, odd : bool, big : bool, neg : bool, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : i32) -> _option_sums {
  r : mut i32
  let @0 = n <= 0 in
  if (@0) {
    if (odd) {
      let @2 = acc + 100 in
      r = @2
    } else {
      r = acc
    }
    if (big) {
      let @4 = (*r) + 1000 in
      r = @4
    }
    if (neg) {
      let @6 = 0 - (*r) in
      r = @6
    }
    _result_sums = (*r)
    let @11 = build<_option_sums>((*r), true) in
    return @11
  } else {
    let @8 = n - 1 in
    let @9 = acc + n in
    let @12 = build<Entry_sums>(@8, @9, odd, big, neg, _slot_sums) in
    let @13 = build<_option_sums>(undef, false) in
    let @16 = atomic_add((&(*_queue_sums).count), 1u) in
    let @17 = cast<u8>(odd) in
    let @18 = cast<u8>(big) in
    let @19 = @18 << 1u in
    let @20 = @17 | @19 in
    let @21 = cast<u8>(neg) in
    let @22 = @21 << 2u in
    let @23 = @20 | @22 in
    let @25 = (*_queue_sums).n in
    @25[@16] = @8
    let @28 = (*_queue_sums).acc in
    @28[@16] = @9
    let @31 = (*_queue_sums)._slot in
    @31[@16] = _slot_sums
    let @34 = (*_queue_sums)._bits0 in
    @34[@16] = @23
    return @13
  }
}


schedule {
    sums = run.queue(root);
    walk.defer(walk, sums)

}
