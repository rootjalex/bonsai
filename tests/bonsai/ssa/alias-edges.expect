type PS = struct PS{ p : f32; wi : f32x3; pdf : f32 }
type vec3f = f32x3

func [[export]] run(x : f32, n : i32) -> f32 {
  let @0 = through_arm(x, n) in
  let @1 = through_storage(x, n) in
  let @2 = @0 + @1 in
  let @3 = through_call(x) in
  let @4 = @2 + @3 in
  return @4
}

func [[noinline]] sample(x : f32) -> PS {
  let @0 = x < 0f in
  if (@0) {
    let @1 = build<f32x3>(0f, 0f, 0f) in
    let @2 = build<PS>(0f, @1, 0f) in
    return @2
  } else {
    let @3 = x * 2f in
    let @4 = build<f32x3>(x, x, @3) in
    let @5 = x - 1f in
    let @6 = build<PS>(x, @4, @5) in
    return @6
  }
}

func through_arm(x : f32, n : i32) -> f32 {
  beta : mut f32
  beta = 1f
  w : mut f32x3
  let @0 = build<f32x3>(0f, 0f, 1f) in
  w = @0
  depth : mut i32
  depth = 0
  while ((*depth) < n) {
    let @3 = (*depth) in
    let @4 = cast<f32>(@3) in
    let @5 = x + @4 in
    let @6 = sample(@5) in
    let ps = @6 in
    let @7 = ps.pdf in
    let @8 = @7 == 0f in
    let @9 = ps.wi in
    let @10 = @9[2u] in
    let @11 = @10 == 0f in
    let @12 = @8 || @11 in
    if (@12) {
      beta = 0f
    } else {
      let _t2 = ps in
      let _t3 = _t2.pdf in
      let @14 = (*beta) in
      let @15 = ps.p in
      let @16 = @14 * @15 in
      let @17 = @16 / _t3 in
      beta = @17
      let @18 = _t2.wi in
      w = @18
      let @19 = (*beta) in
      let @20 = @19 + _t3 in
      beta = @20
    }
    let @21 = (*depth) in
    let @22 = @21 + 1 in
    depth = @22
  }
  let @23 = (*beta) in
  let @24 = (*w) in
  let @25 = @24[2u] in
  let @26 = @23 * @25 in
  return @26
}

func [[noinline]] through_call(x : f32) -> f32 {
  let @0 = x * 2f in
  let @1 = sample(@0) in
  let _t7 = @1 in
  let @2 = _t7.p in
  let @3 = _t7.pdf in
  let _t10 = @2 * @3 in
  let @5 = x + 1f in
  let @6 = sample(@5) in
  let _t12 = @6 in
  let @7 = _t12.p in
  let @8 = @7 * _t10 in
  let @9 = _t12.pdf in
  let a = @8 + @9 in
  let _t13 = _t10 + 1f in
  let b = _t13 * _t13 in
  let @13 = a + b in
  let @14 = _t7.wi in
  let @15 = @14[0u] in
  let @16 = @13 + @15 in
  return @16
}

func through_storage(x : f32, n : i32) -> f32 {
  _t23 : mut f32x3
  acc : mut f32
  acc = 0f
  depth : mut i32
  depth = 0
  while ((*depth) < n) {
    let @2 = (*depth) in
    let @3 = cast<f32>(@2) in
    let @4 = x + @3 in
    let @5 = sample(@4) in
    let _t17 = @5 in
    let _t19 = _t17.pdf in
    let @7 = _t17.wi in
    let @8 = build<f32x3>(_t19, _t19, _t19) in
    let u = @7 / @8 in
    let @10 = _t17.p in
    let @11 = @10 < 0.5f in
    if (@11) {
      _t23 = u
      let @12 = (*acc) in
      let @13 = (*_t23)[0u] in
      let @14 = sample(@13) in
      let @15 = @14.p in
      let @16 = @12 + @15 in
      acc = @16
    } else {
      _t23 = u
    }
    let @17 = (*acc) in
    let @18 = (*_t23)[0u] in
    let @19 = u[1u] in
    let @20 = @18 * @19 in
    let @21 = @17 + @20 in
    let @22 = u[2u] in
    let @23 = sample(@22) in
    let @24 = @23.pdf in
    let @25 = @21 + @24 in
    acc = @25
    let @26 = (*depth) in
    let @27 = @26 + 1 in
    depth = @27
  }
  let @28 = (*acc) in
  return @28
}


