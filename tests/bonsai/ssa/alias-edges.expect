type PS = struct PS{ p : f32; wi : f32x3; pdf : f32 }
type vec3f = f32x3

func [[export]] run(x : f32, n : i32) -> f32 {
  let @0 = through_arm(x, n) in
  let @1 = through_storage(x, n) in
  let @2 = @0 + @1 in
  let @3 = through_call(x) in
  let @4 = @2 + @3 in
  return @4
}

func [[noinline]] sample(x : f32) -> PS {
  let @0 = x < 0f in
  if (@0) {
    let @1 = build<f32x3>(0f, 0f, 0f) in
    let @2 = build<PS>(0f, @1, 0f) in
    return @2
  } else {
    let @3 = x * 2f in
    let @4 = build<f32x3>(x, x, @3) in
    let @5 = x - 1f in
    let @6 = build<PS>(x, @4, @5) in
    return @6
  }
}

func through_arm(x : f32, n : i32) -> f32 {
  beta : mut f32
  @27!mirror : mut f32
  w : mut f32x3
  depth : mut i32
  let @0 = build<f32x3>(0f, 0f, 1f) in
  let @29 = cast<f32>(0) in
  let @30 = x + @29 in
  beta = 1f
  @27!mirror = @30
  w = @0
  depth = 0
  while ((*depth) < n) {
    let @6 = sample((*@27!mirror)) in
    let ps = @6 in
    let @7 = ps.pdf in
    let @8 = @7 == 0f in
    let @9 = ps.wi in
    let @10 = @9[2u] in
    let @11 = @10 == 0f in
    let @12 = @8 || @11 in
    if (@12) {
      beta = 0f
    } else {
      let @15 = ps.p in
      let @16 = (*beta) * @15 in
      let @17 = @16 / @7 in
      let @20 = @17 + @7 in
      beta = @20
      w = @9
    }
    let @22 = (*depth) + 1 in
    let @32 = cast<f32>(@22) in
    let @33 = x + @32 in
    @27!mirror = @33
    depth = @22
  }
  let @25 = (*w)[2u] in
  let @26 = (*beta) * @25 in
  return @26
}

func [[noinline]] through_call(x : f32) -> f32 {
  let @0 = x * 2f in
  let @1 = sample(@0) in
  let ps = @1 in
  let @2 = ps.p in
  let @3 = ps.pdf in
  let d = @2 * @3 in
  let @5 = x + 1f in
  let @6 = sample(@5) in
  let q = @6 in
  let @7 = q.p in
  let @8 = @7 * d in
  let @9 = q.pdf in
  let a = @8 + @9 in
  let _t9 = d + 1f in
  let b = _t9 * _t9 in
  let @13 = a + b in
  let @14 = ps.wi in
  let @15 = @14[0u] in
  let @16 = @13 + @15 in
  return @16
}

func through_storage(x : f32, n : i32) -> f32 {
  acc : mut f32
  @29!mirror : mut f32
  depth : mut i32
  let @34 = cast<f32>(0) in
  let @35 = x + @34 in
  acc = 0f
  @29!mirror = @35
  depth = 0
  while ((*depth) < n) {
    let @5 = sample((*@29!mirror)) in
    let v = @5 in
    let _t14 = v.pdf in
    let @7 = v.wi in
    let @8 = build<f32x3>(_t14, _t14, _t14) in
    let u = @7 / @8 in
    let @10 = v.p in
    let @11 = @10 < 0.5f in
    if (@11) {
      let @13 = u[0u] in
      let @14 = sample(@13) in
      let @12 = (*acc) in
      let @15 = @14.p in
      let @16 = @12 + @15 in
      acc = @16
    }
    let @18 = u[0u] in
    let @19 = u[1u] in
    let @20 = @18 * @19 in
    let @21 = (*acc) + @20 in
    let @22 = u[2u] in
    let @23 = sample(@22) in
    let @24 = @23.pdf in
    let @25 = @21 + @24 in
    let @27 = (*depth) + 1 in
    let @31 = cast<f32>(@27) in
    let @32 = x + @31 in
    acc = @25
    @29!mirror = @32
    depth = @27
  }
  return (*acc)
}


