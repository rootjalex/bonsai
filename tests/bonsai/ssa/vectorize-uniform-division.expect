func parts(a : u64[8], d : u64, out : mut u64[8]) -> void {
  let @4 = div_multiplier(d) in
  let @5 = d - 1u in
  let @6 = clz(@5) in
  let @7 = 64u - @6 in
  let @8 = min(@7, 1u) in
  let @9 = max(@7, 1u) in
  let @10 = @9 - 1u in
  let @0 = a[ramp(0, 1, 8)] in
  let @17 = u64x8(@4) in
  let @11 = mulhi(@17, @0) in
  let @12 = @0 - @11 in
  let @18 = u64x8(@8) in
  let @13 = @12 >> @18 in
  let @14 = @11 + @13 in
  let @19 = u64x8(@10) in
  let @15 = @14 >> @19 in
  let @20 = u64x8(d) in
  let @16 = @15 * @20 in
  let @1 = @0 - @16 in
  out[ramp(0, 1, 8)] = @1
  return
}

func scale(a : u64[8], d : u64, out : mut u64[8]) -> void {
  let @4 = div_multiplier(d) in
  let @5 = d - 1u in
  let @6 = clz(@5) in
  let @7 = 64u - @6 in
  let @8 = min(@7, 1u) in
  let @9 = max(@7, 1u) in
  let @10 = @9 - 1u in
  let @0 = a[ramp(0, 1, 8)] in
  let @15 = u64x8(@4) in
  let @11 = mulhi(@15, @0) in
  let @12 = @0 - @11 in
  let @16 = u64x8(@8) in
  let @13 = @12 >> @16 in
  let @14 = @11 + @13 in
  let @17 = u64x8(@10) in
  let @1 = @14 >> @17 in
  out[ramp(0, 1, 8)] = @1
  return
}

func small(a : u32[8], d : u32, out : mut u32[8]) -> void {
  let @4 = div_multiplier(d) in
  let @5 = d - 1u in
  let @6 = clz(@5) in
  let @7 = 32u - @6 in
  let @8 = min(@7, 1u) in
  let @9 = max(@7, 1u) in
  let @10 = @9 - 1u in
  let @0 = a[ramp(0, 1, 8)] in
  let @15 = u32x8(@4) in
  let @11 = mulhi(@15, @0) in
  let @12 = @0 - @11 in
  let @16 = u32x8(@8) in
  let @13 = @12 >> @16 in
  let @14 = @11 + @13 in
  let @17 = u32x8(@10) in
  let @1 = @14 >> @17 in
  out[ramp(0, 1, 8)] = @1
  return
}


schedule host {
    parts.vectorize(i)
    scale.vectorize(i)
    small.vectorize(i)

}
