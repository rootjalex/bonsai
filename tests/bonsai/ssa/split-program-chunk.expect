type Entry_sums = struct Entry_sums{ k : i32; acc : i32; _slot : u32 }
type Queue_sums = struct Queue_sums{ count : u32; k : i32[]; acc : i32[]; _slot : u32[] }

func run(out : mut i32[], n : u32) -> void {
  let @0 = n >> 2u in
  let @1 = max(1u, @0) in
  let @2 = 8u / @1 in
  let @3 = max(1u, @2) in
  let band = @3 << 1u in
  alloc sums_ran : mut u8[band]
  alloc sums_result : mut i32[band]
  alloc sums_k_0 : mut i32[band]
  alloc sums_acc_0 : mut i32[band]
  alloc sums__slot_0 : mut u32[band]
  alloc sums_k_1 : mut i32[band]
  alloc sums_acc_1 : mut i32[band]
  alloc sums__slot_1 : mut u32[band]
  sums_queue : mut Queue_sums[2]
  parfor i_band in [0u:n:band] {
    sums!round : mut u32
    let @9 = n in
    let @8 = band in
    let @12 = fill_bytes(sums_ran, 0u, @8) in
    let @14 = build<Queue_sums>(0u, sums_k_0, sums_acc_0, sums__slot_0) in
    sums_queue[0u] = @14
    let @16 = build<Queue_sums>(0u, sums_k_1, sums_acc_1, sums__slot_1) in
    sums_queue[1u] = @16
    parfor i_in in [0u:@8:1u] {
      let @10 = i_band + i_in in
      let @11 = @10 < @9 in
      if (@11) {
        let i = @10 in
        let @5 = cast<i32>(i) in
        let @19 = walk(@5, 0, (&sums_queue[0u]), (&sums_result[i_in]), i_in) in
        let @20 = out in
        let @21 = @10 in
        let @22 = @19.set in
        let @23 = @19.value in
        if (@22) {
          let @6 = @23 in
          out[i] = @6
          continue
        } else {
          sums_ran[i_in] = 1u
          continue
        }
      } else {
        continue
      }
    }
    sums!round = 0u
    while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
      let @26 = (*sums!round) & 1u in
      let @28 = sums_queue[(*sums!round) & 1u].count in
      let @30 = @26 ^ 1u in
      sums_queue[@30].count = 0u
      parfor sums in [0u:@28:1u] {
        let @31 = (&sums_queue[@30]) in
        let @35 = sums_queue[@26].k in
        let @36 = @35[sums] in
        let @38 = sums_queue[@26].acc in
        let @39 = @38[sums] in
        let @41 = sums_queue[@26]._slot in
        let @42 = @41[sums] in
        walk(@36, @39, @31, (&sums_result[@42]), @42)
        continue
      }
      let @25 = (*sums!round) + 1u in
      sums!round = @25
    }
    parfor sums_rest in [0u:@8:1u] {
      let @49 = sums_result[sums_rest] in
      let @50 = i_band + sums_rest in
      let @52 = sums_ran[sums_rest] in
      switch (@52) {
      case 0: {
        continue
      } break;
      default: {
        let @45 = @49 in
        let @46 = out in
        let @47 = @50 in
        @46[@47] = @45
        continue
      }
      }
    }
    continue
  }
  free(sums_ran)
  free(sums_result)
  free(sums_k_0)
  free(sums_acc_0)
  free(sums__slot_0)
  free(sums_k_1)
  free(sums_acc_1)
  free(sums__slot_1)
  return
}

func walk(k : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : u32) -> _option_sums {
  let @0 = k <= 0 in
  if (@0) {
    _result_sums = acc
    let @4 = build<_option_sums>(acc, true) in
    return @4
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @5 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @6 = build<_option_sums>(undef, false) in
    let @9 = atomic_add((&(*_queue_sums).count), 1u) in
    let @11 = (*_queue_sums).k in
    @11[@9] = @1
    let @14 = (*_queue_sums).acc in
    @14[@9] = @2
    let @17 = (*_queue_sums)._slot in
    @17[@9] = _slot_sums
    return @6
  }
}


schedule {
    sums = run.queue(i_band);
    run.split(i, i_band, i_in, band, 1)
    walk.defer(walk, sums)

}
