type Entry_sums = struct Entry_sums{ k : i32; acc : i32; _slot : u32 }
type Queue_sums = struct Queue_sums{ count : u32; k : i32[]; acc : i32[]; _slot : u32[] }

func run(out : mut i32[], n : u32) -> void {
  let @0 = n >> 2u in
  let @1 = max(1u, @0) in
  let @2 = 8u / @1 in
  let @3 = max(1u, @2) in
  let band = @3 << 1u in
  alloc sums_ran : mut u8[band]
  alloc sums_result : mut i32[band]
  alloc sums_k_0 : mut i32[band]
  alloc sums_acc_0 : mut i32[band]
  alloc sums__slot_0 : mut u32[band]
  alloc sums_k_1 : mut i32[band]
  alloc sums_acc_1 : mut i32[band]
  alloc sums__slot_1 : mut u32[band]
  sums_queue : mut Queue_sums[2]
  parfor i_band in [0u:n:band] {
    sums!round : mut u32
    let @9 = n in
    let @8 = band in
    let @14 = build<Queue_sums>(0u, sums_k_0, sums_acc_0, sums__slot_0) in
    sums_queue[0u] = @14
    let @16 = build<Queue_sums>(0u, sums_k_1, sums_acc_1, sums__slot_1) in
    sums_queue[1u] = @16
    parfor i_in in [0u:@8:1u] {
      let @10 = i_band + i_in in
      let @11 = @10 < @9 in
      sums_ran[i_in] = 0u
      if (@11) {
        let i = @10 in
        let @5 = cast<i32>(i) in
        sums_ran[i_in] = 1u
        walk(@5, 0, (&sums_queue[0u]), (&sums_result[i_in]), i_in)
        continue
      } else {
        continue
      }
    }
    sums!round = 0u
    while (!(sums_queue[(*sums!round) & 1u].count == 0u)) {
      let @21 = (*sums!round) & 1u in
      let @23 = sums_queue[(*sums!round) & 1u].count in
      let @25 = @21 ^ 1u in
      sums_queue[@25].count = 0u
      parfor sums in [0u:@23:1u] {
        let @26 = (&sums_queue[@25]) in
        let @30 = sums_queue[@21].k in
        let @31 = @30[sums] in
        let @33 = sums_queue[@21].acc in
        let @34 = @33[sums] in
        let @36 = sums_queue[@21]._slot in
        let @37 = @36[sums] in
        walk(@31, @34, @26, (&sums_result[@37]), @37)
        continue
      }
      let @20 = (*sums!round) + 1u in
      sums!round = @20
    }
    parfor sums_rest in [0u:@8:1u] {
      let @40 = sums_result[sums_rest] in
      let @41 = i_band + sums_rest in
      let @43 = sums_ran[sums_rest] in
      switch (@43) {
      case 0: {
        continue
      } break;
      default: {
        let @6 = @40 in
        let i = @41 in
        out[i] = @6
        continue
      }
      }
    }
    continue
  }
  free(sums_ran)
  free(sums_result)
  free(sums_k_0)
  free(sums_acc_0)
  free(sums__slot_0)
  free(sums_k_1)
  free(sums_acc_1)
  free(sums__slot_1)
  return
}

func walk(k : i32, acc : i32, _queue_sums : mut (Queue_sums*), _result_sums : mut (i32*), _slot_sums : u32) -> void {
  let @0 = k <= 0 in
  if (@0) {
    _result_sums = acc
    return
  } else {
    let @1 = k - 1 in
    let @2 = acc + k in
    let @4 = build<Entry_sums>(@1, @2, _slot_sums) in
    let @7 = atomic_add((&(*_queue_sums).count), 1u) in
    let @9 = (*_queue_sums).k in
    @9[@7] = @1
    let @12 = (*_queue_sums).acc in
    @12[@7] = @2
    let @15 = (*_queue_sums)._slot in
    @15[@7] = _slot_sums
    return
  }
}


schedule host {
    sums = run.queue(i_band);
    run.split(i, i_band, i_in, band, 1)
    walk.defer(walk, sums)

}
