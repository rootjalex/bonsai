//! flags: -p ssa

// A spawned call deferred: `spawn shade(x, total);` says the call may run
// beside the rest of `step` and reports through the reducer it is handed,
// so `step.defer(shade, q)` may push the call and go on -- the site becomes
// a push and a jump to its continuation, `step` returns what it returned,
// and the drain makes the call, which adds into `total` through the
// address its entry holds (SSA/Defer.cpp, Terminator::Spawn). pbrt's shadow
// ray: traced by its own kernel, added to the pixel's L when it is.
import stdlib/numerics;

func shade(x : Float, total : reduce(+) Float) -> void {
    total += x * 2.0;
    return;
}

func step(x : Float, total : reduce(+) Float) -> void {
    spawn shade(x, total);
    total += x;
    return;
}

func run(values : array[Float, 8], total : reduce(+) Float) -> void {
    parfor i in 0:8 {
        step(values[i], total);
    }
    return;
}

schedule {
    q = run.queue(root);
    step.defer(shade, q);
}
