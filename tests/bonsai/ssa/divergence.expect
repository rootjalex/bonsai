func combine(x : f32, y : f32) -> f32 {
  return x + y
}

func contiguous(a : f32[8], out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    out[i] = a[i] + 1f
  }
  return
}

func divergent_branch(a : f32[8], out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    if (a[i] < 0f) {
      out[i] = 0f
    } else {
      out[i] = a[i]
    }
  }
  return
}

func promoted_local(a : f32[8], seed : f32, out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    x : mut f32 := seed
    if (a[i] < 0f) {
      x = 1f
    } else {
      x = 2f
    }
    out[i] = (*x)
  }
  return
}

func promoted_uniform(a : f32[8], seed : f32, out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    y : mut f32 := seed
    y *= 2f
    out[i] = a[i] + (*y)
  }
  return
}

func uniform_branch(a : f32[8], flag : f32, out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    if (flag < 0f) {
      out[i] = 0f
    } else {
      out[i] = a[i]
    }
  }
  return
}

func uniform_operand(a : f32[8], scale : f32, out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    out[i] = a[i] * scale
  }
  return
}

func varying_call(a : f32[8], b : f32[8], out : mut f32[8]) -> void {
  parfor i in [0:8:1] {
    out[i] = combine(a[i], b[i])
  }
  return
}


