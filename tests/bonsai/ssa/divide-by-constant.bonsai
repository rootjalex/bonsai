//! flags: -p ssa

// Golden for division by a constant (see SSA/InvariantDivision.h): the
// multiplier computed at compile time, and the shortest sequence for each
// kind of constant.
//
// What to read for in the golden:
//
//   * `by_seven`: unsigned by 7, whose multiplier does not fit 32 bits, so
//     the round-up form -- `mulhi`, then `((n - t) >> 1) + t`, then a shift
//     by 2. `by_ten`: unsigned by 10, whose multiplier 0xcccccccd fits, so
//     one `mulhi` and a shift by 3. `by_eight`: a shift by 3, and the
//     remainder an `and` with 7.
//   * `signed_seven`: `mulhi` by 0x92492493 (negative as a signed word), so
//     n is added, then a shift by 2, then the sign bit added back to
//     truncate toward zero. `signed_minus_eight`: the power-of-two form with
//     the bias for negative n, negated.
//   * `by_one` and `signed_minus_one` are a copy and a negation; no
//     multiply and no shift.
//   * `wide`: a 64-bit divisor, which LLVM would have left as a division
//     in a vector of lanes; here a `mulhi` on u64.
//   * `rotate` and `next_axis` divide a dividend that is known to stay
//     below twice the divisor -- pbrt's `(axis + 1) % 3` -- by one
//     comparison: `select(n < 3, n, n - 3)`, and no multiply. `small` is
//     known to stay below the divisor altogether: the remainder is the
//     dividend and the quotient is zero. `axes` chains two such rotations
//     from an `idxmax`, which names one of three lanes; both are selects.
//   * No `/` or `%` on an integer survives anywhere.

func by_seven(n : u32) -> u32 = n / 7u;
func rem_seven(n : u32) -> u32 = n % 7u;
func by_ten(n : u32) -> u32 = n / 10u;
func by_eight(n : u32) -> u32 = n / 8u;
func rem_eight(n : u32) -> u32 = n % 8u;
func by_one(n : u32) -> u32 = n / 1u;

func signed_seven(n : i32) -> i32 = n / 7;
func signed_rem_seven(n : i32) -> i32 = n % 7;
func signed_minus_eight(n : i32) -> i32 = n / -8;
func signed_minus_one(n : i32) -> i32 = n / -1;

func wide(n : u64) -> u64 = n / 10u;

func rotate(k : u32) -> u32 = ((k & 3u) + 1u) % 3u;
func next_axis(z : f32, y : f32) -> i32 {
    kz = select(z > y, 2, select(y > 0.0, 1, 0));
    return (kz + 1) % 3;
}
func small(k : u32) -> u32 = (k & 3u) / 5u;
func small_rem(k : u32) -> u32 = (k & 3u) % 5u;

// pbrt's watertight triangle test permutes the axes from the largest
// component of the direction: `idxmax` names one of three lanes, and each
// rotation is one comparison, the second seeing through the first.
func axes(d : vector[f32, 3]) -> u32 {
    kz : u32 = idxmax(abs(d));
    kx = (kz + 1u) % 3u;
    ky = (kx + 1u) % 3u;
    return kx * 3u + ky;
}
