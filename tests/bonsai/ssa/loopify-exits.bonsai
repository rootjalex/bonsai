//! flags: -p ssa

// The exits of a loopified recursion whose code is the same code, made one
// (merge_exits in SSA/Rewrite.cpp). `step` has three ways out besides its
// tail call: out of steps and past half the limit both `return finish(...)`,
// past the limit returns a constant. `finish` is copied in at both of its
// calls before the schedule runs, so the two exits are two copies of the same
// code, as a walk's two `return terminal(...)` are.
//
// What to read for: ONE copy of `finish`'s arithmetic in `step`, entered
// from both of its exits with that exit's values (the printer shows the one
// block with two ways in once at the end of the body and once after the
// loop), and the `return 0f` where the program wrote it -- no block after
// the loop that every exit jumps to, no `which`, no `reconverge()`, no
// `switch`: an exit whose code is its own stays its own way out. `twice`
// has nothing but the two `finish` exits, made one the same way. `shared`
// has two exits of different shapes, `finish(x, i)` and `scale(x, y, k)`,
// and `pick` two, `return x` and `return halve(t)`, `t` a local of the body
// written by the held `put`: nothing is the same code, so both loops are
// left as loopify made them, each return in place. (From 2026-10-27 to
// 10-28 every exit was redirected to one block after the loop that carried
// a tag and the exits' values, reconverged and dispatched; merge_exits
// says what that cost and why it is gone.)
func finish(x : f32, n : i32) -> f32 {
    return x * 0.5 + cast[[f32]](n);
}

func [[noinline]] put(out : mut f32, v : f32) -> void {
    out = v;
    return;
}

func [[noinline]] halve(v : mut f32) -> f32 {
    v = v * 0.5;
    return v;
}

func pick(i : i32, x : f32) -> f32 {
    if i <= 0 {
        return x;
    }
    y = x * 1.5;
    t : mut f32 = 0.0;
    put(t, y);
    if y > 50.0 {
        return halve(t);
    }
    return pick(i - 1, y);
}

func scale(a : f32, b : f32, k : i32) -> f32 {
    return (a + b) * cast[[f32]](k);
}

func shared(i : i32, x : f32, k : i32) -> f32 {
    if i <= 0 {
        return finish(x, i);
    }
    y = x * 1.5;
    if y > 50.0 {
        return scale(x, y, k);
    }
    return shared(i - 1, y, k);
}

func step(i : i32, x : f32, limit : f32) -> f32 {
    if i <= 0 {
        return finish(x, i);
    }
    y = x * 1.5;
    if y > limit {
        return 0.0;
    }
    if y > limit * 0.5 {
        return finish(y, i);
    }
    return step(i - 1, y, limit);
}

func twice(i : i32, x : f32) -> f32 {
    if i <= 0 {
        return finish(x, i);
    }
    y = x * 1.5;
    if y > 100.0 {
        return finish(y, i);
    }
    return twice(i - 1, y);
}

func main() -> i32 {
    print(step(3, 1.0, 100.0));
    print(step(5, 1.0, 4.0));
    print(step(5, 10.0, 4.0));
    print(twice(3, 1.0));
    print(twice(5, 60.0));
    print(shared(3, 1.0, 2));
    print(shared(4, 20.0, 3));
    print(pick(3, 1.0));
    print(pick(4, 20.0));
    return 0;
}

schedule {
    step.loopify();
    twice.loopify();
    shared.loopify();
    pick.loopify();
}
