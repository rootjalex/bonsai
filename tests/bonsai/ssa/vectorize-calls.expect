func both_ways(a : f32[8], k : f32, out : mut f32[8]) -> void {
  let _t0 = a[ramp(0, 1, 8)] in
  let @8 = f32x8(k) in
  let @1 = _t0 * @8 in
  out[ramp(0, 1, 8)] = @1
  let @9 = f32x8(0f) in
  let @3 = @9 < _t0 in
  let @10 = boolx8(false) in
  let @11 = boolx8(true) in
  let @6 = select(@3, @10, @11) in
  let @12 = f32x8(100f) in
  let @4 = _t0 * @12 in
  masked_store(out[ramp(0, 1, 8)], @4, @3)
  return
}

func chained(a : f32[8], out : mut f32[8]) -> void {
  let @0 = a[ramp(0, 1, 8)] in
  let @1 = inner$gang8_v0(@0) in
  let i = ramp(0, 1, 8) in
  let @5 = f32x8(2f) in
  let @2 = @1 * @5 in
  out[ramp(0, 1, 8)] = @2
  return
}

func [[noinline]] clip(x : f32, lo : f32) -> f32 {
  let @0 = x < lo in
  if (@0) {
    return lo
  } else {
    return x
  }
}

func [[noinline]] clip$gang8_v0(x : f32x8, lo : f32) -> f32x8 {
  let @3 = f32x8(lo) in
  let @0 = x < @3 in
  let @4 = boolx8(false) in
  let @5 = boolx8(true) in
  let @1 = select(@0, @4, @5) in
  let @6 = f32x8(lo) in
  let @2 = select(@1, x, @6) in
  return @2
}

func clip_all(a : f32[8], lo : f32, out : mut f32[8]) -> void {
  let @0 = a[ramp(0, 1, 8)] in
  let @1 = clip$gang8_v0(@0, lo) in
  let i = ramp(0, 1, 8) in
  out[ramp(0, 1, 8)] = @1
  return
}

func constant_of(k : f32) -> f32 {
  let @0 = k * 2f in
  return @0
}

func [[noinline]] inner(x : f32) -> f32 {
  let @0 = x + 1f in
  return @0
}

func [[noinline]] inner$gang8_v0(x : f32x8) -> f32x8 {
  let @1 = f32x8(1f) in
  let @0 = x + @1 in
  return @0
}

func outer(x : f32) -> f32 {
  let @0 = inner(x) in
  let @1 = @0 * 2f in
  return @1
}

func scale(x : f32, k : f32) -> f32 {
  let @0 = x * k in
  return @0
}

func uniform_arg(k : f32, out : mut f32[8]) -> void {
  let @0 = k * 2f in
  let @3 = f32x8(@0) in
  out[ramp(0, 1, 8)] = @3
  return
}


schedule host {
    both_ways.vectorize(i)
    chained.vectorize(i)
    clip_all.vectorize(i)
    uniform_arg.vectorize(i)

}
