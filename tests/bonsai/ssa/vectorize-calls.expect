func both_ways(a : f32[8], k : f32, out : mut f32[8]) -> void {
  let @0 = a[ramp(0, 1, 8)] in
  let @1 = scale$gang8_v0(@0, k) in
  out[ramp(0, 1, 8)] = @1
  let @3 = a[ramp(0, 1, 8)] in
  let @10 = f32x8(0f) in
  let @4 = @10 < @3 in
  let @11 = boolx8(false) in
  let @12 = boolx8(true) in
  let @8 = select(@4, @11, @12) in
  let @5 = a[ramp(0, 1, 8)] in
  let @6 = scale$gang8_v0$masked(@5, 100f, @4) in
  masked_store(out[ramp(0, 1, 8)], @6, @4)
  return
}

func clip(x : f32, lo : f32) -> f32 {
  let @0 = x < lo in
  if (@0) {
    return lo
  } else {
    return x
  }
}

func clip$gang8_v0(x : f32x8, lo : f32) -> f32x8 {
  let @3 = f32x8(lo) in
  let @0 = x < @3 in
  let @4 = boolx8(false) in
  let @5 = boolx8(true) in
  let @1 = select(@0, @4, @5) in
  let @6 = f32x8(lo) in
  let @2 = select(@1, x, @6) in
  return @2
}

func clip_all(a : f32[8], lo : f32, out : mut f32[8]) -> void {
  let @0 = a[ramp(0, 1, 8)] in
  let @1 = clip$gang8_v0(@0, lo) in
  out[ramp(0, 1, 8)] = @1
  return
}

func constant_of(k : f32) -> f32 {
  let @0 = k * 2f in
  return @0
}

func scale(x : f32, k : f32) -> f32 {
  let @0 = x * k in
  return @0
}

func scale$gang8_v0(x : f32x8, k : f32) -> f32x8 {
  let @1 = f32x8(k) in
  let @0 = x * @1 in
  return @0
}

func scale$gang8_v0$masked(x : f32x8, k : f32, !mask : boolx8) -> f32x8 {
  let @1 = f32x8(k) in
  let @0 = x * @1 in
  return @0
}

func uniform_arg(k : f32, out : mut f32[8]) -> void {
  let @0 = constant_of(k) in
  let @3 = f32x8(@0) in
  out[ramp(0, 1, 8)] = @3
  return
}


schedule host {
    both_ways.vectorize(i)
    clip_all.vectorize(i)
    uniform_arg.vectorize(i)

}
