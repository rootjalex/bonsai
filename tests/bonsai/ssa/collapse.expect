func grid(out : mut i32[12]) -> void {
  parfor c in [0:12:1] {
    let @7 = c >> 31 in
    let @8 = reinterpret_cast<u32>(@7) in
    let @9 = @8 >> 30u in
    let @10 = reinterpret_cast<i32>(@9) in
    let @11 = c + @10 in
    let @5 = @11 >> 2 in
    let @18 = @5 * 4 in
    let @6 = c - @18 in
    let y = @5 in
    let x = @6 in
    let @0 = y * 100 in
    let @1 = @0 + x in
    let @2 = y << 2 in
    let @3 = @2 + x in
    out[@3] = @1
    continue
  }
  return
}


schedule {
    grid.collapse(y, x, c)

}
