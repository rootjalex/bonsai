type AABB = struct AABB{ low : f32x3; high : f32x3 }
type Blob = struct Blob{ xform : struct Transform{ m0 : f32x3; m1 : f32x3; m2 : f32x3; m3 : f32x3 }; low : f32x3; high : f32x3 }
type Float = f32
type Half = f16
type Transform = struct Transform{ m0 : f32x3; m1 : f32x3; m2 : f32x3; m3 : f32x3 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func apply(t : Transform, p : f32x3) -> f32x3 {
  return (((t.m0 * f32x3(p[0u])) + (t.m1 * f32x3(p[1u]))) + (t.m2 * f32x3(p[2u]))) + t.m3
}

func main() -> i32 {
  return 0
}


