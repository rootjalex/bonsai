

func bar(i : i32x8) -> u32x8 {
  if ((i32)0 < reduce<+>(i)) {
    let j = foo(i) in
  } else {
    print(i)
  }
  return abs(i)
}

func foo(i : i32x8) -> u32x8 {
  if (!((i32)0 < reduce<+>(i))) {
    print(i)
  }
  return abs(i)
}

func main() -> i32 {
  let i = x8((i32)-1) in
  return cast<i32>(reduce<+>(bar(i)))
}


