func _lambda0(x : i32) -> i32 {
  return x + 1
}

func _lambda1(x : i32) -> i32 {
  return x - 1
}

func foo() -> i32 {
  let L1 = |x : i32| x + 1 in
  let y = _lambda0(0) in
  return y
}

func main() -> i32 {
  let L1 = |x : i32| x - 1 in
  let y = _lambda1(0) in
  return y
}

func relu(v : set<i32>) -> set<i32> {
  return filter(|x : i32| 0 < x, v)
}


