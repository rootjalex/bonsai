//! flags: -p canonicalize -p verify-layouts -p lower-trees

element Float = f32;
element vec3f = vector[Float, 3];

element Ray {
    o : vec3f;
    d : vec3f;
    t : Float = 0;
    // TODO: medium
    // TODO: differential?
}

element Triangle {
    p0, p1, p2 : vec3f;
}

element AABB {
    low, high : vec3f;
}

extern triangles1 : set[Triangle];
extern triangles2 : set[Triangle];

func trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles1));
func alltrace(ray : Ray) = filter(|tri| intersects(ray, tri), triangles1);
func collisions() = filter(|t0 : Triangle, t1 : Triangle| intersects(t0, t1), product(triangles1, triangles2));

schedule {
    // TODO: generic over primitive types!
    tree[[Triangle]] TriangleBVH(low high : vec3f) with AABB(low, high)
    = Interior(left : TriangleBVH, right : TriangleBVH)
    | Leaf(data : Triangle);

    triangles1 : TriangleBVH;
    triangles2 : TriangleBVH;
}
