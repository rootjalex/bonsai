//! flags: -p canonicalize -p lower-trees -p lower-sorts -p lower-geometrics -p lower-externs -p lower-layouts -p lower-foreachs -p lower-element-references -p lower-tiled-arrays

// Embree's tree, byte for byte: a node row of the children's references and
// their bounds as six component vectors, and leaves of Triangle4 tiles.
//
// Two of Scion's layout constructs make the bytes come out as Embree's
// (Gyurgyik, Root and Kjolstad, "Decoupling Data Layouts from Bounding Volume
// Hierarchies", PLDI 2026).
//
// Derived fields. Embree's AABBNode stores lower_x, upper_x, lower_y, upper_y,
// lower_z, upper_z, each a vector of N floats, in that order. The tree speaks
// of `lo` and `hi`, each a vector of N boxes' corners. The layout stores the
// six as Embree does and *derives* the two from them -- `lo = vector[vec3f,
// 4]{lower_x, lower_y, lower_z}`, a vector of vectors built from its
// components -- which costs nothing: a vector of vectors is a struct of its
// component vectors in the generated code, so the build is the three loads
// put side by side.
//
// Tiles. Embree's Triangle4 is four triangles with every field a vector over
// the four: v0.x[4], v0.y[4], v0.z[4], e1..., e2..., geomID[4], primID[4],
// 176 bytes. That is Scion's array-of-structs-of-arrays, a group nested in a
// group with the inner one the tile; here `indirect group prims[pCount] {
// group[4] { ...the element's fields... }; }`, a group of the set's elements
// (ir::Group::element) whose rows are four to a tile. A leaf's `data` ranges
// over the elements as over any array, and Lower/TiledArrays.cpp spells each
// element read as the tile's: element k is lane k % 4 of tile k / 4, one
// lane out of each field vector, assembled into the triangle.
//
// What to read for in the golden. The storage: `group0_prims` an array of
// tiles, each `v0 : vector[vec3f, 4]` (packed, by component), ..., `geomID :
// vector[u32, 4]`; `group1_row` an array of 256-byte rows with the six
// component vectors after the children. The interior arm's `lo` is
// `build<vector[vec3f, 4]>(lower_x, lower_y, lower_z)` over the row's
// fields. The leaf's loop is a loop over its tiles with a parfor over the
// four lanes of each inside, named `data` for the arm's field
// (Lower/ForEachs.cpp; the range begins and ends on a tile, being spelled
// `(ref >> 4) * 4u` and `(kind - 8u) * 4u`): the body reads
// `group0_prims[(ref >> 4u) + tile]` and takes lane `data` of each of its
// vectors into a `build<Triangle>`, with no division or remainder, the
// tile and the lane read off the index as spelled (Lower/TiledArrays.cpp).
// And the argmin's update is an accumulate, `_best0 argmin= (t, ref)`.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        // Slots, four to a tile; a leaf's tiles are padded with slots whose
        // ids are -1, as Embree pads its own.
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                p0 : vec3f;
                p1 : vec3f;
                p2 : vec3f;
            };
        };
        nCount : u32;
        // Embree's AABBNode<4>: the children, then the bounds by component
        // in Embree's order; the tree's `lo` and `hi` derived from them.
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        // Embree's NodeRef: the low four bits say what it names, 0 a node at
        // row `ref >> 4`, 8 + n a leaf of n tiles from tile `ref >> 4`.
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };
}
