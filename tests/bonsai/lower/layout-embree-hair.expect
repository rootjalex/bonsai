type AABB = struct AABB{ low : f32x3; high : f32x3 }
type BVH = (const BVH&)
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type f32x3x4 = f32x3x4
type f32x9 = f32x9
type tl0 = [[packed]] struct tl0{ low : f32x3x4; high : f32x3x4; children : u64x4 }
type tl1 = [[packed]] struct tl1{  }
type tl2 = [[packed]] struct tl2{  }
type tl3 = [[packed]] struct tl3{  }
type tl4 = [[packed]] struct tl4{ primitive_count : u64; primitives : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[primitive_count]; indirect_group_AABBs0 : [[packed]] struct tl0{ low : f32x3x4; high : f32x3x4; children : u64x4 }[]; group_1 : [[packed]] struct tl3{  }[] }
type u64x4 = u64x4
type vec3f = f32x3
type vec3h = f16x3

extern triangles : [[packed]] struct tl4{ primitive_count : u64; primitives : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[primitive_count]; indirect_group_AABBs0 : [[packed]] struct tl0{ low : f32x3x4; high : f32x3x4; children : u64x4 }[]; group_1 : [[packed]] struct tl3{  }[] }

func _traverse_tree0(ray : Ray, triangles : tl4) -> set<Triangle> {
  rec(index : u64) {
    if (index[0:2] == 2u) {
      if (intersects(ray, build<AABB>(triangles.indirect_group_AABBs0[index[4:63]].low[0], triangles.indirect_group_AABBs0[index[4:63]].high[0]))) {
        from (triangles.indirect_group_AABBs0[index[4:63]].children[0u])
      }
      if (intersects(ray, build<AABB>(triangles.indirect_group_AABBs0[index[4:63]].low[1], triangles.indirect_group_AABBs0[index[4:63]].high[1]))) {
        from (triangles.indirect_group_AABBs0[index[4:63]].children[1u])
      }
      if (intersects(ray, build<AABB>(triangles.indirect_group_AABBs0[index[4:63]].low[2], triangles.indirect_group_AABBs0[index[4:63]].high[2]))) {
        from (triangles.indirect_group_AABBs0[index[4:63]].children[2u])
      }
      if (intersects(ray, build<AABB>(triangles.indirect_group_AABBs0[index[4:63]].low[3], triangles.indirect_group_AABBs0[index[4:63]].high[3]))) {
        from (triangles.indirect_group_AABBs0[index[4:63]].children[3u])
      }
    } else {
      foreach _iter0 in triangles.primitives[index[4:63]:index[4:63] + cast<u64>(cast<u8>(index[1:4] + 1u))] {
        if (intersects(ray, _iter0)) {
          yield _iter0
        }
      }
    }
  }
}

func distmax_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_Point_AABB(pt : Point, a : AABB) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Triangle(p : Point, tri : Triangle) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm(p.vec - pts[0].vec)
}

func distmin_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return (f32)inf
  }
}

func intersects_Ray_AABB(r : Ray, b : AABB) -> bool {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < r.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Sphere(ray : Ray, s : Sphere) -> bool {
  let interval = intersectsp_ray_sphere(ray, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < ray.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Triangle(ray : Ray, tri : Triangle) -> bool {
  return cast<bool>(intersectsp_ray_tri(ray, tri))
}

func [[export]] trace(ray : Ray) -> set<Triangle> {
  return _traverse_tree0(ray, triangles)
}


