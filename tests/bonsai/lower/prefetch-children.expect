  if (_best0[0] != (f32)inf) {
    _best0_result = build<option<Triangle>>(build<Triangle>(cast<f32x3x4>(tris.group0_prims[_best0[1][0] / 4u].p0)[_best0[1][0] % 4u], cast<f32x3x4>(tris.group0_prims[_best0[1][0] / 4u].p1)[_best0[1][0] % 4u], cast<f32x3x4>(tris.group0_prims[_best0[1][0] / 4u].p2)[_best0[1][0] % 4u]))
  }
  yield _best0_result
}

func [[export]] trace(r : Ray, tris : _tree_layout0) -> option<Triangle> {
  return _traverse_tree0(r, tris)
}


schedule host {
    tris : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    trace.sort(tris.Interior, |i : u32, r : struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }, lo : f32x3x4, hi : f32x3x4| distmin(r, build<struct AABB{ low : f32x3; high : f32x3 }>(lo[i], hi[i])))
         .prefetch(tris.Interior.children)

}
