extern tris : [[packed]] struct _tree_layout0{ pCount : u32; group0_prims : [[packed]] struct _tree_layout1{ p0 : [[packed]] f32x3x4; p1 : [[packed]] f32x3x4; p2 : [[packed]] f32x3x4 }[(pCount + (u32)3) / (u32)4]; nCount : u32; group1_row : [[packed]] struct _tree_layout2{ children : [[packed]] u32x4; lower_x : [[packed]] f32x4; upper_x : [[packed]] f32x4; lower_y : [[packed]] f32x4; upper_y : [[packed]] f32x4; lower_z : [[packed]] f32x4; upper_z : [[packed]] f32x4 }[nCount] }

func _traverse_tree0(r : Ray, tris : _tree_layout0) -> option<Triangle> {
  _best0 : mut (f32, (u32)) := ((f32)inf, ())
  rec(tris_ref : u32 = 0u, _bound0 : f32 = -(f32)inf) {
    if (_bound0 < _best0[0]) {
      if ((tris_ref & 15u) == 0u) {
        _mask0 : mut bool[4]
        _carry0 : mut f32[4]
        _keys0 : mut f32[4]
        parfor children in [0u:4u:1u] {
          _mask0[children] = intersects_Ray_AABB(r, build<AABB>(build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_z))[children], build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_z))[children])) && (distmin_Ray_AABB(r, build<AABB>(build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_z))[children], build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_z))[children])) < _best0[0])
          _carry0[children] = distmin_Ray_AABB(r, build<AABB>(build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_z))[children], build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_z))[children]))
          _keys0[children] = distmin_Ray_AABB(r, build<AABB>(build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].lower_z))[children], build<f32x3x4>(cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_x), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_y), cast<f32x4>(tris.group1_row[tris_ref >> 4u].upper_z))[children]))
          if (_mask0[children]) {
            if ((cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[children] & 15u) == 0u) {
              let _prefetch_row0 = prefetch((&tris.group1_row[cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[children] >> 4u]), 144u) in
            } else {
              let _prefetch_row1 = prefetch((&tris.group0_prims[((cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[children] >> 4u) << 2u) / 4u]), 144u) in
            }
          }
        }
        from ((cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[0u], _carry0[0u]), (cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[1u], _carry0[1u]), (cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[2u], _carry0[2u]), (cast<u32x4>(tris.group1_row[tris_ref >> 4u].children)[3u], _carry0[3u])) sorted by (_keys0[0u], _keys0[1u], _keys0[2u], _keys0[3u]) where (_mask0[0u], _mask0[1u], _mask0[2u], _mask0[3u])
      } else {
        forall _idx1 in [0u:(tris_ref & 15u) - 8u:1u] {
          parfor data in [0u:4u:1u] {
            if (intersects_Ray_Triangle(r, build<Triangle>(cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p0)[data], cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p1)[data], cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p2)[data])) && (distmin_Ray_Triangle(r, build<Triangle>(cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p0)[data], cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p1)[data], cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p2)[data])) < _best0[0])) {
              _best0 argmin= (distmin_Ray_Triangle(r, build<Triangle>(cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p0)[data], cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p1)[data], cast<f32x3x4>(tris.group0_prims[(tris_ref >> 4u) + _idx1].p2)[data])), ((((tris_ref >> 4u) + _idx1) * 4u) + data))
