func ?traverse_array0(ijk : i32[4096]) -> i32[4096] {
  alloc ?alloc0 : i32[4096]
  forall i in [(i32)0:(i32)8:(i32)1] {
    forall j in [(i32)0:(i32)16:(i32)1] {
      forall k in [(i32)0:(i32)32:(i32)1] {
        let ?load0 = ijk[(((i * (idx)16) + j) * (idx)32) + k] in
        ?alloc0[(((build<idxx3>(i, j, k)[(i32)0] * (idx)16) + build<idxx3>(i, j, k)[(i32)1]) * (idx)32) + build<idxx3>(i, j, k)[(i32)2]] = ?load0 + (i32)1
      }
    }
  }
  return ?alloc0
}

func ?traverse_array1(ij : i32[8]) -> i32[8] {
  alloc ?alloc1 : i32[8]
  forall i in [(i32)0:(i32)2:(i32)1] {
    forall j in [(i32)0:(i32)4:(i32)1] {
      let ?load1 = ij[(i * (idx)4) + j] in
      ?alloc1[(build<idxx2>(i, j)[(i32)0] * (idx)4) + build<idxx2>(i, j)[(i32)1]] = ?load1
    }
  }
  return ?alloc1
}

func d3(ijk : i32[4096]) -> i32[4096] {
  return ?traverse_array0(ijk)
}

func id(ij : i32[8]) -> i32[8] {
  return ?traverse_array1(ij)
}

func main() -> i32 {
  let v0 = build<i32[4]>((i32)1, (i32)2, (i32)3, (i32)4) in
  let v1 = build<i32[4]>((i32)5, (i32)6, (i32)7, (i32)8) in
  let xs = build<i32[8]>(v0[(idx)0], v0[(idx)1], v0[(idx)2], v0[(idx)3], v1[(idx)0], v1[(idx)1], v1[(idx)2], v1[(idx)3]) in
  let ys = id(xs) in
  return (i32)0
}


