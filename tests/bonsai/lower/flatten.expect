func ?traverse_array0(ij : i32[32]) -> i32[32] {
  alloc ?alloc0 : i32[32]
  forall i in [(i32)0:(i32)8:(i32)1] {
    forall j in [(i32)0:(i32)4:(i32)1] {
      let ?load0 = ij[(i * (idx)4) + j] in
      ?alloc0[(build<idxx2>(i, j)[(i32)0] * (idx)4) + build<idxx2>(i, j)[(i32)1]] = ?load0
    }
  }
  return ?alloc0
}

func id(ij : i32[32]) -> i32[32] {
  return ?traverse_array0(ij)
}


