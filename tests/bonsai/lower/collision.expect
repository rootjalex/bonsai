    let amin$i21 = min(min(PA0$i21, PA1$i21), PA2$i21) in
    let amax$i21 = max(max(PA0$i21, PA1$i21), PA2$i21) in
    let PB0$i21 = dot(_t153, E22) in
    let PB1$i21 = dot(_t152, E22) in
    let PB2$i21 = dot(_t154, E22) in
    let bmin$i21 = min(min(PB0$i21, PB1$i21), PB2$i21) in
    let bmax$i21 = max(max(PB0$i21, PB1$i21), PB2$i21) in
    tri_tri_axis$r21 = !((amax$i21 < bmin$i21) | (bmax$i21 < amin$i21))
  }
  if (!(*tri_tri_axis$r21)) {
