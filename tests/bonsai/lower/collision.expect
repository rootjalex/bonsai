  let P0 = dot(v0, A) in
  let P1 = dot(v1, A) in
  let P2 = dot(v2, A) in
  let Pmin = min(min(P0, P1), P2) in
  let Pmax = max(max(P0, P1), P2) in
  return (-R <= Pmax) & (Pmin <= R)
}

