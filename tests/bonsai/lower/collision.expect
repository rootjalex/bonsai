    let amin$i21 = min(min(PA0$i21, PA1$i21), PA2$i21) in
    let amax$i21 = max(max(PA0$i21, PA1$i21), PA2$i21) in
    let PB0$i21 = dot(_t173, E22) in
    let PB1$i21 = dot(_t172, E22) in
    let PB2$i21 = dot(_t175, E22) in
