}

func axis(A : f32x3, extents : f32x3, v0 : f32x3, v1 : f32x3, v2 : f32x3) -> bool {
  let R = dot(extents, abs(A)) in
  let P0 = dot(v0, A) in
  let P1 = dot(v1, A) in
  let P2 = dot(v2, A) in
  let Pmin = min(min(P0, P1), P2) in
  let Pmax = max(max(P0, P1), P2) in
  return (-R <= Pmax) & (Pmin <= R)
}

