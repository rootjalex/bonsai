func intersects_AABB_AABB(a : (AABB*), b : (AABB*)) -> bool {
  let low = max((*a).low, (*b).low) in
  let high = min((*a).high, (*b).high) in
  return reduce<all>(low <= high)
}

func intersects_Triangle_Triangle(a : (Triangle*), b : (Triangle*)) -> bool {
  let p1 = (*a).p0 in
  let p2 = (*a).p1 in
  let p3 = (*a).p2 in
  let q1 = (*b).p0 in
  let q2 = (*b).p1 in
  let q3 = (*b).p2 in
  let e1 = p2 - p1 in
  let e2 = p3 - p2 in
  let e3 = p1 - p3 in
  let f1 = q2 - q1 in
  let f2 = q3 - q2 in
  let f3 = q1 - q3 in
  let n1 = cross(e1, e2) in
  if (!project6(n1, p1, p2, p3, q1, q2, q3)) {
    return false
  }
  let m1 = cross(f1, f2) in
  if (!project6(m1, p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e1, f1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e1, f2), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e1, f3), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e2, f1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e2, f2), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e2, f3), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e3, f1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e3, f2), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e3, f3), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e1, n1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e2, n1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(e3, n1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(f1, m1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(f2, m1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  if (!project6(cross(f3, m1), p1, p2, p3, q1, q2, q3)) {
    return false
  }
  return true
}

func project6(ax : f32x3, p1 : f32x3, p2 : f32x3, p3 : f32x3, q1 : f32x3, q2 : f32x3, q3 : f32x3) -> bool {
  let P1 = dot(ax, p1) in
  let P2 = dot(ax, p2) in
  let P3 = dot(ax, p3) in
  let Q1 = dot(ax, q1) in
  let Q2 = dot(ax, q2) in
  let Q3 = dot(ax, q3) in
  let mn1 = min(min(P1, P2), P3) in
  let mx2 = max(max(Q1, Q2), Q3) in
  if (mx2 < mn1) {
    return false
  }
  let mx1 = max(max(P1, P2), P3) in
  let mn2 = min(min(Q1, Q2), Q3) in
  if (mx1 < mn2) {
    return false
  }
  return true
}

func rec_build_triangles1(node : (const BVH&), ST : mut (triangles1*), nodes1_index : mut (idx*), primitives_index : mut (idx*)) -> u32 {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high) ->
    let this_index = (*nodes1_index) in
    nodes1_index += 1
    ST.nodes1[this_index].low = node.low
    ST.nodes1[this_index].high = node.high
    ST.nodes1[this_index].nprims = 0
    ST.nodes1[this_index].axis = argmax(node.high - node.low)
    let left_index = rec_build_triangles1(node.left, ST, nodes1_index, primitives_index) in
    let right_index = rec_build_triangles1(node.right, ST, nodes1_index, primitives_index) in
    reinterpret_cast<(arm_Interior*)>(ST.nodes1[this_index].split0on_nprims).offset = right_index - this_index
    return this_index
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high) ->
    let this_index = (*nodes1_index) in
    nodes1_index += 1
    ST.nodes1[this_index].low = node.low
    ST.nodes1[this_index].high = node.high
    ST.nodes1[this_index].nprims = node.nprims
    ST.nodes1[this_index].axis = argmax(node.high - node.low)
    reinterpret_cast<(arm_Leaf*)>(ST.nodes1[this_index].split0on_nprims).poffset = (*primitives_index)
    forall __p in [0u:node.nprims:1u] {
      ST.primitives[(__p + (*primitives_index))] = node.data[__p]
    }
    primitives_index += node.nprims
    return this_index
  }
}

func rec_build_triangles2(node : (const BVH&), ST : mut (triangles2*), nodes2_index : mut (idx*), primitives_index : mut (idx*)) -> u32 {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high) ->
    let this_index = (*nodes2_index) in
    nodes2_index += 1
    ST.nodes2[this_index].low = node.low
    ST.nodes2[this_index].high = node.high
    ST.nodes2[this_index].nprims = 0
    ST.nodes2[this_index].axis = argmax(node.high - node.low)
    let left_index = rec_build_triangles2(node.left, ST, nodes2_index, primitives_index) in
    let right_index = rec_build_triangles2(node.right, ST, nodes2_index, primitives_index) in
    reinterpret_cast<(arm_Interior*)>(ST.nodes2[this_index].split0on_nprims).offset = right_index - this_index
    return this_index
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high) ->
    let this_index = (*nodes2_index) in
    nodes2_index += 1
    ST.nodes2[this_index].low = node.low
    ST.nodes2[this_index].high = node.high
    ST.nodes2[this_index].nprims = node.nprims
    ST.nodes2[this_index].axis = argmax(node.high - node.low)
    reinterpret_cast<(arm_Leaf*)>(ST.nodes2[this_index].split0on_nprims).poffset = (*primitives_index)
    forall __p in [0u:node.nprims:1u] {
      ST.primitives[(__p + (*primitives_index))] = node.data[__p]
    }
    primitives_index += node.nprims
    return this_index
  }
}

func rec_count_triangles1(node : (const BVH&), ST : mut (triangles1*)) -> void {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high) ->
    rec_count_triangles1(node.left, ST)
    rec_count_triangles1(node.right, ST)
    ST.node_count += 1u
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high) ->
    ST.primitive_count += node.nprims
    ST.node_count += 1u
  }
}

func rec_count_triangles2(node : (const BVH&), ST : mut (triangles2*)) -> void {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high) ->
    rec_count_triangles2(node.left, ST)
    rec_count_triangles2(node.right, ST)
    ST.node_count += 1u
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high) ->
    ST.primitive_count += node.nprims
    ST.node_count += 1u
  }
}


schedule host {
    triangles1 : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high)
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high)
    triangles2 : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high)
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high)

}
