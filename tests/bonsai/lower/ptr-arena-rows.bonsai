//! flags: -p canonicalize -p lower-trees -p lower-sorts -p lower-geometrics -p lower-externs -p lower-layouts -p lower-foreachs -p lower-element-references -p lower-tiled-arrays

// arena-rows.bonsai with references that are pointers: Embree's NodeRef as
// it is, an address with the kind in its low four bits -- bit 3 says leaf,
// the three below it count the leaf's tiles -- looked up in a `ptr group`
// (ir::Group::Type::Pointer), whose rows are reached by address and not by
// index from the group's base. The walk starts at `root`, a field the layout
// stores (`layout tris(ref : u64 = root)`): the root's address, wherever the
// builder put it, as Embree's bvh->root.
//
// What to read for. The layout struct holds `root`, `bytes` and the byte
// array `group0_arena`, which only owns the storage. A node's row is element
// zero of an array of its shape at the reference itself, `reinterpret_cast<
// _tree_layout3[]>(reinterpret_cast<const u8*>(tris_ref))[0u]` -- an interior
// node's kind bits are zero, so its reference is its address and nothing is
// masked, as Embree reads an AABBNode -- and a leaf's run of tiles begins at
// `(tris_ref >> 4u) * 16u`, the kind bits taken off, as Embree's `leaf()`
// does. No `&group0_arena[...]`: the arena's base is added to nothing. The
// kind is bit 3, `(tris_ref >> 3u) & 1u`, Embree's `isLeaf`; the leaf's
// count is the low three bits.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };
}
