func bar() -> void {
  print(1)
  return
}

func foo() -> void {
  print(0)
  return
}

func norewrite1(a : mut (bool*)) -> void {
  if ((*a)) {
    print(0)
    a = !(*a)
  }
  if ((*a)) {
    print(1)
  }
  return
}

func rewrite0(a : bool, b : bool) -> void {
  if (b) {
    if (a) {
      print(0)
    } else {
      print(1)
    }
  }
  return
}

func rewrite1(a : bool) -> void {
  if (a) {
    print(0)
    print(1)
  }
  return
}


