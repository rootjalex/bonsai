//! flags: -p canonicalize -p lower-set-functions -p lower-trees

// A struct element's extent written after the element, in the function form.
//
// `element Instance {..} with extent = transform(render_from_instance,
// blas.AABB);` puts the element's fields in scope and nothing else. This is
// the other spelling of the same promise: `element Instance with extent = |i|
// ..;` later in the file, as a function of the element, which is what every
// extent is recorded as whichever way it was written (see the parser's
// parse_extent). The traversal built here has to be the one
// nested-trees.bonsai gets from the field form -- the outer leaf bounded by its
// box ahead of its loop, and the inner match carrying the volume map the
// extent implies -- since the two spellings say the same thing.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func transform(t : Transform, tri : Triangle) -> Triangle {
    out : Triangle = {apply(t, tri.p0), apply(t, tri.p1), apply(t, tri.p2)};
    return out;
}

element Instance {
    render_from_instance : Transform;
    blas : set[Triangle];
}

// The extent, as a function of the instance and after the element.
element Instance with extent = |i| transform(i.render_from_instance, i.blas.AABB);

extern instances : set[Instance];

func trace(r : Ray) =
    argmin(|i : Instance, tri : Triangle| distmin(r, tri),
           filter(|i : Instance, tri : Triangle| intersects(r, tri),
                  flatten(|i : Instance|
                              map(|tri : Triangle|
                                      transform(i.render_from_instance, tri),
                                  i.blas),
                          instances)));

schedule {
    tree[[Triangle]] BLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : BLAS, right : BLAS, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    tree[[Instance]] TLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : TLAS, right : TLAS, axis : u8)
    | Leaf(data : array[Instance]) with data = data;

    instances : TLAS;
    Instance.blas : BLAS from BlasNodes;
}
