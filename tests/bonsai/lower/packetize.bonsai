//! flags: -b llvm

// Just an abs(), used to test control flow.
func foo(y : i32) -> i32 {
    if y < 0 {
        return -y;
    }
    return y;
}

func array_abs(a : array[i32, 8]) = map(foo, a);

// Test the remove continues optimization.
func bar(x : i32) -> i32 {
    if x < 0 {
        return -x;
    } else {
        return x;
    }
}

func array_abs2(a : array[i32, 8]) = map(bar, a);

