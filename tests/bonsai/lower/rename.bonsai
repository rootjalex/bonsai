//! flags: -p canonicalize

func id(x: i32) -> i32 { return x; }

func rename(cond: bool) -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  x: mut = 3;
  c: i32 = a + x;    // #3
  d: i32 = a + x;    // #3

  x += 1;
  e: i32 = a + x;    // #4
  f: i32 = a + x;    // #4

  if (cond) {
    x += 1;
  } else {
    x += 2;
  }

  if (cond && x < 0) {
    x = 0;
  } else {
    x = 1;
  }

  x += 3;
  x *= 2;
  x = 42;

  if (cond) {
    x += 2;
    y: mut = 0;
    y += 1;
    if (cond) {
      x = 0;
    }
  }

  x += 2;
  x = x + 2;
  x = x + id(x);

  return 0;
}
