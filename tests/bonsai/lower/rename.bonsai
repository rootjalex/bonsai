//! flags: -p rename

func nested_subexpressions(x: i32, y: i32, z: i32) -> i32 {
    v = (x / y) - (x * z) + 2;
    w: mut i32 = 42;
    w += 1;
    w = 42 - v;
    return x + v - w;
}

func cond(b: bool) { return b; }

func if_statement(b: bool) {
  if (b ^ 0 == cond(b)) {
    return 1;
  }
  return 0;
}

func print_and_return(i : i32) -> i32 {
    print(i);
    return i;
}

func void_call(i: i32, j: i32) -> void { 
  z: i32 = i + j; 
  return; 
}

func foo(i : i32) -> i32 {
    j : mut = i;
    if (i > 0) {
      k: mut i32 = 0;
      k += print_and_return(i);
    } else {
        print(i);
    }
    void_call(print_and_return(i));
    return abs(i);
}
