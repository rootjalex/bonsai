type Position = struct Position{ x : i32; y : i32; z : i32; c : f32 }

func [[export]] foo($r0 : mut Position, i : Position, j : Position) -> void {
  $r0 = build<Position>(i.x + j.x, i.y + j.y, i.z + j.z, i.c + j.c)
}

func main() -> i32 {
  let i = build<Position>((i32)1, (i32)2, (i32)3, 1f) in
  let j = build<Position>((i32)10, (i32)20, (i32)30, 41f) in
  $r1 = build<Position>()
  let _ = foo($r1, i, j) in
  return (i32)0
}


