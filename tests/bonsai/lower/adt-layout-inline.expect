type Float = f32
type Half = f16
type Shape = struct Shape{ tag : u8; _pad : [[packed]] u8x15; payload : [[packed]] u32x8 }
type Sph = struct Sph{ centre : f32x3; radius : f32 }
type Tri = struct Tri{ a : f32x3; b : f32x3 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Shape_Sph(_ret0 : mut (Shape*), centre : f32x3, radius : f32) -> void {
  _ret0 = build<Shape>(0u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x8>(reinterpret_cast<u32>(centre[0u]), reinterpret_cast<u32>(centre[1u]), reinterpret_cast<u32>(centre[2u]), 0u, reinterpret_cast<u32>(radius), 0u, 0u, 0u))
  return
}

func [[export]] Shape_Tri(_ret1 : mut (Shape*), a : f32x3, b : f32x3) -> void {
  _ret1 = build<Shape>(1u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x8>(reinterpret_cast<u32>(a[0u]), reinterpret_cast<u32>(a[1u]), reinterpret_cast<u32>(a[2u]), 0u, reinterpret_cast<u32>(b[0u]), reinterpret_cast<u32>(b[1u]), reinterpret_cast<u32>(b[2u]), 0u))
  return
}

func _unexported_Shape_Sph(centre : f32x3, radius : f32) -> Shape {
  return build<Shape>(0u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x8>(reinterpret_cast<u32>(centre[0u]), reinterpret_cast<u32>(centre[1u]), reinterpret_cast<u32>(centre[2u]), 0u, reinterpret_cast<u32>(radius), 0u, 0u, 0u))
}

func _unexported_Shape_Tri(a : f32x3, b : f32x3) -> Shape {
  return build<Shape>(1u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x8>(reinterpret_cast<u32>(a[0u]), reinterpret_cast<u32>(a[1u]), reinterpret_cast<u32>(a[2u]), 0u, reinterpret_cast<u32>(b[0u]), reinterpret_cast<u32>(b[1u]), reinterpret_cast<u32>(b[2u]), 0u))
}

func [[export]] size(s : (Shape*)) -> f32 {
  switch ((*s).tag) {
  case 0: { // Shape.Sph of size
    let radius = reinterpret_cast<f32>((*s).payload[4u]) in
    return radius
  } break;
  default: { // Shape.Tri of size
    let _t13 = (*s).payload in
    let a = build<f32x3>(reinterpret_cast<f32>(_t13[0u]), reinterpret_cast<f32>(_t13[1u]), reinterpret_cast<f32>(_t13[2u])) in
    return a[0u]
  }
  }
}


