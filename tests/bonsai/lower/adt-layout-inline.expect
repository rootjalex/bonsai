type Float = f32
type Half = f16
type Shape = struct Shape{ tag : u8; payload : union Shape_payload{ Sph : struct Sph{ centre : f32x3; radius : f32 }; Tri : struct Tri{ a : f32x3; b : f32x3 } } }
type Sph = struct Sph{ centre : f32x3; radius : f32 }
type Tri = struct Tri{ a : f32x3; b : f32x3 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Shape_Sph(_ret0 : mut (Shape*), centre : f32x3, radius : f32) -> void {
  _ret0 = build<Shape>(0u, Shape_payload{.Sph = build<Sph>(centre, radius)})
  return
}

func [[export]] Shape_Tri(_ret1 : mut (Shape*), a : f32x3, b : f32x3) -> void {
  _ret1 = build<Shape>(1u, Shape_payload{.Tri = build<Tri>(a, b)})
  return
}

func _unexported_Shape_Sph(centre : f32x3, radius : f32) -> Shape {
  return build<Shape>(0u, Shape_payload{.Sph = build<Sph>(centre, radius)})
}

func _unexported_Shape_Tri(a : f32x3, b : f32x3) -> Shape {
  return build<Shape>(1u, Shape_payload{.Tri = build<Tri>(a, b)})
}

func [[export]] size(s : (Shape*)) -> f32 {
  if ((*s).tag == 0u) {
    let radius = (*s).payload.Sph.radius in
    return radius
  } else {
    let a = (*s).payload.Tri.a in
    return a[0u]
  }
}


