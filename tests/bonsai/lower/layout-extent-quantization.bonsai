//! flags: -p canonicalize -p verify-layouts -p lower-trees -p lower-layouts 

import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

element f32x3 = vector[f32, 3];
element Particle { p: f32x3; }

extern particles : set[Particle];

func [[export]] find_neighbors(a : AABB) = filter(|p| intersects(a, p), particles);

// dequantization of snapped BVH grid with 2^10 - 1 bins. Reference:
// https://github.com/mphowardlab/neighbor/blob/52cffd270cd7f6f8bff31e87efcc710069b66050/include/neighbor/kernels/LBVHTraverser.cuh#L219
func dequantize(v: i30, bins: f32x3) -> f32x3 {
  return f32x3 {fmul_rd(((v >> 20) & 1023), bins.x), fmul_rd(((v >> 10) & 1023), bins.y), fmul_rd((v & 1023), bins.z)};
}

schedule {
    // extent quantization, as defined in
    // https://www.sciencedirect.com/science/article/pii/S092702561930206X
    tree[[Particle]] BVH(low : f32x3, high : f32x3) with AABB(low, high)
      = Interior(left : BVH, right : BVH)
      | Leaf(nprims: u16, data : array[Particle, nprims]);

    particles : BVH;

    layout particles(index: u32) {
        wlow: f32x3;
        whigh: f32x3;
        bins: f32x3;

        primitive_count : u32;
        primitives : array[Particle, primitive_count];
        node_count : u32;
        group nodes[node_count] by index {
            q_min: i30;
            q_max: i30;
            4;
            nprims : u16;
            16;
            low  = fadd_rd(wlow,  dequantize(q_min, bins));
            high = fsub_ru(whigh, dequantize(q_max, bins));
            split nprims {
                0 -> Interior {
                    offset : u32;
                    left = index + 1;
                    right = index + offset;
                };
                _ -> Leaf {
                    poffset : u32;
                    data = primitives[poffset : poffset + nprims];
                };
            };
        };
    };
}
