//! flags: -p canonicalize -p lower-trees -p lower-sorts -p lower-prefetches -p lower-geometrics -p lower-externs -p lower-layouts -p lower-foreachs -p lower-element-references -p lower-tiled-arrays

// The prefetch directive with a count of cache lines: prefetch-switch-arm
// .bonsai's layout, FCPW's shape, with `trace.prefetch(tris.Interior.
// children, 4)` -- Embree's four lines of a node (ir::Prefetch::lines).
// Without the count the fetch is the storage's own bytes, here the node
// row's 112 (prefetch-switch-arm.bonsai); with it, the four lines the
// schedule said, 256 bytes, so the fetch runs past the row into the next,
// as Embree's four lines of a BVH4 node do.
//
// What to read for: the one prefetch of the child's row as before, now
// `prefetch(&tris.group1_index[child], 256u)`.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        nPackets : u32;
        indirect group packets[nPackets] {
            group[4] {
                pa : vec3f;
                pb : vec3f;
                pc : vec3f;
                primitiveIndex : i32;
                p0 = pa;
                p1 = pb;
                p2 = pc;
            };
        };
        nNodes : u32;
        group[nNodes] index : u32 {
            boxMin_x : vector[f32, 4];
            boxMin_y : vector[f32, 4];
            boxMin_z : vector[f32, 4];
            boxMax_x : vector[f32, 4];
            boxMax_y : vector[f32, 4];
            boxMax_z : vector[f32, 4];
            child0 : i32;
            child1 : i32;
            child2 : i32;
            child3 : i32;
            kind = child0[31:31];
            switch kind {
                0 => Interior {
                    children = vector[u32, 4]{cast[[u32]](child0), cast[[u32]](child1),
                                              cast[[u32]](child2), cast[[u32]](child3)};
                    lo = vector[vec3f, 4]{boxMin_x, boxMin_y, boxMin_z};
                    hi = vector[vec3f, 4]{boxMax_x, boxMax_y, boxMax_z};
                };
                _ => Leaf {
                    data = range(packets, cast[[u32]](0 - child0 - 1) * 4u, cast[[u32]](child3));
                };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}));
    trace.prefetch(tris.Interior.children, 4);
}
