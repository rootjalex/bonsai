//! flags: -p verify-layouts -p lower-trees -p lower-layouts

import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = filter(|tri| intersects(ray, tri), triangles);

element f32x3 = vector[f32, 3];
element f32x3x4 = vector[f32x3, 4];
element f32x9 = vector[f32, 9];
element u64x4 = vector[u64, 4];

element OBB { obb_low: f32x3; obb_high: f32x3; orientation: f32x9; }

schedule {
    tree[[Triangle]] BVH 
      = AABBNode(aabb_children: array[BVH, 4], aabb_low: f32x3x4, aabb_high: f32x3x4) with AABB(aabb_low, aabb_high) on aabb_children
      | OBBNode(obb_children: array[BVH, 4], orientation: f32x9, obb_low: f32x3x4, obb_high: f32x3x4) with OBB(obb_low, obb_high, orientation) on obb_children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(index: u64 = 2) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        indirect group AABBs {
            aabb_low: f32x3x4;
            aabb_high: f32x3x4;
            aabb_children: u64x4;
        };
        indirect group OBBs {
            obb_low: f32x3x4;
            obb_high: f32x3x4;
            orientation: f32x9;
            obb_children: u64x4;
        };

        group by index {
            split index[0:2] {
                2 -> AABBNode from AABBs[index[4:63]];
                3 -> OBBNode from OBBs[index[4:63]];
                _ -> Leaf { 
                    nprims = cast[[u8]](index[1:4] + 1);
                    data = primitives[index[4:63] : index[4:63] + nprims];
                };
            };
        };
    };
}
