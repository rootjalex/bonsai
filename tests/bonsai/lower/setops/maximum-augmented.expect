type Item = struct Item{ id : i32 }
type ItemTree = (const ItemTree&)

extern items : tree[[struct Item{ id : i32 }]] ItemTree
  | Interior(idl : i32, idh : i32, left : (const ItemTree&), right : (const ItemTree&)) with id in [idl, idh] with max(id) = idh
  | Leaf(idl : i32, idh : i32, data : Item) with data = data with id in [idl, idh] with max(id) = idh

func _traverse_tree0(items : tree[[Item]] ItemTree) -> i32 {
  _best0 : mut i32 := -(i32)inf
  rec(items : tree[[Item]] ItemTree) {
    match items {
    | Interior(idl : i32, idh : i32, left : (const ItemTree&), right : (const ItemTree&)) with id in [idl, idh] with max(id) = idh ->
      _best0 max= (items as Interior).idh
    | Leaf(idl : i32, idh : i32, data : Item) with data = data with id in [idl, idh] with max(id) = idh ->
      _best0 max= (items as Leaf).data.id
    }
  }
  yield _best0
}

func q() -> i32 {
  return _traverse_tree0(items)
}


schedule host {

}
