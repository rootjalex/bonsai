type Item = struct Item{ id : i32 }
type ItemTree = (const ItemTree&)

extern items : tree[[struct Item{ id : i32 }]] ItemTree
  | Interior(idl : i32, idh : i32, left : (const ItemTree&), right : (const ItemTree&)) with id in [idl, idh]
  | Leaf(idl : i32, idh : i32, data : Item) with data = data with id in [idl, idh]

func _traverse_tree0(lo : i32, hi : i32, items : tree[[Item]] ItemTree) -> option<Item> {
  _best0 : mut (i32, Item) := ((i32)inf, build<Item>())
  rec(items : tree[[Item]] ItemTree) {
    match items {
    | Interior(idl : i32, idh : i32, left : (const ItemTree&), right : (const ItemTree&)) with id in [idl, idh] ->
      if (((lo <= (items as Interior).idh) && ((items as Interior).idl <= hi)) && ((items as Interior).idl < _best0[0])) {
        from ((items as Interior).left, (items as Interior).right)
      }
    | Leaf(idl : i32, idh : i32, data : Item) with data = data with id in [idl, idh] ->
      if (((lo <= (items as Leaf).idh) && ((items as Leaf).idl <= hi)) && ((items as Leaf).idl < _best0[0])) {
        if (((lo <= (items as Leaf).data.id) & ((items as Leaf).data.id <= hi)) && ((items as Leaf).data.id < _best0[0])) {
          _best0 = ((items as Leaf).data.id, (items as Leaf).data)
        }
      }
    }
  }
  yield select(_best0[0] != (i32)inf, build<option<Item>>(_best0[1]), build<option<Item>>())
}

func q(lo : i32, hi : i32) -> option<Item> {
  return _traverse_tree0(lo, hi, items)
}


schedule host {

}
