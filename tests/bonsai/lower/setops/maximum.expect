type Item = struct Item{ id : i32 }
type ItemTree = (const ItemTree&)

extern items : tree[[struct Item{ id : i32 }]] ItemTree
  | Interior(idl : i32, idh : i32, left : (const ItemTree&), right : (const ItemTree&)) with id in [idl, idh]
  | Leaf(idl : i32, idh : i32, data : Item) with data = data with id in [idl, idh]

func _traverse_tree0(lo : i32, hi : i32, items : tree[[Item]] ItemTree) -> option<i32> {
  _best0 : mut i32 := -(i32)inf
  rec(items : tree[[Item]] ItemTree) {
    match items {
    | Interior(idl : i32, idh : i32, left : (const ItemTree&), right : (const ItemTree&)) with id in [idl, idh] ->
      if (((lo <= (items as Interior).idh) && ((items as Interior).idl <= hi)) && (_best0 < (items as Interior).idh)) {
        from ((items as Interior).left, (items as Interior).right)
      }
    | Leaf(idl : i32, idh : i32, data : Item) with data = data with id in [idl, idh] ->
      if (((lo <= (items as Leaf).idh) && ((items as Leaf).idl <= hi)) && (_best0 < (items as Leaf).idh)) {
        if (((lo <= (items as Leaf).data.id) & ((items as Leaf).data.id <= hi)) && (_best0 < (items as Leaf).data.id)) {
          _best0 max= (items as Leaf).data.id
        }
      }
    }
  }
  yield select(_best0 != -(i32)inf, build<option<i32>>(_best0), build<option<i32>>())
}

func q(lo : i32, hi : i32) -> option<i32> {
  return _traverse_tree0(lo, hi, items)
}


schedule host {

}
