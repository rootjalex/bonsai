//! flags: -p canonicalize -p lower-trees

element Item {
    id : i32;
}

extern items : set[Item];

func q() = reduce(0, |a : i32, b : i32| a + b, map(|x| x.id, items));

schedule {
    tree[[Item]] ItemTree(idl idh : i32) with id in [idl, idh] =
    | Interior(left : ItemTree, right : ItemTree)
    | Leaf(data : Item) with data = data;

    items : ItemTree;
}
