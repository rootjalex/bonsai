//! flags: -p canonicalize -p lower-trees

element Item {
    id : i32;
}

extern items : set[Item];

func q() = maximum(|x| x.id, items);

schedule {
    tree[[Item]] ItemTree(idl idh : i32) with id in [idl, idh] with max(id) = idh =
    | Interior(left : ItemTree, right : ItemTree)
    | Leaf(data : Item) with data = data;

    items : ItemTree;
}
