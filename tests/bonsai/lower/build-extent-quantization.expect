type AABB = struct AABB{ low : f32x3; high : f32x3 }
type BVH = (const BVH&)
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type arm_Interior = [[packed]] struct arm_Interior{ offset : u32 }
type arm_Leaf = [[packed]] struct arm_Leaf{ poffset : u32 }
type f32x2 = f32x2
type f32x3 = f32x3
type f32x3x4 = f32x3x4
type f32x4 = f32x4
type f32x4x3 = f32x4x3
type f32x5 = f32x5
type f32x6 = f32x6
type f32x7 = f32x7
type f32x8 = f32x8
type f32x9 = f32x9
type i8x3 = i8x3
type i8x4 = i8x4
type i8x4x3 = i8x4x3
type i8x9 = i8x9
type nodes = [[packed]] struct nodes{ q_min : i30; q_max : i30; pad0 : u4; nprims : u16; pad1 : u16; split0on_nprims : u8x4 }
type spheres = [[packed]] struct spheres{ wlow : f32x3; whigh : f32x3; bins : f32x3; bins_inv : f32x3; primitive_count : u32; primitives : struct Sphere{ center : f32x3; radius : f32 }[primitive_count]; node_count : u32; nodes : [[packed]] struct nodes{ q_min : i30; q_max : i30; pad0 : u4; nprims : u16; pad1 : u16; split0on_nprims : u8x4 }[node_count] }
type u64x4 = u64x4
type u8x3 = u8x3
type u8x3x4 = u8x3x4
type vec3f = f32x3
type vec3h = f16x3

extern spheres : [[packed]] struct spheres{ wlow : f32x3; whigh : f32x3; bins : f32x3; bins_inv : f32x3; primitive_count : u32; primitives : struct Sphere{ center : f32x3; radius : f32 }[primitive_count]; node_count : u32; nodes : [[packed]] struct nodes{ q_min : i30; q_max : i30; pad0 : u4; nprims : u16; pad1 : u16; split0on_nprims : u8x4 }[node_count] }

func _traverse_tree0(a : AABB, spheres : spheres) -> set<Sphere> {
  rec(index : u32) {
    if (spheres.nodes[index].nprims == 0u) {
      if (intersects(a, build<AABB>(fadd_rd(spheres.wlow, dequantize(spheres.nodes[index].q_min, spheres.bins)), fsub_ru(spheres.whigh, dequantize(spheres.nodes[index].q_max, spheres.bins))))) {
        from (index + 1u, index + reinterpret_cast<arm_Interior>(spheres.nodes[index].split0on_nprims).offset)
      }
    } else {
      foreach _iter0 in spheres.primitives[reinterpret_cast<arm_Leaf>(spheres.nodes[index].split0on_nprims).poffset:reinterpret_cast<arm_Leaf>(spheres.nodes[index].split0on_nprims).poffset + cast<u32>(spheres.nodes[index].nprims)] {
        if (intersects(a, build<AABB>(fadd_rd(spheres.wlow, dequantize(spheres.nodes[index].q_min, spheres.bins)), fsub_ru(spheres.whigh, dequantize(spheres.nodes[index].q_max, spheres.bins))))) {
          if (intersects(a, _iter0)) {
            yield _iter0
          }
        }
      }
    }
  }
}

func build_bins(low : f32x3, high : f32x3) -> f32x3 {
  let bins_inverse = build_bins_inverse(low, high) in
  return build<f32x3>(frcp_rd(bins_inverse[0u]), frcp_rd(bins_inverse[1u]), frcp_rd(bins_inverse[2u]))
}

func build_bins_inverse(low : f32x3, high : f32x3) -> f32x3 {
  let L1 = build<f32x3>(fsub_ru(high[0u], low[0u]), fsub_ru(high[1u], low[1u]), fsub_ru(high[2u], low[2u])) in
  let L2 = select(L1 <= f32x3(0f), f32x3(1f), L1) in
  return build<f32x3>(fdiv_rd(1023f, L2[0u]), fdiv_rd(1023f, L2[1u]), fdiv_rd(1023f, L2[2u]))
}

func build_spheres(CT : (const BVH&)) -> spheres {
  ST : mut spheres
  primitives_index : mut idx
  nodes_index : mut idx
  rec_count_spheres(CT, ST)
  alloc primitives : mut Sphere[ST.primitive_count]
  ST.primitives = primitives
  alloc nodes : mut nodes[ST.node_count]
  ST.nodes = nodes
  rec_build_spheres(CT, ST, nodes_index, primitives_index)
  return ST
}

func dequantize(v : i30, bins : f32x3) -> f32x3 {
  return build<f32x3>(cast<f32>(fmul_rd((v >> 20) & 1023, bins[0u])), cast<f32>(fmul_rd((v >> 10) & 1023, bins[1u])), cast<f32>(fmul_rd(v & 1023, bins[2u])))
}

func distmax_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_Point_AABB(pt : Point, a : AABB) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Triangle(p : Point, tri : Triangle) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm(p.vec - pts[0].vec)
}

func distmin_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return (f32)inf
  }
}

func [[export]] find_neighbors(a : AABB) -> set<Sphere> {
  return _traverse_tree0(a, spheres)
}

func intersects_AABB_AABB(a : AABB, b : AABB) -> bool {
  let low = max(a.low, b.low) in
  let high = min(a.high, b.high) in
  return reduce<all>(low <= high)
}

func intersects_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  let closest = max(a.low, min(s.center, a.high)) in
  let d = s.center - closest in
  return dot(d, d) <= (s.radius * s.radius)
}

func intersects_AABB_Triangle(a : AABB, b : Triangle) -> bool {
  let center = (a.low + a.high) * f32x3(0.5f) in
  let extents = (a.high - a.low) * f32x3(0.5f) in
  let v0 = b.p0 - center in
  let v1 = b.p1 - center in
  let v2 = b.p2 - center in
  let f0 = v1 - v0 in
  let f1 = v2 - v1 in
  let f2 = v0 - v2 in
  let tri_min = min(min(v0, v1), v2) in
  let tri_max = max(max(v0, v1), v2) in
  if (!reduce<all>((tri_min <= extents) & (-extents <= tri_max))) {
    return false
  }
  let X = (f32x3)[1f,0f,0f] in
  let Y = (f32x3)[0f,1f,0f] in
  let Z = (f32x3)[0f,0f,1f] in
  let A0 = cross(f0, X) in
  let A1 = cross(f0, Y) in
  let A2 = cross(f0, Z) in
  let A3 = cross(f1, X) in
  let A4 = cross(f1, Y) in
  let A5 = cross(f1, Z) in
  let A6 = cross(f2, X) in
  let A7 = cross(f2, Y) in
  let A8 = cross(f2, Z) in
  if (!axis(A0, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A1, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A2, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A3, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A4, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A5, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A6, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A7, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A8, extents, v0, v1, v2)) {
    return false
  }
  let N = cross(f0, f1) in
  let Rn = dot(extents, abs(N)) in
  let dist = dot(v0, N) in
  if ((Rn < dist) || (dist < -Rn)) {
    return false
  }
  return true
}

func intersects_Ray_AABB(r : Ray, b : AABB) -> bool {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < r.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Sphere(ray : Ray, s : Sphere) -> bool {
  let interval = intersectsp_ray_sphere(ray, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < ray.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Triangle(ray : Ray, tri : Triangle) -> bool {
  return cast<bool>(intersectsp_ray_tri(ray, tri))
}

func intersects_Triangle_Triangle(a : Triangle, b : Triangle) -> bool {
  let eA0 = a.p1 - a.p0 in
  let eA1 = a.p2 - a.p1 in
  let eA2 = a.p0 - a.p2 in
  let eB0 = b.p1 - b.p0 in
  let eB1 = b.p2 - b.p1 in
  let eB2 = b.p0 - b.p2 in
  let N0 = cross(eA0, eA1) in
  let N1 = cross(eB0, eB1) in
  let a0 = a.p0 in
  let a1 = a.p1 in
  let a2 = a.p2 in
  let b0 = b.p0 in
  let b1 = b.p1 in
  let b2 = b.p2 in
  if (!tri_tri_axis(N0, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(N1, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  let E00 = cross(eA0, eB0) in
  let E01 = cross(eA0, eB1) in
  let E02 = cross(eA0, eB2) in
  let E10 = cross(eA1, eB0) in
  let E11 = cross(eA1, eB1) in
  let E12 = cross(eA1, eB2) in
  let E20 = cross(eA2, eB0) in
  let E21 = cross(eA2, eB1) in
  let E22 = cross(eA2, eB2) in
  if (!tri_tri_axis(E00, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E01, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E02, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E10, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E11, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E12, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E20, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E21, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E22, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  return true
}

func quantize(current : f32x3, world : f32x3, bin_inverse : f32x3) -> i30 {
  let x = cast<u32>(floorf(fmul_rd(fsub_rd(current[0u], world[0u]), bin_inverse[0u]))) in
  let y = cast<u32>(floorf(fmul_rd(fsub_rd(current[1u], world[1u]), bin_inverse[1u]))) in
  let z = cast<u32>(floorf(fmul_rd(fsub_rd(current[2u], world[2u]), bin_inverse[2u]))) in
  return cast<i30>(((x << 20u) | (y << 10u)) | z)
}

func rec_build_spheres(node : (const BVH&), ST : mut spheres, nodes_index : mut u32, primitives_index : mut idx) -> u32 {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high) ->
    let this_index = nodes_index in
    nodes_index += 1u
    if (this_index == 0) {
      ST.wlow = node.low
      ST.whigh = node.high
      ST.bins_inv = build_bins_inverse(node.low, node.high)
      ST.bins = build_bins(node.low, node.high)
    }
    ST.nodes[this_index].q_min = quantize(node.low, ST.wlow, ST.bins_inv)
    ST.nodes[this_index].q_max = quantize(node.high, ST.whigh, ST.bins_inv)
    ST.nodes[this_index].nprims = 0
    let left_index = rec_build_spheres(node.left, ST, nodes_index, primitives_index) in
    let right_index = rec_build_spheres(node.right, ST, nodes_index, primitives_index) in
    ST.nodes[this_index].split0on_nprims.offset = right_index - this_index
    return this_index
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Sphere[nprims]) with AABB(low, high) ->
    let this_index = nodes_index in
    nodes_index += 1u
    ST.nodes[this_index].q_min = quantize(node.low, ST.wlow, ST.bins_inv)
    ST.nodes[this_index].q_max = quantize(node.high, ST.whigh, ST.bins_inv)
    ST.nodes[this_index].nprims = node.nprims
    ST.nodes[this_index].split0on_nprims.poffset = primitives_index
    forall __p in [0u:node.nprims:1u] {
      ST.primitives[__p + primitives_index] = node.data[__p]
    }
    primitives_index += node.nprims
    return this_index
  }
}

func rec_count_spheres(node : (const BVH&), ST : mut spheres) -> void {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&)) with AABB(low, high) ->
    rec_count_spheres(node.left, ST)
    rec_count_spheres(node.right, ST)
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Sphere[nprims]) with AABB(low, high) ->
    ST.node_count += 1u
  }
}


