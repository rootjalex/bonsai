func ?traverse0(f : Fn(i32) -> i32, fs : i32[(i32)32]) -> i32[(i32)32] {
  let ?alloc0 = alloc i32 x (i32)32 in
  for all ?index0 in [(i32)0:(i32)32:(i32)1] {
    ?alloc0[?index0] = f(fs[?index0]) + (i32)1
  }
}

func ?traverse1(xs : i32[(i32)64]) -> i32[(i32)64] {
  let ?alloc1 = alloc i32 x (i32)64 in
  for all ?index1 in [(i32)0:(i32)64:(i32)1] {
    ?alloc1[?index1] = ((xs[?index1] * (i32)2) - (i32)1) + (i32)1
  }
}

func ?traverse2(ns : i32[(i32)32][(i32)16]) -> i32[][(i32)16] {
  let ?alloc2 = alloc i32[(i32)32] x (i32)16 in
  for all ?index2 in [(i32)0:(i32)16:(i32)1] {
    ?alloc2[?index2] = ?traverse5(ns[?index2])
  }
}

func ?traverse3(xs : i32[(i32)32]) -> i32[(i32)32] {
  let ?alloc3 = alloc i32 x (i32)32 in
  for all ?index3 in [(i32)0:(i32)32:(i32)1] {
    ?alloc3[?index3] = xs[?index3] + (i32)1
  }
}

func ?traverse4(ys : f32[(i32)32]) -> f32[(i32)32] {
  let ?alloc4 = alloc f32 x (i32)32 in
  for all ?index4 in [(i32)0:(i32)32:(i32)1] {
    ?alloc4[?index4] = sin(ys[?index4])
  }
}

func ?traverse5(?iter2 : i32[(i32)32]) -> i32[(i32)32] {
  let ?alloc5 = alloc i32 x (i32)32 in
  for all ?index5 in [(i32)0:(i32)32:(i32)1] {
    ?alloc5[?index5] = ?iter2[?index5] + (i32)1
  }
}

func apply_function(fs : i32[(i32)32]) -> i32[(i32)32] {
  return ?traverse0(f, fs)
}

func f(i : i32) -> i32 {
  return i
}

func fused_maps(xs : i32[(i32)64]) -> i32[(i32)64] {
  return ?traverse1(xs)
}

func hierarchical_maps(ns : i32[(i32)32][(i32)16]) -> i32[(i32)32][(i32)16] {
  return ?traverse2(ns)
}

func simple(xs : i32[(i32)32]) -> void {
  return ?traverse3(xs)
}

func with_intrinsics(ys : f32[(i32)32]) -> f32[(i32)32] {
  return ?traverse4(ys)
}


