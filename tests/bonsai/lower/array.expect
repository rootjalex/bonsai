func ?traverse_array0(f : Fn(i32) -> i32, fs : i32[32]) -> i32[32] {
  alloc ?alloc0 : i32[32]
  forall ?index0 in [(i32)0:(i32)32:(i32)1] {
    let ?load0 = fs[?index0] in
    ?alloc0[?index0] = f(?load0) + (i32)1
  }
  return ?alloc0
}

func ?traverse_array1(xs : i32[64]) -> i32[64] {
  alloc ?alloc1 : i32[64]
  forall ?index1 in [(i32)0:(i32)64:(i32)1] {
    let ?load1 = xs[?index1] in
    ?alloc1[?index1] = ((?load1 * (i32)2) - (i32)1) + (i32)1
  }
  return ?alloc1
}

func ?traverse_array2(ns : i32[32][16]) -> i32[][16] {
  alloc ?alloc2 : i32[32][16]
  forall ?index2 in [(i32)0:(i32)16:(i32)1] {
    let ?load2 = ns[?index2] in
    ?alloc2[?index2] = map(|x : i32| x + (i32)1, ?load2)
  }
  return ?alloc2
}

func ?traverse_array3(xs : i32[32]) -> i32[32] {
  alloc ?alloc3 : i32[32]
  forall ?index3 in [(i32)0:(i32)32:(i32)1] {
    let ?load3 = xs[?index3] in
    ?alloc3[?index3] = ?load3 + (i32)1
  }
  return ?alloc3
}

func ?traverse_array4(ys : f32[32]) -> f32[32] {
  alloc ?alloc4 : f32[32]
  forall ?index4 in [(i32)0:(i32)32:(i32)1] {
    let ?load4 = ys[?index4] in
    ?alloc4[?index4] = sin(?load4)
  }
  return ?alloc4
}

func apply_function(fs : i32[32]) -> i32[32] {
  return ?traverse_array0(f, fs)
}

func f(i : i32) -> i32 {
  return i
}

func fused_maps(xs : i32[64]) -> i32[64] {
  return ?traverse_array1(xs)
}

func hierarchical_maps(ns : i32[32][16]) -> i32[32][16] {
  return ?traverse_array2(ns)
}

func simple(xs : i32[32]) -> void {
  return ?traverse_array3(xs)
}

func with_intrinsics(ys : f32[32]) -> f32[32] {
  return ?traverse_array4(ys)
}


