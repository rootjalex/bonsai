func id(x : i32) -> i32 {
  return x
}

func rename(cond : bool) -> i32 {
  let a = 1 in
  let b = 2 in
  x := 3
  let c = a + x in
  let d = a + x in
  x += 1
  let e = a + x in
  let f = a + x in
  if (cond) {
    x += 1
  } else {
    x += 2
  }
  if (cond && (x < 0)) {
    x = 0
  } else if (0 < x) {
    x = 1
  } else {
    x = 2
  }
  x += 3
  x *= 2
  x = 42
  if (cond) {
    x += 2
    y := 0
    y += 1
    if (cond) {
      x = 0
    }
  }
  x += 2
  x = x + 2
  return 0
}

func unnamed_expressions(x : i32, y : i32) -> i32 {
  let _t0 = (x + y) + (x + y) in
  let v = _t0 + 2 in
  z := 42
  z += 1
  z = 42 - v
  let _t1 = (x + v) - z in
  return _t1
}


