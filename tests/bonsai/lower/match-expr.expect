type Float = f32
type Half = f16
type Shape = struct Shape{ tag : u8; _pad : [[packed]] u8x15; payload : [[packed]] u32x12 }
type Sph = struct Sph{ center : f32x3; radius : f32 }
type Tri = struct Tri{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Shape_Sph(_ret0 : mut (Shape*), center : f32x3, radius : f32) -> void {
  _ret0 = build<Shape>(0u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x12>(reinterpret_cast<u32>(center[0u]), reinterpret_cast<u32>(center[1u]), reinterpret_cast<u32>(center[2u]), 0u, reinterpret_cast<u32>(radius), 0u, 0u, 0u, 0u, 0u, 0u, 0u))
  return
}

func [[export]] Shape_Tri(_ret1 : mut (Shape*), p0 : f32x3, p1 : f32x3, p2 : f32x3) -> void {
  _ret1 = build<Shape>(1u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x12>(reinterpret_cast<u32>(p0[0u]), reinterpret_cast<u32>(p0[1u]), reinterpret_cast<u32>(p0[2u]), 0u, reinterpret_cast<u32>(p1[0u]), reinterpret_cast<u32>(p1[1u]), reinterpret_cast<u32>(p1[2u]), 0u, reinterpret_cast<u32>(p2[0u]), reinterpret_cast<u32>(p2[1u]), reinterpret_cast<u32>(p2[2u]), 0u))
  return
}

func _match0(_matched : Shape) -> f32 {
  switch (_matched.tag) {
  case 0: { // Shape.Sph of _match0
    return ((4f * 3.14159f) * build<Sph>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), reinterpret_cast<f32>(_matched.payload[4u])).radius) * build<Sph>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), reinterpret_cast<f32>(_matched.payload[4u])).radius
  } break;
  default: { // Shape.Tri of _match0
    return 0.5f * norm(cross(build<Tri>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[4u]), reinterpret_cast<f32>(_matched.payload[5u]), reinterpret_cast<f32>(_matched.payload[6u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[8u]), reinterpret_cast<f32>(_matched.payload[9u]), reinterpret_cast<f32>(_matched.payload[10u]))).p1 - build<Tri>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[4u]), reinterpret_cast<f32>(_matched.payload[5u]), reinterpret_cast<f32>(_matched.payload[6u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[8u]), reinterpret_cast<f32>(_matched.payload[9u]), reinterpret_cast<f32>(_matched.payload[10u]))).p0, build<Tri>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[4u]), reinterpret_cast<f32>(_matched.payload[5u]), reinterpret_cast<f32>(_matched.payload[6u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[8u]), reinterpret_cast<f32>(_matched.payload[9u]), reinterpret_cast<f32>(_matched.payload[10u]))).p2 - build<Tri>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[4u]), reinterpret_cast<f32>(_matched.payload[5u]), reinterpret_cast<f32>(_matched.payload[6u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[8u]), reinterpret_cast<f32>(_matched.payload[9u]), reinterpret_cast<f32>(_matched.payload[10u]))).p0))
  }
  }
}

func _match1(_matched : Shape) -> f32 {
  switch (_matched.tag) {
  case 0: { // Shape.Sph of _match1
    return 2f * build<Sph>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), reinterpret_cast<f32>(_matched.payload[4u])).radius
  } break;
  default: { // Shape.Tri of _match1
    return norm(build<Tri>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[4u]), reinterpret_cast<f32>(_matched.payload[5u]), reinterpret_cast<f32>(_matched.payload[6u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[8u]), reinterpret_cast<f32>(_matched.payload[9u]), reinterpret_cast<f32>(_matched.payload[10u]))).p1 - build<Tri>(build<f32x3>(reinterpret_cast<f32>(_matched.payload[0u]), reinterpret_cast<f32>(_matched.payload[1u]), reinterpret_cast<f32>(_matched.payload[2u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[4u]), reinterpret_cast<f32>(_matched.payload[5u]), reinterpret_cast<f32>(_matched.payload[6u])), build<f32x3>(reinterpret_cast<f32>(_matched.payload[8u]), reinterpret_cast<f32>(_matched.payload[9u]), reinterpret_cast<f32>(_matched.payload[10u]))).p0)
  }
  }
}

func area(s : Shape) -> f32 {
  return _match0(s)
}

func [[export]] scaled_extent(s : (Shape*), scale : f32) -> f32 {
  return 1f + (scale * _match1((*s)))
}

func [[export]] total(s : (Shape*), t : (Shape*)) -> f32 {
  return area((*s)) + area((*t))
}


