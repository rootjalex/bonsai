type Float = f32
type Half = f16
type Shape = struct Shape{ tag : u8; payload : union Shape_payload{ Sph : struct Sph{ center : f32x3; radius : f32 }; Tri : struct Tri{ p0 : f32x3; p1 : f32x3; p2 : f32x3 } } }
type Sph = struct Sph{ center : f32x3; radius : f32 }
type Tri = struct Tri{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Shape_Sph(_ret0 : mut (Shape*), center : f32x3, radius : f32) -> void {
  _ret0 = build<Shape>(0u, Shape_payload{.Sph = build<Sph>(center, radius)})
  return
}

func [[export]] Shape_Tri(_ret1 : mut (Shape*), p0 : f32x3, p1 : f32x3, p2 : f32x3) -> void {
  _ret1 = build<Shape>(1u, Shape_payload{.Tri = build<Tri>(p0, p1, p2)})
  return
}

func _match0(_matched : Shape) -> f32 {
  if (_matched.tag == 0u) {
    return ((4f * 3.14159f) * _matched.payload.Sph.radius) * _matched.payload.Sph.radius
  } else {
    return 0.5f * norm(cross(_matched.payload.Tri.p1 - _matched.payload.Tri.p0, _matched.payload.Tri.p2 - _matched.payload.Tri.p0))
  }
}

func _match1(_matched : Shape) -> f32 {
  if (_matched.tag == 0u) {
    return 2f * _matched.payload.Sph.radius
  } else {
    return norm(_matched.payload.Tri.p1 - _matched.payload.Tri.p0)
  }
}

func _unexported_Shape_Sph(center : f32x3, radius : f32) -> Shape {
  return build<Shape>(0u, Shape_payload{.Sph = build<Sph>(center, radius)})
}

func _unexported_Shape_Tri(p0 : f32x3, p1 : f32x3, p2 : f32x3) -> Shape {
  return build<Shape>(1u, Shape_payload{.Tri = build<Tri>(p0, p1, p2)})
}

func area(s : Shape) -> f32 {
  return _match0(s)
}

func [[export]] scaled_extent(s : (Shape*), scale : f32) -> f32 {
  return 1f + (scale * _match1((*s)))
}

func [[export]] total(s : (Shape*), t : (Shape*)) -> f32 {
  return area((*s)) + area((*t))
}


