//! flags: -p canonicalize -p lower-trees

// A node that bounds its children rather than itself.
//
// pbrt's LinearBVHNode stores its own box, and a traversal tests it on
// arrival: the leaf arm and the interior arm each begin by asking whether the
// ray meets the node. Embree's AABBNode stores no box of its own; it stores
// its children's, six vectors of N floats, and the traversal tests all N
// children at the parent and descends only into the ones hit. The tree
// language has said this since BVH_t gained volumes -- `with AABB(lo, hi) on
// children` puts the volume on the children, each child's box read out of
// `lo` and `hi` at its index -- but until now nothing consumed it, and a tree
// written this way was walked without a single box test.
//
// What to read for in the golden. Neither arm tests a volume of its own: the
// leaf loops straight over its triangles, and the interior has no `if` in
// front of it. Instead the children are tested in a loop over them, which
// computes a mask the `from` carries, one bit per branch:
//
//     _mask0 : mut bool[4]
//     parfor children in [0u:4u:1u] {
//       _mask0[children] = intersects(r, build<AABB>((tris as Interior).lo[children],
//                                                    (tris as Interior).hi[children]))
//           && (distmin(r, build<AABB>(...)) < _best0[0])
//     }
//     from ((tris as Interior).children[0u], ...) where (_mask0[0u], ...)
//
// the test being predicate analysis's `maybe` bound of the fused filter --
// the ray meets the child's box, and the box is nearer than the best hit so
// far -- over child i's volume, with i the loop's index. A parfor, since the
// tests are independent, and named for the field, so that a schedule can
// vectorize it (`trace.vectorize(tris.Interior.children)`) into Embree's one
// test of every child at once. The `any` is the same with its own predicate,
// and the whole run is gated once on the accumulator, as a node's own test
// would be. What becomes of the mask is downstream's business: a call not
// made (the LLVM and C++ backends), a push not made
// (ssa/child-volumes-sorted.bonsai).
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

schedule {
    // Embree's BVH4: four children per node, their boxes in the parent, and
    // nothing said about the node itself.
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        // Embree's AABBNode: the children's references, then their boxes as
        // six vectors of four floats.
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lo : vector[vec3f, 4];
            hi : vector[vec3f, 4];
        };
        // Embree's NodeRef: a reference whose low four bits say what it is --
        // 0 an interior node, 8 + n a leaf of n triangles -- and whose high
        // bits are the node's row or the leaf's first triangle. A group that
        // stores nothing: the reference is the data.
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };
}
