type AABB = struct AABB{ low : f32x3; high : f32x3 }
type Float = f32
type Interior = struct Interior{ low : f32x3; high : f32x3; left : (const PointBVH&); right : (const PointBVH&) }
type Leaf = struct Leaf{ low : f32x3; high : f32x3; data : struct Point{ data : f32x3 } }
type Point = struct Point{ data : f32x3 }
type PointBVH = (const PointBVH&)
type vec3f = f32x3

extern points : tree[[struct Point{ data : f32x3 }]] PointBVH
  | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high)
  | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high)

func _traverse_tree0(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (within(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (within(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        if (equals(r, (points as Leaf).data)) {
          yield (points as Leaf).data
        }
      }
    }
  }
}

func _traverse_tree1(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (contains(build<AABB>((points as Interior).low, (points as Interior).high), r)) {
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (contains(build<AABB>((points as Leaf).low, (points as Leaf).high), r)) {
        if (equals((points as Leaf).data, r)) {
          yield (points as Leaf).data
        }
      }
    }
  }
}

func q_uv(r : AABB) -> set<Point> {
  return _traverse_tree0(r, points)
}

func q_vu(r : AABB) -> set<Point> {
  return _traverse_tree1(r, points)
}


schedule host {
    points : tree[[struct Point{ data : f32x3 }]] PointBVH
  | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high)
  | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high)

}
