//! flags: -p canonicalize -p lower-trees

element Float = f32;
element vec3f = vector[Float, 3];

element AABB {
    low, high : vec3f;
}

element Point {
    data : vec3f;
}

extern points : set[Point];

func q_x(r : AABB) = filter(|p| lex(r, p), points);
func q_y(r : AABB) = filter(|p| ley(p, r), points);
func q_z(r : AABB) = filter(|p| lez(r, p), points);

schedule {
    tree[[Point]] PointBVH(low high : vec3f) with AABB(low, high) =
    | Interior(left : PointBVH, right : PointBVH)
    | Leaf(data : Point) with data = data;

    points : PointBVH;
}
