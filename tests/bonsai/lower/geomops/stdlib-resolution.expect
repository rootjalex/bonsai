      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (ltz_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        yield (points as Leaf).data
      } else if (!lez_AABB_AABB(build<AABB>((points as Leaf).low, (points as Leaf).high), r)) {
