func _traverse_tree13(q : Point, points : tree[[Point]] PointBVH) -> f32 {
  _best1 : mut f32 := (f32)inf
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (distmin_Point_AABB(q, build<AABB>((points as Interior).low, (points as Interior).high)) < _best1) {
        _best1 min= distmax_Point_AABB(q, build<AABB>((points as Interior).low, (points as Interior).high))
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (distmin_Point_AABB(q, build<AABB>((points as Leaf).low, (points as Leaf).high)) < _best1) {
        if (distmin_Point_Point(q, (points as Leaf).data) < _best1) {
          _best1 min= distmin_Point_Point(q, (points as Leaf).data)
        }
      }
    }
  }
  yield _best1
}

func _traverse_tree14(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (intersects_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (intersects_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        if (touches_AABB_Point(r, (points as Leaf).data)) {
          yield (points as Leaf).data
        }
      }
    }
  }
}

func _traverse_tree15(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (within_AABB_AABB(build<AABB>((points as Interior).low, (points as Interior).high), r)) {
        scan ((points as Interior).left, (points as Interior).right)
      } else {
        if (intersects_AABB_AABB(build<AABB>((points as Interior).low, (points as Interior).high), r)) {
          from ((points as Interior).left, (points as Interior).right)
        }
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (within_AABB_AABB(build<AABB>((points as Leaf).low, (points as Leaf).high), r)) {
        yield (points as Leaf).data
      } else {
        if (intersects_AABB_AABB(build<AABB>((points as Leaf).low, (points as Leaf).high), r)) {
          if (within_Point_AABB((points as Leaf).data, r)) {
            yield (points as Leaf).data
          }
        }
      }
    }
  }
}

func _traverse_tree2(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (covers_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
        scan ((points as Interior).left, (points as Interior).right)
      } else {
        if (intersects_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
          from ((points as Interior).left, (points as Interior).right)
        }
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (covers_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        yield (points as Leaf).data
      } else {
        if (intersects_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
          if (covers_AABB_Point(r, (points as Leaf).data)) {
            yield (points as Leaf).data
          }
        }
      }
    }
  }
}

func _traverse_tree3(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (disjoint_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
        scan ((points as Interior).left, (points as Interior).right)
      } else {
        if (!contains_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
          from ((points as Interior).left, (points as Interior).right)
        }
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (disjoint_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        yield (points as Leaf).data
      } else {
        if (!contains_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
          if (disjoint_AABB_Point(r, (points as Leaf).data)) {
            yield (points as Leaf).data
          }
        }
      }
    }
  }
}

func _traverse_tree4(q : Point, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (contains_AABB_Point(build<AABB>((points as Interior).low, (points as Interior).high), q)) {
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (contains_AABB_Point(build<AABB>((points as Leaf).low, (points as Leaf).high), q)) {
        if (equals_Point_Point((points as Leaf).data, q)) {
          yield (points as Leaf).data
        }
      }
    }
  }
}

func _traverse_tree5(q : Point, points : tree[[Point]] PointBVH) -> f32 {
  _best0 : mut f32 := -(f32)inf
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (_best0 < distmax_Point_AABB(q, build<AABB>((points as Interior).low, (points as Interior).high))) {
        _best0 max= distmin_Point_AABB(q, build<AABB>((points as Interior).low, (points as Interior).high))
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (_best0 < distmax_Point_AABB(q, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        if (_best0 < distmax_Point_Point(q, (points as Leaf).data)) {
          _best0 max= distmax_Point_Point(q, (points as Leaf).data)
        }
      }
    }
  }
  yield _best0
}

