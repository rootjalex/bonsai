type AABB = struct AABB{ low : f32x3; high : f32x3 }
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type PointBVH = (const PointBVH&)
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type vec3f = f32x3
type vec3h = f16x3

extern points : tree[[struct Point{ vec : f32x3 }]] PointBVH
  | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high)
  | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high)

func _traverse_tree0(q : Point, points : tree[[Point]] PointBVH) -> Point {
  _best0 : mut (f32, Point) := ((f32)inf, build<Point>())
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (distmin_Point_AABB(q, build<AABB>((points as Interior).low, (points as Interior).high)) < _best0[0]) {
        _best0 argmin= (distmax_Point_AABB(q, build<AABB>((points as Interior).low, (points as Interior).high)), build<Point>())
        from ((points as Interior).left, (points as Interior).right)
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (distmin_Point_AABB(q, build<AABB>((points as Leaf).low, (points as Leaf).high)) < _best0[0]) {
        if (distmin_Point_Point(q, (points as Leaf).data) < _best0[0]) {
          _best0 = (distmin_Point_Point(q, (points as Leaf).data), (points as Leaf).data)
        }
      }
    }
  }
  yield _best0[1]
}

func _traverse_tree1(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (contains_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
        scan ((points as Interior).left, (points as Interior).right)
      } else {
        if (intersects_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
          from ((points as Interior).left, (points as Interior).right)
        }
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (contains_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        yield (points as Leaf).data
      } else {
        if (intersects_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
          if (contains_AABB_Point(r, (points as Leaf).data)) {
            yield (points as Leaf).data
          }
        }
      }
    }
  }
}

func _traverse_tree10(r : AABB, points : tree[[Point]] PointBVH) -> set<Point> {
  rec(points : tree[[Point]] PointBVH) {
    match points {
    | Interior(low : f32x3, high : f32x3, left : (const PointBVH&), right : (const PointBVH&)) with AABB(low, high) ->
      if (ltx_AABB_AABB(r, build<AABB>((points as Interior).low, (points as Interior).high))) {
        scan ((points as Interior).left, (points as Interior).right)
      } else {
        if (!lex_AABB_AABB(build<AABB>((points as Interior).low, (points as Interior).high), r)) {
          from ((points as Interior).left, (points as Interior).right)
        }
      }
    | Leaf(low : f32x3, high : f32x3, data : Point) with data = data with AABB(low, high) ->
      if (ltx_AABB_AABB(r, build<AABB>((points as Leaf).low, (points as Leaf).high))) {
        yield (points as Leaf).data
      } else {
        if (!lex_AABB_AABB(build<AABB>((points as Leaf).low, (points as Leaf).high), r)) {
          if (ltx_AABB_Point(r, (points as Leaf).data)) {
            yield (points as Leaf).data
          }
        }
      }
    }
  }
}

