func touches_AABB_AABB(a : AABB, b : AABB) -> bool {
  return intersects_AABB_AABB(a, b) & !reduce<all>(max(a.low, b.low) < min(a.high, b.high))
}

func touches_AABB_Point(a : AABB, p : Point) -> bool {
  return contains_AABB_Point(a, p) & !reduce<all>((a.low < p.vec) & (p.vec < a.high))
}

func within_AABB_AABB(a : AABB, b : AABB) -> bool {
  return contains_AABB_AABB(b, a)
}

func within_AABB_Ray(a : AABB, r : Ray) -> bool {
  return false
}

func within_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  return contains_Sphere_AABB(s, a)
}

func within_Point_AABB(p : Point, a : AABB) -> bool {
  return contains_AABB_Point(a, p)
}

func within_Point_Point(p : Point, q : Point) -> bool {
  return equals_Point_Point(p, q)
}

func within_Sphere_AABB(s : Sphere, a : AABB) -> bool {
  return contains_AABB_Sphere(a, s)
}

func within_Triangle_AABB(t : Triangle, a : AABB) -> bool {
  return contains_AABB_Triangle(a, t)
}


