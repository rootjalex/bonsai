func contains_AABB_AABB(a : AABB, b : AABB) -> bool {
  return reduce<all>((a.low <= b.low) & (b.high <= a.high))
}

func contains_AABB_Point(a : AABB, p : Point) -> bool {
  return reduce<all>((a.low <= p.vec) & (p.vec <= a.high))
}

func contains_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  return contains_AABB_AABB(a, aabb_of_sphere(s))
}

func contains_AABB_Triangle(a : AABB, t : Triangle) -> bool {
  return contains_AABB_AABB(a, aabb_of_triangle(t))
}

func contains_Point_Point(p : Point, q : Point) -> bool {
  return equals_Point_Point(p, q)
}

func contains_Ray_AABB(r : Ray, a : AABB) -> bool {
  return false
}

func contains_Ray_Sphere(r : Ray, s : Sphere) -> bool {
  return false
}

func contains_Ray_Triangle(r : Ray, t : Triangle) -> bool {
  return false
}

func contains_Sphere_AABB(s : Sphere, a : AABB) -> bool {
  let far = max(abs(a.low - s.center), abs(a.high - s.center)) in
  return reduce<+>(far * far) <= (s.radius * s.radius)
}

func covers_AABB_AABB(a : AABB, b : AABB) -> bool {
  return contains_AABB_AABB(a, b)
}

func covers_AABB_Point(a : AABB, p : Point) -> bool {
  return contains_AABB_Point(a, p)
}

func covers_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  return contains_AABB_Sphere(a, s)
}

func covers_AABB_Triangle(a : AABB, t : Triangle) -> bool {
  return contains_AABB_Triangle(a, t)
}

func covers_Ray_AABB(r : Ray, a : AABB) -> bool {
  return false
}

func disjoint_AABB_AABB(a : AABB, b : AABB) -> bool {
  return !intersects_AABB_AABB(a, b)
}

func disjoint_AABB_Point(a : AABB, p : Point) -> bool {
  return !contains_AABB_Point(a, p)
}

func disjoint_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  return !intersects_AABB_Sphere(a, s)
}

func disjoint_AABB_Triangle(a : AABB, t : Triangle) -> bool {
  return !intersects_AABB_Triangle(a, t)
}

func disjoint_Point_AABB(p : Point, a : AABB) -> bool {
  return !contains_AABB_Point(a, p)
}

func disjoint_Point_Point(p : Point, q : Point) -> bool {
  return !equals_Point_Point(p, q)
}

func disjoint_Ray_AABB(r : Ray, a : AABB) -> bool {
  return !intersects_Ray_AABB(r, a)
}

func disjoint_Ray_Sphere(r : Ray, s : Sphere) -> bool {
  return !intersects_Ray_Sphere(r, s)
}

func disjoint_Ray_Triangle(r : Ray, t : Triangle) -> bool {
  return !intersects_Ray_Triangle(r, t)
}

func disjoint_Sphere_AABB(s : Sphere, a : AABB) -> bool {
  return !intersects_AABB_Sphere(a, s)
}

func disjoint_Triangle_AABB(t : Triangle, a : AABB) -> bool {
  return !intersects_AABB_Triangle(a, t)
}

func distmax_AABB_AABB(a : AABB, b : AABB) -> f32 {
  let span = max(abs(a.low - b.high), abs(a.high - b.low)) in
  return norm(span)
}

func distmax_AABB_Point(a : AABB, pt : Point) -> f32 {
  return distmax_Point_AABB(pt, a)
}

func distmax_Point_AABB(pt : Point, a : AABB) -> f32 {
  let span = max(abs(pt.vec - a.low), abs(pt.vec - a.high)) in
  return norm(span)
}

func distmax_Point_Point(p : Point, q : Point) -> f32 {
  return norm(p.vec - q.vec)
}

func distmax_Point_Sphere(pt : Point, s : Sphere) -> f32 {
  return norm(pt.vec - s.center) + s.radius
}

func distmax_Point_Triangle(pt : Point, tri : Triangle) -> f32 {
  let d0 = norm(pt.vec - tri.p0) in
  let d1 = norm(pt.vec - tri.p1) in
  let d2 = norm(pt.vec - tri.p2) in
  return max(max(d0, d1), d2)
}

func distmax_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_AABB_AABB(a : AABB, b : AABB) -> f32 {
  let gap = max(max(a.low - b.high, b.low - a.high), f32x3(0f)) in
  return norm(gap)
}

func distmin_AABB_Point(a : AABB, pt : Point) -> f32 {
  return distmin_Point_AABB(pt, a)
}

func distmin_Point_AABB(pt : Point, a : AABB) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Point(p : Point, q : Point) -> f32 {
  return norm(p.vec - q.vec)
}

func distmin_Point_Sphere(pt : Point, s : Sphere) -> f32 {
  return max(norm(pt.vec - s.center) - s.radius, 0f)
}

func distmin_Point_Triangle(p : Point, tri : Triangle) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm(p.vec - pts[0].vec)
}

func distmin_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return (f32)inf
  }
}

func equals_AABB_AABB(a : AABB, b : AABB) -> bool {
  return reduce<all>((a.low == b.low) & (a.high == b.high))
}

func equals_Point_Point(p : Point, q : Point) -> bool {
  return reduce<all>(p.vec == q.vec)
}

func intersects_AABB_AABB(a : AABB, b : AABB) -> bool {
  return reduce<all>(max(a.low, b.low) <= min(a.high, b.high))
}

func intersects_AABB_Point(a : AABB, p : Point) -> bool {
  return contains_AABB_Point(a, p)
}

func intersects_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  let closest = min(max(s.center, a.low), a.high) in
  let d = closest - s.center in
  return reduce<+>(d * d) <= (s.radius * s.radius)
}

func intersects_AABB_Triangle(a : AABB, t : Triangle) -> bool {
  let c = f32x3(0.5f) * (a.low + a.high) in
  let e = f32x3(0.5f) * (a.high - a.low) in
  let v0 = t.p0 - c in
  let v1 = t.p1 - c in
  let v2 = t.p2 - c in
  let f0 = v1 - v0 in
  let f1 = v2 - v1 in
  let f2 = v0 - v2 in
  if (sat_axis_separates(cross_(build<f32x3>(1f, 0f, 0f), f0), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(1f, 0f, 0f), f1), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(1f, 0f, 0f), f2), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(0f, 1f, 0f), f0), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(0f, 1f, 0f), f1), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(0f, 1f, 0f), f2), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(0f, 0f, 1f), f0), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(0f, 0f, 1f), f1), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(build<f32x3>(0f, 0f, 1f), f2), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(build<f32x3>(1f, 0f, 0f), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(build<f32x3>(0f, 1f, 0f), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(build<f32x3>(0f, 0f, 1f), e, v0, v1, v2)) {
    return false
  }
  if (sat_axis_separates(cross_(f0, f1), e, v0, v1, v2)) {
    return false
  }
  return true
}

func intersects_Point_AABB(p : Point, a : AABB) -> bool {
  return contains_AABB_Point(a, p)
}

func intersects_Point_Point(p : Point, q : Point) -> bool {
  return equals_Point_Point(p, q)
}

func intersects_Ray_AABB(r : Ray, b : AABB) -> bool {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < r.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Sphere(ray : Ray, s : Sphere) -> bool {
  let interval = intersectsp_ray_sphere(ray, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < ray.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Triangle(ray : Ray, tri : Triangle) -> bool {
  return cast<bool>(intersectsp_ray_tri(ray, tri))
}

func intersects_Sphere_AABB(s : Sphere, a : AABB) -> bool {
  return intersects_AABB_Sphere(a, s)
}

func intersects_Triangle_AABB(t : Triangle, a : AABB) -> bool {
  return intersects_AABB_Triangle(a, t)
}

func lex_AABB_AABB(a : AABB, b : AABB) -> bool {
  return a.high[0u] <= b.low[0u]
}

func lex_AABB_Point(a : AABB, p : Point) -> bool {
  return a.high[0u] <= p.vec[0u]
}

func lex_Point_AABB(p : Point, a : AABB) -> bool {
  return p.vec[0u] <= a.low[0u]
}

func lex_Point_Point(p : Point, q : Point) -> bool {
