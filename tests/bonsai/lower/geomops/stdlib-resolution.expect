func q_closest(q : Point) -> Point {
  return _traverse_tree0(q, points)
}

func q_contains(r : AABB) -> set<Point> {
  return _traverse_tree1(r, points)
}

func q_covers(r : AABB) -> set<Point> {
  return _traverse_tree2(r, points)
}

func q_disjoint(r : AABB) -> set<Point> {
  return _traverse_tree3(r, points)
}

func q_equals(q : Point) -> set<Point> {
  return _traverse_tree4(q, points)
}

func q_farthest(q : Point) -> f32 {
  return _traverse_tree5(q, points)
}

func q_intersects(r : AABB) -> set<Point> {
  return _traverse_tree6(r, points)
}

func q_lex(r : AABB) -> set<Point> {
  return _traverse_tree7(r, points)
}

func q_ley(r : AABB) -> set<Point> {
  return _traverse_tree8(r, points)
}

func q_lez(r : AABB) -> set<Point> {
  return _traverse_tree9(r, points)
}

func q_ltx(r : AABB) -> set<Point> {
  return _traverse_tree10(r, points)
}

func q_lty(r : AABB) -> set<Point> {
  return _traverse_tree11(r, points)
}

func q_ltz(r : AABB) -> set<Point> {
  return _traverse_tree12(r, points)
}

func q_nearest(q : Point) -> f32 {
  return _traverse_tree13(q, points)
}

func q_touches(r : AABB) -> set<Point> {
  return _traverse_tree14(r, points)
}

func q_within(r : AABB) -> set<Point> {
  return _traverse_tree15(r, points)
}


