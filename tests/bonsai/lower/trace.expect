func _traverse_array0(n : u32, rays : Ray[n], triangles : (tl3*)) -> _option0[n] {
  alloc _alloc0 : mut _option0[n]
  forall _i0 in [0u:n:1u] {
    _alloc0[_i0] = _traverse_tree0((&rays[_i0]), triangles)
  }
  return (*_alloc0)
