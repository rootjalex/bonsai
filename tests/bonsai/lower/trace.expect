func _traverse_tree0(ray : (Ray*), triangles : (tl3*)) -> _option0 {
  _best0 : mut __tuple_0 := build<__tuple_0>((f32)inf, build<Triangle>())
  _queue_count0 : mut i32 := 1
  _queue0 : mut u32[64]
  _queue0[0] = 0u
  do {
    _queue_count0 -= 1
    let index = (*_queue0)[(*_queue_count0)] in
    if (intersects_Ray_AABB(ray, (&build<AABB>((*triangles).group_nodes0[index].low, (*triangles).group_nodes0[index].high)))) {
      if (distmin_Ray_AABB(ray, (&build<AABB>((*triangles).group_nodes0[index].low, (*triangles).group_nodes0[index].high))) < (*_best0)._field0) {
        if ((*triangles).group_nodes0[index].nPrims == 0u) {
          let _sort_cmp0 = cast<u8>(!((f32x3(1f) / (*ray).d)[(*triangles).group_nodes0[index].axis] < 0f)) < cast<u8>((f32x3(1f) / (*ray).d)[(*triangles).group_nodes0[index].axis] < 0f) in
          let _sort_tmp0 = select(_sort_cmp0, index + 1u, index + reinterpret_cast<tl0>((*triangles).group_nodes0[index].split0on_nPrims).offset) in
          let _sort_tmp1 = select(_sort_cmp0, index + reinterpret_cast<tl0>((*triangles).group_nodes0[index].split0on_nPrims).offset, index + 1u) in
          _queue0[(*_queue_count0)] = _sort_tmp0
          _queue0[(*_queue_count0) + 1] = _sort_tmp1
          _queue_count0 += 2
        } else {
          forall _idx0 in [reinterpret_cast<tl1>((*triangles).group_nodes0[index].split0on_nPrims).pOffset:reinterpret_cast<tl1>((*triangles).group_nodes0[index].split0on_nPrims).pOffset + cast<u32>((*triangles).group_nodes0[index].nPrims):1u] {
            if (intersectsp_ray_tri(ray, (&(*triangles).primitives[_idx0])).set) {
              if (distmin_Ray_Triangle(ray, (&(*triangles).primitives[_idx0])) < (*_best0)._field0) {
                _best0 argmin= build<__tuple_0>(distmin_Ray_Triangle(ray, (&(*triangles).primitives[_idx0])), (*triangles).primitives[_idx0])
              }
            }
          }
        }
      }
    }
  } while ((*_queue_count0) != 0)
  return select((*_best0)._field0 != (f32)inf, build<_option0>((*_best0)._field1, true), build<_option0>())
}

func _unexported_trace(ray : (Ray*), triangles : (tl3*)) -> _option0 {
  return _traverse_tree0(ray, triangles)
}

func distmax_AABB_AABB(a : (AABB*), b : (AABB*)) -> f32 {
  let span = max(abs((*a).low - (*b).high), abs((*a).high - (*b).low)) in
  return norm(span)
}

func distmax_AABB_Point(a : (AABB*), pt : (Point*)) -> f32 {
  return distmax_Point_AABB(pt, a)
}

func distmax_Point_AABB(pt : (Point*), a : (AABB*)) -> f32 {
  let span = max(abs((*pt).vec - (*a).low), abs((*pt).vec - (*a).high)) in
  return norm(span)
}

func distmax_Point_Point(p : (Point*), q : (Point*)) -> f32 {
  return norm((*p).vec - (*q).vec)
}

func distmax_Point_Sphere(pt : (Point*), s : (Sphere*)) -> f32 {
  return norm((*pt).vec - (*s).center) + (*s).radius
}

func distmax_Point_Triangle(pt : (Point*), tri : (Triangle*)) -> f32 {
  let d0 = norm((*pt).vec - (*tri).p0) in
  let d1 = norm((*pt).vec - (*tri).p1) in
  let d2 = norm((*pt).vec - (*tri).p2) in
  return max(max(d0, d1), d2)
}

func distmax_Ray_AABB(r : (Ray*), b : (AABB*)) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (interval.set) {
    let extract = interval.value in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : (Ray*), s : (Sphere*)) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (interval.set) {
    let extract = interval.value in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : (Ray*), tri : (Triangle*)) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (isect.set) {
    let isect_ = isect.value in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_AABB_AABB(a : (AABB*), b : (AABB*)) -> f32 {
  let gap = max(max((*a).low - (*b).high, (*b).low - (*a).high), f32x3(0f)) in
  return norm(gap)
}

func distmin_AABB_Point(a : (AABB*), pt : (Point*)) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_AABB(pt : (Point*), a : (AABB*)) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Point(p : (Point*), q : (Point*)) -> f32 {
  return norm((*p).vec - (*q).vec)
}

func distmin_Point_Sphere(pt : (Point*), s : (Sphere*)) -> f32 {
  return max(norm((*pt).vec - (*s).center) - (*s).radius, 0f)
}

func distmin_Point_Triangle(p : (Point*), tri : (Triangle*)) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm((*p).vec - pts._field0.vec)
}

func distmin_Ray_AABB(r : (Ray*), b : (AABB*)) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (interval.set) {
    let extract = interval.value in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : (Ray*), s : (Sphere*)) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (interval.set) {
    let extract = interval.value in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : (Ray*), tri : (Triangle*)) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (isect.set) {
    let isect_ = isect.value in
    return isect_.t
  } else {
    return (f32)inf
  }
