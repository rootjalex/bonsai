type AABB = struct AABB{ low : f32x3; high : f32x3 }
type BVH = (const BVH&)
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type arm_Interior = [[packed]] struct arm_Interior{ offset : u32 }
type arm_Leaf = [[packed]] struct arm_Leaf{ poffset : u32 }
type f32x3 = f32x3
type nodes = [[packed]] struct nodes{ low : f32x3; high : f32x3; nprims : u16; axis : u8; pad0 : u8; split0on_nprims : u8x4 }
type triangles = [[packed]] struct triangles{ primitive_count : u32; primitives : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[primitive_count]; node_count : u32; group_nodes0 : [[packed]] struct nodes{ low : f32x3; high : f32x3; nprims : u16; axis : u8; pad0 : u8; split0on_nprims : u8x4 }[node_count] }
type vec3f = f32x3
type vec3h = f16x3

extern triangles : [[packed]] struct triangles{ primitive_count : u32; primitives : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[primitive_count]; node_count : u32; group_nodes0 : [[packed]] struct nodes{ low : f32x3; high : f32x3; nprims : u16; axis : u8; pad0 : u8; split0on_nprims : u8x4 }[node_count] }

func _traverse_tree0(ray : Ray, triangles : triangles) -> option<Triangle> {
  _best0 : mut (f32, Triangle) := ((f32)inf, build<Triangle>())
  rec(index : u32) {
    if (triangles.group_nodes0[index].nprims == 0u) {
      if (intersects(ray, build<AABB>(triangles.group_nodes0[index].low, triangles.group_nodes0[index].high)) && (distmin(ray, build<AABB>(triangles.group_nodes0[index].low, triangles.group_nodes0[index].high)) < _best0[0])) {
        from (index + 1u, index + reinterpret_cast<arm_Interior>(triangles.group_nodes0[index].split0on_nprims).offset)
      }
    } else {
      foreach _iter0 in triangles.primitives[reinterpret_cast<arm_Leaf>(triangles.group_nodes0[index].split0on_nprims).poffset:reinterpret_cast<arm_Leaf>(triangles.group_nodes0[index].split0on_nprims).poffset + cast<u32>(triangles.group_nodes0[index].nprims)] {
        if (intersects(ray, build<AABB>(triangles.group_nodes0[index].low, triangles.group_nodes0[index].high)) && (distmin(ray, build<AABB>(triangles.group_nodes0[index].low, triangles.group_nodes0[index].high)) < _best0[0])) {
          if (intersects(ray, _iter0) && (distmin(ray, _iter0) < _best0[0])) {
            _best0 argmin= (distmin(ray, _iter0), _iter0)
          }
        }
      }
    }
  }
  yield select(_best0[0] != (f32)inf, build<option<Triangle>>(_best0[1]), build<option<Triangle>>())
}

func build_triangles(CT : (const BVH&)) -> triangles {
  ST : mut triangles
  primitives_index : mut idx
  nodes_index : mut idx
  rec_count_triangles(CT, ST)
  alloc primitives : mut Triangle[ST.primitive_count]
  ST.primitives = primitives
  alloc nodes : mut nodes[ST.node_count]
  ST.group_nodes0 = nodes
  rec_build_triangles(CT, ST, nodes_index, primitives_index)
  return ST
}

func distmax_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_Point_AABB(pt : Point, a : AABB) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Triangle(p : Point, tri : Triangle) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm(p.vec - pts[0].vec)
}

func distmin_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return (f32)inf
  }
}

func intersects_Ray_AABB(r : Ray, b : AABB) -> bool {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < r.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Sphere(ray : Ray, s : Sphere) -> bool {
  let interval = intersectsp_ray_sphere(ray, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < ray.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Triangle(ray : Ray, tri : Triangle) -> bool {
  return cast<bool>(intersectsp_ray_tri(ray, tri))
}

func rec_build_triangles(node : (const BVH&), ST : mut triangles, nodes_index : mut u32, primitives_index : mut idx) -> u32 {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&), axis : u8) with AABB(low, high) ->
    let this_index = nodes_index in
    nodes_index += 1u
    ST.group_nodes0[this_index].low = node.low
    ST.group_nodes0[this_index].high = node.high
    ST.group_nodes0[this_index].nprims = 0
    ST.group_nodes0[this_index].axis = argmax(node.high - node.low)
    let left_index = rec_build_triangles(node.left, ST, nodes_index, primitives_index) in
    let right_index = rec_build_triangles(node.right, ST, nodes_index, primitives_index) in
    ST.group_nodes0[this_index].split0on_nprims.offset = right_index - this_index
    return this_index
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high) ->
    let this_index = nodes_index in
    nodes_index += 1u
    ST.group_nodes0[this_index].low = node.low
    ST.group_nodes0[this_index].high = node.high
    ST.group_nodes0[this_index].axis = argmax(node.high - node.low)
    ST.group_nodes0[this_index].nprims = node.nprims
    ST.group_nodes0[this_index].split0on_nprims.poffset = primitives_index
    forall __p in [0u:node.nprims:1u] {
      let primitives[__p + primitives_index] = node.data[__p] in
    }
    primitives_index += node.nprims
    return this_index
  }
}

func rec_count_triangles(node : (const BVH&), ST : mut triangles) -> void {
  match node {
  | Interior(low : f32x3, high : f32x3, left : (const BVH&), right : (const BVH&), axis : u8) with AABB(low, high) ->
    ST.node_count += 1u
    rec_count_triangles(node.left, ST)
    rec_count_triangles(node.right, ST)
  | Leaf(low : f32x3, high : f32x3, nprims : u16, data : Triangle[nprims]) with AABB(low, high) ->
    ST.node_count += 1u
    ST.primitive_count += node.nprims
  }
}

func [[export]] trace(ray : Ray) -> option<Triangle> {
  return _traverse_tree0(ray, triangles)
}


