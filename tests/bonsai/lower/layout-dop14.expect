type AABB = struct AABB{ low : f32x3; high : f32x3 }
type BVH = (const BVH&)
type DOP14 = struct DOP14{ low : f32x7; high : f32x7; early_exit : u1 }
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type f32x3 = f32x3
type f32x4 = f32x4
type f32x7 = f32x7
type tl0 = [[packed]] struct tl0{ lo2 : f32x4; hi2 : f32x4 }
type tl1 = [[packed]] struct tl1{ left : u32 }
type tl2 = [[packed]] struct tl2{ leaf_size : u4; tri_address : u28 }
type tl3 = [[packed]] struct tl3{ lo1 : f32x3; hi1 : f32x3; ee : u1; is_leaf_flag : u1; pad0 : u30; right : u32; split0on_is_leaf_flag : u8x4 }
type tl4 = [[packed]] struct tl4{ primitive_count : u32; primitives : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[primitive_count]; node_count : u32; group_dop360 : [[packed]] struct tl0{ lo2 : f32x4; hi2 : f32x4 }[node_count]; group_nodes1 : [[packed]] struct tl3{ lo1 : f32x3; hi1 : f32x3; ee : u1; is_leaf_flag : u1; pad0 : u30; right : u32; split0on_is_leaf_flag : u8x4 }[node_count] }
type vec3f = f32x3
type vec3h = f16x3

extern triangles : [[packed]] struct tl4{ primitive_count : u32; primitives : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[primitive_count]; node_count : u32; group_dop360 : [[packed]] struct tl0{ lo2 : f32x4; hi2 : f32x4 }[node_count]; group_nodes1 : [[packed]] struct tl3{ lo1 : f32x3; hi1 : f32x3; ee : u1; is_leaf_flag : u1; pad0 : u30; right : u32; split0on_is_leaf_flag : u8x4 }[node_count] }

func _traverse_tree0(ray : Ray, triangles : tl4) -> set<Triangle> {
  rec(index : u32) {
    if (triangles.group_nodes1[index].is_leaf_flag == 0u) {
      if (intersects(ray, build<DOP14>(build<f32x7>(triangles.group_nodes1[index].lo1[0], triangles.group_nodes1[index].lo1[1], triangles.group_nodes1[index].lo1[2], triangles.group_dop360[index].lo2[0], triangles.group_dop360[index].lo2[1], triangles.group_dop360[index].lo2[2], triangles.group_dop360[index].lo2[3]), build<f32x7>(triangles.group_nodes1[index].hi1[0], triangles.group_nodes1[index].hi1[1], triangles.group_nodes1[index].hi1[2], triangles.group_dop360[index].hi2[0], triangles.group_dop360[index].hi2[1], triangles.group_dop360[index].hi2[2], triangles.group_dop360[index].hi2[3]), triangles.group_nodes1[index].ee))) {
        from (reinterpret_cast<tl1>(triangles.group_nodes1[index].split0on_is_leaf_flag).left, triangles.group_nodes1[index].right)
      }
    } else {
      foreach _iter0 in triangles.primitives[reinterpret_cast<tl2>(triangles.group_nodes1[index].split0on_is_leaf_flag).tri_address:reinterpret_cast<tl2>(triangles.group_nodes1[index].split0on_is_leaf_flag).tri_address + cast<u28>(reinterpret_cast<tl2>(triangles.group_nodes1[index].split0on_is_leaf_flag).leaf_size)] {
        if (intersects(ray, build<DOP14>(build<f32x7>(triangles.group_nodes1[index].lo1[0], triangles.group_nodes1[index].lo1[1], triangles.group_nodes1[index].lo1[2], triangles.group_dop360[index].lo2[0], triangles.group_dop360[index].lo2[1], triangles.group_dop360[index].lo2[2], triangles.group_dop360[index].lo2[3]), build<f32x7>(triangles.group_nodes1[index].hi1[0], triangles.group_nodes1[index].hi1[1], triangles.group_nodes1[index].hi1[2], triangles.group_dop360[index].hi2[0], triangles.group_dop360[index].hi2[1], triangles.group_dop360[index].hi2[2], triangles.group_dop360[index].hi2[3]), triangles.group_nodes1[index].ee))) {
          if (intersects(ray, _iter0)) {
            yield _iter0
          }
        }
      }
    }
  }
}

func distmax_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_Point_AABB(pt : Point, a : AABB) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Triangle(p : Point, tri : Triangle) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm(p.vec - pts[0].vec)
}

func distmin_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return (f32)inf
  }
}

func intersects_Ray_AABB(r : Ray, b : AABB) -> bool {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < r.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Sphere(ray : Ray, s : Sphere) -> bool {
  let interval = intersectsp_ray_sphere(ray, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < ray.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Triangle(ray : Ray, tri : Triangle) -> bool {
  return cast<bool>(intersectsp_ray_tri(ray, tri))
}

func [[export]] trace(ray : Ray) -> set<Triangle> {
  return _traverse_tree0(ray, triangles)
}


