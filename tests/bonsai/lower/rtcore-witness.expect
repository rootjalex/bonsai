func __closesthit__trace() -> void {
  let _rt_set1 = rt_set_payload(1u, cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), extract_element(rt_barycentrics(), 0), extract_element(rt_barycentrics(), 1)).hit)) in
  let _rt_set2 = rt_set_payload(2u, build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), extract_element(rt_barycentrics(), 0), extract_element(rt_barycentrics(), 1)).idx) in
  let _rt_set3 = rt_set_payload(3u, reinterpret_cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), extract_element(rt_barycentrics(), 0), extract_element(rt_barycentrics(), 1)).t)) in
  let _rt_set4 = rt_set_payload(4u, reinterpret_cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), extract_element(rt_barycentrics(), 0), extract_element(rt_barycentrics(), 1)).b0)) in
  let _rt_set5 = rt_set_payload(5u, reinterpret_cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), extract_element(rt_barycentrics(), 0), extract_element(rt_barycentrics(), 1)).b1)) in
}

func __closesthit__trace$boxes() -> void {
  let _rt_set1 = rt_set_payload(1u, cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), 0f, 0f).hit)) in
  let _rt_set2 = rt_set_payload(2u, build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), 0f, 0f).idx) in
  let _rt_set3 = rt_set_payload(3u, reinterpret_cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), 0f, 0f).t)) in
  let _rt_set4 = rt_set_payload(4u, reinterpret_cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), 0f, 0f).b0)) in
  let _rt_set5 = rt_set_payload(5u, reinterpret_cast<u32>(build<_RTHit_trace>(true, rt_sbt_record().base + rt_primitive_index(), rt_hit_t(), 0f, 0f).b1)) in
}

func __intersection__trace(tris : tree[[Tri]] OptixTree) -> void {
  let _rt_rec = rt_sbt_record() in
  let _rt_idx = _rt_rec.base + rt_primitive_index() in
  let _rt_e0 = stored_element(tris, _rt_idx) in
  let r = build<Ray>(build<Ray>(rt_ray_origin(), rt_ray_direction(), reinterpret_cast<f32>(rt_payload(0u))).o, build<Ray>(rt_ray_origin(), rt_ray_direction(), reinterpret_cast<f32>(rt_payload(0u))).d, rt_hit_t()) in
  let _rt_t = distmin(r, _rt_e0.tri) in
  if (_rt_t != (f32)inf) {
    let _rt_reported = rt_report_hit(_rt_t) in
  }
}

func __intersection__trace_any(tris : tree[[Tri]] OptixTree) -> void {
  let _rt_rec = rt_sbt_record() in
  let _rt_idx = _rt_rec.base + rt_primitive_index() in
  let _rt_e0 = stored_element(tris, _rt_idx) in
  let r = build<Ray>(build<Ray>(rt_ray_origin(), rt_ray_direction(), reinterpret_cast<f32>(rt_payload(0u))).o, build<Ray>(rt_ray_origin(), rt_ray_direction(), reinterpret_cast<f32>(rt_payload(0u))).d, rt_hit_t()) in
  let _rt_t = distmin(r, _rt_e0.tri) in
  if (_rt_t != (f32)inf) {
    let _rt_reported = rt_report_hit(_rt_t) in
  }
}

func __miss__trace() -> void {
  return
}

func __miss__trace_any() -> void {
  let _rt_set1 = rt_set_payload(1u, cast<u32>(false)) in
  return
}

func _rt_trace0(tris : tree[[Tri]] OptixTree, r : Ray) -> option<(Tri, Hit)> {
  let _rt_ctx_out = rt_trace(rt_traversable(tris), r.o, r.d, 1e-07f, min(r.tmax, 1e+30f), 0u, build<_RTContext_trace>(r.tmax, build<_RTHit_trace>(false, 0u, 0f, 0f, 0f))) in
  let _rt_hit = _rt_ctx_out.result in
  if (_rt_hit.hit) {
    let _rt_idx = _rt_hit.idx in
    let _rt_e0 = stored_element(tris, _rt_idx) in
    let _rt_e1 = build<Hit>(_rt_hit.t, interleave(_rt_hit.b0, _rt_hit.b1)) in
    return build<option<(Tri, Hit)>>((_rt_e0, _rt_e1))
  } else {
    return build<option<(Tri, Hit)>>()
  }
}

func _rt_trace0!hit(tris : tree[[Tri]] OptixTree, r : Ray) -> option<(Tri, Hit)> {
  let _rt_set_hit = rt_set_payload(1u, 1u) in
  let _rt_rec = rt_sbt_record() in
  let _rt_idx = _rt_rec.base + rt_primitive_index() in
  let _rt_e0 = stored_element(tris, _rt_idx) in
  let _rt_e1 = build<Hit>(rt_hit_t(), rt_barycentrics()) in
  return build<option<(Tri, Hit)>>((_rt_e0, _rt_e1))
}

func _rt_trace0!hit$boxes(tris : tree[[Tri]] OptixTree, r : Ray) -> option<(Tri, Hit)> {
  let _rt_set_hit = rt_set_payload(1u, 1u) in
  let _rt_rec = rt_sbt_record() in
  let _rt_idx = _rt_rec.base + rt_primitive_index() in
  let _rt_e0 = stored_element(tris, _rt_idx) in
  let _rt_e1 = build<Hit>(rt_hit_t(), f32x2(0f)) in
  return build<option<(Tri, Hit)>>((_rt_e0, _rt_e1))
}

func _rt_trace1(tris : tree[[Tri]] OptixTree, r : Ray) -> bool {
  let _rt_ctx_out = rt_trace(rt_traversable(tris), r.o, r.d, 1e-07f, min(r.tmax, 1e+30f), 12u, build<_RTContext_trace_any>(r.tmax, true)) in
  return _rt_ctx_out.result
}

func accepts(r : Ray, t : Tri, h : Hit) -> bool {
  if (t.alpha < 0f) {
    return true
  }
  return h.b[0u] < t.alpha
}

func trace(r : Ray) -> option<(Tri, Hit)> {
  return _rt_trace0(tris, r)
}

func [[export]] trace_all(n : i32, rays : Ray[n], hit_t : mut f32[], hit_b1 : mut f32[], hit_any : mut i32[]) -> void {
  parfor i in [0:n:1] {
    let r = rays[i] in
    let found = trace(r) in
    if (cast<bool>(found)) {
      let hit = cast<(Tri, Hit)>(found) in
      hit_t[i] = hit[1].t
      hit_b1[i] = hit[1].b[0u]
    } else {
      hit_t[i] = -1f
      hit_b1[i] = -1f
    }
    hit_any[i] = select(trace_any(r), 1, 0)
  }
  return
}

func trace_any(r : Ray) -> bool {
  return _rt_trace1(tris, r)
}

func [[export]] trace_any_anyhit_matters(_rt_e0 : Tri) -> bool {
  return !(_rt_e0.alpha < 0f)
}

func [[export]] trace_anyhit_matters(_rt_e0 : Tri) -> bool {
  return !(_rt_e0.alpha < 0f)
}


schedule {
    tris : tree[[struct Tri{ tri : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }; alpha : f32 }]] OptixTree
  | Leaf(data : Tri[]) with data = data
    tris :       {
        n : u32;
        elems : struct Tri{ tri : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }; alpha : f32 }[n];
      };

    trace.bind(, RTCore)
    trace_all.bind(i, OptixThread)
    trace_any.bind(, RTCore)

}
