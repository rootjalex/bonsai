type AABB = struct AABB{ low : f32x3; high : f32x3 }
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Hit = struct Hit{ t : f32; b : f32x2 }
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Tri = struct Tri{ tri : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }; alpha : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type _RTContext_trace = struct _RTContext_trace{ tmax : f32; result : struct _RTHit_trace{ hit : bool; idx : u32; t : f32; b0 : f32; b1 : f32 } }
type _RTContext_trace_any = struct _RTContext_trace_any{ tmax : f32; result : bool }
type _RTHit_trace = struct _RTHit_trace{ hit : bool; idx : u32; t : f32; b0 : f32; b1 : f32 }
type _RTRecord = struct _RTRecord{ base : u32; holder : u32 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

extern tris : tree[[struct Tri{ tri : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }; alpha : f32 }]] OptixTree
  | Leaf(data : Tri[]) with data = data

func __anyhit__trace(tris : tree[[Tri]] OptixTree) -> void {
  let _rt_rec = rt_sbt_record() in
  let _rt_idx = _rt_rec.base + rt_primitive_index() in
  let _rt_e0 = stored_element(tris, _rt_idx) in
  let _rt_e1 = build<Hit>(rt_hit_t(), rt_barycentrics()) in
  let r = build<Ray>(rt_ray_origin(), rt_ray_direction(), reinterpret_cast<f32>(rt_payload(0u))) in
  if (!accepts(r, _rt_e0, _rt_e1)) {
    let _rt_ignored = rt_ignore_hit() in
  }
}

func __anyhit__trace$boxes(tris : tree[[Tri]] OptixTree) -> void {
  let _rt_rec = rt_sbt_record() in
  let _rt_idx = _rt_rec.base + rt_primitive_index() in
  let _rt_e0 = stored_element(tris, _rt_idx) in
  let _rt_e1 = build<Hit>(rt_hit_t(), f32x2(0f)) in
  let r = build<Ray>(rt_ray_origin(), rt_ray_direction(), reinterpret_cast<f32>(rt_payload(0u))) in
  if (!accepts(r, _rt_e0, _rt_e1)) {
    let _rt_ignored = rt_ignore_hit() in
  }
}

