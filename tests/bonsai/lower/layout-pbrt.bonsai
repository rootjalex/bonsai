//! flags: -p canonicalize -p verify-layouts -p lower-trees -p lower-layouts 

import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles));

element f32x3 = vector[f32, 3];

schedule {
    tree[[Triangle]] BVH(low high : f32x3) with AABB(low, high) 
      = Interior(left : BVH, right : BVH, axis : u8)
      | Leaf(nprims: u16, data : array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(index: u32) {
        primitive_count : u32;
        primitives : array[Triangle, primitive_count];
        node_count : u32;
        group nodes[node_count] by index {
            low : f32x3;
            high : f32x3;
            nprims : u16;
            axis : u8;
            8;
            split nprims {
                0 -> Interior { 
                    offset : u32; 
                    left = index + 1; 
                    right = index + offset; 
                };
                _ -> Leaf { 
                    poffset : u32; 
                    data = primitives[poffset : poffset + nprims]; 
                };
            };
        };
    };

    build triangles {
      build Interior(lo: f32x3, hi: f32x3, left: BVH, right: BVH) {
        build lo;
        build hi;
        build nprims = 0;
        build axis = argmax(hi - lo);
        recurse left;
        recurse right;
        build offset = right - this;
        return this;
      };
    };
}
