type Float = f32

extern scale : f32[4]
extern offset : f32[4]
extern bias : f32[4]

func biased(i : u32, scale : f32[4], bias : f32[4]) -> f32 {
  return bias[i] + (scale[i] * 100f)
}

func [[export]] both(i : u32, scale : f32[4], offset : f32[4], bias : f32[4]) -> f32 {
  return (offset[i] + (scale[i] * 10f)) + (bias[i] + amplify(i, scale))
}


