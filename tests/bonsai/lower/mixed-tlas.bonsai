//! flags: -p canonicalize -p lower-set-functions -p lower-trees -p lower-sorts -p pull-queries

// A tree whose elements are of two kinds: a triangle standing on its own, and
// an instance holding a whole tree of them. pbrt's top-level BVHAggregate is
// exactly this -- its primitives are a mix of GeometricPrimitive and
// TransformedPrimitive, and `Primitive::Intersect` dispatches on which.
//
// The element is a variant, and the set a query reaches through one of them
// depends on the arm: one triangle, or an instance's tree. `geometry` says
// which, once, as a set-valued function, and the queries and the element's
// extent all name it -- pbrt's `Primitive::Bounds()` and `Primitive::Intersect`
// dispatch on the same tag, and so do these.
//
// What to read for in the outer leaf's element loop:
//
//   - `match _iter0 { Solo => ..; Inst => .. }`: one tag test per element,
//     which is what pbrt's dispatch costs. The Solo arm tests its triangle
//     against the ray and nothing else -- no transform, no pulled ray, no
//     walk. The Inst arm pulls the ray back once (`_pulled0`) and walks the
//     instance's tree against it, exactly as tree-traversal-instanced does
//     when every element is an instance.
//
//   - the outer leaf is guarded once, by its own box, ahead of the loop --
//     because `with extent` bounds `transform(p, tri)` for every arm at once,
//     and the node's box bounds the extent.
//
//   - the value yielded is `(_iter0, (_iter0 as Solo).tri)` in one arm and
//     `(_iter0, _iter1)` in the other: the hit as stored, with the primitive
//     it came through, and one transform of the result left to the caller.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func untransform(t : Transform, r : Ray) -> Ray {
    o = t.i0 * r.o.x + t.i1 * r.o.y + t.i2 * r.o.z + t.i3;
    d = t.i0 * r.d.x + t.i1 * r.d.y + t.i2 * r.d.z;
    out : Ray = {o, d, r.tmax};
    return out;
}

// pbrt: Primitive, a TaggedPointer over GeometricPrimitive and
// TransformedPrimitive.
element Prim =
    | Solo(tri : Triangle)
    | Inst(render_from_instance : Transform, blas : set[Triangle]);

// pbrt: what Primitive::Intersect dispatches to. A set, because the two arms
// hold different numbers of things.
func geometry(p : Prim) -> set[Triangle] =
    match p { Solo(tri) => set[Triangle]{tri}, Inst(m, blas) => blas };

// pbrt: Primitive::Bounds(): the shape's own bounds for one arm, the held
// tree's bounds placed by the transform for the other -- said once, as the
// geometry the primitive holds, placed by the primitive. After `geometry`,
// since it names it.
element Prim with extent = |p| transform(p, geometry(p).AABB);

// The primitive as a motion: a TransformedPrimitive moves what it holds, a
// GeometricPrimitive holds it where it is. pbrt's `Transform::operator()` and
// `ApplyInverse` in TransformedPrimitive, and nothing in GeometricPrimitive.
func transform(p : Prim, b : AABB) -> AABB {
    match p {
        Solo(tri) => return b;
        Inst(m, blas) => return transform(m, b);
    }
}

func untransform(p : Prim, r : Ray) -> Ray {
    match p {
        Solo(tri) => return r;
        Inst(m, blas) => return untransform(m, r);
    }
}

extern prims : set[Prim];

// pbrt: Primitive::Intersect over the scene: of every triangle, standing alone
// or placed by an instance, the nearest the ray hits.
func trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, transform(p, tri)),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, transform(p, tri)) &&
                      distmin(r, transform(p, tri)) > 0.001,
                  flatten(|p : Prim| geometry(p), prims)));

schedule {
    layout Prim = tagged_index;

    tree[[Triangle]] BLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : BLAS, right : BLAS, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    tree[[Prim]] TLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : TLAS, right : TLAS, axis : u8)
    | Leaf(data : array[Prim]) with data = data;

    prims : TLAS;
    Inst.blas : BLAS from BlasNodes;

    trace.sort(prims.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)));
    trace.sort(Inst.blas.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)));

    layout prims {
        tCount : u32;
        tris : array[Triangle, tCount];

        bCount : u32;
        indirect group BlasNodes[bCount] bnode : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = bnode + 1;
                                right = bnode + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(tris, pOffset, cast[[u32]](nPrims)); };
            };
        };

        pCount : u32;
        elems : array[Prim, pCount];

        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1;
                                right = index + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(elems, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };
}
