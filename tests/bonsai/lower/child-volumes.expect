type AABB = struct AABB{ low : f32x3; high : f32x3 }
type BVH4 = (const BVH4&)
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

extern tris : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH4
  | Interior(c0 : (const BVH4&), c1 : (const BVH4&), c2 : (const BVH4&), c3 : (const BVH4&), l0 : f32x3, l1 : f32x3, l2 : f32x3, l3 : f32x3, h0 : f32x3, h1 : f32x3, h2 : f32x3, h3 : f32x3) with AABB(l0, h0) on c0 with AABB(l1, h1) on c1 with AABB(l2, h2) on c2 with AABB(l3, h3) on c3
  | Leaf(data : Triangle[]) with data = data

func _traverse_tree0(r : Ray, tris : tree[[Triangle]] BVH4) -> bool {
  _holds0 : mut bool := false
  rec(tris : tree[[Triangle]] BVH4) {
    match tris {
    | Interior(c0 : (const BVH4&), c1 : (const BVH4&), c2 : (const BVH4&), c3 : (const BVH4&), l0 : f32x3, l1 : f32x3, l2 : f32x3, l3 : f32x3, h0 : f32x3, h1 : f32x3, h2 : f32x3, h3 : f32x3) with AABB(l0, h0) on c0 with AABB(l1, h1) on c1 with AABB(l2, h2) on c2 with AABB(l3, h3) on c3 ->
      if (!_holds0) {
        if (contains(r, build<AABB>((tris as Interior).l0, (tris as Interior).h0))) {
          _holds0 = true
        }
        if (contains(r, build<AABB>((tris as Interior).l1, (tris as Interior).h1))) {
          _holds0 = true
        }
        if (contains(r, build<AABB>((tris as Interior).l2, (tris as Interior).h2))) {
          _holds0 = true
        }
        if (contains(r, build<AABB>((tris as Interior).l3, (tris as Interior).h3))) {
          _holds0 = true
        }
        from ((tris as Interior).c0, (tris as Interior).c1, (tris as Interior).c2, (tris as Interior).c3) where (intersects(r, build<AABB>((tris as Interior).l0, (tris as Interior).h0)), intersects(r, build<AABB>((tris as Interior).l1, (tris as Interior).h1)), intersects(r, build<AABB>((tris as Interior).l2, (tris as Interior).h2)), intersects(r, build<AABB>((tris as Interior).l3, (tris as Interior).h3)))
      }
    | Leaf(data : Triangle[]) with data = data ->
      if (!_holds0) {
        foreach _iter0 in (tris as Leaf).data {
          if (!_holds0) {
            _holds0 = _holds0 || intersects(r, _iter0)
          }
        }
      }
    }
  }
  yield _holds0
}

func _traverse_tree1(r : Ray, tris : tree[[Triangle]] BVH4) -> option<Triangle> {
  _best0 : mut (f32, (ref[Triangle in tris])) := ((f32)inf, ())
  rec(tris : tree[[Triangle]] BVH4) {
    match tris {
    | Interior(c0 : (const BVH4&), c1 : (const BVH4&), c2 : (const BVH4&), c3 : (const BVH4&), l0 : f32x3, l1 : f32x3, l2 : f32x3, l3 : f32x3, h0 : f32x3, h1 : f32x3, h2 : f32x3, h3 : f32x3) with AABB(l0, h0) on c0 with AABB(l1, h1) on c1 with AABB(l2, h2) on c2 with AABB(l3, h3) on c3 ->
      from ((tris as Interior).c0, (tris as Interior).c1, (tris as Interior).c2, (tris as Interior).c3) where (intersects(r, build<AABB>((tris as Interior).l0, (tris as Interior).h0)) && (distmin(r, build<AABB>((tris as Interior).l0, (tris as Interior).h0)) < _best0[0]), intersects(r, build<AABB>((tris as Interior).l1, (tris as Interior).h1)) && (distmin(r, build<AABB>((tris as Interior).l1, (tris as Interior).h1)) < _best0[0]), intersects(r, build<AABB>((tris as Interior).l2, (tris as Interior).h2)) && (distmin(r, build<AABB>((tris as Interior).l2, (tris as Interior).h2)) < _best0[0]), intersects(r, build<AABB>((tris as Interior).l3, (tris as Interior).h3)) && (distmin(r, build<AABB>((tris as Interior).l3, (tris as Interior).h3)) < _best0[0]))
    | Leaf(data : Triangle[]) with data = data ->
      foreach _iter1 in (tris as Leaf).data {
        if (intersects(r, _iter1) && (distmin(r, _iter1) < _best0[0])) {
          _best0 = (distmin(r, _iter1), (ref(_iter1)))
        }
      }
    }
  }
  _best0_result : mut option<Triangle> := build<option<Triangle>>()
  if (_best0[0] != (f32)inf) {
    _best0_result = build<option<Triangle>>((*_best0[1][0]))
  }
  yield _best0_result
}

func [[export]] occluded(r : Ray) -> bool {
  return _traverse_tree0(r, tris)
}

func [[export]] trace(r : Ray) -> option<Triangle> {
  return _traverse_tree1(r, tris)
}


schedule host {
    tris : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH4
  | Interior(c0 : (const BVH4&), c1 : (const BVH4&), c2 : (const BVH4&), c3 : (const BVH4&), l0 : f32x3, l1 : f32x3, l2 : f32x3, l3 : f32x3, h0 : f32x3, h1 : f32x3, h2 : f32x3, h3 : f32x3) with AABB(l0, h0) on c0 with AABB(l1, h1) on c1 with AABB(l2, h2) on c2 with AABB(l3, h3) on c3
  | Leaf(data : Triangle[]) with data = data
    tris :       {
        pCount : u32;
        prims : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[pCount];
        nCount : u32;
        group[nCount] row : u32
        {
          children : u32x4;
          lower_x : f32x4;
          upper_x : f32x4;
          lower_y : f32x4;
          upper_y : f32x4;
          lower_z : f32x4;
          upper_z : f32x4;
          c0 = children[(i32)0];
          c1 = children[(i32)1];
          c2 = children[(i32)2];
          c3 = children[(i32)3];
          l0 = build<f32x3>(lower_x[(i32)0], lower_y[(i32)0], lower_z[(i32)0]);
          h0 = build<f32x3>(upper_x[(i32)0], upper_y[(i32)0], upper_z[(i32)0]);
          l1 = build<f32x3>(lower_x[(i32)1], lower_y[(i32)1], lower_z[(i32)1]);
          h1 = build<f32x3>(upper_x[(i32)1], upper_y[(i32)1], upper_z[(i32)1]);
          l2 = build<f32x3>(lower_x[(i32)2], lower_y[(i32)2], lower_z[(i32)2]);
          h2 = build<f32x3>(upper_x[(i32)2], upper_y[(i32)2], upper_z[(i32)2]);
          l3 = build<f32x3>(lower_x[(i32)3], lower_y[(i32)3], lower_z[(i32)3]);
          h3 = build<f32x3>(upper_x[(i32)3], upper_y[(i32)3], upper_z[(i32)3]);
        };
        group[nCount] ref : u32
        {
          kind = ref & (u32)15;
          switch kind {
          0 => Interior
            from Nodes[ref >> (u32)4]          _ => Leaf
            {
              data = range(prims, ref >> (u32)4, kind - (u32)8);
            };
          };
        };
      };


}
