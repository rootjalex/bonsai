type AABB = struct AABB{ low : f32x3; high : f32x3 }
type BVH4 = (const BVH4&)
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

extern tris : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data

func _traverse_tree0(r : Ray, tris : tree[[Triangle]] BVH4) -> bool {
  _holds0 : mut bool := false
  rec(tris : tree[[Triangle]] BVH4) {
    match tris {
    | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children ->
      if (!_holds0) {
        _mask0 : mut bool[4]
        parfor children in [0u:4u:1u] {
          _mask0[children] = intersects(r, build<AABB>((tris as Interior).lo[children], (tris as Interior).hi[children]))
          if (contains(r, build<AABB>((tris as Interior).lo[children], (tris as Interior).hi[children]))) {
            _holds0 = true
          }
        }
        from ((tris as Interior).children[0u], (tris as Interior).children[1u], (tris as Interior).children[2u], (tris as Interior).children[3u]) where (_mask0[0u], _mask0[1u], _mask0[2u], _mask0[3u])
      }
    | Leaf(data : Triangle[]) with data = data ->
      if (!_holds0) {
        foreach _iter0 in (tris as Leaf).data {
          if (!_holds0) {
            _holds0 = _holds0 || intersects(r, _iter0)
          }
        }
      }
    }
  }
  yield _holds0
}

func _traverse_tree1(r : Ray, tris : tree[[Triangle]] BVH4) -> option<Triangle> {
  _best0 : mut (f32, (ref[Triangle in tris])) := ((f32)inf, ())
  rec(tris : tree[[Triangle]] BVH4) {
    match tris {
    | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children ->
      _mask1 : mut bool[4]
      parfor children in [0u:4u:1u] {
        _mask1[children] = intersects(r, build<AABB>((tris as Interior).lo[children], (tris as Interior).hi[children])) && (distmin(r, build<AABB>((tris as Interior).lo[children], (tris as Interior).hi[children])) < _best0[0])
      }
      from ((tris as Interior).children[0u], (tris as Interior).children[1u], (tris as Interior).children[2u], (tris as Interior).children[3u]) where (_mask1[0u], _mask1[1u], _mask1[2u], _mask1[3u])
    | Leaf(data : Triangle[]) with data = data ->
      foreach _iter1 in (tris as Leaf).data {
        if (intersects(r, _iter1) && (distmin(r, _iter1) < _best0[0])) {
          _best0 = (distmin(r, _iter1), (ref(_iter1)))
        }
      }
    }
  }
  _best0_result : mut option<Triangle> := build<option<Triangle>>()
  if (_best0[0] != (f32)inf) {
    _best0_result = build<option<Triangle>>((*_best0[1][0]))
  }
  yield _best0_result
}

func [[export]] occluded(r : Ray) -> bool {
  return _traverse_tree0(r, tris)
}

func [[export]] trace(r : Ray) -> option<Triangle> {
  return _traverse_tree1(r, tris)
}


schedule host {
    tris : tree[[struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }]] BVH4
  | Interior(children : (const BVH4&)[4], lo : f32x3x4, hi : f32x3x4) with AABB(lo, hi) on children
  | Leaf(data : Triangle[]) with data = data
    tris :       {
        pCount : u32;
        prims : struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }[pCount];
        nCount : u32;
        group[nCount] row : u32
        {
          children : u32x4;
          lo : f32x3x4;
          hi : f32x3x4;
        };
        group[nCount] ref : u32
        {
          kind = ref & (u32)15;
          switch kind {
          0 => Interior
            from Nodes[ref >> (u32)4]          _ => Leaf
            {
              data = range(prims, ref >> (u32)4, kind - (u32)8);
            };
          };
        };
      };


}
