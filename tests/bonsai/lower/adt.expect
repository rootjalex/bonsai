type Float = f32
type Half = f16
type Shape = struct Shape{ tag : u8; _pad : [[packed]] u8x15; payload : [[packed]] u32x12 }
type Sph = struct Sph{ center : f32x3; radius : f32 }
type Tri = struct Tri{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type vec2f = f32x2
type vec3f = f32x3
type vec3h = f16x3
type vec4f = f32x4

func [[export]] Shape_Sph(_ret0 : mut (Shape*), center : f32x3, radius : f32) -> void {
  _ret0 = build<Shape>(0u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x12>(reinterpret_cast<u32>(center[0u]), reinterpret_cast<u32>(center[1u]), reinterpret_cast<u32>(center[2u]), 0u, reinterpret_cast<u32>(radius), 0u, 0u, 0u, 0u, 0u, 0u, 0u))
  return
}

func [[export]] Shape_Tri(_ret1 : mut (Shape*), p0 : f32x3, p1 : f32x3, p2 : f32x3) -> void {
  _ret1 = build<Shape>(1u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x12>(reinterpret_cast<u32>(p0[0u]), reinterpret_cast<u32>(p0[1u]), reinterpret_cast<u32>(p0[2u]), 0u, reinterpret_cast<u32>(p1[0u]), reinterpret_cast<u32>(p1[1u]), reinterpret_cast<u32>(p1[2u]), 0u, reinterpret_cast<u32>(p2[0u]), reinterpret_cast<u32>(p2[1u]), reinterpret_cast<u32>(p2[2u]), 0u))
  return
}

func [[export]] area(s : (Shape*)) -> f32 {
  switch ((*s).tag) {
  case 0: { // Shape.Sph of area
    let center = build<f32x3>(reinterpret_cast<f32>((*s).payload[0u]), reinterpret_cast<f32>((*s).payload[1u]), reinterpret_cast<f32>((*s).payload[2u])) in
    let radius = reinterpret_cast<f32>((*s).payload[4u]) in
    return ((4f * 3.14159f) * radius) * radius
  } break;
  default: { // Shape.Tri of area
    let p0 = build<f32x3>(reinterpret_cast<f32>((*s).payload[0u]), reinterpret_cast<f32>((*s).payload[1u]), reinterpret_cast<f32>((*s).payload[2u])) in
    let p1 = build<f32x3>(reinterpret_cast<f32>((*s).payload[4u]), reinterpret_cast<f32>((*s).payload[5u]), reinterpret_cast<f32>((*s).payload[6u])) in
    let p2 = build<f32x3>(reinterpret_cast<f32>((*s).payload[8u]), reinterpret_cast<f32>((*s).payload[9u]), reinterpret_cast<f32>((*s).payload[10u])) in
    return 0.5f * norm(cross(p1 - p0, p2 - p0))
  }
  }
}

func [[export]] unit_sphere(_ret2 : mut (Shape*)) -> void {
  _ret2 = build<Shape>(0u, ([[packed]] u8x15)[0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u,0u], build<[[packed]] u32x12>(reinterpret_cast<u32>(0f), reinterpret_cast<u32>(0f), reinterpret_cast<u32>(0f), 0u, reinterpret_cast<u32>(1f), 0u, 0u, 0u, 0u, 0u, 0u, 0u))
  return
}


