type X = struct X{ x : i32 }

func [[export]] A($return0 : mut X, x : X) -> void {
  $return0 = x
  return
}

func [[export]] B($return1 : mut X, x : X) -> void {
  A($return1, x)
  return
}

func [[export]] C($return2 : mut X, x : X) -> void {
  $return2 = x
  return
}

func [[export]] D($return3 : mut X, x : X) -> void {
  y := build<X>()
  C(y, x)
  $return3 = y
  return
}


