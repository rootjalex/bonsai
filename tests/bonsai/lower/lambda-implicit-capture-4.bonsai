func bar() -> i32 {
  w: i32 = 1;
  L1 = 
    |x: i32| {              // Needs to capture `w`.
         |y: i32| {         // Needs to capture `w`, `x`.
           |z: i32| {       // Needs to capture `w`, `x`, `y`.
             w + x + y + z 
           }
         } 
  };
  L2 = L1(2);
  L3 = L2(3);
  L4: i32 = L3(4);
  return L4;
}
