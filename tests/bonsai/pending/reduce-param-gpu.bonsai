//! flags: -p ssa -b llvm -e

// FAILS (2026-10-12): prints 1.000000 for 65. An `atomic` accumulate into
// a `reduce(+)` parameter, made inside a function the GPU-bound loop
// calls. The program is right: eight threads add into one word, and
// `atomic` says so. The `atomic` survives the parser, the lowering and the
// conversion to SSA, and is taken off by SSA/DemoteAtomics.cpp, which runs
// per function and asks which parallel loops of *that function* enclose
// the accumulate's block (parallel_loops_by_block): in `step` there are
// none -- the bound parfor is in `run`, the caller -- so contention_of
// answers Disjoint and the flag goes; the kernel then does a plain load,
// add and store per thread (`ld.global.b32; add.rn.f32; st.global.b32` in
// the PTX), the stores race, and the last one wins. The same statement
// written inline in the parfor's body keeps its atomic, gets the block
// reduction of SSA/BlockAccumulates.h and prints 65. The analysis has to
// know that a function called from inside a bound loop runs once per
// concurrent iteration -- its callers' loops enclose it -- and keep the
// atomics of such a function (Unknown, not Disjoint) when it cannot see
// the address is the iteration's own.
import stdlib/numerics;

func step(x : Float, total : reduce(+) Float) -> void {
    atomic total += x;
    return;
}

func run(values : array[Float, 8], total : reduce(+) Float) -> void {
    parfor i in 0:8 {
        step(values[i], total);
    }
    return;
}

func main() -> i32 {
    values : array[Float, 8] = {1.0, 4.0, 9.0, 11.0, 2.0, 15.0, 3.0, 20.0};
    total : reduce(+) Float = 0.0;
    run(values, total);
    print(total);
    return 0;
}

schedule {
    run.bind(i, GPUThread);
}
