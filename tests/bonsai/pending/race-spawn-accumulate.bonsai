//! flags: -p ssa -b llvm -e

// A race the language cannot yet state right: the spawn's own accumulate
// into a reducer the spawned calls share.
//
// `spawn total += half(x)` says the call's value is added into `total` by
// whoever runs the call. `total` is the run's one word, and the eight
// spawned calls may run at once -- here they do: `step.defer(half, q)`
// with the drain bound runs them in one kernel -- so the drain's eight
// adds into `total` are concurrent, and they are plain: the parser gives
// the spawn's accumulate no `atomic` (src/Parser/Parser.cpp, the SPAWN
// branch), and the drain copies the flag it was given (SSA/Defer.cpp).
// The rule is the one every accumulate is under (docs/parallel-semantics.
// md, section 3): an accumulate into a location another activity may
// write at once is `atomic` or a race. The program needs a way to say so
// for a spawn -- `spawn atomic total += half(x)` is the spelling proposed
// there, for a ruling -- and until it has one, this program is a race
// the check should refuse rather than a program with an answer. Today:
// compiles; prints 97.5 under no binds (the drain runs one call at a
// time) and 65 with the binds below (every spawned half lost -- the
// entry stores `total`'s address, `q_total : (f32*)[8]` in
// --dump-ssa-postschedule, which on the JIT runtime's GPU path is the
// producer launch's device copy, freed before the drain's kernel runs;
// runtime/bonsai_cuda.h, "Memory" -- a second defect, the other ruling).
// Expected: refused, with a diagnostic like the `.expect`'s (its wording
// is a proposal), and once the spelling exists, 97.5 under every
// schedule, with the drain's accumulate a device atomic where the drain
// is bound (tests/bonsai/backends/ptx/demote-atomics-spawn shows the
// kept atomic for a spawned function's own write).
import stdlib/numerics;

func half(x : Float) -> Float {
    return x * 0.5;
}

func step(x : Float, total : reduce(+) Float) -> void {
    spawn total += half(x);
    atomic total += x;
    return;
}

func run(values : array[Float, 8], total : reduce(+) Float) -> void {
    parfor i in 0:8 {
        step(values[i], total);
    }
    return;
}

func main() -> i32 {
    values : array[Float, 8] = {1.0, 4.0, 9.0, 11.0, 2.0, 15.0, 3.0, 20.0};
    total : reduce(+) Float = 0.0;
    run(values, total);
    print(total);
    return 0;
}

schedule {
    q = run.queue(root);
    step.defer(half, q);
    run.bind(i, GPUThread);
    run.bind(q, GPUThread);
}
