//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane
//! commands: clang++ -std=c++20 -O3 -DBVH4_PTR_ARENA_PERLANE -c tests/bonsai/correctness/cpp/main_bvh4_ptr_arena.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_ptr_arena_perlane.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_ptr_arena_perlane.o tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane.o -o tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane, ./tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane, rm tests/bonsai/correctness/cpp/main_bvh4_ptr_arena_perlane.o, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane.h, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena_perlane.o

// FAILS (2026-10-29): the compiler stops in the vectorizer,
//
//     [internal] Error: src/SSA/Vectorize.cpp:787 --> !pointee
//     Argument _best0!loop of !loop_0 is a per-lane pointer into per-lane
//     memory, which vectorization does not lay out yet
//
// (and `_holds0!loop` for `occluded`, with `trace` taken out). The pointer
// is the argmin's record, one address for the gang's per-lane record, which
// the loopified traversal carries round its loop as a block argument; the
// loop's uniformization names the header's copy `_best0!loop` where the
// entry passes it as `_best0`, and the divergence analysis, which tells
// values apart by name (AnalyzeDivergence.cpp, value_key), reads the two
// names at the header -- a join of a divergent loop's paths -- as two
// values the lanes disagree about, so the one pointer is marked varying.
// `BONSAI_EXPLAIN_ARG='_best0!loop'` prints the two edges. The same two
// directives in this order compile and run for apps/wosx's walk
// (schedules/fcpwb-packet-defer-sort-fine-perlane-threads.bonsai), whose
// loopified traversal keeps its record pointer as the function's parameter
// and threads nothing; the children loop written out (`unroll`) changes
// nothing here. A first attempt to skip a latch that hands the header its
// own argument back (the trivial phi) made other carried values uniform and
// was taken out; the right place is where the two names are made one, or an
// analysis that resolves a threaded name to its definition.
//
// The test as it should run: bvh4_ptr_arena.bonsai's program, scene and
// tree -- Embree's NodeRef as an address with the kind in its low bits,
// looked up in a `ptr group`, the children's boxes in the parent's row,
// Triangle4 tiles -- with its rays traced in gangs of eight by the per-lane
// schedule: the traversal sorted and put on its stack first, the gang made
// afterwards (the order of the two directives is the whole difference from
// bvh4_ptr_arena_packet.bonsai; apps/pbrt/schedules/perlane.bonsai says
// why), so each lane walks the tree at its own pace over a stack of its
// own, in its own nearer-first order, and the node a lane reads is at its
// own address. A reference that differs between the lanes widens to one
// array handle per lane (Type::is_reference_per_lane): the node's row is
// gathered from the lanes' bases under the mask of the lanes that are on,
// the leaf's tiles the same, and the best hit's corner, read after the
// walk, through one pointer per lane.
//
// The driver (main_bvh4_ptr_arena.cpp, built with BVH4_PTR_ARENA_PERLANE,
// which it already takes) runs the scalar checks and then the same nineteen
// rays as a batch -- two whole gangs and a tail of three, so the split's
// guard is exercised and the tail gang's off lanes hold no ray and no
// reference -- through `trace_all` and `occluded_all`, and requires each
// lane's answer to be the one the same ray got alone. The .expect beside
// this file is bvh4_ptr_arena_packet's output, which this program must
// reproduce: the same scene, rays and batch. Closing it: move the pair to
// correctness/cpp and add the name to that directory's CMakeLists.txt.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

// What a ray hit, as one number the driver can compare: the wall's x plus a
// thousand times its lane's z, or -1 for nothing.
func hit_code(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    t = *h;
    return t.p0.x + 1000.0 * (t.p0.z + 1.0);
}

func [[export]] trace_all(n : u32, rs : array[Ray, n], out : mut array[f32, n]) {
    parfor i in 0u:n {
        out[i] = hit_code(rs[i]);
    }
    return;
}

func [[export]] occluded_all(n : u32, rs : array[Ray, n], out : mut array[i32, n]) {
    parfor i in 0u:n {
        out[i] = cast[[i32]](occluded(rs[i]));
    }
    return;
}

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    // The layout of bvh4_ptr_arena.bonsai, unchanged: one arena of bytes, a
    // reference the address of what it names with the kind in its low four
    // bits, Embree's AABBNode<4> rows and Triangle4 tiles.
    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    // The order and the stack first, while the traversal is one ray's; then
    // the gang, which finds the loops already made and widens them, each
    // lane's trip its own. The directives are applied in the order written.
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    occluded.loopify(64);
    trace_all.split(i, i_gang, i_lane, 8, true)
             .vectorize(i_lane);
    occluded_all.split(i, i_gang, i_lane, 8, true)
                .vectorize(i_lane);
}
