//! flags: -p ssa

// A schedule transform the SSA pipeline does not apply yet is an error.
//
// It used to be a no-op. The Stmt-level LoopTransforms pass that applies
// split, collapse and the parallelize family does not run in this pipeline,
// and the dispatch here had a catch-all arm that quietly left anything it did
// not recognise alone -- so the program compiled, without the schedule, and
// said nothing. A `cpu_thread` that never threads and a `split` that leaves
// one loop where two were asked for are wrong answers, not missing features,
// and they are much easier to find as a compile error than as a program that
// is merely slower than it should be.
//
// The dispatch now names every transform kind and has no catch-all, so a new
// kind will not compile until someone decides which of the two it is.

func process(n : i32, a : array[f32, n], out : mut array[f32, n]) -> void {
    parfor i in 0:n {
        out[i] = sqrt(a[i]);
    }
    return;
}

schedule {
    process.cpu_thread(i);
}
