//! flags: -p ssa

// A schedule the compiler cannot honour is an error, not a no-op.
//
// The dispatch in SSA/Convert.cpp names every transform kind and has no
// catch-all, so a new one will not compile until someone decides whether it
// is applied there, applied earlier in lowering, or not yet built. Before
// that it quietly left anything it did not recognise alone, and the program
// compiled without the schedule and said nothing -- a `bind` that never binds
// and a `split` that leaves one loop where two were asked for are wrong
// answers that look only like slowness.
//
// The live instance of that today is a backend which is not finished. RTCore
// and OptixThread are accepted by the parser, because they are part of what
// bind() means, but nothing lowers them yet.

func process(n : i32, a : array[f32, n], out : mut array[f32, n]) -> void {
    parfor i in 0:n {
        out[i] = sqrt(a[i]);
    }
    return;
}

schedule {
    process.bind(i, RTCore);
}
