// What `spawn` spawns is a call: `spawn f(args);`, a function that runs
// beside the rest of this one and reports through the reducers it is
// handed. An accumulate is not a call, and has nothing to run later.

import stdlib/numerics;

func step(x : Float, total : reduce(+) Float) -> void {
    spawn total += x * 2.0;
    return;
}
