//! flags: -p ssa

// `specialize` goes first among a function's directives. The copies it
// makes are what the directives after it schedule, one variant's loops or
// all of them; a directive before it would have been applied to a program
// that still holds every variant, and the copies would then be of a loop
// already scheduled -- which was the old order, and made it impossible to
// schedule one variant differently from another.

import stdlib/numerics;

element Mode =
    | Sum(scale : Float)
    | Clamp(floor : Float);

func apply(mode : Mode, x : Float) -> Float {
    match mode {
        Sum(scale) => return x * scale;
        Clamp(floor) => return max(x, floor);
    }
}

func [[export]] run(mode : Mode, values : array[Float, 8],
                    out : mut array[Float, 8]) -> void {
    parfor i in 0:8 {
        out[i] = apply(mode, values[i]);
    }
    return;
}

schedule {
    run.bind(i, CPUThread);
    run.specialize(mode);
}
