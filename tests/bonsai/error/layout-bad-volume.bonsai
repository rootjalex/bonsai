//! flags: -p verify-layouts -p lower-trees -p lower-layouts

import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = filter(|tri| intersects(ray, tri), triangles);

element f32x3 = vector[f32, 3];
element f32x3x4 = vector[f32x3, 4];
element f32x3x8 = vector[f32x3, 8];
element u64x4 = vector[u64, 4];

schedule {
    tree[[Triangle]] BVH 
      = AABBNode(children: array[BVH, 4], aabb_low: f32x3x8, aabb_high: f32x3x8) with AABB(aabb_low, aabb_high) on children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(index: u64 = 2) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        indirect group AABBs {
            low: f32x3x4;
            high: f32x3x4;
            children: u64x4;
        };
        group by index {
            split index[0:2] {
                2 -> AABBNode from AABBs[index[4:63]];
                _ -> Leaf { 
                    nprims = cast[[u8]](index[1:4] + 1);
                    data = primitives[index[4:63] : index[4:63] + nprims];
                };
            };
        };
    };
}
