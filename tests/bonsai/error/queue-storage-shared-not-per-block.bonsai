//! flags: -p ssa

// A queue in a block's shared memory (`DeviceShared`) placed at root: shared
// memory is one block's, so a queue in it is pushed to and drained inside
// one iteration of a loop bound to GPUBlock, and the queue has to be placed
// at that loop (`queue(<block loop>, DeviceShared)`). Placed at root its
// storage is the function's, outside every block, and the check refuses the
// word (SSA/QueueStorage.h).
func walk(k : i32, acc : i32) -> i32 {
    if (k <= 0) {
        return acc;
    }
    return walk(k - 1, acc + k);
}

func run(out : mut array[i32, 64]) -> void {
    parfor i in 0:64 {
        out[i] = walk(i, 0);
    }
    return;
}

schedule {
    sums = run.queue(root, DeviceShared);
    walk.defer(walk, sums);
    run.bind(i, GPUThread);
    run.split(sums, sums_blk, sums_thr, 16, true);
    run.bind(sums_blk, GPUBlock);
    run.bind(sums_thr, GPUThread);
    run.bind(sums_rest, GPUThread);
}
