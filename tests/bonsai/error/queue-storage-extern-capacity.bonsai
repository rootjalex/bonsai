//! flags: -p ssa

// A queue in the caller's memory (`ExternDevice`) whose capacity the caller
// cannot compute: the loop that owns the pushes runs `out[0]` times, a
// value read from memory, so the count the function computes is no
// expression over its parameters. The check (SSA/QueueStorage.h) refuses it
// and says why: the C++ header has to give the caller the capacity to
// allocate, and only arithmetic over the parameters can be printed there.
func walk(k : i32, acc : i32) -> i32 {
    if (k <= 0) {
        return acc;
    }
    return walk(k - 1, acc + k);
}

func [[export]] run(out : mut array[i32]) -> void {
    m = out[0];
    parfor i in 0:m {
        out[i] = walk(i, 0);
    }
    return;
}

schedule {
    sums = run.queue(root, ExternDevice);
    walk.defer(walk, sums);
    run.bind(i, GPUThread);
    run.bind(sums, GPUThread);
    run.bind(sums_rest, GPUThread);
}
