//! flags: -p ssa

// A queue in host memory (`Heap`) whose drain is bound to the GPU: a kernel
// cannot address the host's heap, so the storage word and the bind
// contradict each other, and the check of the schedule against the hardware
// hierarchy (SSA/QueueStorage.h) says so, naming the queue, the memory, the
// loop and its binding. The fix is one of DeviceGlobal, Managed or an Extern
// memory of the device, or a drain on the CPU.
func walk(k : i32, acc : i32) -> i32 {
    if (k <= 0) {
        return acc;
    }
    return walk(k - 1, acc + k);
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        out[i] = walk(i, 0);
    }
    return;
}

schedule {
    sums = run.queue(root, Heap);
    walk.defer(walk, sums);
    run.bind(i, GPUThread);
    run.bind(sums, GPUThread);
    run.bind(sums_rest, GPUThread);
}
