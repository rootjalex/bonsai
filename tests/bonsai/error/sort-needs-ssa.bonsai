// A sort() asked for on the pipeline that cannot apply it.
//
// The Stmt-level lowering turns a branching recursion into writes to a queue
// before the layout has run, so there is no run of calls left for the SSA
// rewrite that does the reordering (SSA/SortRecursion.h) to permute. What
// matters is that this is refused: writing the branches out in their original
// order would compile a program the schedule did not ask for, and it would
// look exactly like a working sort -- an argmin over a set does not depend on
// visit order, so every pixel of every image would still be right and only the
// speed would be missing.
import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles));

schedule {
    tree[[Triangle]] TriangleBVH(low high : vec3f) with AABB(low, high) =
    | Interior(left : TriangleBVH, right : TriangleBVH, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    triangles : TriangleBVH;

    layout triangles {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            high : vec3f;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u32; data = range(prims, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };

    trace.sort(triangles.Interior, |i : u8, ray : Ray, axis : u8| select((1 / ray.d)[axis] < 0, 1 - i, i))
         .loopify(64);
}
