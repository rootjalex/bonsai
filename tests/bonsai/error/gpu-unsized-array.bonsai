//! flags: -p ssa -b llvm --gpu-arch sm_90

// An exported function's array of no stated length, read by a loop on the
// GPU. The launch moves what a kernel's pointers point at to the device and
// back, and for that it has to know how many bytes there are; an `array[T]`
// parameter is a pointer the driver handed over and nothing more. Such a
// parameter has to come in as a buffer that knows its size and residency
// (apps/pbrt/PLAN.md, phase A0), which is refused until it does rather than
// guessed at.
func [[export]] run(n : i32, out : mut array[i32]) -> void {
    parfor i in 0:n {
        out[i] = i;
    }
    return;
}

schedule {
    run.bind(i, GPUThread);
}
