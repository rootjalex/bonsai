type B = struct B{ n : i32; x : f32 }

func f(b : B) -> f32 {
  s : mut i32 := 0
  acc : mut f32 := 0f
  let _t2 = b.n in
  while ((*s) < _t2) {
    let _t1 = cast<f32>(_t2) in
    acc = (*acc) + (b.x * cast<f32>(_t2))
    s = (*s) + 1
  }
  let _t4 = cast<f32>(_t2) in
  return (*acc) / cast<f32>(_t2)
}

func [[export]] g(b : (B*)) -> f32 {
  return f((*b)) + h((*b))
}

func h(b : B) -> f32 {
  acc : mut f32 := 0f
  let _t7 = b.n in
  forall i in [0:_t7:1] {
    let _t6 = cast<f32>(_t7) in
    acc = ((*acc) + (b.x * cast<f32>(_t7))) + cast<f32>(i)
