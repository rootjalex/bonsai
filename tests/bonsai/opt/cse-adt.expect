type Shape = | Sph(center : f32x3, radius : f32) | Tri(p0 : f32x3, p1 : f32x3, p2 : f32x3)
type vec3f = f32x3

func area(s : Shape) -> f32 {
  match s {
    Sph(center, radius) =>
      return ((4f * 3.14159f) * radius) * radius
    Tri(p0, p1, p2) =>
      return (0.5f * (p1.x - p0.x)) * (p2.y - p0.y)
  }
}

func [[export]] mixed(c : f32x3, r : f32) -> f32 {
  return area(Sph(c, r)) + area(Tri(c, c + build<f32x3>(1f, 0f, 0f), c + build<f32x3>(0f, 1f, 0f)))
}

func [[export]] twice(c : f32x3, r : f32) -> f32 {
  let _t0 = area(Sph(c, r)) in
  return _t0 + _t0
}


