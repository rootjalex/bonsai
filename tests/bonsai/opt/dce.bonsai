func foobar(cond: bool, a: vector[i32, 3], b: vector[i32, 3], c: vector[i32, 3]) -> i32 {
   tmin : mut = min(a[0], b[0]);
   tmin = tmin + 1;
   tmin = tmin + 1;
   if (cond) {
    tmin = tmin - 1;
   } else if (!cond) {
    tmin += 1;
   }
   tmin = tmin + 1;
   return tmin * -1;
}

