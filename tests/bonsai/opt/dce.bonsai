}

func bar(x : i32) -> i32 {
    L1 = |y: i32| y + 1;
    return L1(x);
}


func f1_se(i : i32) -> i32 {
    print(i);
    return i;
}

func f2_se(i : i32) -> i32 {
    print(i);
    return i;
}

func f3_se(i : i32) -> i32 {
    print(i);
    return i;
