func bar(i : i32x8) -> u32x8 {
  if (0 < reduce<+>(i)) {
    if (!(0 < reduce<+>(i))) {
      print(i)
    }
  } else {
    print(i)
  }
  return abs(i)
}

func bazz(i : i32) -> i32 {
  j : mut i32 := i + 1
  if (0 < i) {
    print((*j))
  }
  return cast<i32>(abs(i))
}

func fizz(i : i32) -> i32 {
  if (0 < i) {
    if (!(0 < reduce<+>(i32x8(-4)))) {
      print(i32x8(-4))
    }
  } else {
    print(i)
  }
  return cast<i32>(abs(i))
}

func foo(i : i32x8) -> u32x8 {
  if (!(0 < reduce<+>(i))) {
    print(i)
  }
  return abs(i)
}

func main() -> i32 {
  if (0 < -1) {
    if (!(0 < reduce<+>(i32x8(-4)))) {
      print(i32x8(-4))
    }
  } else {
    print(-1)
  }
  if (0 < 12) {
    if (!(0 < reduce<+>(i32x8(-4)))) {
      print(i32x8(-4))
    }
  } else {
    print(12)
  }
  bar$r5 : mut u32x8
  if (0 < reduce<+>(i32x8(-1))) {
    if (!(0 < reduce<+>(i32x8(-1)))) {
      print(i32x8(-1))
    }
  } else {
    print(i32x8(-1))
  }
  bar$r5 = abs(i32x8(-1))
  return cast<i32>(reduce<+>((*bar$r5)))
}

func print_and_return(i : i32) -> i32 {
  print(i)
  return i
}


