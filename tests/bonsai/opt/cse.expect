type E = struct E{ x : i32; y : i32 }

func bar(x : i32, y : i32) -> i32 {
  return x + y
}

func foo() -> i32 {
  let a = 1 in
  let b = 2 in
  let c = a + b in
  let d = c in
  let e = c in
  return 0
}

func id_no_side_effect(x : i32) -> i32 {
  return x
}

func id_with_side_effect(x : i32) -> i32 {
  print(x)
  return x
}

func if_condition(a : bool, b : bool, c : bool) -> bool {
  r := false
  let c1 = (a && b) && c in
  if (c1) {
    r = a
    let no_cse = (a || b) || c in
  } else {
    let c2 = c1 in
    r = b
    let no_cse = (a || b) || c in
  }
  let c3 = c1 in
  let c4 = (a || b) || c in
  return r
}

func if_statement(x : i32, y : i32, cond : bool) -> void {
  if (cond) {
    let a = x + y in
    let b = a in
  } else {
    let c = x + y in
  }
  let d = x + y in
}

func mutable_struct(e : mut E) -> void {
  e.x += 1
  e.y = 42
}

func mutating_argument(x : mut i32) -> i32 {
  let a = 1 in
  let b = 2 in
  let c = a + x in
  x += 1
  let d = a + x in
  return 0
}

func mutating_value() -> i32 {
  let a = 1 in
  let b = 2 in
  x := 3
  let c = a + x in
  let d = c in
  return 0
}

func nested_binary_operations(x : i32, y : i32) -> void {
  let a = x + y in
  let _t0 = a in
  let _t1 = _t0 + 1 in
  let b = _t1 in
}

func propagate(x : i32, y : i32) -> i32 {
  let a = x + y in
  let b = a in
  let _t0 = bar(a, b) in
  return _t0
}

func self_assign() -> void {
  i := 1
  i = i
}

func side_effects(x : i32) -> i32 {
  let a = 1 in
  let _t0 = id_with_side_effect(a) in
  let _t1 = _t0 + x in
  let b = _t1 in
  let _t2 = id_with_side_effect(a) in
  let _t3 = _t2 + x in
  let c = _t3 in
  let _t4 = id_no_side_effect(a) in
  let _t5 = _t4 + x in
  let d = _t5 in
  let _t6 = _t4 in
  let _t7 = _t6 + x in
  let e = _t7 in
  return 0
}

func vector_access(x : i32x3) -> i32 {
  let b_0 = x[0] in
  let b_1 = b_0 in
  return 0
}


