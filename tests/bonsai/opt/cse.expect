type E = struct E{ x : f32; y : f32 }

func bar(x : i32, y : i32) -> i32 {
  return x + y
}

func foo(x : i32, y : i32, z : i32, cond : bool) -> i32 {
  let _t0 = x * y in
  let _t1 = _t0 / z in
  let n = _t1 - 32 in
  if (cond) {
    return bar(_t1, n)
  } else if (0 < x) {
    return _t1
  }
  return (_t1 + n) + _t1
}

func mutating1(x : mut i32) -> i32 {
  let a = 1 + x in
  x += 1
  let b = 1 + x in
  y := x
  let c = 1 + y in
  y += 1
  let d = 1 + y in
  return (a / b) - (c * d)
}

func mutating2(e1 : E, e2 : mut E) -> f32 {
  let v = 42f in
  let _t0 = e1.x in
  let _t1 = _t0 / v in
  let c = e2.x / v in
  e2.x += 1f
  let d = e2.x / v in
  return (_t1 + _t1) * (c - d)
}


