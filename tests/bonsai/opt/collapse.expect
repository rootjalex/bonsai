; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define ptr @_traverse_array0(i32 noundef %w) {
_traverse_array0_entry:
  %_alloc0 = alloca ptr, align 8
  %size64 = zext i32 %w to i64
  %mallocsize = mul i64 %size64, 4
  %_alloc0_untyped = tail call ptr @malloc(i64 %mallocsize)
  store ptr %_alloc0_untyped, ptr %_alloc0, align 8
  %0 = icmp slt i32 0, %w
  br i1 %0, label %_io0_for, label %_io0_for_end, !prof !0

_io0_for_inc:                                     ; preds = %_ii1_for_end
  %1 = add i32 %4, 4
  %2 = add i32 %4, 1
  %3 = icmp sle i32 %w, %2
  br i1 %3, label %_io0_for_end, label %_io0_for

_io0_for:                                         ; preds = %_io0_for_inc, %_traverse_array0_entry
  %4 = phi i32 [ 0, %_traverse_array0_entry ], [ %1, %_io0_for_inc ]
  br i1 true, label %_ii1_for, label %_ii1_for_end, !prof !0

_io0_for_end:                                     ; preds = %_io0_for_inc, %_traverse_array0_entry
  %deref_temp = load ptr, ptr %_alloc0, align 8
  ret ptr %deref_temp

_ii1_for_inc:                                     ; preds = %_ii1_for
  %5 = add i32 %8, 1
  %6 = add i32 %8, 1
  %7 = icmp sle i32 4, %6
  br i1 %7, label %_ii1_for_end, label %_ii1_for

_ii1_for:                                         ; preds = %_ii1_for_inc, %_io0_for
  %8 = phi i32 [ 0, %_io0_for ], [ %5, %_ii1_for_inc ]
  %9 = add i32 %4, %8
  %10 = add i32 %9, 1
  %11 = add i32 %4, %8
  %_alloc0_ld = load ptr, ptr %_alloc0, align 8
  %_alloc0_ld1 = getelementptr inbounds i32, ptr %_alloc0_ld, i32 %11
  store i32 %10, ptr %_alloc0_ld1, align 4
  br label %_ii1_for_inc

_ii1_for_end:                                     ; preds = %_ii1_for_inc, %_io0_for
  br label %_io0_for_inc
}

define ptr @process(i32 noundef %w) {
process_entry:
  %0 = call ptr @_traverse_array0(i32 %w)
  ret ptr %0
}

declare noalias ptr @malloc(i64)

!0 = !{!"branch_weights", i32 1073741824, i32 0}
