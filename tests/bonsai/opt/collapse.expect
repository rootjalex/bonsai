func _traverse_array0(m : i32, n : i32, a : f32[n][m]) -> f32[n][m] {
  alloc _alloc0 : mut f32[m * n]
  parfor _i0 in [0:m:1] {
    parfor _i1 in [0:n:1] {
      let @0 = a[_i0] in
      let @1 = @0[_i1] in
      let @2 = sqrt(@1) in
      let @3 = _i0 * n in
      let @4 = @3 + _i1 in
      _alloc0[@4] = @2
      continue
    }
    continue
  }
  let @6 = reinterpret_cast<f32[n][m]>(_alloc0) in
  return @6
}

func _traverse_array1(m : i32, n : i32, a : f32[n][m]) -> f32[n][m] {
  alloc _alloc1 : mut f32[m * n]
  let @7 = n + 1 in
  let @8 = @7 - 1 in
  let @9 = m + 1 in
  let @10 = @9 - 1 in
  let @11 = @10 * @8 in
  parfor i_a in [0:@11:1] {
    let @12 = i_a / @8 in
    let @13 = i_a % @8 in
    let _i0 = @12 in
    let _i1 = @13 in
    let @0 = a[_i0] in
    let @1 = @0[_i1] in
    let @2 = sqrt(@1) in
    let @3 = _i0 * n in
    let @4 = @3 + _i1 in
    _alloc1[@4] = @2
    continue
  }
  let @6 = reinterpret_cast<f32[n][m]>(_alloc1) in
  return @6
}

func _traverse_array2(a : f32[8][32]) -> f32[8][32] {
  alloc _alloc2 : mut f32[32 * 8]
  parfor i_b in [0:256:1] {
    let @9 = i_b >> 31 in
    let @10 = reinterpret_cast<u32>(@9) in
    let @11 = @10 >> 29u in
    let @12 = reinterpret_cast<i32>(@11) in
    let @13 = i_b + @12 in
    let @7 = @13 >> 3 in
    let @14 = i_b >> 31 in
    let @15 = reinterpret_cast<u32>(@14) in
    let @16 = @15 >> 29u in
    let @17 = reinterpret_cast<i32>(@16) in
    let @18 = i_b + @17 in
    let @19 = @18 >> 3 in
    let @20 = @19 * 8 in
    let @8 = i_b - @20 in
    let _i0 = @7 in
    let _i1 = @8 in
    let @0 = a[_i0] in
    let @1 = @0[_i1] in
    let @2 = sqrt(@1) in
    let @3 = _i0 << 3 in
    let @4 = @3 + _i1 in
    _alloc2[@4] = @2
    continue
  }
  let @6 = reinterpret_cast<f32[8][32]>(_alloc2) in
  return @6
}

func _traverse_array3(h : i32, w : i32) -> i32[h][w] {
  alloc _alloc3 : mut i32[w * h]
  let @6 = h + 1 in
  let @7 = @6 - 1 in
  let @8 = w + 1 in
  let @9 = @8 - 1 in
  let @10 = @9 * @7 in
  parfor i_c in [0:@10:1] {
    let @11 = i_c / @7 in
    let @12 = i_c % @7 in
    let _i0 = @11 in
    let _i1 = @12 in
    print(_i0, _i1)
    let @0 = _i0 + _i1 in
    let @2 = _i0 * h in
    let @3 = @2 + _i1 in
    _alloc3[@3] = @0
    continue
  }
  let @5 = reinterpret_cast<i32[h][w]>(_alloc3) in
  return @5
}

func _traverse_array4(w : i32) -> i32[w] {
  alloc _alloc4 : mut i32[w]
  let @4 = w + 4 in
  let @5 = @4 - 1 in
  let @11 = @5 >> 31 in
  let @12 = reinterpret_cast<u32>(@11) in
  let @13 = @12 >> 30u in
  let @14 = reinterpret_cast<i32>(@13) in
  let @15 = @5 + @14 in
  let @6 = @15 >> 2 in
  let @7 = @6 * 4 in
  parfor i in [0:@7:1] {
    let @16 = i >> 31 in
    let @17 = reinterpret_cast<u32>(@16) in
    let @18 = @17 >> 30u in
    let @19 = reinterpret_cast<i32>(@18) in
    let @20 = i + @19 in
    let @8 = @20 >> 2 in
    let @9 = @8 * 4 in
    let @21 = i >> 31 in
    let @22 = reinterpret_cast<u32>(@21) in
    let @23 = @22 >> 30u in
    let @24 = reinterpret_cast<i32>(@23) in
    let @25 = i + @24 in
    let @26 = @25 >> 2 in
    let @27 = @26 * 4 in
    let @10 = i - @27 in
    let io = @9 in
    let ii = @10 in
    let @3 = io + ii in
    let _i0 = @3 in
    print(_i0, 1)
    let @0 = _i0 + 1 in
    _alloc4[_i0] = @0
    continue
  }
  return _alloc4
}

func f(x : i32, y : i32) -> i32 {
  print(x, y)
  let @0 = x + y in
  return @0
}

func no_collapse(n : i32, m : i32, a : f32[n][m]) -> f32[n][m] {
  let @0 = _traverse_array0(m, n, a) in
  return @0
}

func process1(n : i32, m : i32, a : f32[n][m]) -> f32[n][m] {
  let @0 = _traverse_array1(m, n, a) in
  return @0
}

func process2(a : f32[8][32]) -> f32[8][32] {
  let @0 = _traverse_array2(a) in
  return @0
}

func process3(w : i32, h : i32) -> i32[h][w] {
  let @0 = _traverse_array3(h, w) in
  return @0
}

func process4(w : i32) -> i32[w] {
  let @0 = _traverse_array4(w) in
  return @0
}


schedule host {
    process1.collapse(i0, i1, i_a)
    process2.collapse(i0, i1, i_b)
    process3.collapse(i0, i1, i_c)
    process4.split(i0, io, ii, (i32)4, 0)
            .collapse(io, ii, i)

}
