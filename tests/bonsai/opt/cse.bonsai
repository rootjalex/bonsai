//! flags: -p core -p cse -p dce

func bar(x: i32, y: i32) -> i32 { return x + y; }

func foo(x: i32, y: i32, z: i32, cond: bool) -> i32 {
    m: i32 = x * y / z;
    n: i32 = x * y / z - 32;
    if (cond) {
        a: i32 = x * y / z;
        b: i32 = x * y / z;
        return bar(a, b - 32);
    } else if (x > 0) {
        c: i32 = x * y / z;
        return c;
    }
    return m + n + (x * y / z);
}


element E { x: f32; y: f32; }
func mutating(e1: E, e2: mut E) -> f32 {
    v: f32 = 42.0;
    a: f32 = e1.x / v;
    b: f32 = e1.x / v;

    c: f32 = e2.x / v;
    e2.x += 1.0;
    d: f32 = e2.x / v;
    return (a + b) * (c - d);
}
