//! flags: -p core -p rename -p cse

func foo() -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  c: i32 = a + b;    // #3
  d: i32 = a + b;    // #3

  return 0;
}

func mutating_argument(x: mut i32) -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  c: i32 = a + x;    // #3
  x += 1;
  d: i32 = a + x;    // #4

  return 0;
}


func if_condition(a: bool, b: bool, c: bool) -> bool {
    r: mut bool = false;
    c1: bool = a && b && c;     // #1
    if (a && b && c) {          // #1
        r = a;
        no_cse: bool = a || b || c;
    } else {
        // CSE can occur within control flow as long as both
        // expressions are immutable and not side-effecting.
        c2: bool = a && b && c; // #1
        r = b;
        no_cse: bool = a || b || c;
    }
    c3: bool = a && b && c;     // #1
    
    // Verify this shouldn't CSE with `no_cse` in either branch.
    c4: bool = a || b || c;
    return r;
}

func vector_access(x : vector[i32, 3]) -> i32 {
    b_0: i32 = x[0]; // #1
    b_1: i32 = x[0]; // #1
    return 0;
}

func id_with_side_effect(x: i32) { print(x); return x; }
func id_no_side_effect(x: i32) { return x; }

func side_effects() -> i32 {
    a: i32 = 1;
    b: i32 = id_with_side_effect(a);
    c: i32 = id_with_side_effect(a);

    d: i32 = id_no_side_effect(a);
    e: i32 = id_no_side_effect(a);
    return 0;
}

func mutating_value() -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  x: mut = 3;
  c: i32 = a + x;    // #3
  d: i32 = a + x;    // #3
  return 0;
}

element E { x: i32; y: i32; }

func mutable_struct(e: mut E) -> void {
    e.x += 1;
    e.y = 42;
}

func self_assign() -> void {
    i: mut i32 = 1;
    i = i;
}

func nested_binary_operations(x: i32,  y: i32) -> void {
    a: i32 = x + y;
    b: i32 = x + y + 1;
}

func bar(x: i32, y: i32) -> i32 { return x + y; }

func if_statement(x: i32, y: i32, cond: bool) -> void {
    if (cond) {
        a: i32 = x + y;
        b: i32 = x + y;
    } else {
        c: i32 = x + y;
    }
    d: i32 = x + y;
}
