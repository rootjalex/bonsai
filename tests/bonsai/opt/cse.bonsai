//! flags: -p core -p cse

func id(x: i32) -> i32 { return x; }

func rename(cond: bool) -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  x: mut = 3;
  c: i32 = a + x;    // #3
  d: i32 = a + x;    // #3

  x += 1;
  e: i32 = a + x;    // #4
  f: i32 = a + x;    // #4

  if (cond) {
    x += 1;
  } else {
    x += 2;
  }

  if (cond && x < 0) {
    x = 0;
  } else {
    x = 1;
  }

  x += 3;
  x *= 2;
  x = 42;

  if (cond) {
    x += 2;
    y: mut = 0;
    y += 1;
    if (cond) {
      x = 0;
    }
  }

  x += 2;
  x = x + 2;
  x = x + id(x);

  return 0;
}

func foo() -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  c: i32 = a + b;    // #3
  d: i32 = a + b;    // #3
  e: i32 = 2;        // #2

  return 0;
}

func mutating_argument(x: mut i32) -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  c: i32 = a + x;    // #3
  x += 1;
  d: i32 = a + x;    // #4

  return 0;
}

func if_condition(a: bool, b: bool) -> bool {
    cond: bool = a && b;
    if (a && b) {
        return a;
    } else {
        return b;
    }
}

func vector_access(x : vector[i32, 3]) -> i32 {
    b_0: i32 = x[0]; // #1
    b_1: i32 = x[0]; // #1
    return 0;
}

func id_with_side_effect(x: i32) { print(x); return x; }
func id_no_side_effect(x: i32) { return x; }

func side_effects() -> i32 {
    a: i32 = 1;
    b: i32 = id_with_side_effect(a) + 1;
    c: i32 = id_with_side_effect(a) + 1;

    d: i32 = id_no_side_effect(a) + 1;
    e: i32 = id_no_side_effect(a) + 1;
    return 0;
}

func mutating_value() -> i32 {
  a: i32 = 1;        // #1
  b: i32 = 2;        // #2
  x: mut = 3;
  c: i32 = a + x;    // #3
  d: i32 = a + x;    // #3

  x = 1;
  e: i32 = a + x;    // #4
  f: i32 = a + x;    // #4

  return 0;
}

element E { x: i32; y: i32; }

func mutable_struct(e: mut E) -> void {
    e.x += 1;
    e.y = 42;
}

func self_assign() -> void {
    i: mut i32 = 1;
    i = i;
}
