//! flags: -p core -p cse 

func bar(x: i32, y: i32) -> i32 { return x + y; }

func foo(x: i32, y: i32, z: i32, cond: bool) -> i32 {
    m: i32 = x * y / z;
    n: i32 = x * y / z - 32;
    if (cond) {
        a: i32 = x * y / z;
        b: i32 = x * y / z;
        return bar(a, b - 32);
    } else if (x > 0) {
        c: i32 = x * y / z;
        return c;
    }
    return m + n + (x * y / z);
}
