//! flags: -p core -p rename -p cse -p dce

func bar(x: i32, y: i32) -> i32 { return x + y; }

func if_statement(x: i32, y: i32, z: i32, cond: bool) -> i32 {
    m: i32 = x * y / z;
    n: i32 = x * y / z - 32;
    if (cond) {
        a: i32 = x * y / z;
        b: i32 = x * y / z;
        return bar(a, b - 32);
    } else if (x > 0) {
        c: i32 = x * y / z;
        return c;
    }
    return m + n + (x * y / z);
}

func mutating(x: mut i32) -> i32 {
    a: i32 = 1 + x;
    x += 1;
    b: i32 = 1 + x;
    y: mut i32 = x;
    c: i32 = 1 + y;
    y += 1;
    d: i32 = 1 + y;
    
    return (a / b) - (c * d);
}
