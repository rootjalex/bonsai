//! flags: -p ssa -b cpp -o tests/bonsai/correctness/gpu/rtcore-placed
//! commands: clang++ -std=c++20 -O3 -c $<>/main_rtcore_placed_cpp.cpp -I. -o $<>/main_rtcore_placed_cpp.o, clang++ $<>/main_rtcore_placed_cpp.o $<>/rtcore-placed.o -o $<>/rtcore-placed, ./$<>/rtcore-placed, rm $<>/rtcore-placed, rm $<>/main_rtcore_placed_cpp.o, rm $<>/rtcore-placed.h, rm $<>/rtcore-placed.o

// rtcore-tlas.bonsai's scene with object A made of two MESHES and placed as
// pbrt's GPU places an instance of a definition (gpu/optix/aggregate.cpp):
// the definition's structure is built once, with a build input per mesh,
// and each instance of it is one OptixInstance under the instance's
// transform whose records reach the mesh's own record. Here the record's
// element is a `Placed` primitive -- the instance's transform, the mesh,
// the mesh's run of `tris` -- one per instance use and mesh, consecutive
// in the primitives from the instance's first (bonsai_optix_instance::
// holder_per_input: the k-th input's records carry `holder + k`), which
// is how apps/pbrt renders an instanced mesh with no record per triangle.
// Object B stays an instance holding a tree of triangles (`Inst`). The
// same eight rays and answers as rtcore-tlas: a hit through a placed mesh
// is reported in the object's frame, placed by the program, and names its
// mesh.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func untransform(t : Transform, r : Ray) -> Ray {
    o = t.i0 * r.o.x + t.i1 * r.o.y + t.i2 * r.o.z + t.i3;
    d = t.i0 * r.d.x + t.i1 * r.d.y + t.i2 * r.d.z;
    out : Ray = {o, d, r.tmax};
    return out;
}

// pbrt: Primitive -- a GeometricPrimitive, an instance's placement of one
// mesh of its definition, or a TransformedPrimitive over a tree.
element Prim =
    | Solo(tri : Triangle)
    | Placed(render_from_instance : Transform, mesh : u32, tris : set[Triangle])
    | Inst(render_from_instance : Transform, blas : set[Triangle]);

// A triangle of a mesh as the query sees it (apps/pbrt rebuilds the
// triangle's Geometric from the mesh's record here).
func of_mesh(mesh : u32, t : Triangle) -> Triangle {
    out : Triangle = {t.p0, t.p1, t.p2};
    return out;
}

// pbrt: what Primitive::Intersect dispatches to.
func geometry(p : Prim) -> set[Triangle] =
    match p {
        Solo(tri) => set[Triangle]{tri},
        Placed(m, mesh, tris) => map(|t : Triangle| of_mesh(mesh, t), tris),
        Inst(m, blas) => blas
    };

// pbrt: Primitive::Bounds(), through the same dispatch.
element Prim with extent = |p| transform(p, geometry(p).AABB);

func transform(p : Prim, b : AABB) -> AABB {
    match p {
        Solo(tri) => return b;
        Placed(m, mesh, tris) => return transform(m, b);
        Inst(m, blas) => return transform(m, b);
    }
}

func untransform(p : Prim, r : Ray) -> Ray {
    match p {
        Solo(tri) => return r;
        Placed(m, mesh, tris) => return untransform(m, r);
        Inst(m, blas) => return untransform(m, r);
    }
}

// The motion the query names, `transform(p, tri)`: a triangle where its
// primitive puts it.
func transform(p : Prim, tri : Triangle) -> Triangle {
    match p {
        Solo(t) => return tri;
        Placed(m, mesh, tris) => {
            out : Triangle = {apply(m, tri.p0), apply(m, tri.p1),
                              apply(m, tri.p2)};
            return out;
        }
        Inst(m, blas) => {
            out : Triangle = {apply(m, tri.p0), apply(m, tri.p1),
                              apply(m, tri.p2)};
            return out;
        }
    }
}

// Which arm a hit came through: 0 standalone, 1 an instance's tree, 2 a
// placed mesh -- and for a placed mesh, which mesh (or -1).
func kind_of(p : Prim) -> i32 {
    match p {
        Solo(tri) => return 0;
        Placed(m, mesh, tris) => return 2;
        Inst(m, blas) => return 1;
    }
}

func mesh_of(p : Prim) -> i32 {
    match p {
        Solo(tri) => return -1;
        Placed(m, mesh, tris) => return cast[[i32]](mesh);
        Inst(m, blas) => return -1;
    }
}

// How near a hit may be (see rtcore-tlas.bonsai on its place in the
// signature).
extern near : array[f32, 1];
extern prims : set[Prim];

// pbrt: Primitive::Intersect over the scene.
func trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, transform(p, tri)),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, transform(p, tri)) &&
                      distmin(r, transform(p, tri)) > near[0],
                  flatten(|p : Prim| geometry(p), prims)));

// pbrt: Primitive::IntersectP.
func trace_any(r : Ray) =
    any(|p : Prim, tri : Triangle|
            intersects(r, transform(p, tri)) &&
            distmin(r, transform(p, tri)) > near[0],
        flatten(|p : Prim| geometry(p), prims));

// Every ray traced, and what it found written out: the hit triangle placed,
// which arm it came through and its mesh, and whether anything at all is
// along the ray (see rtcore-tlas.bonsai on the two loops).
func [[export]] trace_all(n : i32, rays : array[Ray, n],
                          hit_p0 : mut array[vec3f], hit_kind : mut array[i32],
                          hit_mesh : mut array[i32],
                          hit_any : mut array[i32]) -> void {
    parfor i in 0:n {
        r = rays[i];
        found = trace(r);
        if found {
            hit = *found;
            via = hit[0];
            tri = hit[1];
            placed = transform(via, tri);
            hit_p0[i] = placed.p0;
            hit_kind[i] = kind_of(via);
            hit_mesh[i] = mesh_of(via);
        } else {
            hit_p0[i] = vec3f{0.0, 0.0, 0.0};
            hit_kind[i] = -1;
            hit_mesh[i] = -1;
        }
    }
    parfor j in 0:n {
        hit_any[j] = select(trace_any(rays[j]), 1, 0);
    }
    return;
}

schedule {
    layout Prim = tagged_index;
    // The hardware's trees: the scene's primitives; a placed mesh's
    // triangles and an instance's object, each a run of `tris` the field
    // names the start of.
    prims : OptixTree;
    Placed.tris : OptixTree from tris;
    Inst.blas : OptixTree from tris;
    layout prims {
        tCount : u32;
        tris : array[Triangle, tCount];
        pCount : u32;
        elems : array[Prim, pCount];
    };
    trace.bind(RTCore);
    trace_any.bind(RTCore);
    trace_all.bind(i, OptixThread);
    trace_all.bind(j, OptixThread);
}
