//! flags: -p ssa -b llvm -e

// A queue whose producer and drains are kernels: the queue's arrays, the
// record's and the queue's header live on the device
// (CodeGen_LLVM::device_resident) -- allocated once with bonsai_cuda_malloc,
// handed to each launch as the device address they are, never copied. The
// host reads the header's count once a round, by a copy back, to know
// whether to go on; the drain itself is launched over the queue's capacity
// and reads the count on the device (Bind.cpp), so no launch waits for the
// one before it. The same program as correctness/llvm/defer-frame on the
// CPU: walk(i) sums 1..i, deferred through the queue, the result written
// into out[i] by the pass after the rounds.

func walk(k : i32, acc : i32) -> i32 {
    if (k <= 0) {
        return acc;
    }
    return walk(k - 1, acc + k);
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        out[i] = walk(i, 0);
    }
    return;
}

func main() -> i32 {
    out : mut array[i32, 8] = {-1, -1, -1, -1, -1, -1, -1, -1};
    run(out);
    // {0, 1, 3, 6, 10, 15, 21, 28}
    print(out);
    return 0;
}

schedule {
    sums = run.queue(root);
    walk.defer(walk, sums);
    run.bind(i, GPUThread);
    run.bind(sums, GPUThread);
    run.bind(sums_rest, GPUThread);
}
