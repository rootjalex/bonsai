//! flags: -p ssa -b cpp -o tests/bonsai/correctness/gpu/rtcore-tlas
//! commands: clang++ -std=c++20 -O3 -c $<>/main_rtcore_tlas_cpp.cpp -I. -o $<>/main_rtcore_tlas_cpp.o, clang++ $<>/main_rtcore_tlas_cpp.o $<>/rtcore-tlas.o -o $<>/rtcore-tlas, ./$<>/rtcore-tlas, rm $<>/rtcore-tlas, rm $<>/main_rtcore_tlas_cpp.o, rm $<>/rtcore-tlas.h, rm $<>/rtcore-tlas.o

// correctness/cpp/mixed-tlas.bonsai's two-level scene -- triangles standing
// on their own beside instances holding trees of them -- with the two ray
// queries on the ray tracing hardware: `trace.bind(RTCore)` and
// `trace_any.bind(RTCore)` make each query a trace through the acceleration
// structure the driver builds (runtime/bonsai_optix.h), with the query's
// filter and metric as the hit programs (Lower/Trees.cpp), and the loop over
// the rays bound to OptixThread is the raygen program that traces
// (CodeGen_OptiX). The same eight rays, the same answers as the CPU tree's:
// the standalone triangle in front of an instance's has to win and the
// other way round, a hit through an instance is reported in the instance's
// frame and placed by the program, and `distmin > 0.001` -- the rest of the
// filter, which the hardware does not test -- runs at every candidate as
// the any-hit program.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func untransform(t : Transform, r : Ray) -> Ray {
    o = t.i0 * r.o.x + t.i1 * r.o.y + t.i2 * r.o.z + t.i3;
    d = t.i0 * r.d.x + t.i1 * r.d.y + t.i2 * r.d.z;
    out : Ray = {o, d, r.tmax};
    return out;
}

// pbrt: Primitive -- a GeometricPrimitive or a TransformedPrimitive.
element Prim =
    | Solo(tri : Triangle)
    | Inst(render_from_instance : Transform, blas : set[Triangle]);

// pbrt: what Primitive::Intersect dispatches to.
func geometry(p : Prim) -> set[Triangle] =
    match p { Solo(tri) => set[Triangle]{tri}, Inst(m, blas) => blas };

// pbrt: Primitive::Bounds(), through the same dispatch.
element Prim with extent = |p| transform(p, geometry(p).AABB);

func transform(p : Prim, b : AABB) -> AABB {
    match p {
        Solo(tri) => return b;
        Inst(m, blas) => return transform(m, b);
    }
}

func untransform(p : Prim, r : Ray) -> Ray {
    match p {
        Solo(tri) => return r;
        Inst(m, blas) => return untransform(m, r);
    }
}

// The motion the query names, `transform(p, tri)`: a triangle where its
// primitive puts it -- what is applied to a hit, TransformedPrimitive's one
// transform of the result.
func transform(p : Prim, tri : Triangle) -> Triangle {
    match p {
        Solo(t) => return tri;
        Inst(m, blas) => {
            out : Triangle = {apply(m, tri.p0), apply(m, tri.p1),
                              apply(m, tri.p2)};
            return out;
        }
    }
}

func is_instance(p : Prim) -> bool {
    match p {
        Solo(tri) => return false;
        Inst(m, blas) => return true;
    }
}

// How near a hit may be: what the rest of the filter compares against, read
// by the hit programs alone. Declared before `prims` so that the exported
// signature's order is the declaration's however an extern reached
// `trace_all`: `prims` reaches it as the trace's traversable, this one only
// as a read the trace carries for its programs (Lower/RTCoreReads.h), a run
// of LowerExterns later -- and the driver passes it first all the same.
extern near : array[f32, 1];

extern prims : set[Prim];

// pbrt: Primitive::Intersect over the scene.
func trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, transform(p, tri)),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, transform(p, tri)) &&
                      distmin(r, transform(p, tri)) > near[0],
                  flatten(|p : Prim| geometry(p), prims)));

// pbrt: Primitive::IntersectP.
func trace_any(r : Ray) =
    any(|p : Prim, tri : Triangle|
            intersects(r, transform(p, tri)) &&
            distmin(r, transform(p, tri)) > near[0],
        flatten(|p : Prim| geometry(p), prims));

// Every ray traced, and what it found written out: the hit triangle placed,
// which arm it came through (1 an instance, 0 standalone, -1 a miss), and
// whether anything at all is along the ray.
func [[export]] trace_all(n : i32, rays : array[Ray, n],
                          hit_p0 : mut array[vec3f], hit_kind : mut array[i32],
                          hit_any : mut array[i32]) -> void {
    parfor i in 0:n {
        r = rays[i];
        found = trace(r);
        if found {
            hit = *found;
            via = hit[0];
            tri = hit[1];
            placed = transform(via, tri);
            hit_p0[i] = placed.p0;
            hit_kind[i] = select(is_instance(via), 1, 0);
        } else {
            hit_p0[i] = vec3f{0.0, 0.0, 0.0};
            hit_kind[i] = -1;
        }
        hit_any[i] = select(trace_any(r), 1, 0);
    }
    return;
}

schedule {
    layout Prim = tagged_index;

    tree[[Triangle]] BLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : BLAS, right : BLAS, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    tree[[Prim]] TLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : TLAS, right : TLAS, axis : u8)
    | Leaf(data : array[Prim]) with data = data;

    prims : TLAS;
    Inst.blas : BLAS from BlasNodes;

    // The layout the CPU tree has; on the hardware its node groups stay
    // empty and the structure is the handle the layout gains (`traversable`).
    layout prims {
        tCount : u32;
        tris : array[Triangle, tCount];

        bCount : u32;
        indirect group BlasNodes[bCount] bnode : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = bnode + 1;
                                right = bnode + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(tris, pOffset, cast[[u32]](nPrims)); };
            };
        };

        pCount : u32;
        elems : array[Prim, pCount];

        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1;
                                right = index + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(elems, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };

    trace.bind(RTCore);
    trace_any.bind(RTCore);
    trace_all.bind(i, OptixThread);
}
