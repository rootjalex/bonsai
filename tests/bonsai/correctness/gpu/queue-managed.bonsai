//! flags: -p ssa -b llvm -e

// tests/bonsai/correctness/gpu/defer-device with the queue placed in
// managed memory by the schedule (`queue(root, Managed)`, IR/Storage.h):
// the arrays and header come from cuMemAllocManaged
// (bonsai_cuda_malloc_managed), one address for the host and the device, and
// everything else is as for device memory -- the kernels are handed the
// address, the host's reads of the count are copies. The same result.

func walk(k : i32, acc : i32) -> i32 {
    if (k <= 0) {
        return acc;
    }
    return walk(k - 1, acc + k);
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        out[i] = walk(i, 0);
    }
    return;
}

func main() -> i32 {
    out : mut array[i32, 8] = {-1, -1, -1, -1, -1, -1, -1, -1};
    run(out);
    // {0, 1, 3, 6, 10, 15, 21, 28}
    print(out);
    return 0;
}

schedule {
    sums = run.queue(root, Managed);
    walk.defer(walk, sums);
    run.bind(i, GPUThread);
    run.bind(sums, GPUThread);
    run.bind(sums_rest, GPUThread);
}
