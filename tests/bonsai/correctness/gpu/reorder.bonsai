//! flags: -p ssa -b llvm -e

// backends/ptx/reorder's program run on the GPU: the threads of the raygen
// launch are reordered by which variant each holds before the stage that
// branches on it (`run.sort(weigh, |k| k)`, shader execution reordering),
// and the answers are the ones the CPU program gives -- a reordering changes
// which threads run together and nothing about what each computes.

element Kind =
    | Small(v : i32)
    | Large(v : i32);

func kind_of(i : i32) -> Kind {
    if i < 4 {
        return Small(i);
    }
    return Large(i);
}

func weigh(k : Kind, i : i32) -> i32 {
    return match k {
        Small(v) => v + i,
        Large(v) => v * i
    };
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        k = kind_of(i);
        out[i] = weigh(k, i);
    }
    return;
}

func main() -> i32 {
    out : mut array[i32, 8] = {-1, -1, -1, -1, -1, -1, -1, -1};
    run(out);
    // {0, 2, 4, 6, 16, 25, 36, 49}
    print(out);
    return 0;
}

schedule {
    run.sort(weigh, |k : Kind| k);
    run.bind(i, OptixThread);
}
