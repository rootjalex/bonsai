//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/stored_lane
//! commands: clang++ -std=c++20 -O3 -march=native -c tests/bonsai/correctness/cpp/main_stored_lane.cpp -I. -o tests/bonsai/correctness/cpp/main_stored_lane.o, clang++ tests/bonsai/correctness/cpp/main_stored_lane.o tests/bonsai/correctness/cpp/stored_lane.o -o tests/bonsai/correctness/cpp/stored_lane, ./tests/bonsai/correctness/cpp/stored_lane, rm tests/bonsai/correctness/cpp/stored_lane, rm tests/bonsai/correctness/cpp/main_stored_lane.o, rm tests/bonsai/correctness/cpp/stored_lane.h, rm tests/bonsai/correctness/cpp/stored_lane.o

// ssa/stored-lane.bonsai, run (main_stored_lane.cpp): the reads of an
// extern's vectors that the simplifier turns into scalar loads off the
// storage -- a lane only known when it runs, and lane 0 of a compress read
// once, which is the lane the mask's lowest set bit names -- against the
// vector forms, a compress read twice and a lane known at compile time.
// The extern is every exported function's last parameter.

extern rows : array[vector[f32, 8]];

func [[export]] pick(i : u32, lane : u32) -> f32 {
    return rows[i][lane];
}

func [[export]] first(i : u32, m : vector[u32, 8]) -> f32 {
    return compress(rows[i], m != 0u)[0u];
}

func [[export]] two(i : u32, m : vector[u32, 8]) -> f32 {
    c = compress(rows[i], m != 0u);
    return c[0u] + c[1u];
}

func [[export]] third(i : u32) -> f32 {
    return rows[i][2u];
}
