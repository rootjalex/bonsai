//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_add_one
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_vectorize_add_one.cpp -I. -o tests/bonsai/correctness/cpp/main_vectorize_add_one.o, clang++ tests/bonsai/correctness/cpp/main_vectorize_add_one.o tests/bonsai/correctness/cpp/vectorize_add_one.o -o tests/bonsai/correctness/cpp/vectorize_add_one, ./tests/bonsai/correctness/cpp/vectorize_add_one, rm tests/bonsai/correctness/cpp/vectorize_add_one, rm tests/bonsai/correctness/cpp/main_vectorize_add_one.o, rm tests/bonsai/correctness/cpp/vectorize_add_one.h, rm tests/bonsai/correctness/cpp/vectorize_add_one.o

// Verifies vectorize() end-to-end: the SSA rewrite produces real
// <8 x float> LLVM vector code (widened Load/Add/Store, see
// SSA/Rewrite.cpp's vectorize()), and running that compiled code produces
// the correct per-lane result, not just plausible-looking IR.
func [[export]] add_one(a : array[f32, 8], out : mut array[f32, 8]) {
  parfor i in 0:8 {
    out[i] = a[i] + 1.0;
  }
  return;
}

schedule {
  add_one.vectorize(i);
}
