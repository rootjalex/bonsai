//! flags: -b cpp -o tests/bonsai/correctness/cpp/mixed-tlas
//! commands: clang++ -std=c++20 -O3 -c $<>/main_mixed_tlas.cpp -I. -o $<>/main_mixed_tlas.o, clang++ $<>/main_mixed_tlas.o $<>/mixed-tlas.o -o $<>/mixed-tlas, ./$<>/mixed-tlas, rm $<>/mixed-tlas, rm $<>/main_mixed_tlas.o, rm $<>/mixed-tlas.h, rm $<>/mixed-tlas.o

// A tree of mixed primitives that runs: triangles standing on their own beside
// instances holding trees of them, in one top-level tree, as pbrt's scene is.
//
// lower/mixed-tlas.bonsai is this query stopped at the IR. What only running
// it can check:
//
//   - that the dispatch is right: a ray aimed at a standalone triangle finds
//     it through the Solo arm, one aimed into an instance finds that through
//     the Inst arm, and neither arm is ever entered for the other.
//   - that the running best crosses the arms both ways. A standalone triangle
//     in front of an instance's triangle has to win, and an instance's
//     triangle in front of a standalone one has to win; each is pbrt's `tMax`
//     doing its job at the top level, and a walk that forgot the best found
//     in the other arm would still hit something plausible.
//   - that a hit reports the primitive it came through and the triangle as
//     stored: in the instance's frame for the Inst arm, so the driver places
//     it, exactly as TransformedPrimitive transforms the interaction once.
//
// The driver owns the scene, as in main_blas_tlas.cpp, and the variant is
// stored `tagged_index` so the driver also owns the two pools.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func untransform(t : Transform, r : Ray) -> Ray {
    o = t.i0 * r.o.x + t.i1 * r.o.y + t.i2 * r.o.z + t.i3;
    d = t.i0 * r.d.x + t.i1 * r.d.y + t.i2 * r.d.z;
    out : Ray = {o, d, r.tmax};
    return out;
}

// pbrt: Primitive -- a GeometricPrimitive or a TransformedPrimitive.
element Prim =
    | Solo(tri : Triangle)
    | Inst(render_from_instance : Transform, blas : set[Triangle]);

// pbrt: what Primitive::Intersect dispatches to.
func geometry(p : Prim) -> set[Triangle] =
    match p { Solo(tri) => set[Triangle]{tri}, Inst(m, blas) => blas };

// pbrt: Primitive::Bounds(), through the same dispatch.
element Prim with extent = |p| transform(p, geometry(p).AABB);

// The primitive as a motion: pbrt's `Transform::operator()` and `ApplyInverse`
// in TransformedPrimitive, nothing in GeometricPrimitive.
func transform(p : Prim, b : AABB) -> AABB {
    match p {
        Solo(tri) => return b;
        Inst(m, blas) => return transform(m, b);
    }
}

func untransform(p : Prim, r : Ray) -> Ray {
    match p {
        Solo(tri) => return r;
        Inst(m, blas) => return untransform(m, r);
    }
}

// The motion the query names, `transform(p, tri)`: a triangle where its
// primitive puts it. The traversal never runs it -- pulling the ray back
// replaces every use -- but it is what the driver applies to a hit, which is
// TransformedPrimitive's one transform of the result, and GeometricPrimitive's
// none. Exported so the driver dispatches through the program rather than
// reading the tag itself.
func [[export]] transform(p : Prim, tri : Triangle) -> Triangle {
    match p {
        Solo(t) => return tri;
        Inst(m, blas) => {
            out : Triangle = {apply(m, tri.p0), apply(m, tri.p1),
                              apply(m, tri.p2)};
            return out;
        }
    }
}

// Which arm a hit came through, for the driver to say so.
func [[export]] is_instance(p : Prim) -> bool {
    match p {
        Solo(tri) => return false;
        Inst(m, blas) => return true;
    }
}

extern prims : set[Prim];

// pbrt: Primitive::Intersect over the scene.
func [[export]] trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, transform(p, tri)),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, transform(p, tri)) &&
                      distmin(r, transform(p, tri)) > 0.001,
                  flatten(|p : Prim| geometry(p), prims)));

// pbrt: Primitive::IntersectP.
func [[export]] trace_any(r : Ray) =
    any(|p : Prim, tri : Triangle|
            intersects(r, transform(p, tri)) &&
            distmin(r, transform(p, tri)) > 0.001,
        flatten(|p : Prim| geometry(p), prims));

schedule {
    layout Prim = tagged_index;

    tree[[Triangle]] BLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : BLAS, right : BLAS, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    tree[[Prim]] TLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : TLAS, right : TLAS, axis : u8)
    | Leaf(data : array[Prim]) with data = data;

    prims : TLAS;
    Inst.blas : BLAS from BlasNodes;

    layout prims {
        tCount : u32;
        tris : array[Triangle, tCount];

        bCount : u32;
        indirect group BlasNodes[bCount] bnode : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = bnode + 1;
                                right = bnode + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(tris, pOffset, cast[[u32]](nPrims)); };
            };
        };

        pCount : u32;
        elems : array[Prim, pCount];

        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1;
                                right = index + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(elems, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };
}
