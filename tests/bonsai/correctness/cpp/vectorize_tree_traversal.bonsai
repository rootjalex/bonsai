//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_tree_traversal
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_vectorize_tree_traversal.cpp -I. -o tests/bonsai/correctness/cpp/main_vectorize_tree_traversal.o, clang++ tests/bonsai/correctness/cpp/main_vectorize_tree_traversal.o tests/bonsai/correctness/cpp/vectorize_tree_traversal.o -o tests/bonsai/correctness/cpp/vectorize_tree_traversal, ./tests/bonsai/correctness/cpp/vectorize_tree_traversal, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal, rm tests/bonsai/correctness/cpp/main_vectorize_tree_traversal.o, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal.h, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal.o

// A nearest-hit query over a tree of variants, traced for a gang of rays at
// once.
//
// adt-bvh.bonsai's scene and query, with the rays in a vectorized loop: eight
// rays walk the BVH together, each lane at its own node, each lane's leaf
// elements gathered from the primitive array at its own index, each lane's
// shape a variant matched on per lane, and the best hit remembered per lane
// as an index into that array (see Lower/ElementReferences.cpp). This is
// the traversal a vectorized renderer makes, small enough to read: the
// loopified recursion becomes a uniformized loop with a per-lane stack, the
// pruning tests become masks, and every gather is masked by the lanes still
// walking. Each lane's answer must match the same ray traced alone.
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/sphere;
import stdlib/triangle;

element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle);

func distmin(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmin(r, s);
        Tri(t) => return distmin(r, t);
    }
}

func distmax(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmax(r, s);
        Tri(t) => return distmax(r, t);
    }
}

func intersects(r : Ray, sh : Shape) -> bool {
    match sh {
        Sph(s) => return intersects(r, s);
        Tri(t) => return intersects(r, t);
    }
}

extern shapes : set[Shape];

func trace(r : Ray) =
    argmin(|sh : Shape| distmin(r, sh),
           filter(|sh : Shape| intersects(r, sh) && distmin(r, sh) > 0.001,
                  shapes));

// What a ray hit, as one number: a sphere's centre height, a triangle's apex
// height, or -1 for nothing.
func hit_z(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    s = *h;
    match s {
        Sph(sp) => return sp.center.z;
        Tri(t) => return t.p2.z;
    }
}

func [[export]] hit_z_one(r : Ray) -> f32 {
    return hit_z(r);
}

func [[export]] hit_z_all(rs : array[Ray, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = hit_z(rs[i]);
    }
    return;
}

schedule {
    tree[[Shape]] ShapeBVH(center : vec3f, radius : Float)
        with Sphere(center, radius) =
    | Interior(left : ShapeBVH, right : ShapeBVH, axis : u8)
    | Leaf(data : array[Shape]) with data = data;

    shapes : ShapeBVH;

    layout shapes {
        pCount : u32;
        prims : array[Shape, pCount];
        nCount : u32;
        group[nCount] index : u16 {
            center : vec3f;
            radius : Float;
            nPrims : u8;
            axis : u8;
            switch nPrims {
                0 => Interior { offset : u16; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u16; data = range(prims, pOffset, cast[[u16]](nPrims)); };
            };
        };
    };

    trace.loopify(64);
    hit_z_all.vectorize(i);
}
