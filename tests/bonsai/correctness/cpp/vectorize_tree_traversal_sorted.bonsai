//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_sorted.cpp -I. -o tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_sorted.o, clang++ tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_sorted.o tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted.o -o tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted, ./tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted, rm tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_sorted.o, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted.h, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal_sorted.o

// vectorize_tree_traversal.bonsai with a front-to-back `sort()` on the
// traversal, and rays whose lanes disagree about which child is nearer.
//
// A sort decides which child a lane descends into first, by a key of the
// lane's own ray: pbrt's rule flips the order when the ray runs backwards
// along the axis the node was split on. The rays here alternate the sign of
// their direction along that axis from lane to lane, so within one gang half
// the lanes push the children in one order and half in the other, and the
// per-lane stacks hold different nodes at the same depth. A gang whose lanes
// walk the tree in different orders is the case a renderer's centre column
// makes -- rays whose direction along the split axis is nearly zero, and of
// either sign from sample to sample -- and the answer must not depend on it:
// each lane's hit must match the same ray traced alone, and the shape it
// names must be the one adt-bvh's unsorted walk finds.
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/sphere;
import stdlib/triangle;

element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle);

func distmin(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmin(r, s);
        Tri(t) => return distmin(r, t);
    }
}

func distmax(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmax(r, s);
        Tri(t) => return distmax(r, t);
    }
}

func intersects(r : Ray, sh : Shape) -> bool {
    match sh {
        Sph(s) => return intersects(r, s);
        Tri(t) => return intersects(r, t);
    }
}

extern shapes : set[Shape];

func trace(r : Ray) =
    argmin(|sh : Shape| distmin(r, sh),
           filter(|sh : Shape| intersects(r, sh) && distmin(r, sh) > 0.001,
                  shapes));

// What a ray hit, as one number: a sphere's centre height, a triangle's apex
// height, or -1 for nothing.
func hit_z(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    s = *h;
    match s {
        Sph(sp) => return sp.center.z;
        Tri(t) => return t.p2.z;
    }
}

func [[export]] hit_z_one(r : Ray) -> f32 {
    return hit_z(r);
}

func [[export]] hit_z_all(rs : array[Ray, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = hit_z(rs[i]);
    }
    return;
}

schedule {
    tree[[Shape]] ShapeBVH(center : vec3f, radius : Float)
        with Sphere(center, radius) =
    | Interior(left : ShapeBVH, right : ShapeBVH, axis : u8)
    | Leaf(data : array[Shape]) with data = data;

    shapes : ShapeBVH;

    layout shapes {
        pCount : u32;
        prims : array[Shape, pCount];
        nCount : u32;
        group[nCount] index : u16 {
            center : vec3f;
            radius : Float;
            nPrims : u8;
            axis : u8;
            switch nPrims {
                0 => Interior { offset : u16; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u16; data = range(prims, pOffset, cast[[u16]](nPrims)); };
            };
        };
    };

    // pbrt's rule: if the ray points down the axis this node was split on,
    // its second child is the nearer one, so give branch 1 the smaller key.
    trace.sort(shapes.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
    hit_z_all.vectorize(i);
}
