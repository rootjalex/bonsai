//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet
//! commands: clang++ -std=c++20 -O3 -DBVH4_PTR_ARENA_PACKET -c tests/bonsai/correctness/cpp/main_bvh4_ptr_arena.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_ptr_arena_packet.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_ptr_arena_packet.o tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet.o -o tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet, ./tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet, rm tests/bonsai/correctness/cpp/main_bvh4_ptr_arena_packet.o, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet.h, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena_packet.o

// bvh4_ptr_arena.bonsai's program, scene and tree -- Embree's NodeRef as an
// address with the kind in its low bits, looked up in a `ptr group`, the
// children's boxes in the parent's row, Triangle4 tiles -- with its rays
// traced in gangs of eight by the packet schedule: the gang made first, the
// traversal sorted and put on a stack afterwards (bvh4_child_volumes_packet
// .bonsai is the same order over a tree of index rows; this is the order over
// Embree's bytes, the layout apps/rtq/schedules/packet16.bonsai runs over).
// One node for the gang, each child's call made under the mask of the lanes
// whose ray meets its box, the children's order decided once for the gang by
// the majority of the lanes that are on, one stack of nodes and masks; the
// leaf's tiles tested one lane at a time by the gang, the zero triangles of a
// half-full tile missing every ray. The occluded query is the same without
// an order. No prefetch: Embree's chunk traversal has none.
//
// The driver (main_bvh4_ptr_arena.cpp, built with BVH4_PTR_ARENA_PACKET) runs the scalar
// checks as before and then the same nineteen rays as a batch -- two whole
// gangs and a tail of three, so the split's guard is exercised -- through
// `trace_all` and `occluded_all`, and requires each lane's answer to be the
// one the same ray got alone.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

// What a ray hit, as one number the driver can compare: the wall's x plus a
// thousand times its lane's z, or -1 for nothing.
func hit_code(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    t = *h;
    return t.p0.x + 1000.0 * (t.p0.z + 1.0);
}

func [[export]] trace_all(n : u32, rs : array[Ray, n], out : mut array[f32, n]) {
    parfor i in 0u:n {
        out[i] = hit_code(rs[i]);
    }
    return;
}

func [[export]] occluded_all(n : u32, rs : array[Ray, n], out : mut array[i32, n]) {
    parfor i in 0u:n {
        out[i] = cast[[i32]](occluded(rs[i]));
    }
    return;
}

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    // The layout of bvh4_ptr_arena.bonsai, unchanged: one arena of bytes, a
    // reference the address of what it names with the kind in its low four
    // bits, Embree's AABBNode<4> rows and Triangle4 tiles.
    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    // The gang first -- the batch's rays in gangs of eight, the tail guarded
    // -- then the order and the stack. The directives are applied in the
    // order they are written; the traversal's own loops (a node's children,
    // a tile's lanes) stay loops the gang runs.
    trace_all.split(i, i_gang, i_lane, 8, true)
             .vectorize(i_lane);
    occluded_all.split(i, i_gang, i_lane, 8, true)
                .vectorize(i_lane);
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    occluded.loopify(64);
}
