//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_union
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_vectorize_union.cpp -I. -o tests/bonsai/correctness/cpp/main_vectorize_union.o, clang++ tests/bonsai/correctness/cpp/main_vectorize_union.o tests/bonsai/correctness/cpp/vectorize_union.o -o tests/bonsai/correctness/cpp/vectorize_union, ./tests/bonsai/correctness/cpp/vectorize_union, rm tests/bonsai/correctness/cpp/vectorize_union, rm tests/bonsai/correctness/cpp/main_vectorize_union.o, rm tests/bonsai/correctness/cpp/vectorize_union.h, rm tests/bonsai/correctness/cpp/vectorize_union.o

// A variant built per lane, carried per lane, and matched per lane.
//
// A variant with an inline layout is a tag and a union, and a gang whose
// lanes hold different variants holds a union per lane: the vectorizer widens
// the union as one scalar union per lane (see ir::widen), so a lane's bytes
// are its own whatever its neighbours hold. Building one from a member value
// per lane, and reading one member out of every lane at once, are then
// transposes between that array of unions and the struct of gang-wide vectors
// the member is otherwise carried as, which the backend lowers as interleaves
// (see ir::Shuffle).
//
// The members are of unlike shapes on purpose -- one float, two integers, a
// three-vector beside a flag -- so that every lane's bytes are read at a
// different type from its neighbours', the unit the transposes work in is
// smaller than some fields, and the padding of the smaller members is real.
// Each lane picks its variant by its index, so every gang holds all three.
import stdlib/numerics;

element Blob =
    | Whole(x : f32)
    | Split(lo : i32, hi : i32)
    | Wide(v : vec3f, neg : bool);

func make_blob(v : f32, i : i32) -> Blob {
    if (i % 3 == 0) {
        return Whole(v);
    }
    if (i % 3 == 1) {
        return Split(i, i * 10);
    }
    return Wide(vec3f{v, 2.0 * v, 3.0 * v}, v < 0.0);
}

func weigh(b : Blob) -> f32 {
    match b {
        Whole(x) => return x * 2.0;
        Split(lo, hi) => return cast[[f32]](lo + hi);
        Wide(v, neg) => return select(neg, -(v.x + v.y + v.z), v.x + v.y + v.z);
    }
}

func [[export]] weigh_all(a : array[f32, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        b : Blob = make_blob(a[i], cast[[i32]](i));
        out[i] = weigh(b);
    }
    return;
}

schedule {
    weigh_all.vectorize(i);
}
