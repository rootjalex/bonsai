//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_tiled_elements_where
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_where.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_where.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_where.o tests/bonsai/correctness/cpp/bvh4_tiled_elements_where.o -o tests/bonsai/correctness/cpp/bvh4_tiled_elements_where, ./tests/bonsai/correctness/cpp/bvh4_tiled_elements_where, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements_where, rm tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_where.o, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements_where.h, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements_where.o

// Padding lanes that are not elements, run: bvh4_tiled_elements with every
// tile carrying an id per lane and `where id != 4294967295u`, so that the
// lanes a leaf does not fill are not triangles of the set whatever they
// hold. The driver (main_bvh4_tiled_elements_where.cpp) fills them with
// decoys -- walls just in front of the real ones, which a ray would hit
// first and a point would be nearer to -- with ids of -1; the answers must
// be the real walls', for the rays as before and for the closest point to
// chosen points. The closest point is an argmin over every element, no
// filter, which the lowering prunes by each child's farthest distance as
// well as its nearest (lower/argmin-tighten-children.bonsai): a second thing
// this run checks, on a tree whose leaves hold decoy lanes the tightening
// must not count.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/point;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func [[export]] closest(p : Point) -> option[Triangle] {
    return argmin(|t : Triangle| distmin(p, t), tris);
}

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        // Slots, four to a tile; a slot is a triangle where its id is not -1.
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                p0 : vec3f;
                p1 : vec3f;
                p2 : vec3f;
                id : u32;
            } where id != 4294967295u;
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    occluded.vectorize(tris.Interior.children)
            .vectorize(tris.Leaf.data)
            .loopify(64);
    closest.sort(tris.Interior,
                 |i : u32, p : Point, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
                 distmin(p, AABB{lo[i], hi[i]}))
           .vectorize(tris.Interior.children)
           .vectorize(tris.Leaf.data)
           .loopify(64);
}
