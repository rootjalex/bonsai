//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_packet.cpp -I. -o tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_packet.o, clang++ tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_packet.o tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet.o -o tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet, ./tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet, rm tests/bonsai/correctness/cpp/main_vectorize_tree_traversal_packet.o, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet.h, rm tests/bonsai/correctness/cpp/vectorize_tree_traversal_packet.o

// vectorize_tree_traversal_sorted.bonsai with its schedule the other way
// round: the gang is made before the traversal is put on a stack, so the
// stack is the gang's -- one node the lanes share and a mask of which lanes
// reached it -- rather than one per lane. That is a packet traversal, and the
// sort's order is then decided once for the gang, by a vote over the lanes'
// keys (see ssa/vectorize-packet-traversal.bonsai for the shape).
//
// The rays alternate the sign of their lean along the split axis from lane to
// lane, so at every interior node the vote is four against four and settles
// on the order as written; half the lanes descend into their farther child
// first. That may cost them work, and it must not change what they hit: each
// lane's answer must match the same ray traced alone by the scalar
// `hit_z_one`, which walks each child in its own key's order.
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/sphere;
import stdlib/triangle;

element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle);

func distmin(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmin(r, s);
        Tri(t) => return distmin(r, t);
    }
}

func distmax(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmax(r, s);
        Tri(t) => return distmax(r, t);
    }
}

func intersects(r : Ray, sh : Shape) -> bool {
    match sh {
        Sph(s) => return intersects(r, s);
        Tri(t) => return intersects(r, t);
    }
}

extern shapes : set[Shape];

func trace(r : Ray) =
    argmin(|sh : Shape| distmin(r, sh),
           filter(|sh : Shape| intersects(r, sh) && distmin(r, sh) > 0.001,
                  shapes));

// What a ray hit, as one number: a sphere's centre height, a triangle's apex
// height, or -1 for nothing.
func hit_z(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    s = *h;
    match s {
        Sph(sp) => return sp.center.z;
        Tri(t) => return t.p2.z;
    }
}

func [[export]] hit_z_one(r : Ray) -> f32 {
    return hit_z(r);
}

func [[export]] hit_z_all(rs : array[Ray, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = hit_z(rs[i]);
    }
    return;
}

schedule {
    tree[[Shape]] ShapeBVH(center : vec3f, radius : Float)
        with Sphere(center, radius) =
    | Interior(left : ShapeBVH, right : ShapeBVH, axis : u8)
    | Leaf(data : array[Shape]) with data = data;

    shapes : ShapeBVH;

    layout shapes {
        pCount : u32;
        prims : array[Shape, pCount];
        nCount : u32;
        group[nCount] index : u16 {
            center : vec3f;
            radius : Float;
            nPrims : u8;
            axis : u8;
            switch nPrims {
                0 => Interior { offset : u16; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u16; data = range(prims, pOffset, cast[[u16]](nPrims)); };
            };
        };
    };

    // The gang first, then the stack. pbrt's rule for the key: if the ray
    // points down the axis this node was split on, its second child is the
    // nearer one, so give branch 1 the smaller key.
    hit_z_all.vectorize(i);
    trace.sort(shapes.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
}
