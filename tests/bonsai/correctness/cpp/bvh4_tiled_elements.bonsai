//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_tiled_elements
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh4_tiled_elements.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_tiled_elements.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_tiled_elements.o tests/bonsai/correctness/cpp/bvh4_tiled_elements.o -o tests/bonsai/correctness/cpp/bvh4_tiled_elements, ./tests/bonsai/correctness/cpp/bvh4_tiled_elements, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements, rm tests/bonsai/correctness/cpp/main_bvh4_tiled_elements.o, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements.h, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements.o

// Embree's bytes, run: a BVH whose node rows hold the children's bounds as
// six component vectors with `lo` and `hi` derived from them, and whose
// leaves are tiles of four triangles with every field a vector over the four
// (lower/tiled-elements.bonsai explains both), sorted nearest child first,
// put on a stack, and run against rays whose answers are known.
//
// The scene and the rays are bvh4_child_volumes's: walls facing the x axis
// at known positions along lanes in z, a tree split in x so that a ray along
// +x crosses every child's box in order. What is new is what the driver
// (main_bvh4_tiled_elements.cpp) writes: a leaf of two walls is one tile,
// the two walls in lanes 0 and 1 and the zero triangle in lanes 2 and 3 --
// which the traversal reads as four elements and tests as four, the zero
// ones missing every ray, as Embree's padding lanes do -- and a node's boxes
// go into `lower_x[i]`, `upper_x[i]`, ... as Embree's setBounds puts them.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        // Slots, four to a tile.
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                p0 : vec3f;
                p1 : vec3f;
                p2 : vec3f;
            };
        };
        nCount : u32;
        // Embree's AABBNode<4>: the children, then the bounds by component in
        // Embree's order; the tree's `lo` and `hi` derived from them.
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        // Embree's NodeRef: the low four bits say what it is, 0 an interior
        // node at row `ref >> 4`, 8 + n a leaf of n tiles from tile
        // `ref >> 4`.
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    occluded.loopify(64);
}
