//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/unroll_let_names
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_unroll_let_names.cpp -I. -o tests/bonsai/correctness/cpp/main_unroll_let_names.o, clang++ tests/bonsai/correctness/cpp/main_unroll_let_names.o tests/bonsai/correctness/cpp/unroll_let_names.o -o tests/bonsai/correctness/cpp/unroll_let_names, ./tests/bonsai/correctness/cpp/unroll_let_names, rm tests/bonsai/correctness/cpp/unroll_let_names, rm tests/bonsai/correctness/cpp/main_unroll_let_names.o, rm tests/bonsai/correctness/cpp/unroll_let_names.h, rm tests/bonsai/correctness/cpp/unroll_let_names.o

// bvh2_unrolled run with the sort key going through a `let` of a call's
// result: the children loop unrolled, each copy of its body binding `k` to
// what `half` returns -- a named Set in the SSA, one per copy, both under
// the program's name, which the simplifier's value numbering has to tell
// apart (ssa/blocks/unroll-let-names.bonsai says what went wrong when it
// told them apart by name: the two children's keys became one value and
// the nearer child was no longer entered first). The answers are the ones
// the ordering cannot change -- the nearest wall along the ray -- so this
// run pins that the program is right; the block golden pins the two Sets
// and the two keys.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

// Not copied in, so that its result is a value the let names.
func [[noinline]] half(x : Float) -> Float = x * 0.5;

func key(r : Ray, lo : vec3f, hi : vec3f) -> Float {
    k = half(entry(r, AABB{lo, hi}));
    s = r.o.x * 0.0 + 1.0;
    return k * s;
}

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               key(r, lo[i], hi[i]))
         .unroll(tris.Interior.children)
         .loopify(64);
    occluded.unroll(tris.Interior.children).loopify(64);
}
