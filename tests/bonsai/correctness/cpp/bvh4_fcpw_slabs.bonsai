//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_fcpw_slabs
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh4_fcpw_slabs.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_fcpw_slabs.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_fcpw_slabs.o tests/bonsai/correctness/cpp/bvh4_fcpw_slabs.o -o tests/bonsai/correctness/cpp/bvh4_fcpw_slabs, ./tests/bonsai/correctness/cpp/bvh4_fcpw_slabs, rm tests/bonsai/correctness/cpp/bvh4_fcpw_slabs, rm tests/bonsai/correctness/cpp/main_bvh4_fcpw_slabs.o, rm tests/bonsai/correctness/cpp/bvh4_fcpw_slabs.h, rm tests/bonsai/correctness/cpp/bvh4_fcpw_slabs.o

// FCPW's arithmetic over Embree's bytes, run: the scene, tree and rays of
// bvh4_tiled_elements with the geometry written as FCPW computes it
// (apps/rtq/metrics/fcpw.bonsai) -- the slab test with every intermediate
// a named three-vector (`t0`, `t1`, `tNear`, `tFar`) and its two tests one
// conjunction, `tMin <= tMax && proper`; Moeller-Trumbore with its
// reciprocal taken as enoki takes it, the machine's estimate and the step
// `2r - (r m) r` (rcp_fcpw) -- and the children's loop vectorized, so that
// the slab test is a gang callee inlined into the traversal
// (SSA/Vectorize.cpp inline_pure_variants) twice over, once as the
// children's test and once inside the `distmin` their keys and bounds are.
//
// What this run guards. A `let` of a fresh value renames the value's
// instruction (`t1 = (b.high - r.o) * rinvD` is one multiply, named `t1`),
// and the block's table of names kept the old `@N` as well, so a copy of the
// callee carried `@N -> t1` into the caller, where `@N` was the caller's
// own instruction -- here a component of the children's `lo` -- and the
// simplifier's table, which takes an instruction's value from that table
// by name, handed the callee's `t1` out for it (SSA/SSA.cpp
// Block::make_instruction, SSA/Rewrite.cpp inline_call). The box the
// children's test received was then one lane of the slab test's own
// output, and the program would not even compile. Every answer here is the
// one the scene was built to give; the zero triangle in a leaf's unfilled
// lanes is rejected by FCPW's own `|det| > epsilon`, as FCPW rejects it.
import stdlib/aabb;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

element FInterval {
    low, high : Float;
}

// enoki's reciprocal (enoki/array_avx512.h rcp_): the machine's estimate,
// then `t0 = r + r`, `t1 = r m`, `t0 - t1 r` as one fused multiply-subtract.
func rcp_fcpw(m : Float) -> Float {
    r = rcp_approx(m);
    t0 = r + r;
    t1 = r * m;
    return t0 - t1 * r;
}

// FCPW: intersectWideBox, with the box's own mark for an empty slot (an
// inverted box) tested beside the slabs, as FCPW tests the slot's.
func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    proper = b.low.x <= b.high.x;
    rinvD = vec3f{1.0, 1.0, 1.0} / r.d;
    t0 = (b.low - r.o) * rinvD;
    t1 = (b.high - r.o) * rinvD;
    tNear = min(t0, t1);
    tFar = max(t0, t1);
    tMin = max(0.0, max(max(tNear.x, tNear.y), tNear.z));
    tMax = min(r.tmax, min(min(tFar.x, tFar.y), tFar.z));
    if tMin <= tMax && proper {
        return FInterval{tMin, tMax};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

func contains(r : Ray, b : AABB) -> bool = false;

element TriangleHit {
    t, u, v : Float;
}

// FCPW: intersectWideTriangle, Moeller-Trumbore over the edges from the
// first vertex, the determinant rejected within the float epsilon of zero.
func intersectsp_ray_tri(r : Ray, tri : Triangle) -> option[TriangleHit] {
    epsilon : Float = 1.1920929e-7;
    v1 = tri.p1 - tri.p0;
    v2 = tri.p2 - tri.p0;
    p = cross(r.d, v2);
    det = dot(v1, p);
    if !(abs(det) > epsilon) {
        return {};
    }
    invDet = rcp_fcpw(det);
    s = r.o - tri.p0;
    v = dot(s, p) * invDet;
    if !(v >= 0.0 && v <= 1.0) {
        return {};
    }
    q = cross(s, v1);
    w = dot(r.d, q) * invDet;
    if !(w >= 0.0 && v + w <= 1.0) {
        return {};
    }
    d = dot(v2, q) * invDet;
    if !(d >= 0.0 && d <= r.tmax) {
        return {};
    }
    return TriangleHit{d, v, w};
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](intersectsp_ray_tri(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return -inf;
}

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        // Slots, four to a tile.
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                p0 : vec3f;
                p1 : vec3f;
                p2 : vec3f;
            };
        };
        nCount : u32;
        // Embree's AABBNode<4>: the children, then the bounds by component in
        // Embree's order; the tree's `lo` and `hi` derived from them.
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    occluded.vectorize(tris.Interior.children)
            .vectorize(tris.Leaf.data)
            .loopify(64);
}
