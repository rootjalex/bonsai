//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/layout_tile_group_reads
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_layout_tile_group_reads.cpp -I. -o tests/bonsai/correctness/cpp/main_layout_tile_group_reads.o, clang++ tests/bonsai/correctness/cpp/main_layout_tile_group_reads.o tests/bonsai/correctness/cpp/layout_tile_group_reads.o -o tests/bonsai/correctness/cpp/layout_tile_group_reads, ./tests/bonsai/correctness/cpp/layout_tile_group_reads, rm tests/bonsai/correctness/cpp/layout_tile_group_reads, rm tests/bonsai/correctness/cpp/main_layout_tile_group_reads.o, rm tests/bonsai/correctness/cpp/layout_tile_group_reads.h, rm tests/bonsai/correctness/cpp/layout_tile_group_reads.o

// A tile whose derived fields read other groups of the layout, run: the
// scene, tree and rays of bvh4_tiled_elements_derived, with the leaves'
// triangles stored as an indexed mesh -- a tile holds the address of a face
// object (`face : u64`), the face (the row of a `ptr group` at that
// address) holds three indices into a vertex table, and the layout derives
// each corner by following the address and gathering the vertex
// (`p0 = vertices[f.i0].p`), as FCPW's CPU leaf reads a triangle through
// its polygon soup (apps/rtq/schedules/layouts/fcpwb.bonsai). The driver
// (main_layout_tile_group_reads.cpp) builds the vertex table and the face
// objects -- the faces in a vector of their own, each tile given its face's
// address, the vertex table shared by every face -- and checks every hit's
// three vertices against the wall the scene was built to give.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        vCount : u32;
        indirect group vertices[vCount] {
            p : vec3f;
        };
        fCount : u32;
        ptr group faces[fCount] {
            i0 : i32;
            i1 : i32;
            i2 : i32;
            tag : i32;
        };
        pCount : u32;
        indirect group prims[pCount] {
            group[1] {
                face : u64;
                f = faces[face];
                p0 = vertices[f.i0].p;
                p1 = vertices[f.i1].p;
                p2 = vertices[f.i2].p;
            };
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    occluded.loopify(64);
}
