//! flags: -b cpp -o tests/bonsai/correctness/cpp/rcp
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_rcp.cpp -I. -o tests/bonsai/correctness/cpp/main_rcp.o, clang++ tests/bonsai/correctness/cpp/main_rcp.o tests/bonsai/correctness/cpp/rcp.o -o tests/bonsai/correctness/cpp/rcp, ./tests/bonsai/correctness/cpp/rcp, rm tests/bonsai/correctness/cpp/rcp, rm tests/bonsai/correctness/cpp/main_rcp.o, rm tests/bonsai/correctness/cpp/rcp.h, rm tests/bonsai/correctness/cpp/rcp.o

// `rcp` run on the host: a scalar, a three-vector (padded to the register,
// as Embree's Vec3fa is) and a vector of four. The driver (main_rcp.cpp)
// checks each against the exact quotient to the precision an estimate
// refined by one Newton step reaches -- a relative error of a few units in
// the last place of a float, where the raw estimate's is around a part in
// four thousand -- so that both the instruction and its refinement are
// exercised wherever the host has them, and the plain division passes too.
element vec3f = vector[f32, 3];

func [[export]] rcp_scalar(x : f32) -> f32 {
    return rcp(x);
}

func [[export]] rcp_vec3(v : vec3f) -> vec3f {
    return rcp(v);
}

func [[export]] rcp_vec4(v : vector[f32, 4]) -> vector[f32, 4] {
    return rcp(v);
}
