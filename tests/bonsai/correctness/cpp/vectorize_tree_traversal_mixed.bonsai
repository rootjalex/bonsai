//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_tree_traversal_mixed
//! commands: clang++ -std=c++20 -O3 -DVECTORIZED -c $<>/main_mixed_tlas.cpp -I. -o $<>/main_mixed_tlas_vectorized.o, clang++ $<>/main_mixed_tlas_vectorized.o $<>/vectorize_tree_traversal_mixed.o -o $<>/vectorize_tree_traversal_mixed, ./$<>/vectorize_tree_traversal_mixed, rm $<>/vectorize_tree_traversal_mixed, rm $<>/main_mixed_tlas_vectorized.o, rm $<>/vectorize_tree_traversal_mixed.h, rm $<>/vectorize_tree_traversal_mixed.o

// mixed-tlas-loopified.bonsai with the query also traced for a gang of rays
// at once, run against the same driver and required to print the same thing
// -- and, lane by lane, the same thing the scalar trace prints.
//
// This is the traversal a vectorized renderer makes, in small: a top-level
// tree whose elements are a `tagged_index` variant -- each lane's primitive a
// tag and an index into an arm's pool -- standalone triangles beside
// instances, each holding a tree of its own that the walk enters with the ray
// pulled back into the instance's frame; the best hit remembered per lane as
// a tagged index (see Lower/ElementReferences.cpp); and eight rays whose
// walks diverge at every node.
//
// The outer walk's leaf loop dispatches on the primitive, and one of its arms
// begins the inner walk. Loopified, each walk has a stack of its own -- and the
// inner one is entered from inside a match arm inside the outer one's leaf
// loop, so a stack that leaked across the arm, or an outer walk that resumed
// in the wrong arm, would come back with a plausible hit rather than an
// error. Same answers as the recursive form is the check.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func untransform(t : Transform, r : Ray) -> Ray {
    o = t.i0 * r.o.x + t.i1 * r.o.y + t.i2 * r.o.z + t.i3;
    d = t.i0 * r.d.x + t.i1 * r.d.y + t.i2 * r.d.z;
    out : Ray = {o, d, r.tmax};
    return out;
}

element Prim =
    | Solo(tri : Triangle)
    | Inst(render_from_instance : Transform, blas : set[Triangle]);

func geometry(p : Prim) -> set[Triangle] =
    match p { Solo(tri) => set[Triangle]{tri}, Inst(m, blas) => blas };

element Prim with extent = |p| transform(p, geometry(p).AABB);

func transform(p : Prim, b : AABB) -> AABB {
    match p {
        Solo(tri) => return b;
        Inst(m, blas) => return transform(m, b);
    }
}

func untransform(p : Prim, r : Ray) -> Ray {
    match p {
        Solo(tri) => return r;
        Inst(m, blas) => return untransform(m, r);
    }
}

func [[export]] transform(p : Prim, tri : Triangle) -> Triangle {
    match p {
        Solo(t) => return tri;
        Inst(m, blas) => {
            out : Triangle = {apply(m, tri.p0), apply(m, tri.p1),
                              apply(m, tri.p2)};
            return out;
        }
    }
}

func [[export]] is_instance(p : Prim) -> bool {
    match p {
        Solo(tri) => return false;
        Inst(m, blas) => return true;
    }
}

extern prims : set[Prim];

func [[export]] trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, transform(p, tri)),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, transform(p, tri)) &&
                      distmin(r, transform(p, tri)) > 0.001,
                  flatten(|p : Prim| geometry(p), prims)));

// What a ray hit, as one number: the world-space x of the triangle's first
// vertex, placed by the primitive it came through, or -1 for nothing. Adds
// 1000 for a hit through an instance, so that a hit through the wrong arm
// gives a different number from the right one.
func hit_x(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    found = *h;
    placed = transform(found[0], found[1]);
    return placed.p0.x + select(is_instance(found[0]), 1000.0, 0.0);
}

func [[export]] hit_x_one(r : Ray) -> f32 {
    return hit_x(r);
}

func [[export]] hit_x_all(rs : array[Ray, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = hit_x(rs[i]);
    }
    return;
}

func [[export]] trace_any(r : Ray) =
    any(|p : Prim, tri : Triangle|
            intersects(r, transform(p, tri)) &&
            distmin(r, transform(p, tri)) > 0.001,
        flatten(|p : Prim| geometry(p), prims));

schedule {
    layout Prim = tagged_index;

    tree[[Triangle]] BLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : BLAS, right : BLAS, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    tree[[Prim]] TLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : TLAS, right : TLAS, axis : u8)
    | Leaf(data : array[Prim]) with data = data;

    prims : TLAS;
    Inst.blas : BLAS from BlasNodes;

    // Both levels, each onto a stack of its own.
    trace.loopify(64);
    trace_any.loopify(64);
    hit_x_all.vectorize(i);

    layout prims {
        tCount : u32;
        tris : array[Triangle, tCount];

        bCount : u32;
        indirect group BlasNodes[bCount] bnode : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = bnode + 1;
                                right = bnode + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(tris, pOffset, cast[[u32]](nPrims)); };
            };
        };

        pCount : u32;
        elems : array[Prim, pCount];

        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1;
                                right = index + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(elems, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };
}
