//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_ptr_arena
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh4_ptr_arena.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_ptr_arena.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_ptr_arena.o tests/bonsai/correctness/cpp/bvh4_ptr_arena.o -o tests/bonsai/correctness/cpp/bvh4_ptr_arena, ./tests/bonsai/correctness/cpp/bvh4_ptr_arena, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena, rm tests/bonsai/correctness/cpp/main_bvh4_ptr_arena.o, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena.h, rm tests/bonsai/correctness/cpp/bvh4_ptr_arena.o

// bvh4_arena.bonsai with its references as pointers: Embree's NodeRef as it
// is, an address with the kind in its low four bits -- bit 3 a leaf, the
// three below it the leaf's tile count -- looked up in a `ptr group` whose
// rows are reached by address (lower/ptr-arena-rows.bonsai and ssa/
// ptr-arena-rows-vectorized.bonsai pin what the layout and the schedule make
// of it); the walk starts at `root`, a field the layout stores. The same
// scene, known answers and checks; the driver (main_bvh4_ptr_arena.cpp)
// writes the rows and then the tiles into one allocation and rewrites every
// reference to the address of what it names, as Embree's builder leaves
// them, and puts the root's address in `root`.
//
// The scene and the rays are bvh4_child_volumes's: walls facing the x axis
// at known positions along lanes in z, a tree split in x so that a ray along
// +x crosses every child's box in order. What the driver writes: a leaf of
// two walls is one tile,
// the two walls in lanes 0 and 1 and the zero triangle in lanes 2 and 3 --
// which the traversal reads as four elements and tests as four, the zero
// ones missing every ray, as Embree's padding lanes do -- and a node's boxes
// go into `lower_x[i]`, `upper_x[i]`, ... as Embree's setBounds puts them.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    // One arena of bytes holding the node rows and the leaves' tiles; a
    // reference is the byte offset of what it names with the kind in its low
    // four bits, Embree's NodeRef as an offset (ir::Lookup::shape; see
    // lower/arena-rows.bonsai).
    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            // Embree's AABBNode<4>: the children, then the bounds by
            // component in Embree's order; the tree's `lo` and `hi` derived
            // from them. An interior node's kind bits are zero, so its
            // reference is its address.
            0 => Interior from arena[ref] {
                children : vector[u64, 4];
                lower_x : vector[f32, 4];
                upper_x : vector[f32, 4];
                lower_y : vector[f32, 4];
                upper_y : vector[f32, 4];
                lower_z : vector[f32, 4];
                upper_z : vector[f32, 4];
                lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
            };
            // A leaf, bit 3 set, of n tiles in its low three bits, from the
            // address with the kind taken off.
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    trace.prefetch(tris.Interior.children);
    occluded.vectorize(tris.Interior.children)
            .vectorize(tris.Leaf.data)
            .loopify(64);
    occluded.prefetch(tris.Interior.children);
}
