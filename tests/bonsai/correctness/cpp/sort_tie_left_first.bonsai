//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/sort_tie_left_first
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_sort_tie_left_first.cpp -I. -o tests/bonsai/correctness/cpp/main_sort_tie_left_first.o, clang++ tests/bonsai/correctness/cpp/main_sort_tie_left_first.o tests/bonsai/correctness/cpp/sort_tie_left_first.o -o tests/bonsai/correctness/cpp/sort_tie_left_first, ./tests/bonsai/correctness/cpp/sort_tie_left_first, rm tests/bonsai/correctness/cpp/sort_tie_left_first, rm tests/bonsai/correctness/cpp/main_sort_tie_left_first.o, rm tests/bonsai/correctness/cpp/sort_tie_left_first.h, rm tests/bonsai/correctness/cpp/sort_tie_left_first.o

// The order a sorted run of two children is visited in when their keys tie:
// the left child first, as FCPW's and Embree's traversals have it (their
// swaps are strict compares, `boxHits[2] < boxHits[0]`, `d1 < d0`), which
// SSA/SortRecursion.cpp's compare_and_swap exchanges a pair on only where
// the later element is strictly the smaller. A tie is every ray whose origin
// lies inside both children's boxes -- the slab entry is zero for both --
// which near a tree's root is most rays of a camera inside the scene; the
// order decides which side is descended first and so how many nodes the
// first hit visits before its bound closes (apps/rtq/PLAN.md, the
// 2026-10-26 reading of the ray gap against FCPW's scalar tree). The order
// is observed through the answer: main_sort_tie_left_first.cpp builds a
// root over two leaves of one triangle each, both triangles in the plane
// x = 10 across the ray's path, so that the ray meets both at the same t;
// the first hit keeps the first one found (`t < best`), and which triangle
// comes back says which child was entered first. Three trees: both boxes
// holding the origin (a tie: the left's triangle), the right box strictly
// nearer (the right's), the left box strictly nearer (the left's).
// ssa/blocks/sort.expect pins the compare and the selects; the LLVM goldens
// of the two-child traversals pin the generated code.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               entry(r, AABB{lo[i], hi[i]}))
         .unroll(tris.Interior.children)
         .loopify(64);
}
