//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/vectorize_skip_arms
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_vectorize_skip_arms.cpp -I. -o tests/bonsai/correctness/cpp/main_vectorize_skip_arms.o, clang++ tests/bonsai/correctness/cpp/main_vectorize_skip_arms.o tests/bonsai/correctness/cpp/vectorize_skip_arms.o -o tests/bonsai/correctness/cpp/vectorize_skip_arms, ./tests/bonsai/correctness/cpp/vectorize_skip_arms, rm tests/bonsai/correctness/cpp/vectorize_skip_arms, rm tests/bonsai/correctness/cpp/main_vectorize_skip_arms.o, rm tests/bonsai/correctness/cpp/vectorize_skip_arms.h, rm tests/bonsai/correctness/cpp/vectorize_skip_arms.o

// The arms a gang skips, run: both arms of an `if`, an early `return` inside
// one of them, and the three arms of a `match`, each behind a test of its
// own mask (see the BOSCC gadget in SSA/Linearize.h). The driver runs gangs
// where every lane returns early, where no lane takes the then arm, and a
// mixed one, so every guard is taken and bypassed, and compares each lane
// with the same input weighed alone. What has to come out right is what a
// skipped arm's bypass hands the code after it: the value from before the
// arm, `false` for the early return's mask, and nothing a lane reads for the
// value the then arm is the first to define. The SSA is golden-diffed in
// ssa/vectorize-skip-arms.bonsai.
import stdlib/numerics;

element Shape =
    | Disc(r : f32)
    | Box(w : f32, h : f32)
    | Ring(ro : f32, ri : f32);

func classify(x : f32) -> Shape {
    if x < 0.0 {
        return Disc(-x);
    }
    if x < 4.0 {
        return Box(x, x * 0.5);
    }
    return Ring(x, x * 0.25);
}

func weigh(x : f32) -> f32 {
    acc : mut = 0.0;
    if x > 2.0 {
        t = sqrt(x) * 3.0 + 1.0;
        if t > 7.0 {
            return t;
        }
        acc = t * t - x;
    } else {
        u = x * x * 0.5 + 1.0;
        acc = u * u + u * 3.0 - 1.0;
    }
    s = classify(x);
    w : mut = 0.0;
    match s {
        Disc(r) => w = r * r * 3.0 + r * 0.5 - r;
        Box(wd, h) => w = wd * h * 2.0 + h * h - wd;
        Ring(ro, ri) => w = (ro * ro - ri * ri) * 3.0 + ri;
    }
    return acc + w;
}

func [[export]] weigh_one(x : f32) -> f32 {
    return weigh(x);
}

func [[export]] weigh_all(a : array[f32, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = weigh(a[i]);
    }
    return;
}

schedule {
    weigh_all.vectorize(i);
}
