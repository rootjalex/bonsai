//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_derived.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_derived.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_derived.o tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived.o -o tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived, ./tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived, rm tests/bonsai/correctness/cpp/main_bvh4_tiled_elements_derived.o, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived.h, rm tests/bonsai/correctness/cpp/bvh4_tiled_elements_derived.o

// Tiles that store other fields than the element's, run: bvh4_tiled_elements
// with the leaf's tiles storing a vertex and two edges -- `a`, `e1`, `e2` --
// and the element's three vertices derived from them (`p1 = a + e1`;
// lower/tiled-elements-derived.bonsai explains the form), the leaf tested
// four lanes at a time so that the derived vertices are made as vectors,
// against the same rays with the same known answers. The driver
// (main_bvh4_tiled_elements_derived.cpp) writes each wall's vertex and its
// two edges into the tile's lanes; the answers are the same walls as before,
// which the test prints by the vertex the program derives back.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        // Slots, four to a tile: a vertex and two edges stored, the three
        // vertices derived.
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                a : vec3f;
                e1 : vec3f;
                e2 : vec3f;
                p0 = a;
                p1 = a + e1;
                p2 = a + e2;
            };
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    occluded.vectorize(tris.Interior.children)
            .vectorize(tris.Leaf.data)
            .loopify(64);
}
