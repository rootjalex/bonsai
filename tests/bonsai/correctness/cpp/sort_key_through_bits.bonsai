//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/sort_key_through_bits
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_sort_key_through_bits.cpp -I. -o tests/bonsai/correctness/cpp/main_sort_key_through_bits.o, clang++ tests/bonsai/correctness/cpp/main_sort_key_through_bits.o tests/bonsai/correctness/cpp/sort_key_through_bits.o -o tests/bonsai/correctness/cpp/sort_key_through_bits, ./tests/bonsai/correctness/cpp/sort_key_through_bits, rm tests/bonsai/correctness/cpp/sort_key_through_bits, rm tests/bonsai/correctness/cpp/main_sort_key_through_bits.o, rm tests/bonsai/correctness/cpp/sort_key_through_bits.h, rm tests/bonsai/correctness/cpp/sort_key_through_bits.o

// ssa/sort-key-through-bits.bonsai, run (main_sort_key_through_bits.cpp):
// sort_key_nonnegative's two traversals with the slab test on the floats'
// bits as Embree's AVX-512 build writes it -- integer max, min and compare
// -- and the same checks: every ray of the four-wide walls scene answered
// as the scene says by both, and on a ray whose `tnear` is negative the raw
// query accepting a wall behind the origin where the clamped one sees the
// wall ahead. The clamped query's keys are ordered without the sign flip,
// the fact having travelled through the reinterpretations to the key; and
// both node tests are the one compare with the best folded into `tFar`,
// which has to prune exactly what the compare against the best pruned.
import stdlib/aabb;
import stdlib/numerics;

element Ray {
    o : vec3f;
    tnear : Float;
    d : vec3f;
    tfar : Float;
}

element Triangle {
    p0 : vec3f;
    p1 : vec3f;
    p2 : vec3f;
}

element FInterval {
    low, high : Float;
}

func zero_fix(d : vec3f) -> vec3f {
    tiny : Float = 1e-18;
    return select(abs(d) < tiny, vec3f{tiny, tiny, tiny}, d);
}

// Embree's reciprocal: the machine's estimate and one Newton step.
func rcp_embree(a : vec3f) -> vec3f {
    r = rcp_approx(a);
    return r + r * (1.0 - a * r);
}

func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    rdir = rcp_embree(zero_fix(r.d));
    org_rdir = r.o * rdir;
    dirIsNeg = rdir < 0.0;
    near = select(dirIsNeg, b.high, b.low);
    far = select(dirIsNeg, b.low, b.high);
    tNearV = near * rdir - org_rdir;
    tFarV = far * rdir - org_rdir;
    tNear = max(max(reinterpret[[i32]](tNearV.x), reinterpret[[i32]](tNearV.y)),
                max(reinterpret[[i32]](tNearV.z), reinterpret[[i32]](r.tnear)));
    tFar = min(min(reinterpret[[i32]](tFarV.x), reinterpret[[i32]](tFarV.y)),
               min(reinterpret[[i32]](tFarV.z), reinterpret[[i32]](r.tfar)));
    if tNear <= tFar {
        return FInterval{reinterpret[[Float]](tNear), reinterpret[[Float]](tFar)};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

func contains(r : Ray, b : AABB) -> bool = false;

func hit_distance(r : Ray, tri : Triangle) -> option[Float] {
    e1 = tri.p1 - tri.p0;
    e2 = tri.p2 - tri.p0;
    p = cross(r.d, e2);
    den = dot(e1, p);
    if abs(den) < 1e-12 {
        return {};
    }
    inv = 1.0 / den;
    s = r.o - tri.p0;
    u = dot(s, p) * inv;
    if u < 0.0 || u > 1.0 {
        return {};
    }
    q = cross(s, e1);
    v = dot(r.d, q) * inv;
    if v < 0.0 || u + v > 1.0 {
        return {};
    }
    t = dot(e2, q) * inv;
    if !(r.tnear < t && t <= r.tfar) {
        return {};
    }
    return t;
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](hit_distance(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = hit_distance(r, tri);
    if hit {
        return *hit;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = hit_distance(r, tri);
    if hit {
        return *hit;
    }
    return -inf;
}

extern tris : set[Triangle];

// The segment clamped to a non-negative number (see the ssa test).
func clamped(r : Ray) -> Ray = Ray{r.o, select(r.tnear > 0.0, r.tnear, 0.0), r.d,
                                  select(r.tfar > 0.0, r.tfar, 0.0)};

func [[export]] trace(r0 : Ray) -> option[Triangle] {
    r = clamped(r0);
    return argmin(|t : Triangle| distmin(r, t),
                  filter(|t : Triangle| intersects(r, t), tris));
}

func [[export]] trace_raw(r : Ray) -> option[Triangle] {
    return argmin(|t : Triangle| distmin(r, t),
                  filter(|t : Triangle| intersects(r, t), tris));
}

func [[export]] occluded(r0 : Ray) -> bool {
    r = clamped(r0);
    return any(|t : Triangle| intersects(r, t), tris);
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lo : vector[vec3f, 4];
            hi : vector[vec3f, 4];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .loopify(64);
    trace_raw.sort(tris.Interior,
                   |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
                   distmin(r, AABB{lo[i], hi[i]}))
             .loopify(64);
    occluded.loopify(64);
}
