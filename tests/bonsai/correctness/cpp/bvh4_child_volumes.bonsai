//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh4_child_volumes
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh4_child_volumes.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh4_child_volumes.o, clang++ tests/bonsai/correctness/cpp/main_bvh4_child_volumes.o tests/bonsai/correctness/cpp/bvh4_child_volumes.o -o tests/bonsai/correctness/cpp/bvh4_child_volumes, ./tests/bonsai/correctness/cpp/bvh4_child_volumes, rm tests/bonsai/correctness/cpp/bvh4_child_volumes, rm tests/bonsai/correctness/cpp/main_bvh4_child_volumes.o, rm tests/bonsai/correctness/cpp/bvh4_child_volumes.h, rm tests/bonsai/correctness/cpp/bvh4_child_volumes.o

// A BVH whose nodes hold their children's boxes -- Embree's AABBNode, four
// wide -- built by the driver, sorted nearest child first, put on a stack,
// and run against rays whose answers are known.
//
// ssa/child-volumes-sorted.bonsai pins what the schedule makes of this; this
// pins that what it makes is right. The driver (main_bvh4_child_volumes.cpp)
// lays out walls facing the x axis at known positions along lanes in z, and
// builds the tree by splitting the walls in x, so that a ray along +x passes
// through every child's box in order and has to find the nearest wall, a ray
// along -x the farthest, and a ray down a lane with no wall nothing. Each
// answer is checked against the one the scene was built to give.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

func [[inline]] child_box(i : u8, l0 : vec3f, l1 : vec3f, l2 : vec3f,
                          l3 : vec3f, h0 : vec3f, h1 : vec3f, h2 : vec3f,
                          h3 : vec3f) -> AABB {
    low = select(i == 0, l0, select(i == 1, l1, select(i == 2, l2, l3)));
    high = select(i == 0, h0, select(i == 1, h1, select(i == 2, h2, h3)));
    return AABB{low, high};
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(c0 c1 c2 c3 : BVH4, l0 l1 l2 l3 : vec3f, h0 h1 h2 h3 : vec3f)
        with AABB(l0, h0) on c0 with AABB(l1, h1) on c1
        with AABB(l2, h2) on c2 with AABB(l3, h3) on c3
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            c0 = children[0]; c1 = children[1]; c2 = children[2]; c3 = children[3];
            l0 = vec3f{lower_x[0], lower_y[0], lower_z[0]}; h0 = vec3f{upper_x[0], upper_y[0], upper_z[0]};
            l1 = vec3f{lower_x[1], lower_y[1], lower_z[1]}; h1 = vec3f{upper_x[1], upper_y[1], upper_z[1]};
            l2 = vec3f{lower_x[2], lower_y[2], lower_z[2]}; h2 = vec3f{upper_x[2], upper_y[2], upper_z[2]};
            l3 = vec3f{lower_x[3], lower_y[3], lower_z[3]}; h3 = vec3f{upper_x[3], upper_y[3], upper_z[3]};
        };
        // A reference's low four bits say what it is: 0 an interior node at
        // row `ref >> 4`, 8 + n a leaf of n triangles starting at `ref >> 4`.
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u8, r : Ray, l0 : vec3f, l1 : vec3f, l2 : vec3f, l3 : vec3f,
                h0 : vec3f, h1 : vec3f, h2 : vec3f, h3 : vec3f|
               entry(r, child_box(i, l0, l1, l2, l3, h0, h1, h2, h3)))
         .loopify(64);
    occluded.loopify(64);
}
