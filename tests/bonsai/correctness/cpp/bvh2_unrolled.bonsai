//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/bvh2_unrolled
//! commands: clang++ -std=c++20 -O3 -c tests/bonsai/correctness/cpp/main_bvh2_unrolled.cpp -I. -o tests/bonsai/correctness/cpp/main_bvh2_unrolled.o, clang++ tests/bonsai/correctness/cpp/main_bvh2_unrolled.o tests/bonsai/correctness/cpp/bvh2_unrolled.o -o tests/bonsai/correctness/cpp/bvh2_unrolled, ./tests/bonsai/correctness/cpp/bvh2_unrolled, rm tests/bonsai/correctness/cpp/bvh2_unrolled, rm tests/bonsai/correctness/cpp/main_bvh2_unrolled.o, rm tests/bonsai/correctness/cpp/bvh2_unrolled.h, rm tests/bonsai/correctness/cpp/bvh2_unrolled.o

// A binary BVH whose nodes hold their children's boxes -- FCPW's scalar
// tree as the layout fcpwb.bonsai reads it, the children's boxes the
// parent's to test -- built by the driver, its children loop unrolled, the
// two sorted nearest first and put on a stack, and run against rays whose
// answers are known: the execution test beside ssa/child-volumes-unrolled-
// two.bonsai, which pins what the schedule makes of the same program.
//
// The scene and the checks are bvh4_child_volumes's (main_bvh4_child_
// volumes.cpp): walls facing the x axis at known positions along lanes in
// z, the tree split in x first and then in z, so that a ray along +x
// crosses both children's boxes of every node on its way and has to find
// the nearest wall, a ray along -x the farthest, a ray between the lanes
// nothing; the occlusion query runs over the same unrolled visit without
// the sort.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        // A reference's low four bits say what it is: 0 an interior node at
        // row `ref >> 4`, 8 + n a leaf of n triangles starting at `ref >> 4`.
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               entry(r, AABB{lo[i], hi[i]}))
         .unroll(tris.Interior.children)
         .loopify(64);
    occluded.unroll(tris.Interior.children).loopify(64);
}
