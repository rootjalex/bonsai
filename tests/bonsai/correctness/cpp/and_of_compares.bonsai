//! flags: -p ssa -b cpp -o tests/bonsai/correctness/cpp/and_of_compares
//! commands: clang++ -std=c++20 -O3 -march=native -c tests/bonsai/correctness/cpp/main_and_of_compares.cpp -I. -o tests/bonsai/correctness/cpp/main_and_of_compares.o, clang++ tests/bonsai/correctness/cpp/main_and_of_compares.o tests/bonsai/correctness/cpp/and_of_compares.o -o tests/bonsai/correctness/cpp/and_of_compares, ./tests/bonsai/correctness/cpp/and_of_compares, rm tests/bonsai/correctness/cpp/and_of_compares, rm tests/bonsai/correctness/cpp/main_and_of_compares.o, rm tests/bonsai/correctness/cpp/and_of_compares.h, rm tests/bonsai/correctness/cpp/and_of_compares.o

// ssa/and-of-compares.bonsai, run (main_and_of_compares.cpp): the rules
// that decide a conjunction's side inside the other and join two
// comparisons into one against a min or a max, against what the program
// says -- at the ties the joined compare must keep (`i <= n` with `i == n`),
// on the arm a decided select must take, with a NaN in the float case the
// rule leaves alone, and over the lanes of the vectorized form.

func [[export]] decided(c : bool, x : i32, y : i32) -> bool =
    c && (select(c, x, y) < 10);

func [[export]] decided_or(c : bool, x : i32, y : i32) -> bool =
    c || (select(c, x, y) < 10);

func [[export]] at_most(i : u32, n : u32, m : u32) -> bool = i <= n && i <= m;

func [[export]] below(i : i32, n : i32, m : i32) -> bool = n < i || m < i;

func [[export]] at_most_f(t : f32, a : f32, b : f32) -> bool = t <= a && t <= b;

func [[export]] at_most_all(is : array[u32, 8], n : u32, m : u32,
                           out : mut array[u32, 8]) -> void {
    parfor k in 0:8 {
        v = is[k];
        out[k] = select(v <= n && v <= m, 1u, 0u);
    }
    return;
}

schedule {
    at_most_all.vectorize(k);
}
