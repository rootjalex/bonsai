//! flags: -b llvm -e

// `asin`, the inverse sine, added as the companion of `acos` for the
// spherical-triangle sampling of a mesh area light. Like `acos` and `atanh` it
// is a call to libm's asinf rather than an LLVM intrinsic, so its answer is the
// one std::asin gives, bit for bit -- which is what lets apps/pbrt's
// AngleBetween match pbrt. Its IR shape is pinned by
// backends/llvm/libm-call.bonsai; this checks the values.

element Float = f32;

func close(a : Float, b : Float) -> bool = abs(a - b) < 1.0e-6;

func main() -> i32 {
    // Fixed points and known values.
    print(close(asin(0.0), 0.0));
    print(close(asin(1.0), 1.570796327));
    print(close(asin(0.0 - 1.0), 0.0 - 1.570796327));
    print(close(asin(0.5), 0.523598776));
    print(close(asin(0.0 - 0.5), 0.0 - 0.523598776));

    // The identity asin(x) + acos(x) = pi/2, which fails for anything that is
    // not the inverse sine.
    print(close(asin(0.3) + acos(0.3), 1.570796327));

    // Element-wise over a vector, taken a lane at a time through libm.
    v : vector[Float, 4] = {0.0, 0.5, 0.0 - 0.5, 1.0};
    a = asin(v);
    print(close(a[0], 0.0));
    print(close(a[1], 0.523598776));
    print(close(a[2], 0.0 - 0.523598776));
    print(close(a[3], 1.570796327));
    return 0;
}
