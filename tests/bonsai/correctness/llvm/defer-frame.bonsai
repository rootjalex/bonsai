//! flags: -p ssa -b llvm -e

// The producer's own state in the record. The result of the deferred
// recursion is written to `out[i]` *by the caller*, after the call, and `i`
// is the parfor's index: gone by the time the drain runs the entry. So the
// record keeps it -- the producer writes `i` into its iteration's slot before
// the call -- and the recursion writes its value into the iteration's result
// slot where it ends; the store runs in the pass over the record after the
// rounds, once per iteration, with both (pbrt's pixelSampleState and
// UpdateFilm). The user's rule, which the record answers for every
// iteration at once: "if the return says we saved state, save this data in
// the queue location, otherwise act as normal."
func tally(n : i32, acc : i32) -> i32 {
    if (n <= 0) {
        return acc;
    }
    return tally(n - 1, acc + n);
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        out[i] = tally(i, 0);
    }
    return;
}

func main() -> i32 {
    out : mut array[i32, 8] = {-1, -1, -1, -1, -1, -1, -1, -1};
    run(out);
    print(out);
    return 0;
}

schedule {
    sums = run.queue(root);
    tally.defer(tally, sums);
}
