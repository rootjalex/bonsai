define void @read_fields(ptr noundef %samples, ptr nocapture noundef readonly %which, ptr nocapture noundef writeonly %out) local_unnamed_addr #0 {
read_fields:
  %extract = load <8 x i32>, ptr %which, align 4
  %extract_off = shl <8 x i32> %extract, <i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3>
  %extract_x = tail call <8 x float> @llvm.x86.avx2.gather.d.ps.256(<8 x float> zeroinitializer, ptr %samples, <8 x i32> %extract_off, <8 x float> <float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000, float 0xFFFFFFFFE0000000>, i8 1)
  %extract_n_base = getelementptr inbounds i8, ptr %samples, i64 4
  %extract_n = tail call <8 x i32> @llvm.x86.avx2.gather.d.d.256(<8 x i32> zeroinitializer, ptr nonnull %extract_n_base, <8 x i32> %extract_off, <8 x i32> <i32 -1, i32 -1, i32 -1, i32 -1, i32 -1, i32 -1, i32 -1, i32 -1>, i8 1)
  %0 = sitofp <8 x i32> %extract_n to <8 x float>
  %1 = fmul <8 x float> %extract_x, %0
  store <8 x float> %1, ptr %out, align 4
  ret void
}

