//! flags: -p ssa -b llvm -e

// `a && b` evaluates `b` only when `a` holds, as C does: `y != 0 && 100 / y
// > 3` with y = 0 must not divide, and an integer division by zero traps.
// The same for `||`. `guarded` is a call rather than an operator so that
// the division is work the condition spares (see SSA/Convert.cpp,
// short_circuit).

func [[noinline]] guarded(y : i32) -> bool {
    return 100 / y > 3;
}

func test_and(y : i32) -> i32 {
    if y != 0 && guarded(y) {
        return 1;
    }
    return 0;
}

func value_and(y : i32) -> i32 {
    ok = y != 0 && guarded(y);
    return cast[[i32]](ok);
}

func value_or(y : i32) -> i32 {
    ok = y == 0 || guarded(y);
    return cast[[i32]](ok);
}

func main() -> i32 {
    out : mut array[i32, 6] = {-1, -1, -1, -1, -1, -1};
    out[0] = test_and(0);
    out[1] = test_and(20);
    out[2] = value_and(0);
    out[3] = value_and(20);
    out[4] = value_or(0);
    out[5] = value_or(50);
    // {0, 1, 0, 1, 1, 0}: 100 / 20 = 5 > 3; 100 / 50 = 2, not > 3.
    print(out);
    return 0;
}
