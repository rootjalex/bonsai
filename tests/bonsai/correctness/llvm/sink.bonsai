//! flags: -p ssa -b llvm -e

// Execution under the ssa pipeline, where Opt/Sink runs between CSE and
// DCE: the answers must be the ones the unsunk program gives. The shapes
// it exercises are the ones the pass moves: a value read by one arm of a
// branch (sunk into it), by two arms of three (duplicated under fresh
// names into those two and gone from the third's path), by none (left for
// DCE), and one that reads a mutable and may not cross its store.

element Probe {
    kind : i32;
    a : f32;
    b : f32;
}

func classify(p : Probe) -> f32 {
    // `heavy` is read by kinds 0 and 1 and not by 2: the duplication case.
    heavy = sqrt(p.a * p.a + p.b * p.b);
    // `one` is read by kind 0 alone: the plain sink-into-an-arm case.
    one = p.a * 3.0 - p.b;
    // `acc` pins `early` above the store.
    acc : mut f32 = p.a;
    early = acc + 100.0;
    acc = acc * 2.0;
    if p.kind == 0 {
        return heavy + one + early;
    }
    if p.kind == 1 {
        return heavy - acc;
    }
    return p.b + acc;
}

func main() -> i32 {
    p0 : Probe = {0, 3.0, 4.0};
    p1 : Probe = {1, 3.0, 4.0};
    p2 : Probe = {2, 3.0, 4.0};
    // 5 + (9 - 4) + 103 = 113; 5 - 6 = -1; 4 + 6 = 10.
    print(classify(p0));
    print(classify(p1));
    print(classify(p2));
    return 0;
}
