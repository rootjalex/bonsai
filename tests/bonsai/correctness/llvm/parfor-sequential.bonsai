//! flags: -b llvm -e

// A `parfor` that no schedule placed on any hardware, run.
//
// `parfor` says the iterations may run in any order; one after another is one
// of those orders, so an unplaced one is emitted as the counted loop it is,
// by the same code that emits a sequential one. Before that it could not be
// compiled at all -- every backend declared ir::ParFor with RESTRICT_VISITOR,
// so a parfor only worked if a schedule removed it first.
//
// What is checked here is that the loop actually runs over the whole range,
// with the right index at each step, for a stride of one and of more than one.

func doubled(n : i32, a : array[i32, 8], out : mut array[i32, 8]) -> void {
    parfor i in 0:n {
        out[i] = a[i] * 2;
    }
    return;
}

func strided(n : i32, out : mut array[i32, 8]) -> void {
    parfor i in 0:n:2 {
        out[i] = i + 100;
    }
    return;
}

func main() -> i32 {
    a : array[i32, 8] = {1, 2, 3, 4, 5, 6, 7, 8};
    d : mut array[i32, 8] = {0, 0, 0, 0, 0, 0, 0, 0};
    doubled(8, a, d);
    print(d);

    // A range that stops short of the array, so a loop that ran too far would
    // show up as a changed tail.
    e : mut array[i32, 8] = {0, 0, 0, 0, 0, 0, 0, 0};
    doubled(5, a, e);
    print(e);

    s : mut array[i32, 8] = {0, 0, 0, 0, 0, 0, 0, 0};
    strided(8, s);
    print(s);
    return 0;
}
