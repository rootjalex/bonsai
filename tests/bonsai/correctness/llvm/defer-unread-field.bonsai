//! flags: -p ssa -b llvm -e

// A struct argument of which the callee reads two fields of three
// (tests/bonsai/ssa/defer-unread-field.bonsai reads the layout): the queue
// carries `hi` and `step` and not `lo`, and the walk from i in steps of
// i + 1 up to 10 sums what it visits: i + (i + s) + (i + 2s) + ... below 10.

element Span {
    lo : i32;
    hi : i32;
    step : i32;
}

func walk(n : i32, acc : i32, span : Span) -> i32 {
    if (n >= span.hi) {
        return acc;
    }
    next : Span = {n, span.hi, span.step};
    return walk(n + span.step, acc + n, next);
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        s : Span = {i, 10, i + 1};
        out[i] = walk(i, 0, s);
    }
    return;
}

func main() -> i32 {
    out : mut array[i32, 8] = {-1, -1, -1, -1, -1, -1, -1, -1};
    run(out);
    // i=0: 0+1+...+9 = 45; i=1: 1+3+5+7+9 = 25; i=2: 2+5+8 = 15; i=3: 3+7 = 10;
    // i=4: 4+9 = 13; i=5: 5; i=6: 6; i=7: 7
    print(out);
    return 0;
}

schedule {
    sums = run.queue(root);
    walk.defer(walk, sums);
}
