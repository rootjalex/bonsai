func g(ys: array[array[i32, 2], 2], i: i32, j: i32) -> i32 {
    y1 : i32 = ys[0,0];
    y2 : i32 = ys[0,1];
    y3 : i32 = ys[1,0];
    y4 : i32 = ys[1,1];
    print(y1);
    print(y2);
    print(y3);
    print(y4);
    return 0;
}

func main() -> i32 {
    // xs : array[i32, 4] = {0, 1, 2, 3};
    // i: i32 = 1;
    // j: i32 = f(xs, i);

    v0: array[i32, 2] = {1,2};
    print(v0[0]);
    print(v0[1]);
    
    v1: array[i32, 2] = {3,4};
    print(v1[0]);
    print(v1[1]);

    ys: array[array[i32, 2], 2] = {v0, v1};

    return g(ys, 1, 2);
}


