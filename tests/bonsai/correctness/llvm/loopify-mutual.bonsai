//! flags: -p ssa -b llvm -e

// ssa/loopify-mutual's program, run: a recursion through another function
// made a loop gives the recursion's answers. step(10, 0) sums 10 down to 1
// through `route` ten times; step(3, 5) adds 3, 2 and 1 to 5; route(2, 2000)
// returns at once, and `route` is still a function of its own for that.

func step(n : i32, acc : i32) -> i32 {
    if n == 0 {
        return acc;
    }
    return route(n, acc + n);
}

func route(n : i32, acc : i32) -> i32 {
    if acc > 1000 {
        return acc;
    }
    return step(n - 1, acc);
}

func main() -> i32 {
    // 55
    print(step(10, 0));
    // 11
    print(step(3, 5));
    // 2000
    print(route(2, 2000));
    return 0;
}

schedule {
    step.loopify();
}
