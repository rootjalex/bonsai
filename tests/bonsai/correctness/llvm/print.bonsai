func main() -> i32 {
    i: i32 = -42;
    print(i);
    
    j: f32 = 42.0;
    print(j);
    
    k: u32 = 4294967295u;
    print(k);

    l: bool = true;
    print(l);
    
    m: bool = false;
    print(m);

    v : vector[i32, 3] = {1, 2, 3};
    print(v);

    w : vector[bool, 3] = {true, false, true};
    print(w);
    
    return 0;
}
