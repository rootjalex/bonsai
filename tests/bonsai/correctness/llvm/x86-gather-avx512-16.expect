  %extract_n_up = getelementptr i8, ptr %samples, i64 2147483652
  %extract_n = tail call <16 x i32> @llvm.x86.avx512.mask.gather.dpi.512(<16 x i32> zeroinitializer, ptr %extract_n_up, <16 x i32> %extract_x_flip, <16 x i1> splat (i1 true), i32 1)
  %0 = sitofp <16 x i32> %extract_n to <16 x float>
  %1 = fmul <16 x float> %extract_x, %0
  store <16 x float> %1, ptr %out, align 4
  ret void
}

