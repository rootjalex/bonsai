//! flags: -p ssa -b llvm -e

// tests/bonsai/ssa/loopify-exits' program, run: a loopified recursion whose
// exits were brought together after the loop (funnel_exits in
// SSA/Rewrite.cpp) computes what the recursion computed, by every exit --
// the first walk runs out of steps (1 -> 1.5 -> 2.25 -> 3.375, then
// finish(3.375, 0) = 1.6875), the second passes half the limit on its
// second step (finish(2.25, 4) = 5.125), the third passes the limit at once
// (0). The two `finish` exits are one arm after the loop, entered with
// different values; the first and second walks check that each enters it
// with its own. `twice` has only the two `finish` exits, which fold into
// one with no funnel: run out of steps (1 -> 1.5 -> 2.25 -> 3.375,
// finish(3.375, 0) = 1.6875) and past 100 on the second step (60 -> 90 ->
// 135, finish(135, 4) = 71.5). `shared` has exits of different shapes,
// `finish(x, i)` and `scale(x, y, k)`, whose arguments share the funnel's
// slots by type, `k` handed to its arm directly: out of steps (1 -> 1.5 ->
// 2.25 -> 3.375, finish(3.375, 0) = 1.6875), and past 50 on the third step
// (20 -> 30 -> 45 -> 67.5, scale(45, 67.5, 3) = 337.5) -- each arm reading
// its own values from the shared slots. `pick` hands the address of a local
// of the body, `t`, to a held function at one exit: out of steps (3.375,
// the `return x` exit), and past 50 on the third step (t = 67.5, halve(t) =
// 33.75), the address slot undefined on the other exit's edge.
func finish(x : f32, n : i32) -> f32 {
    return x * 0.5 + cast[[f32]](n);
}

func [[noinline]] put(out : mut f32, v : f32) -> void {
    out = v;
    return;
}

func [[noinline]] halve(v : mut f32) -> f32 {
    v = v * 0.5;
    return v;
}

func pick(i : i32, x : f32) -> f32 {
    if i <= 0 {
        return x;
    }
    y = x * 1.5;
    t : mut f32 = 0.0;
    put(t, y);
    if y > 50.0 {
        return halve(t);
    }
    return pick(i - 1, y);
}

func scale(a : f32, b : f32, k : i32) -> f32 {
    return (a + b) * cast[[f32]](k);
}

func shared(i : i32, x : f32, k : i32) -> f32 {
    if i <= 0 {
        return finish(x, i);
    }
    y = x * 1.5;
    if y > 50.0 {
        return scale(x, y, k);
    }
    return shared(i - 1, y, k);
}

func step(i : i32, x : f32, limit : f32) -> f32 {
    if i <= 0 {
        return finish(x, i);
    }
    y = x * 1.5;
    if y > limit {
        return 0.0;
    }
    if y > limit * 0.5 {
        return finish(y, i);
    }
    return step(i - 1, y, limit);
}

func twice(i : i32, x : f32) -> f32 {
    if i <= 0 {
        return finish(x, i);
    }
    y = x * 1.5;
    if y > 100.0 {
        return finish(y, i);
    }
    return twice(i - 1, y);
}

func main() -> i32 {
    print(step(3, 1.0, 100.0));
    print(step(5, 1.0, 4.0));
    print(step(5, 10.0, 4.0));
    print(twice(3, 1.0));
    print(twice(5, 60.0));
    print(shared(3, 1.0, 2));
    print(shared(4, 20.0, 3));
    print(pick(3, 1.0));
    print(pick(4, 20.0));
    return 0;
}

schedule {
    step.loopify();
    twice.loopify();
    shared.loopify();
    pick.loopify();
}
