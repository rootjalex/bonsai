//! flags: -p ssa -b llvm -e

// Inequality of two booleans, run: an exclusive or written as a comparison,
// `(a < 0) != (b < 0)`, which is how a sign test reads (pbrt's
// `(ray.d.z > 0) ^ (radius < 0)` in its lens tracing, apps/pbrt/camera.bonsai).
// The LLVM lowering had `==` on booleans and not `!=`, so the program failed
// in code generation with "Unimplemented BinOp lowering for boolean".

func differ(a : f32, b : f32) -> bool {
    return (a < 0.0) != (b < 0.0);
}

func same(a : f32, b : f32) -> bool {
    return (a < 0.0) == (b < 0.0);
}

func main() -> i32 {
    // Both negative, one negative each way, neither.
    print(differ(-1.0, -2.0), differ(-1.0, 2.0), differ(1.0, -2.0), differ(1.0, 2.0));
    print(same(-1.0, -2.0), same(-1.0, 2.0), same(1.0, -2.0), same(1.0, 2.0));
    // Picks the nearer root of a quadratic when the ray runs towards a
    // surface that bulges towards it: the sign of each decides together.
    t0 : f32 = 1.0;
    t1 : f32 = 3.0;
    print(select((1.0 > 0.0) != (-2.0 < 0.0), min(t0, t1), max(t0, t1)),
          select((1.0 > 0.0) != (2.0 < 0.0), min(t0, t1), max(t0, t1)));
    return 0;
}
