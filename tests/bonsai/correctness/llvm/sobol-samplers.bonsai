        2469888676u, 1618987279u, 2802343910u, 3784262585u, 616742508u,
        2012703341u, 895296467u, 4140332618u, 2966975828u, 2534385700u,
        1631169848u, 385074895u, 3761023306u, 924175717u, 1879309731u,
        3086922331u, 4064322550u};
    at = ((set % 5) * 16 + index) * 2;
    return vec2f{cast[[Float]](words[at]) * 0.00000000023283064365386963,
                 cast[[Float]](words[at + 1]) * 0.00000000023283064365386963};
}

// pbrt: PMJ02BNSampler::Get1D -- the sample's index permuted within the
// pixel, one stratum of sixteen, placed within it by the pixel's blue noise.
func pmj_1d(x : i32, y : i32, pixel : i32, sample : u32, dimension : i32) -> Float {
    h = hash4(x, y, dimension, 0);
    index = permutation_element(sample, 16u, cast[[u32]](h));
    return min((cast[[Float]](index) + blue_noise_at(dimension, pixel)) / 16.0,
               one_minus_epsilon());
}

// pbrt: PMJ02BNSampler::Get2D -- set `dimension / 2` at the sample's own
// index for the first five sets and a permuted index past them, rotated by
// the pixel's blue noise for the two dimensions and wrapped.
func pmj_2d(x : i32, y : i32, pixel : i32, sample : u32, dimension : i32) -> vec2f {
    instance = dimension / 2;
    index : mut i32 = cast[[i32]](sample);
    if instance >= 5 {
        h = hash4(x, y, dimension, 0);
        index = cast[[i32]](permutation_element(sample, 16u, cast[[u32]](h)));
    }
    u = pmj02bn_point(instance, index);
    ux : mut Float = u.x + blue_noise_at(dimension, pixel);
    uy : mut Float = u.y + blue_noise_at(dimension + 1, pixel);
    if ux >= 1.0 {
        ux = ux - 1.0;
    }
    if uy >= 1.0 {
        uy = uy - 1.0;
    }
    return vec2f{min(ux, one_minus_epsilon()), min(uy, one_minus_epsilon())};
}

// One pixel sample of the pmj02bn sampler at sixteen samples a pixel: the
// wavelength (Get1D at dimension two), the time (Get1D at three; the pixel
// sample between them is the driver's table and not drawn), the lens (Get2D
// at four), then four more pairs -- dimensions six to thirteen, the last
// pair past the fifth set.
func pmj_draw(x : i32, y : i32, pixel : i32, sample : u32) -> void {
    print(pmj_1d(x, y, pixel, sample, 2));
    print(pmj_1d(x, y, pixel, sample, 3));
    for d in 2:7 {
        u = pmj_2d(x, y, pixel, sample, 2 * d);
        print(u.x);
        print(u.y);
    }
}

func main() -> i32 {
    // SobolIntervalToIndex at m = 3: frames 0, 1 and 5 at four pixels, and
    // m = 0, where the frame is the index.
    px : array[i32, 4] = {0, 1, 5, 7};
    py : array[i32, 4] = {0, 0, 3, 7};
    frames : array[u64, 3] = {0u, 1u, 5u};
    for f in 0:3 {
        for i in 0:4 {
            print(sobol_interval_to_index(3, frames[f], cast[[u32]](px[i]),
                                          cast[[u32]](py[i])));
        }
    }
    five : u64 = 5u;
    print(sobol_interval_to_index(0, five, 3u, 4u));

    // Dimensions two to five of the sequence unscrambled, at indices that
    // reach past the thirty-second column.
    xs : array[u64, 7] = {0u, 1u, 2u, 7u, 1000u, 123456789u, 1099511627781u};
    for d in 2:6 {
        for i in 0:7 {
            print(sobol_sample(xs[i], d, randomize_none(), 0u));
        }
    }

    // The sobol sampler under the default `fastowen` at the four pixels, two
    // samples each, and under the other three randomizations at one.
    for i in 0:4 {
        for sample in 0:2 {
            sobol_draw(px[i], py[i], cast[[u32]](sample), randomize_fast_owen());
        }
    }
    sobol_draw(5, 3, 1u, randomize_none());
    sobol_draw(5, 3, 1u, randomize_permute_digits());
    sobol_draw(5, 3, 1u, randomize_owen());

    // The paddedsobol sampler, likewise, at pixels (0, 0), (1, 0) and
    // (37, 11).
    qx : array[i32, 3] = {0, 1, 37};
    qy : array[i32, 3] = {0, 0, 11};
    for i in 0:3 {
        for sample in 0:2 {
            padded_draw(qx[i], qy[i], cast[[u32]](sample), randomize_fast_owen());
        }
    }
    padded_draw(37, 11, 1u, randomize_none());
    padded_draw(37, 11, 1u, randomize_permute_digits());
    padded_draw(37, 11, 1u, randomize_owen());

    // The pmj02bn sampler at the same three pixels.
    for i in 0:3 {
        for sample in 0:2 {
            pmj_draw(qx[i], qy[i], i, cast[[u32]](sample));
        }
    }
    return 0;
}
