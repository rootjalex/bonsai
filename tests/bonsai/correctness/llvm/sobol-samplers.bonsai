//! flags: -b llvm -e

// pbrt's SobolSampler, PaddedSobolSampler and PMJ02BNSampler, reproduced
// exactly. Every number below is pbrt's own, printed by
// `apps/pbrt/scene_dump --print-sampler`.
//
// The three are the Sobol' family's other members and the one tabulated
// sampler. `sobol` is the sequence proper: a different Sobol' dimension for
// every draw and the pixel's entries found by inverting the first two
// dimensions (SobolIntervalToIndex, checked here on its own at a film side of
// eight, whose two van der Corput rows the test carries). `paddedsobol` takes
// every pair from dimensions zero and one at an index permuted per pixel and
// dimension by the stratified sampler's hash. `pmj02bn` draws nothing from a
// sequence: its pairs come from pbrt's tabulated blue-noise point sets,
// rotated per pixel by a tabulated blue-noise offset, and its one-dimensional
// draws are a permuted stratum jittered by the same offset. Its camera samples
// are the first set sorted into pixels by the driver (render_hook.cpp) and
// are checked by scenes/pmj02bn.pbrt rather than here.
//
// The functions here are a copy of apps/pbrt/sampler.bonsai rather than an
// import of it, for the reason halton.bonsai's and zsobol.bonsai's are: the
// app takes its tables as externs, and an extern becomes a parameter that a
// `main` with no arguments cannot supply. The tables below are the first six
// Sobol' dimensions (the renderer's draw order reaches dimension five), the
// two van der Corput rows for m = 3, and of the pmj02bn tables only the
// entries these draws touch -- the first sixteen points of each set and the
// blue noise at three pixels for dimensions two to thirteen -- which is why
// the pixels and sample indices below are what they are.
element Float = f32;
element vec2f = vector[Float, 2];

func one_minus_epsilon() -> Float = 0.99999994;

func clamp_f(x : Float, low : Float, high : Float) -> Float =
    min(max(x, low), high);

// pbrt: MixBits, from util/hash.h.
func mix_bits(v : u64) -> u64 {
    a : mut u64 = v ^ (v >> 31u);
    a = a * 0x7fb5d329728ea185;
    a = a ^ (a >> 27u);
    a = a * 0x81dadef4bc2dd44d;
    a = a ^ (a >> 33u);
    return a;
}

// pbrt: MurmurHash64A -- one block and no tail for eight bytes, two blocks
// for sixteen.
func murmur_m() -> u64 = 0xc6a4a7935bd1e995;

func murmur_block(h : u64, block : u64) -> u64 {
    k : mut u64 = block * murmur_m();
    k = k ^ (k >> 47u);
    k = k * murmur_m();
    return (h ^ k) * murmur_m();
}

func murmur_finish(h : u64) -> u64 {
    a : mut u64 = h ^ (h >> 47u);
    a = a * murmur_m();
    return a ^ (a >> 47u);
}

func packed(low : i32, high : i32) -> u64 =
    cast[[u64]](cast[[u32]](low)) | (cast[[u64]](cast[[u32]](high)) << 32u);

func hash2(a : i32, b : i32) -> u64 =
    murmur_finish(murmur_block(8u * murmur_m(), packed(a, b)));

func hash4(a : i32, b : i32, c : i32, d : i32) -> u64 {
    h = murmur_block(16u * murmur_m(), packed(a, b));
    return murmur_finish(murmur_block(h, packed(c, d)));
}

// pbrt: PermutationElement, from util/math.h.
func permutation_element(index : u32, l : u32, p : u32) -> u32 {
    w : mut u32 = l - 1u;
    w = w | (w >> 1u);
    w = w | (w >> 2u);
    w = w | (w >> 4u);
    w = w | (w >> 8u);
    w = w | (w >> 16u);
    i : mut u32 = index;
    do {
        i = i ^ p;
        i = i * 0xe170893du;
        i = i ^ (p >> 16u);
        i = i ^ ((i & w) >> 4u);
        i = i ^ (p >> 8u);
        i = i * 0x0929eb3fu;
        i = i ^ (p >> 23u);
        i = i ^ ((i & w) >> 1u);
        i = i * (1u | (p >> 27u));
        i = i * 0x6935fa69u;
        i = i ^ ((i & w) >> 11u);
        i = i * 0x74dcb303u;
        i = i ^ ((i & w) >> 2u);
        i = i * 0x9e501cc3u;
        i = i ^ ((i & w) >> 2u);
        i = i * 0xc860a3dfu;
        i = i & w;
        i = i ^ (i >> 5u);
    } while i >= l;
    return (i + p) % l;
}

// pbrt: RandomizeStrategy, in pbrt's order.
func randomize_none() -> i32 = 0;
func randomize_permute_digits() -> i32 = 1;
func randomize_fast_owen() -> i32 = 2;
func randomize_owen() -> i32 = 3;

