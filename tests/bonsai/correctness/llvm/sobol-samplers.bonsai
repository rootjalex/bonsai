// pbrt: VdCSobolMatrices[2] and VdCSobolMatricesInv[2], the rows for m = 3
// -- a film whose side is eight -- padded with zeros to fifty-two columns as
// the C++ array is.
func vdc_matrix(column : i32) -> u64 {
    table : array[u64, 52] = {
        5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u,
        5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u,
        5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u, 5u, 7u, 4u, 6u, 5u, 7u, 0u, 0u,
        0u, 0u, 0u, 0u};
    return table[column];
}

func vdc_matrix_inv(column : i32) -> u64 {
    table : array[u64, 52] = {
        0x28u, 0x30u, 0x10u, 0x3cu, 0x22u, 0x11u, 0u, 0u, 0u, 0u, 0u, 0u, 0u,
        0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u,
        0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u,
        0u, 0u, 0u, 0u, 0u};
    return table[column];
}

// pbrt: ReverseBits32.
func reverse_bits32(v : u32) -> u32 {
    n : mut u32 = (v << 16u) | (v >> 16u);
    n = ((n & 0x00ff00ffu) << 8u) | ((n & 0xff00ff00u) >> 8u);
    n = ((n & 0x0f0f0f0fu) << 4u) | ((n & 0xf0f0f0f0u) >> 4u);
    n = ((n & 0x33333333u) << 2u) | ((n & 0xccccccccu) >> 2u);
    n = ((n & 0x55555555u) << 1u) | ((n & 0xaaaaaaaau) >> 1u);
    return n;
}

// pbrt: BinaryPermuteScrambler, FastOwenScrambler and OwenScrambler.
func binary_permute_scramble(v : u32, permutation : u32) -> u32 =
    permutation ^ v;

func fast_owen_scramble(v : u32, seed : u32) -> u32 {
    a : mut u32 = reverse_bits32(v);
    a = a ^ (a * 0x3d20adeau);
    a = a + seed;
    a = a * ((seed >> 16u) | 1u);
    a = a ^ (a * 0x05526c56u);
    a = a ^ (a * 0x53a22864u);
    return reverse_bits32(a);
}

func owen_scramble(v : u32, seed : u32) -> u32 {
    a : mut u32 = v;
    if (seed & 1u) != 0u {
        a = a ^ 0x80000000u;
    }
    for b in 1:32 {
        mask = 0xffffffffu << cast[[u32]](32 - b);
        h = cast[[u32]](mix_bits(cast[[u64]]((a & mask) ^ seed)));
        if (h & (1u << cast[[u32]](b))) != 0u {
            a = a ^ (1u << cast[[u32]](31 - b));
        }
    }
    return a;
}

// pbrt: SobolSample.
func sobol_sample(a : u64, dimension : i32, randomize : i32,
                  hash : u32) -> Float {
    v : mut u32 = 0u;
    bits : mut u64 = a;
    column : mut i32 = dimension * 52;
    while bits != 0u {
        if (bits & 1u) != 0u {
            v = v ^ sobol_matrix(column);
        }
        bits = bits >> 1u;
        column = column + 1;
    }
    if randomize == randomize_permute_digits() {
        v = binary_permute_scramble(v, hash);
    }
    if randomize == randomize_fast_owen() {
        v = fast_owen_scramble(v, hash);
    }
    if randomize == randomize_owen() {
        v = owen_scramble(v, hash);
    }
    return min(cast[[Float]](v) * 0.00000000023283064365386963,
               one_minus_epsilon());
}

// pbrt: SobolIntervalToIndex, for m = 3 (and m = 0, the sequence itself).
func sobol_interval_to_index(m : i32, frame : u64, px : u32, py : u32) -> u64 {
    if m == 0 {
        return frame;
    }
    index : mut u64 = frame << cast[[u64]](2 * m);
    delta : mut u64 = 0u;
    f : mut u64 = frame;
    c : mut i32 = 0;
    while f != 0u {
        if (f & 1u) != 0u {
            delta = delta ^ vdc_matrix(c);
        }
        f = f >> 1u;
        c = c + 1;
    }
    b : mut u64 = ((cast[[u64]](px) << cast[[u64]](m)) | cast[[u64]](py)) ^ delta;
    c = 0;
    while b != 0u {
        if (b & 1u) != 0u {
            index = index ^ vdc_matrix_inv(c);
        }
        b = b >> 1u;
        c = c + 1;
    }
    return index;
}

// pbrt: SobolSampler::SampleDimension.
func sobol_dimension(a : u64, dim : i32, randomize : i32, seed : i32) -> Float =
    sobol_sample(a, dim, randomize, cast[[u32]](hash2(dim, seed)));

// One pixel sample of the sobol sampler on an 8 by 8 film at sixteen samples
// a pixel, drawn from as the renderer draws: the wavelength (Get1D, dimension
// two), the pixel (GetPixel2D: dimensions zero and one unscrambled, scaled by
// eight with the pixel taken off), the time (Get1D) and the lens (Get2D).
// The seed is zero.
func sobol_draw(x : i32, y : i32, sample : u32, randomize : i32) -> void {
    a = sobol_interval_to_index(3, cast[[u64]](sample), cast[[u32]](x),
                                cast[[u32]](y));
    print(sobol_dimension(a, 2, randomize, 0));
    ux = sobol_sample(a, 0, randomize_none(), 0u) * 8.0 - cast[[Float]](x);
    uy = sobol_sample(a, 1, randomize_none(), 0u) * 8.0 - cast[[Float]](y);
    print(clamp_f(ux, 0.0, one_minus_epsilon()));
    print(clamp_f(uy, 0.0, one_minus_epsilon()));
    print(sobol_dimension(a, 3, randomize, 0));
    print(sobol_dimension(a, 4, randomize, 0));
    print(sobol_dimension(a, 5, randomize, 0));
}

// One pixel sample of the paddedsobol sampler at sixteen samples a pixel, in
// the same order: Get1D at dimension zero, GetPixel2D (which is Get2D) at
// one, Get1D at three, Get2D at four. Every draw hashes the pixel, the
// dimension and the seed, permutes the sample index by the hash's low word
// and scrambles under its high word (and, for a pair, dimension zero under
// the low word too).
func padded_draw(x : i32, y : i32, sample : u32, randomize : i32) -> void {
    spp : u32 = 16u;
    dimension : mut i32 = 0;

    h0 = hash4(x, y, dimension, 0);
    i0 = cast[[u64]](permutation_element(sample, spp, cast[[u32]](h0)));
    dimension = dimension + 1;
    print(sobol_sample(i0, 0, randomize, cast[[u32]](h0 >> 32u)));

    h1 = hash4(x, y, dimension, 0);
    i1 = cast[[u64]](permutation_element(sample, spp, cast[[u32]](h1)));
    dimension = dimension + 2;
    print(sobol_sample(i1, 0, randomize, cast[[u32]](h1)));
    print(sobol_sample(i1, 1, randomize, cast[[u32]](h1 >> 32u)));

    h3 = hash4(x, y, dimension, 0);
    i3 = cast[[u64]](permutation_element(sample, spp, cast[[u32]](h3)));
    dimension = dimension + 1;
    print(sobol_sample(i3, 0, randomize, cast[[u32]](h3 >> 32u)));

    h4 = hash4(x, y, dimension, 0);
    i4 = cast[[u64]](permutation_element(sample, spp, cast[[u32]](h4)));
    dimension = dimension + 2;
    print(sobol_sample(i4, 0, randomize, cast[[u32]](h4)));
    print(sobol_sample(i4, 1, randomize, cast[[u32]](h4 >> 32u)));
}

// pbrt: BlueNoiseTextures[table][x][y] for the three pixels the draws below
// visit -- (0, 0), (1, 0) and (37, 11), in that order -- at dimensions two
// to thirteen. The sampler divides by 65535.
func blue_noise_at(table : i32, pixel : i32) -> Float {
    values : array[u32, 36] = {
        1836u, 10020u, 16556u, 50672u, 31656u, 62408u,
        47820u, 19560u, 29676u, 32784u, 42820u, 8332u,
        46000u, 15652u, 48048u, 65428u, 24748u, 24760u,
        32956u, 13232u, 39360u, 28972u, 30100u, 51088u,
        36464u, 35420u, 26332u, 35884u, 40348u, 15024u,
        36108u, 15604u, 14932u, 34720u, 21992u, 27660u};
    return cast[[Float]](values[pixel * 12 + table - 2]) / 65535.0;
}

