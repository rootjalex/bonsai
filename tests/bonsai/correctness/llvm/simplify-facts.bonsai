//! flags: -p ssa -b llvm -e

// What a branch decides, run: opt/simplify-facts.bonsai shows the shapes,
// this checks that folding a test on a known condition changes no answer.
//
// `nested` takes the arm its outer test took. `returned` past its return
// runs with `k > 0` false. `mutable` must not learn `c`: the arm assigns it,
// and the inner test's answer is the assigned value. `strict` must still
// run `bump` in the arm the select does not take -- a select evaluates both
// arms -- and the count it leaves behind says whether it did.

func tri_test(x : f32) -> f32 {
    return x * 2.0 + 1.0;
}

element Counter {
    n : i32;
}

func bump(c : mut Counter) -> f32 {
    c.n = c.n + 1;
    return cast[[f32]](c.n);
}

func nested(is_tri : bool, x : f32) -> f32 {
    d : mut f32 = 0.0;
    if is_tri {
        if is_tri {
            d = x;
        } else {
            d = 0.0 - x;
        }
        if !is_tri {
            d = d * 2.0;
        }
    } else {
        if is_tri {
            d = 1.0;
        }
    }
    return d;
}

func returned(k : i32, x : f32) -> f32 {
    if k > 0 {
        return x;
    }
    y : mut f32 = x;
    if k > 0 {
        y = y + 1.0;
    }
    z = select(k > 0, 1.0, 2.0);
    return y * z;
}

func mutable(flag : bool, x : f32) -> f32 {
    c : mut bool = flag;
    y : mut f32 = 0.0;
    if c {
        c = false;
        if c {
            y = x;
        } else {
            y = 1.0;
        }
    }
    return y;
}

func strict(k : i32, x : f32) -> f32 {
    c : mut Counter = {0};
    y : mut f32 = 0.0;
    if k > 0 {
        y = select(k > 0, x, bump(c));
        y = y + select(k > 0, 5.0, tri_test(x));
    }
    return y + cast[[f32]](c.n) * 100.0;
}

func main() -> i32 {
    // 3 and 0: the then arm keeps x, the else arm never sets d.
    print(nested(true, 3.0), nested(false, 3.0));
    // 3 from the return; 3 * 2 with k > 0 known false.
    print(returned(1, 3.0), returned(0, 3.0));
    // 1: c was assigned false before the inner test. 0: never entered.
    print(mutable(true, 3.0), mutable(false, 3.0));
    // 3 + 5, and bump ran once: 108. Then 0 with nothing run.
    print(strict(1, 3.0), strict(0, 3.0));
    return 0;
}
