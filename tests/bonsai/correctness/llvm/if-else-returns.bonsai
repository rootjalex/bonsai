//! flags: -b llvm -e

// An if whose else returns and whose then does not, with code after it.
//
// The LLVM backend decides whether an if/else chain needs a block to carry on
// into, and used to ask for one only when *both* some arm fell through and
// the else did too. Here the else returns and the then does not, so no block
// was made -- and then the then-arm branched to it anyway, which is a branch
// to nothing and a segfault in the compiler. It needs one as soon as any path
// falls out of the chain.
//
// Written without a loop or a schedule on purpose: nothing exotic is required
// to produce this shape, it was simply never compiled before.
func clamp_or_fail(a : i32) -> i32 {
    x : mut i32 = 0;
    if (a > 0) {
        x = a;
    } else {
        return 0 - 1;
    }
    return x + 10;
}

// The same with the arms the other way round, so the block is needed for the
// else instead of the then.
func other_way(a : i32) -> i32 {
    y : mut i32 = 0;
    if (a > 0) {
        return 100;
    } else {
        y = 0 - a;
    }
    return y + 10;
}

// And a chain of three, where the middle one returns.
func chained(a : i32) -> i32 {
    z : mut i32 = 0;
    if (a > 10) {
        z = 1;
    } else if (a > 5) {
        return 55;
    } else {
        z = 3;
    }
    return z + 1000;
}

func main() -> i32 {
    print(clamp_or_fail(7), clamp_or_fail(0 - 7));
    print(other_way(7), other_way(0 - 7));
    print(chained(20), chained(7), chained(1));
    return 0;
}
