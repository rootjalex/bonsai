//! flags: -p ssa -b llvm -e

// Two arguments recomputed at the drain from a third
// (tests/bonsai/ssa/defer-remat.bonsai reads the plan) give the sums they
// would have given stored: with S the sum of 1..i, acc + neg + twice is
// S - S + 2S = 2S, and 0 for i = 0, which never pushes.

func tally(n : i32, acc : i32, neg : i32, twice : i32) -> i32 {
    if (n <= 0) {
        return acc + neg + twice;
    }
    return tally(n - 1, acc + n, 0 - (acc + n), 2 * (acc + n));
}

func run(out : mut array[i32, 8]) -> void {
    parfor i in 0:8 {
        out[i] = tally(i, 0, 0, 0);
    }
    return;
}

func main() -> i32 {
    out : mut array[i32, 8] = {-1, -1, -1, -1, -1, -1, -1, -1};
    run(out);
    // {0, 2, 6, 12, 20, 30, 42, 56}
    print(out);
    return 0;
}

schedule {
    sums = run.queue(root);
    tally.defer(tally, sums);
}
