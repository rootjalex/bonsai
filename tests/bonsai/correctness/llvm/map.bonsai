// TODO(cgyurgyik): causing mismatch type errors, probably from extraction.
func map2d(xs: array[array[i32, 2], 2]) -> array[array[i32, 2], 2] {
    return map(|i: array[i32, 2]| {  map(|j: i32| { j + 1 }, i) }, xs);
}

