func map2d(xs: array[array[i32, 2], 2]) -> array[array[i32, 2], 2] {
    return map(|i: array[i32, 2]| {  map(|j: i32| { j }, i) }, xs);
}

func main() -> i32 {
    v0: array[i32, 2] = {1,2};
    v1: array[i32, 2] = {3,4};
    ys: array[array[i32, 2], 2] = {v0, v1};
    print(ys);
    // yss = map2d(ys);
    // print(yss);

    return 0;
}


