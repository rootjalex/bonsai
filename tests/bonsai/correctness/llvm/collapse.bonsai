//! flags: -b llvm -e

func f(x: i32) -> i32 {
    return x;
}

func process(a : array[array[i32, 3], 2]) -> array[array[i32, 3], 2] {
    return map(|l| map(|x : i32| { f(x) }, l), a);
}

func main() -> i32 {
    x: array[i32, 3] = {0, 1, 2};
    y: array[i32, 3] = {3, 4, 5};
    
    input: array[array[i32, 3], 2] = {x, y};
    print(input[0][0]);
    print(input[0][1]);
    print(input[0][2]);
    print(input[1][0]);
    print(input[1][1]);
    print(input[1][2]);
    
    print(input);
    // TODO(cgyurgyik): This is broken even without collapse.
    // output: array[array[i32, 3], 2] = process(input);
    // print(output);
    return 0;
}

// schedule { process.collapse(i0, i1); }
