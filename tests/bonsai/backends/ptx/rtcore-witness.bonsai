//! flags: -p ssa -b ptx

// lower/rtcore-witness.bonsai's program compiled to its OptiX modules
// (CodeGen_OptiX): the queries carry the hit's witness, so the hit programs
// come in two flavors apiece. What to read for, in the PTX:
//
// - `__anyhit__trace` (the hardware triangles') calls
//   `_optix_get_triangle_barycentrics` once and `_optix_get_ray_tmax` once,
//   and contains NO triangle intersection: `accepts` reads the carried
//   barycentric. `__anyhit__trace$boxes` reads the tmax alone and holds
//   zeros where the barycentrics would be.
//
// - BOTH contexts are PROMOTED to the payload registers: no program takes
//   a context pointer (no `_optix_get_payload` pair feeding an address),
//   `__miss__trace_any` is two movs and one `_optix_set_payload`, and the
//   raygen's `_optix_trace_typed_32` calls carry the contexts' own words.
//   A program that needs the query's ray reads it from the hardware
//   (`_optix_get_world_ray_origin_*`, `_optix_get_world_ray_direction_*`)
//   rather than from memory.
//
// - `__closesthit__trace` and its `$boxes` flavor load NOTHING and store
//   no element: they write the hit's index (`_optix_get_sbt_data_ptr_64`'s
//   base plus `_optix_read_primitive_idx`), its `_optix_get_ray_tmax` and
//   its barycentrics (zeros in the `$boxes` flavor) as payload words
//   (`_optix_set_payload`), no `ld.global` in either body; the raygen
//   loads the element at that index after the trace, so (element, t, b)
//   come back without a second intersection anywhere.
//
// - The `intersection` implementation itself (stdlib/distance's
//   intersectsp_ray_tri path) appears in NO device program: the map
//   annotation is instruction-selected to the hardware's reads in every
//   hit program, and the raygen only rebuilds the record from the words.
import stdlib/aabb;
import stdlib/distance;
import stdlib/hit;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element Tri {
    tri : Triangle;
    alpha : f32;
} with extent = aabb_of_triangle(tri);

func accepts(r : Ray, t : Tri, h : Hit) -> bool {
    if t.alpha < 0.0 {
        return true;
    }
    return h.b.x < t.alpha;
}

extern tris : set[Tri];

func trace(r : Ray) =
    argmin(|t : Tri, h : Hit| distmin(r, t.tri),
           filter(|t : Tri, h : Hit| intersects(r, t.tri) && accepts(r, t, h),
                  map(|t : Tri| (t, intersection(r, t.tri)), tris)));

func trace_any(r : Ray) =
    any(|t : Tri, h : Hit| intersects(r, t.tri) && accepts(r, t, h),
        map(|t : Tri| (t, intersection(r, t.tri)), tris));

func [[export]] trace_all(n : i32, rays : array[Ray, n],
                          hit_t : mut array[f32],
                          hit_b1 : mut array[f32],
                          hit_any : mut array[i32]) -> void {
    parfor i in 0:n {
        r = rays[i];
        found = trace(r);
        if found {
            hit = *found;
            hit_t[i] = hit[1].t;
            hit_b1[i] = hit[1].b.x;
        } else {
            hit_t[i] = -1.0;
            hit_b1[i] = -1.0;
        }
        hit_any[i] = select(trace_any(r), 1, 0);
    }
    return;
}

schedule {
    tris : OptixTree;

    layout tris {
        n : u32;
        elems : array[Tri, n];
    };

    trace.bind(RTCore);
    trace_any.bind(RTCore);
    trace_all.bind(i, OptixThread);
}
