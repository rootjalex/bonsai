//! flags: -p ssa -b ptx

// The hit programs over a mesh whose triangles are stored nowhere: the
// layout computes a triangle from the pair (mesh primitive, index) --
// `group mesh_tris (h : Mesh, k : u32) { mesh = h.mesh; tri = k; }` -- so
// the closest-hit program reads the hit-group record, the mesh primitive it
// names and the primitive index, and goes straight to the mesh's index and
// position arrays, as pbrt's closest-hit program reads `rec.mesh` and
// `optixGetPrimitiveIndex()` (gpu/optix/optix.cu). What to read for in the
// golden: no load of a triangle row between the record and the mesh's
// arrays, where `tris : array[TriRef, n]` with `Mesh.tris : OptixTree from
// tris` reads `tris[base + prim]` first. The program is
// correctness/gpu/rtcore-holder-reference's.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

element TriRef {
    mesh : u32;
    tri : u32;
}

extern mesh_first_index : array[u32];
extern mesh_first_vertex : array[u32];
extern indices : array[u32];
extern positions : array[vec3f];

func corner(t : TriRef, c : u32) -> vec3f =
    positions[mesh_first_vertex[t.mesh] +
              indices[mesh_first_index[t.mesh] + 3u * t.tri + c]];

func triangle_of(t : TriRef) -> Triangle {
    out : Triangle = {corner(t, 0u), corner(t, 1u), corner(t, 2u)};
    return out;
}

element Prim =
    | Solo(tri : Triangle)
    | Mesh(mesh : u32, tris : set[TriRef]);

func geometry(p : Prim) -> set[Triangle] =
    match p {
        Solo(tri) => set[Triangle]{tri},
        Mesh(mesh, tris) => map(|t : TriRef| triangle_of(t), tris)
    };

element Prim with extent = |p| geometry(p).AABB;

func mesh_of(p : Prim) -> i32 {
    match p {
        Solo(tri) => return -1;
        Mesh(mesh, tris) => return cast[[i32]](mesh);
    }
}

extern near : array[f32, 1];
extern prims : set[Prim];

func trace(r : Ray) =
    argmin(|p : Prim, tri : Triangle| distmin(r, tri),
           filter(|p : Prim, tri : Triangle|
                      intersects(r, tri) && distmin(r, tri) > near[0],
                  flatten(|p : Prim| geometry(p), prims)));

func [[export]] render(n : i32, rays : array[Ray, n],
                       hit_x : mut array[f32], hit_mesh : mut array[i32]) -> void {
    parfor i in 0:n {
        r = rays[i];
        found = trace(r);
        if found {
            hit = *found;
            hit_x[i] = hit[1].p0.x;
            hit_mesh[i] = mesh_of(hit[0]);
        } else {
            hit_x[i] = -1.0;
            hit_mesh[i] = -2;
        }
    }
    return;
}

schedule {
    layout Prim = tagged_index;
    prims : OptixTree;
    Mesh.tris : OptixTree from mesh_tris;
    layout prims {
        group mesh_tris (h : Mesh, k : u32) { mesh = h.mesh; tri = k; };
        pCount : u32;
        elems : array[Prim, pCount];
    };
    trace.bind(RTCore);
    render.bind(i, OptixThread);
}
