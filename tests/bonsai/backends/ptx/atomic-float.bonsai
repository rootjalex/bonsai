//! flags: -p ssa -b ptx

// Float accumulates from the threads of a block into one place -- a pixel's
// film, summed over its samples -- as the hardware's atomic add, not a
// compare-and-swap loop.
//
// PTX has `atom.add.f32`, but on global memory it flushes denormals whatever
// the surrounding code does, so LLVM uses it only in a function whose own
// denormal mode is to flush them (NVPTXISelLowering.cpp,
// shouldExpandAtomicRMWInIR); anywhere else `atomicrmw fadd` becomes a load
// and a CAS loop, retried until no other thread got in between. Every device
// function here flushes denormals -- `--use_fast_math`, which pbrt's GPU
// build uses, does the same -- and the accumulates below must come out as
// `atom.relaxed.gpu.global.add.f32`, one per component for the vector.
import stdlib/numerics;

func run(total : mut array[Float, 4], rgb : mut array[vec3f, 4]) -> void {
    parfor p in 0:4 {
        total[p] = 0.0;
        rgb[p] = vec3f{0.0, 0.0, 0.0};
        parfor s in 0:8 {
            f = cast[[Float]](s) * 0.5;
            atomic total[p] += f;
            atomic rgb[p] += vec3f{f, 2.0 * f, cast[[Float]](p)};
        }
    }
    return;
}

func main() -> i32 {
    total : mut array[Float, 4] = {0.0, 0.0, 0.0, 0.0};
    zero = vec3f{0.0, 0.0, 0.0};
    rgb : mut array[vec3f, 4] = {zero, zero, zero, zero};
    run(total, rgb);
    // 0 + 0.5 + ... + 3.5 = 14, in every pixel.
    print(total);
    // 14, 28, and the pixel's own index eight times over.
    print(rgb);
    return 0;
}

schedule {
    run.bind(p, GPUBlock);
    run.bind(s, GPUThread);
}
