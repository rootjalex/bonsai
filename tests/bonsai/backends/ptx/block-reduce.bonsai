//! flags: -p ssa -b ptx

// Accumulates every thread of a block makes to the block's own word
// (`atomic out[b] += ...` under bind(b, GPUBlock) and bind(t, GPUThread)),
// reduced once per block instead of an atomic per thread
// (SSA/BlockAccumulates.h): each thread's slot, a warp shuffle tree
// (`shfl.sync.down`), one shared-memory slot per warp, `bar.sync`, the
// warps' sums added, and the leader's one write -- a plain store for
// `out[b]` and `rgb[b]`, which are the block's own, and one `atom.add` per
// block for `total[0]`, which every block writes. The thread count is a
// parameter, so the tree handles a block that ends in a partial warp.
import stdlib/numerics;

func run(out : mut array[Float, 4], rgb : mut array[vec3f, 4],
         total : mut array[Float, 1], n : i32) -> void {
    parfor b in 0:4 {
        parfor t in 0:n {
            f = cast[[Float]](t) * 0.5;
            atomic out[b] += f;
            atomic rgb[b] += vec3f{f, 1.0, cast[[Float]](b)};
            atomic total[0] += 1.0;
            if t % 2 == 0 {
                atomic out[b] += 100.0;
            }
        }
    }
    return;
}

schedule {
    run.bind(b, GPUBlock);
    run.bind(t, GPUThread);
}
