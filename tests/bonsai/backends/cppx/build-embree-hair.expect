void rec_count_triangles(const BVH* __restrict__ node, Triangles* __restrict__ ST, size_t* __restrict__ size_AABBs, size_t* __restrict__ size_OBBs) {
  return std::visit(overloaded{
    [&](const AABBNode& node) {
      for (int32_t __r = 0; __r < 4; ++__r) {
        rec_count_triangles(node.aabb_children[__r], ST, size_AABBs, size_OBBs);
      }
      (*size_AABBs) += 1;
    },
    [&](const OBBNode& node) {
      for (int32_t __r = 0; __r < 4; ++__r) {
        rec_count_triangles(node.obb_children[__r], ST, size_AABBs, size_OBBs);
