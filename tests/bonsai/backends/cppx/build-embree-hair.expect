      const uint64_t aabb_children_index0 = rec_build_triangles(node.aabb_children[0], ST, AABBs_index, OBBs_index, primitives_index);
      (*ST).AABBs[this_index].aabb_children[0] = aabb_children_index0;
      const uint64_t aabb_children_index1 = rec_build_triangles(node.aabb_children[1], ST, AABBs_index, OBBs_index, primitives_index);
      (*ST).AABBs[this_index].aabb_children[1] = aabb_children_index1;
      const uint64_t aabb_children_index2 = rec_build_triangles(node.aabb_children[2], ST, AABBs_index, OBBs_index, primitives_index);
      (*ST).AABBs[this_index].aabb_children[2] = aabb_children_index2;
      const uint64_t aabb_children_index3 = rec_build_triangles(node.aabb_children[3], ST, AABBs_index, OBBs_index, primitives_index);
      (*ST).AABBs[this_index].aabb_children[3] = aabb_children_index3;
      return ((this_index << 4) | 2);
    },
    [&](const OBBNode& node) {
      const size_t this_index = (*OBBs_index);
      (*OBBs_index) += 1;
      (*ST).OBBs[this_index].mlo = min((*ST).AABBs[this_index].aabb_low[0], min((*ST).AABBs[this_index].aabb_low[1], min((*ST).AABBs[this_index].aabb_low[2], (*ST).AABBs[this_index].aabb_low[3])));
      (*ST).OBBs[this_index].mex = calculate_merged_extent((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      (*ST).OBBs[this_index].qlo = quantize_bounds_low((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      (*ST).OBBs[this_index].qhi = quantize_bounds_high((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      (*ST).OBBs[this_index].qorientation = quantize_orientation(node.orientation);
      std::array<uint64_t, 4> obb_children_index;
      for (int32_t __r = 0; __r < 4; ++__r) {
        obb_children_index[__r] = rec_build_triangles(node.obb_children[__r], ST, AABBs_index, OBBs_index, primitives_index);
        (*ST).OBBs[this_index].obb_children[__r] = obb_children_index[__r];
      }
      return ((this_index << 4) | 3);
    },
    [&](const Leaf& node) {
      for (uint8_t __p = 0; __p < node.nprims; ++__p) {
