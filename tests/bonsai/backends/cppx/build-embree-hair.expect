  size_t size_AABBs = 0;
  size_t size_OBBs = 0;
  rec_count_triangles(CT, (&ST), (&size_AABBs), (&size_OBBs));
  Triangle* primitives = reinterpret_cast<Triangle*>(malloc(sizeof(Triangle) * ST.primitive_count));
  ST.primitives = primitives;
  AABBs* AABBs = reinterpret_cast<AABBs*>(malloc(sizeof(AABBs) * size_AABBs));
  ST.AABBs = AABBs;
  OBBs* OBBs = reinterpret_cast<OBBs*>(malloc(sizeof(OBBs) * size_OBBs));
  ST.OBBs = OBBs;
