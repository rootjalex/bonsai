        const float v0 = (d1 / (d1 - d3));
        return std::tuple<Point, Point>{Point{.vec=(a + (vec3_float{v0} * ab))}, Point{.vec=vec3_float{(1.0f - v0), v0, 0.0f}}};
      }
    }
