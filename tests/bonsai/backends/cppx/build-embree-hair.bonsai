//! flags: -b cppx

import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles));

element OBB { 
  // TODO(cgyurgyik): we shouldn't need {obb,aabb}_low.
  // This is an artifact of our path-finding algorithm that assumes paths 
  // are unique only to identifiers. In reality, it should take into 
  // account the variant as well.
  obb_low: f32x3; 
  obb_high: f32x3; 

  // m00 m01 m02 tx
  // m10 m11 m12 ty
  // m20 m21 m22 tz
  // 
  // m00, ..., m22 describe the rotation / scale.
  // tx, ty, tz    describe the translation.
  orientation: f32x4x3; 
}

func intersectsp_ray_obb(r: Ray, b: OBB) -> option[FInterval] {
    // 1. Transform the ray into the OBB's local space.
    ox = b.orientation[0][0] * r.o.x + b.orientation[0][1] * r.o.y + b.orientation[0][2] * r.o.z + b.orientation[0][3];
    oy = b.orientation[1][0] * r.o.x + b.orientation[1][1] * r.o.y + b.orientation[1][2] * r.o.z + b.orientation[1][3];
    oz = b.orientation[2][0] * r.o.x + b.orientation[2][1] * r.o.y + b.orientation[2][2] * r.o.z + b.orientation[2][3];

    dx = b.orientation[0][0] * r.d.x + b.orientation[0][1] * r.d.y + b.orientation[0][2] * r.d.z;
    dy = b.orientation[1][0] * r.d.x + b.orientation[1][1] * r.d.y + b.orientation[1][2] * r.d.z;
    dz = b.orientation[2][0] * r.d.x + b.orientation[2][1] * r.d.y + b.orientation[2][2] * r.d.z;

    // 2. Simplified slab test against unit cube.
    // Since the inverse direction is dependent on the orientation matrix, we can't just 
    // cache this in the ray data structure.
    inv_dx: f32 = 1.0 / dx;
    inv_dy: f32 = 1.0 / dy;
    inv_dz: f32 = 1.0 / dz;

    // X slab
    t0x = (0.0 - ox) * inv_dx;
    t1x = (1.0 - ox) * inv_dx;
    tmin_x = min(t0x, t1x);
    tmax_x = max(t0x, t1x);

    // Y slab
    t0y = (0.0 - oy) * inv_dy;
    t1y = (1.0 - oy) * inv_dy;
    tmin_y = min(t0y, t1y);
    tmax_y = max(t0y, t1y);

    // Z slab
    t0z = (0.0 - oz) * inv_dz;
    t1z = (1.0 - oz) * inv_dz;
    tmin_z = min(t0z, t1z);
    tmax_z = max(t0z, t1z);

    // Find intersection of all slabs.
    tmin: f32 = max(max(tmin_x, tmin_y), tmin_z);
    tmax: f32 = min(min(tmax_x, tmax_y), tmax_z);

    if tmin > tmax { return {}; } 
    if tmax < 0.0 { return {}; }
    return FInterval{max(tmin, 0.0), tmax};
}

func intersects_Ray_OBB(r: Ray, b: OBB) -> bool {
    interval = intersectsp_ray_obb(r, b);
    if interval {
        extract = *interval;
        return extract.low < r.tmax & extract.high > 0.0;
    }
    return false;
}

func distmin_Ray_OBB(r : Ray, b : OBB) -> f32 {
    interval: option[FInterval] = intersectsp_ray_obb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return -inf;
}

func to_i8(f: f32) -> i8 {
  f1 : f32 = roundf(f);
  f2: f32 = max(-128.0, min(f1, 127.0));
  return cast[[i8]](f2);
}

func quantize_orientation(x: f32x4x3) -> i8x4x3 {
  return i8x4x3 {
    i8x4 {
      to_i8(x[0][0] * 127.0),
      to_i8(x[0][1] * 127.0),
      to_i8(x[0][2] * 127.0),
      to_i8(x[0][3] * 127.0)
    },
    i8x4 {
      to_i8(x[1][0] * 127.0),
      to_i8(x[1][1] * 127.0),
      to_i8(x[1][2] * 127.0),
      to_i8(x[1][3] * 127.0)
    },
    i8x4 {
      to_i8(x[2][0] * 127.0),
      to_i8(x[2][1] * 127.0),
      to_i8(x[2][2] * 127.0),
      to_i8(x[2][3] * 127.0)
    }
  };
}

func calculate_merged_low(low: f32x3x4) -> f32x3 {
  return min(low[0], min(low[1], min(low[2], low[3])));
}

func calculate_merged_extent(low: f32x3x4, high: f32x3x4) -> f32x3 {
  mlo: f32x3 = min(low[0], min(low[1], min(low[2], low[3])));
  mhi: f32x3 = max(high[0], max(high[1], max(high[2], high[3])));
  return mhi - mlo;
}

func to_u8_floor(f: f32x3) -> u8x3 {
    f1: f32 = floorf(f);
    f2: f32 = max(0.0, min(f1, 255.0));
    return cast[[u8x3]](f2);
}

func to_u8_ceil(f: f32x3) -> u8x3 {
    f1: f32 = ceilf(f);
    f2: f32 = max(0.0, min(f1, 255.0));
    return cast[[u8x3]](f2);
}

func quantize_bounds_low(low: f32x3x4, high: f32x3x4) -> u8x3x4 {
  mlo: f32x3 = calculate_merged_low(low);
  mex: f32x3 = calculate_merged_extent(low, high);
  return u8x3x4 {
    to_u8_floor((low[0] - mlo) / mex * 255.0),
    to_u8_floor((low[1] - mlo) / mex * 255.0),
    to_u8_floor((low[2] - mlo) / mex * 255.0),
    to_u8_floor((low[3] - mlo) / mex * 255.0)
  };
}

func quantize_bounds_high(low: f32x3x4, high: f32x3x4) -> u8x3x4 {
  mlo: f32x3 = calculate_merged_low(low);
  mex: f32x3 = calculate_merged_extent(low, high);
  return u8x3x4 {
    to_u8_ceil((high[0] - mlo) / mex * 255.0),
    to_u8_ceil((high[1] - mlo) / mex * 255.0),
    to_u8_ceil((high[2] - mlo) / mex * 255.0),
    to_u8_ceil((high[3] - mlo) / mex * 255.0)
  };
}

func dequantize_orientation(x: i8x4x3) -> f32x4x3 {
    return f32x4x3 {
        f32x4 {
            cast[[f32]](x[0][0]) / 127.0,
            cast[[f32]](x[0][1]) / 127.0,
            cast[[f32]](x[0][2]) / 127.0,
            cast[[f32]](x[0][3]) / 127.0
        },
        f32x4 {
          cast[[f32]](x[1][0]) / 127.0,
            cast[[f32]](x[1][1]) / 127.0,
            cast[[f32]](x[1][2]) / 127.0,
            cast[[f32]](x[1][3]) / 127.0
        },
        f32x4 {
            cast[[f32]](x[2][0]) / 127.0,
            cast[[f32]](x[2][1]) / 127.0,
            cast[[f32]](x[2][2]) / 127.0,
            cast[[f32]](x[2][3]) / 127.0
        }
    };
}

func dequantize_bounds(mlo: f32x3, mex: f32x3, q: u8x3x4) -> f32x3x4 {
  return f32x3x4 { 
    mlo + (cast[[f32]](q[0]) / 255.0) * mex,
    mlo + (cast[[f32]](q[1]) / 255.0) * mex,
    mlo + (cast[[f32]](q[2]) / 255.0) * mex,
    mlo + (cast[[f32]](q[3]) / 255.0) * mex
  };
}

schedule {
    tree[[Triangle]] BVH 
      = AABBNode(aabb_children: array[BVH, 4], aabb_low: f32x3x4, aabb_high: f32x3x4) with AABB(aabb_low, aabb_high) on aabb_children
      | OBBNode(obb_children: array[BVH, 4], orientation: f32x4x3, obb_low: f32x3x4, obb_high: f32x3x4) with OBB(obb_low, obb_high, orientation) on obb_children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(index: u64) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        aabb_count: u64;
        indirect group Aabbs[size=aabb_count] {
            aabb_low: f32x3x4;
            aabb_high: f32x3x4;
            aabb_children: u64x4;
        };

        // quantized, per section 3.5
        obb_count: u64;
        indirect group Obbs[size=obb_count] {
            mlo: f32x3;           // low of the merged AABB.
            mex: f32x3;           // extent of the merged AABB.
            qlo: u8x3x4;          // quantized low offset of each child.
            qhi: u8x3x4;          // quantized high offset of each child.
            qorientation: i8x4x3; // common orientation for all 4 OBB bounds.
            obb_children: u64x4;

            obb_low = dequantize_bounds(mlo, mex, qlo);
            obb_high = dequantize_bounds(mlo, mex, qhi);
            orientation = dequantize_orientation(qorientation);
        };

        group _ by index {
            split index[0:2] {
                2 -> AABBNode from Aabbs[index[4:63]];
                3 -> OBBNode from Obbs[index[4:63]];
                _ -> Leaf {
                    nprims = cast[[u8]](index[1:4] + 1);
                    data = primitives[index[4:63] : index[4:63] + nprims];
                };
            };
        };
    };

    build triangles {
      build AABBNode(aabb_children: array[BVH, 4], aabb_low: f32x3x4, aabb_high: f32x3x4) {
        build aabb_low;
        build aabb_high;
        recurse aabb_children[0];
        recurse aabb_children[1];
        recurse aabb_children[2];
        recurse aabb_children[3];
        return (this << 4) | 2;
      };

      build OBBNode(obb_children: array[BVH, 4], orientation: f32x4x3, aabb_low: f32x3x4, aabb_high: f32x3x4) {
        build mlo = calculate_merged_low(aabb_low);
        build mex = calculate_merged_extent(aabb_low, aabb_high);
        build qlo = quantize_bounds_low(aabb_low, aabb_high);
        build qhi = quantize_bounds_high(aabb_low, aabb_high);
        build qorientation = quantize_orientation(orientation);
        recurse obb_children; // syntactic sugar for the above!
        return (this << 4) | 3;
      };

      build Leaf(nprims: u8, data: array[Triangle, nprims]) {
        let poffset: u64 = append(data, nprims);
        return (poffset << 4) | (nprims << 2);
      };
    };
}
