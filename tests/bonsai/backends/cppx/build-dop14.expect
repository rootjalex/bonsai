uint32_t rec_build_triangles(const BVH* node, Triangles* restrict ST, size_t* restrict nodes_index, size_t* restrict primitives_index) {
  return std::visit(overloaded{
    [&](const Interior& node) {
      const size_t this_index = (*nodes_index);
      (*nodes_index) += 1;
      (*ST).nodes[this_index].lo1 = vec3_float{node.lo[0], node.lo[1], node.lo[2]};
      (*ST).nodes[this_index].hi1 = vec3_float{node.hi[0], node.hi[1], node.hi[2]};
      (*ST).dop36[this_index].lo2 = vec4_float{node.lo[3], node.lo[4], node.lo[5], node.lo[6]};
      (*ST).dop36[this_index].hi2 = vec4_float{node.hi[3], node.hi[4], node.hi[5], node.hi[6]};
      (*ST).nodes[this_index].ee = false;
      (*ST).nodes[this_index].is_leaf_flag = 0;
      const uint32_t left_index = rec_build_triangles(node.left, ST, nodes_index, primitives_index);
      reinterpret_cast<Arm_Interior *>(&(*ST).nodes[this_index].split0on_is_leaf_flag)->left = left_index;
      const uint32_t right_index = rec_build_triangles(node.right, ST, nodes_index, primitives_index);
      (*ST).nodes[this_index].right = right_index;
      return this_index;
    },
    [&](const Leaf& node) {
      const size_t this_index = (*nodes_index);
      (*nodes_index) += 1;
      (*ST).nodes[this_index].is_leaf_flag = 1;
      (*ST).nodes[this_index].ee = node.ee;
      reinterpret_cast<Arm_Leaf *>(&(*ST).nodes[this_index].split0on_is_leaf_flag)->tri_address = (*primitives_index);
      for (uint8_t __p = 0; __p < node.leaf_size; __p += 1) {
        (*ST).primitives[(__p + (*primitives_index))] = node.data[__p];
      }
      (*primitives_index) += node.leaf_size;
      return this_index;
    }
  }, *node);
}
void rec_count_triangles(const BVH* node, Triangles* restrict ST) {
  return std::visit(overloaded{
    [&](const Interior& node) {
      rec_count_triangles(node.left, ST);
      rec_count_triangles(node.right, ST);
      (*ST).node_count += 1;
    },
    [&](const Leaf& node) {
      (*ST).primitive_count += node.leaf_size;
      (*ST).node_count += 1;
    }
  }, *node);
}
Triangles build_triangles(const BVH* CT) {
  Triangles ST;
  size_t primitives_index = 0;
  size_t nodes_index = 0;
  rec_count_triangles(CT, (&ST));
  Triangle* primitives = reinterpret_cast<Triangle*>(malloc(sizeof(Triangle) * ST.primitive_count));
  ST.primitives = primitives;
  Dop36* dop36 = reinterpret_cast<Dop36*>(malloc(sizeof(Dop36) * ST.node_count));
  ST.dop36 = dop36;
  Nodes* nodes = reinterpret_cast<Nodes*>(malloc(sizeof(Nodes) * ST.node_count));
  ST.nodes = nodes;
  rec_build_triangles(CT, (&ST), (&nodes_index), (&primitives_index));
  return ST;
}
