type AABB = struct AABB{ low : f32x3; high : f32x3 }
type CCT = (u32, f32x3, f32x3)[2]
type FInterval = struct FInterval{ low : f32; high : f32 }
type Float = f32
type Half = f16
type Interior = struct Interior{ low : f32x3x2; high : f32x3x2; children : (const KD&)[2]; split_axis : u8; coord : f32 }
type KD = (const KD&)
type Leaf = struct Leaf{ nprims : u16; data : struct Point{ vec : f32x3 }[nprims] }
type Point = struct Point{ vec : f32x3 }
type Ray = struct Ray{ o : f32x3; d : f32x3; tmax : f32 = (f32)inf }
type Sphere = struct Sphere{ center : f32x3; radius : f32 }
type Triangle = struct Triangle{ p0 : f32x3; p1 : f32x3; p2 : f32x3 }
type TriangleIntersection = struct TriangleIntersection{ b0 : f32; b1 : f32; b2 : f32; t : f32 }
type arm_Interior = [[packed]] struct arm_Interior{ offset : u32 }
type arm_Leaf = [[packed]] struct arm_Leaf{ poffset : u32 }
type boolx3 = boolx3
type f32x2 = f32x2
type f32x3 = f32x3
type f32x3x2 = f32x3x2
type f32x3x4 = f32x3x4
type f32x4 = f32x4
type f32x4x3 = f32x4x3
type f32x5 = f32x5
type f32x6 = f32x6
type f32x7 = f32x7
type f32x8 = f32x8
type f32x9 = f32x9
type i8x3 = i8x3
type i8x4 = i8x4
type i8x4x3 = i8x4x3
type i8x9 = i8x9
type nodes = [[packed]] struct nodes{ coord : f32; split_axis : u8; pad0 : u8; nprims : u16; split0on_nprims : u8x4 }
type points = [[packed]] struct points{ primitive_count : u32; wlo : f32x3; whi : f32x3; primitives : struct Point{ vec : f32x3 }[primitive_count]; node_count : u32; nodes : [[packed]] struct nodes{ coord : f32; split_axis : u8; pad0 : u8; nprims : u16; split0on_nprims : u8x4 }[node_count] }
type u64x4 = u64x4
type u8x3 = u8x3
type u8x3x4 = u8x3x4
type vec3f = f32x3
type vec3h = f16x3

extern points : [[packed]] struct points{ primitive_count : u32; wlo : f32x3; whi : f32x3; primitives : struct Point{ vec : f32x3 }[primitive_count]; node_count : u32; nodes : [[packed]] struct nodes{ coord : f32; split_axis : u8; pad0 : u8; nprims : u16; split0on_nprims : u8x4 }[node_count] }

func _recloop_func0(hi : f32x3, lo : f32x3, index : u32, points : points, ray : Ray, _best0 : mut (f32, Point)) -> void {
  if (points.nodes[index].nprims == 0u) {
    if (intersects(ray, build<AABB>(build<f32x3x2>(lo, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord))[0], build<f32x3x2>(split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord), hi)[0]))) {
      if (distmin(ray, build<AABB>(build<f32x3x2>(lo, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord))[0], build<f32x3x2>(split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord), hi)[0])) < _best0[0]) {
        _recloop_func0((index + 1u, lo, split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord))[0], (index + 1u, lo, split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord))[1], (index + 1u, lo, split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord))[2], points, ray, _best0)
      }
    }
    if (intersects(ray, build<AABB>(build<f32x3x2>(lo, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord))[1], build<f32x3x2>(split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord), hi)[1]))) {
      if (distmin(ray, build<AABB>(build<f32x3x2>(lo, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord))[1], build<f32x3x2>(split_aabb(hi, points.nodes[index].split_axis, points.nodes[index].coord), hi)[1])) < _best0[0]) {
        _recloop_func0((index + reinterpret_cast<arm_Interior>(points.nodes[index].split0on_nprims).offset, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord), hi)[0], (index + reinterpret_cast<arm_Interior>(points.nodes[index].split0on_nprims).offset, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord), hi)[1], (index + reinterpret_cast<arm_Interior>(points.nodes[index].split0on_nprims).offset, split_aabb(lo, points.nodes[index].split_axis, points.nodes[index].coord), hi)[2], points, ray, _best0)
      }
    }
  } else {
    foreach _iter0 in points.primitives[reinterpret_cast<arm_Leaf>(points.nodes[index].split0on_nprims).poffset:reinterpret_cast<arm_Leaf>(points.nodes[index].split0on_nprims).poffset + cast<u32>(points.nodes[index].nprims)] {
      if (true) {
        if (intersects(ray, _iter0)) {
          if (distmin(ray, _iter0) < _best0[0]) {
            _best0 argmin= (distmin(ray, _iter0), _iter0)
          }
        }
      }
    }
  }
  return
}

func _traverse_tree0(ray : Ray, points : points) -> option<Point> {
  _best0 : mut (f32, Point) := ((f32)inf, build<Point>())
  _recloop_func0(points.whi, points.wlo, 0u, points, ray, _best0)
  yield select(_best0[0] != (f32)inf, build<option<Point>>(_best0[1]), build<option<Point>>())
}

func [[export]] build_points(CT : (const KD&)) -> points {
  ST : mut points
  primitives_index : mut idx
  nodes_index : mut idx
  rec_count_points(CT, ST)
  alloc primitives : mut Point[ST.primitive_count]
  ST.primitives = primitives
  alloc nodes : mut nodes[ST.node_count]
  ST.nodes = nodes
  rec_build_points(CT, ST, nodes_index, primitives_index)
  return ST
}

func distmax_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.high
  }
  return (f32)inf
}

func distmax_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return -(f32)inf
  }
}

func distmin_Point_AABB(pt : Point, a : AABB) -> f32 {
  return sqrt(SqDistPointAABB(pt, a))
}

func distmin_Point_Triangle(p : Point, tri : Triangle) -> f32 {
  let pts = closestPointonTriangle(p, tri) in
  return norm(p.vec - pts[0].vec)
}

func distmin_Ray_AABB(r : Ray, b : AABB) -> f32 {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Sphere(r : Ray, s : Sphere) -> f32 {
  let interval = intersectsp_ray_sphere(r, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return extract.low
  }
  return -(f32)inf
}

func distmin_Ray_Triangle(ray : Ray, tri : Triangle) -> f32 {
  let isect = intersectsp_ray_tri(ray, tri) in
  if (cast<bool>(isect)) {
    let isect_ = cast<TriangleIntersection>(isect) in
    return isect_.t
  } else {
    return (f32)inf
  }
}

func intersects_AABB_AABB(a : AABB, b : AABB) -> bool {
  let low = max(a.low, b.low) in
  let high = min(a.high, b.high) in
  return reduce<all>(low <= high)
}

func intersects_AABB_Sphere(a : AABB, s : Sphere) -> bool {
  let closest = max(a.low, min(s.center, a.high)) in
  let d = s.center - closest in
  return dot(d, d) <= (s.radius * s.radius)
}

func intersects_AABB_Triangle(a : AABB, b : Triangle) -> bool {
  let center = (a.low + a.high) * f32x3(0.5f) in
  let extents = (a.high - a.low) * f32x3(0.5f) in
  let v0 = b.p0 - center in
  let v1 = b.p1 - center in
  let v2 = b.p2 - center in
  let f0 = v1 - v0 in
  let f1 = v2 - v1 in
  let f2 = v0 - v2 in
  let tri_min = min(min(v0, v1), v2) in
  let tri_max = max(max(v0, v1), v2) in
  if (!reduce<all>((tri_min <= extents) & (-extents <= tri_max))) {
    return false
  }
  let X = (f32x3)[1f,0f,0f] in
  let Y = (f32x3)[0f,1f,0f] in
  let Z = (f32x3)[0f,0f,1f] in
  let A0 = cross(f0, X) in
  let A1 = cross(f0, Y) in
  let A2 = cross(f0, Z) in
  let A3 = cross(f1, X) in
  let A4 = cross(f1, Y) in
  let A5 = cross(f1, Z) in
  let A6 = cross(f2, X) in
  let A7 = cross(f2, Y) in
  let A8 = cross(f2, Z) in
  if (!axis(A0, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A1, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A2, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A3, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A4, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A5, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A6, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A7, extents, v0, v1, v2)) {
    return false
  }
  if (!axis(A8, extents, v0, v1, v2)) {
    return false
  }
  let N = cross(f0, f1) in
  let Rn = dot(extents, abs(N)) in
  let dist = dot(v0, N) in
  if ((Rn < dist) || (dist < -Rn)) {
    return false
  }
  return true
}

func intersects_Ray_AABB(r : Ray, b : AABB) -> bool {
  let interval = intersectsp_ray_aabb(r, b) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < r.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Sphere(ray : Ray, s : Sphere) -> bool {
  let interval = intersectsp_ray_sphere(ray, s) in
  if (cast<bool>(interval)) {
    let extract = cast<FInterval>(interval) in
    return (extract.low < ray.tmax) & (0f < extract.high)
  }
  return false
}

func intersects_Ray_Triangle(ray : Ray, tri : Triangle) -> bool {
  return cast<bool>(intersectsp_ray_tri(ray, tri))
}

func intersects_Triangle_Triangle(a : Triangle, b : Triangle) -> bool {
  let eA0 = a.p1 - a.p0 in
  let eA1 = a.p2 - a.p1 in
  let eA2 = a.p0 - a.p2 in
  let eB0 = b.p1 - b.p0 in
  let eB1 = b.p2 - b.p1 in
  let eB2 = b.p0 - b.p2 in
  let N0 = cross(eA0, eA1) in
  let N1 = cross(eB0, eB1) in
  let a0 = a.p0 in
  let a1 = a.p1 in
  let a2 = a.p2 in
  let b0 = b.p0 in
  let b1 = b.p1 in
  let b2 = b.p2 in
  if (!tri_tri_axis(N0, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(N1, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  let E00 = cross(eA0, eB0) in
  let E01 = cross(eA0, eB1) in
  let E02 = cross(eA0, eB2) in
  let E10 = cross(eA1, eB0) in
  let E11 = cross(eA1, eB1) in
  let E12 = cross(eA1, eB2) in
  let E20 = cross(eA2, eB0) in
  let E21 = cross(eA2, eB1) in
  let E22 = cross(eA2, eB2) in
  if (!tri_tri_axis(E00, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E01, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E02, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E10, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E11, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E12, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E20, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E21, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  if (!tri_tri_axis(E22, a0, a1, a2, b0, b1, b2)) {
    return false
  }
  return true
}

func rec_build_points(node : (const KD&), ST : mut points, nodes_index : mut idx, primitives_index : mut idx) -> u32 {
  match node {
  | Interior(low : f32x3x2, high : f32x3x2, children : (const KD&)[2], split_axis : u8, coord : f32) with AABB(low, high) ->
    let this_index = nodes_index in
    nodes_index += 1
    if (this_index == 0) {
      ST.wlo = build<f32x3>(min(node.low[0].x, node.low[1].x), min(node.low[0].y, node.low[1].y), min(node.low[0].z, node.low[1].z))
      ST.whi = build<f32x3>(max(node.high[0].x, node.high[1].x), max(node.high[0].y, node.high[1].y), max(node.high[0].z, node.high[1].z))
    }
    ST.nodes[this_index].coord = node.coord
    ST.nodes[this_index].split_axis = node.split_axis
    ST.nodes[this_index].nprims = 0
    children_index : mut u32[2]
    forall __r in [0:2:1] {
      children_index[__r] = rec_build_points(node.children[__r], ST, nodes_index, primitives_index)
    }
    reinterpret_cast<(arm_Interior*)>(ST.nodes[this_index].split0on_nprims).offset = children_index[1] - this_index
    return this_index
  | Leaf(nprims : u16, data : Point[nprims]) ->
    let this_index = nodes_index in
    nodes_index += 1
    ST.nodes[this_index].nprims = node.nprims
    reinterpret_cast<(arm_Leaf*)>(ST.nodes[this_index].split0on_nprims).poffset = primitives_index
    forall __p in [0u:node.nprims:1u] {
      ST.primitives[(__p + primitives_index)] = node.data[__p]
    }
    primitives_index += node.nprims
    return this_index
  }
}

func rec_count_points(node : (const KD&), ST : mut points) -> void {
  match node {
  | Interior(low : f32x3x2, high : f32x3x2, children : (const KD&)[2], split_axis : u8, coord : f32) with AABB(low, high) ->
    forall __r in [0:2:1] {
      rec_count_points(node.children[__r], ST)
    }
    ST.node_count += 1u
  | Leaf(nprims : u16, data : Point[nprims]) ->
    ST.primitive_count += node.nprims
    ST.node_count += 1u
  }
}

func split_aabb(v : f32x3, split_axis : u8, coord : f32) -> f32x3 {
  v_ : mut f32x3 := v
  v_[split_axis] = coord
  return v_
}

func [[export]] trace(ray : Ray, points : points) -> option<Point> {
  return _traverse_tree0(ray, points)
}


schedule host {
    points : tree[[struct Point{ vec : f32x3 }]] KD
  | Interior(low : f32x3x2, high : f32x3x2, children : (const KD&)[2], split_axis : u8, coord : f32) with AABB(low, high)
  | Leaf(nprims : u16, data : Point[nprims])

}
