//! flags: -b cppx

import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles));

element u64x8 = vector[u64, 8];

schedule {
    tree[[Triangle]] BVH 
      = Interior(children: array[BVH, 8], lo: f32x3x8, hi: f32x3x8) with AABB(lo, hi) on children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(I: u64 = 2u) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        indirect group Interiors {
            lo: f32x3x8;
            hi: f32x3x8;
            children: u64x8;
        };

        group _ by I {
            split I[0:1] {
                2 -> Interior from Interiors[I[5:63]];
                _ -> Leaf { nprims = cast[[u8]](I[2:4] + 1); data = primitives[I[5:63] : I[5:63] + nprims]; };
            };
        };
    };

    build triangles {
      build Interior(children: array[BVH, 8], lo: f32x3x8, hi: f32x3x8) {
        build lo;
        build hi;
        recurse children;
        return (this << cast[[u64]](4)) | cast[[u64]](2);
      };

      build Leaf(nprims: u8, data: array[Triangle, nprims]) {
        let poffset: u64 = append(data, nprims);
        return (poffset << cast[[u64]](5)) | ((nprims - cast[[u64]](1)) << cast[[u64]](2));
      };
    };

    trace.loopify(64);
}

