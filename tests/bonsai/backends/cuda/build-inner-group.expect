};

struct Interior {
  float3 low;
  float3 high;
  BVH* left;
  BVH* right;
  uint8_t axis;
};

struct Triangle {
  float3 p0;
  float3 p1;
  float3 p2;
};

struct Leaf {
  float3 low;
  float3 high;
  uint16_t nprims;
  Triangle* data;
};

struct Point {
  float3 vec;
};

struct Ray {
  float3 o;
  float3 d;
  float tmax = INFINITY;
};

struct Sphere {
  float3 center;
  float radius;
};

struct TriangleIntersection {
  float b0;
  float b1;
  float b2;
  float t;
};

struct Arm_Interior {
  uint32_t offset;
} __attribute__((packed));

struct Arm_Leaf {
  uint32_t poffset;
} __attribute__((packed));

struct Highs {
  float3 high;
} __attribute__((packed));

struct Lows {
  float3 low;
} __attribute__((packed));

struct Nodes {
  uint16_t nprims;
  uint8_t axis;
  uint8_t pad0;
  uchar4 split0on_nprims;
} __attribute__((packed));

struct Volumes {
  cuda::std::array<Lows, 4> lows;
