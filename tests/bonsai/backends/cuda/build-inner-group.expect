#include "helpers.h"
#include <thrust/universal_vector.h>
#include <optional>
#include <tuple>

struct AABB {
  float3 low;
  float3 high;
};

struct FInterval {
  float low;
  float high;
};

struct Interior {
  float3 low;
  float3 high;
  (const BVH&) left;
  (const BVH&) right;
  uint8_t axis;
};

struct Triangle {
  float3 p0;
  float3 p1;
  float3 p2;
};

struct Leaf {
  float3 low;
  float3 high;
  uint16_t nprims;
  Triangle* data; // of size nprims
};

struct Point {
  float3 vec;
};

struct Ray {
  float3 o;
  float3 d;
  float tmax = INFINITY;
};

struct Sphere {
  float3 center;
  float radius;
};

struct TriangleIntersection {
  float b0;
  float b1;
  float b2;
  float t;
};

struct arm_Interior {
  uint32_t offset;
} __attribute__((packed));

struct arm_Leaf {
  uint32_t poffset;
} __attribute__((packed));

struct highs {
  float3 high;
} __attribute__((packed));

struct lows {
  float3 low;
} __attribute__((packed));

struct nodes {
  uint16_t nprims;
  uint8_t axis;
  uint8_t pad0;
  uchar4 split0on_nprims;
} __attribute__((packed));

struct volumes {
  lows* lows; // of size 4
  highs* highs; // of size 4
} __attribute__((packed));

struct triangles {
  uint32_t primitive_count;
  Triangle* primitives; // of size primitive_count
  uint32_t node_count;
  volumes* volumes; // of size node_count
  nodes* nodes; // of size node_count
} __attribute__((packed));

__device__ __host__ float __prod_diff_f32(float a, float b, float c, float d) {
  float cd = (c * d);
  float diff = fmaf(a, b, -cd);
  float err = fmaf(-c, d, cd);
  return (diff + err);
}

__device__ __host__ std::optional<FInterval> intersectsp_ray_aabb(Ray* r, AABB* b) {
  float3 invDir = (make_float3(1) / (*r).d);
  bool3 dirIsNeg = (invDir < make_float3(0));
  float3 low_parts = make_float3((dirIsNeg.x ? (*b).high.x : (*b).low.x),(dirIsNeg.y ? (*b).high.y : (*b).low.y),(dirIsNeg.z ? (*b).high.z : (*b).low.z));
  float3 high_parts = make_float3((dirIsNeg.x ? (*b).low.x : (*b).high.x),(dirIsNeg.y ? (*b).low.y : (*b).high.y),(dirIsNeg.z ? (*b).low.z : (*b).high.z));
  float3 _tMin = ((low_parts - (*r).o) * invDir);
  float3* tMin = &_tMin;
  float3 _tMax = ((high_parts - (*r).o) * invDir);
  float3* tMax = &_tMax;
  *tMax *= (1 + ((float)2 * (((float)3 * (float)5.96046e-08) / (1 - ((float)3 * (float)5.96046e-08)))));
  if ((tMax.y < tMin.x) || (tMax.x < tMin.y)) {
    return std::optional<FInterval>{};
  }
  float _tmin = fmaxf(tMin.x, tMin.y);
  float* tmin = &_tmin;
  float _tmax = fminf(tMax.x, tMax.y);
  float* tmax = &_tmax;
  if ((tMax.z < tmin) || (tmax < tMin.z)) {
    return std::optional<FInterval>{};
  }
  *tmin = fmaxf(tmin, tMin.z);
  *tmax = fminf(tmax, tMax.z);
  return (std::optional<FInterval>)FInterval{tmin, tmax};
}

__device__ __host__ float distmin_Ray_AABB(Ray* r, AABB* b) {
  std::optional<FInterval> interval = intersectsp_ray_aabb(r, b);
  if ((bool)interval) {
    FInterval extract = (FInterval)interval;
    return extract.low;
  }
  return -INFINITY;
}

__device__ __host__ float3 cross_(float3 v0, float3 v1) {
  return float3{__prod_diff_f32(v0.y, v1.z, v0.z, v1.y), __prod_diff_f32(v0.z, v1.x, v0.x, v1.z), __prod_diff_f32(v0.x, v1.y, v0.y, v1.x)};
}

__device__ __host__ std::optional<TriangleIntersection> intersectsp_ray_tri(Ray* ray, Triangle* tri) {
  if (sum((cross_((*tri).p2 - (*tri).p0, (*tri).p1 - (*tri).p0) * cross_((*tri).p2 - (*tri).p0, (*tri).p1 - (*tri).p0))) == 0) {
    return std::optional<TriangleIntersection>{};
  }
  float3 _p0t = ((*tri).p0 - (*ray).o);
  float3* p0t = &_p0t;
  float3 _p1t = ((*tri).p1 - (*ray).o);
  float3* p1t = &_p1t;
  float3 _p2t = ((*tri).p2 - (*ray).o);
  float3* p2t = &_p2t;
  uint32_t kz = idxmax(abs((*ray).d));
  uint32_t kx = ((kz + 1u) % 3u);
  uint32_t ky = ((kx + 1u) % 3u);
  float3 d = shuffle((*ray).d, {kx, ky, kz});
  *p0t = shuffle(p0t, {kx, ky, kz});
  *p1t = shuffle(p1t, {kx, ky, kz});
  *p2t = shuffle(p2t, {kx, ky, kz});
  float Sx = (-d.x / d.z);
  float Sy = (-d.y / d.z);
  float Sz = (1 / d.z);
  *p0t += (Sx * p0t.z);
  *p0t += (Sy * p0t.z);
  *p1t += (Sx * p1t.z);
  *p1t += (Sy * p1t.z);
  *p2t += (Sx * p2t.z);
  *p2t += (Sy * p2t.z);
  float e0 = __prod_diff_f32(p1t.x, p2t.y, p1t.y, p2t.x);
  float e1 = __prod_diff_f32(p2t.x, p0t.y, p2t.y, p0t.x);
  float e2 = __prod_diff_f32(p0t.x, p1t.y, p0t.y, p1t.x);
  if (((e0 < 0) || (e1 < 0)) || (e2 < 0)) {
    if (((0 < e0) || (0 < e1)) || (0 < e2)) {
      return std::optional<TriangleIntersection>{};
    }
  }
  float det = ((e0 + e1) + e2);
  if (det == 0) {
    return std::optional<TriangleIntersection>{};
  }
  *p0t *= Sz;
  *p1t *= Sz;
  *p2t *= Sz;
  float tScaled = (((e0 * p0t.z) + (e1 * p1t.z)) + (e2 * p2t.z));
  if ((det < 0) && ((0 <= tScaled) || (tScaled < ((*ray).tmax * det)))) {
    return std::optional<TriangleIntersection>{};
  } else {
    if ((0 < det) && ((tScaled <= 0) || (((*ray).tmax * det) < tScaled))) {
      return std::optional<TriangleIntersection>{};
    }
  }
  float invDet = (1 / det);
  float b0 = (e0 * invDet);
  float b1 = (e1 * invDet);
  float b2 = (e2 * invDet);
  float t = (tScaled * invDet);
  float maxZt = max(abs(float3{p0t.z, p1t.z, p2t.z}));
  float deltaZ = ((((float)3 * (float)5.96046e-08) / (1 - ((float)3 * (float)5.96046e-08))) * maxZt);
  float maxXt = max(abs(float3{p0t.x, p1t.x, p2t.x}));
  float maxYt = max(abs(float3{p0t.y, p1t.y, p2t.y}));
  float deltaX = ((((float)5 * (float)5.96046e-08) / (1 - ((float)5 * (float)5.96046e-08))) * (maxXt + maxZt));
  float deltaY = ((((float)5 * (float)5.96046e-08) / (1 - ((float)5 * (float)5.96046e-08))) * (maxYt + maxZt));
  float deltaE = ((float)2 * (((((((float)2 * (float)5.96046e-08) / (1 - ((float)2 * (float)5.96046e-08))) * maxXt) * maxYt) + (deltaY * maxXt)) + (deltaX * maxYt)));
  float maxE = max(abs(float3{e0, e1, e2}));
  float deltaT = (((float)3 * (((((((float)3 * (float)5.96046e-08) / (1 - ((float)3 * (float)5.96046e-08))) * maxE) * maxZt) + (deltaE * maxZt)) + (deltaZ * maxE))) * fabsf(invDet));
  if (t <= deltaT) {
    return std::optional<TriangleIntersection>{};
  }
  return (std::optional<TriangleIntersection>)TriangleIntersection{b0, b1, b2, t};
}

__device__ __host__ float distmin_Ray_Triangle(Ray* ray, Triangle* tri) {
  std::optional<TriangleIntersection> isect = intersectsp_ray_tri(ray, tri);
  if ((bool)isect) {
    TriangleIntersection isect_ = (TriangleIntersection)isect;
    return isect_.t;
  } else {
    return INFINITY;
  }
}

__device__ __host__ bool intersects_Ray_AABB(Ray* r, AABB* b) {
  std::optional<FInterval> interval = intersectsp_ray_aabb(r, b);
  if ((bool)interval) {
    FInterval extract = (FInterval)interval;
    return ((extract.low < (*r).tmax) & (0 < extract.high));
  }
  return false;
}

__device__ __host__ void _recloop_func0(uint32_t index, triangles* triangles, Ray* ray, std::tuple<float, Triangle>* _best0) {
  AABB _lv5 = AABB{(*triangles).volumes[index / 4u].lows[index % 4u].low, (*triangles).volumes[index / 4u].highs[index % 4u].high};
  if (intersects_Ray_AABB(ray, (&_lv5))) {
    AABB _lv4 = AABB{(*triangles).volumes[index / 4u].lows[index % 4u].low, (*triangles).volumes[index / 4u].highs[index % 4u].high};
    if (distmin_Ray_AABB(ray, (&_lv4)) < (*_best0)[0]) {
      if ((*triangles).nodes[index].nprims == 0u) {
        _recloop_func0(index + 1u, triangles, ray, _best0);
        _recloop_func0(index + bonsai_reinterpret<arm_Interior>((*triangles).nodes[index].split0on_nprims).offset, triangles, ray, _best0);
      } else {
        for (uint32_t _idx0 = bonsai_reinterpret<arm_Leaf>((*triangles).nodes[index].split0on_nprims).poffset; _idx0 < (bonsai_reinterpret<arm_Leaf>((*triangles).nodes[index].split0on_nprims).poffset + (uint32_t)(*triangles).nodes[index].nprims); _idx0 += 1u) {
          Triangle _lv3 = (*triangles).primitives[_idx0];
          if ((bool)intersectsp_ray_tri(ray, (&_lv3))) {
            Triangle _lv2 = (*triangles).primitives[_idx0];
            if (distmin_Ray_Triangle(ray, (&_lv2)) < (*_best0)[0]) {
              Triangle _lv0 = (*triangles).primitives[_idx0];
              Triangle _lv1 = (*triangles).primitives[_idx0];
              *_best0 = argmin(_best0, std::tuple<float, Triangle>{distmin_Ray_Triangle(ray, (&_lv0)), _lv1});
            }
          }
        }
      }
    }
  }
  return;
}

__device__ __host__ std::optional<Triangle> _traverse_tree0(Ray* ray, triangles* triangles) {
  std::tuple<float, Triangle> __best0 = std::tuple<float, Triangle>{INFINITY, Triangle{}};
  std::tuple<float, Triangle>* _best0 = &__best0;
  _recloop_func0(0u, triangles, ray, (&_best0));
  return ((_best0[0] != INFINITY) ? std::optional<Triangle>{_best0[1]} : std::optional<Triangle>{});
}

__device__ __host__ uint32_t rec_build_triangles((const BVH&) node, triangles* ST, idx* nodes_index, idx* primitives_index) {
  return std::visit(overloaded{
    [&](const Interior& node) {
      idx this_index = (*nodes_index);
      *nodes_index += 1;
      *ST.volumes[(this_index / 4u)].lows[(this_index & 3u)].low = node.low;
      *ST.volumes[(this_index / 4u)].highs[(this_index & 3u)].high = node.high;
      *ST.nodes[this_index].nprims = 0;
      *ST.nodes[this_index].axis = argmax(node.high - node.low);
      uint32_t left_index = rec_build_triangles(node.left, ST, nodes_index, primitives_index);
      uint32_t right_index = rec_build_triangles(node.right, ST, nodes_index, primitives_index);
      *reinterpret_cast<(arm_Interior*)>(ST.nodes[this_index].split0on_nprims).offset = (right_index - this_index);
      return this_index;
    },
    [&](const Leaf& node) {
      idx this_index = (*nodes_index);
      *nodes_index += 1;
      *ST.volumes[(this_index / 4u)].lows[(this_index & 3u)].low = node.low;
      *ST.volumes[(this_index / 4u)].highs[(this_index & 3u)].high = node.high;
      *ST.nodes[this_index].axis = argmax(node.high - node.low);
      *ST.nodes[this_index].nprims = node.nprims;
      *reinterpret_cast<(arm_Leaf*)>(ST.nodes[this_index].split0on_nprims).poffset = (*primitives_index);
      for (uint16_t __p = 0u; __p < node.nprims; __p += 1u) {
        *ST.primitives[(__p + (*primitives_index))] = node.data[__p];
      }
      *primitives_index += node.nprims;
      return this_index;
    }
  }, *node);
}

__device__ __host__ void rec_count_triangles((const BVH&) node, triangles* ST) {
  return std::visit(overloaded{
    [&](const Interior& node) {
      rec_count_triangles(node.left, ST);
      rec_count_triangles(node.right, ST);
      *ST += 1u;
    },
    [&](const Leaf& node) {
      *ST += node.nprims;
      *ST += 1u;
    }
  }, *node);
}

__host__ triangles build_triangles((const BVH&) CT) {
  triangles _ST;
  triangles* ST = &_ST;
  idx _primitives_index = 0;
  idx* primitives_index = &_primitives_index;
  idx _nodes_index = 0;
  idx* nodes_index = &_nodes_index;
  rec_count_triangles(CT, (&ST));
  Triangle* primitives;
  (void)cudaMalloc((void**)&primitives, ST.primitive_count * sizeof(Triangle));
  *ST.primitives = primitives;
  volumes* volumes;
  (void)cudaMalloc((void**)&volumes, ST.node_count * sizeof(volumes));
  *ST.volumes = volumes;
  nodes* nodes;
  (void)cudaMalloc((void**)&nodes, ST.node_count * sizeof(nodes));
  *ST.nodes = nodes;
  rec_build_triangles(CT, (&ST), (&nodes_index), (&primitives_index));
  return ST;
}

__host__ std::optional<Triangle> trace(Ray* ray, triangles* triangles) {
  return _traverse_tree0(ray, triangles);
}
