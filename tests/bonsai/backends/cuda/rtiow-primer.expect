float random_float(float low, float high) {
  return (low + ((high - low) * static_cast<float>(rand())));
}

float3 random_on_hemisphere(float3 normal) {
  float3 on_unit_sphere = random_unit_vector();
  if (0 < dot(on_unit_sphere, normal)) {
    return on_unit_sphere;
  } else {
    return -on_unit_sphere;
  }
}

float3 random_vec3f() {
  return float3{static_cast<float>(rand()), static_cast<float>(rand()), static_cast<float>(rand())};
}

