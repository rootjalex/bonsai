  float3 mlo = min(low.x, min(low.y, min(low.z, low.w)));
  float3 mex = calculate_merged_extent(low, high);
  return cuda::std::array<uchar3, 4>{to_u8_floor(((low.x - mlo) / mex) * make_float3((float)255)), to_u8_floor(((low.y - mlo) / mex) * make_float3((float)255)), to_u8_floor(((low.z - mlo) / mex) * make_float3((float)255)), to_u8_floor(((low.w - mlo) / mex) * make_float3((float)255))};
}

__device__ __host__ int8_t to_i8(float f) {
  float f1 = roundf(f);
  float f2 = fmaxf((float)-128, fminf(f1, (float)127));
  return (int8_t)f2;
}

__device__ __host__ uint64_t rec_build_triangles(BVH* node, triangles* ST, size_t* AABBs_index, size_t* OBBs_index, size_t* primitives_index) {
  return std::visit(overloaded{
    [&](const AABBNode& node) {
      size_t this_index = (*AABBs_index);
      *AABBs_index += 1;
      *ST.AABBs[this_index].aabb_low = node.aabb_low;
      *ST.AABBs[this_index].aabb_high = node.aabb_high;
      uint64_t aabb_children_index0 = rec_build_triangles(node.aabb_children[0], ST, AABBs_index, OBBs_index, primitives_index);
      *ST.AABBs[this_index].aabb_children[0] = aabb_children_index0;
      uint64_t aabb_children_index1 = rec_build_triangles(node.aabb_children[1], ST, AABBs_index, OBBs_index, primitives_index);
      *ST.AABBs[this_index].aabb_children[1] = aabb_children_index1;
      uint64_t aabb_children_index2 = rec_build_triangles(node.aabb_children[2], ST, AABBs_index, OBBs_index, primitives_index);
      *ST.AABBs[this_index].aabb_children[2] = aabb_children_index2;
      uint64_t aabb_children_index3 = rec_build_triangles(node.aabb_children[3], ST, AABBs_index, OBBs_index, primitives_index);
      *ST.AABBs[this_index].aabb_children[3] = aabb_children_index3;
      return ((this_index << 4u) | 2u);
    },
    [&](const OBBNode& node) {
      size_t this_index = (*OBBs_index);
      *OBBs_index += 1;
      *ST.OBBs[this_index].mlo = min((*ST).AABBs[this_index].aabb_low.x, min((*ST).AABBs[this_index].aabb_low.y, min((*ST).AABBs[this_index].aabb_low.z, (*ST).AABBs[this_index].aabb_low.w)));
      *ST.OBBs[this_index].mex = calculate_merged_extent((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      *ST.OBBs[this_index].qlo = quantize_bounds_low((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      *ST.OBBs[this_index].qhi = quantize_bounds_high((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      *ST.OBBs[this_index].qorientation = cuda::std::array<char4, 3>{char4{to_i8(node.orientation.x.x * (float)127), to_i8(node.orientation.x.y * (float)127), to_i8(node.orientation.x.z * (float)127), to_i8(node.orientation.x.w * (float)127)}, char4{to_i8(node.orientation.y.x * (float)127), to_i8(node.orientation.y.y * (float)127), to_i8(node.orientation.y.z * (float)127), to_i8(node.orientation.y.w * (float)127)}, char4{to_i8(node.orientation.z.x * (float)127), to_i8(node.orientation.z.y * (float)127), to_i8(node.orientation.z.z * (float)127), to_i8(node.orientation.z.w * (float)127)}};
      for (int32_t __r = 0; __r < 4; __r += 1) {
        uint64_t obb_children_index = rec_build_triangles(node.obb_children[__r], ST, AABBs_index, OBBs_index, primitives_index);
        *ST.OBBs[this_index].obb_children[__r] = obb_children_index;
      }
      return ((this_index << 4u) | 3u);
    },
    [&](const Leaf& node) {
      for (uint8_t __p = 0u; __p < node.nprims; __p += 1u) {
        *ST.primitives[(__p + (*primitives_index))] = node.data[__p];
      }
      *primitives_index += node.nprims;
      uint64_t poffset = (*primitives_index);
      return ((poffset << 4u) | (uint64_t)(node.nprims << 2u));
    }
  }, *node);
}

__device__ __host__ void rec_count_triangles(BVH* node, triangles* ST, size_t* size_AABBs, size_t* size_OBBs) {
  return std::visit(overloaded{
    [&](const AABBNode& node) {
      for (int32_t __r = 0; __r < 4; __r += 1) {
        rec_count_triangles(node.aabb_children[__r], ST, size_AABBs, size_OBBs);
      }
      *size_AABBs += 1;
    },
    [&](const OBBNode& node) {
      for (int32_t __r = 0; __r < 4; __r += 1) {
        rec_count_triangles(node.obb_children[__r], ST, size_AABBs, size_OBBs);
      }
      *size_OBBs += 1;
    },
    [&](const Leaf& node) {
      *ST += node.nprims;
    }
  }, *node);
}

__host__ triangles build_triangles(BVH* CT) {
  triangles _ST;
  triangles* ST = &_ST;
  size_t _primitives_index = 0;
  size_t* primitives_index = &_primitives_index;
  size_t _size_AABBs = 0;
  size_t* size_AABBs = &_size_AABBs;
  size_t _size_OBBs = 0;
  size_t* size_OBBs = &_size_OBBs;
  rec_count_triangles(CT, (&ST), (&size_AABBs), (&size_OBBs));
  Triangle* primitives;
  (void)cudaMalloc((void**)&primitives, ST.primitive_count * sizeof(Triangle));
  *ST.primitives = primitives;
  AABBs* AABBs;
  (void)cudaMalloc((void**)&AABBs, size_AABBs * sizeof(AABBs));
  *ST.AABBs = AABBs;
  OBBs* OBBs;
  (void)cudaMalloc((void**)&OBBs, size_OBBs * sizeof(OBBs));
  *ST.OBBs = OBBs;
  rec_build_triangles(CT, (&ST), (&AABBs_index), (&OBBs_index), (&primitives_index));
  return ST;
}

__host__ std::optional<Triangle> trace(Ray* ray, triangles* triangles) {
  return _traverse_tree0(ray, triangles);
}
