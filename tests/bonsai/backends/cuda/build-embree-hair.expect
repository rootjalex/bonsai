      (*ST).AABBs[this_index].aabb_children[2] = aabb_children_index2;
      uint64_t aabb_children_index3 = rec_build_triangles(node.aabb_children[3], ST, AABBs_index, OBBs_index, primitives_index);
      (*ST).AABBs[this_index].aabb_children[3] = aabb_children_index3;
      return ((this_index << 4u) | 2u);
    }
    else if (std::holds_alternative<OBBNode>(*node_)) {
      const OBBNode& node = std::get<OBBNode>(*node_);
      size_t this_index = (*OBBs_index);
      (*OBBs_index) += 1;
      (*ST).OBBs[this_index].mlo = min((*ST).AABBs[this_index].aabb_low.x, min((*ST).AABBs[this_index].aabb_low.y, min((*ST).AABBs[this_index].aabb_low.z, (*ST).AABBs[this_index].aabb_low.w)));
      (*ST).OBBs[this_index].mex = calculate_merged_extent((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      (*ST).OBBs[this_index].qlo = quantize_bounds_low((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      (*ST).OBBs[this_index].qhi = quantize_bounds_high((*ST).AABBs[this_index].aabb_low, (*ST).AABBs[this_index].aabb_high);
      (*ST).OBBs[this_index].qorientation = quantize_orientation(node.orientation);
      uint64_t obb_children_index[4];
      for (int32_t __r = 0; __r < 4; __r += 1) {
        obb_children_index[__r] = rec_build_triangles(node.obb_children[__r], ST, AABBs_index, OBBs_index, primitives_index);
        (*ST).OBBs[this_index].obb_children[__r] = obb_children_index[__r];
      }
      return ((this_index << 4u) | 3u);
    }
    else if (std::holds_alternative<Leaf>(*node_)) {
      const Leaf& node = std::get<Leaf>(*node_);
      for (uint8_t __p = 0u; __p < node.nprims; __p += 1u) {
        (*ST).primitives[(__p + (*primitives_index))] = node.data[__p];
      }
      (*primitives_index) += node.nprims;
      uint64_t poffset = (*primitives_index);
      return ((poffset << 4u) | (uint64_t)(node.nprims << 2u));
    }
}

__host__ void rec_count_triangles(BVH* node_, Triangles* ST, size_t* size_AABBs, size_t* size_OBBs) {
    if (std::holds_alternative<AABBNode>(*node_)) {
      const AABBNode& node = std::get<AABBNode>(*node_);
      for (int32_t __r = 0; __r < 4; __r += 1) {
        rec_count_triangles(node.aabb_children[__r], ST, size_AABBs, size_OBBs);
      }
      (*size_AABBs) += 1;
    }
    else if (std::holds_alternative<OBBNode>(*node_)) {
      const OBBNode& node = std::get<OBBNode>(*node_);
      for (int32_t __r = 0; __r < 4; __r += 1) {
        rec_count_triangles(node.obb_children[__r], ST, size_AABBs, size_OBBs);
      }
      (*size_OBBs) += 1;
    }
    else if (std::holds_alternative<Leaf>(*node_)) {
      const Leaf& node = std::get<Leaf>(*node_);
      (*ST).primitive_count += node.nprims;
    }
}

__host__ Triangles build_triangles(BVH* CT) {
  Triangles ST;
  size_t primitives_index = 0;
  size_t size_AABBs = 0;
  size_t size_OBBs = 0;
  ST.primitive_count = 0u;
  rec_count_triangles(CT, (&ST), (&size_AABBs), (&size_OBBs));
  Triangle* primitives = reinterpret_cast<Triangle*>(malloc(sizeof(Triangle) * ST.primitive_count));
  ST.primitives = primitives;
  AABBs* AABBs = reinterpret_cast<AABBs*>(malloc(sizeof(AABBs) * size_AABBs));
  ST.AABBs = AABBs;
  OBBs* OBBs = reinterpret_cast<OBBs*>(malloc(sizeof(OBBs) * size_OBBs));
  ST.OBBs = OBBs;
  rec_build_triangles(CT, (&ST), (&AABBs_index), (&OBBs_index), (&primitives_index));
  return ST;
}

__host__ cuda::std::optional<Triangle> trace(Ray* ray, Triangles* triangles) {
  return _traverse_tree0(ray, triangles);
}
