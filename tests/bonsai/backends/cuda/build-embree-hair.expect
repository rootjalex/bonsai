__device__ __host__ float3 calculate_merged_extent(cuda::std::array<float3, 4> low, cuda::std::array<float3, 4> high) {
  float3 mlo = min(low.x, min(low.y, min(low.z, low.w)));
  float3 mhi = max(high.x, max(high.y, max(high.z, high.w)));
  return (mhi - mlo);
}

__device__ __host__ uchar3 to_u8_ceil(float3 f) {
  float f1 = ceilf(f);
  float f2 = fmaxf(0, fminf(f1, (float)255));
  return (uchar3)f2;
}

__device__ __host__ cuda::std::array<uchar3, 4> quantize_bounds_high(cuda::std::array<float3, 4> low, cuda::std::array<float3, 4> high) {
  float3 mlo = min(low.x, min(low.y, min(low.z, low.w)));
  float3 mex = calculate_merged_extent(low, high);
  return cuda::std::array<uchar3, 4>{to_u8_ceil(((high.x - mlo) / mex) * make_float3((float)255)), to_u8_ceil(((high.y - mlo) / mex) * make_float3((float)255)), to_u8_ceil(((high.z - mlo) / mex) * make_float3((float)255)), to_u8_ceil(((high.w - mlo) / mex) * make_float3((float)255))};
}

__device__ __host__ uchar3 to_u8_floor(float3 f) {
  float f1 = floorf(f);
  float f2 = fmaxf(0, fminf(f1, (float)255));
  return (uchar3)f2;
}

