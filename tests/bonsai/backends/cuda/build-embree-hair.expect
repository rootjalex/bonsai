struct AABB {
  float3 low;
  float3 high;
};

struct AABBNode {
  cuda::std::array<BVH*, 4> aabb_children;
  cuda::std::array<float3, 4> aabb_low;
  cuda::std::array<float3, 4> aabb_high;
};

struct AABBs {
  cuda::std::array<float3, 4> aabb_low;
  cuda::std::array<float3, 4> aabb_high;
  ulonglong4 aabb_children;
} __attribute__((packed));

struct FInterval {
  float low;
  float high;
};

struct Triangle {
  float3 p0;
  float3 p1;
  float3 p2;
};

struct Leaf {
  uint8_t nprims;
  cuda::std::array<Triangle, nprims> data;
};

struct OBB {
  float3 obb_low;
  float3 obb_high;
  cuda::std::array<float4, 3> orientation;
};

struct OBBNode {
  cuda::std::array<BVH*, 4> obb_children;
  cuda::std::array<float4, 3> orientation;
  cuda::std::array<float3, 4> obb_low;
  cuda::std::array<float3, 4> obb_high;
};

struct OBBs {
  float3 mlo;
  float3 mex;
  cuda::std::array<uchar3, 4> qlo;
  cuda::std::array<uchar3, 4> qhi;
  cuda::std::array<char4, 3> qorientation;
  ulonglong4 obb_children;
} __attribute__((packed));

struct Point {
  float3 vec;
};

struct Ray {
  float3 o;
  float3 d;
  float tmax = INFINITY;
};

struct Sphere {
  float3 center;
  float radius;
};

struct TriangleIntersection {
  float b0;
  float b1;
  float b2;
  float t;
};

struct triangles {
  uint64_t primitive_count;
  cuda::std::array<Triangle, primitive_count> primitives;
  AABBs* AABBs;
  OBBs* OBBs;
} __attribute__((packed));

