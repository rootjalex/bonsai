  float P3 = dot(ax, p3);
  float Q1 = dot(ax, q1);
  float Q2 = dot(ax, q2);
  float Q3 = dot(ax, q3);
  float mn1 = fminf(fminf(P1, P2), P3);
  float mx2 = fmaxf(fmaxf(Q1, Q2), Q3);
  if (mx2 < mn1) {
    return false;
  }
  float mx1 = fmaxf(fmaxf(P1, P2), P3);
  float mn2 = fminf(fminf(Q1, Q2), Q3);
  if (mx1 < mn2) {
    return false;
  }
  return true;
}

