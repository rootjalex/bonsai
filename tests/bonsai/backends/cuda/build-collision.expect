      uint32_t left_index = rec_build_triangles2(node.left, ST, nodes2_index, primitives_index);
      uint32_t right_index = rec_build_triangles2(node.right, ST, nodes2_index, primitives_index);
      reinterpret_cast<Arm_Interior *>(&(*ST).nodes2[this_index].split0on_nprims)->offset = (right_index - this_index);
      return this_index;
    }
    else if (std::holds_alternative<Leaf>(*node_)) {
      const Leaf& node = std::get<Leaf>(*node_);
      size_t this_index = (*nodes2_index);
