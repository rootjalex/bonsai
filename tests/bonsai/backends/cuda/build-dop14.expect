struct AABB {
  float3 low;
  float3 high;
};

struct DOP14 {
  uint8_t early_exit;
  universal::thrust::vector<float, 7> low;
  universal::thrust::vector<float, 7> high;
};

struct FInterval {
  float low;
  float high;
};

struct Interior {
  universal::thrust::vector<float, 7> lo;
  universal::thrust::vector<float, 7> hi;
  uint8_t ee;
  BVH* left;
  BVH* right;
};

struct Triangle {
  float3 p0;
  float3 p1;
  float3 p2;
};

struct Leaf {
  universal::thrust::vector<float, 7> lo;
  universal::thrust::vector<float, 7> hi;
  uint8_t ee;
  uint8_t leaf_size;
  Triangle* data;
};

struct Point {
  float3 vec;
};

struct Ray {
  float3 o;
  float3 d;
  float tmax = INFINITY;
};

struct Sphere {
  float3 center;
  float radius;
};

struct TriangleIntersection {
  float b0;
  float b1;
  float b2;
  float t;
};

struct arm_Interior {
  uint32_t left;
} __attribute__((packed));

struct arm_Leaf {
  uint8_t leaf_size;
  uint32_t tri_address;
} __attribute__((packed));

struct dop36 {
  float4 lo2;
  float4 hi2;
} __attribute__((packed));

struct nodes {
  float3 lo1;
  float3 hi1;
  uint8_t ee;
  uint8_t is_leaf_flag;
  uint32_t pad0;
  uint32_t right;
  uchar4 split0on_is_leaf_flag;
} __attribute__((packed));

struct triangles {
  uint32_t primitive_count;
  Triangle* primitives;
  uint32_t node_count;
  dop36* dop36;
  nodes* nodes;
} __attribute__((packed));

__device__ __host__ float __prod_diff_f32(float a, float b, float c, float d) {
  float cd = (c * d);
  float diff = fmaf(a, b, -cd);
  float err = fmaf(-c, d, cd);
  return (diff + err);
}

__device__ __host__ FInterval clip(Ray* r, float tmin, float tmax, float3 normal, float d_low, float d_high) {
  float denom = dot((*r).d, normal);
  float t1 = ((d_low - dot((*r).o, normal)) / denom);
  float t2 = ((d_high - dot((*r).o, normal)) / denom);
  float new_tmin = fmaxf(tmin, fminf(t1, t2));
  float new_tmax = fminf(tmax, fmaxf(t1, t2));
  return FInterval{new_tmin, new_tmax};
}

__device__ __host__ std::optional<FInterval> intersectsp_ray_dop14(Ray* r, DOP14* d) {
  float3 invDir = (make_float3(1) / (*r).d);
  bool3 dirIsNeg = (invDir < make_float3(0));
  float3 b_low = float3{(*d).low[0], (*d).low[1], (*d).low[2]};
  float3 b_high = float3{(*d).high[0], (*d).high[1], (*d).high[2]};
  float3 low_parts = make_float3((dirIsNeg.x ? b_high.x : b_low.x),(dirIsNeg.y ? b_high.y : b_low.y),(dirIsNeg.z ? b_high.z : b_low.z));
  float3 high_parts = make_float3((dirIsNeg.x ? b_low.x : b_high.x),(dirIsNeg.y ? b_low.y : b_high.y),(dirIsNeg.z ? b_low.z : b_high.z));
  float3 tMin = ((low_parts - (*r).o) * invDir);
  float3 tMax = ((high_parts - (*r).o) * invDir);
  *tMax *= (1 + ((float)2 * (((float)3 * (float)5.96046e-08) / (1 - ((float)3 * (float)5.96046e-08)))));
  float tmin = fmaxf(tMin.x, fmaxf(tMin.y, tMin.z));
  float tmax = fminf(tMax.x, fminf(tMax.y, tMax.z));
  if (tmax < tmin) {
    return std::optional<FInterval>{};
  }
  if ((*d).early_exit) {
    return (std::optional<FInterval>)FInterval{tmin, tmax};
  }
  FInterval n3 = clip(r, tmin, tmax, make_float3(1, 1, 1), (*d).low[3], (*d).high[3]);
  if (n3.high < n3.low) {
    return std::optional<FInterval>{};
  }
  FInterval n4 = clip(r, n3.low, n3.high, make_float3(1, (float)-1, 1), (*d).low[4], (*d).high[4]);
  if (n4.high < n4.low) {
    return std::optional<FInterval>{};
  }
  FInterval n5 = clip(r, n4.low, n4.high, make_float3(1, 1, (float)-1), (*d).low[5], (*d).high[5]);
  if (n5.high < n5.low) {
    return std::optional<FInterval>{};
  }
  FInterval n6 = clip(r, n5.low, n5.high, make_float3((float)-1, 1, 1), (*d).low[6], (*d).high[6]);
  return (std::optional<FInterval>)n6;
}

__device__ __host__ float distmin_Ray_DOP14(Ray* r, DOP14* b) {
  std::optional<FInterval> interval = intersectsp_ray_dop14(r, b);
  if ((bool)interval) {
    FInterval extract = (FInterval)interval;
    return extract.low;
  }
  return -INFINITY;
}

__device__ __host__ float3 cross_(float3 v0, float3 v1) {
  return float3{__prod_diff_f32(v0.y, v1.z, v0.z, v1.y), __prod_diff_f32(v0.z, v1.x, v0.x, v1.z), __prod_diff_f32(v0.x, v1.y, v0.y, v1.x)};
}

__device__ __host__ std::optional<TriangleIntersection> intersectsp_ray_tri(Ray* ray, Triangle* tri) {
  if (sum((cross_((*tri).p2 - (*tri).p0, (*tri).p1 - (*tri).p0) * cross_((*tri).p2 - (*tri).p0, (*tri).p1 - (*tri).p0))) == 0) {
    return std::optional<TriangleIntersection>{};
  }
  float3 _p0t = ((*tri).p0 - (*ray).o);
  float3* p0t = &_p0t;
  float3 _p1t = ((*tri).p1 - (*ray).o);
  float3* p1t = &_p1t;
  float3 _p2t = ((*tri).p2 - (*ray).o);
  float3* p2t = &_p2t;
  uint32_t kz = idxmax(abs((*ray).d));
  uint32_t kx = ((kz + 1u) % 3u);
  uint32_t ky = ((kx + 1u) % 3u);
  float3 d = shuffle((*ray).d, {kx, ky, kz});
  *p0t = shuffle(p0t, {kx, ky, kz});
  *p1t = shuffle(p1t, {kx, ky, kz});
  *p2t = shuffle(p2t, {kx, ky, kz});
  float Sx = (-d.x / d.z);
  float Sy = (-d.y / d.z);
  float Sz = (1 / d.z);
  *p0t += (Sx * p0t.z);
  *p0t += (Sy * p0t.z);
  *p1t += (Sx * p1t.z);
  *p1t += (Sy * p1t.z);
  *p2t += (Sx * p2t.z);
  *p2t += (Sy * p2t.z);
  float e0 = __prod_diff_f32(p1t.x, p2t.y, p1t.y, p2t.x);
  float e1 = __prod_diff_f32(p2t.x, p0t.y, p2t.y, p0t.x);
  float e2 = __prod_diff_f32(p0t.x, p1t.y, p0t.y, p1t.x);
  if (((e0 < 0) || (e1 < 0)) || (e2 < 0)) {
    if (((0 < e0) || (0 < e1)) || (0 < e2)) {
      return std::optional<TriangleIntersection>{};
    }
  }
  float det = ((e0 + e1) + e2);
  if (det == 0) {
    return std::optional<TriangleIntersection>{};
  }
  *p0t *= Sz;
  *p1t *= Sz;
  *p2t *= Sz;
  float tScaled = (((e0 * p0t.z) + (e1 * p1t.z)) + (e2 * p2t.z));
  if ((det < 0) && ((0 <= tScaled) || (tScaled < ((*ray).tmax * det)))) {
    return std::optional<TriangleIntersection>{};
  } else {
    if ((0 < det) && ((tScaled <= 0) || (((*ray).tmax * det) < tScaled))) {
      return std::optional<TriangleIntersection>{};
    }
  }
  float invDet = (1 / det);
  float b0 = (e0 * invDet);
  float b1 = (e1 * invDet);
  float b2 = (e2 * invDet);
  float t = (tScaled * invDet);
  float maxZt = max(abs(float3{p0t.z, p1t.z, p2t.z}));
  float deltaZ = ((((float)3 * (float)5.96046e-08) / (1 - ((float)3 * (float)5.96046e-08))) * maxZt);
  float maxXt = max(abs(float3{p0t.x, p1t.x, p2t.x}));
  float maxYt = max(abs(float3{p0t.y, p1t.y, p2t.y}));
  float deltaX = ((((float)5 * (float)5.96046e-08) / (1 - ((float)5 * (float)5.96046e-08))) * (maxXt + maxZt));
  float deltaY = ((((float)5 * (float)5.96046e-08) / (1 - ((float)5 * (float)5.96046e-08))) * (maxYt + maxZt));
  float deltaE = ((float)2 * (((((((float)2 * (float)5.96046e-08) / (1 - ((float)2 * (float)5.96046e-08))) * maxXt) * maxYt) + (deltaY * maxXt)) + (deltaX * maxYt)));
  float maxE = max(abs(float3{e0, e1, e2}));
  float deltaT = (((float)3 * (((((((float)3 * (float)5.96046e-08) / (1 - ((float)3 * (float)5.96046e-08))) * maxE) * maxZt) + (deltaE * maxZt)) + (deltaZ * maxE))) * fabsf(invDet));
  if (t <= deltaT) {
    return std::optional<TriangleIntersection>{};
  }
  return (std::optional<TriangleIntersection>)TriangleIntersection{b0, b1, b2, t};
}

__device__ __host__ float distmin_Ray_Triangle(Ray* ray, Triangle* tri) {
  std::optional<TriangleIntersection> isect = intersectsp_ray_tri(ray, tri);
  if ((bool)isect) {
    TriangleIntersection isect_ = (TriangleIntersection)isect;
    return isect_.t;
  } else {
    return INFINITY;
  }
}

__device__ __host__ bool intersects_Ray_DOP14(Ray* r, DOP14* d) {
  std::optional<FInterval> interval = intersectsp_ray_dop14(r, d);
  if ((bool)interval) {
    FInterval extract = (FInterval)interval;
    return ((extract.low < (*r).tmax) & (0 < extract.high));
  }
  return false;
}

__device__ __host__ void _recloop_func0(uint32_t index, triangles* triangles, Ray* ray, std::tuple<float, Triangle>* _best0) {
  DOP14 _lv5 = DOP14{(*triangles).nodes[index].ee, universal::thrust::vector<float, 7>{(*triangles).nodes[index].lo1.x, (*triangles).nodes[index].lo1.y, (*triangles).nodes[index].lo1.z, (*triangles).dop36[index].lo2.x, (*triangles).dop36[index].lo2.y, (*triangles).dop36[index].lo2.z, (*triangles).dop36[index].lo2.w}, universal::thrust::vector<float, 7>{(*triangles).nodes[index].hi1.x, (*triangles).nodes[index].hi1.y, (*triangles).nodes[index].hi1.z, (*triangles).dop36[index].hi2.x, (*triangles).dop36[index].hi2.y, (*triangles).dop36[index].hi2.z, (*triangles).dop36[index].hi2.w}};
  if (intersects_Ray_DOP14(ray, (&_lv5))) {
    DOP14 _lv4 = DOP14{(*triangles).nodes[index].ee, universal::thrust::vector<float, 7>{(*triangles).nodes[index].lo1.x, (*triangles).nodes[index].lo1.y, (*triangles).nodes[index].lo1.z, (*triangles).dop36[index].lo2.x, (*triangles).dop36[index].lo2.y, (*triangles).dop36[index].lo2.z, (*triangles).dop36[index].lo2.w}, universal::thrust::vector<float, 7>{(*triangles).nodes[index].hi1.x, (*triangles).nodes[index].hi1.y, (*triangles).nodes[index].hi1.z, (*triangles).dop36[index].hi2.x, (*triangles).dop36[index].hi2.y, (*triangles).dop36[index].hi2.z, (*triangles).dop36[index].hi2.w}};
    if (distmin_Ray_DOP14(ray, (&_lv4)) < (*_best0)[0]) {
      if ((*triangles).nodes[index].is_leaf_flag == 0u) {
        _recloop_func0(bonsai_reinterpret<arm_Interior>((*triangles).nodes[index].split0on_is_leaf_flag).left, triangles, ray, _best0);
        _recloop_func0((*triangles).nodes[index].right, triangles, ray, _best0);
      } else {
        for (uint32_t _idx0 = bonsai_reinterpret<arm_Leaf>((*triangles).nodes[index].split0on_is_leaf_flag).tri_address; _idx0 < (bonsai_reinterpret<arm_Leaf>((*triangles).nodes[index].split0on_is_leaf_flag).tri_address + (uint32_t)bonsai_reinterpret<arm_Leaf>((*triangles).nodes[index].split0on_is_leaf_flag).leaf_size); _idx0 += 1u) {
          Triangle _lv3 = (*triangles).primitives[_idx0];
          if ((bool)intersectsp_ray_tri(ray, (&_lv3))) {
            Triangle _lv2 = (*triangles).primitives[_idx0];
            if (distmin_Ray_Triangle(ray, (&_lv2)) < (*_best0)[0]) {
              Triangle _lv0 = (*triangles).primitives[_idx0];
              Triangle _lv1 = (*triangles).primitives[_idx0];
              *_best0 = argmin(_best0, std::tuple<float, Triangle>{distmin_Ray_Triangle(ray, (&_lv0)), _lv1});
            }
          }
        }
      }
    }
  }
  return;
}

__device__ __host__ std::optional<Triangle> _traverse_tree0(Ray* ray, triangles* triangles) {
  std::tuple<float, Triangle> __best0 = std::tuple<float, Triangle>{INFINITY, Triangle{}};
  std::tuple<float, Triangle>* _best0 = &__best0;
  _recloop_func0(0u, triangles, ray, (&_best0));
  return ((_best0[0] != INFINITY) ? std::optional<Triangle>{_best0[1]} : std::optional<Triangle>{});
}

__device__ __host__ uint32_t rec_build_triangles(BVH* node, triangles* ST, size_t* nodes_index, size_t* primitives_index) {
  return std::visit(overloaded{
    [&](const Interior& node) {
      size_t this_index = (*nodes_index);
      *nodes_index += 1;
      *ST.nodes[this_index].lo1 = float3{node.lo[0], node.lo[1], node.lo[2]};
      *ST.nodes[this_index].hi1 = float3{node.hi[0], node.hi[1], node.hi[2]};
      *ST.dop36[this_index].lo2 = float4{node.lo[3], node.lo[4], node.lo[5], node.lo[6]};
      *ST.dop36[this_index].hi2 = float4{node.hi[3], node.hi[4], node.hi[5], node.hi[6]};
      *ST.nodes[this_index].ee = false;
      *ST.nodes[this_index].is_leaf_flag = 0;
      uint32_t left_index = rec_build_triangles(node.left, ST, nodes_index, primitives_index);
      *reinterpret_cast<(arm_Interior*)>(ST.nodes[this_index].split0on_is_leaf_flag).left = left_index;
      uint32_t right_index = rec_build_triangles(node.right, ST, nodes_index, primitives_index);
      *ST.nodes[this_index].right = right_index;
      return this_index;
    },
    [&](const Leaf& node) {
      size_t this_index = (*nodes_index);
      *nodes_index += 1;
      *ST.nodes[this_index].is_leaf_flag = 1;
      *ST.nodes[this_index].ee = node.ee;
      *reinterpret_cast<(arm_Leaf*)>(ST.nodes[this_index].split0on_is_leaf_flag).tri_address = (*primitives_index);
      for (uint8_t __p = 0u; __p < node.leaf_size; __p += 1u) {
        *ST.primitives[(__p + (*primitives_index))] = node.data[__p];
      }
      *primitives_index += node.leaf_size;
      return this_index;
    }
  }, *node);
}

__device__ __host__ void rec_count_triangles(BVH* node, triangles* ST) {
  return std::visit(overloaded{
    [&](const Interior& node) {
      rec_count_triangles(node.left, ST);
      rec_count_triangles(node.right, ST);
      *ST += 1u;
    },
    [&](const Leaf& node) {
      *ST += node.leaf_size;
      *ST += 1u;
    }
  }, *node);
}

__host__ triangles build_triangles(BVH* CT) {
  triangles _ST;
  triangles* ST = &_ST;
  size_t _primitives_index = 0;
  size_t* primitives_index = &_primitives_index;
  size_t _nodes_index = 0;
  size_t* nodes_index = &_nodes_index;
  rec_count_triangles(CT, (&ST));
  Triangle* primitives;
  (void)cudaMalloc((void**)&primitives, ST.primitive_count * sizeof(Triangle));
  *ST.primitives = primitives;
  dop36* dop36;
  (void)cudaMalloc((void**)&dop36, ST.node_count * sizeof(dop36));
  *ST.dop36 = dop36;
  nodes* nodes;
  (void)cudaMalloc((void**)&nodes, ST.node_count * sizeof(nodes));
  *ST.nodes = nodes;
  rec_build_triangles(CT, (&ST), (&nodes_index), (&primitives_index));
  return ST;
}

__host__ std::optional<Triangle> trace(Ray* ray, triangles* triangles) {
  return _traverse_tree0(ray, triangles);
}
