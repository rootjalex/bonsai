__host__ float3 dequantize(uint32_t v, float3 bins) {
  uint32_t x_ = ((v >> 20u) & 1023u);
  uint32_t y_ = ((v >> 10u) & 1023u);
  uint32_t z_ = ((v >> 0u) & 1023u);
  return float3{fmul_rd((float)x_, bins.x), fmul_rd((float)y_, bins.y), fmul_rd((float)z_, bins.z)};
}

__host__ bool sat_axis_separates(float3 axis, float3 e, float3 v0, float3 v1, float3 v2) {
  float p0 = dot(axis, v0);
  float p1 = dot(axis, v1);
  float p2 = dot(axis, v2);
  float r = dot(abs(axis), e);
  return ((r < fminf(fminf(p0, p1), p2)) | (fmaxf(fmaxf(p0, p1), p2) < -r));
}

