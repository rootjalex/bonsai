// Bonsai Header
#pragma once

#include <array>
#include <cstdint>

extern "C" {
struct Position {
    int32_t x;
    int32_t y;
};

Position add(const Position& i, const Position& j);
}

------------------------------------------

; LLVM Module
; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"
target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-darwin22.6.0"

%struct.Position = type { i32, i32 }

define %struct.Position @add(ptr noundef nonnull readonly %i, ptr noundef nonnull readonly %j) {
add_entry:
  %0 = load %struct.Position, ptr %i, align 4
  %1 = load %struct.Position, ptr %j, align 4
  %2 = extractvalue %struct.Position %0, 0
  %3 = extractvalue %struct.Position %1, 0
  %4 = add i32 %2, %3
  %5 = extractvalue %struct.Position %0, 1
  %6 = extractvalue %struct.Position %1, 1
  %7 = add i32 %5, %6
  %8 = insertvalue %struct.Position undef, i32 %4, 0
  %9 = insertvalue %struct.Position %8, i32 %7, 1
  ret %struct.Position %9
}
