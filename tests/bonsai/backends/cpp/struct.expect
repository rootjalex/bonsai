// Bonsai Header
#pragma once

#include <array>
#include <cstdint>

extern "C" {
struct Position {
    int32_t x;
    int32_t y;
};

Position add(Position i, Position j);
}

------------------------------------------

; LLVM Module
; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"
target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-darwin22.6.0"

%struct.Position = type { i32, i32 }

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define %struct.Position @add(%struct.Position %i, %struct.Position %j) local_unnamed_addr #0 {
add_entry:
  %0 = extractvalue %struct.Position %i, 0
  %1 = extractvalue %struct.Position %j, 0
  %2 = add i32 %1, %0
  %3 = extractvalue %struct.Position %i, 1
  %4 = extractvalue %struct.Position %j, 1
  %5 = add i32 %4, %3
  %6 = insertvalue %struct.Position undef, i32 %2, 0
  %7 = insertvalue %struct.Position %6, i32 %5, 1
  ret %struct.Position %7
}

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
