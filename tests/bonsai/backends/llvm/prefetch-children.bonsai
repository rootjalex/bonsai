//! flags: -p ssa -b llvm

// The prefetch directive all the way to LLVM: ssa/prefetch-children.bonsai's
// program, the children's gang prefetching each hit child's storage.
//
// What to read for. In the traversal, after the four-wide node test, two
// runs of `llvm.prefetch` -- one for the children that are interior nodes,
// one for the leaves, each over the lanes of its arm's mask
// (CodeGen_LLVM::emit_prefetch): the vector of row addresses, as integers,
// is packed to the front by the mask (`vector.compress`,
// `prefetch_addresses`) and the mask's bits counted (`ctpop`); then a
// chain of blocks, one per lane (`prefetch_lane`), each entered when the
// count exceeds the lane's number, taking that lane's address out at a
// constant index (`prefetch_address`) and fetching its lines --
// `llvm.prefetch(p, 0, 3, 1)`, a read of high locality, at the row and at
// the row plus 64 and 128, the three lines of the 160 bytes the widest arm
// holds. Embree's traversal takes the hit children out of a node the same
// way (bvh_traverser1.h: `vcompress`, a switch on the count), with
// `BVH::prefetch`'s lines for each. On x86 that is one `vpcompressq` in a
// register, then per hit child a compare, an extract and three
// `prefetcht0`; nothing goes through memory. (A loop over the set bits of
// the mask reading each lane's address back from a stack slot waited on
// the slot's 64-byte store for every lane.)
import stdlib/numerics;

element Ray {
    o : vec3f;
    tnear : Float;
    d : vec3f;
    tfar : Float;
}

element Triangle {
    v0 : vec3f;
    e1 : vec3f;
    e2 : vec3f;
    primID : u32;
}

element AABB {
    low, high : vec3f;
}

element FInterval {
    low, high : Float;
}

func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    rdir = 1.0 / r.d;
    org_rdir = r.o * rdir;
    dirIsNeg = rdir < 0.0;
    near = select(dirIsNeg, b.high, b.low);
    far = select(dirIsNeg, b.low, b.high);
    tNearV = near * rdir - org_rdir;
    tFarV = far * rdir - org_rdir;
    tNear = max(max(tNearV.x, tNearV.y), max(tNearV.z, r.tnear));
    tFar = min(min(tFarV.x, tFarV.y), min(tFarV.z, r.tfar));
    if tNear <= tFar {
        return FInterval{tNear, tFar};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

func contains(r : Ray, b : AABB) -> bool = false;

element TriangleHit {
    t, u, v : Float;
}

func intersectsp_ray_tri(r : Ray, tri : Triangle) -> option[TriangleHit] {
    Ng = cross(tri.e2, tri.e1);
    C = tri.v0 - r.o;
    R = cross(C, r.d);
    den = dot(Ng, r.d);
    absDen = abs(den);
    sgnDen = reinterpret[[u32]](den) & 2147483648u;
    U = reinterpret[[Float]](reinterpret[[u32]](dot(R, tri.e2)) ^ sgnDen);
    V = reinterpret[[Float]](reinterpret[[u32]](dot(R, tri.e1)) ^ sgnDen);
    if !(den != 0.0 && U >= 0.0 && V >= 0.0 && U + V <= absDen) {
        return {};
    }
    T = reinterpret[[Float]](reinterpret[[u32]](dot(Ng, C)) ^ sgnDen);
    if !(absDen * r.tnear < T && T <= absDen * r.tfar) {
        return {};
    }
    rcpAbsDen = 1.0 / absDen;
    return TriangleHit{T * rcpAbsDen, U * rcpAbsDen, V * rcpAbsDen};
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](intersectsp_ray_tri(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return -inf;
}

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        indirect group prims[pCount] {
            group[4] {
                v0 : vec3f;
                e1 : vec3f;
                e2 : vec3f;
                primID : u32;
            };
        };
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lower_x : vector[f32, 4];
            upper_x : vector[f32, 4];
            lower_y : vector[f32, 4];
            upper_y : vector[f32, 4];
            lower_z : vector[f32, 4];
            upper_z : vector[f32, 4];
            lo = vector[vec3f, 4]{lower_x, lower_y, lower_z};
            hi = vector[vec3f, 4]{upper_x, upper_y, upper_z};
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, (ref >> 4) * 4u, (kind - 8u) * 4u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(tris.Interior.children)
         .vectorize(tris.Leaf.data)
         .loopify(64);
    trace.prefetch(tris.Interior.children);
}
