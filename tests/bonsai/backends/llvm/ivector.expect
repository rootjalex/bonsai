source_filename = "bonsai_module"

define <2 x half> @"_fma$f16_f16x2"(<2 x half> noundef %a, <2 x half> noundef %b, <2 x half> noundef %c) {
"_fma$f16_f16x2_entry":
  %0 = fmul <2 x half> %a, %b
  %1 = fadd <2 x half> %0, %c
  ret <2 x half> %1
}

