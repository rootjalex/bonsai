  %"@29.i" = getelementptr inbounds nuw [4 x i8], ptr %sums_i_055, i64 %_wide.i
  store i32 %7, ptr %"@29.i", align 4, !tbaa !3
  %"@32.i" = getelementptr inbounds nuw i8, ptr %sums__bits0_054, i64 %_wide.i
  store i8 %29, ptr %"@32.i", align 1, !tbaa !5
  br label %walk.exit

walk.exit:                                        ; preds = %"!then_0.i", %"!merge_1.i"
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, 40
  br i1 %exitcond.not, label %"sums!round.preheader", label %"!par_body_0", !prof !7

sums_gang1_pf_exit:                               ; preds = %"sums!run_yield_sums_gang"
  %30 = add i32 %"sums!round277", 1
  %31 = and i32 %30, 1
  %_wide = zext nneg i32 %31 to i64
  %extract_ptr = getelementptr inbounds nuw [40 x i8], ptr %sums_queue1149, i64 %_wide
