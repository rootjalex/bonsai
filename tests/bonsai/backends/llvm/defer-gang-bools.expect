  call void @llvm.masked.scatter.v16i32.v16p0(<16 x i32> %49, <16 x ptr> align 4 %store_ptrs.i, <16 x i1> %39)
  br label %"!merge_1!any.i"

"!merge_1!any.i":                                 ; preds = %"!then_2.i", %"sums!run"
  %51 = bitcast <16 x i1> %38 to i16
  %.not10.i = icmp eq i16 %51, 0
