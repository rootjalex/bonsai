  %3 = getelementptr inbounds nuw i8, ptr %sums_queue18, i64 16
  %4 = getelementptr inbounds nuw i8, ptr %sums_queue18, i64 24
  %5 = getelementptr inbounds nuw i8, ptr %sums_queue18, i64 32
  br label %"sums!run_step_sums_lane"

"sums!round.preheader":                           ; preds = %walk.exit
  %"@13.count76" = load i32, ptr %sums_queue1149, align 16
  %6 = icmp eq i32 %"@13.count76", 0
  br i1 %6, label %"!par_cont_1", label %"sums!batch"

"!par_body_0":                                    ; preds = %run, %walk.exit
  %indvars.iv = phi i64 [ 0, %run ], [ %indvars.iv.next, %walk.exit ]
  %mulhi_wide = mul nsw i64 %indvars.iv, -1840700269
  %mulhi_high = lshr i64 %mulhi_wide, 32
  %mulhi = trunc nuw i64 %mulhi_high to i32
  %7 = trunc nuw nsw i64 %indvars.iv to i32
  %8 = add i32 %7, %mulhi
  %9 = ashr i32 %8, 2
  %10 = lshr i32 %8, 31
  %11 = add nsw i32 %9, %10
  %.neg = mul i32 %11, -7
  %12 = add i32 %.neg, %7
  %13 = icmp samesign ugt i64 %indvars.iv, 20
  %mulhi_wide14 = mul nuw nsw i64 %indvars.iv, 1717986919
  %sum.shift = lshr i64 %mulhi_wide14, 33
  %14 = trunc nuw nsw i64 %sum.shift to i32
  %.neg58 = mul nsw i32 %14, -5
  %15 = trunc i64 %indvars.iv to i32
  %16 = sub i32 0, %15
  %17 = icmp eq i32 %.neg58, %16
  %18 = icmp slt i32 %12, 1
  br i1 %18, label %"!then_0.i", label %"!merge_1.i"

"!then_0.i":                                      ; preds = %"!par_body_0"
  %19 = trunc i64 %indvars.iv to i1
  %spec.select.i = select i1 %19, i32 100, i32 0
  %20 = add nuw nsw i32 %spec.select.i, 1000
  %r21.i = select i1 %13, i32 %20, i32 %spec.select.i
  %21 = sub nsw i32 0, %r21.i
  %r26.i = select i1 %17, i32 %21, i32 %r21.i
  %out44.i = getelementptr inbounds nuw [4 x i8], ptr %out, i64 %indvars.iv
  store i32 %r26.i, ptr %out44.i, align 4, !tbaa !3
  br label %walk.exit

"!merge_1.i":                                     ; preds = %"!par_body_0"
  %22 = add nsw i32 %12, -1
  %23 = atomicrmw add ptr %sums_queue1149, i32 1 monotonic, align 4
  %24 = trunc i64 %indvars.iv to i8
  %25 = and i8 %24, 1
  %26 = select i1 %13, i8 2, i8 0
  %27 = or disjoint i8 %26, %25
  %28 = select i1 %17, i8 4, i8 0
  %29 = or disjoint i8 %27, %28
  %_wide.i = zext i32 %23 to i64
  %"@23.i" = getelementptr inbounds nuw [4 x i8], ptr %sums_n_057, i64 %_wide.i
