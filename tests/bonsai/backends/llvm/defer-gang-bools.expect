"!then_2.i":                                      ; preds = %"sums!run"
  %41 = and <16 x i8> %extract41, splat (i8 4)
  %.not73 = icmp eq <16 x i8> %41, zeroinitializer
  %42 = and <16 x i8> %extract41, splat (i8 2)
  %.not72 = icmp eq <16 x i8> %42, zeroinitializer
  %43 = trunc <16 x i8> %extract41 to <16 x i1>
  %44 = add <16 x i32> %extract35, splat (i32 100)
  %45 = select <16 x i1> %43, <16 x i32> %44, <16 x i32> %extract35
  %46 = add <16 x i32> %45, splat (i32 1000)
  %47 = select <16 x i1> %.not72, <16 x i32> %45, <16 x i32> %46
  %48 = sub <16 x i32> zeroinitializer, %47
  %49 = select <16 x i1> %.not73, <16 x i32> %47, <16 x i32> %48
  %50 = sext <16 x i32> %extract48 to <16 x i64>
