  store ptr %sums_n_153, ptr %.fca.1.gep65, align 16
  %.fca.2.gep67 = getelementptr inbounds nuw i8, ptr %sums_queue1149, i64 56
  store ptr %sums_acc_152, ptr %.fca.2.gep67, align 8
  %.fca.3.gep69 = getelementptr inbounds nuw i8, ptr %sums_queue1149, i64 64
  store ptr %sums_i_151, ptr %.fca.3.gep69, align 16
  %.fca.4.gep71 = getelementptr inbounds nuw i8, ptr %sums_queue1149, i64 72
