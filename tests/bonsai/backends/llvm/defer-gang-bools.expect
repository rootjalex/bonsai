  %"@75.i" = getelementptr inbounds nuw [4 x i8], ptr %n1.i, i64 %_wide.i60
  call void @llvm.masked.compressstore.v16i32.p0(<16 x i32> %52, ptr align 4 %"@75.i", <16 x i1> %38)
  %acc3.i = load ptr, ptr %3, align 8
  %"@78.i" = getelementptr inbounds nuw [4 x i8], ptr %acc3.i, i64 %_wide.i60
  call void @llvm.masked.compressstore.v16i32.p0(<16 x i32> %53, ptr align 4 %"@78.i", <16 x i1> %38)
  %i6.i = load ptr, ptr %4, align 8
  %"@81.i" = getelementptr inbounds nuw [4 x i8], ptr %i6.i, i64 %_wide.i60
  call void @llvm.masked.compressstore.v16i32.p0(<16 x i32> %extract48, ptr align 4 %"@81.i", <16 x i1> %38)
  %_bits0.i61 = load ptr, ptr %5, align 8
