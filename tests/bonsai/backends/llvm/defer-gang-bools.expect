  %extract_base40 = getelementptr inbounds nuw i8, ptr %extract28.fca.4.load, i64 %sums_gang21_wide
  %extract41 = call <16 x i8> @llvm.masked.load.v16i8.p0(ptr align 1 %extract_base40, <16 x i1> %34, <16 x i8> zeroinitializer)
  %extract_base47 = getelementptr inbounds nuw [4 x i8], ptr %extract28.fca.3.load, i64 %sums_gang21_wide
  %extract48 = call <16 x i32> @llvm.masked.load.v16i32.p0(ptr align 4 %extract_base47, <16 x i1> %34, <16 x i32> zeroinitializer)
  %36 = icmp slt <16 x i32> %extract29, splat (i32 1)
  %37 = xor <16 x i1> %36, splat (i1 true)
  %38 = and <16 x i1> %34, %37
  %39 = and <16 x i1> %34, %36
  %40 = bitcast <16 x i1> %39 to i16
  %.not.i = icmp eq i16 %40, 0
