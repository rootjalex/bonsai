; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define i32 @"?lambda0"(i32 noundef %x) {
"?lambda0_entry":
  %0 = add i32 %x, 1
  ret i32 %0
}

define i32 @bar(i32 noundef %i) {
bar_entry:
  %0 = add i32 %i, 2
  %1 = call i32 @foo(i32 %0)
  ret i32 %1
}

define i32 @foo(i32 noundef %z) {
foo_entry:
  %0 = sub i32 %z, 4
  %1 = call i32 @"?lambda0"(i32 %0)
  ret i32 %1
}
