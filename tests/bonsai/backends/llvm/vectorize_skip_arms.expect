  %25 = fmul float %24, 3.000000e+00
  %26 = fmul float %23, 5.000000e-01
  %27 = fadd float %26, %25
  %28 = fsub float %27, %23
  br label %after_bb10.i

case1_bb.i:                                       ; preds = %next_bb6.i
  %29 = fmul float %x, 5.000000e-01
  %30 = fmul float %29, %x
  %31 = fmul float %30, 2.000000e+00
  %32 = fmul float %29, %29
  %33 = fadd float %32, %31
  %34 = fsub float %33, %x
  br label %after_bb10.i

weigh.exit:                                       ; preds = %then_bb.i, %after_bb10.i
  %common.ret.op.i = phi float [ %16, %after_bb10.i ], [ %4, %then_bb.i ]
  ret float %common.ret.op.i
}

