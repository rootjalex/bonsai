; Function Attrs: mustprogress
define void @weigh_all(ptr noundef %a_buffer, ptr noundef %out_buffer) local_unnamed_addr #0 {
weigh_all:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %0 = fcmp ogt <8 x float> %extract, splat (float 2.000000e+00)
  %1 = xor <8 x i1> %0, splat (i1 true)
  %2 = bitcast <8 x i1> %0 to i8
  %.not.i = icmp eq i8 %2, 0
  br i1 %.not.i, label %"!else_1!any.i", label %"!then_0.i"

"!then_0.i":                                      ; preds = %weigh_all
  %3 = tail call <8 x float> @llvm.sqrt.v8f32(<8 x float> %extract)
  %4 = fmul <8 x float> %3, splat (float 3.000000e+00)
  %5 = fadd <8 x float> %4, splat (float 1.000000e+00)
  %6 = fcmp ule <8 x float> %5, splat (float 7.000000e+00)
  %7 = and <8 x i1> %0, %6
  %8 = bitcast <8 x i1> %7 to i8
  %.not4.i = icmp eq i8 %8, 0
  br i1 %.not4.i, label %"!else_1!any.i", label %"!merge_4.i"

"!merge_4.i":                                     ; preds = %"!then_0.i"
  %9 = fmul <8 x float> %5, %5
  %10 = fsub <8 x float> %9, %extract
  br label %"!else_1!any.i"

"!else_1!any.i":                                  ; preds = %"!merge_4.i", %"!then_0.i", %weigh_all
  %"@61!join.i" = phi <8 x i1> [ zeroinitializer, %weigh_all ], [ %7, %"!then_0.i" ], [ %7, %"!merge_4.i" ]
  %"acc!skip.i" = phi <8 x float> [ undef, %weigh_all ], [ undef, %"!then_0.i" ], [ %10, %"!merge_4.i" ]
  %"!ret!skip.i" = phi <8 x float> [ undef, %weigh_all ], [ %5, %"!then_0.i" ], [ %5, %"!merge_4.i" ]
  %11 = bitcast <8 x i1> %1 to i8
  %.not5.i = icmp eq i8 %11, 0
  br i1 %.not5.i, label %"!merge_2.i", label %"!else_1.i"

"!else_1.i":                                      ; preds = %"!else_1!any.i"
  %12 = fmul <8 x float> %extract, %extract
  %13 = fmul <8 x float> %12, splat (float 5.000000e-01)
  %14 = fadd <8 x float> %13, splat (float 1.000000e+00)
  %15 = fmul <8 x float> %14, %14
  %16 = fmul <8 x float> %14, splat (float 3.000000e+00)
  %17 = fadd <8 x float> %15, %16
  %18 = fadd <8 x float> %17, splat (float -1.000000e+00)
  %19 = select <8 x i1> %0, <8 x float> %"acc!skip.i", <8 x float> %18
  br label %"!merge_2.i"

"!merge_2.i":                                     ; preds = %"!else_1.i", %"!else_1!any.i"
  %"acc!skip0.i" = phi <8 x float> [ %"acc!skip.i", %"!else_1!any.i" ], [ %19, %"!else_1.i" ]
  %20 = or <8 x i1> %"@61!join.i", %1
  %21 = fcmp uge <8 x float> %extract, zeroinitializer
  %22 = and <8 x i1> %21, %20
  %23 = fneg <8 x float> %extract
  %24 = bitcast <8 x i1> %22 to i8
  %.not6.i = icmp eq i8 %24, 0
  br i1 %.not6.i, label %"!merge_7.i", label %"!else_6.i"

"!else_6.i":                                      ; preds = %"!merge_2.i"
  %25 = fcmp uge <8 x float> %extract, splat (float 4.000000e+00)
  %26 = and <8 x i1> %25, %20
  %27 = fmul <8 x float> %extract, splat (float 5.000000e-01)
  %28 = bitcast <8 x i1> %26 to i8
  %.not7.i = icmp eq i8 %28, 0
  br i1 %.not7.i, label %"!merge_10.i", label %"!else_9.i"

"!else_9.i":                                      ; preds = %"!else_6.i"
  %29 = fmul <8 x float> %extract, splat (float 2.500000e-01)
  %30 = select <8 x i1> %26, <8 x i8> splat (i8 2), <8 x i8> splat (i8 1)
  %.v.i = select <8 x i1> %26, <8 x float> %29, <8 x float> %27
  br label %"!merge_10.i"

"!merge_10.i":                                    ; preds = %"!else_9.i", %"!else_6.i"
  %"classify$r6$tag0!skip.i" = phi <8 x i8> [ splat (i8 1), %"!else_6.i" ], [ %30, %"!else_9.i" ]
  %"classify$r6$payload1!skip0.1.in.i" = phi <8 x float> [ %27, %"!else_6.i" ], [ %.v.i, %"!else_9.i" ]
  %31 = select <8 x i1> %22, <8 x i8> %"classify$r6$tag0!skip.i", <8 x i8> zeroinitializer
  %.v8.i = select <8 x i1> %22, <8 x float> %extract, <8 x float> %23
  %32 = select <8 x i1> %22, <8 x float> %"classify$r6$payload1!skip0.1.in.i", <8 x float> zeroinitializer
  br label %"!merge_7.i"

"!merge_7.i":                                     ; preds = %"!merge_10.i", %"!merge_2.i"
  %"classify$r6$tag0!skip0.i" = phi <8 x i8> [ zeroinitializer, %"!merge_2.i" ], [ %31, %"!merge_10.i" ]
  %"classify$r6$payload1!skip2.0.in.i" = phi <8 x float> [ %23, %"!merge_2.i" ], [ %.v8.i, %"!merge_10.i" ]
  %"classify$r6$payload1!skip2.1.i" = phi <8 x float> [ zeroinitializer, %"!merge_2.i" ], [ %32, %"!merge_10.i" ]
  %33 = icmp eq <8 x i8> %"classify$r6$tag0!skip0.i", zeroinitializer
  %34 = and <8 x i1> %20, %33
  %35 = icmp eq <8 x i8> %"classify$r6$tag0!skip0.i", splat (i8 1)
  %36 = and <8 x i1> %20, %35
  %37 = icmp samesign ugt <8 x i8> %"classify$r6$tag0!skip0.i", splat (i8 1)
  %38 = and <8 x i1> %20, %37
  %39 = bitcast <8 x i1> %38 to i8
  %.not9.i = icmp eq i8 %39, 0
  br i1 %.not9.i, label %"!case_13!any.i", label %"!case_14.i"

"!case_14.i":                                     ; preds = %"!merge_7.i"
  %40 = fmul <8 x float> %"classify$r6$payload1!skip2.0.in.i", %"classify$r6$payload1!skip2.0.in.i"
  %41 = fmul <8 x float> %"classify$r6$payload1!skip2.1.i", %"classify$r6$payload1!skip2.1.i"
  %42 = fsub <8 x float> %40, %41
  %43 = fmul <8 x float> %42, splat (float 3.000000e+00)
  %44 = fadd <8 x float> %"classify$r6$payload1!skip2.1.i", %43
  br label %"!case_13!any.i"

"!case_13!any.i":                                 ; preds = %"!case_14.i", %"!merge_7.i"
  %"w!skip.i" = phi <8 x float> [ undef, %"!merge_7.i" ], [ %44, %"!case_14.i" ]
  %45 = bitcast <8 x i1> %36 to i8
  %.not10.i = icmp eq i8 %45, 0
  br i1 %.not10.i, label %"!case_12!any.i", label %"!case_13.i"

"!case_13.i":                                     ; preds = %"!case_13!any.i"
  %46 = fmul <8 x float> %"classify$r6$payload1!skip2.0.in.i", %"classify$r6$payload1!skip2.1.i"
  %47 = fmul <8 x float> %46, splat (float 2.000000e+00)
  %48 = fmul <8 x float> %"classify$r6$payload1!skip2.1.i", %"classify$r6$payload1!skip2.1.i"
  %49 = fadd <8 x float> %48, %47
  %50 = fsub <8 x float> %49, %"classify$r6$payload1!skip2.0.in.i"
  %51 = select <8 x i1> %36, <8 x float> %50, <8 x float> %"w!skip.i"
  br label %"!case_12!any.i"

"!case_12!any.i":                                 ; preds = %"!case_13.i", %"!case_13!any.i"
  %"w!skip0.i" = phi <8 x float> [ %"w!skip.i", %"!case_13!any.i" ], [ %51, %"!case_13.i" ]
  %52 = bitcast <8 x i1> %34 to i8
  %.not11.i = icmp eq i8 %52, 0
  br i1 %.not11.i, label %"weigh$gang8_v0.exit", label %"!case_12.i"

"!case_12.i":                                     ; preds = %"!case_12!any.i"
  %53 = fmul <8 x float> %"classify$r6$payload1!skip2.0.in.i", %"classify$r6$payload1!skip2.0.in.i"
  %54 = fmul <8 x float> %53, splat (float 3.000000e+00)
  %55 = fmul <8 x float> %"classify$r6$payload1!skip2.0.in.i", splat (float 5.000000e-01)
  %56 = fadd <8 x float> %55, %54
  %57 = fsub <8 x float> %56, %"classify$r6$payload1!skip2.0.in.i"
  %58 = select <8 x i1> %34, <8 x float> %57, <8 x float> %"w!skip0.i"
  br label %"weigh$gang8_v0.exit"

"weigh$gang8_v0.exit":                            ; preds = %"!case_12!any.i", %"!case_12.i"
  %"w!skip1.i" = phi <8 x float> [ %"w!skip0.i", %"!case_12!any.i" ], [ %58, %"!case_12.i" ]
  %59 = fadd <8 x float> %"acc!skip0.i", %"w!skip1.i"
  %60 = select <8 x i1> %20, <8 x float> %59, <8 x float> %"!ret!skip.i"
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  store <8 x float> %60, ptr %out, align 4
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define float @weigh_one(float noundef %x) local_unnamed_addr #1 {
weigh_one:
  %0 = fcmp ogt float %x, 2.000000e+00
  br i1 %0, label %"!then_0.i", label %"!else_1.i"

"!then_0.i":                                      ; preds = %weigh_one
  %1 = tail call nnan float @llvm.sqrt.f32(float %x)
  %2 = fmul nnan float %1, 3.000000e+00
  %3 = fadd float %2, 1.000000e+00
  %4 = bitcast float %3 to i32
  %5 = icmp sgt i32 %4, 1088421888
  br i1 %5, label %weigh.exit, label %"!merge_4.i"

"!merge_4.i":                                     ; preds = %"!then_0.i"
  %6 = fmul float %3, %3
  %7 = fsub float %6, %x
  br label %"!merge_2.i"

"!else_1.i":                                      ; preds = %weigh_one
  %8 = fmul float %x, %x
  %9 = fmul float %8, 5.000000e-01
  %10 = fadd float %9, 1.000000e+00
  %11 = fmul float %10, %10
  %12 = fmul float %10, 3.000000e+00
  %13 = fadd float %11, %12
  %14 = fadd float %13, -1.000000e+00
  br label %"!merge_2.i"

"!merge_2.i":                                     ; preds = %"!else_1.i", %"!merge_4.i"
  %acc.i = phi float [ %14, %"!else_1.i" ], [ %7, %"!merge_4.i" ]
  %15 = fcmp olt float %x, 0.000000e+00
  br i1 %15, label %"!case_12.i", label %"!else_6.i"

"!else_6.i":                                      ; preds = %"!merge_2.i"
  %16 = fcmp olt float %x, 4.000000e+00
  br i1 %16, label %"!case_13.i", label %"!case_14.i"

"!case_14.i":                                     ; preds = %"!else_6.i"
  %17 = fmul float %x, 2.500000e-01
  %18 = fmul float %x, %x
  %19 = fmul float %17, %17
  %20 = fsub float %18, %19
  %21 = fmul float %20, 3.000000e+00
  %22 = fadd float %17, %21
  br label %"!merge_11.i"

"!case_13.i":                                     ; preds = %"!else_6.i"
  %23 = fmul nnan float %x, 5.000000e-01
  %24 = fmul nnan float %x, %23
  %25 = fmul nnan float %24, 2.000000e+00
  %26 = fmul float %23, %23
  %27 = fadd float %26, %25
  %28 = fsub float %27, %x
  br label %"!merge_11.i"

"!case_12.i":                                     ; preds = %"!merge_2.i"
  %29 = fmul float %x, %x
  %30 = fmul nnan float %29, 3.000000e+00
  %31 = fmul nnan float %x, 5.000000e-01
  %32 = fsub float %30, %31
  %33 = fadd float %x, %32
  br label %"!merge_11.i"

"!merge_11.i":                                    ; preds = %"!case_12.i", %"!case_13.i", %"!case_14.i"
  %w.i = phi float [ %33, %"!case_12.i" ], [ %28, %"!case_13.i" ], [ %22, %"!case_14.i" ]
  %34 = fadd float %acc.i, %w.i
  br label %weigh.exit

weigh.exit:                                       ; preds = %"!then_0.i", %"!merge_11.i"
  %common.ret.op.i = phi float [ %34, %"!merge_11.i" ], [ %3, %"!then_0.i" ]
  ret float %common.ret.op.i
}

