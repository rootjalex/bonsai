; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define float @first(<3 x float> noundef %v) {
first_entry:
  %0 = extractelement <3 x float> %v, i32 0
  ret float %0
}

define float @idx(<3 x float> noundef %v, i32 noundef %i) {
idx_entry:
  %0 = extractelement <3 x float> %v, i32 %i
  ret float %0
}

define float @safe_idx(<3 x float> noundef %v, i32 noundef %i) {
safe_idx_entry:
  %0 = icmp sle i32 0, %i
  %1 = icmp slt i32 %i, 3
  %2 = and i1 %0, %1
  br i1 %2, label %then_bb, label %next_bb

then_bb:                                          ; preds = %safe_idx_entry
  %3 = extractelement <3 x float> %v, i32 %i
  ret float %3

next_bb:                                          ; preds = %safe_idx_entry
  ret float 0.000000e+00
}

define float @safe_oob(<3 x float> noundef %v) {
safe_oob_entry:
  %0 = call float @safe_idx(<3 x float> %v, i32 4)
  ret float %0
}

define float @second(<3 x float> noundef %v) {
second_entry:
  %0 = extractelement <3 x float> %v, i32 1
  ret float %0
}

define float @third(<3 x float> noundef %v) {
third_entry:
  %0 = extractelement <3 x float> %v, i32 2
  ret float %0
}
