//! flags: -p ssa -b llvm

// ssa/child-volumes-unrolled-two.bonsai all the way to LLVM: a binary node
// that bounds its children, the children loop unrolled, the two sorted and
// put on a stack. What to read for in the traversal: no loop over the
// children and no indexed read of a lane at a run-time index, the two
// boxes each read off their own row, one float compare ordering the two
// children with the selects that swap them, and no `cttz`.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               entry(r, AABB{lo[i], hi[i]}))
         .unroll(tris.Interior.children)
         .loopify(64);
}
