//! flags: -p ssa -b llvm

// ssa/and-of-compares.bonsai through the LLVM backend. What to look for:
// `decided` compares `x` alone against 10 under `c`, no select of `x` and
// `y` left; `at_most` and `below` are one `llvm.umin`/`llvm.smin` and one
// compare where the program wrote two compares and an and; `at_most_f` keeps
// its two float compares (std::min's NaN); `at_most_all` compares the lanes
// against one broadcast of a scalar `llvm.umin.i32`, the min of the two
// bounds taken once rather than in every lane.

func [[export]] decided(c : bool, x : i32, y : i32) -> bool =
    c && (select(c, x, y) < 10);

func [[export]] decided_or(c : bool, x : i32, y : i32) -> bool =
    c || (select(c, x, y) < 10);

func [[export]] at_most(i : u32, n : u32, m : u32) -> bool = i <= n && i <= m;

func [[export]] below(i : i32, n : i32, m : i32) -> bool = n < i || m < i;

func [[export]] at_most_f(t : f32, a : f32, b : f32) -> bool = t <= a && t <= b;

func [[export]] at_most_all(is : array[u32, 8], n : u32, m : u32,
                           out : mut array[u32, 8]) -> void {
    parfor k in 0:8 {
        v = is[k];
        out[k] = select(v <= n && v <= m, 1u, 0u);
    }
    return;
}

schedule {
    at_most_all.vectorize(k);
}
