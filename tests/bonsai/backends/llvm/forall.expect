declare noalias noundef ptr @malloc(i64 noundef) local_unnamed_addr #1

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

attributes #0 = { mustprogress }
attributes #1 = { mustprogress nofree nounwind willreturn allockind("alloc,uninitialized") allocsize(0) memory(inaccessiblemem: readwrite, errnomem: write) "alloc-family"="malloc" }

!0 = !{!1, !1, i64 0}
!1 = !{!"i32", !2, i64 0}
!2 = !{!"bonsai"}
!3 = !{!"branch_weights", i32 0, i32 1}
!4 = !{!"branch_weights", i32 1, i32 127}
!5 = !{!6, !6, i64 0}
!6 = !{!"f32", !2, i64 0}
!7 = distinct !{!7, !8, !9}
!8 = !{!"llvm.loop.isvectorized", i32 1}
!9 = !{!"llvm.loop.unroll.runtime.disable"}
!10 = !{!"branch_weights", i32 1, i32 7}
!11 = !{!"branch_weights", i32 0, i32 1073741824}
!12 = distinct !{!12, !9, !8}
