; Function Attrs: mustprogress
define noalias noundef ptr @doubled(ptr noundef %a_buffer) local_unnamed_addr #0 {
doubled:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %_alloc0_untyped.i = tail call dereferenceable_or_null(16) ptr @malloc(i64 16)
  %0 = load <4 x i32>, ptr %a, align 4
  %1 = shl <4 x i32> %0, splat (i32 1)
  store <4 x i32> %1, ptr %_alloc0_untyped.i, align 4, !tbaa !0
  ret ptr %_alloc0_untyped.i
}

; Function Attrs: mustprogress
define noalias noundef ptr @scale(i32 noundef %n, ptr noundef %a_buffer, float noundef %k) local_unnamed_addr #0 {
scale:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %size64.i = zext i32 %n to i64
  %mallocsize.i = shl nuw nsw i64 %size64.i, 2
  %_alloc1_untyped.i = tail call ptr @malloc(i64 %mallocsize.i)
  %.not.i = icmp eq i32 %n, 0
  br i1 %.not.i, label %_traverse_array1.exit, label %"!par_body_0.i.preheader", !prof !3

"!par_body_0.i.preheader":                        ; preds = %scale
  %min.iters.check = icmp ult i32 %n, 8
  br i1 %min.iters.check, label %"!par_body_0.i.preheader2", label %vector.ph, !prof !4

vector.ph:                                        ; preds = %"!par_body_0.i.preheader"
  %n.vec = and i64 %size64.i, 4294967288
  %broadcast.splatinsert = insertelement <4 x float> poison, float %k, i64 0
  %broadcast.splat = shufflevector <4 x float> %broadcast.splatinsert, <4 x float> poison, <4 x i32> zeroinitializer
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index = phi i64 [ 0, %vector.ph ], [ %index.next, %vector.body ]
  %0 = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %index
  %1 = getelementptr inbounds nuw i8, ptr %0, i64 16
  %wide.load = load <4 x float>, ptr %0, align 4
  %wide.load1 = load <4 x float>, ptr %1, align 4
  %2 = fmul <4 x float> %broadcast.splat, %wide.load
  %3 = fmul <4 x float> %broadcast.splat, %wide.load1
  %4 = getelementptr inbounds nuw [4 x i8], ptr %_alloc1_untyped.i, i64 %index
  %5 = getelementptr inbounds nuw i8, ptr %4, i64 16
  store <4 x float> %2, ptr %4, align 4, !tbaa !5
  store <4 x float> %3, ptr %5, align 4, !tbaa !5
  %index.next = add nuw i64 %index, 8
  %6 = icmp eq i64 %index.next, %n.vec
  br i1 %6, label %middle.block, label %vector.body, !llvm.loop !7

middle.block:                                     ; preds = %vector.body
  %cmp.n = icmp eq i64 %n.vec, %size64.i
  br i1 %cmp.n, label %_traverse_array1.exit, label %"!par_body_0.i.preheader2", !prof !10

"!par_body_0.i.preheader2":                       ; preds = %"!par_body_0.i.preheader", %middle.block
  %indvars.iv.i.ph = phi i64 [ 0, %"!par_body_0.i.preheader" ], [ %n.vec, %middle.block ]
  br label %"!par_body_0.i"

"!par_body_0.i":                                  ; preds = %"!par_body_0.i.preheader2", %"!par_body_0.i"
  %indvars.iv.i = phi i64 [ %indvars.iv.next.i, %"!par_body_0.i" ], [ %indvars.iv.i.ph, %"!par_body_0.i.preheader2" ]
  %extract_ptr.i = getelementptr inbounds nuw [4 x i8], ptr %a, i64 %indvars.iv.i
  %extract.i = load float, ptr %extract_ptr.i, align 4
  %7 = fmul float %k, %extract.i
  %_alloc12.i = getelementptr inbounds nuw [4 x i8], ptr %_alloc1_untyped.i, i64 %indvars.iv.i
  store float %7, ptr %_alloc12.i, align 4, !tbaa !5
  %indvars.iv.next.i = add nuw nsw i64 %indvars.iv.i, 1
  %exitcond.not.i = icmp eq i64 %indvars.iv.next.i, %size64.i
  br i1 %exitcond.not.i, label %_traverse_array1.exit, label %"!par_body_0.i", !prof !11, !llvm.loop !12

_traverse_array1.exit:                            ; preds = %"!par_body_0.i", %middle.block, %scale
  ret ptr %_alloc1_untyped.i
}

