  %5 = zext nneg i32 %2 to i33
  %6 = add nsw i32 %n, -2
  %7 = zext i32 %6 to i33
  %8 = mul i33 %5, %7
  %9 = lshr i33 %8, 1
  %10 = trunc nuw i33 %9 to i32
  %11 = sub i32 %4, %10
