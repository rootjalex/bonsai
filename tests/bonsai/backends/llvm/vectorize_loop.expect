define void @sum_to(i32 noundef %n, i32 noundef %acc, ptr noundef %out_buffer, i32 noundef %i) local_unnamed_addr {
sum_to:
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  %0 = icmp slt i32 %n, 1
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  br i1 %0, label %common.ret, label %"!merge_1"

common.ret:                                       ; preds = %"!merge_1.preheader.i", %"!merge_1", %sum_to
  %acc.tr.lcssa.i.sink = phi i32 [ %acc, %sum_to ], [ %2, %"!merge_1" ], [ %14, %"!merge_1.preheader.i" ]
  %i3_wide.i = sext i32 %i to i64
  %out8.i = getelementptr inbounds [4 x i8], ptr %out, i64 %i3_wide.i
  store i32 %acc.tr.lcssa.i.sink, ptr %out8.i, align 4, !tbaa !0
  ret void

"!merge_1":                                       ; preds = %sum_to
  %1 = add nsw i32 %n, -1
  %2 = add i32 %acc, %n
  %3 = icmp eq i32 %1, 0
  br i1 %3, label %common.ret, label %"!merge_1.preheader.i"

"!merge_1.preheader.i":                           ; preds = %"!merge_1"
  %4 = add i32 %2, %1
  %5 = add nsw i32 %n, -2
  %6 = mul i32 %5, %5
  %7 = add i32 %4, %6
  %8 = zext nneg i32 %5 to i33
  %9 = add nsw i32 %n, -3
  %10 = zext i32 %9 to i33
  %11 = mul i33 %8, %10
  %12 = lshr i33 %11, 1
  %13 = trunc nuw i33 %12 to i32
  %14 = sub i32 %7, %13
  br label %common.ret
}

define void @triangles(ptr noundef %n_buffer, ptr noundef %out_buffer) local_unnamed_addr {
triangles:
  %n = tail call ptr @bonsai_buffer_require(ptr %n_buffer, i32 1)
