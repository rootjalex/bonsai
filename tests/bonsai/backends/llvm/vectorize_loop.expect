"!then_0.i":                                      ; preds = %triangles
  %store_ptrs.i = getelementptr inbounds nuw [4 x i8], ptr %out, <8 x i64> <i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7>
  tail call void @llvm.masked.scatter.v8i32.v8p0(<8 x i32> zeroinitializer, <8 x ptr> align 4 %store_ptrs.i, <8 x i1> %0)
  br label %"!merge_1!any.i"

"!merge_1!any.i":                                 ; preds = %"!then_0.i", %triangles
  %3 = bitcast <8 x i1> %1 to i8
  %.not3.i = icmp eq i8 %3, 0
  br i1 %.not3.i, label %"_unexported_sum_to$gang8_v0_v3$masked.exit", label %"!merge_1.i"

"!merge_1.i":                                     ; preds = %"!merge_1!any.i"
  %store_ptrs.i.i = getelementptr inbounds nuw [4 x i8], ptr %out, <8 x i64> <i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7>
  br label %tailrecurse.i.i

tailrecurse.i.i:                                  ; preds = %"!merge_1!any.i.i", %"!merge_1.i"
  %n.tr.i.in.i = phi <8 x i32> [ %extract, %"!merge_1.i" ], [ %n.tr.i.i, %"!merge_1!any.i.i" ]
  %acc.tr.i.i = phi <8 x i32> [ %extract, %"!merge_1.i" ], [ %10, %"!merge_1!any.i.i" ]
  %"!mask.tr.i.i" = phi <8 x i1> [ %1, %"!merge_1.i" ], [ %6, %"!merge_1!any.i.i" ]
  %n.tr.i.i = add <8 x i32> %n.tr.i.in.i, splat (i32 -1)
  %4 = icmp slt <8 x i32> %n.tr.i.i, splat (i32 1)
  %5 = xor <8 x i1> %4, splat (i1 true)
  %6 = and <8 x i1> %"!mask.tr.i.i", %5
  %7 = and <8 x i1> %4, %"!mask.tr.i.i"
  %8 = bitcast <8 x i1> %7 to i8
  %.not.i.i = icmp eq i8 %8, 0
  br i1 %.not.i.i, label %"!merge_1!any.i.i", label %"!then_0.i.i"

"!then_0.i.i":                                    ; preds = %tailrecurse.i.i
  tail call void @llvm.masked.scatter.v8i32.v8p0(<8 x i32> %acc.tr.i.i, <8 x ptr> align 4 %store_ptrs.i.i, <8 x i1> %7)
  br label %"!merge_1!any.i.i"

"!merge_1!any.i.i":                               ; preds = %"!then_0.i.i", %tailrecurse.i.i
  %9 = bitcast <8 x i1> %6 to i8
  %.not1.i.i = icmp eq i8 %9, 0
  %10 = add <8 x i32> %acc.tr.i.i, %n.tr.i.i
