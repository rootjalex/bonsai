  %59 = and i32 %58, 1
  %_wide = zext nneg i32 %59 to i64
  %extract_ptr46 = getelementptr inbounds nuw [32 x i8], ptr %q_queue3184, i64 %_wide
  %"@23.count" = load i32, ptr %extract_ptr46, align 16
  %60 = icmp eq i32 %"@23.count", 0
  br i1 %60, label %q_rest, label %"q!batch"
}

