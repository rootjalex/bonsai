//! flags: -p ssa -b llvm

// The float zero rules the simplifier leaves alone under the default exact
// arithmetic (opt/float-zero-folds.bonsai), all the way to LLVM: the
// multiply by zero, the adds of zero and the subtraction from zero are
// emitted as written, with no fast-math flags for LLVM to fold them by;
// `x - 0.0` has folded to `x`; and a negation is `fneg`, not a subtraction
// from `+0.0`, which would be `+0.0` at `x = +0.0`.
func [[export]] negate(x : f32) -> f32 = -x;
func [[export]] times_zero(x : f32) -> f32 = x * 0.0;
func [[export]] zero_plus(x : f32) -> f32 = 0.0 + x;
func [[export]] plus_zero(x : f32) -> f32 = x + 0.0;
func [[export]] zero_minus(x : f32) -> f32 = 0.0 - x;
func [[export]] minus_zero(x : f32) -> f32 = x - 0.0;
func [[export]] negative_zero() -> f32 = -0.0;
