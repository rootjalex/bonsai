  %30 = add i32 %29, 5367177
  %31 = mul i32 %30, %28
  %32 = add i32 %31, 6517565
  %33 = and i32 %32, 8388607
  %34 = or disjoint i32 %33, 1065353216
  %35 = bitcast i32 %34 to float
