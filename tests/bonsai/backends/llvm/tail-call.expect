then_bb:                                          ; preds = %tailrecurse.then_bb_crit_edge, %sample1_entry
  %e.tr.lcssa = phi %struct.Example [ %3, %tailrecurse.then_bb_crit_edge ], [ %e, %sample1_entry ]
  %e.value = extractvalue %struct.Example %e.tr.lcssa, 0
  br label %common.ret

next_bb:                                          ; preds = %next_bb.lr.ph, %then_bb6
  %4 = phi <4 x i32> [ %_rng_state.promoted, %next_bb.lr.ph ], [ %29, %then_bb6 ]
  %e.depth22 = phi i32 [ %e.depth20, %next_bb.lr.ph ], [ %40, %then_bb6 ]
  %e.tr21 = phi <3 x float> [ %1, %next_bb.lr.ph ], [ %39, %then_bb6 ]
  %5 = add <4 x i32> %4, <i32 4, i32 8, i32 12, i32 16>
  %6 = extractelement <4 x i32> %4, i64 0
  %7 = mul i32 %6, 609248
  %8 = add i32 %7, 5367177
