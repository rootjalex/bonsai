next_bb:                                          ; preds = %next_bb.lr.ph, %then_bb8
  %depth31 = phi i32 [ %depth29, %next_bb.lr.ph ], [ %38, %then_bb8 ]
  %deref_temp30 = phi <3 x float> [ %5, %next_bb.lr.ph ], [ %37, %then_bb8 ]
