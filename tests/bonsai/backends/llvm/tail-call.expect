%struct.Example = type { <3 x float>, i32 }

define <3 x float> @sample(<3 x float> noundef %a, i32 noundef %depth) local_unnamed_addr {
sample_entry:
  %0 = tail call i32 @rand()
  %1 = tail call i32 @rand()
  %2 = tail call i32 @rand()
  %3 = tail call i32 @rand()
  %4 = icmp slt i32 %depth, 0
  br i1 %4, label %common.ret, label %next_bb

common.ret:                                       ; preds = %next_bb, %sample_entry
  %a.tr.lcssa = phi <3 x float> [ %a, %sample_entry ], [ %14, %next_bb ]
  ret <3 x float> %a.tr.lcssa

next_bb:                                          ; preds = %sample_entry, %next_bb
  %5 = phi i32 [ %16, %next_bb ], [ %0, %sample_entry ]
  %depth.tr2 = phi i32 [ %15, %next_bb ], [ %depth, %sample_entry ]
  %a.tr1 = phi <3 x float> [ %14, %next_bb ], [ %a, %sample_entry ]
  %6 = mul i32 %5, 609248
  %7 = add i32 %6, 5367177
  %8 = mul i32 %7, %5
  %9 = add i32 %8, 6517565
  %10 = and i32 %9, 8388607
  %11 = or disjoint i32 %10, 1065353216
  %12 = bitcast i32 %11 to float
  %13 = fadd float %12, -1.000000e+00
  %.splatinsert = insertelement <3 x float> poison, float %13, i64 0
  %.splat = shufflevector <3 x float> %.splatinsert, <3 x float> poison, <3 x i32> zeroinitializer
  %14 = fmul <3 x float> %a.tr1, %.splat
  %15 = add nsw i32 %depth.tr2, -1
  %16 = tail call i32 @rand()
  %17 = tail call i32 @rand()
  %18 = tail call i32 @rand()
  %19 = tail call i32 @rand()
  %20 = icmp eq i32 %depth.tr2, 0
  br i1 %20, label %common.ret, label %next_bb
}

define <3 x float> @sample1(ptr noundef nonnull readonly captures(none) %e) local_unnamed_addr {
