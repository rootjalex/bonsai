common.ret.loopexit:                              ; preds = %then_bb2
  store <4 x i32> %17, ptr %_rng_state, align 16
  br label %common.ret

common.ret:                                       ; preds = %common.ret.loopexit, %next_bb3, %then_bb
  %common.ret.op = phi <3 x float> [ %e.value, %then_bb ], [ %28, %next_bb3 ], [ zeroinitializer, %common.ret.loopexit ]
  ret <3 x float> %common.ret.op

tailrecurse.then_bb_crit_edge:                    ; preds = %then_bb6
  %2 = insertvalue %struct.Example undef, <3 x float> %39, 0
  %3 = insertvalue %struct.Example %2, i32 0, 1
  store <4 x i32> %29, ptr %_rng_state, align 16
