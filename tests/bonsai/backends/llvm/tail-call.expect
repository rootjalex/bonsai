  %9 = mul i32 %8, %6
  %10 = add i32 %9, 6517565
  %11 = and i32 %10, 8388607
  %12 = or disjoint i32 %11, 1065353216
  %13 = bitcast i32 %12 to float
  %14 = fadd float %13, -1.000000e+00
  %15 = tail call float @llvm.vector.reduce.fadd.v3f32(float 0.000000e+00, <3 x float> %deref_temp30)
  %16 = fcmp olt float %14, %15
  br i1 %16, label %then_bb3, label %next_bb4

then_bb3:                                         ; preds = %next_bb
  %17 = add i32 %6, 4
  %18 = mul i32 %17, 609248
