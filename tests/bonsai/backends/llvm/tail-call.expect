; Function Attrs: nofree norecurse nosync nounwind memory(argmem: readwrite)
define <3 x float> @sample1(%struct.Example noundef %e, ptr nocapture noundef nonnull %_rng_state) local_unnamed_addr #0 {
sample1_entry:
  %e.depth20 = extractvalue %struct.Example %e, 1
  %0 = icmp slt i32 %e.depth20, 1
  br i1 %0, label %then_bb, label %next_bb.lr.ph

next_bb.lr.ph:                                    ; preds = %sample1_entry
  %_rng_state.promoted = load <4 x i32>, ptr %_rng_state, align 16
  %1 = extractvalue %struct.Example %e, 0
