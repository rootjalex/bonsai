%struct.Example = type { <3 x float>, i32 }

; Function Attrs: nofree norecurse nosync nounwind memory(argmem: readwrite)
define <3 x float> @sample(<3 x float> noundef %a, i32 noundef %depth, ptr nocapture noundef nonnull %_rng_state) local_unnamed_addr #0 {
sample_entry:
  %0 = icmp slt i32 %depth, 0
  br i1 %0, label %common.ret, label %next_bb.lr.ph

next_bb.lr.ph:                                    ; preds = %sample_entry
  %_rng_state.promoted = load <4 x i32>, ptr %_rng_state, align 16
  %1 = and i32 %depth, 1
  %lcmp.mod.not.not = icmp eq i32 %1, 0
  br i1 %lcmp.mod.not.not, label %next_bb.prol, label %next_bb.prol.loopexit

next_bb.prol:                                     ; preds = %next_bb.lr.ph
  %2 = add <4 x i32> %_rng_state.promoted, <i32 4, i32 8, i32 12, i32 16>
  %3 = extractelement <4 x i32> %_rng_state.promoted, i64 0
  %4 = mul i32 %3, 609248
  %5 = add i32 %4, 5367177
  %6 = mul i32 %5, %3
  %7 = add i32 %6, 6517565
  %8 = and i32 %7, 8388607
  %9 = or disjoint i32 %8, 1065353216
  %10 = bitcast i32 %9 to float
  %11 = fadd float %10, -1.000000e+00
  %.splatinsert.prol = insertelement <3 x float> poison, float %11, i64 0
  %.splat.prol = shufflevector <3 x float> %.splatinsert.prol, <3 x float> poison, <3 x i32> zeroinitializer
  %12 = fmul <3 x float> %.splat.prol, %a
  %13 = add nsw i32 %depth, -1
  br label %next_bb.prol.loopexit

next_bb.prol.loopexit:                            ; preds = %next_bb.prol, %next_bb.lr.ph
  %.lcssa6.unr = phi <4 x i32> [ poison, %next_bb.lr.ph ], [ %2, %next_bb.prol ]
  %.lcssa.unr = phi <3 x float> [ poison, %next_bb.lr.ph ], [ %12, %next_bb.prol ]
  %.unr = phi <4 x i32> [ %_rng_state.promoted, %next_bb.lr.ph ], [ %2, %next_bb.prol ]
  %depth.tr2.unr = phi i32 [ %depth, %next_bb.lr.ph ], [ %13, %next_bb.prol ]
  %a.tr1.unr = phi <3 x float> [ %a, %next_bb.lr.ph ], [ %12, %next_bb.prol ]
  %14 = icmp eq i32 %depth, 0
  br i1 %14, label %tailrecurse.common.ret_crit_edge, label %next_bb

tailrecurse.common.ret_crit_edge:                 ; preds = %next_bb, %next_bb.prol.loopexit
  %.lcssa6 = phi <4 x i32> [ %.lcssa6.unr, %next_bb.prol.loopexit ], [ %26, %next_bb ]
  %.lcssa = phi <3 x float> [ %.lcssa.unr, %next_bb.prol.loopexit ], [ %37, %next_bb ]
  store <4 x i32> %.lcssa6, ptr %_rng_state, align 16
  br label %common.ret

common.ret:                                       ; preds = %tailrecurse.common.ret_crit_edge, %sample_entry
  %a.tr.lcssa = phi <3 x float> [ %.lcssa, %tailrecurse.common.ret_crit_edge ], [ %a, %sample_entry ]
  ret <3 x float> %a.tr.lcssa

next_bb:                                          ; preds = %next_bb.prol.loopexit, %next_bb
  %15 = phi <4 x i32> [ %26, %next_bb ], [ %.unr, %next_bb.prol.loopexit ]
  %depth.tr2 = phi i32 [ %38, %next_bb ], [ %depth.tr2.unr, %next_bb.prol.loopexit ]
  %a.tr1 = phi <3 x float> [ %37, %next_bb ], [ %a.tr1.unr, %next_bb.prol.loopexit ]
  %16 = extractelement <4 x i32> %15, i64 0
  %17 = mul i32 %16, 609248
  %18 = add i32 %17, 5367177
  %19 = mul i32 %18, %16
  %20 = add i32 %19, 6517565
  %21 = and i32 %20, 8388607
  %22 = or disjoint i32 %21, 1065353216
  %23 = bitcast i32 %22 to float
  %24 = fadd float %23, -1.000000e+00
  %.splatinsert = insertelement <3 x float> poison, float %24, i64 0
  %.splat = shufflevector <3 x float> %.splatinsert, <3 x float> poison, <3 x i32> zeroinitializer
  %25 = fmul <3 x float> %a.tr1, %.splat
  %26 = add <4 x i32> %15, <i32 8, i32 16, i32 24, i32 32>
  %27 = extractelement <4 x i32> %15, i64 0
  %28 = add i32 %27, 4
  %29 = mul i32 %28, 609248
  %30 = add i32 %29, 5367177
  %31 = mul i32 %30, %28
  %32 = add i32 %31, 6517565
  %33 = and i32 %32, 8388607
  %34 = or disjoint i32 %33, 1065353216
  %35 = bitcast i32 %34 to float
  %36 = fadd float %35, -1.000000e+00
  %.splatinsert.1 = insertelement <3 x float> poison, float %36, i64 0
  %.splat.1 = shufflevector <3 x float> %.splatinsert.1, <3 x float> poison, <3 x i32> zeroinitializer
  %37 = fmul <3 x float> %25, %.splat.1
  %38 = add nsw i32 %depth.tr2, -2
  %39 = icmp eq i32 %depth.tr2, 1
  br i1 %39, label %tailrecurse.common.ret_crit_edge, label %next_bb
