next_bb4:                                         ; preds = %next_bb
  %.splatinsert17 = insertelement <3 x float> poison, float %14, i64 0
  %.splat18 = shufflevector <3 x float> %.splatinsert17, <3 x float> poison, <3 x i32> zeroinitializer
  %27 = fmul <3 x float> %deref_temp30, %.splat18
