  %16 = fcmp olt float %14, %15
  br i1 %16, label %then_bb2, label %next_bb3

then_bb2:                                         ; preds = %next_bb
  %17 = add <4 x i32> %4, <i32 8, i32 16, i32 24, i32 32>
  %18 = extractelement <4 x i32> %5, i64 0
  %19 = mul i32 %18, 609248
  %20 = add i32 %19, 5367177
  %21 = mul i32 %20, %18
  %22 = add i32 %21, 6517565
  %23 = and i32 %22, 8388607
  %24 = or disjoint i32 %23, 1065353216
  %25 = bitcast i32 %24 to float
  %26 = fadd float %25, -1.000000e+00
  %27 = fcmp olt float %15, %26
  br i1 %27, label %then_bb6, label %common.ret.loopexit

next_bb3:                                         ; preds = %next_bb
  store <4 x i32> %5, ptr %_rng_state, align 16
  %.splatinsert12 = insertelement <3 x float> poison, float %14, i64 0
  %.splat13 = shufflevector <3 x float> %.splatinsert12, <3 x float> poison, <3 x i32> zeroinitializer
  %28 = fmul <3 x float> %e.tr21, %.splat13
