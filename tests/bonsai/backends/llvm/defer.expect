; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

%struct.Queue_sums = type { i32, ptr, ptr, ptr }

; Function Attrs: mustprogress noinline norecurse nounwind willreturn memory(write, argmem: readwrite, inaccessiblemem: none, target_mem: none)
define internal fastcc void @fill(i32 noundef %n, i32 noundef %acc, ptr nofree noundef writeonly captures(none) %out, i32 noundef %i, ptr nofree noundef nonnull captures(none) %_queue_sums) unnamed_addr #0 {
fill:
  %0 = icmp slt i32 %n, 1
  br i1 %0, label %"!then_0", label %"!merge_1"

common.ret:                                       ; preds = %"!merge_1", %"!then_0"
  ret void

"!then_0":                                        ; preds = %fill
  %1 = sext i32 %i to i64
  %out14 = getelementptr inbounds [4 x i8], ptr %out, i64 %1
  store i32 %acc, ptr %out14, align 4, !tbaa !0
  br label %common.ret

"!merge_1":                                       ; preds = %fill
  %2 = add nsw i32 %n, -1
  %3 = add i32 %acc, %n
  %4 = atomicrmw add ptr %_queue_sums, i32 1 monotonic, align 4
  %5 = getelementptr inbounds nuw i8, ptr %_queue_sums, i64 8
  %n9 = load ptr, ptr %5, align 8
  %6 = sext i32 %4 to i64
  %"@9" = getelementptr inbounds [4 x i8], ptr %n9, i64 %6
  store i32 %2, ptr %"@9", align 4, !tbaa !0
  %7 = getelementptr inbounds nuw i8, ptr %_queue_sums, i64 16
  %acc11 = load ptr, ptr %7, align 8
  %"@12" = getelementptr inbounds [4 x i8], ptr %acc11, i64 %6
  store i32 %3, ptr %"@12", align 4, !tbaa !0
  %8 = getelementptr inbounds nuw i8, ptr %_queue_sums, i64 24
  %i13 = load ptr, ptr %8, align 8
  %"@15" = getelementptr inbounds [4 x i8], ptr %i13, i64 %6
  store i32 %i, ptr %"@15", align 4, !tbaa !0
  br label %common.ret
}

define void @run(ptr noundef %out_buffer) local_unnamed_addr {
run:
  %sums_queue1129 = alloca [2 x %struct.Queue_sums], align 16
  %sums_i_130 = alloca [8 x i32], align 4
  %sums_acc_131 = alloca [8 x i32], align 4
  %sums_n_132 = alloca [8 x i32], align 4
