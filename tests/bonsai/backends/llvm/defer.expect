  call fastcc void @fill(i32 5, i32 0, ptr %out, i32 5, ptr %sums_queue1129)
  call fastcc void @fill(i32 6, i32 0, ptr %out, i32 6, ptr %sums_queue1129)
  call fastcc void @fill(i32 7, i32 0, ptr %out, i32 7, ptr %sums_queue1129)
  %"@7.count46" = load i32, ptr %sums_queue1129, align 16
  %0 = icmp eq i32 %"@7.count46", 0
  br i1 %0, label %"!par_cont_1", label %"sums!batch"

"!par_cont_1":                                    ; preds = %sums1_pf_exit, %run
  ret void

"sums!batch":                                     ; preds = %run, %sums1_pf_exit
  %"@7.count49" = phi i32 [ %"@7.count", %sums1_pf_exit ], [ %"@7.count46", %run ]
  %extract_ptr48 = phi ptr [ %extract_ptr, %sums1_pf_exit ], [ %sums_queue1129, %run ]
  %1 = phi i32 [ %7, %sums1_pf_exit ], [ 0, %run ]
  %"sums!round247" = phi i32 [ %6, %sums1_pf_exit ], [ 0, %run ]
  %2 = xor i32 %1, 1
  %3 = zext nneg i32 %2 to i64
  %sums_queue14 = getelementptr inbounds nuw [32 x i8], ptr %sums_queue1129, i64 %3
  store i32 0, ptr %sums_queue14, align 16, !tbaa !3
  %extract17.fca.1.gep = getelementptr inbounds nuw i8, ptr %extract_ptr48, i64 8
  %extract17.fca.2.gep = getelementptr inbounds nuw i8, ptr %extract_ptr48, i64 16
  %extract17.fca.3.gep = getelementptr inbounds nuw i8, ptr %extract_ptr48, i64 24
  br label %"sums!run"

"sums!run":                                       ; preds = %"sums!batch", %"sums!run"
  %sums45 = phi i32 [ 0, %"sums!batch" ], [ %5, %"sums!run" ]
  %extract17.fca.1.load = load ptr, ptr %extract17.fca.1.gep, align 8
  %extract17.fca.2.load = load ptr, ptr %extract17.fca.2.gep, align 8
  %extract17.fca.3.load = load ptr, ptr %extract17.fca.3.gep, align 8
  %4 = sext i32 %sums45 to i64
  %extract_ptr18 = getelementptr inbounds [4 x i8], ptr %extract17.fca.1.load, i64 %4
  %extract19 = load i32, ptr %extract_ptr18, align 4
  %extract_ptr22 = getelementptr inbounds [4 x i8], ptr %extract17.fca.2.load, i64 %4
  %extract23 = load i32, ptr %extract_ptr22, align 4
  %extract_ptr27 = getelementptr inbounds [4 x i8], ptr %extract17.fca.3.load, i64 %4
  %extract28 = load i32, ptr %extract_ptr27, align 4
  call fastcc void @fill(i32 %extract19, i32 %extract23, ptr %out, i32 %extract28, ptr %sums_queue14)
  %5 = add nuw i32 %sums45, 1
  %exitcond.not = icmp eq i32 %5, %"@7.count49"
  br i1 %exitcond.not, label %sums1_pf_exit, label %"sums!run", !prof !5

sums1_pf_exit:                                    ; preds = %"sums!run"
  %6 = add i32 %"sums!round247", 1
  %7 = and i32 %6, 1
  %8 = zext nneg i32 %7 to i64
  %extract_ptr = getelementptr inbounds nuw [32 x i8], ptr %sums_queue1129, i64 %8
  %"@7.count" = load i32, ptr %extract_ptr, align 16
  %9 = icmp eq i32 %"@7.count", 0
