  %.fca.3.gep = getelementptr inbounds nuw i8, ptr %sums_queue1129, i64 24
  store ptr %sums_i_033, ptr %.fca.3.gep, align 8
  %sums_queue13 = getelementptr inbounds nuw i8, ptr %sums_queue1129, i64 32
  store i32 0, ptr %sums_queue13, align 16
  %.fca.1.gep39 = getelementptr inbounds nuw i8, ptr %sums_queue1129, i64 40
  store ptr %sums_n_132, ptr %.fca.1.gep39, align 8
  %.fca.2.gep41 = getelementptr inbounds nuw i8, ptr %sums_queue1129, i64 48
  store ptr %sums_acc_131, ptr %.fca.2.gep41, align 16
  %.fca.3.gep43 = getelementptr inbounds nuw i8, ptr %sums_queue1129, i64 56
  store ptr %sums_i_130, ptr %.fca.3.gep43, align 8
  call fastcc void @fill(i32 0, i32 0, ptr %out, i32 0, ptr %sums_queue1129)
  call fastcc void @fill(i32 1, i32 0, ptr %out, i32 1, ptr %sums_queue1129)
  call fastcc void @fill(i32 2, i32 0, ptr %out, i32 2, ptr %sums_queue1129)
