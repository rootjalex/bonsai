//! flags: -b llvm

// A binary node that bounds its children, sorted and put on a stack: FCPW's
// scalar BVH traversal (bvh.inl, processSubtreeForClosestPoint: test both
// children, tighten by their far corners, push the farther and descend into
// the nearer) as a tree declaration and two directives, and the smallest
// mask a children's loop makes. child-volumes-sorted is the four-wide case
// and says what the sort does with the lanes; this is what the two lanes
// are held as.
//
// The children's tests, one per iteration of the scalar children's loop,
// are the two bits of one word (SSA/PackBoolArrays.h): `_mask0 : mut u32`,
// cleared where it is made, each child's test cast to the word, shifted to
// the child's bit and or'ed in over the bit cleared --
//
//     _mask0 = ((*_mask0) & ~(1u << children)) | (cast<u32>(test) << children)
//
// -- and the word read back for the sort as the two-lane mask,
// `reinterpret_cast<boolx2>(cast<u2>(*_mask0))`, which the sort's peel
// turns straight back into the word (`reinterpret_cast<u2>`, then widened
// and `ctz`, SSA/MaskLanes.h) and the backend folds to nothing. Before
// this the loop stored each test as a byte of a two-byte array and the
// sort loaded both bytes as one word, which the store buffer cannot
// forward -- a stall of ten cycles and more at every interior node -- and
// a two-lane mask had no word: its lowest lane was the least index of a
// select over the lane ramp.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

// The distance at which the ray enters a box, and infinity where it misses:
// a sort key that puts the child the ray misses last.
func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    // Nearer child first, by the distance at which the ray enters its box.
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
}
