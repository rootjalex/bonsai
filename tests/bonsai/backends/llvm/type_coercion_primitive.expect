; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define i32 @a(i32 noundef %x) {
a_entry:
  %0 = add i32 %x, 5
  ret i32 %0
}

define double @b(double noundef %x) {
b_entry:
  %0 = fadd double %x, 3.000000e+00
  ret double %0
}

define double @c(double noundef %x) {
c_entry:
  %0 = fadd double %x, 3.000000e+00
  ret double %0
}

define half @d(half noundef %x) {
d_entry:
  %0 = fadd half %x, 0xH4200
  ret half %0
}

define <4 x float> @ret_f32x4(<4 x float> noundef %x) {
ret_f32x4_entry:
  %0 = fadd <4 x float> %x, <float 2.000000e+00, float 2.000000e+00, float 2.000000e+00, float 2.000000e+00>
  ret <4 x float> %0
}

define float @ret_fone() {
ret_fone_entry:
  ret float 1.000000e+00
}

define float @ret_fzero() {
ret_fzero_entry:
  ret float 0.000000e+00
}

define i32 @ret_zero() {
ret_zero_entry:
  ret i32 0
}

define i32 @reti32(i32 noundef %i) {
reti32_entry:
  %0 = add i32 %i, 2
  ret i32 %0
}
