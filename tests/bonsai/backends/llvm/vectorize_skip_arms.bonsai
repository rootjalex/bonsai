//! flags: -p ssa -b llvm

// Golden-diffs the LLVM IR for the arms a gang skips: the same program as
// ssa/vectorize-skip-arms.bonsai, after LLVM has had it.
//
// What to read for: one `br i1` on an or-reduction of the arm's mask per arm
// of the `if` and of the `match`, and at each landing a `phi` merging the
// arm's blend with what the bypass hands on -- the value from before the arm,
// or `false` for a mask, or a zero for a value with nothing before it. No arm
// computes anything unless some lane is in it.
import stdlib/numerics;

element Shape =
    | Disc(r : f32)
    | Box(w : f32, h : f32)
    | Ring(ro : f32, ri : f32);

func classify(x : f32) -> Shape {
    if x < 0.0 {
        return Disc(-x);
    }
    if x < 4.0 {
        return Box(x, x * 0.5);
    }
    return Ring(x, x * 0.25);
}

func weigh(x : f32) -> f32 {
    acc : mut = 0.0;
    if x > 2.0 {
        t = sqrt(x) * 3.0 + 1.0;
        if t > 7.0 {
            return t;
        }
        acc = t * t - x;
    } else {
        u = x * x * 0.5 + 1.0;
        acc = u * u + u * 3.0 - 1.0;
    }
    s = classify(x);
    w : mut = 0.0;
    match s {
        Disc(r) => w = r * r * 3.0 + r * 0.5 - r;
        Box(wd, h) => w = wd * h * 2.0 + h * h - wd;
        Ring(ro, ri) => w = (ro * ro - ri * ri) * 3.0 + ri;
    }
    return acc + w;
}

func [[export]] weigh_one(x : f32) -> f32 {
    return weigh(x);
}

func [[export]] weigh_all(a : array[f32, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = weigh(a[i]);
    }
    return;
}

schedule {
    weigh_all.vectorize(i);
}
