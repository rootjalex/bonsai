//! flags: -p ssa -b llvm

// The instanced traversal with the ray pulled back, compiled end to end.
//
// tree-traversal-nested.bonsai has a tree inside a tree and no motion, so it
// pins the two stacks. This one has the motion -- an instance places its
// triangles with a `Transform` -- and pins what `pull-queries`
// (Opt/PullQueries.h) makes of it.
//
// No `loopify()` here, on purpose. Loopified, both walks are inlined into
// `_traverse_tree0` and the thing to read is spread across one function; left
// as recursions they stay functions of their own, and the walk over one
// instance's tree is `_recloop_func1`, whose signature is the evidence:
//
//   - it takes `%struct.Ray noundef %_pulled0` and not the world-space ray.
//     The ray arrives already in the instance's frame, computed once per
//     instance by the caller -- pbrt's `ApplyInverse(r, &tMax)` at the top of
//     `TransformedPrimitive::Intersect`. Nothing inside the walk needs `r` any
//     more, so it is not a parameter at all.
//
//   - the node test is a slab test and nothing else: no `v3f32` `minnum` or
//     `maxnum` -- the eight-corner fold -- and no matrix columns read on the
//     way to a node's box. Before the rewrite this function did an
//     eight-corner box transform at every node, 17 vector multiplies, 29 adds
//     and 14 min/max, against pbrt's handful. That difference was the whole
//     cost of instancing.
//
// What remains of the matrix inside the walk is in the hit path only: the
// value the query yields is the triangle *where the instance puts it*, and
// that is built when a hit is recorded, not tested at every node.
import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

element Transform {
    m0, m1, m2, m3 : vec3f;
    i0, i1, i2, i3 : vec3f;
}

func apply(t : Transform, p : vec3f) -> vec3f =
    t.m0 * p.x + t.m1 * p.y + t.m2 * p.z + t.m3;

func transform(t : Transform, b : AABB) -> AABB {
    c0 = apply(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

func transform(t : Transform, tri : Triangle) -> Triangle {
    out : Triangle = {apply(t, tri.p0), apply(t, tri.p1), apply(t, tri.p2)};
    return out;
}

// Not renormalised; see blas-tlas.bonsai.
func untransform(t : Transform, r : Ray) -> Ray {
    o = t.i0 * r.o.x + t.i1 * r.o.y + t.i2 * r.o.z + t.i3;
    d = t.i0 * r.d.x + t.i1 * r.d.y + t.i2 * r.d.z;
    out : Ray = {o, d, r.tmax};
    return out;
}

element Instance {
    render_from_instance : Transform;
    blas : set[Triangle];
} with extent = transform(render_from_instance, blas.AABB);

extern instances : set[Instance];

func [[export]] trace(r : Ray) =
    argmin(|i : Instance, tri : Triangle| distmin(r, tri),
           filter(|i : Instance, tri : Triangle|
                      intersects(r, tri) && distmin(r, tri) > 0.001,
                  flatten(|i : Instance|
                              map(|tri : Triangle|
                                      transform(i.render_from_instance, tri),
                                  i.blas),
                          instances)));

schedule {
    tree[[Triangle]] BLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : BLAS, right : BLAS, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    tree[[Instance]] TLAS(low high : vec3f) with AABB(low, high) =
    | Interior(left : TLAS, right : TLAS, axis : u8)
    | Leaf(data : array[Instance]) with data = data;

    instances : TLAS;
    Instance.blas : BLAS from BlasNodes;

    layout instances {
        tCount : u32;
        tris : array[Triangle, tCount];

        bCount : u32;
        indirect group BlasNodes[bCount] bnode : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            switch nPrims {
                0 => Interior { offset : u32; left = bnode + 1;
                                right = bnode + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(tris, pOffset, cast[[u32]](nPrims)); };
            };
        };

        iCount : u32;
        insts : array[Instance, iCount];

        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1;
                                right = index + offset; };
                _ => Leaf { pOffset : u32;
                            data = range(insts, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };
}
