//! flags: -p ssa -b llvm

// A tree query through the SSA pipeline, end to end.
//
// This is `tests/bonsai/lower/trace.bonsai` compiled the other way, and it is
// the only place several things meet: a tree lowered into a traversal, that
// traversal loopified onto an explicit stack by the SSA rewriter, and the
// aliasing facts that decide whether the result is any good.
//
// The thing to look for in the golden is that there is no `_recloop_func0`.
// Lowering has to extract a recursion into a function of its own before
// `loopify` can turn it into a loop, and once it is a loop that function has
// served its purpose: left standing, what the query folds into stays the
// caller's, so every update to it is a store through a pointer and reading
// the answer back is a load per field. `loopify` marks it to be folded back
// into the caller it came from, which is what puts the accumulator in
// registers -- see SSA/Rewrite.cpp.
//
// The `noalias` that makes that accumulator worth having in the first place
// is pinned by tree-traversal-recursive.bonsai, which is the same query
// without a `loopify` and so still has a function to hang it on.
import stdlib/distance;
import stdlib/intersects;
import stdlib/triangle;

extern triangles : set[Triangle];

func [[export]] trace(ray : Ray) = argmin(|tri| distmin(ray, tri), filter(|tri| intersects(ray, tri), triangles));

func [[export]] trace_all(n : u32, rays : array[Ray, n]) = map(|r : Ray| trace(r), rays);

schedule {
    tree[[Triangle]] TriangleBVH(low high : vec3f) with AABB(low, high) =
    | Interior(left : TriangleBVH, right : TriangleBVH, axis : u8)
    | Leaf(data : array[Triangle]) with data = data;

    triangles : TriangleBVH;

    layout triangles {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            high : vec3f;
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u32; data = range(prims, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };

    trace.loopify(64);
}
