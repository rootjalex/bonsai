//! flags: -p ssa -b llvm

// A node that bounds its children rather than itself, all the way to LLVM,
// with the recursion left as recursion.
//
// lower/child-volumes.bonsai is the `from` with a mask bit per branch, from
// a loop over the children; ssa/child-volumes-sorted.bonsai is what loopify
// makes of those bits. This is the other consumer: a run of recursive calls
// that is still a run of calls when it reaches the backend. Each call is
// made under its branch's bit -- a `br i1` round the call, in blocks of the
// run's own (`!call`, `!next`) -- so the child whose box the ray missed is
// not visited, and the two calls that are made are made in the order the
// `from` gave.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
// For `contains(Ray, AABB)`: the condition under which a box's whole
// contents are hit, which is what settles an `any` without a visit.
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

schedule {
    // Two children, to keep the module short: the shape is the same at four
    // or eight.
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH2;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 2];
            lo : vector[vec3f, 2];
            hi : vector[vec3f, 2];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };
}
