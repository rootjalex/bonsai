; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

@0 = private unnamed_addr constant [4 x i8] c"%f\0A\00", align 1

; Function Attrs: mustprogress nofree nounwind
define noundef float @pick(float noundef %x, float noundef %y, i1 noundef %big) local_unnamed_addr #0 {
pick:
  br i1 %big, label %"!then_0", label %common.ret

common.ret:                                       ; preds = %pick, %"!then_0"
  %.pn = phi float [ %1, %"!then_0" ], [ %y, %pick ]
  %common.ret.op = fadd float %x, %.pn
  ret float %common.ret.op

"!then_0":                                        ; preds = %pick
  %0 = fmul float %x, %y
  %1 = tail call float @llvm.sqrt.f32(float %0)
  %2 = fpext float %1 to double
  %3 = tail call i32 (ptr, ...) @printf(ptr nonnull dereferenceable(1) @0, double %2)
  br label %common.ret
}

; Function Attrs: mustprogress nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare float @llvm.sqrt.f32(float) #1

; Function Attrs: nofree nounwind
declare noundef i32 @printf(ptr noundef readonly captures(none), ...) local_unnamed_addr #2

attributes #0 = { mustprogress nofree nounwind }
attributes #1 = { mustprogress nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
attributes #2 = { nofree nounwind }
