; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define <3 x float> @centroid(i32 noundef %a, i32 noundef %b, i32 noundef %c, ptr noundef %positions_buffer) local_unnamed_addr {
centroid:
  %positions = tail call ptr @bonsai_buffer_require(ptr %positions_buffer, i32 1)
  %a_wide = zext i32 %a to i64
  %extract_ptr = getelementptr inbounds nuw [12 x i8], ptr %positions, i64 %a_wide
  %extract.unpack = load float, ptr %extract_ptr, align 4
  %extract.elt5 = getelementptr inbounds nuw i8, ptr %extract_ptr, i64 4
  %0 = load <2 x float>, ptr %extract.elt5, align 4
  %1 = insertelement <3 x float> poison, float %extract.unpack, i64 0
  %2 = shufflevector <2 x float> %0, <2 x float> poison, <3 x i32> <i32 0, i32 1, i32 poison>
  %3 = shufflevector <3 x float> %1, <3 x float> %2, <3 x i32> <i32 0, i32 3, i32 4>
  %b_wide = zext i32 %b to i64
  %extract_ptr1 = getelementptr inbounds nuw [12 x i8], ptr %positions, i64 %b_wide
  %extract2.unpack = load float, ptr %extract_ptr1, align 4
  %extract2.elt10 = getelementptr inbounds nuw i8, ptr %extract_ptr1, i64 4
  %4 = load <2 x float>, ptr %extract2.elt10, align 4
  %5 = insertelement <3 x float> poison, float %extract2.unpack, i64 0
  %6 = shufflevector <2 x float> %4, <2 x float> poison, <3 x i32> <i32 0, i32 1, i32 poison>
  %7 = shufflevector <3 x float> %5, <3 x float> %6, <3 x i32> <i32 0, i32 3, i32 4>
  %8 = fadd <3 x float> %3, %7
  %c_wide = zext i32 %c to i64
  %extract_ptr3 = getelementptr inbounds nuw [12 x i8], ptr %positions, i64 %c_wide
  %extract4.unpack = load float, ptr %extract_ptr3, align 4
  %extract4.elt15 = getelementptr inbounds nuw i8, ptr %extract_ptr3, i64 4
  %9 = load <2 x float>, ptr %extract4.elt15, align 4
  %10 = insertelement <3 x float> poison, float %extract4.unpack, i64 0
  %11 = shufflevector <2 x float> %9, <2 x float> poison, <3 x i32> <i32 0, i32 1, i32 poison>
  %12 = shufflevector <3 x float> %10, <3 x float> %11, <3 x i32> <i32 0, i32 3, i32 4>
  %13 = fadd <3 x float> %8, %12
  %14 = fdiv <3 x float> %13, splat (float 3.000000e+00)
  ret <3 x float> %14
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr
