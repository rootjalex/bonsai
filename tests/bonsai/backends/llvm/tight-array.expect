; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: read)
define <3 x float> @centroid(i32 noundef %a, i32 noundef %b, i32 noundef %c, ptr nofree noundef readonly captures(none) %positions) local_unnamed_addr #0 {
centroid:
  %0 = sext i32 %a to i64
  %extract_ptr = getelementptr inbounds [12 x i8], ptr %positions, i64 %0
  %extract.unpack = load float, ptr %extract_ptr, align 4
  %extract.elt5 = getelementptr inbounds nuw i8, ptr %extract_ptr, i64 4
  %1 = load <2 x float>, ptr %extract.elt5, align 4
  %2 = insertelement <3 x float> poison, float %extract.unpack, i64 0
  %3 = shufflevector <2 x float> %1, <2 x float> poison, <3 x i32> <i32 0, i32 1, i32 poison>
  %4 = shufflevector <3 x float> %2, <3 x float> %3, <3 x i32> <i32 0, i32 3, i32 4>
  %5 = sext i32 %b to i64
  %extract_ptr1 = getelementptr inbounds [12 x i8], ptr %positions, i64 %5
  %extract2.unpack = load float, ptr %extract_ptr1, align 4
  %extract2.elt10 = getelementptr inbounds nuw i8, ptr %extract_ptr1, i64 4
  %6 = load <2 x float>, ptr %extract2.elt10, align 4
  %7 = insertelement <3 x float> poison, float %extract2.unpack, i64 0
  %8 = shufflevector <2 x float> %6, <2 x float> poison, <3 x i32> <i32 0, i32 1, i32 poison>
  %9 = shufflevector <3 x float> %7, <3 x float> %8, <3 x i32> <i32 0, i32 3, i32 4>
  %10 = fadd <3 x float> %4, %9
  %11 = sext i32 %c to i64
  %extract_ptr3 = getelementptr inbounds [12 x i8], ptr %positions, i64 %11
  %extract4.unpack = load float, ptr %extract_ptr3, align 4
  %extract4.elt15 = getelementptr inbounds nuw i8, ptr %extract_ptr3, i64 4
  %12 = load <2 x float>, ptr %extract4.elt15, align 4
  %13 = insertelement <3 x float> poison, float %extract4.unpack, i64 0
  %14 = shufflevector <2 x float> %12, <2 x float> poison, <3 x i32> <i32 0, i32 1, i32 poison>
  %15 = shufflevector <3 x float> %13, <3 x float> %14, <3 x i32> <i32 0, i32 3, i32 4>
  %16 = fadd <3 x float> %10, %15
  %17 = fdiv <3 x float> %16, splat (float 3.000000e+00)
  ret <3 x float> %17
}

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: read) }
