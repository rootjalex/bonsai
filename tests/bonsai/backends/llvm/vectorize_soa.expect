define void @sum_components(ptr noundef %inp, ptr nocapture noundef writeonly %out) local_unnamed_addr #0 {
sum_components:
  %extract_ptrs = getelementptr inbounds float, ptr %inp, <8 x i64> <i64 0, i64 4, i64 8, i64 12, i64 16, i64 20, i64 24, i64 28>
  %extract = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> %extract_ptrs, i32 4, <8 x i1> <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true>, <8 x float> poison)
  %extract_ptrs3 = getelementptr inbounds float, ptr %inp, <8 x i64> <i64 1, i64 5, i64 9, i64 13, i64 17, i64 21, i64 25, i64 29>
  %extract4 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> %extract_ptrs3, i32 4, <8 x i1> <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true>, <8 x float> poison)
  %extract_ptrs5 = getelementptr inbounds float, ptr %inp, <8 x i64> <i64 2, i64 6, i64 10, i64 14, i64 18, i64 22, i64 26, i64 30>
  %extract6 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> %extract_ptrs5, i32 4, <8 x i1> <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true>, <8 x float> poison)
  %0 = fadd <8 x float> %extract, %extract4
  %1 = fadd <8 x float> %0, %extract6
  store <8 x float> %1, ptr %out, align 4
  ret void
}

