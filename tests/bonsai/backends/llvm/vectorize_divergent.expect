; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite)
define void @clamp_negative(ptr nocapture noundef readonly %a, ptr nocapture noundef writeonly %out) local_unnamed_addr #0 {
clamp_negative:
  %extract = load <8 x float>, ptr %a, align 32
  %0 = fcmp olt <8 x float> %extract, zeroinitializer
  %not. = xor <8 x i1> %0, <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true>
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> zeroinitializer, ptr %out, i32 32, <8 x i1> %0)
  %extract4 = load <8 x float>, ptr %a, align 32
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> %extract4, ptr %out, i32 32, <8 x i1> %not.)
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite)
define void @uniform_outer(ptr nocapture noundef readonly %a, float noundef %flag, ptr nocapture noundef writeonly %out) local_unnamed_addr #0 {
uniform_outer:
  %0 = fcmp olt float %flag, 0.000000e+00
  br i1 %0, label %"!then_2", label %"!else_3"

"!then_2":                                        ; preds = %uniform_outer
  store <8 x float> zeroinitializer, ptr %out, align 32
  br label %"!par_cont_1"

"!else_3":                                        ; preds = %uniform_outer
  %extract = load <8 x float>, ptr %a, align 32
  %1 = fcmp olt <8 x float> %extract, zeroinitializer
  %not. = xor <8 x i1> %1, <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true>
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> <float 1.000000e+00, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00>, ptr %out, i32 32, <8 x i1> %1)
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> <float 2.000000e+00, float 2.000000e+00, float 2.000000e+00, float 2.000000e+00, float 2.000000e+00, float 2.000000e+00, float 2.000000e+00, float 2.000000e+00>, ptr %out, i32 32, <8 x i1> %not.)
  br label %"!par_cont_1"

"!par_cont_1":                                    ; preds = %"!then_2", %"!else_3"
  ret void
}

