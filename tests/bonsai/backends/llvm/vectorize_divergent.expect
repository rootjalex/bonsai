; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @clamp_negative(ptr noundef %a_buffer, ptr noundef %out_buffer) local_unnamed_addr {
clamp_negative:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %0 = fcmp olt <8 x float> %extract, zeroinitializer
  %not. = xor <8 x i1> %0, splat (i1 true)
  %1 = bitcast <8 x i1> %0 to i8
  %.not = icmp eq i8 %1, 0
  br i1 %.not, label %"!else_3!any", label %"!then_2"

"!then_2":                                        ; preds = %clamp_negative
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> zeroinitializer, ptr align 4 %out, <8 x i1> %0)
  br label %"!else_3!any"

"!else_3!any":                                    ; preds = %"!then_2", %clamp_negative
  %2 = bitcast <8 x i1> %not. to i8
  %.not4 = icmp eq i8 %2, 0
  br i1 %.not4, label %"!par_cont_1", label %"!else_3"

"!else_3":                                        ; preds = %"!else_3!any"
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> %extract, ptr align 4 %out, <8 x i1> %not.)
  br label %"!par_cont_1"

"!par_cont_1":                                    ; preds = %"!else_3!any", %"!else_3"
  ret void
}

define void @uniform_outer(ptr noundef %a_buffer, float noundef %flag, ptr noundef %out_buffer) local_unnamed_addr {
uniform_outer:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %0 = fcmp olt float %flag, 0.000000e+00
  br i1 %0, label %"!then_2", label %"!else_3"

"!then_2":                                        ; preds = %uniform_outer
  store <8 x float> zeroinitializer, ptr %out, align 4
  br label %"!par_cont_1"

"!else_3":                                        ; preds = %uniform_outer
  %extract = load <8 x float>, ptr %a, align 4
  %1 = fcmp olt <8 x float> %extract, zeroinitializer
  %not. = xor <8 x i1> %1, splat (i1 true)
  %2 = bitcast <8 x i1> %1 to i8
  %.not = icmp eq i8 %2, 0
  br i1 %.not, label %"!else_6!any", label %"!then_5"

"!then_5":                                        ; preds = %"!else_3"
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> splat (float 1.000000e+00), ptr align 4 %out, <8 x i1> %1)
  br label %"!else_6!any"

"!else_6!any":                                    ; preds = %"!then_5", %"!else_3"
  %3 = bitcast <8 x i1> %not. to i8
  %.not6 = icmp eq i8 %3, 0
  br i1 %.not6, label %"!par_cont_1", label %"!else_6"

"!else_6":                                        ; preds = %"!else_6!any"
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> splat (float 2.000000e+00), ptr align 4 %out, <8 x i1> %not.)
  br label %"!par_cont_1"

"!par_cont_1":                                    ; preds = %"!then_2", %"!else_6", %"!else_6!any"
  ret void
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: write)
declare void @llvm.masked.store.v8f32.p0(<8 x float>, ptr captures(none), <8 x i1>) #0

attributes #0 = { mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: write) }
