define <3 x float> @lanes(<3 x float> noundef %v) local_unnamed_addr #0 {
lanes_entry:
  %0 = shufflevector <3 x float> %v, <3 x float> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 poison>
  %1 = insertelement <4 x float> %0, float 1.000000e+00, i64 3
  %rcp_est = tail call <4 x float> @llvm.x86.sse.rcp.ps(<4 x float> %1) #4
  %2 = fneg <4 x float> %1
  %3 = shufflevector <4 x float> %rcp_est, <4 x float> poison, <3 x i32> <i32 0, i32 1, i32 2>
  %4 = shufflevector <4 x float> %2, <4 x float> poison, <3 x i32> <i32 0, i32 1, i32 2>
  %5 = shufflevector <4 x float> %rcp_est, <4 x float> poison, <3 x i32> <i32 0, i32 1, i32 2>
  %6 = tail call <3 x float> @llvm.fma.v3f32(<3 x float> %4, <3 x float> %5, <3 x float> splat (float 1.000000e+00))
  %7 = shufflevector <4 x float> %rcp_est, <4 x float> poison, <3 x i32> <i32 0, i32 1, i32 2>
  %rcp = tail call <3 x float> @llvm.fma.v3f32(<3 x float> %3, <3 x float> %6, <3 x float> %7)
  ret <3 x float> %rcp
}

