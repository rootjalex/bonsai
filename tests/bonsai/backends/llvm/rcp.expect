define float @embree(float noundef %x) local_unnamed_addr #0 {
embree:
  %0 = insertelement <4 x float> <float poison, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00>, float %x, i64 0
  %rcp_est = tail call <4 x float> @llvm.x86.sse.rcp.ps(<4 x float> %0) #3
  %rcp = extractelement <4 x float> %rcp_est, i64 0
  %1 = fneg float %x
  %2 = tail call float @llvm.fma.f32(float %1, float %rcp, float 1.000000e+00)
  %3 = tail call float @llvm.fma.f32(float %rcp, float %2, float %rcp)
  ret float %3
}

