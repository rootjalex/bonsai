define float @scalar(float noundef %x) local_unnamed_addr #0 {
scalar_entry:
  %0 = insertelement <4 x float> <float poison, float 1.000000e+00, float 1.000000e+00, float 1.000000e+00>, float %x, i64 0
  %rcp_est = tail call <4 x float> @llvm.x86.sse.rcp.ps(<4 x float> %0) #4
  %1 = fneg <4 x float> %0
  %2 = tail call <4 x float> @llvm.fma.v4f32(<4 x float> %1, <4 x float> %rcp_est, <4 x float> splat (float 1.000000e+00))
  %3 = tail call <4 x float> @llvm.fma.v4f32(<4 x float> %rcp_est, <4 x float> %2, <4 x float> %rcp_est)
  %rcp = extractelement <4 x float> %3, i64 0
