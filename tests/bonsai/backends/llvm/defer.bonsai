//! flags: -p ssa -b llvm

// A deferred tail recursion, all the way to LLVM: the queue is a stack
// allocation of the owner sized by the producer loop's trip count, the push
// is an atomic fetch-and-add on its count and stores of the entry's fields
// into the slot it claimed, and the drain is a loop of rounds over the
// entries, compacted in place.
func fill(n : i32, acc : i32, out : mut array[i32, 8], i : i32) -> void {
  if (n <= 0) {
    out[i] = acc;
    return;
  }
  fill(n - 1, acc + n, out, i);
  return;
}

func [[export]] run(out : mut array[i32, 8]) -> void {
  parfor i in 0:8 {
    fill(i, 0, out, i);
  }
  return;
}

schedule {
  sums = run.queue(root);
  fill.defer(fill, sums);
}
