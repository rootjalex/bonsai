define noundef i1 @at_most(i32 noundef %i, i32 noundef %n, i32 noundef %m) local_unnamed_addr #0 {
at_most:
  %0 = tail call i32 @llvm.umin.i32(i32 %n, i32 %m)
  %1 = icmp ule i32 %i, %0
