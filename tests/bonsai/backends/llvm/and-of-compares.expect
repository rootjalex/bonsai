}

; Function Attrs: mustprogress
define void @at_most_all(ptr noundef %is_buffer, i32 noundef %n, i32 noundef %m, ptr noundef %out_buffer) local_unnamed_addr #1 {
at_most_all:
  %is = tail call ptr @bonsai_buffer_require(ptr %is_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %is, align 4
  %0 = tail call i32 @llvm.umin.i32(i32 %n, i32 %m)
  %.splatinsert = insertelement <8 x i32> poison, i32 %0, i64 0
  %.splat = shufflevector <8 x i32> %.splatinsert, <8 x i32> poison, <8 x i32> zeroinitializer
  %1 = icmp ule <8 x i32> %extract, %.splat
  %2 = zext <8 x i1> %1 to <8 x i32>
  store <8 x i32> %2, ptr %out, align 4
  ret void
}

