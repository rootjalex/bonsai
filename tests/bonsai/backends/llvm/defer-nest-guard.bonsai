//! flags: -p ssa -b llvm

// A queue owned by the outer loop of a split with a tail guard (ssa/
// defer-nest-guard says what the deferral does about it: a byte per slot,
// cleared by one fill where the chunk initializes its queue, set at the
// call, tested by the pass over the record). The LLVM shows what the
// optimizer makes of that for a record of twelve bytes: the pass unrolled,
// the bytes forwarded from their stores, so that each slot's rest is
// branched on the guard's own comparison (`icmp ult i32 %io, %extract`)
// and the array is gone. The extent is read at run time so that the guard
// is not settled at compile time. The execution twin is
// correctness/llvm/defer-nest-guard.
import stdlib/numerics;

func step(x : Float, n : i32, total : reduce(+) Float) -> void {
    total += x;
    if n == 0 {
        return;
    }
    step(x, n - 1, total);
    return;
}

func [[export]] run(values : array[Float, 10], counts : array[u32, 1],
                    out : mut array[Float, 16], total : reduce(+) Float) -> void {
    parfor i in 0u:counts[0] {
        parfor j in 0u:3u {
            step(values[i], cast[[i32]](j), total);
            out[i] = out[i] + 1.0;
        }
    }
    return;
}

schedule {
    run.split(i, io, ii, 4, true);
    rays = run.queue(io);
    run.defer(step, rays);
    step.defer(step, rays);
}
