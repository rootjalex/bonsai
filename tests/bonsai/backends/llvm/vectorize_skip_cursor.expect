; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @weigh_all(ptr noundef %a_buffer, ptr noundef %out_buffer) local_unnamed_addr {
weigh_all:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %0 = fcmp olt <8 x float> %extract, zeroinitializer
  %1 = fsub <8 x float> zeroinitializer, %extract
  %2 = fcmp uge <8 x float> %extract, splat (float 4.000000e+00)
  %3 = fmul <8 x float> %extract, splat (float 5.000000e-01)
  %4 = fmul <8 x float> %extract, splat (float 2.500000e-01)
  %.v = select <8 x i1> %2, <8 x float> %4, <8 x float> %3
  %5 = bitcast <8 x float> %.v to <8 x i32>
  %.v11 = select <8 x i1> %0, <8 x float> %1, <8 x float> %extract
  %6 = select <8 x i1> %0, <8 x i32> zeroinitializer, <8 x i32> %5
  %7 = xor <8 x i1> %2, %0
  %8 = xor <8 x i1> %7, splat (i1 true)
  %9 = bitcast <8 x i1> %2 to i8
  %.not = icmp eq i8 %9, 0
  br i1 %.not, label %"!case_10!any", label %"!case_11"

"!case_11":                                       ; preds = %weigh_all
  %10 = bitcast <8 x i32> %6 to <8 x float>
  %11 = fmul <8 x float> %.v11, splat (float 6.000000e+00)
  %12 = fmul <8 x float> %10, splat (float 6.000000e+00)
  %13 = fadd <8 x float> %11, %12
  br label %"!case_10!any"

"!case_10!any":                                   ; preds = %"!case_11", %weigh_all
  %"p$i9!skip" = phi <8 x float> [ undef, %weigh_all ], [ %13, %"!case_11" ]
  %14 = bitcast <8 x i1> %8 to i8
  %.not14 = icmp eq i8 %14, 0
  br i1 %.not14, label %"!case_9!any", label %"!case_10"

"!case_10":                                       ; preds = %"!case_10!any"
  %15 = bitcast <8 x i32> %6 to <8 x float>
  %16 = fmul <8 x float> %.v11, splat (float 2.000000e+00)
  %17 = fmul <8 x float> %15, splat (float 2.000000e+00)
  %18 = fadd <8 x float> %16, %17
  %19 = select <8 x i1> %7, <8 x float> %"p$i9!skip", <8 x float> %18
  br label %"!case_9!any"

"!case_9!any":                                    ; preds = %"!case_10", %"!case_10!any"
  %"p$i9!skip0" = phi <8 x float> [ %"p$i9!skip", %"!case_10!any" ], [ %19, %"!case_10" ]
  %20 = bitcast <8 x i1> %0 to i8
  %.not15 = icmp eq i8 %20, 0
  br i1 %.not15, label %"!merge_8", label %"!case_9"

"!case_9":                                        ; preds = %"!case_9!any"
  %21 = fmul <8 x float> %1, splat (float 6.000000e+00)
  %22 = select <8 x i1> %0, <8 x float> %21, <8 x float> %"p$i9!skip0"
  br label %"!merge_8"

"!merge_8":                                       ; preds = %"!case_9", %"!case_9!any"
  %"p$i9!skip1" = phi <8 x float> [ %"p$i9!skip0", %"!case_9!any" ], [ %22, %"!case_9" ]
  %23 = fmul <8 x float> %3, %3
  %24 = fadd <8 x float> %23, splat (float 1.000000e+00)
  %25 = bitcast <8 x i32> %6 to <8 x float>
  %26 = fmul <8 x float> %.v11, %.v11
  %27 = fcmp olt <8 x float> %24, %26
  %28 = fmul <8 x float> %25, %25
  %29 = fcmp olt <8 x float> %28, %24
  %30 = and <8 x i1> %27, %29
  br i1 %.not14, label %"!case_13", label %"!case_14"

"!case_14":                                       ; preds = %"!merge_8"
  %31 = fcmp olt <8 x float> %23, %26
  %32 = fcmp ogt <8 x float> %28, splat (float 1.000000e+00)
  %33 = and <8 x i1> %31, %32
  %34 = select <8 x i1> %7, <8 x i1> %30, <8 x i1> %33
  br label %"!case_13"

"!case_13":                                       ; preds = %"!case_14", %"!merge_8"
  %"hit$i12!skip" = phi <8 x i1> [ %30, %"!merge_8" ], [ %34, %"!case_14" ]
  br i1 %.not, label %"!case_20", label %"!case_21"

"!case_21":                                       ; preds = %"!case_13"
  %35 = fsub <8 x float> %26, %28
  %36 = fmul <8 x float> %35, splat (float 3.000000e+00)
  %37 = fmul <8 x float> %25, splat (float 5.000000e-01)
  %38 = fadd <8 x float> %37, %36
  %39 = fsub <8 x float> %38, %.v11
  br label %"!case_20"

"!case_20":                                       ; preds = %"!case_21", %"!case_13"
  %"a$i13!skip" = phi <8 x float> [ undef, %"!case_13" ], [ %39, %"!case_21" ]
  %40 = select <8 x i1> %0, <8 x i1> %27, <8 x i1> %"hit$i12!skip"
  %41 = fadd <8 x float> %"p$i9!skip1", splat (float 1.000000e+00)
  %42 = select <8 x i1> %40, <8 x float> %41, <8 x float> %"p$i9!skip1"
  %43 = fmul <8 x float> %.v11, %25
  %44 = select <8 x i1> %7, <8 x float> %"a$i13!skip", <8 x float> %43
  %45 = fmul <8 x float> %26, splat (float 3.000000e+00)
  %46 = select <8 x i1> %0, <8 x float> %45, <8 x float> %44
  %47 = fadd <8 x float> %42, %46
  store <8 x float> %47, ptr %out, align 4
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define float @weigh_one(float noundef %x) local_unnamed_addr #0 {
weigh_one:
  %0 = fcmp olt float %x, 0.000000e+00
  br i1 %0, label %"!case_17", label %"!else_1"

"!else_1":                                        ; preds = %weigh_one
  %1 = fcmp olt float %x, 4.000000e+00
  br i1 %1, label %"!case_18", label %"!case_19"

"!case_19":                                       ; preds = %"!else_1"
  %2 = fmul float %x, 2.500000e-01
  %3 = fmul float %x, 6.000000e+00
  %4 = fmul float %2, 6.000000e+00
  %5 = fadd float %3, %4
  %6 = fmul float %x, 5.000000e-01
  %7 = fmul float %6, %6
  %8 = fadd float %7, 1.000000e+00
  %9 = fmul float %x, %x
  %10 = fcmp olt float %8, %9
  %11 = fmul float %2, %2
  %12 = fcmp olt float %11, %8
  %13 = and i1 %10, %12
  %14 = fadd float %5, 1.000000e+00
  %"p$i102570" = select i1 %13, float %14, float %5
  %15 = fsub float %9, %11
  %16 = fmul float %15, 3.000000e+00
  %17 = fmul float %2, 5.000000e-01
  %18 = fadd float %17, %16
  %19 = fsub float %18, %x
  br label %"!merge_16"

"!case_18":                                       ; preds = %"!else_1"
  %20 = fmul nnan float %x, 5.000000e-01
  %21 = fmul nnan float %x, 2.000000e+00
  %22 = fmul nnan float %20, 2.000000e+00
  %23 = fadd float %21, %22
  %24 = fmul float %20, %20
  %25 = fmul float %x, %x
  %26 = fcmp olt float %24, %25
  %27 = fcmp ogt float %24, 1.000000e+00
  %28 = and i1 %26, %27
  %29 = fadd float %23, 1.000000e+00
  %"p$i1025" = select i1 %28, float %29, float %23
  %30 = fmul nnan float %x, %20
  br label %"!merge_16"

"!case_17":                                       ; preds = %weigh_one
  %31 = fsub float 0.000000e+00, %x
  %32 = fmul nnan float %31, 6.000000e+00
  %33 = fmul nnan float %x, 5.000000e-01
  %34 = fmul float %33, %33
  %35 = fadd float %34, 1.000000e+00
  %36 = fmul float %31, %31
  %37 = fcmp olt float %35, %36
  %38 = fadd float %32, 1.000000e+00
  %"p$i102579" = select i1 %37, float %38, float %32
  %39 = fmul nnan float %36, 3.000000e+00
  br label %"!merge_16"

"!merge_16":                                      ; preds = %"!case_19", %"!case_18", %"!case_17"
  %"p$i102572" = phi float [ %"p$i102579", %"!case_17" ], [ %"p$i1025", %"!case_18" ], [ %"p$i102570", %"!case_19" ]
  %"a$i16" = phi float [ %39, %"!case_17" ], [ %30, %"!case_18" ], [ %19, %"!case_19" ]
  %40 = fadd float %"p$i102572", %"a$i16"
  ret float %40
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
