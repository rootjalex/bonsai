; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @weigh_all(ptr noundef %a_buffer, ptr noundef %out_buffer) local_unnamed_addr {
weigh_all:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %0 = fcmp olt <8 x float> %extract, zeroinitializer
  %1 = fsub <8 x float> zeroinitializer, %extract
  %2 = fcmp uge <8 x float> %extract, splat (float 4.000000e+00)
  %3 = fmul <8 x float> %extract, splat (float 5.000000e-01)
  %4 = fmul <8 x float> %extract, splat (float 2.500000e-01)
  %5 = xor <8 x i1> %2, %0
  %6 = xor <8 x i1> %5, splat (i1 true)
  %7 = bitcast <8 x i1> %2 to i8
  %.not = icmp eq i8 %7, 0
  br i1 %.not, label %"!case_10!any", label %"!case_11"

"!case_11":                                       ; preds = %weigh_all
  %.v = select <8 x i1> %0, <8 x float> %1, <8 x float> %extract
  %.v4 = select <8 x i1> %2, <8 x float> %4, <8 x float> %3
  %8 = fmul <8 x float> %.v, splat (float 6.000000e+00)
  %9 = fmul <8 x float> %.v4, splat (float 6.000000e+00)
  %10 = select <8 x i1> %0, <8 x float> zeroinitializer, <8 x float> %9
  %11 = fadd <8 x float> %8, %10
  br label %"!case_10!any"

"!case_10!any":                                   ; preds = %"!case_11", %weigh_all
  %"p$i9!skip" = phi <8 x float> [ undef, %weigh_all ], [ %11, %"!case_11" ]
  %12 = bitcast <8 x i1> %6 to i8
  %.not5 = icmp eq i8 %12, 0
  br i1 %.not5, label %"!case_9!any", label %"!case_10"

"!case_10":                                       ; preds = %"!case_10!any"
  %.v6 = select <8 x i1> %0, <8 x float> %1, <8 x float> %extract
  %.v7 = select <8 x i1> %2, <8 x float> %4, <8 x float> %3
  %13 = fmul <8 x float> %.v6, splat (float 2.000000e+00)
  %14 = fmul <8 x float> %.v7, splat (float 2.000000e+00)
  %15 = select <8 x i1> %0, <8 x float> zeroinitializer, <8 x float> %14
  %16 = fadd <8 x float> %13, %15
  %17 = select <8 x i1> %5, <8 x float> %"p$i9!skip", <8 x float> %16
  br label %"!case_9!any"

"!case_9!any":                                    ; preds = %"!case_10", %"!case_10!any"
  %"p$i9!skip0" = phi <8 x float> [ %"p$i9!skip", %"!case_10!any" ], [ %17, %"!case_10" ]
  %18 = bitcast <8 x i1> %0 to i8
  %.not8 = icmp eq i8 %18, 0
  br i1 %.not8, label %"!merge_8", label %"!case_9"

"!case_9":                                        ; preds = %"!case_9!any"
  %19 = fmul <8 x float> %1, splat (float 6.000000e+00)
  %20 = select <8 x i1> %0, <8 x float> %19, <8 x float> %"p$i9!skip0"
  br label %"!merge_8"

"!merge_8":                                       ; preds = %"!case_9", %"!case_9!any"
  %"p$i9!skip1" = phi <8 x float> [ %"p$i9!skip0", %"!case_9!any" ], [ %20, %"!case_9" ]
  %21 = fmul <8 x float> %3, %3
  %22 = fadd <8 x float> %21, splat (float 1.000000e+00)
  %.v10 = select <8 x i1> %0, <8 x float> %1, <8 x float> %extract
  %.v11 = select <8 x i1> %2, <8 x float> %4, <8 x float> %3
  %23 = select <8 x i1> %0, <8 x float> zeroinitializer, <8 x float> %.v11
  %24 = fmul <8 x float> %.v10, %.v10
  %25 = fcmp olt <8 x float> %22, %24
  %26 = fmul <8 x float> %23, %23
  %27 = fcmp olt <8 x float> %26, %22
  %28 = and <8 x i1> %25, %27
  br i1 %.not5, label %"!case_13", label %"!case_14"

"!case_14":                                       ; preds = %"!merge_8"
  %29 = fcmp olt <8 x float> %21, %24
  %30 = fcmp ogt <8 x float> %26, splat (float 1.000000e+00)
  %31 = and <8 x i1> %29, %30
  %32 = select <8 x i1> %5, <8 x i1> %28, <8 x i1> %31
  br label %"!case_13"

"!case_13":                                       ; preds = %"!case_14", %"!merge_8"
  %"hit$i12!skip" = phi <8 x i1> [ %28, %"!merge_8" ], [ %32, %"!case_14" ]
  br i1 %.not, label %"!case_20", label %"!case_21"

"!case_21":                                       ; preds = %"!case_13"
  %33 = fsub <8 x float> %24, %26
  %34 = fmul <8 x float> %33, splat (float 3.000000e+00)
  %35 = fmul <8 x float> %23, splat (float 5.000000e-01)
  %36 = fadd <8 x float> %35, %34
  %37 = fsub <8 x float> %36, %.v10
  br label %"!case_20"

"!case_20":                                       ; preds = %"!case_21", %"!case_13"
  %"a$i13!skip" = phi <8 x float> [ undef, %"!case_13" ], [ %37, %"!case_21" ]
  %38 = select <8 x i1> %0, <8 x i1> %25, <8 x i1> %"hit$i12!skip"
  %39 = fadd <8 x float> %"p$i9!skip1", splat (float 1.000000e+00)
  %40 = select <8 x i1> %38, <8 x float> %39, <8 x float> %"p$i9!skip1"
  %41 = fmul <8 x float> %.v10, %23
  %42 = select <8 x i1> %5, <8 x float> %"a$i13!skip", <8 x float> %41
  %43 = fmul <8 x float> %24, splat (float 3.000000e+00)
  %44 = select <8 x i1> %0, <8 x float> %43, <8 x float> %42
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %45 = fadd <8 x float> %40, %44
  store <8 x float> %45, ptr %out, align 4
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define float @weigh_one(float noundef %x) local_unnamed_addr #0 {
weigh_one:
  %0 = fcmp olt float %x, 0.000000e+00
  br i1 %0, label %"!case_17", label %"!else_1"

"!else_1":                                        ; preds = %weigh_one
  %1 = fcmp olt float %x, 4.000000e+00
  br i1 %1, label %"!case_18", label %"!case_19"

"!case_19":                                       ; preds = %"!else_1"
  %2 = fmul float %x, 2.500000e-01
  %3 = fmul float %x, 6.000000e+00
  %4 = fmul float %2, 6.000000e+00
  %5 = fadd float %3, %4
  %6 = fmul float %x, 5.000000e-01
  %7 = fmul float %6, %6
  %8 = fadd float %7, 1.000000e+00
  %9 = fmul float %x, %x
  %10 = fcmp olt float %8, %9
  %11 = fmul float %2, %2
  %12 = fcmp olt float %11, %8
  %13 = and i1 %10, %12
  %14 = fadd float %5, 1.000000e+00
  %"p$i102567" = select i1 %13, float %14, float %5
  %15 = fsub float %9, %11
  %16 = fmul float %15, 3.000000e+00
  %17 = fmul float %2, 5.000000e-01
  %18 = fadd float %17, %16
  %19 = fsub float %18, %x
  br label %"!merge_16"

"!case_18":                                       ; preds = %"!else_1"
  %20 = fmul nnan float %x, 5.000000e-01
  %21 = fmul nnan float %x, 2.000000e+00
  %22 = fmul nnan float %20, 2.000000e+00
  %23 = fadd float %21, %22
  %24 = fmul float %20, %20
  %25 = fmul float %x, %x
  %26 = fcmp olt float %24, %25
  %27 = fcmp ogt float %24, 1.000000e+00
  %28 = and i1 %26, %27
  %29 = fadd float %23, 1.000000e+00
  %"p$i1025" = select i1 %28, float %29, float %23
  %30 = fmul nnan float %x, %20
  br label %"!merge_16"

"!case_17":                                       ; preds = %weigh_one
  %31 = fsub float 0.000000e+00, %x
  %32 = fmul nnan float %31, 6.000000e+00
  %33 = fmul nnan float %x, 5.000000e-01
  %34 = fmul float %33, %33
  %35 = fadd float %34, 1.000000e+00
  %36 = fmul float %31, %31
  %37 = fcmp olt float %35, %36
  %38 = fadd float %32, 1.000000e+00
  %"p$i102576" = select i1 %37, float %38, float %32
  %39 = fmul nnan float %36, 3.000000e+00
  br label %"!merge_16"

"!merge_16":                                      ; preds = %"!case_19", %"!case_18", %"!case_17"
  %"p$i102569" = phi float [ %"p$i102576", %"!case_17" ], [ %"p$i1025", %"!case_18" ], [ %"p$i102567", %"!case_19" ]
  %"a$i16" = phi float [ %39, %"!case_17" ], [ %30, %"!case_18" ], [ %19, %"!case_19" ]
  %40 = fadd float %"p$i102569", %"a$i16"
  ret float %40
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
