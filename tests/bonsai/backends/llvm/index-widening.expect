; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define range(i32 0, 256) i32 @byte_at_i32(ptr noundef %bytes_buffer, i32 noundef %i) local_unnamed_addr {
byte_at_i32:
  %bytes = tail call ptr @bonsai_buffer_require(ptr %bytes_buffer, i32 1)
  %i_wide = sext i32 %i to i64
  %extract_ptr = getelementptr inbounds i8, ptr %bytes, i64 %i_wide
  %extract = load i8, ptr %extract_ptr, align 1
  %0 = zext i8 %extract to i32
  ret i32 %0
}

define range(i32 0, 256) i32 @byte_at_u32(ptr noundef %bytes_buffer, i32 noundef %i) local_unnamed_addr {
byte_at_u32:
  %bytes = tail call ptr @bonsai_buffer_require(ptr %bytes_buffer, i32 1)
  %i_wide = zext i32 %i to i64
  %extract_ptr = getelementptr inbounds nuw i8, ptr %bytes, i64 %i_wide
  %extract = load i8, ptr %extract_ptr, align 1
  %0 = zext i8 %extract to i32
  ret i32 %0
}

define range(i32 0, 256) i32 @byte_at_u64(ptr noundef %bytes_buffer, i64 noundef %i) local_unnamed_addr {
byte_at_u64:
  %bytes = tail call ptr @bonsai_buffer_require(ptr %bytes_buffer, i32 1)
  %extract_ptr = getelementptr inbounds i8, ptr %bytes, i64 %i
  %extract = load i8, ptr %extract_ptr, align 1
  %0 = zext i8 %extract to i32
  ret i32 %0
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr
