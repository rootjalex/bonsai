  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  %done = tail call ptr @bonsai_buffer_require(ptr %done_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %done_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  store ptr %counts, ptr %_pfctx, align 16
  %0 = getelementptr inbounds nuw i8, ptr %_pfctx, i64 8
  store ptr %values, ptr %0, align 8
  %1 = getelementptr inbounds nuw i8, ptr %_pfctx, i64 16
  store ptr %out, ptr %1, align 16
  %2 = getelementptr inbounds nuw i8, ptr %_pfctx, i64 24
  store ptr %done, ptr %2, align 8
  call void @bonsai_parallel_for(i64 4, ptr nonnull %_pfctx, ptr nonnull @_pfkernel1)
  ret void
}

