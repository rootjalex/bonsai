define noundef <3 x float> @vmax(<3 x float> noundef %a, <3 x float> noundef %b) local_unnamed_addr #0 {
vmax_entry:
  %max_lt = fcmp olt <3 x float> %a, %b
  %max = select <3 x i1> %max_lt, <3 x float> %b, <3 x float> %a
  ret <3 x float> %max
}

