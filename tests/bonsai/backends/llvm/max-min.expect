define noundef float @fmax2(float noundef %a, float noundef %b) local_unnamed_addr #0 {
fmax2_entry:
  %max_lt = fcmp olt float %a, %b
  %max = select i1 %max_lt, float %b, float %a
  ret float %max
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @fmin2(float noundef %a, float noundef %b) local_unnamed_addr #0 {
fmin2_entry:
  %min_lt = fcmp olt float %b, %a
  %min = select i1 %min_lt, float %b, float %a
