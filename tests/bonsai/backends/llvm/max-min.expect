}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef i32 @imax(i32 noundef %a, i32 noundef %b) local_unnamed_addr #0 {
imax_entry:
  %0 = tail call i32 @llvm.smax.i32(i32 %a, i32 %b)
  ret i32 %0
}

