; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @clamp01(float noundef %x) local_unnamed_addr #0 {
clamp01_entry:
  %max_lt = fcmp olt float %x, 0.000000e+00
  %max = select i1 %max_lt, float 0.000000e+00, float %x
  %min_lt = fcmp ogt float %max, 1.000000e+00
  %min = select i1 %min_lt, float 1.000000e+00, float %max
  ret float %min
}

