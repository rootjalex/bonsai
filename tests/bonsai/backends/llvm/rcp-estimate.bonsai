//! flags: -p ssa -b llvm --ffp-contract

// `rcp_estimate`: the machine's reciprocal estimate and nothing after it,
// for a program that writes a library's own refinement out. On the AVX-512
// this directory's block pins it is `vrcp14ps` (`llvm.x86.avx512.rcp14.ps.*`,
// a relative error under 2^-14), over the scalar or the three components
// padded to the register's four lanes, with no `llvm.fma` of its own.
//
// `enoki_rcp` is enoki's reciprocal (enoki/array_avx512.h rcp_), which FCPW
// takes its divisions with: the estimate `r`, then `t0 = r + r`, `t1 = r m`
// and `t0 - t1 r` -- under --ffp-contract (SSA/Contract.h, which fuses `c -
// a b` as `fma(-a, b, c)`) one `llvm.fma` of the negated `t1`, `r` and
// `t0`, enoki's `_mm512_fnmadd_ps(t1, r, t0)`, with `t1` its own rounded
// `fmul`, since a product consumed by a multiply is not fused. `rcp`
// beside it is Embree's form, which the backend writes itself
// (CodeGen_X86::reciprocal): the same estimate, then `fma(-m, r, 1)` and
// `fma(r, h, r)`. The two refinements round differently in a third of all
// inputs, which is why a transcription of FCPW cannot say `rcp`
// (apps/rtq/metrics/fcpw.bonsai).
element vec3f = vector[f32, 3];

func [[export]] scalar(x : f32) -> f32 {
    return rcp_estimate(x);
}

func [[export]] three(x : vec3f) -> vec3f {
    return rcp_estimate(x);
}

func [[export]] enoki_rcp(m : f32) -> f32 {
    r = rcp_estimate(m);
    t0 = r + r;
    t1 = r * m;
    return t0 - t1 * r;
}

func [[export]] embree_rcp(m : f32) -> f32 {
    return rcp(m);
}
