; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

; Function Attrs: mustprogress
define float @sample(ptr noundef %vals_buffer, i32 noundef %at, i32 noundef %i) local_unnamed_addr #0 {
sample:
  %vals = tail call ptr @bonsai_buffer_require(ptr %vals_buffer, i32 1)
  %0 = sext i32 %at to i64
  %p.i = getelementptr [4 x i8], ptr %vals, i64 %0
  %1 = sext i32 %i to i64
  %p.i4 = getelementptr [4 x i8], ptr %p.i, i64 %1
  %v.i = load float, ptr %p.i4, align 4
  %r.i = fmul float %v.i, 2.000000e+00
  %2 = add i32 %i, 1
  %3 = sext i32 %2 to i64
  %p.i5 = getelementptr [4 x i8], ptr %p.i, i64 %3
  %v.i6 = load float, ptr %p.i5, align 4
  %r.i7 = fmul float %v.i6, 2.000000e+00
  %4 = fadd float %r.i, %r.i7
  ret float %4
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

attributes #0 = { mustprogress }
