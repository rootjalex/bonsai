; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

%struct.Queue_sums = type { i32, ptr, ptr, ptr }

define void @run(ptr noundef %out_buffer) local_unnamed_addr {
run:
  %sums_queue1134 = alloca [2 x %struct.Queue_sums], align 16
  %sums_i_135 = alloca [40 x i32], align 4
  %sums_acc_136 = alloca [40 x i32], align 4
  %sums_n_137 = alloca [40 x i32], align 4
  %sums_i_038 = alloca [40 x i32], align 4
  %sums_acc_039 = alloca [40 x i32], align 4
  %sums_n_040 = alloca [40 x i32], align 4
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  store i32 0, ptr %sums_queue1134, align 16
  %.fca.1.gep = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 8
  store ptr %sums_n_040, ptr %.fca.1.gep, align 8
  %.fca.2.gep = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 16
  store ptr %sums_acc_039, ptr %.fca.2.gep, align 16
  %.fca.3.gep = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 24
  store ptr %sums_i_038, ptr %.fca.3.gep, align 8
  %sums_queue13 = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 32
  store i32 0, ptr %sums_queue13, align 16
  %.fca.1.gep46 = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 40
  store ptr %sums_n_137, ptr %.fca.1.gep46, align 8
  %.fca.2.gep48 = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 48
  store ptr %sums_acc_136, ptr %.fca.2.gep48, align 16
  %.fca.3.gep50 = getelementptr inbounds nuw i8, ptr %sums_queue1134, i64 56
  store ptr %sums_i_135, ptr %.fca.3.gep50, align 8
  br label %"!par_body_0"

"!par_cont_1":                                    ; preds = %sums_gang1_pf_exit, %"sums!round.preheader"
  ret void

"sums!batch":                                     ; preds = %"sums!round.preheader", %sums_gang1_pf_exit
  %"@8.count56" = phi i32 [ %"@8.count", %sums_gang1_pf_exit ], [ %"@8.count53", %"sums!round.preheader" ]
  %extract_ptr55 = phi ptr [ %extract_ptr, %sums_gang1_pf_exit ], [ %sums_queue1134, %"sums!round.preheader" ]
  %0 = phi i32 [ %18, %sums_gang1_pf_exit ], [ 0, %"sums!round.preheader" ]
  %"sums!round254" = phi i32 [ %17, %sums_gang1_pf_exit ], [ 0, %"sums!round.preheader" ]
  %1 = xor i32 %0, 1
  %2 = zext nneg i32 %1 to i64
  %sums_queue14 = getelementptr inbounds nuw [32 x i8], ptr %sums_queue1134, i64 %2
  store i32 0, ptr %sums_queue14, align 16, !tbaa !0
  %.splatinsert = insertelement <16 x i32> poison, i32 %"@8.count56", i64 0
  %.splat = shufflevector <16 x i32> %.splatinsert, <16 x i32> poison, <16 x i32> zeroinitializer
  %extract23.fca.1.gep = getelementptr inbounds nuw i8, ptr %extract_ptr55, i64 8
  %extract23.fca.2.gep = getelementptr inbounds nuw i8, ptr %extract_ptr55, i64 16
  %extract23.fca.3.gep = getelementptr inbounds nuw i8, ptr %extract_ptr55, i64 24
  %3 = getelementptr inbounds nuw i8, ptr %sums_queue14, i64 8
  %4 = getelementptr inbounds nuw i8, ptr %sums_queue14, i64 16
  %5 = getelementptr inbounds nuw i8, ptr %sums_queue14, i64 24
  br label %"sums!run_step_sums_lane"

"sums!round.preheader":                           ; preds = %walk.exit
  %"@8.count53" = load i32, ptr %sums_queue1134, align 16
  %6 = icmp eq i32 %"@8.count53", 0
  br i1 %6, label %"!par_cont_1", label %"sums!batch"

"!par_body_0":                                    ; preds = %run, %walk.exit
  %indvars.iv = phi i64 [ 0, %run ], [ %indvars.iv.next, %walk.exit ]
  %mulhi_wide = mul nsw i64 %indvars.iv, -1840700269
  %mulhi_high = lshr i64 %mulhi_wide, 32
  %mulhi = trunc nuw i64 %mulhi_high to i32
  %7 = trunc nuw nsw i64 %indvars.iv to i32
  %8 = add i32 %7, %mulhi
  %9 = ashr i32 %8, 2
  %10 = lshr i32 %8, 31
  %11 = add nsw i32 %9, %10
  %.neg = mul i32 %11, -7
  %12 = add i32 %.neg, %7
  %13 = icmp slt i32 %12, 1
  br i1 %13, label %"!then_0.i", label %"!merge_1.i"

"!then_0.i":                                      ; preds = %"!par_body_0"
  %out14.i = getelementptr inbounds nuw [4 x i8], ptr %out, i64 %indvars.iv
  store i32 0, ptr %out14.i, align 4, !tbaa !3
  br label %walk.exit

"!merge_1.i":                                     ; preds = %"!par_body_0"
  %14 = add nsw i32 %12, -1
  %15 = atomicrmw add ptr %sums_queue1134, i32 1 monotonic, align 4
  %16 = sext i32 %15 to i64
  %"@9.i" = getelementptr inbounds [4 x i8], ptr %sums_n_040, i64 %16
  store i32 %14, ptr %"@9.i", align 4, !tbaa !3
  %"@12.i" = getelementptr inbounds [4 x i8], ptr %sums_acc_039, i64 %16
  store i32 %12, ptr %"@12.i", align 4, !tbaa !3
  %"@15.i" = getelementptr inbounds [4 x i8], ptr %sums_i_038, i64 %16
  store i32 %7, ptr %"@15.i", align 4, !tbaa !3
  br label %walk.exit

walk.exit:                                        ; preds = %"!then_0.i", %"!merge_1.i"
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, 40
  br i1 %exitcond.not, label %"sums!round.preheader", label %"!par_body_0", !prof !5

sums_gang1_pf_exit:                               ; preds = %"sums!run_yield_sums_gang"
  %17 = add i32 %"sums!round254", 1
  %18 = and i32 %17, 1
  %19 = zext nneg i32 %18 to i64
  %extract_ptr = getelementptr inbounds nuw [32 x i8], ptr %sums_queue1134, i64 %19
  %"@8.count" = load i32, ptr %extract_ptr, align 16
  %20 = icmp eq i32 %"@8.count", 0
  br i1 %20, label %"!par_cont_1", label %"sums!batch"

"sums!run_step_sums_lane":                        ; preds = %"sums!batch", %"sums!run_yield_sums_gang"
  %sums_gang52 = phi i32 [ 0, %"sums!batch" ], [ %37, %"sums!run_yield_sums_gang" ]
  %.splatinsert20 = insertelement <16 x i32> poison, i32 %sums_gang52, i64 0
  %.splat21 = shufflevector <16 x i32> %.splatinsert20, <16 x i32> poison, <16 x i32> zeroinitializer
  %21 = or disjoint <16 x i32> %.splat21, <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %22 = icmp ult <16 x i32> %21, %.splat
  %23 = bitcast <16 x i1> %22 to i16
  %.not = icmp eq i16 %23, 0
  br i1 %.not, label %"sums!run_yield_sums_gang", label %"sums!run"

"sums!run":                                       ; preds = %"sums!run_step_sums_lane"
  %extract23.fca.1.load = load ptr, ptr %extract23.fca.1.gep, align 8
  %extract23.fca.2.load = load ptr, ptr %extract23.fca.2.gep, align 8
  %extract23.fca.3.load = load ptr, ptr %extract23.fca.3.gep, align 8
  %24 = sext i32 %sums_gang52 to i64
  %extract_base = getelementptr inbounds [4 x i8], ptr %extract23.fca.1.load, i64 %24
  %extract24 = call <16 x i32> @llvm.masked.load.v16i32.p0(ptr align 4 %extract_base, <16 x i1> %22, <16 x i32> zeroinitializer)
  %extract_base27 = getelementptr inbounds [4 x i8], ptr %extract23.fca.2.load, i64 %24
  %extract28 = call <16 x i32> @llvm.masked.load.v16i32.p0(ptr align 4 %extract_base27, <16 x i1> %22, <16 x i32> zeroinitializer)
  %extract_base32 = getelementptr inbounds [4 x i8], ptr %extract23.fca.3.load, i64 %24
  %extract33 = call <16 x i32> @llvm.masked.load.v16i32.p0(ptr align 4 %extract_base32, <16 x i1> %22, <16 x i32> zeroinitializer)
  %25 = icmp slt <16 x i32> %extract24, splat (i32 1)
  %not..i = xor <16 x i1> %25, splat (i1 true)
  %26 = and <16 x i1> %22, %not..i
  %27 = and <16 x i1> %22, %25
  %28 = bitcast <16 x i1> %27 to i16
  %.not.i = icmp eq i16 %28, 0
  br i1 %.not.i, label %"!merge_1!any.i", label %"!then_0.i41"

"!then_0.i41":                                    ; preds = %"sums!run"
  %29 = sext <16 x i32> %extract33 to <16 x i64>
  %store_ptrs.i = getelementptr inbounds [4 x i8], ptr %out, <16 x i64> %29
  call void @llvm.masked.scatter.v16i32.v16p0(<16 x i32> %extract28, <16 x ptr> align 4 %store_ptrs.i, <16 x i1> %27)
  br label %"!merge_1!any.i"

"!merge_1!any.i":                                 ; preds = %"!then_0.i41", %"sums!run"
  %30 = bitcast <16 x i1> %26 to i16
  %.not6.i = icmp eq i16 %30, 0
  br i1 %.not6.i, label %"sums!run_yield_sums_gang", label %"!merge_1.i42"

"!merge_1.i42":                                   ; preds = %"!merge_1!any.i"
  %31 = add <16 x i32> %extract24, splat (i32 -1)
  %32 = add <16 x i32> %extract28, %extract24
  %33 = call range(i16 1, 17) i16 @llvm.ctpop.i16(i16 %30)
  %34 = zext nneg i16 %33 to i32
  %35 = atomicrmw add ptr %sums_queue14, i32 %34 monotonic, align 4
  %n1.i = load ptr, ptr %3, align 8
  %36 = sext i32 %35 to i64
  %"@19.i" = getelementptr inbounds [4 x i8], ptr %n1.i, i64 %36
  call void @llvm.masked.compressstore.v16i32.p0(<16 x i32> %31, ptr align 4 %"@19.i", <16 x i1> %26)
  %acc3.i = load ptr, ptr %4, align 16
  %"@22.i" = getelementptr inbounds [4 x i8], ptr %acc3.i, i64 %36
  call void @llvm.masked.compressstore.v16i32.p0(<16 x i32> %32, ptr align 4 %"@22.i", <16 x i1> %26)
  %i5.i = load ptr, ptr %5, align 8
  %"@25.i" = getelementptr inbounds [4 x i8], ptr %i5.i, i64 %36
  call void @llvm.masked.compressstore.v16i32.p0(<16 x i32> %extract33, ptr align 4 %"@25.i", <16 x i1> %26)
  br label %"sums!run_yield_sums_gang"

"sums!run_yield_sums_gang":                       ; preds = %"!merge_1.i42", %"!merge_1!any.i", %"sums!run_step_sums_lane"
  %37 = add i32 %sums_gang52, 16
  %38 = icmp ult i32 %37, %"@8.count56"
  br i1 %38, label %"sums!run_step_sums_lane", label %sums_gang1_pf_exit, !prof !6
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: read)
declare <16 x i32> @llvm.masked.load.v16i32.p0(ptr captures(none), <16 x i1>, <16 x i32>) #0

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: write)
declare void @llvm.masked.compressstore.v16i32.p0(<16 x i32>, ptr captures(none), <16 x i1>) #1

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(write)
declare void @llvm.masked.scatter.v16i32.v16p0(<16 x i32>, <16 x ptr>, <16 x i1>) #2

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare i16 @llvm.ctpop.i16(i16) #3

attributes #0 = { mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: read) }
attributes #1 = { mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: write) }
attributes #2 = { mustprogress nocallback nofree nosync nounwind willreturn memory(write) }
attributes #3 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }

!0 = !{!1, !1, i64 0}
!1 = !{!"u32", !2, i64 0}
!2 = !{!"bonsai"}
!3 = !{!4, !4, i64 0}
!4 = !{!"i32", !2, i64 0}
!5 = !{!"branch_weights", i32 0, i32 1073741824}
!6 = !{!"branch_weights", i32 1073741824, i32 0}
