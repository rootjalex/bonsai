; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define <8 x i8> @sat_add(<8 x i8> noundef %x, <8 x i8> noundef %y) {
sat_add_entry:
  %0 = sext <8 x i8> %x to <8 x i16>
  %1 = sext <8 x i8> %y to <8 x i16>
  %2 = add <8 x i16> %0, %1
  %3 = call <8 x i16> @llvm.smin.v8i16(<8 x i16> %2, <8 x i16> <i16 127, i16 127, i16 127, i16 127, i16 127, i16 127, i16 127, i16 127>)
  %4 = call <8 x i16> @llvm.smax.v8i16(<8 x i16> %3, <8 x i16> <i16 -128, i16 -128, i16 -128, i16 -128, i16 -128, i16 -128, i16 -128, i16 -128>)
  %5 = trunc <8 x i16> %4 to <8 x i8>
  ret <8 x i8> %5
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare <8 x i16> @llvm.smin.v8i16(<8 x i16>, <8 x i16>) #0

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare <8 x i16> @llvm.smax.v8i16(<8 x i16>, <8 x i16>) #0

attributes #0 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
