; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite)
define void @divide(ptr nofree noundef readonly captures(none) %a, ptr nofree noundef readonly captures(none) %b, ptr nofree noundef writeonly captures(none) initializes((0, 32)) %q, ptr nofree noundef writeonly captures(none) initializes((0, 32)) %r) local_unnamed_addr #0 {
divide:
  %extract = load <8 x i32>, ptr %a, align 4
  %extract6 = load <8 x i32>, ptr %b, align 4
  %0 = uitofp <8 x i32> %extract to <8 x double>
  %1 = uitofp <8 x i32> %extract6 to <8 x double>
  %2 = fdiv <8 x double> %0, %1
  %quotient = fptoui <8 x double> %2 to <8 x i32>
  store <8 x i32> %quotient, ptr %q, align 4
  %3 = mul <8 x i32> %extract6, %quotient
  %remainder = sub <8 x i32> %extract, %3
  store <8 x i32> %remainder, ptr %r, align 4
  ret void
}

