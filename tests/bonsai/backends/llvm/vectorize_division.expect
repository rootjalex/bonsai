; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @bounded(ptr noundef %a_buffer, ptr noundef %b_buffer, ptr noundef %q_buffer) local_unnamed_addr {
bounded:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %b = tail call ptr @bonsai_buffer_require(ptr %b_buffer, i32 1)
  %q = tail call ptr @bonsai_buffer_require(ptr %q_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %q_buffer, i32 1)
  %extract = load <8 x i32>, ptr %a, align 4
  %0 = and <8 x i32> %extract, splat (i32 65535)
  %extract5 = load <8 x i32>, ptr %b, align 4
  %1 = and <8 x i32> %extract5, splat (i32 255)
  %2 = add nuw nsw <8 x i32> %1, splat (i32 1)
  %3 = uitofp nneg <8 x i32> %0 to <8 x float>
  %4 = uitofp nneg <8 x i32> %2 to <8 x float>
  %5 = fdiv <8 x float> %3, %4
  %6 = fptoui <8 x float> %5 to <8 x i32>
  store <8 x i32> %6, ptr %q, align 4
  ret void
}

define void @divide(ptr noundef %a_buffer, ptr noundef %b_buffer, ptr noundef %q_buffer, ptr noundef %r_buffer) local_unnamed_addr {
divide:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %b = tail call ptr @bonsai_buffer_require(ptr %b_buffer, i32 1)
  %q = tail call ptr @bonsai_buffer_require(ptr %q_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %q_buffer, i32 1)
  %r = tail call ptr @bonsai_buffer_require(ptr %r_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %r_buffer, i32 1)
  %extract = load <8 x i32>, ptr %a, align 4
  %extract6 = load <8 x i32>, ptr %b, align 4
  %0 = uitofp <8 x i32> %extract to <8 x double>
  %1 = uitofp <8 x i32> %extract6 to <8 x double>
  %2 = fdiv <8 x double> %0, %1
  %quotient = fptoui <8 x double> %2 to <8 x i32>
  store <8 x i32> %quotient, ptr %q, align 4
  %3 = mul <8 x i32> %extract6, %quotient
  %remainder = sub <8 x i32> %extract, %3
  store <8 x i32> %remainder, ptr %r, align 4
  ret void
}

define void @divide_signed(ptr noundef %a_buffer, ptr noundef %b_buffer, ptr noundef %q_buffer) local_unnamed_addr {
divide_signed:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %b = tail call ptr @bonsai_buffer_require(ptr %b_buffer, i32 1)
  %q = tail call ptr @bonsai_buffer_require(ptr %q_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %q_buffer, i32 1)
  %extract = load <8 x i32>, ptr %a, align 4
  %extract5 = load <8 x i32>, ptr %b, align 4
  %0 = sitofp <8 x i32> %extract to <8 x double>
  %1 = sitofp <8 x i32> %extract5 to <8 x double>
  %2 = fdiv <8 x double> %0, %1
  %quotient = fptosi <8 x double> %2 to <8 x i32>
  store <8 x i32> %quotient, ptr %q, align 4
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef i32 @scalar(i32 noundef %a, i32 noundef %b) local_unnamed_addr #0 {
scalar:
  %0 = udiv i32 %a, %b
  ret i32 %0
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
