//! flags: -b llvm

func [[export]]reti32(i : i32) = i + 2;

func [[export]]ret_zero() -> i32 = 0;

func [[export]]ret_fzero() -> f32 = 0;

func [[export]]ret_fone() -> f32 = 1;

func [[export]]ret_f32x4(x : vector[f32, 4]) = x + 2;

func [[export]]a(x : u32) = x + 5u;

func [[export]]b(x : f64) = x + 3.0;

func [[export]]c(x : f64) = x + 3;

func [[export]]d(x : f16) = x + 3;
