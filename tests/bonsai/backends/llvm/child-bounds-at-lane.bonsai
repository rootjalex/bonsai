//! flags: -p ssa -b llvm

// ssa/child-bounds-at-lane.bonsai at the LLVM level: a child's box read at
// the children loop's counter, out of a node that holds its children's boxes
// by component (Embree's AABBNode<8>), with the children tested one at a
// time. What to read for, in the children loop of the loopified any hit:
// each component of the child's box is a scalar `load float` through a
// `getelementptr` into the row's own vector at the loop's index -- the six
// of them, and nothing else of the row's bounds -- as Embree's
// `node->lower_x[i]` is one load. Before, the row's six `<8 x float>`
// vectors were loaded whole and each read with `extractelement ... i32 %i`
// at the loop's index, which the x86 backend can only do through the stack:
// six stores before the loop's body and six loads in it, every child.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

schedule {
    tree[[Triangle]] BVH8 =
    | Interior(children : array[BVH8, 8], lo hi : vector[vec3f, 8])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH8;

    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 8];
                lower_x : vector[f32, 8];
                upper_x : vector[f32, 8];
                lower_y : vector[f32, 8];
                upper_y : vector[f32, 8];
                lower_z : vector[f32, 8];
                upper_z : vector[f32, 8];
                lo = vector[vec3f, 8]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 8]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    occluded.loopify(64);
}
