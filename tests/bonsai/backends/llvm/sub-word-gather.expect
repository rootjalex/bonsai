  br label %extract_after

extract_after:                                    ; preds = %extract_lanes, %extract_words
  %extract6 = phi <8 x i8> [ %extract4, %extract_words ], [ %extract5, %extract_lanes ]
  %6 = zext <8 x i8> %extract6 to <8 x i32>
