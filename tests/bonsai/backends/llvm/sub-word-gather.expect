; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @read_bytes(i32 noundef %n, ptr noundef %table_buffer, ptr noundef %which_buffer, ptr noundef %out_buffer) local_unnamed_addr {
read_bytes:
  %table = tail call ptr @bonsai_buffer_require(ptr %table_buffer, i32 1)
  %which = tail call ptr @bonsai_buffer_require(ptr %which_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %which, align 4
  %0 = icmp ugt i32 %n, 3
  br i1 %0, label %extract_words, label %extract_lanes

extract_words:                                    ; preds = %read_bytes
  %extract_aligned = and <8 x i32> %extract, splat (i32 -4)
  %.scalar = add i32 %n, -4
  %1 = insertelement <8 x i32> poison, i32 %.scalar, i64 0
  %extract_last = shufflevector <8 x i32> %1, <8 x i32> poison, <8 x i32> zeroinitializer
  %extract_word_at = tail call <8 x i32> @llvm.umin.v8i32(<8 x i32> %extract_aligned, <8 x i32> %extract_last)
  %2 = sext <8 x i32> %extract_word_at to <8 x i64>
  %extract_word_ptrs = getelementptr inbounds i8, ptr %table, <8 x i64> %2
  %extract_word = tail call <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr> align 1 %extract_word_ptrs, <8 x i1> splat (i1 true), <8 x i32> poison)
  %3 = sub <8 x i32> %extract, %extract_word_at
  %extract_shift = shl <8 x i32> %3, splat (i32 3)
  %4 = lshr <8 x i32> %extract_word, %extract_shift
  %extract4 = trunc <8 x i32> %4 to <8 x i8>
  br label %extract_after

extract_lanes:                                    ; preds = %read_bytes
  %5 = sext <8 x i32> %extract to <8 x i64>
  %extract_ptrs = getelementptr inbounds i8, ptr %table, <8 x i64> %5
  %extract5 = tail call <8 x i8> @llvm.masked.gather.v8i8.v8p0(<8 x ptr> align 1 %extract_ptrs, <8 x i1> splat (i1 true), <8 x i8> poison)
  br label %extract_after

extract_after:                                    ; preds = %extract_lanes, %extract_words
  %extract6 = phi <8 x i8> [ %extract4, %extract_words ], [ %extract5, %extract_lanes ]
  %6 = zext <8 x i8> %extract6 to <8 x i32>
  store <8 x i32> %6, ptr %out, align 4
  ret void
}

define void @read_halfwords(ptr noundef %table_buffer, ptr noundef %which_buffer, ptr noundef %out_buffer) local_unnamed_addr {
read_halfwords:
  %table = tail call ptr @bonsai_buffer_require(ptr %table_buffer, i32 1)
  %which = tail call ptr @bonsai_buffer_require(ptr %which_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %which, align 4
  %extract_off = shl <8 x i32> %extract, splat (i32 1)
  %extract_aligned = and <8 x i32> %extract_off, splat (i32 -4)
  %extract_word_at = tail call <8 x i32> @llvm.umin.v8i32(<8 x i32> %extract_aligned, <8 x i32> splat (i32 18))
  %0 = zext nneg <8 x i32> %extract_word_at to <8 x i64>
  %extract_word_ptrs = getelementptr inbounds nuw i8, ptr %table, <8 x i64> %0
  %extract_word = tail call <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr> align 2 %extract_word_ptrs, <8 x i1> splat (i1 true), <8 x i32> poison)
  %1 = sub <8 x i32> %extract_off, %extract_word_at
  %extract_shift = shl <8 x i32> %1, splat (i32 3)
  %2 = lshr <8 x i32> %extract_word, %extract_shift
  %3 = and <8 x i32> %2, splat (i32 65535)
  store <8 x i32> %3, ptr %out, align 4
  ret void
}

define void @read_nodes(ptr noundef %nodes_buffer, ptr noundef %which_buffer, ptr noundef %out_buffer) local_unnamed_addr {
read_nodes:
  %nodes = tail call ptr @bonsai_buffer_require(ptr %nodes_buffer, i32 1)
  %which = tail call ptr @bonsai_buffer_require(ptr %which_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %which, align 4
  %extract_off = mul <8 x i32> %extract, splat (i32 12)
  %0 = sext <8 x i32> %extract_off to <8 x i64>
  %extract_n_prims_word_ptrs = getelementptr inbounds i8, ptr %nodes, <8 x i64> %0
  %extract_n_prims_word = tail call <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr> align 4 %extract_n_prims_word_ptrs, <8 x i1> splat (i1 true), <8 x i32> poison)
  %1 = lshr <8 x i32> %extract_n_prims_word, splat (i32 16)
  %2 = lshr <8 x i32> %extract_n_prims_word, splat (i32 24)
  %extract_flip_word_base = getelementptr inbounds nuw i8, ptr %nodes, i64 4
  %extract_flip_word_ptrs = getelementptr inbounds i8, ptr %extract_flip_word_base, <8 x i64> %0
  %extract_flip_word = tail call <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr> align 4 %extract_flip_word_ptrs, <8 x i1> splat (i1 true), <8 x i32> poison)
  %3 = and <8 x i32> %extract_n_prims_word, splat (i32 65535)
  %4 = and <8 x i32> %1, splat (i32 255)
  %5 = and <8 x i32> %extract_flip_word, splat (i32 1)
  %6 = add nuw nsw <8 x i32> %2, %3
  %7 = add nuw nsw <8 x i32> %6, %4
  %8 = add nuw nsw <8 x i32> %7, %5
  store <8 x i32> %8, ptr %out, align 4
  ret void
}

define void @read_tails(ptr noundef %tails_buffer, ptr noundef %which_buffer, ptr noundef %out_buffer) local_unnamed_addr {
read_tails:
  %tails = tail call ptr @bonsai_buffer_require(ptr %tails_buffer, i32 1)
  %which = tail call ptr @bonsai_buffer_require(ptr %which_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %which, align 4
  %extract_off = mul <8 x i32> %extract, splat (i32 5)
  %extract_tag_word_base = getelementptr inbounds nuw i8, ptr %tails, i64 1
  %0 = sext <8 x i32> %extract_off to <8 x i64>
  %extract_tag_word_ptrs = getelementptr inbounds i8, ptr %extract_tag_word_base, <8 x i64> %0
  %extract_tag_word = tail call <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr> align 1 %extract_tag_word_ptrs, <8 x i1> splat (i1 true), <8 x i32> poison)
  %1 = lshr <8 x i32> %extract_tag_word, splat (i32 24)
  store <8 x i32> %1, ptr %out, align 4
  ret void
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

; Function Attrs: mustprogress nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare <8 x i32> @llvm.umin.v8i32(<8 x i32>, <8 x i32>) #0

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(read)
declare <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr>, <8 x i1>, <8 x i32>) #1

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(read)
declare <8 x i8> @llvm.masked.gather.v8i8.v8p0(<8 x ptr>, <8 x i1>, <8 x i8>) #1

attributes #0 = { mustprogress nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
attributes #1 = { mustprogress nocallback nofree nosync nounwind willreturn memory(read) }
