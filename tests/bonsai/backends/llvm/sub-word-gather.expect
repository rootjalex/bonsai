  %extract_shift = shl <8 x i32> %3, <i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3>
  %4 = lshr <8 x i32> %extract_word, %extract_shift
  %extract4 = trunc <8 x i32> %4 to <8 x i8>
