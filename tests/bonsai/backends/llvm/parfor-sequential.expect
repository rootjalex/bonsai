define void @add_one(ptr nocapture noundef readonly %a, ptr nocapture noundef writeonly %out) local_unnamed_addr #0 {
add_one_entry:
  %extract = load float, ptr %a, align 4
  %0 = fadd float %extract, 1.000000e+00
  store float %0, ptr %out, align 4, !tbaa !0
  %extract_ptr.1 = getelementptr inbounds i8, ptr %a, i64 4
  %extract.1 = load float, ptr %extract_ptr.1, align 4
  %1 = fadd float %extract.1, 1.000000e+00
  %out1.1 = getelementptr inbounds i8, ptr %out, i64 4
  store float %1, ptr %out1.1, align 4, !tbaa !0
  %extract_ptr.2 = getelementptr inbounds i8, ptr %a, i64 8
  %extract.2 = load float, ptr %extract_ptr.2, align 4
  %2 = fadd float %extract.2, 1.000000e+00
  %out1.2 = getelementptr inbounds i8, ptr %out, i64 8
  store float %2, ptr %out1.2, align 4, !tbaa !0
  %extract_ptr.3 = getelementptr inbounds i8, ptr %a, i64 12
  %extract.3 = load float, ptr %extract_ptr.3, align 4
  %3 = fadd float %extract.3, 1.000000e+00
  %out1.3 = getelementptr inbounds i8, ptr %out, i64 12
  store float %3, ptr %out1.3, align 4, !tbaa !0
  %extract_ptr.4 = getelementptr inbounds i8, ptr %a, i64 16
  %extract.4 = load float, ptr %extract_ptr.4, align 4
  %4 = fadd float %extract.4, 1.000000e+00
  %out1.4 = getelementptr inbounds i8, ptr %out, i64 16
  store float %4, ptr %out1.4, align 4, !tbaa !0
  %extract_ptr.5 = getelementptr inbounds i8, ptr %a, i64 20
  %extract.5 = load float, ptr %extract_ptr.5, align 4
  %5 = fadd float %extract.5, 1.000000e+00
  %out1.5 = getelementptr inbounds i8, ptr %out, i64 20
  store float %5, ptr %out1.5, align 4, !tbaa !0
  %extract_ptr.6 = getelementptr inbounds i8, ptr %a, i64 24
  %extract.6 = load float, ptr %extract_ptr.6, align 4
  %6 = fadd float %extract.6, 1.000000e+00
  %out1.6 = getelementptr inbounds i8, ptr %out, i64 24
  store float %6, ptr %out1.6, align 4, !tbaa !0
  %extract_ptr.7 = getelementptr inbounds i8, ptr %a, i64 28
  %extract.7 = load float, ptr %extract_ptr.7, align 4
