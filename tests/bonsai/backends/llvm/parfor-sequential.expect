define void @scale(i32 noundef %n, ptr nocapture noundef readonly %a, ptr nocapture noundef writeonly %out) local_unnamed_addr #1 {
scale_entry:
  %0 = icmp sgt i32 %n, 0
  br i1 %0, label %i1_for.preheader, label %i1_for_end, !prof !3

i1_for.preheader:                                 ; preds = %scale_entry
  %out2 = ptrtoint ptr %out to i64
  %a3 = ptrtoint ptr %a to i64
  %min.iters.check = icmp ult i32 %n, 8
  %1 = sub i64 %out2, %a3
  %diff.check = icmp ult i64 %1, 32
  %or.cond = or i1 %min.iters.check, %diff.check
  br i1 %or.cond, label %i1_for.preheader5, label %vector.ph

vector.ph:                                        ; preds = %i1_for.preheader
  %n.vec = and i32 %n, 2147483640
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index = phi i32 [ 0, %vector.ph ], [ %index.next, %vector.body ]
  %2 = zext nneg i32 %index to i64
  %3 = getelementptr inbounds float, ptr %a, i64 %2
  %4 = getelementptr inbounds i8, ptr %3, i64 16
  %wide.load = load <4 x float>, ptr %3, align 4
  %wide.load4 = load <4 x float>, ptr %4, align 4
  %5 = fmul <4 x float> %wide.load, <float 3.000000e+00, float 3.000000e+00, float 3.000000e+00, float 3.000000e+00>
  %6 = fmul <4 x float> %wide.load4, <float 3.000000e+00, float 3.000000e+00, float 3.000000e+00, float 3.000000e+00>
  %7 = getelementptr inbounds float, ptr %out, i64 %2
  %8 = getelementptr inbounds i8, ptr %7, i64 16
  store <4 x float> %5, ptr %7, align 4, !tbaa !0
  store <4 x float> %6, ptr %8, align 4, !tbaa !0
  %index.next = add nuw i32 %index, 8
  %9 = icmp eq i32 %index.next, %n.vec
  br i1 %9, label %middle.block, label %vector.body, !llvm.loop !4

middle.block:                                     ; preds = %vector.body
  %cmp.n = icmp eq i32 %n.vec, %n
  br i1 %cmp.n, label %i1_for_end, label %i1_for.preheader5

i1_for.preheader5:                                ; preds = %middle.block, %i1_for.preheader
  %.ph = phi i32 [ 0, %i1_for.preheader ], [ %n.vec, %middle.block ]
  br label %i1_for

i1_for:                                           ; preds = %i1_for.preheader5, %i1_for
  %10 = phi i32 [ %13, %i1_for ], [ %.ph, %i1_for.preheader5 ]
  %11 = zext nneg i32 %10 to i64
  %extract_ptr = getelementptr inbounds float, ptr %a, i64 %11
  %extract = load float, ptr %extract_ptr, align 4
  %12 = fmul float %extract, 3.000000e+00
  %out1 = getelementptr inbounds float, ptr %out, i64 %11
  store float %12, ptr %out1, align 4, !tbaa !0
  %13 = add nuw nsw i32 %10, 1
  %.not = icmp slt i32 %13, %n
  br i1 %.not, label %i1_for, label %i1_for_end, !llvm.loop !7

i1_for_end:                                       ; preds = %i1_for, %middle.block, %scale_entry
  ret void
}

