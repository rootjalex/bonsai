; Function Attrs: mustprogress
define float @first(i32 noundef %i, <8 x i32> noundef %m, ptr noundef %rows_buffer) local_unnamed_addr #0 {
first:
  %rows = tail call ptr @bonsai_buffer_require(ptr %rows_buffer, i32 1)
  %0 = icmp ne <8 x i32> %m, zeroinitializer
  %1 = bitcast <8 x i1> %0 to i8
  %2 = tail call range(i8 0, 9) i8 @llvm.cttz.i8(i8 %1, i1 false)
  %i_wide = zext i32 %i to i64
  %ptr_array_deref = getelementptr inbounds nuw [32 x i8], ptr %rows, i64 %i_wide
  %_wide = zext nneg i8 %2 to i64
  %extract_ptr = getelementptr inbounds nuw [4 x i8], ptr %ptr_array_deref, i64 %_wide
  %extract = load float, ptr %extract_ptr, align 4, !invariant.load !0
  ret float %extract
}

