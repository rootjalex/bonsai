define float @pick(i32 noundef %i, i32 noundef %lane, ptr noundef %rows_buffer) local_unnamed_addr #0 {
pick:
  %rows = tail call ptr @bonsai_buffer_require(ptr %rows_buffer, i32 1)
  %i_wide = zext i32 %i to i64
  %ptr_array_deref = getelementptr inbounds nuw [32 x i8], ptr %rows, i64 %i_wide
  %lane_wide = zext i32 %lane to i64
  %extract_ptr = getelementptr inbounds nuw [4 x i8], ptr %ptr_array_deref, i64 %lane_wide
  %extract = load float, ptr %extract_ptr, align 4, !invariant.load !0
