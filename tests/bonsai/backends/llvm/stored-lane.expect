; Function Attrs: mustprogress
define float @two(i32 noundef %i, <8 x i32> noundef %m, ptr noundef %rows_buffer) local_unnamed_addr #0 {
two:
  %rows = tail call ptr @bonsai_buffer_require(ptr %rows_buffer, i32 1)
  %i_wide = zext i32 %i to i64
  %extract_ptr = getelementptr inbounds nuw [32 x i8], ptr %rows, i64 %i_wide
  %extract = load <8 x float>, ptr %extract_ptr, align 32, !invariant.load !0
  %0 = icmp ne <8 x i32> %m, zeroinitializer
  %compress = tail call <8 x float> @llvm.experimental.vector.compress.v8f32(<8 x float> %extract, <8 x i1> %0, <8 x float> poison)
  %1 = extractelement <8 x float> %compress, i64 0
  %2 = extractelement <8 x float> %compress, i64 1
  %3 = fadd float %1, %2
  ret float %3
}

