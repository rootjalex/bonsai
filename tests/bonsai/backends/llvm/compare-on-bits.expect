; Function Attrs: mustprogress
define void @gang(ptr noundef %as_buffer, ptr noundef %ns_buffer, float noundef %z, ptr noundef %out_buffer) local_unnamed_addr #0 {
gang:
  %as = tail call ptr @bonsai_buffer_require(ptr %as_buffer, i32 1)
  %ns = tail call ptr @bonsai_buffer_require(ptr %ns_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  %0 = fcmp ule float %z, 0.000000e+00
  br i1 %0, label %common.ret, label %"!par_body_2"

common.ret:                                       ; preds = %gang, %"!par_body_2"
  ret void

"!par_body_2":                                    ; preds = %gang
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %as, align 4
  %1 = tail call <8 x float> @llvm.fabs.v8f32(<8 x float> %extract)
  %extract10 = load <8 x i32>, ptr %ns, align 4
  %2 = uitofp <8 x i32> %extract10 to <8 x float>
  %3 = bitcast <8 x float> %1 to <8 x i32>
  %4 = bitcast <8 x float> %2 to <8 x i32>
  %5 = bitcast float %z to i32
  %6 = add nsw i32 %5, -1
  %.splatinsert = insertelement <8 x i32> poison, i32 %6, i64 0
  %.splat = shufflevector <8 x i32> %.splatinsert, <8 x i32> poison, <8 x i32> zeroinitializer
  %7 = tail call <8 x i32> @llvm.smin.v8i32(<8 x i32> %4, <8 x i32> %.splat)
  %8 = icmp sge <8 x i32> %7, %3
  %store_bytes = zext <8 x i1> %8 to <8 x i8>
  store <8 x i8> %store_bytes, ptr %out, align 1
  br label %common.ret
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define i1 @joined(float noundef %a, i32 noundef %n, float noundef %z) local_unnamed_addr #1 {
joined:
  %0 = fcmp ule float %z, 0.000000e+00
  br i1 %0, label %common.ret, label %"!merge_1"

common.ret:                                       ; preds = %joined, %"!merge_1"
  %common.ret.op = phi i1 [ %8, %"!merge_1" ], [ false, %joined ]
  ret i1 %common.ret.op

"!merge_1":                                       ; preds = %joined
  %1 = tail call float @llvm.fabs.f32(float %a)
  %2 = uitofp i32 %n to float
  %3 = bitcast float %1 to i32
  %4 = bitcast float %2 to i32
  %5 = bitcast float %z to i32
  %6 = add nsw i32 %5, -1
  %7 = tail call i32 @llvm.smin.i32(i32 %4, i32 %6)
  %8 = icmp sge i32 %7, %3
  br label %common.ret
}

