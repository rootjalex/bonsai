; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @scale_all(ptr noundef %a_buffer, float noundef %scale, ptr noundef %out_buffer) local_unnamed_addr {
scale_all:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %.splatinsert = insertelement <8 x float> poison, float %scale, i64 0
  %.splat = shufflevector <8 x float> %.splatinsert, <8 x float> poison, <8 x i32> zeroinitializer
  %0 = fmul <8 x float> %.splat, %extract
  store <8 x float> %0, ptr %out, align 4
  ret void
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr
