//! flags: -p ssa -b llvm

// ssa/vectorize-packet-wide.bonsai at the LLVM level: the packet traversal
// of a wide node, a gang of eight rays over a BVH whose nodes hold their
// children's boxes. What to look for, against vectorize_packet_traversal
// (the binary tree's packet): the stack is `[64 x i32]` of nodes, `[64 x
// <8 x float>]` of the lanes' bounds and `[64 x <8 x i1>]` of masks; each
// node's row is loaded once and its four boxes tested against the eight
// rays as vectors; each child's mask is the node's mask `and`ed with its
// box test, `or`ed together for the one test in front of the pushes; the
// sort's comparisons are `llvm.ctpop` counts of the lanes that are on,
// compared, one decision for the gang per compare-and-swap of the network.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/triangle;

extern tris : set[Triangle];

func trace(r : Ray) =
    argmin(|t : Triangle| distmin(r, t),
           filter(|t : Triangle| intersects(r, t), tris));

func hit_x(r : Ray) -> f32 {
    h = trace(r);
    if !h {
        return -1.0;
    }
    t = *h;
    return t.p0.x;
}

func [[export]] hit_x_all(rs : array[Ray, 8], out : mut array[f32, 8]) {
    parfor i in 0:8 {
        out[i] = hit_x(rs[i]);
    }
    return;
}

func entry(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        if extract.low < r.tmax && extract.high > 0.0 {
            return extract.low;
        }
    }
    return inf;
}

schedule {
    tree[[Triangle]] BVH4 =
    | Interior(children : array[BVH4, 4], lo hi : vector[vec3f, 4])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH4;

    layout tris {
        pCount : u32;
        prims : array[Triangle, pCount];
        nCount : u32;
        indirect group Nodes[nCount] row : u32 {
            children : vector[u32, 4];
            lo : vector[vec3f, 4];
            hi : vector[vec3f, 4];
        };
        group[nCount] ref : u32 {
            kind = ref & 15u;
            switch kind {
                0 => Interior from Nodes[ref >> 4];
                _ => Leaf { data = range(prims, ref >> 4, kind - 8u); };
            };
        };
    };

    hit_x_all.vectorize(i);
    trace.sort(tris.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               entry(r, AABB{lo[i], hi[i]}))
         .loopify(64);
}
