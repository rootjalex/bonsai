; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define <4 x float> @at(ptr noundef %table_buffer, <4 x i32> noundef %o) local_unnamed_addr {
at:
  %table = tail call ptr @bonsai_buffer_require(ptr %table_buffer, i32 1)
  %0 = sext <4 x i32> %o to <4 x i64>
  %extract_ptrs = getelementptr inbounds [4 x i8], ptr %table, <4 x i64> %0
  %extract = tail call <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr> align 4 %extract_ptrs, <4 x i1> splat (i1 true), <4 x float> poison)
  ret <4 x float> %extract
}

define void @guarded(ptr noundef %table_buffer, ptr noundef %first_buffer, ptr noundef %out_buffer) local_unnamed_addr {
guarded:
  %table = tail call ptr @bonsai_buffer_require(ptr %table_buffer, i32 1)
  %first = tail call ptr @bonsai_buffer_require(ptr %first_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %first, align 4
  %0 = icmp sgt <8 x i32> %extract, splat (i32 -1)
  %not. = xor <8 x i1> %0, splat (i1 true)
  %1 = bitcast <8 x i1> %0 to i8
  %.not = icmp eq i8 %1, 0
  br i1 %.not, label %"!else_3!any", label %"!then_2"

"!then_2":                                        ; preds = %guarded
  %2 = add <8 x i32> %extract, splat (i32 1)
  %3 = add <8 x i32> %extract, splat (i32 2)
  %4 = add <8 x i32> %extract, splat (i32 3)
  %5 = sext <8 x i32> %extract to <8 x i64>
  %extract_ptrs = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %5
  %extract4 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs, <8 x i1> %0, <8 x float> zeroinitializer)
  %6 = sext <8 x i32> %2 to <8 x i64>
  %extract_ptrs5 = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %6
  %extract6 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs5, <8 x i1> %0, <8 x float> zeroinitializer)
  %7 = sext <8 x i32> %3 to <8 x i64>
  %extract_ptrs7 = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %7
  %extract8 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs7, <8 x i1> %0, <8 x float> zeroinitializer)
  %8 = sext <8 x i32> %4 to <8 x i64>
  %extract_ptrs9 = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %8
  %extract10 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs9, <8 x i1> %0, <8 x float> zeroinitializer)
  %9 = fadd <8 x float> %extract4, %extract6
  %10 = fadd <8 x float> %9, %extract8
  %11 = fadd <8 x float> %10, %extract10
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> %11, ptr align 4 %out, <8 x i1> %0)
  br label %"!else_3!any"

"!else_3!any":                                    ; preds = %"!then_2", %guarded
  %12 = bitcast <8 x i1> %not. to i8
  %.not12 = icmp eq i8 %12, 0
  br i1 %.not12, label %"!par_cont_1", label %"!else_3"

"!else_3":                                        ; preds = %"!else_3!any"
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> splat (float -1.000000e+00), ptr align 4 %out, <8 x i1> %not.)
  br label %"!par_cont_1"

"!par_cont_1":                                    ; preds = %"!else_3!any", %"!else_3"
  ret void
}

define void @lookup(ptr noundef %table_buffer, ptr noundef %first_buffer, ptr noundef %out_buffer) local_unnamed_addr {
lookup:
  %table = tail call ptr @bonsai_buffer_require(ptr %table_buffer, i32 1)
  %first = tail call ptr @bonsai_buffer_require(ptr %first_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x i32>, ptr %first, align 4
  %0 = add <8 x i32> %extract, splat (i32 1)
  %1 = add <8 x i32> %extract, splat (i32 2)
  %2 = add <8 x i32> %extract, splat (i32 3)
  %3 = sext <8 x i32> %extract to <8 x i64>
  %extract_ptrs = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %3
  %extract4 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs, <8 x i1> splat (i1 true), <8 x float> poison)
  %4 = sext <8 x i32> %0 to <8 x i64>
  %extract_ptrs5 = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %4
  %extract6 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs5, <8 x i1> splat (i1 true), <8 x float> poison)
  %5 = sext <8 x i32> %1 to <8 x i64>
  %extract_ptrs7 = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %5
  %extract8 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs7, <8 x i1> splat (i1 true), <8 x float> poison)
  %6 = sext <8 x i32> %2 to <8 x i64>
  %extract_ptrs9 = getelementptr inbounds [4 x i8], ptr %table, <8 x i64> %6
  %extract10 = tail call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %extract_ptrs9, <8 x i1> splat (i1 true), <8 x float> poison)
  %7 = fadd <8 x float> %extract4, %extract6
  %8 = fadd <8 x float> %7, %extract8
  %9 = fadd <8 x float> %8, %extract10
  store <8 x float> %9, ptr %out, align 4
  ret void
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

