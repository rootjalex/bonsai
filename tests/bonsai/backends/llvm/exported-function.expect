; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

%struct.Position = type { i32, i32, i32, float }

@0 = private unnamed_addr constant [46 x i8] c"Position {\0A  x: %d\0A  y: %d\0A  z: %d\0A  c: %f\0A}\0A\00", align 1

define void @foo(ptr noundef nonnull %"$r0", ptr noundef nonnull readonly %i, ptr noundef nonnull readonly %j) {
foo_entry:
  %0 = load %struct.Position, ptr %"$r0", align 4
  %1 = load %struct.Position, ptr %i, align 4
  %2 = load %struct.Position, ptr %j, align 4
  %3 = extractvalue %struct.Position %1, 0
  %4 = extractvalue %struct.Position %2, 0
  %5 = add i32 %3, %4
  %6 = extractvalue %struct.Position %1, 1
  %7 = extractvalue %struct.Position %2, 1
  %8 = add i32 %6, %7
  %9 = extractvalue %struct.Position %1, 2
  %10 = extractvalue %struct.Position %2, 2
  %11 = add i32 %9, %10
  %12 = extractvalue %struct.Position %1, 3
  %13 = extractvalue %struct.Position %2, 3
  %14 = fadd float %12, %13
  %15 = insertvalue %struct.Position undef, i32 %5, 0
  %16 = insertvalue %struct.Position %15, i32 %8, 1
  %17 = insertvalue %struct.Position %16, i32 %11, 2
  %18 = insertvalue %struct.Position %17, float %14, 3
  store %struct.Position %18, ptr %"$r0", align 4
  ret void
}

define i32 @main() {
main_entry:
  %r = alloca %struct.Position, align 8
  store %struct.Position zeroinitializer, ptr %r, align 4
  %0 = load %struct.Position, ptr %r, align 4
  %1 = alloca %struct.Position, align 8
  store %struct.Position { i32 1, i32 2, i32 3, float 1.000000e+00 }, ptr %1, align 4
  %2 = alloca %struct.Position, align 8
  store %struct.Position { i32 10, i32 20, i32 30, float 4.100000e+01 }, ptr %2, align 4
  call void @foo(ptr %r, ptr %1, ptr %2)
  %3 = load %struct.Position, ptr %r, align 4
  %4 = extractvalue %struct.Position %3, 0
  %5 = load %struct.Position, ptr %r, align 4
  %6 = extractvalue %struct.Position %5, 1
  %7 = load %struct.Position, ptr %r, align 4
  %8 = extractvalue %struct.Position %7, 2
  %9 = load %struct.Position, ptr %r, align 4
  %10 = extractvalue %struct.Position %9, 3
  %11 = call i32 (ptr, ...) @printf(ptr @0, i32 %4, i32 %6, i32 %8, float %10)
  ret i32 0
}

declare i32 @printf(ptr, ...)
