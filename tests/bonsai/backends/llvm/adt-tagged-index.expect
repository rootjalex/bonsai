; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

%struct.Sph = type { <3 x float>, float }

define i64 @Shape_Sph(<3 x float> noundef %centre, float noundef %radius, ptr noundef %Shape_Sph_pool_buffer, ptr noundef %Shape_Sph_fill_buffer) local_unnamed_addr {
Shape_Sph:
  %Shape_Sph_pool = tail call ptr @bonsai_buffer_require(ptr %Shape_Sph_pool_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %Shape_Sph_pool_buffer, i32 1)
  %Shape_Sph_fill = tail call ptr @bonsai_buffer_require(ptr %Shape_Sph_fill_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %Shape_Sph_fill_buffer, i32 1)
  %0 = atomicrmw add ptr %Shape_Sph_fill, i64 1 monotonic, align 8
  %1 = insertvalue %struct.Sph undef, <3 x float> %centre, 0
  %2 = insertvalue %struct.Sph %1, float %radius, 1
  %Shape_Sph_pool1.i = getelementptr inbounds [32 x i8], ptr %Shape_Sph_pool, i64 %0
  store %struct.Sph %2, ptr %Shape_Sph_pool1.i, align 16
  ret i64 %0
}

define range(i64 72057594037927936, 0) i64 @Shape_Tri(<3 x float> noundef %a, <3 x float> noundef %b, ptr noundef %Shape_Tri_pool_buffer, ptr noundef %Shape_Tri_fill_buffer) local_unnamed_addr {
Shape_Tri:
  %Shape_Tri_pool = tail call ptr @bonsai_buffer_require(ptr %Shape_Tri_pool_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %Shape_Tri_pool_buffer, i32 1)
  %Shape_Tri_fill = tail call ptr @bonsai_buffer_require(ptr %Shape_Tri_fill_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %Shape_Tri_fill_buffer, i32 1)
  %0 = atomicrmw add ptr %Shape_Tri_fill, i64 1 monotonic, align 8
  %Shape_Tri_pool1.i = getelementptr inbounds [32 x i8], ptr %Shape_Tri_pool, i64 %0
  store <3 x float> %a, ptr %Shape_Tri_pool1.i, align 16
  %Shape_Tri_pool1.repack2.i = getelementptr inbounds nuw i8, ptr %Shape_Tri_pool1.i, i64 16
  store <3 x float> %b, ptr %Shape_Tri_pool1.repack2.i, align 16
  %1 = or i64 %0, 72057594037927936
  ret i64 %1
}

define float @size(i64 noundef %s, ptr noundef %Shape_Sph_pool_buffer, ptr noundef %Shape_Tri_pool_buffer) local_unnamed_addr {
size:
  %Shape_Sph_pool = tail call ptr @bonsai_buffer_require(ptr %Shape_Sph_pool_buffer, i32 1)
  %Shape_Tri_pool = tail call ptr @bonsai_buffer_require(ptr %Shape_Tri_pool_buffer, i32 1)
  %cond = icmp ult i64 %s, 72057594037927936
  br i1 %cond, label %"!case_0", label %"!case_1"

common.ret:                                       ; preds = %"!case_0", %"!case_1"
  %common.ret.op = phi float [ %1, %"!case_1" ], [ %"@2.radius", %"!case_0" ]
  ret float %common.ret.op

"!case_1":                                        ; preds = %size
  %0 = and i64 %s, 72057594037927935
  %extract_ptr5 = getelementptr inbounds nuw [32 x i8], ptr %Shape_Tri_pool, i64 %0
  %extract6.unpack = load <3 x float>, ptr %extract_ptr5, align 16
  %1 = extractelement <3 x float> %extract6.unpack, i64 0
  br label %common.ret

"!case_0":                                        ; preds = %size
  %extract_ptr = getelementptr inbounds nuw [32 x i8], ptr %Shape_Sph_pool, i64 %s
  %2 = getelementptr inbounds nuw i8, ptr %extract_ptr, i64 16
  %"@2.radius" = load float, ptr %2, align 4
  br label %common.ret
}

define i64 @unit_sphere(ptr noundef %Shape_Sph_pool_buffer, ptr noundef %Shape_Sph_fill_buffer) local_unnamed_addr {
unit_sphere:
  %Shape_Sph_pool = tail call ptr @bonsai_buffer_require(ptr %Shape_Sph_pool_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %Shape_Sph_pool_buffer, i32 1)
  %Shape_Sph_fill = tail call ptr @bonsai_buffer_require(ptr %Shape_Sph_fill_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %Shape_Sph_fill_buffer, i32 1)
  %0 = atomicrmw add ptr %Shape_Sph_fill, i64 1 monotonic, align 8
  %Shape_Sph_pool1.i = getelementptr inbounds [32 x i8], ptr %Shape_Sph_pool, i64 %0
  store %struct.Sph { <3 x float> zeroinitializer, float 1.000000e+00 }, ptr %Shape_Sph_pool1.i, align 16
  ret i64 %0
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr
