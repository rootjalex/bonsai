; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

%struct._pfctx0 = type { ptr }
%struct._pfctx2 = type { ptr }
%struct._pfctx4 = type { ptr }

define void @derived_bound(i32 noundef %n, ptr noundef %out_buffer) local_unnamed_addr {
derived_bound:
  %_pfctx = alloca %struct._pfctx0, align 16
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  store ptr %out, ptr %_pfctx, align 16
  %0 = zext i32 %n to i64
  call void @bonsai_parallel_for(i64 %0, ptr nonnull %_pfctx, ptr nonnull @_pfkernel1)
  ret void
}

define void @per_lane_bound(i32 noundef %n, ptr noundef %out_buffer) local_unnamed_addr {
per_lane_bound:
  %_pfctx = alloca %struct._pfctx2, align 16
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  store ptr %out, ptr %_pfctx, align 16
  %0 = zext i32 %n to i64
  call void @bonsai_parallel_for(i64 %0, ptr nonnull %_pfctx, ptr nonnull @_pfkernel3)
  ret void
}

define void @shared_bound(i32 noundef %n, ptr noundef %out_buffer) local_unnamed_addr {
shared_bound:
  %_pfctx = alloca %struct._pfctx4, align 16
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  store ptr %out, ptr %_pfctx, align 16
  %0 = zext i32 %n to i64
  call void @bonsai_parallel_for(i64 %0, ptr nonnull %_pfctx, ptr nonnull @_pfkernel5)
  ret void
}

define void @shared_unbound(i32 noundef %n, ptr noundef %out_buffer) local_unnamed_addr {
shared_unbound:
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %.not = icmp eq i32 %n, 0
  br i1 %.not, label %i6_pf_exit, label %"!par_body_0.lr.ph", !prof !0

"!par_body_0.lr.ph":                              ; preds = %shared_unbound
  %out.promoted = load float, ptr %out, align 4
  %xtraiter = and i32 %n, 7
  %0 = icmp ult i32 %n, 8
  br i1 %0, label %"!par_body_0.epil.preheader", label %"!par_body_0.lr.ph.new", !prof !1

"!par_body_0.lr.ph.new":                          ; preds = %"!par_body_0.lr.ph"
  %unroll_iter = and i32 %n, -8
  br label %"!par_body_0"

"!par_body_0":                                    ; preds = %"!par_body_0", %"!par_body_0.lr.ph.new"
  %acc_base3 = phi float [ %out.promoted, %"!par_body_0.lr.ph.new" ], [ %8, %"!par_body_0" ]
  %niter = phi i32 [ 0, %"!par_body_0.lr.ph.new" ], [ %niter.next.7, %"!par_body_0" ]
  %1 = fadd float %acc_base3, 1.000000e+00
  %2 = fadd float %1, 1.000000e+00
  %3 = fadd float %2, 1.000000e+00
  %4 = fadd float %3, 1.000000e+00
  %5 = fadd float %4, 1.000000e+00
  %6 = fadd float %5, 1.000000e+00
  %7 = fadd float %6, 1.000000e+00
  %8 = fadd float %7, 1.000000e+00
  %niter.next.7 = add i32 %niter, 8
  %niter.ncmp.7 = icmp eq i32 %niter.next.7, %unroll_iter
  br i1 %niter.ncmp.7, label %i6_pf_head.i6_pf_exit_crit_edge.unr-lcssa, label %"!par_body_0", !prof !1

i6_pf_head.i6_pf_exit_crit_edge.unr-lcssa:        ; preds = %"!par_body_0"
  %lcmp.mod.not = icmp eq i32 %xtraiter, 0
  br i1 %lcmp.mod.not, label %i6_pf_head.i6_pf_exit_crit_edge, label %"!par_body_0.epil.preheader", !prof !1

"!par_body_0.epil.preheader":                     ; preds = %i6_pf_head.i6_pf_exit_crit_edge.unr-lcssa, %"!par_body_0.lr.ph"
  %acc_base3.epil.init = phi float [ %out.promoted, %"!par_body_0.lr.ph" ], [ %8, %i6_pf_head.i6_pf_exit_crit_edge.unr-lcssa ]
  %lcmp.mod5 = icmp ne i32 %xtraiter, 0
  tail call void @llvm.assume(i1 %lcmp.mod5)
  br label %"!par_body_0.epil"

"!par_body_0.epil":                               ; preds = %"!par_body_0.epil", %"!par_body_0.epil.preheader"
  %acc_base3.epil = phi float [ %acc_base3.epil.init, %"!par_body_0.epil.preheader" ], [ %9, %"!par_body_0.epil" ]
  %epil.iter = phi i32 [ 0, %"!par_body_0.epil.preheader" ], [ %epil.iter.next, %"!par_body_0.epil" ]
  %9 = fadd float %acc_base3.epil, 1.000000e+00
  %epil.iter.next = add i32 %epil.iter, 1
  %epil.iter.cmp.not = icmp eq i32 %epil.iter.next, %xtraiter
  br i1 %epil.iter.cmp.not, label %i6_pf_head.i6_pf_exit_crit_edge, label %"!par_body_0.epil", !prof !2, !llvm.loop !3

i6_pf_head.i6_pf_exit_crit_edge:                  ; preds = %"!par_body_0.epil", %i6_pf_head.i6_pf_exit_crit_edge.unr-lcssa
  %.lcssa = phi float [ %8, %i6_pf_head.i6_pf_exit_crit_edge.unr-lcssa ], [ %9, %"!par_body_0.epil" ]
  store float %.lcssa, ptr %out, align 4
  br label %i6_pf_exit

i6_pf_exit:                                       ; preds = %i6_pf_head.i6_pf_exit_crit_edge, %shared_unbound
  ret void
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

; Function Attrs: mustprogress norecurse nounwind willreturn memory(readwrite, inaccessiblemem: none, target_mem: none)
define internal void @_pfkernel1(ptr nofree readonly captures(none) %0, i64 %1) #0 {
"!par_body_0":
  %2 = load ptr, ptr %0, align 8
  %3 = lshr i64 %1, 1
  %4 = and i64 %3, 2147483647
  %out = getelementptr inbounds nuw [4 x i8], ptr %2, i64 %4
  %5 = atomicrmw fadd ptr %out, float 1.000000e+00 monotonic, align 4
  ret void
}

declare void @bonsai_parallel_for(i64, ptr, ptr) local_unnamed_addr

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(readwrite, inaccessiblemem: none, target_mem: none)
define internal void @_pfkernel3(ptr nofree readonly captures(none) %0, i64 %1) #1 {
"!par_body_0":
  %2 = load ptr, ptr %0, align 8
  %sext = shl i64 %1, 32
  %3 = ashr exact i64 %sext, 30
  %out = getelementptr inbounds i8, ptr %2, i64 %3
  %acc_base = load float, ptr %out, align 4
  %4 = fadd float %acc_base, 1.000000e+00
  store float %4, ptr %out, align 4
  ret void
}

; Function Attrs: mustprogress norecurse nounwind willreturn memory(readwrite, inaccessiblemem: none, target_mem: none)
define internal void @_pfkernel5(ptr nofree readonly captures(none) %0, i64 %1) #0 {
"!par_body_0":
  %2 = load ptr, ptr %0, align 8
  %3 = atomicrmw fadd ptr %2, float 1.000000e+00 monotonic, align 4
  ret void
}

; Function Attrs: nocallback nofree nosync nounwind willreturn memory(inaccessiblemem: write)
declare void @llvm.assume(i1 noundef) #2

