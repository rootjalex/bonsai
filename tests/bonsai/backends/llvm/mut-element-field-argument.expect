; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @deeper(ptr noundef %vs_buffer, i32 noundef %i) local_unnamed_addr {
deeper:
  %vs = tail call ptr @bonsai_buffer_require(ptr %vs_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %vs_buffer, i32 1)
  %0 = sext i32 %i to i64
  %ptr_array_deref = getelementptr inbounds [32 x i8], ptr %vs, i64 %0
  %c_gep = getelementptr inbounds nuw i8, ptr %ptr_array_deref, i64 20
  %deref_temp.i = load float, ptr %c_gep, align 4, !tbaa !0
  %1 = fadd float %deref_temp.i, 1.000000e+00
  store float %1, ptr %c_gep, align 4, !tbaa !0
  ret void
}

define void @touch(ptr noundef %vs_buffer, i32 noundef %i) local_unnamed_addr {
touch:
  %vs = tail call ptr @bonsai_buffer_require(ptr %vs_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %vs_buffer, i32 1)
  %0 = sext i32 %i to i64
  %ptr_array_deref = getelementptr inbounds [32 x i8], ptr %vs, i64 %0
  %w_gep = getelementptr inbounds nuw i8, ptr %ptr_array_deref, i64 16
  %deref_temp.i = load float, ptr %w_gep, align 4, !tbaa !0
  %1 = fadd float %deref_temp.i, 1.000000e+00
  store float %1, ptr %w_gep, align 4, !tbaa !0
  ret void
}

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

!0 = !{!1, !1, i64 0}
!1 = !{!"f32", !2, i64 0}
!2 = !{!"bonsai"}
