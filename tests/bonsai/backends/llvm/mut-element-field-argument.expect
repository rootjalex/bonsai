; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite)
define void @deeper(ptr nofree noundef captures(none) %vs, i32 noundef %i) local_unnamed_addr #0 {
deeper:
  %0 = sext i32 %i to i64
  %ptr_array_deref = getelementptr inbounds [32 x i8], ptr %vs, i64 %0
  %c_gep = getelementptr inbounds nuw i8, ptr %ptr_array_deref, i64 20
  %deref_temp.i = load float, ptr %c_gep, align 4, !tbaa !0
  %1 = fadd float %deref_temp.i, 1.000000e+00
  store float %1, ptr %c_gep, align 4, !tbaa !0
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite)
define void @touch(ptr nofree noundef captures(none) %vs, i32 noundef %i) local_unnamed_addr #0 {
touch:
  %0 = sext i32 %i to i64
  %ptr_array_deref = getelementptr inbounds [32 x i8], ptr %vs, i64 %0
  %w_gep = getelementptr inbounds nuw i8, ptr %ptr_array_deref, i64 16
  %deref_temp.i = load float, ptr %w_gep, align 4, !tbaa !0
  %1 = fadd float %deref_temp.i, 1.000000e+00
  store float %1, ptr %w_gep, align 4, !tbaa !0
  ret void
}

