//! flags: -p ssa -b llvm

// ssa/any-hit-prefetch.bonsai through the LLVM backend: the any-hit
// traversal of an eight-wide node over references that are pointers, its
// run of hits a switch on their count, with the children prefetched. What
// to read for: in the arms for one to four hits, `llvm.prefetch` of the
// child's own loaded reference (`inttoptr` of the `load i64` off the node's
// row at the lane `llvm.cttz`/`llvm.ctlz` found), four lines each, with no
// test of the count in front of them; in the default arm alone the vector
// form -- the children compressed under the mask, the count from the mask,
// each lane fetched behind a test of the count (CodeGen_LLVM::emit_prefetch)
// -- and no prefetch in the node's block before the switch.
import stdlib/aabb;
import stdlib/distance;
import stdlib/intersects;
import stdlib/numerics;
import stdlib/ray;
import stdlib/topology;
import stdlib/triangle;

extern tris : set[Triangle];

func [[export]] occluded(r : Ray) = any(|t : Triangle| intersects(r, t), tris);

schedule {
    tree[[Triangle]] BVH8 =
    | Interior(children : array[BVH8, 8], lo hi : vector[vec3f, 8])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    tris : BVH8;

    layout tris(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 8];
                lower_x : vector[f32, 8];
                upper_x : vector[f32, 8];
                lower_y : vector[f32, 8];
                upper_y : vector[f32, 8];
                lower_z : vector[f32, 8];
                upper_z : vector[f32, 8];
                lo = vector[vec3f, 8]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 8]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                indirect group tiles { group[4] { p0 : vec3f; p1 : vec3f; p2 : vec3f; }; };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };

    occluded.vectorize(tris.Interior.children)
            .loopify(64);
    occluded.prefetch(tris.Interior.children);
}
