; ModuleID = 'bonsai_module'
source_filename = "bonsai_module"

define void @both_ways(ptr noundef %a_buffer, float noundef %k, ptr noundef %out_buffer) local_unnamed_addr {
both_ways:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %.splatinsert = insertelement <8 x float> poison, float %k, i64 0
  %.splat = shufflevector <8 x float> %.splatinsert, <8 x float> poison, <8 x i32> zeroinitializer
  %0 = fmul <8 x float> %.splat, %extract
  store <8 x float> %0, ptr %out, align 4
  %1 = fcmp ogt <8 x float> %extract, zeroinitializer
  %2 = bitcast <8 x i1> %1 to i8
  %.not = icmp eq i8 %2, 0
  br i1 %.not, label %"!par_cont_1", label %"!then_2"

"!then_2":                                        ; preds = %both_ways
  %3 = fmul <8 x float> %extract, splat (float 1.000000e+02)
  tail call void @llvm.masked.store.v8f32.p0(<8 x float> %3, ptr nonnull align 4 %out, <8 x i1> %1)
  br label %"!par_cont_1"

"!par_cont_1":                                    ; preds = %both_ways, %"!then_2"
  ret void
}

define void @conditional_store(ptr noundef %a_buffer, ptr noundef %out_buffer) local_unnamed_addr {
conditional_store:
  %a = tail call ptr @bonsai_buffer_require(ptr %a_buffer, i32 1)
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %extract = load <8 x float>, ptr %a, align 4
  %0 = fcmp ogt <8 x float> %extract, zeroinitializer
  %1 = bitcast <8 x i1> %0 to i8
  %.not = icmp eq i8 %1, 0
  br i1 %.not, label %"!par_cont_1", label %"!then_2"

"!then_2":                                        ; preds = %conditional_store
  %2 = fmul <8 x float> %extract, splat (float 1.000000e+02)
  %store_ptrs.i = getelementptr inbounds nuw [4 x i8], ptr %out, <8 x i64> <i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7>
  tail call void @llvm.masked.scatter.v8f32.v8p0(<8 x float> %2, <8 x ptr> align 4 %store_ptrs.i, <8 x i1> %0)
  br label %"!par_cont_1"

"!par_cont_1":                                    ; preds = %conditional_store, %"!then_2"
  ret void
}

; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
define noundef float @scale(float noundef %x, float noundef %k) local_unnamed_addr #0 {
scale:
  %0 = fmul float %x, %k
  ret float %0
}

define void @store_to(ptr noundef %out_buffer, i32 noundef %i, float noundef %v) local_unnamed_addr {
store_to:
  %out = tail call ptr @bonsai_buffer_require(ptr %out_buffer, i32 1)
  tail call void @bonsai_buffer_mark_dirty(ptr %out_buffer, i32 1)
  %0 = sext i32 %i to i64
  %out1 = getelementptr inbounds [4 x i8], ptr %out, i64 %0
  store float %v, ptr %out1, align 4, !tbaa !0
  ret void
}

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(write)
declare void @llvm.masked.scatter.v8f32.v8p0(<8 x float>, <8 x ptr>, <8 x i1>) #1

declare ptr @bonsai_buffer_require(ptr, i32) local_unnamed_addr

declare void @bonsai_buffer_mark_dirty(ptr, i32) local_unnamed_addr

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: write)
declare void @llvm.masked.store.v8f32.p0(<8 x float>, ptr captures(none), <8 x i1>) #2

attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(none) }
attributes #1 = { mustprogress nocallback nofree nosync nounwind willreturn memory(write) }
attributes #2 = { mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: write) }

!0 = !{!1, !1, i64 0}
!1 = !{!"f32", !2, i64 0}
!2 = !{!"bonsai"}
