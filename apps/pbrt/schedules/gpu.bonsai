// The GPU schedule, first form: the scalar schedule's loops, with the pixels
// on the GPU's blocks and each pixel's samples on the block's threads. No
// gang is made -- the warp is the gang -- and the traversals are the loops
// over a stack that scalar.bonsai makes of them, in each thread's local
// memory, as pbrt's own megakernel keeps its stack. This is the software
// path (phase A of apps/pbrt/PLAN.md, "NVIDIA GPU support"); the RT cores
// come with `bind(trace, RTCore)`, which is not built yet.
schedule {
    walk_step.loopify();
    path_step.loopify();
    full_path_step.loopify();
    // volpath's walks too (see scalar.bonsai).
    vol_path_step.loopify();
    vol_medium_step.loopify();
    vol_shadow_step.loopify();
    vol_shadow_track.loopify();

    trace.sort(primitives.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .sort(Inst.blas.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
    trace_any.loopify(64);

    // One kernel per integrator, entered by a dispatch on the scene's tag:
    // in each the tag is a constant, integrator_li is copied with it fixed
    // so its match is the one arm, and ptxas allocates registers for the
    // integrator the scene runs and not for four -- pbrt's GPU build is one
    // integrator by construction (SSA/Specialize.h). First among render's
    // directives: the copies are what the binds after it schedule, and a
    // bind naming `p` binds every variant's `p!<Integrator>`.
    render.specialize(integrator);
    render.bind(p, GPUBlock);
    render.bind(s, GPUThread);

    // The image textures on the texture units, as pbrt --gpu samples them
    // (GPUSpectrumImageTexture::Evaluate, tex2DGrad on a mipmapped texture
    // object): the lookup's level, filter and wrap are the unit's, from the
    // object the driver made of the same pyramid (texture_handles). The
    // software filter stays what the program says and what the CPU
    // schedules run; here it is what the lambda computes instead (see
    // textures.bonsai, texture_filter_unit).
    texture_filter.bind(TextureUnit,
                        |t : ImageTexture, st : vec2f, dstdx : vec2f,
                         dstdy : vec2f|
                        texture_filter_unit(texture_handles[t.id], st, dstdx,
                                            dstdy));
    texture_filter_float.bind(TextureUnit,
                              |t : ImageTexture, st : vec2f, dstdx : vec2f,
                               dstdy : vec2f|
                              texture_filter_float_unit(
                                  texture_handles[t.id], t.average_channels,
                                  st, dstdx, dstdy));
}
