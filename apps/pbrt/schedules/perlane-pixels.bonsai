// The per-lane schedule over pixels: the gang is sixteen consecutive pixels
// at the same sample index, not sixteen samples of one pixel
// (perlane-media-scalar.bonsai) -- a lane per pixel, the gang stepping
// through the samples together, the shape of ispc's and Embree's example
// path tracers. Neighbouring pixels' camera rays leave through neighbouring
// footprints and mostly hit neighbouring surfaces, so the gang's first
// trace and first material are coherent across its pixels; after that the
// lanes diverge as any gang's do, and every lane walks the tree at its own
// pace over a stack of its own (the traversals are put on their stacks
// before the gang is made, as perlane.bonsai does; see packet.bonsai for
// what each directive is doing). The threads take gangs of pixels. The
// gang is made on the integrator's copy without media, the copy with media
// running scalar, for the reason packet-media-scalar.bonsai gives (the
// NanoVDB grid is a foreign function the vectorizer cannot give a lane's
// arguments).
//
// The exploration of 11-01 (the user: "what sometimes-optimal schedules can
// you find across these sweep scenes", from the directives the language
// has and their compositions, nothing new and no layout change). Not
// measured: with the foreign call lowered per lane (6488f426) the compiler
// gets past it and stops on an older fault of the gang's short-vector
// handling (`Implicit casting of types: f32x3$v16 versus f32x16`,
// IR/Expr.cpp) -- PLAN.md, "11-01 evening". Kept for the day it compiles.
import apps/pbrt/schedules/trees/bvh;

schedule {
    walk_step.loopify();
    path_step.loopify();
    full_path_step.loopify();
    vol_path_step.loopify();
    vol_medium_step.loopify();
    vol_shadow_step.loopify();
    vol_probe_step.loopify();
    vol_shadow_track.loopify();
    render.specialize(integrator);
    render[VolPath].specialize(have_media);
    // First: each traversal becomes a loop over a stack while it is still one
    // ray's, and the near-child order is each ray's own.
    trace.sort(primitives.Interior,
               |i : u8, q : RaySegment, axis : u8|
               select((1.0 / q.ray.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .sort(Inst.blas.Interior,
               |i : u8, q : RaySegment, axis : u8|
               select((1.0 / q.ray.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
    trace_any.sort(primitives.Interior,
                   |i : u8, q : RaySegment, axis : u8|
                   select((1.0 / q.ray.d)[axis] < 0.0,
                          1.0 - cast[[Float]](i), cast[[Float]](i)))
             .sort(Inst.blas.Interior,
                   |i : u8, q : RaySegment, axis : u8|
                   select((1.0 / q.ray.d)[axis] < 0.0,
                          1.0 - cast[[Float]](i), cast[[Float]](i)))
             .loopify(64);
    // Then the gang: sixteen pixels a lane each, their sample loops in step.
    render[VolPath][False].split(p, p_gang, p_lane, 16, true)
                          .vectorize(p_lane);
    render.bind(p_gang, CPUThread);
    render.bind(p, CPUThread);
    render.bind(q, CPUThread);
}
