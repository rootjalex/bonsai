// One launch per bounce: the ray queue is the only queue, and everything a
// bounce does -- the sample draws, the medium's sampling and scattering,
// the routing of a miss or an emissive hit, the material, the light sample
// and its shadow ray, the subsurface probe and exit -- runs inside the
// trace program that traced the ray, which pushes the next ray onto the
// queue for the next round. pbrt's kernel per stage becomes a kernel per
// bounce: the shape of Laine, Karras and Aila's wavefront path tracer with
// one logic kernel [Megakernels Considered Harmful, HPG 2013], without
// their path regeneration, standing between gpu-optix.bonsai (pbrt's dozen
// launches a round over a dozen queues) and gpu-optix-mega-flat.bonsai
// (one launch a frame, no queue). What a round keeps against the
// megakernel is its compaction -- every lane of the launch is a live path
// at every bounce -- and what it gives up against the matched wavefront is
// the queues' writes, reloads and launches, and the per-stage programs'
// small size: this raygen carries every stage, as the megakernel does, so
// it is specialized by the scene's media and subsurface flags as the
// megakernels are. Nothing stands between a trace and the material switch
// (gpu-optix-fused-ser.bonsai's reordering would).
//
// The exploration of 11-01 (the user: "what sometimes-optimal schedules can
// you find across these sweep scenes", from the directives the language
// has and their compositions, nothing new and no layout change). The ray
// drain's rest pass (`rays_rest`, the entries' work after the pixel loop)
// and the film pass (`q`) are CUDA launches as in every wavefront here.
import apps/pbrt/schedules/trees/optix;

schedule {
    walk_step.loopify();
    path_step.loopify();
    full_path_step.loopify();
    vol_medium_step.loopify();
    vol_shadow_step.loopify();
    vol_shadow_track.loopify();
    vol_probe_step.loopify();
    render.specialize(integrator);
    render[VolPath].specialize(film_visible_surface);
    render[VolPath].specialize(have_media);
    render[VolPath].specialize(VolPath::have_subsurface);
    render[VolPath].reorder(p, s);
    render[VolPath].split(p, p_band, p_in, pass_pixels, true);
    rays = render[VolPath].queue(p_band, ExternDevice);
    li_vol_path.defer(vol_path_step, rays);
    vol_medium_scatter.defer(vol_path_step, rays);
    vol_surface.defer(vol_path_step, rays);
    vol_route.defer(vol_path_step, rays);
    vol_exit.defer(vol_path_step, rays);
    trace.bind(RTCore);
    trace_any.bind(RTCore);
    render.bind(rays, OptixThread);
    render.split(p_in, p_blk, p_thr, 256, true);
    render.bind(p_blk, GPUBlock);
    render.bind(p_thr, GPUThread);
    render.specialize(p_blk, sampler);
    render.split(rays_rest, rays_rest_blk, rays_rest_thr, 256, true);
    render.bind(rays_rest_blk, GPUBlock);
    render.bind(rays_rest_thr, GPUThread);
    render.split(q, q_blk, q_thr, 256, true);
    render.bind(q_blk, GPUBlock);
    render.bind(q_thr, GPUThread);
    texture_filter.bind(TextureUnit,
                        |t : ImageTexture, st : vec2f, dstdx : vec2f,
                         dstdy : vec2f|
                        texture_filter_unit(texture_handles[t.id], st, dstdx,
                                            dstdy));
    texture_filter_float.bind(TextureUnit,
                              |t : ImageTexture, st : vec2f, dstdx : vec2f,
                               dstdy : vec2f|
                              texture_filter_float_unit(
                                  texture_handles[t.id], t.average_channels,
                                  st, dstdx, dstdy));
}
