// pbrt's wavefront for volpath with a pass's queues, on the CPU: the same
// kernel list as wavefront-volpath.bonsai (see there for what each queue
// is), but every queue is a band's for one sample per pixel -- pbrt's pass
// over a band of scanlines, sized as pbrt sizes it -- rather than a pixel's
// for all of its samples.
//
// The program is pixel-outer, sample-inner, as pbrt's CPU integrator is;
// pbrt's wavefront is sample-outer (the passes), pixel-inner (the band). So
// the schedule interchanges the two loops of the VolPath copy of `render`:
// `reorder(p, s)` names them innermost first, as Halide does. The pixel
// loop's prologue -- the zeroing of the pixel's sums -- becomes a loop of
// its own before the passes (`p!prologue`), and the pixel's index
// arithmetic is recomputed inside the new inner loop; nothing follows the
// sample loop in the pixel's body, the finalization being a pass of its
// own already (see include/SSA/ReorderLoops.h for the rules). Each queue
// is then owned by one iteration of the sample loop -- one pass -- with
// the pixel loop as its producer (pbrt's GenerateCameraRays over the band),
// sized by the pixels, its record one slot per pixel (pbrt's
// pixelSampleState, indexed by pixelIndex). The storage is hoisted out of
// the sample loop and made once per render call, on the heap, freed at the
// return (SSA/HoistAllocations.h, SSA/HeapArrays.h), as pbrt allocates its
// queues once. Each drain is a loop over every path in flight, which the
// schedule binds to the CPU's threads as pbrt launches it over the device;
// the round loop runs on the calling thread; the passes run in sample
// order, so a pixel's samples are still summed in pbrt's order and the
// image agrees with the scalar schedule bit for bit. This is the structure
// the device schedule binds to GPUThread instead.
import apps/pbrt/schedules/trees/bvh;

schedule {
    walk_step.loopify();
    path_step.loopify();
    full_path_step.loopify();
    vol_medium_step.loopify();
    vol_shadow_step.loopify();
    vol_shadow_track.loopify();

    render.specialize(integrator);
    render[VolPath].reorder(p, s);
    // pbrt's pass is a band of scanlines, not the frame: `for (y0 = ...; y0
    // += scanlinesPerPass)` inside the sample loop, a million pixels' worth
    // at most, evened across the passes, with every queue sized to one band
    // (`maxQueueSize`). The band is `pass_pixels`, which render.bonsai
    // computes as pbrt does; the pixel loop is cut into bands of it, the
    // band loop serial as pbrt's is, the pixels of a band the threads'.
    render[VolPath].split(p, p_band, p_in, pass_pixels, true);

    rays = render[VolPath].queue(p_band);
    li_vol_path.defer(vol_path_step, rays);
    vol_medium_scatter.defer(vol_path_step, rays);
    vol_surface.defer(vol_path_step, rays);
    // pbrt's trace kernel pushes a hit on a medium boundary straight onto the
    // next ray queue (EnqueueWorkAfterIntersection); the routing after a
    // trace does the same here.
    vol_route.defer(vol_path_step, rays);

    medium_samples = render[VolPath].queue(p_band);
    vol_path_step.defer(vol_medium_sample, medium_samples);
    medium_scatters = render[VolPath].queue(p_band);
    vol_medium_sample.defer(vol_medium_scatter, medium_scatters);

    escaped = render[VolPath].queue(p_band);
    vol_route.defer(escaped_contribution, escaped);
    emissive = render[VolPath].queue(p_band);
    vol_route.defer(emissive_contribution, emissive);
    hits = render[VolPath].queue(p_band);
    vol_route.defer(vol_surface, hits);
    hits.specialize(material);
    shadow = render[VolPath].queue(p_band);
    vol_sample_ld.defer(shadow_contribution, shadow);

    trace.sort(primitives.Interior,
               |i : u8, q : RaySegment, axis : u8|
               select((1.0 / q.ray.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .sort(Inst.blas.Interior,
               |i : u8, q : RaySegment, axis : u8|
               select((1.0 / q.ray.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
    // pbrt's IntersectP walks the near child first exactly as Intersect
    // does (BVHAggregate::IntersectP, dirIsNeg), so the any-hit traversal
    // takes the same order.
    trace_any.sort(primitives.Interior,
                   |i : u8, q : RaySegment, axis : u8|
                   select((1.0 / q.ray.d)[axis] < 0.0,
                          1.0 - cast[[Float]](i), cast[[Float]](i)))
             .sort(Inst.blas.Interior,
                   |i : u8, q : RaySegment, axis : u8|
                   select((1.0 / q.ray.d)[axis] < 0.0,
                          1.0 - cast[[Float]](i), cast[[Float]](i)))
             .loopify(64);

    // The camera rays over the pixels of a band, then each drain over the
    // band's paths, then the film pass and the finalization: pbrt's
    // launches, as threads. `p_in` covers the pixels of a band in every
    // variant, and the prologue loop's in the one that was reordered; the
    // band loop `p_band` itself is serial, as pbrt's is.
    render.bind(p_in, CPUThread);
    render.bind(rays, CPUThread);
    render.bind(medium_samples, CPUThread);
    render.bind(medium_scatters, CPUThread);
    render.bind(escaped, CPUThread);
    render.bind(emissive, CPUThread);
    render.bind(hits, CPUThread);
    render.bind(shadow, CPUThread);
    render.bind(rays_rest, CPUThread);
    render.bind(q, CPUThread);
}
