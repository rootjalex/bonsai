// The scene's trees as the ray tracing hardware holds them: pbrt's
// OptiXAggregate, an acceleration structure over the scene's own primitives
// and one per instance definition, built by the driver (render_hook.cpp,
// through runtime/bonsai_optix.h) and searched by `trace.bind(RTCore)`. What
// every schedule on the RT cores imports; a schedule that walks the trees
// itself imports trees/bvh.bonsai instead.
//
// An OptixTree has no nodes of the schedule's. Its layout is its elements --
// the arrays the hit programs read a hit's element out of, at the index the
// hardware reports plus the build input's base, both from the input's
// shader binding table record (with the record's `holder`, the instance
// primitive the hit came through, where it did) -- and the handle of the
// structure (`traversable`), which the layout gains on its own. The
// instances' objects are runs of `geoms`, as `from` says, and an instance
// stores where its object's run starts. The compiler refuses a software
// traversal over either set, and refuses `bind(RTCore)` over any other kind
// of tree (Lower/Trees.cpp).
schedule {
    primitives : OptixTree;
    Inst.blas : OptixTree from geoms;
    // A mesh primitive's triangles: one build input (pbrt's
    // buildBVHForTriangles makes one per mesh too), the mesh's own index
    // buffer, and nothing stored per triangle. A triangle is unique only
    // within its mesh, so the reference to one is the pair (the mesh
    // primitive, the triangle's index in the mesh): the hit-group record's
    // holder and the primitive index the hardware reports, which is what
    // pbrt's closest-hit program reads (`rec.mesh`,
    // `optixGetPrimitiveIndex()`, gpu/optix/optix.cu). The groups below
    // compute the Triangle from that pair (the user, 10-26); the software
    // trees (trees/bvh.bonsai) store the same triangles as rows, pbrt's CPU
    // Triangle objects, and the program is the same for both.
    Mesh.tris : OptixTree from mesh_tris;
    Placed.tris : OptixTree from placed_tris;

    layout primitives {
        // Every instanced GeometricPrimitive in the scene, each definition's
        // together, in the order the driver's build inputs want them.
        gCount : u32;
        geoms : array[Geometric, gCount];
        // A mesh's triangles, and a placed mesh's: computed from the holder
        // and the ordinal, stored nowhere.
        group mesh_tris (h : Mesh, k : u32) { mesh = h.mesh; tri = k; };
        group placed_tris (h : Placed, k : u32) { mesh = h.mesh; tri = k; };
        // The scene's own primitives, and then its instances.
        pCount : u32;
        prims : array[Primitive, pCount];
    };
}
