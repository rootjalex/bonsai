// pbrt's GPU wavefront (`pbrt --gpu`) for volpath, on the RT cores: gpu-
// wavefront.bonsai with the two ray queries answered by the ray tracing
// hardware and the two kernels that trace launched as OptiX raygen programs
// -- pbrt's `__raygen__findClosest` over its ray queue and `__raygen__shadow`
// (or `__raygen__shadow_Tr` in a scene with media) over its shadow-ray queue,
// each an `optixLaunch` over the queue (wavefront/aggregate.cpp,
// OptiXAggregate::IntersectClosest and ::IntersectShadow). Every other kernel
// is the CUDA launch gpu-wavefront.bonsai makes of it, as pbrt's are.
//
// `trace.bind(RTCore)` says the acceleration structure answers `trace`: the
// query becomes an `optixTrace` from the raygen program, with the query's
// filter split between the hardware's triangle test and an anyhit program
// (the alpha test, pbrt's `__anyhit__triangle`), a closest-hit program that
// records which primitive was hit (pbrt's `__closesthit__triangle`, the
// ClosestHitContext idea: the result is written through a pointer the two
// payload words carry), and an intersection program for the shapes the
// hardware does not test itself (spheres and disks, pbrt's
// `__intersection__quadric`). `trace_any` is the same with `any`'s early
// exit as OPTIX_RAY_FLAG_TERMINATE_ON_FIRST_HIT (pbrt's shadow trace). The
// scene's acceleration structure is the driver's to build -- pbrt's
// OptiXAggregate builds one GAS of triangles per mesh and an IAS over them
// and the instances, and render_hook.cpp does the same -- and reaches the
// program as the `traversable` word of the tree's layout (Lower/Layouts.cpp).
//
// The two queries no longer name a traversal of their own, so the sort and
// loopify directives that shaped the software traversal are gone: the
// hardware orders its own visits. The sets they search are the hardware's
// trees (trees/optix.bonsai: `primitives : OptixTree`).
import apps/pbrt/schedules/trees/optix;

schedule {
    walk_step.loopify();
    path_step.loopify();
    full_path_step.loopify();
    vol_medium_step.loopify();
    vol_shadow_step.loopify();
    vol_shadow_track.loopify();
    vol_probe_step.loopify();

    render.specialize(integrator);
    render[VolPath].reorder(p, s);
    render[VolPath].split(p, p_band, p_in, pass_pixels, true);

    // The queues' storage is the driver's (ExternDevice, IR/Storage.h):
    // their arrays are parameters of `render`, allocated once per process
    // by render_hook.cpp -- in managed memory as pbrt allocates its queues,
    // or plain device memory, by --queue-memory -- so that nothing is
    // allocated or freed inside a render, as nothing is in pbrt's.
    rays = render[VolPath].queue(p_band, ExternDevice);
    li_vol_path.defer(vol_path_step, rays);
    vol_medium_scatter.defer(vol_path_step, rays);
    vol_surface.defer(vol_path_step, rays);
    vol_route.defer(vol_path_step, rays);
    vol_exit.defer(vol_path_step, rays);

    medium_samples = render[VolPath].queue(p_band, ExternDevice);
    vol_path_step.defer(vol_medium_sample, medium_samples);
    medium_scatters = render[VolPath].queue(p_band, ExternDevice);
    vol_medium_sample.defer(vol_medium_scatter, medium_scatters);

    escaped = render[VolPath].queue(p_band, ExternDevice);
    vol_route.defer(escaped_contribution, escaped);
    emissive = render[VolPath].queue(p_band, ExternDevice);
    vol_route.defer(emissive_contribution, emissive);
    hits = render[VolPath].queue(p_band, ExternDevice);
    vol_route.defer(vol_surface, hits);
    hits.specialize(material);
    shadow = render[VolPath].queue(p_band, ExternDevice);
    vol_sample_ld.defer(shadow_contribution, shadow);
    // pbrt's subsurface queues, in pbrt's order after the material kernels
    // and their shadow rays: the material kernel pushes a path that went
    // into a subsurface material onto the BSSRDF queue, whose kernel samples
    // the probe segment and pushes it onto the subsurface-scatter queue;
    // IntersectOneRandom is a raygen launch over that queue
    // (`__raygen__randomHit`), since the probe walk traces; "Handle
    // out-scattering after SSS" is a CUDA kernel over the same queue, which
    // pushes the exit's shadow ray and its next ray; and SampleSubsurface
    // ends with a second TraceShadowRays for those shadow rays, the first
    // having run before it ("do immediately so that we have space for
    // shadow rays for subsurface", integrator.cpp): a sample whose entry
    // was a rough boundary sends one from the entry and one from the exit
    // in a round, one more than a queue holds for it. Here the BSSRDF kernel
    // is the material kernel's own tail (vol_subsurface runs in the
    // Subsurface material's copy of `hits`), the walk is the drain of
    // `probes` on the hardware, the exit's shading the drain of `exits`, and
    // the exit's shadow rays the drain of `exit_shadow`, on the hardware
    // too; the drains run in the order their queues are deferred.
    probes = render[VolPath].queue(p_band, ExternDevice);
    vol_subsurface.defer(vol_probe, probes);
    exits = render[VolPath].queue(p_band, ExternDevice);
    vol_probe.defer(vol_exit, exits);
    exit_shadow = render[VolPath].queue(p_band, ExternDevice);
    vol_exit.defer(exit_shadow_contribution, exit_shadow);

    // The ray tracing hardware answers both queries.
    trace.bind(RTCore);
    trace_any.bind(RTCore);

    // The two kernels that trace are raygen launches over their queue's
    // count: the ray drain (pbrt's IntersectClosest, whose continuation is
    // the medium sampling and the routing of the hit) and the shadow drain
    // (pbrt's IntersectShadow / IntersectShadowTr). OptiX chooses their
    // block shape.
    render.bind(rays, OptixThread);
    render.bind(shadow, OptixThread);
    render.bind(probes, OptixThread);
    render.bind(exit_shadow, OptixThread);
    // pbrt's `haveMedia`: TraceShadowRays runs `__raygen__shadow` in a scene
    // without media and `__raygen__shadow_Tr` in one with them, a host-side
    // switch per scene, and nothing else of the wavefront is specialized on
    // it (its medium kernels are skipped, its material kernels branch on it
    // at run time). The same here: the shadow drain alone is copied for
    // `have_media` false and true, the launch dispatching on it, so the
    // kernel of a scene without media is the plain occlusion trace with the
    // transmittance walk folded away (a 115-line raygen in place of 4,300,
    // 6-8% of book). After the defer that made the drain and the bind that
    // put it on the hardware: the loop form of specialize comes late.
    render.specialize(shadow, have_media);
    render.specialize(exit_shadow, have_media);

    // Every other kernel over blocks of 256 threads, as gpu-wavefront.bonsai
    // has them: the camera rays over a band's pixels (and the prologue's
    // zeroing), each drain that does not trace over its count, the film pass
    // and the finalization.
    render.split(p_in, p_blk, p_thr, 256, true);
    render.bind(p_blk, GPUBlock);
    render.bind(p_thr, GPUThread);
    render.split(medium_samples, medium_samples_blk, medium_samples_thr, 256, true);
    render.bind(medium_samples_blk, GPUBlock);
    render.bind(medium_samples_thr, GPUThread);
    render.split(medium_scatters, medium_scatters_blk, medium_scatters_thr, 256, true);
    render.bind(medium_scatters_blk, GPUBlock);
    render.bind(medium_scatters_thr, GPUThread);
    render.split(escaped, escaped_blk, escaped_thr, 256, true);
    render.bind(escaped_blk, GPUBlock);
    render.bind(escaped_thr, GPUThread);
    render.split(emissive, emissive_blk, emissive_thr, 256, true);
    render.bind(emissive_blk, GPUBlock);
    render.bind(emissive_thr, GPUThread);
    render.split(hits, hits_blk, hits_thr, 256, true);
    render.bind(hits_blk, GPUBlock);
    render.bind(hits_thr, GPUThread);
    render.split(exits, exits_blk, exits_thr, 256, true);
    render.bind(exits_blk, GPUBlock);
    render.bind(exits_thr, GPUThread);
    render.split(rays_rest, rays_rest_blk, rays_rest_thr, 256, true);
    render.bind(rays_rest_blk, GPUBlock);
    render.bind(rays_rest_thr, GPUThread);
    render.split(q, q_blk, q_thr, 256, true);
    render.bind(q_blk, GPUBlock);
    render.bind(q_thr, GPUThread);

    // pbrt's image textures on the GPU are CUDA texture objects
    // (`cudaTextureObject_t`, gpu/textures.cpp), filtered by the texture
    // units; as gpu.bonsai has it.
    texture_filter.bind(TextureUnit,
                        |t : ImageTexture, st : vec2f, dstdx : vec2f,
                         dstdy : vec2f|
                        texture_filter_unit(texture_handles[t.id], st, dstdx,
                                            dstdy));
    texture_filter_float.bind(TextureUnit,
                              |t : ImageTexture, st : vec2f, dstdx : vec2f,
                               dstdy : vec2f|
                              texture_filter_float_unit(
                                  texture_handles[t.id], t.average_channels,
                                  st, dstdx, dstdy));
}
