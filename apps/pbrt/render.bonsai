//! flags: -p ssa -b cpp -o apps/pbrt/render
// `bind` is an SSA rewrite, so this needs the SSA pipeline rather than the
// default one.

// PBRT v4: the scene query, the film, and the schedule that decides how both
// are run. The pieces they are built from live beside this file:
//
//   interval.bonsai   pbrt's outward-rounded arithmetic, which is what makes a
//                     decision about a grazing ray trustworthy.
//   shapes.bonsai     Sphere, Triangle, their intersections, the shading
//                     geometry at a hit, and the AABB a BVH node is bounded by.
//   camera.bonsai     Transform and PerspectiveCamera.
//   spectrum.bonsai   SampledWavelengths and the sigmoid fit.
//   colour.bonsai     the matching curves and the conversion back to RGB that a
//                     film ends with.
//   frame.bonsai      the orthonormal basis a BSDF is evaluated in.
//   bxdf.bonsai       the materials, and the reflectance a gbuffer records.
//   rng.bonsai        pbrt's generator and the hashes that seed it.
//   sampler.bonsai    the samplers built on them.
//
// The rule for this app is that the source stays a straight transcription of
// PBRT and every performance decision lives in the `schedule` block at the
// bottom. If something here looks like it was written for speed rather than
// for clarity, that is a bug in the schedule language, not a licence to
// rewrite this file.
//
// The clearest instance of that rule is the scene query. PBRT builds a
// `BVHAggregate` and hand-writes the traversal; here `trace` says only what it
// wants -- the nearest primitive the ray hits -- and the schedule below decides
// that the answer comes from a BVH, what its nodes look like, and that the
// traversal is a loop over an explicit stack rather than recursion.
import stdlib/numerics;
import apps/pbrt/bxdf;
import apps/pbrt/camera;
import apps/pbrt/colour;
import apps/pbrt/differentials;
import apps/pbrt/filter;
import apps/pbrt/frame;
import apps/pbrt/sampler;
import apps/pbrt/shapes;
import apps/pbrt/spectrum;

// pbrt: DiffuseAreaLight, with no image and no alpha mask -- a shape that
// emits the same radiance in every direction it faces.
//
// The only kind of light here so far, and the one a random walk can use without
// any machinery at all: `RandomWalkIntegrator` never samples a light, it finds
// one by hitting it, so this needs no `SampleLi`, no PDF and no shadow ray.
//
// `l` is the RGB the scene wrote, fitted by the driver as every other spectrum
// is; `scale` is pbrt's own scale after the division that makes a radiance of
// one mean one nit. What makes this an illuminant rather than a reflectance is
// the multiply by the colour space's D65 in `area_light_l` below -- pbrt's
// RGBIlluminantSpectrum is a fit *times* an illuminant, where an albedo is the
// fit alone.
element AreaLight {
    l : SigmoidPolynomial;
    scale : Float;
    two_sided : bool;
}

// pbrt: DiffuseAreaLight::L, which is what SurfaceInteraction::Le calls.
//
// `n` is the geometric normal as the shape gives it and `w` points back the way
// the ray came. A one-sided light emits only where its normal points, so a ray
// that reaches the back of one sees nothing -- which is not a detail: the
// sphere in killeroo-simple is one-sided, and a two-sided reading of it would
// light the scene from inside the sphere as well.
func area_light_l(light : AreaLight, n : vec3f, w : vec3f,
                  lambda : SampledWavelengths) -> vec4f {
    if !light.two_sided && (dot(n, w) < 0.0) {
        return vec4f{0.0, 0.0, 0.0, 0.0};
    }
    return light.scale * spectrum_at(light.l, lambda) *
           spectrum_at_dense(illuminant_d65, lambda);
}

// pbrt: LightLiSample -- a direction towards a light, what arrives along it,
// and the density it was chosen with.
//
// `p_light` and `n_light` are the point on the light, which the caller needs to
// aim a shadow ray at: the ray has to stop just short of the surface rather
// than run to infinity, or the light occludes itself.
element LightLiSample {
    l : vec4f;
    wi : vec3f;
    pdf : Float;
    p_light : vec3f;
    p_light_error : vec3f;
    n_light : vec3f;
}

// pbrt: UniformInfiniteLight -- the same radiance arriving from every direction,
// which is what a scene gets when it writes `LightSource "infinite"` with no
// image behind it.
//
// It is the first light here that is not a surface, and that is most of what is
// interesting about it. A ray finds it by *failing* to hit anything, so every
// integrator grows an arm in the branch it used to treat as "carries nothing";
// it has no geometry to sample, so `SampleLi` picks a direction over the whole
// sphere rather than over a shape; and it has no point on it, so the shadow ray
// aimed at it has to be given an end, which is what `scene_radius` is for --
// pbrt's `Preprocess` bounds the scene in a sphere and the sample sits two radii
// away, far enough to be outside anything.
//
// `has_l` is not decoration. With no `L` written, pbrt emits the colour space's
// own illuminant -- for sRGB, D65 itself -- and with an `L` it emits an
// RGBIlluminantSpectrum, which is a sigmoid fit *times* that illuminant. The
// two are different spectra and the fit is not the identity, so which one this
// is has to be carried rather than guessed.
element UniformInfiniteLight {
    l : SigmoidPolynomial;
    scale : Float;
    has_l : bool;
    // pbrt: sceneRadius, from Preprocess. The scene's bounding sphere.
    scene_radius : Float;
}

// pbrt: the environment map an ImageInfiniteLight reads.
//
// The texels are an extern rather than a field because they are the biggest
// thing in the scene: every real environment map in pbrt-v4-scenes turns out to
// be 2048x2048, which is four million of them.
//
// Each texel is a *fitted* spectrum and not an RGB. pbrt builds an
// `RGBIlluminantSpectrum` at every lookup, which is a table lookup into the
// rgb2spec coefficients and a scale; the result is a deterministic function of
// the RGB, so doing it once per texel in the driver gives the same number and
// keeps a table lookup out from under the ray -- which is what this app does
// with every other spectrum. `xyz` are the sigmoid coefficients and `w` is the
// scale the fit was taken at, pbrt's `2 * rgb.MaxComponentValue()`.
extern env_texels : array[vec4f];

// pbrt: the two `PiecewiseConstant2D`s an ImageInfiniteLight builds over its
// image. Their tables, for every environment map in the scene, laid end to end
// -- a `Dist2D` on the light says where each one starts.
//
// `env_dist_values` is what is being sampled: the average of a texel's three
// channels, which is `Image::GetSamplingDistribution`. It is not the texel
// itself, so it is a fifth array rather than a field of `env_texels`.
extern env_dist_values : array[Float];
extern env_dist_cond_cdf : array[Float];
extern env_dist_marg_func : array[Float];
extern env_dist_marg_cdf : array[Float];

element ImageInfiniteLight {
    // pbrt: `renderFromLight` and its inverse. Both, because both are used:
    // `Le` and `PDF_Li` take a render-space direction back into the light's
    // frame, and `SampleLi` sends one the other way.
    light_from_render : Transform;
    render_from_light : Transform;
    scale : Float;
    // The map is square, which pbrt insists on: a non-square one is almost
    // certainly a latitude-longitude image rather than an equal-area octahedral
    // one, and reading it as if it were would be silently wrong.
    resolution : i32;
    // Where this light's texels begin, so two maps can share the array.
    first_texel : i32;
    // pbrt: sceneRadius, for the point a shadow ray towards the sky stops at.
    scene_radius : Float;
    // pbrt: `distribution` and `compensatedDistribution`.
    //
    // Two distributions over the same image, and the second is what
    // `allowIncompletePDF` selects. It samples `max(0, texel - average)`: the
    // part of the sky that is *brighter than average*, on the grounds that a
    // BSDF sample will find the even part perfectly well on its own. Sampling
    // what the other estimator is bad at is the whole idea of MIS compensation,
    // and it is why an environment map needs two tables rather than one.
    dist : Dist2D;
    compensated : Dist2D;
}

// pbrt: Light, which is a TaggedPointer over nine kinds. A variant here, for
// the same reason Integrator is: `match` is how this app spells a vtable.
//
// Three kinds. The rest go in as their own arms, and `light_sample_li` grows an
// arm rather than the callers growing a branch.
element Light =
    | DiffuseArea(area : AreaLight, shape : Shape)
    // `sky` rather than the `inf` that reads more naturally: `inf` is the
    // floating-point infinity in stdlib/numerics, and binding it in a match arm
    // shadows it.
    | UniformInfinite(sky : UniformInfiniteLight)
    | ImageInfinite(img : ImageInfiniteLight);

// pbrt: the scene's lights, one per emissive shape -- which is what pbrt's
// `std::vector<Light>` is. A primitive names one by index, as it names a
// material.
extern lights : array[Light];

// pbrt: Light::L, which SurfaceInteraction::Le reaches through the light rather
// than through the area light directly. An arm per kind, and only the ones that
// are surfaces have an `L` at all -- an infinite light answers `Le(ray)` and
// never this.
func light_l(light : Light, n : vec3f, w : vec3f,
             lambda : SampledWavelengths) -> vec4f {
    match light {
        DiffuseArea(area, shape) => return area_light_l(area, n, w, lambda);
        // An infinite light is not a surface, so nothing ever lands on one and
        // this is unreachable for it. pbrt says the same by not declaring `L`
        // on the class at all.
        UniformInfinite(sky) => return vec4f{0.0, 0.0, 0.0, 0.0};
        ImageInfinite(img) => return vec4f{0.0, 0.0, 0.0, 0.0};
    }
}

// pbrt: UniformInfiniteLight::Le, `scale * Lemit.Sample(lambda)`.
func uniform_infinite_le(sky : UniformInfiniteLight,
                         lambda : SampledWavelengths) -> vec4f {
    illuminant = spectrum_at_dense(illuminant_d65, lambda);
    // With an L, pbrt's Lemit is an RGBIlluminantSpectrum: the fit times the
    // colour space's illuminant, which is what `area_light_l` computes too.
    // Without one, Lemit *is* that illuminant.
    if sky.has_l {
        return sky.scale * spectrum_at(sky.l, lambda) * illuminant;
    }
    return sky.scale * illuminant;
}

// pbrt: RemapPixelCoords under WrapMode::OctahedralSphere -- what an
// environment map does with a texel coordinate that fell off the edge.
//
// Not a clamp and not a repeat. The square is an unfolded octahedron, so
// stepping off one edge arrives back on the *opposite* side of the same
// edge, mirrored: leaving across `u = 0` continues at `u = 0` with `v` flipped
// about the middle, because those two texels are neighbours on the sphere even
// though they are a square apart on the map. A clamp would smear the seam and a
// repeat would join the wrong halves; both would look like a plausible sky.
func wrap_octahedral(px : i32, py : i32, res : i32) -> vec2f {
    x : mut i32 = px;
    y : mut i32 = py;
    if x < 0 {
        x = -x;
        y = res - 1 - y;
    } else if x >= res {
        x = 2 * res - 1 - x;
        y = res - 1 - y;
    }
    if y < 0 {
        x = res - 1 - x;
        y = -y;
    } else if y >= res {
        x = res - 1 - x;
        y = 2 * res - 1 - y;
    }
    return vec2f{cast[[Float]](x), cast[[Float]](y)};
}

// pbrt: ImageInfiniteLight::ImageLe, and the LookupNearestChannel inside it.
//
// *Nearest* and not bilinear, which is pbrt's choice and worth not
// second-guessing: the map is sampled by a distribution built over the same
// texels, so interpolating the lookup and not the distribution would put the
// value and the density slightly out of step with each other.
func image_le(img : ImageInfiniteLight, uv : vec2f,
              lambda : SampledWavelengths) -> vec4f {
    // pbrt: `Point2i pi(p.x * resolution.x, p.y * resolution.y)`, which
    // truncates -- so a uv of exactly one lands one past the edge and is
    // brought back by the wrap below rather than by a clamp.
    res = cast[[Float]](img.resolution);
    at = wrap_octahedral(cast[[i32]](uv.x * res), cast[[i32]](uv.y * res),
                         img.resolution);
    texel = env_texels[img.first_texel +
                       cast[[i32]](at.y) * img.resolution + cast[[i32]](at.x)];
    fit : SigmoidPolynomial = {texel.x, texel.y, texel.z};
    // pbrt: `scale * RGBIlluminantSpectrum(cs, rgb).Sample(lambda)`, which is
    // the light's scale times the fit's own scale times the fit times the
    // colour space's illuminant.
    return img.scale * texel.w * spectrum_at(fit, lambda) *
           spectrum_at_dense(illuminant_d65, lambda);
}

// pbrt: ImageInfiniteLight::Le. The ray's direction, taken back into the
// light's own frame, is a point on the sphere; the map is that sphere unfolded.
func image_infinite_le(img : ImageInfiniteLight, d : vec3f,
                       lambda : SampledWavelengths) -> vec4f {
    w_light = unit_vector_(apply_vector(img.light_from_render, d));
    return image_le(img, equal_area_sphere_to_square(w_light), lambda);
}

// pbrt: Light::Le, the radiance a ray that hit nothing carries. Only the
// infinite lights have one, which is why pbrt keeps them in a list of their own
// and loops over that rather than over every light in the scene.
//
// The ray's direction is a parameter where an area light needed none: an
// environment map answers differently in every direction, which is the whole
// difference between it and the uniform light beside it.
func light_le(light : Light, d : vec3f,
              lambda : SampledWavelengths) -> vec4f {
    match light {
        DiffuseArea(area, shape) => return vec4f{0.0, 0.0, 0.0, 0.0};
        UniformInfinite(sky) => return uniform_infinite_le(sky, lambda);
        ImageInfinite(img) => return image_infinite_le(img, d, lambda);
    }
}

// pbrt: Light::SampleLi. Choose a point on the light as seen from `ctx`, and
// report what it sends back along the direction that reaches it.
//
// Thin, because the work is in the shape: sampling a light *is* sampling its
// geometry towards a point, and the light only decides what the point emits.
// `allow_incomplete_pdf` is pbrt's flag of that name, and it is not a detail
// that can be left out.
//
// It says the caller will find this light some other way as well, so the light
// is allowed to decline to sample the parts of itself that the other way covers
// -- and a uniform infinite light declines entirely, because a BSDF sample that
// escapes finds it with no shadow ray at all. `path` passes true and
// `simplepath` passes false, which is pbrt's own split: the first weighs two
// estimators against each other and the second has only one, so the second
// cannot afford to be declined.
//
// Getting this wrong is not visible as an error. Passing false from `path`
// would sample the light *and* pick it up on escape, count it twice, and
// produce a scene that is simply too bright -- which looks like a scale factor
// somewhere, not like a bug in an MIS weight.
func light_sample_li(light : Light, ctx : ShapeSampleContext, u : vec2f,
                     lambda : SampledWavelengths,
                     allow_incomplete_pdf : bool) -> option[LightLiSample] {
    match light {
        // pbrt: ImageInfiniteLight::SampleLi. A direction is chosen by sampling
        // the map -- so a bright patch of sky is found often and an even one
        // rarely, which is what makes a shadow ray towards an environment map
        // worth spending at all.
        //
        // The density comes back in the *square's* measure and is divided by
        // 4pi to become one in solid angle. That single constant is the whole
        // of the Jacobian, and it is why the map has to be equal-area: on a
        // latitude-longitude map the factor would vary with latitude.
        ImageInfinite(img) => {
            picked = select(allow_incomplete_pdf, img.compensated, img.dist);
            s = dist2d_sample(picked, img.resolution, img.resolution, u,
                              env_dist_values, env_dist_cond_cdf,
                              env_dist_marg_func, env_dist_marg_cdf);
            if s.pdf == 0.0 {
                return {};
            }
            w_light = equal_area_square_to_sphere(s.uv);
            wi = apply_vector(img.render_from_light, w_light);
            far = ctx.p + 2.0 * img.scene_radius * wi;
            out : LightLiSample = {image_le(img, s.uv, lambda), wi,
                                   s.pdf / (4.0 * pi()), far,
                                   vec3f{0.0, 0.0, 0.0}, vec3f{0.0, 0.0, 0.0}};
            return out;
        }
        UniformInfinite(sky) => {
            if allow_incomplete_pdf {
                return {};
            }
            // No geometry to sample, so the whole sphere with a constant
            // density. The point is put two scene radii away, which is pbrt's
            // way of giving a shadow ray somewhere to stop that is certainly
            // outside everything.
            wi = sample_uniform_sphere(u);
            far = ctx.p + 2.0 * sky.scene_radius * wi;
            s : LightLiSample = {uniform_infinite_le(sky, lambda), wi,
                                 uniform_sphere_pdf(), far,
                                 vec3f{0.0, 0.0, 0.0}, vec3f{0.0, 0.0, 0.0}};
            return s;
        }
        DiffuseArea(area, shape) => {
            found = shape_sample(shape, ctx, u);
            if !found {
                return {};
            }
            ss = *found;
            if (ss.pdf == 0.0) || (sqlen[[Float]](ss.p - ctx.p) == 0.0) {
                return {};
            }
            wi = unit_vector_(ss.p - ctx.p);
            // The light is asked what it emits *towards the viewer*, which is
            // -wi: `wi` points from the surface to the light.
            emitted = area_light_l(area, ss.n, -wi, lambda);
            if !nonzero(emitted) {
                return {};
            }
            s : LightLiSample = {emitted, wi, ss.pdf, ss.p, ss.p_error, ss.n};
            return s;
        }
    }
}

// pbrt: Light::PDF_Li, the density `light_sample_li` draws `wi` with. What MIS
// weighs the light's estimator against the BSDF's with.
func light_pdf_li(light : Light, ctx : ShapeSampleContext, wi : vec3f,
                  allow_incomplete_pdf : bool) -> Float {
    match light {
        DiffuseArea(area, shape) => return shape_pdf(shape, ctx, wi);
        // Zero rather than the sphere's density, and it has to be: the caller
        // asked with `allow_incomplete_pdf` set, `light_sample_li` declined to
        // sample this light at all, and a weight computed against a density
        // nothing drew from would be a weight against nothing.
        UniformInfinite(sky) =>
            return select(allow_incomplete_pdf, 0.0, uniform_sphere_pdf());
        // pbrt: ImageInfiniteLight::PDF_Li, and the same 4pi. Note what is
        // *not* here: pbrt normalizes the direction in `Le` and does not
        // normalize it here, so neither does this.
        ImageInfinite(img) => {
            uv = equal_area_sphere_to_square(
                apply_vector(img.light_from_render, wi));
            picked = select(allow_incomplete_pdf, img.compensated, img.dist);
            return dist2d_pdf(picked, img.resolution, img.resolution, uv,
                              env_dist_values) / (4.0 * pi());
        }
    }
}

// pbrt: the `infiniteLights` an Integrator keeps beside its `lights`.
//
// A subrange rather than a second list, because it is one: `scene_dump` writes
// the scene's lights in pbrt's own order, which is every area light first and
// then every other kind, so the infinite ones are a run at the end. What the
// integrators need it for is the escaped ray -- looping over all of a scene's
// lights there would be 66,533 of them on killeroo-simple and none of them
// would answer anything.
element LightSet {
    count : i32;
    first_infinite : i32;
}

// pbrt: SampledLight -- which light was chosen and with what probability.
element SampledLight {
    light : i32;
    p : Float;
}

// pbrt: LightType, asked through IsDeltaLight. A point or a directional light
// is a delta in solid angle: there is no density to weigh a BSDF sample against
// because a BSDF will never sample that direction, so multiple importance
// sampling has nothing to combine and the light's estimator stands alone.
//
// An area light is not one, which is why every arm here answers false. It is
// written out rather than left implicit because the day a point light arrives
// this is the line that has to change, and a `path` integrator that forgot it
// would quietly halve the light's contribution.
func light_is_delta(light : Light) -> bool {
    match light {
        DiffuseArea(area, shape) => return false;
        // pbrt: LightType::Infinite, which IsDeltaLight does not include. It
        // arrives from every direction, so a BSDF sample can find it.
        UniformInfinite(sky) => return false;
        ImageInfinite(img) => return false;
    }
}

// pbrt: one node of BVHLightSampler's tree, dequantized -- the CompactLightBounds
// read back through the accessors pbrt's importance reads them through, so the
// importance below runs on plain floats and comes out as pbrt's. Scalar fields
// rather than a vec3f so the bytes are exactly the driver's LightTreeNode: a
// vec3f in storage is the compute vector's sixteen, and this is three floats.
// See scene_dump.cpp, which builds the tree with pbrt's own builder.
element LightTreeNode {
    wx : Float; wy : Float; wz : Float;
    phi : Float;
    cos_theta_o : Float;
    cos_theta_e : Float;
    bmin_x : Float; bmin_y : Float; bmin_z : Float;
    bmax_x : Float; bmax_y : Float; bmax_z : Float;
    two_sided : u32;
    // Interior: the second child, an absolute node index. Leaf: a light ordinal.
    child_or_light : u32;
    is_leaf : u32;
}

extern light_tree : array[LightTreeNode];
extern light_bit_trails : array[u32];

func bvh_safe_sqrt(x : Float) -> Float = sqrt(max(x, 0.0));

// pbrt: BoundSubtendedDirections(bounds, p).cosTheta -- the cosine of the half
// angle the box subtends from p, or -1 (the whole sphere) when p is inside it.
func bounds_subtended_cos(bmin : vec3f, bmax : vec3f, p : vec3f) -> Float {
    center = (bmin + bmax) * 0.5;
    radius2 = sqlen_((bmax - bmin) * 0.5);
    d2 = sqlen_(p - center);
    if d2 < radius2 {
        return -1.0;
    }
    return bvh_safe_sqrt(1.0 - radius2 / d2);
}

// pbrt's cosSubClamped/sinSubClamped: cos/sin of (theta_a - theta_b) clamped to
// zero angle, the subtraction of two cones' half-angles.
func cos_sub_clamped(sin_a : Float, cos_a : Float, sin_b : Float,
                     cos_b : Float) -> Float =
    select(cos_a > cos_b, 1.0, cos_a * cos_b + sin_a * sin_b);
func sin_sub_clamped(sin_a : Float, cos_a : Float, sin_b : Float,
                     cos_b : Float) -> Float =
    select(cos_a > cos_b, 0.0, sin_a * cos_b - cos_a * sin_b);

// pbrt: CompactLightBounds::Importance, the estimate of how much a light's
// bounds can send towards the shading point -- power, folded by how far the
// point is off the emission cone and off the surface's own normal. `ctx.ns` is
// the shading normal pbrt weighs the incident cosine with.
func light_node_importance(node : LightTreeNode,
                           ctx : ShapeSampleContext) -> Float {
    w = vec3f{node.wx, node.wy, node.wz};
    bmin = vec3f{node.bmin_x, node.bmin_y, node.bmin_z};
    bmax = vec3f{node.bmax_x, node.bmax_y, node.bmax_z};
    p = ctx.p;
    pc = (bmin + bmax) * 0.5;
    d2 = max(sqlen_(p - pc), norm(bmax - bmin) * 0.5);

    wi = unit_vector_(p - pc);
    cos_w0 = dot(w, wi);
    cos_w = select(node.two_sided != 0u, abs(cos_w0), cos_w0);
    sin_w = bvh_safe_sqrt(1.0 - cos_w * cos_w);

    cos_b = bounds_subtended_cos(bmin, bmax, p);
    sin_b = bvh_safe_sqrt(1.0 - cos_b * cos_b);
    sin_o = bvh_safe_sqrt(1.0 - node.cos_theta_o * node.cos_theta_o);

    cos_x = cos_sub_clamped(sin_w, cos_w, sin_o, node.cos_theta_o);
    sin_x = sin_sub_clamped(sin_w, cos_w, sin_o, node.cos_theta_o);
    cos_tp = cos_sub_clamped(sin_x, cos_x, sin_b, cos_b);
    if cos_tp <= node.cos_theta_e {
        return 0.0;
    }

    imp : mut Float = node.phi * cos_tp / d2;
    // The incident-cosine factor at a surface. Always taken here: a shading
    // point has a normal. pbrt guards it for the point-in-space case, which a
    // path tracer's light sampling is not.
    if sqlen_(ctx.ns) != 0.0 {
        cos_i = abs(dot(wi, ctx.ns));
        sin_i = bvh_safe_sqrt(1.0 - cos_i * cos_i);
        imp = imp * cos_sub_clamped(sin_i, cos_i, sin_b, cos_b);
    }
    return max(imp, 0.0);
}

// pbrt: the descent of BVHLightSampler::Sample once the infinite lights have
// been split off -- at each interior node the two children's importances are a
// two-way discrete choice (pbrt's SampleDiscrete), and the leaf is the light.
// A `while` rather than the recursion pbrt writes: the tree is not something a
// schedule turns into a wavefront, it is a handful of nodes walked per shadow
// ray.
func bvh_descend(u_in : Float, pmf_in : Float,
                 ctx : ShapeSampleContext) -> option[SampledLight] {
    node_index : mut i32 = 0;
    u : mut Float = u_in;
    pmf : mut Float = pmf_in;
    // The leaf's light, or -1 if a node of zero total importance stopped the
    // walk. The option is built once at the single exit, since a bare
    // SampledLight is not itself an option[SampledLight].
    chosen : mut i32 = -1;
    done : mut bool = false;
    while !done {
        node = light_tree[cast[[u32]](node_index)];
        if node.is_leaf != 0u {
            chosen = cast[[i32]](node.child_or_light);
            done = true;
        } else {
            ci0 = light_node_importance(light_tree[cast[[u32]](node_index + 1)],
                                        ctx);
            ci1 = light_node_importance(light_tree[node.child_or_light], ctx);
            imp_sum = ci0 + ci1;
            if imp_sum == 0.0 {
                done = true;
            } else {
                up = u * imp_sum;
                if up < ci0 {
                    u = min(up / ci0, 0.99999994);
                    pmf = pmf * (ci0 / imp_sum);
                    node_index = node_index + 1;
                } else {
                    u = min((up - ci0) / ci1, 0.99999994);
                    pmf = pmf * (ci1 / imp_sum);
                    node_index = cast[[i32]](node.child_or_light);
                }
            }
        }
    }
    if chosen < 0 {
        return {};
    }
    s : SampledLight = {chosen, pmf};
    return s;
}

// pbrt: BVHLightSampler::PMF, the density the descent above draws a bounded
// light with, recovered by walking that light's stored bit trail rather than
// its importances -- the turns are known, only the probabilities are recomputed.
func bvh_pmf_bounded(light : i32, ctx : ShapeSampleContext) -> Float {
    trail : mut u32 = light_bit_trails[cast[[u32]](light)];
    node_index : mut i32 = 0;
    pmf : mut Float = 1.0;
    done : mut bool = false;
    while !done {
        node = light_tree[cast[[u32]](node_index)];
        if node.is_leaf != 0u {
            done = true;
        } else {
            ci0 = light_node_importance(light_tree[cast[[u32]](node_index + 1)],
                                        ctx);
            ci1 = light_node_importance(light_tree[node.child_or_light], ctx);
            went_right = (trail & 1u) != 0u;
            ci = select(went_right, ci1, ci0);
            pmf = pmf * (ci / (ci0 + ci1));
            node_index = select(went_right, cast[[i32]](node.child_or_light),
                                node_index + 1);
            trail = trail >> 1u;
        }
    }
    return pmf;
}

// pbrt: LightSampler, another TaggedPointer and so another variant. Uniform is
// pbrt's fallback and what simplepath always uses; `BVHLights` is pbrt's default
// for `path`, the importance tree above. They differ once a scene has two or
// more bounded lights (see scene_dump.cpp); below that the driver keeps the
// cheaper uniform arm.
element LightSampler =
    | UniformLights(num : i32)
    | BVHLights(num_bounded : i32, num_infinite : i32);

// pbrt: UniformLightSampler::Sample, and BVHLightSampler::Sample. The uniform
// arm gives every light the same chance; the BVH arm splits the infinite lights
// off with a fixed probability and walks the tree for the rest.
//
// `min` because a `u` of exactly one would index off the end. pbrt guards it
// the same way rather than assuming the sampler never returns it.
func light_sampler_sample(ls : LightSampler, ctx : ShapeSampleContext,
                          u : Float) -> option[SampledLight] {
    match ls {
        UniformLights(num) => {
            if num == 0 {
                return {};
            }
            index = min(cast[[i32]](u * cast[[Float]](num)), num - 1);
            s : SampledLight = {index, 1.0 / cast[[Float]](num)};
            return s;
        }
        BVHLights(num_bounded, num_infinite) => {
            has_tree = select(num_bounded == 0, 0, 1);
            denom = cast[[Float]](num_infinite + has_tree);
            p_inf = cast[[Float]](num_infinite) / denom;
            if u < p_inf {
                uu = u / p_inf;
                index = min(cast[[i32]](uu * cast[[Float]](num_infinite)),
                            num_infinite - 1);
                // The infinite lights sit after the bounded ones in the list.
                s : SampledLight = {num_bounded + index, p_inf /
                                    cast[[Float]](num_infinite)};
                return s;
            }
            if num_bounded == 0 {
                return {};
            }
            uu = min((u - p_inf) / (1.0 - p_inf), 0.99999994);
            return bvh_descend(uu, 1.0 - p_inf, ctx);
        }
    }
}

// pbrt: LightSampler::PMF, the probability `light_sampler_sample` would have
// chosen this light. The other half of the MIS weight.
func light_sampler_pmf(ls : LightSampler, ctx : ShapeSampleContext,
                       light : i32) -> Float {
    match ls {
        UniformLights(num) =>
            return select(num == 0, 0.0, 1.0 / cast[[Float]](num));
        BVHLights(num_bounded, num_infinite) => {
            has_tree = select(num_bounded == 0, 0, 1);
            if light >= num_bounded {
                // An infinite light: uniform among them, which is the same
                // 1 / (num_infinite + has_tree) pbrt returns.
                return 1.0 / cast[[Float]](num_infinite + has_tree);
            }
            p_inf = cast[[Float]](num_infinite) /
                    cast[[Float]](num_infinite + has_tree);
            return (1.0 - p_inf) * bvh_pmf_bounded(light, ctx);
        }
    }
}

// pbrt: GeometricPrimitive -- a shape paired with what it is made of. The
// geometry answers where a ray hits; the material answers what is there.
element Geometric {
    shape : Shape;
    // Which of the scene's lights this primitive emits as, or -1 for one that
    // does not. Per primitive rather than per material because pbrt's
    // `AreaLightSource` is a graphics-state directive like `Material` and the
    // two are set independently -- killeroo-simple's emissive sphere has a
    // `diffuse` material of its own.
    light : i32;
    // pbrt: the Material a shape was declared under, which is a pointer there
    // because a scene has a handful of materials and thousands of shapes. Here
    // it is an index into `materials` for the same reason: killeroo-simple has
    // four materials and 66,533 triangles, and a material carried by value
    // would be four megabytes of the same sixty-four bytes.
    material : u32;
    // pbrt: GeometricPrimitive's `alpha` texture, or -1 where the shape has
    // none -- which is almost all of them, so PBRT keeps such a shape in a
    // `SimplePrimitive` with no alpha field at all.
    //
    // A cutout: the texture says how much of the surface is really there, and
    // a ray that lands on a transparent part passes through. It is what makes
    // a tree leaf leaf-shaped rather than a quad.
    alpha : i32;
}

// pbrt: Primitive, the TaggedPointer the top-level BVHAggregate is built over.
// Two of its kinds are here: a GeometricPrimitive standing on its own, and a
// TransformedPrimitive -- an `ObjectInstance`, which is a transform and a whole
// tree of GeometricPrimitives shared by every instance of the same object.
// pbrt's `Primitive::Intersect` dispatches on which one it has, and the two arms
// cost what they cost: a shape test for the first, `ApplyInverse` and a walk of
// the held tree for the second. That dispatch is the `match` in `geometry`
// below, and the compiler puts it where pbrt puts it: once per primitive a
// leaf holds.
//
// pbrt's Transform carries its inverse beside it, and so does this: `render_
// from_instance` places the object, `instance_from_render` pulls a ray back
// into it, and both are pbrt's own matrices as scene_dump read them off it.
// (pbrt's AnimatedPrimitive -- an instance whose transform moves over the
// frame -- is not here; scene_dump refuses one.)
element Primitive =
    | Geom(g : Geometric)
    | Inst(render_from_instance : Transform, instance_from_render : Transform,
           blas : set[Geometric]);

// pbrt: what Primitive::Intersect dispatches to -- the one shape a
// GeometricPrimitive is, or everything a TransformedPrimitive's tree holds. A
// set, because the two arms hold different numbers of things, and a function
// so that the queries and the extent name it once.
func geometry(p : Primitive) -> set[Geometric] =
    match p {
        Geom(g) => set[Geometric]{g},
        Inst(render_from_instance, instance_from_render, blas) => blas
    };

// pbrt: Primitive::Bounds() -- Shape::Bounds() for a GeometricPrimitive, and
// `renderFromPrimitive(primitive.Bounds())` for a TransformedPrimitive: the
// geometry the primitive holds, placed by the primitive. It is what the
// top-level tree's boxes are built from, so it is the promise every node of
// that tree makes about what lies beneath it. After `geometry`, since it
// names it.
element Primitive with extent = |p| transform(p, geometry(p).AABB);

// pbrt: Transform::operator()(const Bounds3f &), which unions the eight
// transformed corners -- the short version, transforming the two extreme
// points, is wrong for any rotation.
func transform_bounds(t : Transform, b : AABB) -> AABB {
    c0 = apply_point(t, vec3f{b.low.x, b.low.y, b.low.z});
    c1 = apply_point(t, vec3f{b.high.x, b.low.y, b.low.z});
    c2 = apply_point(t, vec3f{b.low.x, b.high.y, b.low.z});
    c3 = apply_point(t, vec3f{b.high.x, b.high.y, b.low.z});
    c4 = apply_point(t, vec3f{b.low.x, b.low.y, b.high.z});
    c5 = apply_point(t, vec3f{b.high.x, b.low.y, b.high.z});
    c6 = apply_point(t, vec3f{b.low.x, b.high.y, b.high.z});
    c7 = apply_point(t, vec3f{b.high.x, b.high.y, b.high.z});
    lo = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    hi = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));
    out : AABB = {lo, hi};
    return out;
}

// pbrt: Transform::ApplyInverse(const Ray &, Float *tMax), the top of
// TransformedPrimitive::Intersect: the ray moved into the instance's frame, so
// that everything inside the instance's tree is tested against stored
// geometry. `inv` is the inverse matrix, so applying it is `ApplyInverse`.
//
// The origin is a point and goes through the interval-point arithmetic pbrt
// uses for it -- `(m00 x + m01 y) + (m02 z + m03)`, paired that way -- and the
// direction is a vector, through the same rows without the translation. The
// direction is *not* renormalised, on purpose and as in pbrt: an affine map
// preserves the parameter along a line only when the direction is transformed
// rather than rescaled, and it is that parameter -- the `t` of a hit -- that
// `distmin` answers and that the running best is compared against. Renormalise
// and an instance could no longer prune against a hit found in another one.
//
// pbrt then nudges the origin forward by its rounding error, `o += d * dt`, and
// takes the same `dt` off `tMax` so that the two sides still agree about where
// the best hit so far is. That is not done here. The nudge is against a ray
// re-hitting the surface its origin was rounded onto, which this renderer
// guards with pbrt's own SpawnRay offset, applied in render space before the
// ray reaches any instance; and `tMax` is not a field
// of the query here but the traversal's accumulator, which nothing inside a
// query may alter (see PLAN.md). Without the nudge the identity the whole
// arrangement rests on -- a distance along the pulled ray *is* the distance
// along the original -- holds exactly rather than up to `dt`, and the hit point
// differs from pbrt's by that `dt`: a few units in the last place.
func pull_ray(inv : Transform, r : Ray) -> Ray {
    o = vec3f{fma(inv.r0.y, r.o.y, inv.r0.x * r.o.x) + fma(inv.r0.z, r.o.z, inv.r0.w),
              fma(inv.r1.y, r.o.y, inv.r1.x * r.o.x) + fma(inv.r1.z, r.o.z, inv.r1.w),
              fma(inv.r2.y, r.o.y, inv.r2.x * r.o.x) + fma(inv.r2.z, r.o.z, inv.r2.w)};
    wp = fma(inv.r3.y, r.o.y, inv.r3.x * r.o.x) + fma(inv.r3.z, r.o.z, inv.r3.w);
    out : Ray = {select(wp == 1.0, o, o / wp), apply_vector(inv, r.d), r.tmax};
    return out;
}

// pbrt: Transform::operator()(const SurfaceInteraction &), the bottom of
// TransformedPrimitive::Intersect: the interaction the instance's own geometry
// computed, moved into render space once. Points by the matrix, vectors by its
// upper three by three, normals by the inverse transposed -- pbrt's
// `operator()(Normal3f)` reads the *columns* of the inverse -- and the two
// normals renormalised afterwards, as pbrt's are. `shading.n` is then turned
// to face the geometric normal, which is the last line of pbrt's version.
//
// The hit point is pbrt's Point3fi: the position, and the bound on how far the
// arithmetic could have put it, which grows through the transform the way
// pbrt's `Transform::operator()(const Point3fi &)` grows it -- the incoming
// error scaled by the matrix's magnitudes, plus the transform's own rounding.
func push_surface(m : Transform, inv : Transform,
                  s : SurfaceGeometry) -> SurfaceGeometry {
    p = vec3f{fma(m.r0.y, s.p.y, m.r0.x * s.p.x) + fma(m.r0.z, s.p.z, m.r0.w),
              fma(m.r1.y, s.p.y, m.r1.x * s.p.x) + fma(m.r1.z, s.p.z, m.r1.w),
              fma(m.r2.y, s.p.y, m.r2.x * s.p.x) + fma(m.r2.z, s.p.z, m.r2.w)};
    wp = fma(m.r3.y, s.p.y, m.r3.x * s.p.x) + fma(m.r3.z, s.p.z, m.r3.w);
    g3 = gamma(3);
    e = s.p_error;
    p_error = vec3f{
        (g3 + 1.0) * (abs(m.r0.x) * e.x + abs(m.r0.y) * e.y + abs(m.r0.z) * e.z) +
            g3 * (abs(m.r0.x * s.p.x) + abs(m.r0.y * s.p.y) + abs(m.r0.z * s.p.z) +
                  abs(m.r0.w)),
        (g3 + 1.0) * (abs(m.r1.x) * e.x + abs(m.r1.y) * e.y + abs(m.r1.z) * e.z) +
            g3 * (abs(m.r1.x * s.p.x) + abs(m.r1.y * s.p.y) + abs(m.r1.z * s.p.z) +
                  abs(m.r1.w)),
        (g3 + 1.0) * (abs(m.r2.x) * e.x + abs(m.r2.y) * e.y + abs(m.r2.z) * e.z) +
            g3 * (abs(m.r2.x * s.p.x) + abs(m.r2.y * s.p.y) + abs(m.r2.z * s.p.z) +
                  abs(m.r2.w))};
    n = unit_vector_(apply_normal_inverse(inv, s.n));
    ns_raw = unit_vector_(apply_normal_inverse(inv, s.ns));
    ns = select(dot(ns_raw, n) < 0.0, -ns_raw, ns_raw);
    out : SurfaceGeometry = {n, ns,
                             apply_vector(m, s.dpdus), apply_vector(m, s.dpdvs),
                             s.uv,
                             apply_vector(m, s.dpdu), apply_vector(m, s.dpdv),
                             apply_normal_inverse(inv, s.dndu),
                             apply_normal_inverse(inv, s.dndv),
                             select(wp == 1.0, p, p / wp),
                             select(wp == 1.0, p_error, p_error / abs(wp))};
    return out;
}

// The primitive as a motion: pbrt's TransformedPrimitive moves what it holds
// and its GeometricPrimitive holds it where it is. These three are the
// `renderFromPrimitive->...` lines of TransformedPrimitive, each dispatched on
// the primitive -- and, for a GeometricPrimitive, the nothing that
// GeometricPrimitive does instead. Supplying `untransform` for a ray is what
// lets the compiler rewrite `intersects(r, transform(p, g))` into
// `intersects(untransform(p, r), g)` and pull the ray back once per primitive,
// which is where pbrt's `ApplyInverse` is (see Opt/PullQueries.h).
func transform(p : Primitive, b : AABB) -> AABB {
    match p {
        Geom(g) => return b;
        Inst(render_from_instance, instance_from_render, blas) =>
            return transform_bounds(render_from_instance, b);
    }
}

func untransform(p : Primitive, r : Ray) -> Ray {
    match p {
        Geom(g) => return r;
        Inst(render_from_instance, instance_from_render, blas) =>
            return pull_ray(instance_from_render, r);
    }
}

func transform(p : Primitive, s : SurfaceGeometry) -> SurfaceGeometry {
    match p {
        Geom(g) => return s;
        Inst(render_from_instance, instance_from_render, blas) =>
            return push_surface(render_from_instance, instance_from_render, s);
    }
}

// pbrt: GeometricPrimitive::Intersect's alpha test.
//
// The test is stochastic and the draw is `HashFloat(ray.o, ray.d)` -- a hash of
// the ray rather than a sampler draw, so that the same ray always makes the
// same decision and a shadow ray agrees with the camera ray that cast it.
//
// pbrt recurses on rejection, spawning a new ray past the hit and intersecting
// the same primitive again. For a triangle that recursion can only miss, since
// a triangle is hit at most once -- so what it comes to is exactly this: the
// hit does not count. The BVH then goes on to the next candidate of its own
// accord, which is what makes the whole thing expressible as a condition on
// the set rather than as a loop around the query.
//
// The ray is the one the geometry was tested against: inside an instance that
// is the ray pulled back into the instance's frame, which is the ray pbrt's
// GeometricPrimitive::Intersect sees there too, and `HashFloat` hashes it.
func alpha_accepts(r : Ray, p : Geometric) -> bool {
    if p.alpha < 0 {
        return true;
    }
    g = surface_geometry(p.shape, r);
    a = texture_float(textures[cast[[u32]](p.alpha)], g.uv, 0.0, 0.0, 0.0, 0.0);
    if a >= 1.0 {
        return true;
    }
    // pbrt: `Float u = (a <= 0) ? 1.f : HashFloat(r.o, r.d);` -- a fully
    // transparent texel is rejected without consulting the hash at all.
    u = select(a <= 0.0, 1.0,
               hash_float6(reinterpret[[i32]](r.o.x), reinterpret[[i32]](r.o.y),
                           reinterpret[[i32]](r.o.z), reinterpret[[i32]](r.d.x),
                           reinterpret[[i32]](r.d.y),
                           reinterpret[[i32]](r.d.z)));
    return u <= a;
}

// pbrt: the scene's materials. Every spectrum in one is an RGB already fitted
// to three sigmoid coefficients -- the fit is a Gauss-Newton solve and belongs
// nowhere near a ray, so the driver does it once per material, exactly as pbrt
// looks it up in a table generated offline.
extern materials : array[Material];
// pbrt: `Material::GetDisplacement()`, indexed the same way `materials` is.
//
// Beside the materials rather than inside them because that is where pbrt keeps
// it: a displacement is not part of what any one material *is*, it tilts the
// shading frame before `GetBSDF` asks the material anything, and every kind of
// material may carry one. Negative where there is none.
extern material_displacement : array[i32];

// pbrt: the path integrator's fixed sample points for a reflectance estimate,
// which are file-scope constants there. Fixed rather than drawn from the
// sampler, so that the albedo a pixel records does not depend on where in the
// stream the estimate happened to fall -- and so that two pixels of the same
// material agree.
//
// Externs rather than locals of the function that uses them, which is where
// they read most naturally. A local array is allocated where it is declared,
// and these were being allocated per camera ray: three mallocs of sixty-four
// bytes on every hit, never freed, which cost a fifth of the render and four
// gigabytes of resident memory on a scene with no layered material in it at
// all. Constants belong somewhere they are built once.
extern rho_uc : array[Float];
extern rho_ux : array[Float];
extern rho_uy : array[Float];

// The ray queries pass straight through to the geometry: which primitive a ray
// hits is a question about its shape alone.
func distmin(r : Ray, p : Geometric) -> Float = distmin(r, p.shape);
func distmax(r : Ray, p : Geometric) -> Float = distmax(r, p.shape);
func intersects(r : Ray, p : Geometric) -> bool = intersects(r, p.shape);

extern primitives : set[Primitive];

// pbrt: Primitive::Intersect over the whole scene. Written as the question it
// is -- of the geometry this ray hits, which is nearest -- rather than as a
// traversal. The schedule turns it into one.
//
// The searched set is every GeometricPrimitive the scene reaches: the ones
// standing on their own, and every one held by every instance, each seen
// through the primitive it was reached by. The tests place it --
// `transform(p, g)`, the geometry where its primitive puts it, against the
// ray as it arrived -- because that is one uniform ray against one varying
// geometric object, which is the shape predicate analysis bounds. pbrt writes
// the other side of the same identity, `ApplyInverse(r)` against stored
// geometry, and so does the code this compiles to: the compiler moves the
// motion onto the ray and hoists it to once per primitive (Opt/PullQueries.h).
// The answer is the pair as stored, the hit in the instance's own frame, and
// `transform(p, surf)` at the call sites is TransformedPrimitive's one
// transform of the result.
//
// No minimum distance. pbrt has none: a shape's own test accepts any `t` in
// (0, tMax), and what keeps a ray from finding the surface it left is that
// `spawn_ray` starts it off that surface by the hit's rounding error. There
// used to be a `distmin > 0.001` here, from before the error bounds were
// carried, and it was a light leak: `t` is the parameter of the ray's own
// direction, and a shadow ray's direction is the whole way to the light, so a
// thousandth of it was six centimetres on the pavilion's pool -- through which
// the wall a bump-mapped normal had aimed the shadow ray into was invisible,
// and the wall came out several times as bright as pbrt's.
func trace(r : Ray) =
    argmin(|p : Primitive, g : Geometric| distmin(r, transform(p, g)),
           filter(|p : Primitive, g : Geometric|
                      intersects(r, transform(p, g)) &&
                      alpha_accepts(untransform(p, r), g),
                  flatten(|p : Primitive| geometry(p), primitives)));

// pbrt: Primitive::IntersectP -- is there *anything* along this ray?
//
// The same question as `trace` with the `argmin` taken off, which is exactly
// what a shadow ray wants: an occlusion test does not care which surface is in
// the way or how far off it is, only that one is. That is a strictly easier
// query and the schedule can lower it as one -- a traversal that stops at the
// first leaf that answers yes, rather than one that has to visit every subtree
// that could hold something nearer than the best hit so far.
//
// Written as `any` over the same predicate rather than as a second traversal,
// because the difference between the two queries is the whole point: the
// source says what is being asked and the schedule decides what that costs.
// The alpha test is here too, and for pbrt's reason: `GeometricPrimitive::
// IntersectP` answers `Intersect(...).has_value()` where there is an alpha
// texture, rather than the shape's cheaper occlusion test. A leaf that a camera
// ray passes through must not cast a shadow.
func trace_any(r : Ray) =
    any(|p : Primitive, g : Geometric|
            intersects(r, transform(p, g)) &&
            alpha_accepts(untransform(p, r), g),
        flatten(|p : Primitive| geometry(p), primitives));

// pbrt: VisibleSurface, what a camera ray leaves behind for the film to
// record. pbrt fills one of these from a single intersection and the gbuffer
// writes every channel out of it.
//
// One structure rather than a function per channel, for the reason pbrt has
// one: asking separately meant tracing the same ray once per channel, and the
// scene query is the expensive part of a render. Two channels doubled the
// render time, which is what that costs.
//
// Both normals, as pbrt writes both: `n` is the shape's and `ns` is the one the
// BSDF was built about -- interpolated across a mesh's vertex normals and then
// tilted by a displacement, where the material has one. A displacement changes
// nothing the geometric normal can see, so `ns` is the channel that checks a
// bump map against pbrt's.
//
// `set` is pbrt's: a VisibleSurface starts out empty and the integrator that
// fills one marks it, so the film can tell a camera ray that found a surface
// from one that escaped, and an integrator that fills none from one that does.
element VisibleSurface {
    n : vec3f;
    ns : vec3f;
    albedo : vec3f;
    set : bool;
}

// pbrt: Integrator, which is a TaggedPointer over the eight ways pbrt knows to
// turn a camera ray into radiance.
//
// A variant type, because that is what a bonsai interface is: `match` is the
// vtable, and dispatching on one is how this app transcribes anything pbrt
// dispatches virtually. It also means the driver hands over whichever
// integrator the scene named and the same binary runs it, rather than there
// being an exported entry point per configuration.
//
// Three variants. Their parameters go in their own arms -- pbrt's
// SimplePathIntegrator carries `sampleLights` and `sampleBSDF` where
// PathIntegrator carries `regularize`, and a variant is where those belong
// rather than in a shared struct whose fields two thirds of the arms ignore.
//
// `VolPath` is what pbrt defaults to and is the next one worth having; it needs
// participating media, which nothing here has.
// Every arm carries a `LightSet`, which is pbrt's `Integrator::infiniteLights`
// -- a base-class member, so every integrator has one, including the random
// walk that samples no light at all. A ray that leaves the scene has to be
// asked what it flew off into whatever the integrator is.
element Integrator =
    | RandomWalk(max_depth : i32, set : LightSet)
    | SimplePath(max_depth : i32, sampler : LightSampler, set : LightSet)
    | Path(max_depth : i32, sampler : LightSampler, set : LightSet,
           regularize : bool);

// pbrt: RandomWalkIntegrator::LiRandomWalk, the radiance arriving along a ray.
//
// The simplest integrator pbrt has, and the right one to arrive first: it never
// samples a light, so it needs no `SampleLi`, no light PDF and no shadow ray.
// It finds a light by scattering into one, which makes it very noisy and makes
// everything it does depend on nothing but the BSDF and the sampler -- both of
// which are already checked against pbrt on their own.
//
// Recursive, as pbrt's is, and that is a scheduling decision rather than a
// stylistic one. A `while` loop carrying the state would already have said that
// a path is walked to its end before the next one starts; a tail call says only
// what the next step is and leaves `loopify()` to decide, which is what lets
// the same source become a wavefront -- a queue of suspended paths advanced
// together -- instead of a per-pixel loop. It is the rule `trace` follows
// above, where the traversal is a recursion and `trace.loopify(64)` in the
// schedule turns it into a stack.
//
// `beta` is pbrt's throughput and `l` the radiance found so far, both carried
// as arguments because that is what a tail call has instead of mutable state.
// The estimator divides by a density that does not depend on direction -- the
// walk scatters uniformly over the whole sphere, including into the surface --
// which is why it is unbiased despite knowing nothing about the BSDF it is
// sampling.
//
// The draws from the sampler are what must not move: one `get_2d` per bounce,
// taken before the ray for the next bounce is built.
// The camera and the sample scale ride along so that a textured material can be
// filtered. pbrt's `GetBSDF` computes the differentials whichever integrator
// called it, so a random walk over a textured scene filters its textures the
// same way a path does -- it just never has a ray carrying differentials of its
// own past the first vertex, so every lookup uses the camera approximation.
func walk_step(ray : Ray, ray_diff : RayDifferential,
               camera : PerspectiveCamera, spp_scale : Float,
               beta : vec4f, l : vec4f,
               lambda : SampledWavelengths, sampler : Sampler,
               state : mut SamplerState, ls : LightSet, seed : i32,
               depth : i32, max_depth : i32) -> vec4f {
    isect = trace(ray);
    if !isect {
        // pbrt sums `light.Le(ray)` over the infinite lights. A random walk
        // never samples a light, so there is no weight to apply and nothing to
        // avoid counting twice -- this is simply the emission along a ray that
        // left the scene.
        escaped : mut vec4f = l;
        for i in ls.first_infinite:ls.count {
            escaped = escaped + beta * light_le(lights[i], ray.d, lambda);
        }
        return escaped;
    }
    reached = *isect;
    via = reached[0];
    prim = reached[1];
    // pbrt: the geometry computes its interaction in the frame it was tested
    // in -- an instance's own, for a TransformedPrimitive -- and
    // TransformedPrimitive::Intersect moves it into render space once. So the
    // ray is the one the traversal tested with, pulled back where it was, and
    // the transform is the one pbrt applies on the way out.
    surf = transform(via, surface_geometry(prim.shape, untransform(via, ray)));
    // pbrt: `Vector3f wo = -ray.d`, and *not* `isect.wo`. The two differ:
    // Interaction's constructor normalizes the direction it is handed, and this
    // integrator never asks it for one -- it negates the ray directly. A camera
    // ray's direction is a unit vector transformed by a rigid motion, so it is
    // unit to within a bit or two and not exactly, which is enough to change
    // the last bit of everything downstream of the shading frame. `rho` in
    // `full_path_step`'s visible surface does go through `isect.wo` and is
    // normalized there, for the same reason: because pbrt does.
    wo = -ray.d;

    // pbrt: SurfaceInteraction::Le. The emission of the surface the ray landed
    // on, which for a random walk is the only way light is ever found.
    emitted = select(prim.light >= 0,
                     beta * light_l(lights[max(prim.light, 0)], surf.n, wo,
                                    lambda),
                     vec4f{0.0, 0.0, 0.0, 0.0});
    found = l + emitted;

    if depth == max_depth {
        return found;
    }

    // pbrt: GetBSDF, then a direction sampled uniformly over the sphere, then
    // `bsdf.f(wo, wp) * AbsDot(wp, shading.n)`.
    diffs = compute_differentials(surf, ray_diff, camera, spp_scale);
    hit = displaced(surf, material_displacement[prim.material], diffs);
    shading = frame_from_xz(unit_vector_(hit.dpdus), hit.ns);
    bsdf = material_bxdf(materials[prim.material], lambda, false, hit.uv,
                         diffs.dudx, diffs.dvdx, diffs.dudy, diffs.dvdy);
    u = get_2d(sampler, state);
    wp = sample_uniform_sphere(u);
    fcos = bxdf_f(bsdf, frame_to_local(shading, wo),
                  frame_to_local(shading, wp), seed) *
           abs(dot(wp, hit.ns));
    if !nonzero(fcos) {
        return found;
    }

    // pbrt: SurfaceInteraction::SpawnRay, which offsets the origin off the
    // surface by the hit point's own error bound. Without it the next ray finds
    // the surface it just left, at a distance of nearly zero.
    // A uniformly sampled direction is not a specular bounce, so pbrt's
    // SpawnRay carries no differentials past here and every later lookup falls
    // to the camera approximation.
    next_ray = spawn_ray(surf, wp);
    next_diff = spawn_ray_differential(hit, diffs, ray_diff, wo, wp, 0, 1.0);
    return walk_step(next_ray, next_diff, camera, spp_scale,
                     beta * fcos / uniform_sphere_pdf(),
                     found, lambda, sampler, state, ls, seed, depth + 1,
                     max_depth);
}

// The entry point, which is where the walk's initial state is named rather than
// passed in by a caller that should not have to know it: a full throughput and
// no radiance yet.
func li_random_walk(r0 : Ray, d0 : RayDifferential,
                    camera : PerspectiveCamera, spp_scale : Float,
                    lambda : SampledWavelengths, sampler : Sampler,
                    state : mut SamplerState, ls : LightSet, seed : i32,
                    max_depth : i32) -> vec4f =
    walk_step(r0, d0, camera, spp_scale, vec4f{1.0, 1.0, 1.0, 1.0},
              vec4f{0.0, 0.0, 0.0, 0.0}, lambda, sampler, state, ls, seed, 0,
              max_depth);

// pbrt: Unoccluded -- is there anything between these two surfaces?
//
// A shadow ray, which is the whole reason sampling a light is worth doing: the
// direction is known to reach the light, so all that is left is to ask whether
// something is in the way. `trace_any` and not `trace`, because which surface
// blocks it and how far away that surface is are both answers nobody here
// reads.
func unoccluded(from_p : vec3f, from_error : vec3f, from_n : vec3f,
                to_p : vec3f, to_error : vec3f, to_n : vec3f) -> bool {
    shadow = spawn_ray_to(from_p, from_error, from_n, to_p, to_error, to_n);
    return !trace_any(shadow);
}

// pbrt: SimplePathIntegrator::Li, with `sampleLights` and `sampleBSDF` both on.
//
// The difference from the random walk is one idea: at every surface, sample a
// point *on a light* and ask whether it is visible, instead of hoping to
// scatter into one. That is what turns a thousand lit pixels into a picture --
// the walk finds a small light by chance, and this one always finds it.
//
// `specular_bounce` is what stops the light being counted twice. A path that
// samples a light directly has already accounted for it, so when the next
// bounce lands on that same light its emission must be ignored -- unless the
// bounce was specular, which has no density to sample against and so was never
// accounted for. pbrt threads exactly this flag for exactly this reason.
//
// Tail-recursive, as `walk_step` is: what the schedule does with the path is
// the schedule's to decide.
func path_step(ray : Ray, ray_diff : RayDifferential,
               camera : PerspectiveCamera, spp_scale : Float,
               beta : vec4f, l : vec4f, specular_bounce : bool,
               lambda : SampledWavelengths, sampler : Sampler,
               state : mut SamplerState, ls : LightSampler, set : LightSet,
               seed : i32, depth : i32, max_depth : i32) -> vec4f {
    isect = trace(ray);
    if !isect {
        // pbrt: `if (!sampleLights || specularBounce)` around the sum over the
        // infinite lights, and `sampleLights` is on here. The same
        // double-counting rule the surface emission below follows: a ray that
        // left a non-specular bounce had its chance to sample this light
        // directly, so picking it up again on the way out would count it twice.
        escaped : mut vec4f = l;
        if specular_bounce {
            for i in set.first_infinite:set.count {
                escaped = escaped + beta * light_le(lights[i], ray.d, lambda);
            }
        }
        return escaped;
    }
    reached = *isect;
    via = reached[0];
    prim = reached[1];
    // pbrt: the geometry computes its interaction in the frame it was tested
    // in -- an instance's own, for a TransformedPrimitive -- and
    // TransformedPrimitive::Intersect moves it into render space once. So the
    // ray is the one the traversal tested with, pulled back where it was, and
    // the transform is the one pbrt applies on the way out.
    surf = transform(via, surface_geometry(prim.shape, untransform(via, ray)));
    // Raw rather than normalized, as in `walk_step` above and for the same
    // reason: pbrt's SimplePathIntegrator writes `Vector3f wo = -ray.d`.
    wo = -ray.d;

    // The emission of the surface itself, counted only when the previous bounce
    // could not have sampled it.
    emitted = select(specular_bounce && (prim.light >= 0),
                     beta * light_l(lights[max(prim.light, 0)], surf.n, wo,
                                    lambda),
                     vec4f{0.0, 0.0, 0.0, 0.0});
    found : mut vec4f = l + emitted;

    if depth == max_depth {
        return found;
    }

    // pbrt: GetBSDF, once, before anything is asked of it -- differentials,
    // then the displacement, then the material.
    diffs = compute_differentials(surf, ray_diff, camera, spp_scale);
    hit = displaced(surf, material_displacement[prim.material], diffs);
    shading = frame_from_xz(unit_vector_(hit.dpdus), hit.ns);
    bsdf = material_bxdf(materials[prim.material], lambda, false, hit.uv,
                         diffs.dudx, diffs.dvdx, diffs.dudy, diffs.dvdy);
    ctx : ShapeSampleContext = {surf.p, surf.p_error, surf.n, hit.ns};

    // Direct lighting: pick a light, pick a point on it, and connect.
    chosen = light_sampler_sample(ls, ctx, get_1d(sampler, state));
    if chosen {
        picked = *chosen;
        u_light = get_2d(sampler, state);
        // `false`, which is pbrt's default and what SimplePathIntegrator takes:
        // this integrator has no second estimator to fall back on, so a light
        // is not allowed to decline part of itself.
        sampled = light_sample_li(lights[picked.light], ctx, u_light, lambda,
                                  false);
        if sampled {
            lsample = *sampled;
            if nonzero(lsample.l) && (lsample.pdf > 0.0) {
                fcos = bxdf_f(bsdf, frame_to_local(shading, wo),
                              frame_to_local(shading, lsample.wi), seed) *
                       abs(dot(lsample.wi, hit.ns));
                if nonzero(fcos) &&
                   unoccluded(surf.p, surf.p_error, surf.n, lsample.p_light,
                              lsample.p_light_error, lsample.n_light) {
                    found = found + beta * fcos * lsample.l /
                                    (picked.p * lsample.pdf);
                }
            }
        }
    }

    // And the path continues in whatever direction the surface chooses.
    uc = get_1d(sampler, state);
    u = get_2d(sampler, state);
    bs = bxdf_sample_f(bsdf, frame_to_local(shading, wo), uc, u, seed);
    if !bs {
        return found;
    }
    sample = *bs;
    if !nonzero(sample.f) || (sample.pdf == 0.0) {
        return found;
    }
    wi = frame_from_local(shading, sample.wi);
    next_beta = beta * sample.f * abs(dot(wi, hit.ns)) / sample.pdf;
    next_ray = spawn_ray(surf, wi);
    next_diff = spawn_ray_differential(hit, diffs, ray_diff, wo, wi,
                                       sample.flags, sample.eta);
    return path_step(next_ray, next_diff, camera, spp_scale, next_beta, found,
                     is_specular(sample.flags), lambda, sampler, state, ls, set,
                     seed, depth + 1, max_depth);
}

// The entry point, which names the state a path starts with. `specular_bounce`
// starts true because the camera ray has sampled no light, so a light it lands
// on directly must be counted.
func li_simple_path(r0 : Ray, d0 : RayDifferential,
                    camera : PerspectiveCamera, spp_scale : Float,
                    lambda : SampledWavelengths, sampler : Sampler,
                    state : mut SamplerState, ls : LightSampler, set : LightSet,
                    seed : i32, max_depth : i32) -> vec4f =
    path_step(r0, d0, camera, spp_scale, vec4f{1.0, 1.0, 1.0, 1.0},
              vec4f{0.0, 0.0, 0.0, 0.0}, true, lambda, sampler, state, ls, set,
              seed, 0, max_depth);

// pbrt: PathIntegrator::SampleLd, the direct-lighting estimate at one vertex.
//
// The difference from the one inside `path_step` above is the last two lines:
// this one asks the surface what density *it* would have chosen the light's
// direction with, and weighs the two estimators against each other. Without
// that, a path tracer that samples both a light and a BSDF counts the same
// transport twice and has to pick one everywhere; with it, each estimator is
// trusted where it is good -- the light sample near a small bright source, the
// BSDF sample on a sharp highlight -- and the two sum to one.
//
// The nudge at the top is pbrt's and is easy to overlook. A light is sampled
// from a point, and the point the geometry gives is on the surface; a purely
// reflective surface should sample the light as seen from *just above* it,
// because a light sample from exactly on it can land on the wrong side of a
// grazing shadow ray. The offset point has no error interval of its own -- it
// is already the outward-rounded one.
//
// The draws are what must not move: one for the light, then two for the point
// on it, both taken before anything is tested, so a vertex costs the same three
// numbers whether or not the light turns out to be visible.
// `wo` here is pbrt's `intr.wo` -- the normalized one -- and not the `-ray.d`
// the caller hands to `Sample_f`. pbrt reads a different member in each place,
// and the two are not the same vector.
func path_sample_ld(bsdf : BxDF, surf : SurfaceGeometry, shading : Frame,
                    wo : vec3f, flags : i32, lambda : SampledWavelengths,
                    sampler : Sampler, state : mut SamplerState,
                    ls : LightSampler, seed : i32) -> vec4f {
    zero = vec4f{0.0, 0.0, 0.0, 0.0};

    // The nudged point is already outward-rounded, so it carries no interval of
    // its own -- pbrt's `ctx.pi = intr.OffsetRayOrigin(...)` assigns a Point3f
    // into a Point3fi, which is a zero-width interval.
    no_error = vec3f{0.0, 0.0, 0.0};
    ctx_p : mut vec3f = surf.p;
    ctx_error : mut vec3f = surf.p_error;
    if is_reflective(flags) && !is_transmissive(flags) {
        ctx_p = offset_ray_origin(surf.p, surf.p_error, surf.n, wo);
        ctx_error = no_error;
    } else if is_transmissive(flags) && !is_reflective(flags) {
        ctx_p = offset_ray_origin(surf.p, surf.p_error, surf.n, -wo);
        ctx_error = no_error;
    }
    ctx : ShapeSampleContext = {ctx_p, ctx_error, surf.n, surf.ns};

    // pbrt calls the context-taking overload of Sample here where `path_step`
    // calls the one that takes only a number. For a uniform sampler they are
    // the same function; for the BVH sampler pbrt defaults `path` to, they are
    // not, which is why the difference is written down rather than smoothed
    // over. See the refusal in scene_dump.cpp.
    u = get_1d(sampler, state);
    chosen = light_sampler_sample(ls, ctx, u);
    u_light = get_2d(sampler, state);
    if !chosen {
        return zero;
    }
    picked = *chosen;
    // `true`: this integrator will find the light again through its BSDF
    // sample, so a light that a BSDF sample reaches perfectly well is entitled
    // to decline. A uniform infinite light declines every time, and the whole
    // of its contribution then arrives through the escaped-ray branch of
    // `full_path_step` with an MIS weight of one.
    sampled = light_sample_li(lights[picked.light], ctx, u_light, lambda, true);
    if !sampled {
        return zero;
    }
    lsample = *sampled;
    if !nonzero(lsample.l) || (lsample.pdf == 0.0) {
        return zero;
    }

    wi = lsample.wi;
    wo_local = frame_to_local(shading, wo);
    wi_local = frame_to_local(shading, wi);
    f = bxdf_f(bsdf, wo_local, wi_local, seed) * abs(dot(wi, surf.ns));
    if !nonzero(f) {
        return zero;
    }
    // The shadow ray leaves from the surface itself, not from the nudged point
    // above: the nudge is about where the light is *seen* from, and the ray
    // still has to clear the geometry it started on.
    if !unoccluded(surf.p, surf.p_error, surf.n, lsample.p_light,
                   lsample.p_light_error, lsample.n_light) {
        return zero;
    }

    p_l = picked.p * lsample.pdf;
    if light_is_delta(lights[picked.light]) {
        return lsample.l * f / p_l;
    }
    p_b = bxdf_pdf(bsdf, wo_local, wi_local, seed);
    return power_heuristic(1.0, p_l, 1.0, p_b) * lsample.l * f / p_l;
}

// pbrt: PathIntegrator::Li, which is the integrator every scene in `scenes/`
// asks for and pbrt's own workhorse for a scene with no media in it.
//
// It is `simplepath` plus four things, and each of them is a way of not wasting
// samples:
//
//   - multiple importance sampling, above and in the emission below, so that
//     the light's estimator and the BSDF's are combined rather than chosen
//     between;
//   - Russian roulette, so that a path whose throughput has fallen away is
//     killed at random instead of traced to the depth limit -- unbiased,
//     because the survivors are scaled back up by the survival probability;
//   - `eta_scale`, which undoes the radiance compression a refraction applies
//     before roulette looks at the throughput, so that a path inside glass is
//     not killed for being dim when what is dim is the units it is measured in;
//   - regularization, optional and off by default, which widens a near-delta
//     lobe after the first non-specular bounce so that an indirect path cannot
//     land on a highlight and return a value a hundred times the mean.
//
// `p_b` and `prev_ctx` are what the MIS weight for emission needs: the density
// the *previous* vertex chose this ray's direction with, and the point it chose
// it from. They are carried rather than recomputed because neither is
// recoverable from where the path is now.
//
// Tail-recursive, as `walk_step` and `path_step` are, and for the same reason:
// what the schedule does with a path is the schedule's to decide.
func full_path_step(ray : Ray, ray_diff : RayDifferential,
                    camera : PerspectiveCamera, spp_scale : Float,
                    beta : vec4f, l : vec4f, depth : i32,
                    specular_bounce : bool, any_non_specular : bool,
                    eta_scale : Float, p_b : Float,
                    prev_ctx : ShapeSampleContext,
                    lambda : SampledWavelengths, sampler : Sampler,
                    state : mut SamplerState, ls : LightSampler, set : LightSet,
                    seed : i32, max_depth : i32, regularize : bool,
                    want_visible : bool,
                    visible : mut VisibleSurface) -> vec4f {
    isect = trace(ray);
    if !isect {
        // pbrt weighs each infinite light's emission exactly the way the
        // surface emission below is weighed, and for the same reason: a ray
        // that left a non-specular bounce could also have reached this light by
        // sampling it, so the two estimators share the credit.
        //
        // For a *uniform* infinite light the light's share is always zero,
        // because `light_sample_li` declined to sample it -- `light_pdf_li`
        // answers 0 under `allow_incomplete_pdf` and the power heuristic then
        // gives this estimator the whole weight. That is not a special case
        // written here; it falls out of the two functions agreeing about what
        // was sampled, which is the point of threading the flag.
        escaped : mut vec4f = l;
        for i in set.first_infinite:set.count {
            emitted = light_le(lights[i], ray.d, lambda);
            if (depth == 0) || specular_bounce {
                escaped = escaped + beta * emitted;
            } else {
                p_l = light_sampler_pmf(ls, prev_ctx, i) *
                      light_pdf_li(lights[i], prev_ctx, ray.d, true);
                escaped = escaped +
                          beta * power_heuristic(1.0, p_b, 1.0, p_l) * emitted;
            }
        }
        return escaped;
    }
    reached = *isect;
    via = reached[0];
    prim = reached[1];
    // pbrt: the geometry computes its interaction in the frame it was tested
    // in -- an instance's own, for a TransformedPrimitive -- and
    // TransformedPrimitive::Intersect moves it into render space once. So the
    // ray is the one the traversal tested with, pulled back where it was, and
    // the transform is the one pbrt applies on the way out.
    surf = transform(via, surface_geometry(prim.shape, untransform(via, ray)));
    // Both of them, because pbrt uses both. `Li` writes
    // `Vector3f wo = -ray.d` and hands *that* to `Le` and to `Sample_f`;
    // `SampleLd` reads `intr.wo`, which Interaction's constructor normalized.
    // The two differ in the last bit or two, and a layered BSDF's walk is
    // seeded by hashing this vector -- so using one where pbrt uses the other
    // gives a walk with different noise, which converges to the same picture
    // and agrees with pbrt at no finite sample count. Not a distinction worth
    // inventing; it is only here because pbrt has it.
    wo = -ray.d;
    wo_unit = unit_vector_(wo);

    // pbrt: SurfaceInteraction::Le, and the MIS weight that goes with it. A
    // camera ray and a ray that left a specular lobe found this light by the
    // only means they had, so their estimate is the whole of it; any other ray
    // could also have got here by sampling the light directly, and the two ways
    // share the credit.
    found : mut vec4f = l;
    if prim.light >= 0 {
        emitted = light_l(lights[max(prim.light, 0)], surf.n, wo, lambda);
        if nonzero(emitted) {
            if (depth == 0) || specular_bounce {
                found = l + beta * emitted;
            } else {
                p_l = light_sampler_pmf(ls, prev_ctx, prim.light) *
                      light_pdf_li(lights[max(prim.light, 0)], prev_ctx, ray.d,
                                   true);
                found = l + beta * power_heuristic(1.0, p_b, 1.0, p_l) *
                            emitted;
            }
        }
    }

    // pbrt: GetBSDF, then the visible surface, then Regularize, then the depth
    // test, in that order -- the BSDF is built at every vertex the path
    // reaches, the last one included, and the gbuffer is filled before the
    // depth is looked at. `bsdf` below is the value everything after this asks
    // its questions of, exactly as pbrt asks them of the BSDF `GetBSDF`
    // returned. Regularizing is an argument rather than a mutation because a
    // bonsai BSDF is a value, and it is applied here rather than at each
    // question for the same reason pbrt applies it here: it is a property of
    // the surface at this vertex.
    do_regularize = regularize && any_non_specular;

    // pbrt's `GetBSDF`, in its order: the differentials first, then the
    // displacement -- which tilts the shading frame and so has to happen before
    // the frame is built -- and only then the material.
    diffs = compute_differentials(surf, ray_diff, camera, spp_scale);
    hit = displaced(surf, material_displacement[prim.material], diffs);
    shading = frame_from_xz(unit_vector_(hit.dpdus), hit.ns);
    bsdf = material_bxdf(materials[prim.material], lambda, do_regularize,
                         hit.uv, diffs.dudx, diffs.dvdx, diffs.dudy,
                         diffs.dvdy);
    flags = bxdf_flags(bsdf);

    // pbrt: `if (depth == 0 && visibleSurf)`, the one place the gbuffer is
    // written. The albedo is `bsdf.rho(isect.wo, ...)`, the hemispherical
    // reflectance estimated with the sixteen fixed sample points pbrt's path
    // integrator carries; `isect.wo` is the normalized direction, and it is
    // asked in the shading frame the BSDF was built about. What makes the
    // albedo worth computing rather than copying is the round trip after it:
    // the reflectance is an RGB, becomes a spectrum, is lit by the film's
    // illuminant (GBufferFilm::AddSample), and is integrated back to RGB, none
    // of which is the identity. The normals are pbrt's `FaceForward(si.n, wo)`
    // and `FaceForward(si.shading.n, wo)` -- turned to face the camera, so a
    // comparison cannot see their sign, only their line -- and the shading one
    // is the bumped one, which is the channel that checks a bump map.
    // Never regularized: nothing has bounced yet, so `do_regularize` is false
    // here whatever the option says, as it is in pbrt.
    if want_visible && (depth == 0) {
        rho = bxdf_rho(bsdf, frame_to_local(shading, wo_unit), seed, rho_uc,
                       rho_ux, rho_uy);
        lit = rho * spectrum_at_dense(illuminant_d65, lambda);
        facing = select(dot(surf.n, wo_unit) < 0.0, -surf.n, surf.n);
        facing_ns = select(dot(hit.ns, wo_unit) < 0.0, -hit.ns, hit.ns);
        seen : VisibleSurface = {facing, facing_ns, spectrum_to_rgb(lit, lambda),
                                 true};
        visible = seen;
    }

    if depth == max_depth {
        return found;
    }
    next_depth = depth + 1;

    // Direct lighting, but only where there is a density to weigh it with. A
    // purely specular surface would return zero from every term of it, so pbrt
    // does not spend the shadow ray -- and, importantly, does not spend the
    // three draws either.
    if is_non_specular(flags) {
        found = found + beta * path_sample_ld(bsdf, hit, shading, wo_unit,
                                              flags, lambda, sampler, state, ls,
                                              seed);
    }

    // And the path continues in whatever direction the surface chooses.
    wo_local = frame_to_local(shading, wo);
    uc = get_1d(sampler, state);
    u = get_2d(sampler, state);
    bs = bxdf_sample_f(bsdf, wo_local, uc, u, seed);
    if !bs {
        return found;
    }
    sample = *bs;
    if !nonzero(sample.f) || (sample.pdf == 0.0) || (sample.wi.z == 0.0) {
        return found;
    }
    wi = frame_from_local(shading, sample.wi);
    // pbrt: `AbsDot(bs->wi, isect.shading.n)`, the *shading* normal -- which is
    // the bumped one where there is a displacement.
    next_beta = beta * sample.f * abs(dot(wi, hit.ns)) / sample.pdf;

    // A layered BSDF reports a density that is only proportional to the one it
    // actually sampled from -- the entrance interface's rather than the whole
    // stack's -- which is fine for its own estimator and useless as an MIS
    // weight. So the real density is asked for, and asked for about the
    // direction *after* its round trip through the shading frame, because that
    // is the vector pbrt has in hand at this point.
    next_p_b : mut Float = sample.pdf;
    if sample.pdf_is_proportional {
        next_p_b = bxdf_pdf(bsdf, wo_local, frame_to_local(shading, wi), seed);
    }

    next_specular = is_specular(sample.flags);
    next_any_ns = any_non_specular || !next_specular;
    // pbrt: `etaScale *= Sqr(bs->eta)` on a transmission. Radiance is scaled by
    // the square of the index ratio when it crosses into a denser medium, and
    // roulette must not read that scaling as a path going dark.
    next_eta_scale = select(is_transmissive(sample.flags),
                            eta_scale * sqr(sample.eta), eta_scale);
    // The geometric normal and the point stay the shape's -- a bump map moves
    // nothing -- and the shading normal is the bumped one, which is the pair
    // pbrt's ShapeSampleContext takes.
    next_ctx : ShapeSampleContext = {surf.p, surf.p_error, surf.n, hit.ns};
    next_ray = spawn_ray(surf, wi);
    // pbrt: the four-argument SpawnRay, which carries the differentials across
    // a *specular* bounce and drops them across any other. A mirror or a pane
    // of glass sends the two companion rays somewhere predictable; a rough
    // surface does not, and the next hit falls back on the camera's minimum
    // footprint.
    // The bumped hit: pbrt's SpawnRay reads `shading.n` and the shading normal
    // derivatives, which is what the bump changed.
    next_diff = spawn_ray_differential(hit, diffs, ray_diff, wo_unit, wi,
                                       sample.flags, sample.eta);

    // pbrt: Russian roulette, after the ray is spawned and never at the first
    // vertex -- `depth > 1` on the already-incremented depth. Killing a camera
    // ray would put holes in the image for no saving worth having.
    rr_beta = max(next_beta * next_eta_scale);
    survived : mut vec4f = next_beta;
    if (rr_beta < 1.0) && (next_depth > 1) {
        q = max(0.0, 1.0 - rr_beta);
        if get_1d(sampler, state) < q {
            return found;
        }
        survived = next_beta / (1.0 - q);
    }

    return full_path_step(next_ray, next_diff, camera, spp_scale, survived,
                          found, next_depth, next_specular, next_any_ns,
                          next_eta_scale, next_p_b, next_ctx, lambda, sampler,
                          state, ls, set, seed, max_depth, regularize,
                          want_visible, visible);
}

// The entry point, which names the state a path starts with: full throughput,
// no radiance, no scattering yet, and a previous vertex that does not exist --
// `depth == 0` is what stops `prev_ctx` and `p_b` ever being read before one
// does.
func li_path(r0 : Ray, d0 : RayDifferential, camera : PerspectiveCamera,
             spp_scale : Float, lambda : SampledWavelengths, sampler : Sampler,
             state : mut SamplerState, ls : LightSampler, set : LightSet,
             seed : i32, max_depth : i32, regularize : bool,
             want_visible : bool, visible : mut VisibleSurface) -> vec4f {
    origin : ShapeSampleContext = {vec3f{0.0, 0.0, 0.0}, vec3f{0.0, 0.0, 0.0},
                                   vec3f{0.0, 0.0, 1.0}, vec3f{0.0, 0.0, 1.0}};
    return full_path_step(r0, d0, camera, spp_scale, vec4f{1.0, 1.0, 1.0, 1.0},
                          vec4f{0.0, 0.0, 0.0, 0.0}, 0, false, false, 1.0, 0.0,
                          origin, lambda, sampler, state, ls, set, seed,
                          max_depth, regularize, want_visible, visible);
}

// pbrt: Integrator::Li, the dispatch itself -- one arm per integrator, which is
// what pbrt's TaggedPointer does at a call site.
// The differentials reach only the `path` arm, which is the only one that
// takes them in pbrt either: RandomWalkIntegrator and SimplePathIntegrator
// declare a `RayDifferential` parameter and never look at its differentials,
// because neither has a texture to filter.
// `want_visible` and `visible` are pbrt's `VisibleSurface *` argument, as a
// flag and the place to write: the path integrator fills it at its first vertex
// when the film asked, and the random walk and simple path never do -- pbrt's
// take the pointer and ignore it, so a gbuffer rendered with either is empty.
func integrator_li(integrator : Integrator, r : Ray, dr : RayDifferential,
                   camera : PerspectiveCamera, spp_scale : Float,
                   lambda : SampledWavelengths, sampler : Sampler,
                   state : mut SamplerState, seed : i32, want_visible : bool,
                   visible : mut VisibleSurface) -> vec4f {
    match integrator {
        RandomWalk(max_depth, set) =>
            return li_random_walk(r, dr, camera, spp_scale, lambda, sampler,
                                  state, set, seed, max_depth);
        SimplePath(max_depth, ls, set) =>
            return li_simple_path(r, dr, camera, spp_scale, lambda, sampler,
                                  state, ls, set, seed, max_depth);
        Path(max_depth, ls, set, regularize) =>
            return li_path(r, dr, camera, spp_scale, lambda, sampler, state, ls,
                           set, seed, max_depth, regularize, want_visible,
                           visible);
    }
}

// pbrt: the render loop, which in v4 is ParallelFor2D over the film tiles.
// One flat loop over pixels rather than two nested ones, because the schedule
// wants a single index to bind.
//
// Several outputs because pbrt's gbuffer film records several channels from one
// render, and comparing only one of them was how a normal pointing the wrong
// way went unnoticed for as long as it did.
//
// `weight_out` is pbrt's `Pixel::weightSum`, and it is an output because it has
// to be: a filtered sample carries a weight, the channels are sums of weighted
// samples, and what a pixel is divided by at the end is the sum of the weights
// and not the number of them. It is per pixel because the weights are -- each
// sample draws its own jitter, so no two pixels sum to the same thing.
//
// The film has no size on it: the caller owns the allocation, and how many
// pixels there are is the resolution, which is already here.
//
// `disable_pixel_jitter` is pbrt's option of that name, threaded rather than
// baked because it is what a comparison turns off to ask a question about the
// geometry alone -- with it set, every sample of a pixel traces the identical
// ray and a difference in the image can only be a difference in the scene.
// Everything a texture would be filtered by, for one pixel and one hit, so it
// can be checked against `scene_dump --print-differentials`.
//
// Exported rather than folded into `render` because a wrong footprint does not
// show in an image: it makes a texture a little too blurry or too sharp and
// moves no edge, so no pixel comparison against pbrt would fail on it. The hit
// is passed in rather than traced for the same reason the pbrt side passes one
// in -- what is under test is `compute_differentials`, and a chosen hit
// exercises both of its branches, including the one a first hit never takes.
//
// Thirty-five floats out: the camera ray's four differential vectors, then
// dpdx, dpdy and the four (u,v) derivatives, then what a bounce into `wi` off a
// lobe with `flags` and `eta` leaves behind -- its flag and its four vectors.
func [[export]] differentials_at(camera : PerspectiveCamera,
                                 px : Float, py : Float,
                                 has_differentials : bool, spp : u32,
                                 p : vec3f, dpdu : vec3f, dpdv : vec3f,
                                 wi : vec3f, flags : i32, eta : Float,
                                 out : mut array[Float]) -> void {
    // An off-centre lens sample, so that a camera with a lens takes its
    // lens branch in earnest: at the centre the lens point is the origin and
    // the branch collapses to the pinhole one.
    sample = CameraSample{vec2f{px + 0.5, py + 0.5}, vec2f{0.9, 0.3}, 0.0, 1.0};
    camera_ray = generate_ray_differential(camera, sample);
    out[35u] = camera_ray.ray.o.x;
    out[36u] = camera_ray.ray.o.y;
    out[37u] = camera_ray.ray.o.z;
    out[38u] = camera_ray.ray.d.x;
    out[39u] = camera_ray.ray.d.y;
    out[40u] = camera_ray.ray.d.z;
    // pbrt: CameraTransform::CameraFromRender on a point and on a vector --
    // Transform::ApplyInverse, which Approximate_dp_dxy and every light with a
    // frame of its own go through. The inverse is a second matrix here, and
    // these check that applying it fuses as pbrt's ApplyInverse does.
    inv_p = apply_inverse_point(camera.camera_from_render, p);
    inv_d = apply_vector(camera.camera_from_render, camera_ray.ray.d);
    out[41u] = inv_p.x;
    out[42u] = inv_p.y;
    out[43u] = inv_p.z;
    out[44u] = inv_d.x;
    out[45u] = inv_d.y;
    out[46u] = inv_d.z;
    dr_scaled = scale_differentials(camera_ray.ray, camera_ray.diff,
                                    ray_differential_scale(spp, false));
    dr = RayDifferential{dr_scaled.rx_origin, dr_scaled.ry_origin,
                         dr_scaled.rx_direction, dr_scaled.ry_direction,
                         has_differentials};

    out[0u] = dr.rx_origin.x;
    out[1u] = dr.rx_origin.y;
    out[2u] = dr.rx_origin.z;
    out[3u] = dr.ry_origin.x;
    out[4u] = dr.ry_origin.y;
    out[5u] = dr.ry_origin.z;
    out[6u] = dr.rx_direction.x;
    out[7u] = dr.rx_direction.y;
    out[8u] = dr.rx_direction.z;
    out[9u] = dr.ry_direction.x;
    out[10u] = dr.ry_direction.y;
    out[11u] = dr.ry_direction.z;

    // pbrt's SurfaceInteraction constructor sets the geometric normal from the
    // parameterization, and the shading fields from the geometric ones.
    n = unit_vector_(cross_(dpdu, dpdv));
    g = SurfaceGeometry{n, n, dpdu, dpdv, vec2f{0.375, 0.625}, dpdu, dpdv,
                        vec3f{0.0, 0.0, 0.0}, vec3f{0.0, 0.0, 0.0}, p,
                        vec3f{0.0, 0.0, 0.0}};
    d = compute_differentials(g, dr, camera,
                              ray_differential_scale(spp, false));

    out[12u] = d.dpdx.x;
    out[13u] = d.dpdx.y;
    out[14u] = d.dpdx.z;
    out[15u] = d.dpdy.x;
    out[16u] = d.dpdy.y;
    out[17u] = d.dpdy.z;
    out[18u] = d.dudx;
    out[19u] = d.dvdx;
    out[20u] = d.dudy;
    out[21u] = d.dvdy;

    // And what a bounce does to them: `spawn_ray_differential` for one lobe.
    // The flag is the first number out and is as much of the answer as the
    // vectors -- a rough lobe drops the differentials, and dropping them is the
    // behaviour under test.
    // pbrt's SurfaceInteraction carries `wo = -ray.d` -- the base ray's, not a
    // companion's -- and SpawnRay reads it from there.
    sp = spawn_ray_differential(g, d, dr, -camera_ray.ray.d, wi, flags, eta);
    out[22u] = select(sp.has_differentials, 1.0, 0.0);
    out[23u] = sp.rx_origin.x;
    out[24u] = sp.rx_origin.y;
    out[25u] = sp.rx_origin.z;
    out[26u] = sp.ry_origin.x;
    out[27u] = sp.ry_origin.y;
    out[28u] = sp.ry_origin.z;
    out[29u] = sp.rx_direction.x;
    out[30u] = sp.rx_direction.y;
    out[31u] = sp.rx_direction.z;
    out[32u] = sp.ry_direction.x;
    out[33u] = sp.ry_direction.y;
    out[34u] = sp.ry_direction.z;
}

// One texture, read both ways at one point with one footprint, for
// check_differentials.sh's `texf` and `texs` rows: the number a float texture
// gives, and the four spectral samples a spectrum texture gives at the
// wavelengths `lambda_u` draws. pbrt's `TextureEvalContext` orders its
// derivatives (dudx, dudy, dvdx, dvdy) and the lookups here take
// (dudx, dvdx, dudy, dvdy); the arguments are in pbrt's order.
func [[export]] texture_at(index : u32, uv : vec2f, dudx : Float, dudy : Float,
                           dvdx : Float, dvdy : Float, lambda_u : Float,
                           out : mut array[Float]) -> void {
    t = textures[index];
    lambda = sample_wavelengths_visible(lambda_u);
    out[0u] = texture_float(t, uv, dudx, dvdx, dudy, dvdy);
    s = texture_albedo(t, uv, dudx, dvdx, dudy, dvdy, lambda);
    out[1u] = s.x;
    out[2u] = s.y;
    out[3u] = s.z;
    out[4u] = s.w;
    // The wavelengths themselves, so that a spectrum row that differs can be
    // told apart from a wavelength that does.
    out[5u] = lambda.lambda.x;
    out[6u] = lambda.lambda.y;
    out[7u] = lambda.lambda.z;
    out[8u] = lambda.lambda.w;
    // The filtered colour before it is read as a number or fitted, for the
    // `texrgb` rows.
    rgb = texture_rgb(t, uv, dudx, dvdx, dudy, dvdy);
    out[9u] = rgb.x;
    out[10u] = rgb.y;
    out[11u] = rgb.z;
}

// An RGB fitted to a spectrum by table lookup and sampled at four
// wavelengths, for check_differentials.sh's `sig` rows -- what a spectrum
// texture does with its filtered colour, against pbrt's RGBAlbedoSpectrum.
func [[export]] sigmoid_at(rgb : vec3f, lambda_u : Float,
                           out : mut array[Float]) -> void {
    s = spectrum_at(rgb_to_sigmoid(rgb), sample_wavelengths_visible(lambda_u));
    out[0u] = s.x;
    out[1u] = s.y;
    out[2u] = s.z;
    out[3u] = s.w;
}

func [[export]] render(camera : PerspectiveCamera, width : u32, height : u32,
                       sampler : Sampler, integrator : Integrator,
                       pixel_filter : Filter, seed : i32,
                       disable_pixel_jitter : bool,
                       // pbrt: Film::UsesVisibleSurface(). Only a gbuffer film
                       // records the normals and the albedo, so only for one
                       // does the integrator fill them in -- the albedo is
                       // sixteen BSDF samples per camera ray, which pbrt does
                       // not spend on an image that will not show them.
                       film_visible_surface : bool,
                       // pbrt: PixelSensor's `exposureTime * ISO / 100`, and
                       // RGBFilm's `maxcomponentvalue`, which is infinity
                       // unless the scene names one.
                       imaging_ratio : Float, max_component_value : Float,
                       normal_out : mut array[vec3f],
                       shading_out : mut array[vec3f],
                       albedo_out : mut array[vec3f],
                       radiance_out : mut array[vec3f],
                       weight_out : mut array[Float]) -> void {
    spp = samples_per_pixel(sampler);
    parfor p in 0u:(width * height) {
        i = p % width;
        j = p / width;

        normal_out[p] = vec3f{0.0, 0.0, 0.0};
        shading_out[p] = vec3f{0.0, 0.0, 0.0};
        albedo_out[p] = vec3f{0.0, 0.0, 0.0};
        radiance_out[p] = vec3f{0.0, 0.0, 0.0};
        weight_out[p] = 0.0;

        // The samples of a pixel are a parfor and an atomic accumulate, not a
        // sequential loop, because a sequential loop cannot be scheduled: the
        // algorithm says what may run at once and the schedule decides what to
        // spend on it. Nothing binds `s` here, so the compiler takes the lock
        // back off and the sum runs in sample order -- which is also what
        // makes this agree with pbrt down to the last bit, since pbrt adds a
        // pixel's samples in that order too. Binding `s` would trade that for
        // parallelism, which is a trade the schedule is allowed to make.
        parfor s in 0u:spp {
            // pbrt: EvaluatePixelSample. StartPixelSample reseeds per sample,
            // so a sample's draws depend on nothing but its own index.
            state : mut SamplerState =
                start_pixel_sample(sampler, cast[[i32]](i), cast[[i32]](j), s);
            // The first draw of the sample is the wavelength's; pbrt makes it
            // whether or not --disable-wavelength-jitter then overrides the
            // result, so the stream is in the same place either way. Through
            // the sampler rather than from the generator directly, because a
            // stratified sampler's first draw is a stratum rather than a
            // uniform.
            lambda = sample_wavelengths_visible(get_1d(sampler, state));

            // pbrt: GetCameraSample. The filter is sampled first, then the time,
            // then the lens, and all three draws happen whether or not their
            // results are used -- pbrt overwrites the filter's *after* drawing
            // it when --disable-pixel-jitter is set. Skipping a draw instead
            // would leave the sampler out of step with pbrt's for everything
            // after it, which is invisible in a gbuffer and is the whole
            // difference in a render.
            pixel_u = get_pixel_2d(sampler, state);
            fs = filter_sample(pixel_filter, pixel_u);
            // pbrt: `fs.p = Point2f(0, 0); fs.weight = 1;` under the option --
            // applied to the sample and not to the draw.
            jitter = select(disable_pixel_jitter, vec2f{0.0, 0.0}, fs.p);
            weight = select(disable_pixel_jitter, 1.0, fs.weight);
            time_u = get_1d(sampler, state);
            lens_u = get_2d(sampler, state);
            // pbrt: `cs.pFilm = pPixel + Vector2f(0.5, 0.5) + fs.p`, and the
            // time and lens as drawn -- except under the option, which
            // overwrites all four after the draws: `cs.time = 0.5f; cs.pLens =
            // Point2f(0.5f, 0.5f)`, the lens sample at its centre, which puts
            // the ray's origin at the lens's. A camera with a lens is what
            // makes this visible: with the lens point left as drawn, every
            // pixel's one ray started somewhere else on the lens than pbrt's.
            time = select(disable_pixel_jitter, 0.5, time_u);
            lens = select(disable_pixel_jitter, vec2f{0.5, 0.5}, lens_u);
            sample = CameraSample{vec2f{cast[[Float]](i) + 0.5,
                                        cast[[Float]](j) + 0.5} + jitter,
                                  lens, time, weight};
            // pbrt: `camera.GenerateRayDifferential(cameraSample, lambda)`,
            // then `cameraRay->ray.ScaleDifferentials(rayDiffScale)` in
            // RenderCPU before anything is traced with it. The scale narrows
            // the one-pixel footprint the camera produced to the one a single
            // sample of `spp` covers. Not applied at all under the option --
            // pbrt's `if (!Options->disablePixelJitter)` -- rather than
            // applied with a scale of one, because `o + (rx - o) * 1` is not
            // `rx` in floating point.
            camera_ray = generate_ray_differential(camera, sample);
            ray = camera_ray.ray;
            ray_diff : mut RayDifferential = camera_ray.diff;
            if !disable_pixel_jitter {
                ray_diff = scale_differentials(
                    ray, camera_ray.diff, ray_differential_scale(spp, false));
            }

            // The radiance, which is the render -- and, for a gbuffer film,
            // the visible surface, which pbrt's `Li` fills at the path's first
            // vertex from the intersection and the BSDF the path itself goes
            // on to use. One trace of the camera ray and one BSDF, as pbrt
            // has it; this used to trace and build both a second time for the
            // gbuffer channels, and estimate the albedo whatever the film.
            zero3 = vec3f{0.0, 0.0, 0.0};
            visible : mut VisibleSurface = {zero3, zero3, zero3, false};
            radiance = integrator_li(integrator, ray, ray_diff, camera,
                                     ray_differential_scale(spp,
                                                            disable_pixel_jitter),
                                     lambda, sampler, state, seed,
                                     film_visible_surface, visible);
            // pbrt: GBufferFilm::AddSample, which records the channels only
            // when the integrator set them.
            if visible.set {
                atomic normal_out[p] += weight * visible.n;
                atomic shading_out[p] += weight * visible.ns;
                atomic albedo_out[p] += weight * visible.albedo;
            }
            // pbrt: RGBFilm::AddSample, which clamps the sensor RGB of *each
            // sample* before accumulating it -- not the pixel afterwards. The
            // difference is the whole point: it is there to stop one lucky path
            // through a caustic from dominating a pixel, so it has to act on
            // the sample that found it.
            rgb = radiance_to_rgb(radiance, lambda, imaging_ratio);
            m = max(max(rgb.x, rgb.y), rgb.z);
            clamped = select(m > max_component_value,
                             rgb * (max_component_value / m), rgb);
            atomic radiance_out[p] += weight * clamped;
            // pbrt: `p.weightSum += weight`, outside the visible-surface test.
            // Every sample counts towards what the pixel is divided by, even
            // one that hit nothing -- which is what makes a pixel on a
            // silhouette come out darker rather than as bright as its
            // neighbour.
            atomic weight_out[p] += weight;
        }

        // pbrt: GBufferFilm::GetImage. The normal is *normalized* and not
        // averaged -- a direction has no magnitude to average, and a pixel
        // straddling an edge would otherwise report the short vector two
        // opposed normals sum to. The colours are divided by the whole weight.
        //
        // The two were the same thing while the jitter was off, since every
        // sample of a pixel then found the same surface and the sum was one
        // normal repeated. They are not the same thing now.
        if sqlen_(normal_out[p]) > 0.0 {
            normal_out[p] = unit_vector_(normal_out[p]);
        } else {
            normal_out[p] = vec3f{0.0, 0.0, 0.0};
        }
        if sqlen_(shading_out[p]) > 0.0 {
            shading_out[p] = unit_vector_(shading_out[p]);
        } else {
            shading_out[p] = vec3f{0.0, 0.0, 0.0};
        }
        w = weight_out[p];
        if w != 0.0 {
            albedo_out[p] = albedo_out[p] / w;
            radiance_out[p] = radiance_out[p] / w;
        }
    }
    return;
}

schedule {
    // pbrt: TaggedPointer, which is what a Shape is there. A value of the type
    // is one word -- the variant in the top byte, an index into a pool per
    // variant in the rest -- rather than a tag beside a union as large as the
    // largest arm.
    //
    // That is what a `Geometric` is mostly made of, and a `Geometric` is what
    // the BVH's leaves hold, so this is a question about how much memory the
    // traversal streams. A Sphere is a centre, a radius and a flag, and a
    // Triangle is two indices; a tagged union has to be big enough for the
    // first, so the 66,533 triangles of killeroo-simple each carried a
    // sphere's worth of space. Under this the pools are separate and each
    // holds what it actually is.
    //
    // The pools are the driver's, which is what lets a variant be built with
    // no allocator. See render_hook.cpp.
    layout Shape = tagged_index;

    // pbrt: Primitive is a TaggedPointer too, but it does not get the same
    // layout, because its arms are nothing alike: an instance is two matrices
    // and a tree, a hundred and thirty bytes, and a plain primitive is twenty
    // -- and almost every primitive in a scene is the plain kind. Stored as a
    // tag beside a union, every triangle would carry an instance's worth of
    // space through the top-level tree's leaves; stored `tagged_index`, every
    // triangle would sit behind an indirection that pbrt's TaggedPointer also
    // pays and that the inline `Primitive` struct here never did (+7.5% on a
    // scene with no instances, measured). So the arms are laid out apart: a
    // plain primitive is its own twenty bytes in the leaf, and an instance is
    // a row number into a pool of them. pbrt cannot do this -- its
    // TaggedPointer is one shape for every arm -- which is why this is the
    // layout language's decision and not the query's.
    layout Primitive {
        Geom = inline;
        Inst = tagged_index;
    }

    // pbrt: the BVHAggregate an instance definition's shapes are built into,
    // shared by every instance of the object. Same node, same packing; a leaf
    // names a run of `geoms` below.
    tree[[Geometric]] InstanceBVH(low high : vec3f) with AABB(low, high) =
    | Interior(left : InstanceBVH, right : InstanceBVH, axis : u8)
    | Leaf(data : array[Geometric]) with data = data;

    // pbrt: BVHAggregate. Everything about how the scene is searched lives
    // here -- that it is a BVH at all, that its nodes are bounded by boxes,
    // how a node is packed, and that traversal is a loop over a stack of 64
    // rather than recursion. None of it appears in `trace` above.
    tree[[Primitive]] PrimitiveBVH(low high : vec3f) with AABB(low, high) =
    | Interior(left : PrimitiveBVH, right : PrimitiveBVH, axis : u8)
    | Leaf(data : array[Primitive]) with data = data;

    primitives : PrimitiveBVH;
    // An instance's tree has no layout of its own: its nodes are rows of the
    // group below, in the layout of the object that holds every tree, and the
    // instance stores which row it starts at. Two instances of one object name
    // the same row, which is how the object is stored once however often it
    // is placed -- pbrt's forty-three trees over one BVHAggregate.
    Inst.blas : InstanceBVH from InstanceNodes;

    // pbrt: LinearBVHNode, field for field and 32 bytes like it. The offset
    // discriminated on nPrims is pbrt's union of primitivesOffset and
    // secondChildOffset; the left child is the next node, so only the right
    // one needs saying. Twice: once for the pool every instance's tree is rows
    // of, once for the top-level tree.
    layout primitives {
        // Every instanced GeometricPrimitive in the scene, in the order the
        // instance trees' leaves name them.
        gCount : u32;
        geoms : array[Geometric, gCount];

        bCount : u32;
        indirect group InstanceNodes[bCount] bnode : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            switch nPrims {
                0 => Interior { offset : u32; left = bnode + 1; right = bnode + offset; };
                _ => Leaf { pOffset : u32; data = range(geoms, pOffset, cast[[u32]](nPrims)); };
            };
        };

        pCount : u32;
        prims : array[Primitive, pCount];
        nCount : u32;
        group[nCount] index : u32 {
            low : vec3f;
            high : vec3f;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u32; data = range(prims, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };

    // pbrt: `if (dirIsNeg[node->axis])`, which is the whole of how
    // BVHAggregate::Intersect decides which child to descend into first.
    //
    //     int axis = node->axis;
    //     if (dirIsNeg[axis]) { visit the second child first }
    //
    // and `dirIsNeg[i]` is `invDir[i] < 0` for `invDir = 1 / ray.d`, which is
    // what the key spells out. The reciprocal is kept even though `d[axis] < 0`
    // decides the same way everywhere except a component of exactly -0: this
    // renderer's job is to compute what pbrt computes, and where the two differ
    // it should differ for a reason better than a divide.
    //
    // Visiting the near child first is what makes the running best distance
    // tighten early, so every subtree whose nearest point is already further
    // than that is skipped. It changes no answer -- an `argmin` over a set does
    // not depend on the order the set is visited in -- so it belongs here and
    // not in `trace`, which says only which primitive is nearest.
    //
    // The key is the child index, flipped when the ray runs backwards along the
    // axis the node was split on. `axis` is a field of the Interior arm and was
    // carried by the layout from the beginning without anything reading it.
    //
    // The same rule inside an instance's tree, where pbrt applies it to the
    // ray *after* `ApplyInverse`: the split axis is an axis of the instance's
    // frame. The key is written over the query's ray here too, and the
    // compiler carries it into the pulled-back one along with every other
    // test in that walk (Opt/PullQueries.h).
    trace.sort(primitives.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .sort(Inst.blas.Interior,
               |i : u8, r : Ray, axis : u8|
               select((1.0 / r.d)[axis] < 0.0,
                      1.0 - cast[[Float]](i), cast[[Float]](i)))
         .loopify(64);
    // The occlusion test gets its own stack, and it is the same 64 pbrt's
    // IntersectP uses.
    trace_any.loopify(64);

    // pbrt's `Point3f *p` and `Normal3f *n` are three floats each, twelve
    // bytes, and so are these: a vertex is stored as exactly its three
    // components and widened to the vector the program computes with where it
    // is read. Left to the compute type, a `vec3f` element is the machine's
    // sixteen-byte vector, and every fetch of a triangle's corners reads a
    // third more memory than pbrt's.
    layout mesh_positions { tight(root); };
    layout mesh_normals { tight(root); };

    // The random walk is a tail recursion, so this turns it into a loop. Said
    // here rather than written as one: what the source says is that a path's
    // next step depends on its last, and how that is run -- a loop per pixel
    // now, a queue of suspended paths advanced together later -- is this
    // block's to decide.
    walk_step.loopify();
    path_step.loopify();
    full_path_step.loopify();

    // The samples of a pixel are a gang on the SIMD unit: ISPC-style, one lane
    // per sample, the whole path trace run a register's worth at a time --
    // sixteen 32-bit lanes, the machine's AVX-512 register. `spp` is a
    // runtime count, and vectorize wants a constant gang width, so split
    // peels a width-sixteen inner loop off it first and that is what is
    // vectorized; a scene whose spp is not a multiple of sixteen is the tail
    // split's to carry.
    render.split(s, s_gang, s_lane, 16, false)
          .vectorize(s_lane);
    render.bind(p, CPUThread);
}
