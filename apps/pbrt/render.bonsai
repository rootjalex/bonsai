//! flags: -p ssa -b cpp -o apps/pbrt/render
// `bind` is an SSA rewrite, so this needs the SSA pipeline rather than the
// default one.

// PBRT v4: a perspective camera over a scene of shapes, shaded by their
// normals. Sampling and spectra are still to come.
//
// The rule for this app is that the source stays a straight transcription of
// PBRT and every performance decision lives in the `schedule` block at the
// bottom. If something here looks like it was written for speed rather than
// for clarity, that is a bug in the schedule language, not a licence to
// rewrite this file.
//
// The clearest instance of that rule is the scene query. PBRT builds a
// `BVHAggregate` and hand-writes the traversal; here `trace` says only what it
// wants -- the nearest shape the ray hits -- and the schedule below decides
// that the answer comes from a BVH, what its nodes look like, and that the
// traversal is a loop over an explicit stack rather than recursion.
//
// What PBRT computes in a constructor is computed by the driver and passed in
// as data. That is faithful to PBRT's hot path, which only ever *applies* the
// camera transforms; building them is a one-off that bonsai has no file I/O to
// drive anyway. The BVH is built there too, for now: tree construction is not
// yet expressible in bonsai, and only the traversal runs per ray.

// stdlib/numerics only, and only for the type aliases and the helpers that are
// themselves transcriptions of pbrt (prod_diff is DifferenceOfProducts, gamma
// is pbrt's gamma). The geometry deliberately does *not* come from the stdlib:
// stdlib/sphere.bonsai and stdlib/intersects.bonsai are derived from Ray
// Tracing in One Weekend and are not numerically what pbrt does, which showed
// up as pixels disagreeing along silhouettes. What this app needs is pbrt's
// arithmetic, so pbrt's arithmetic is written out below.
import stdlib/numerics;

// pbrt: Ray. Its tMax lives on the Ray in bonsai the way pbrt passes it
// alongside; the tree lowering needs a bound to prune against.
element Ray {
    o : vec3f;
    d : vec3f;
    tmax : Float = inf;
}

// pbrt: Sphere. pbrt keeps a transform and a radius and works in object space,
// where the sphere is at the origin; these are placed by a translation only,
// so object space is reached by subtracting the centre.
element Sphere {
    center : vec3f;
    radius : Float;
}

// pbrt: Triangle, as three positions rather than an index into a mesh.
element Triangle {
    p0 : vec3f;
    p1 : vec3f;
    p2 : vec3f;
}

element vec2f = vector[Float, 2];
element vec4f = vector[Float, 4];

// pbrt: Transform, minus the inverse it carries alongside the matrix. Nothing
// in M0 inverts one -- the driver hands over both directions it needs already
// inverted -- so storing mInv would be storing something never read.
//
// Rows rather than a flat 16, so that applying one is four dot products.
element Transform {
    r0, r1, r2, r3 : vec4f;
}

// pbrt: Transform::operator()(Point3f), which divides through by w. The
// perspective transform is the whole reason that divide is here: for an
// affine transform w comes out 1 and PBRT skips it.
func apply_point(t : Transform, p : vec3f) -> vec3f {
    h = vec4f{p.x, p.y, p.z, 1.0};
    xp = dot(t.r0, h);
    yp = dot(t.r1, h);
    zp = dot(t.r2, h);
    wp = dot(t.r3, h);
    v = vec3f{xp, yp, zp};
    return select(wp == 1.0, v, v / wp);
}

// pbrt: Transform::operator()(Vector3f). A direction ignores the translation
// column, so this is the upper-left 3x3 and no divide.
func apply_vector(t : Transform, v : vec3f) -> vec3f {
    h = vec4f{v.x, v.y, v.z, 0.0};
    return vec3f{dot(t.r0, h), dot(t.r1, h), dot(t.r2, h)};
}

// pbrt: CameraSample. M0 takes one sample at the centre of each pixel, so
// p_lens and time are always zero and filter_weight is always one -- but they
// are here because GenerateRay's signature is what M2's sampler will fill in.
element CameraSample {
    p_film : vec2f;
    p_lens : vec2f;
    time : Float = 0.0;
    filter_weight : Float = 1.0;
}

// pbrt: PerspectiveCamera. The two transforms its ctor derives from the field
// of view, the screen window and the resolution; see render_hook.cpp.
element PerspectiveCamera {
    camera_from_raster : Transform;
    render_from_camera : Transform;
}

// pbrt: PerspectiveCamera::GenerateRay. Every ray leaves the camera's origin
// and passes through the sample's point on the film plane. The differentials
// PBRT also computes here are for texture filtering, which M0 has none of.
func generate_ray(camera : PerspectiveCamera, sample : CameraSample) -> Ray {
    p_film = vec3f{sample.p_film.x, sample.p_film.y, 0.0};
    p_camera = apply_point(camera.camera_from_raster, p_film);
    o = apply_point(camera.render_from_camera, vec3f{0.0, 0.0, 0.0});
    d = apply_vector(camera.render_from_camera, unit_vector(p_camera));
    return Ray{o, d};
}

// pbrt: Sphere::BasicIntersect, without the interval arithmetic it carries the
// coefficients in. Answers the parametric distance to the nearest hit ahead of
// the ray, or nothing.
//
// The discriminant is the reason this is written out rather than taken from
// the stdlib. Solving b^2 - 4ac directly loses almost all its significant bits
// when a ray grazes the sphere, because the two terms nearly cancel; pbrt
// instead computes the distance from the sphere's centre to the ray's closest
// approach and forms
//
//     discrim = 4a(radius + |v|)(radius - |v|)
//
// which is the same quantity factored so that the subtraction happens between
// two numbers that are not nearly equal. The quadratic is then solved by the
// stable pairing q = -(b +/- sqrt(discrim))/2, t0 = q/a, t1 = c/q, which avoids
// cancelling again in whichever root is small.
element FInterval {
    low, high : Float;
}

func sphere_roots(r : Ray, s : Sphere) -> option[FInterval] {
    // Object space: the sphere is at the origin.
    oi = r.o - s.center;
    di = r.d;

    a = dot(di, di);
    b = 2.0 * dot(di, oi);
    c = dot(oi, oi) - s.radius * s.radius;

    v = oi - (b / (2.0 * a)) * di;
    length = norm(v);
    discrim = 4.0 * a * (s.radius + length) * (s.radius - length);
    if discrim < 0.0 {
        return {};
    }

    root_discrim = sqrt(discrim);
    q = select(b < 0.0, -0.5 * (b - root_discrim), -0.5 * (b + root_discrim));
    ta = q / a;
    tb = c / q;
    roots : FInterval = {min(ta, tb), max(ta, tb)};
    return roots;
}

func distmin(r : Ray, s : Sphere) -> Float {
    roots = sphere_roots(r, s);
    if roots {
        near = *roots;
        return near.low;
    }
    return -inf;
}

func distmax(r : Ray, s : Sphere) -> Float {
    roots = sphere_roots(r, s);
    if roots {
        far = *roots;
        return far.high;
    }
    return inf;
}

func intersects(r : Ray, s : Sphere) -> bool {
    roots = sphere_roots(r, s);
    if roots {
        hit = *roots;
        return (hit.low < r.tmax) & (hit.high > 0.0);
    }
    return false;
}

// pbrt: IntersectTriangle from shapes.cpp, which is watertight: the ray is
// moved to its own coordinate space, the largest component of its direction
// is permuted into z, and the vertices are sheared so that the edge tests are
// exact in sign. The error bounds at the end are pbrt's, and they are what
// keeps a ray from slipping between two triangles that share an edge.
func triangle_t(ray : Ray, tri : Triangle) -> option[Float] {
    // Degenerate triangles have no interior to hit.
    if (sqlen[[Float]](cross_(tri.p2 - tri.p0, tri.p1 - tri.p0)) == 0)
        return {};

    // Translate the vertices so the ray starts at the origin.
    p0t : mut = tri.p0 - ray.o;
    p1t : mut = tri.p1 - ray.o;
    p2t : mut = tri.p2 - ray.o;

    // Permute so that the ray's dominant direction is z.
    kz : u32 = idxmax(abs(ray.d));
    kx = (kz + 1) % 3;
    ky = (kx + 1) % 3;
    d = permute(ray.d, {kx, ky, kz});
    p0t = permute(p0t, {kx, ky, kz});
    p1t = permute(p1t, {kx, ky, kz});
    p2t = permute(p2t, {kx, ky, kz});

    // Shear, so that the ray becomes +z and the edge tests are 2D.
    Sx = -d.x / d.z;
    Sy = -d.y / d.z;
    Sz = 1 / d.z;
    p0t.x += Sx * p0t.z;
    p0t.y += Sy * p0t.z;
    p1t.x += Sx * p1t.z;
    p1t.y += Sy * p1t.z;
    p2t.x += Sx * p2t.z;
    p2t.y += Sy * p2t.z;

    // Edge functions, by a difference of products that does not cancel.
    e0 = prod_diff[[Float]](p1t.x, p2t.y, p1t.y, p2t.x);
    e1 = prod_diff[[Float]](p2t.x, p0t.y, p2t.y, p0t.x);
    e2 = prod_diff[[Float]](p0t.x, p1t.y, p0t.y, p1t.x);

    // TODO: pbrt falls back to double precision when an edge function is
    // exactly zero, which is where a ray meets a shared edge.

    if ((e0 < 0 || e1 < 0 || e2 < 0) && (e0 > 0 || e1 > 0 || e2 > 0))
        return {};
    det = e0 + e1 + e2;
    if (det == 0)
        return {};

    p0t.z *= Sz;
    p1t.z *= Sz;
    p2t.z *= Sz;

    tScaled = e0 * p0t.z + e1 * p1t.z + e2 * p2t.z;
    if (det < 0 && (tScaled >= 0 || tScaled < ray.tmax * det))
        return {};
    else if (det > 0 && (tScaled <= 0 || tScaled > ray.tmax * det))
        return {};

    invDet = 1 / det;
    t = tScaled * invDet;

    // pbrt's bound on the error in t, so that a hit is only reported when it
    // is conservatively in front of the ray.
    maxZt = max(abs(vec3f{p0t.z, p1t.z, p2t.z}));
    deltaZ = gamma(3) * maxZt;
    maxXt = max(abs(vec3f{p0t.x, p1t.x, p2t.x}));
    maxYt = max(abs(vec3f{p0t.y, p1t.y, p2t.y}));
    deltaX = gamma(5) * (maxXt + maxZt);
    deltaY = gamma(5) * (maxYt + maxZt);
    deltaE = 2 * (gamma(2) * maxXt * maxYt + deltaY * maxXt + deltaX * maxYt);
    maxE = max(abs(vec3f{e0, e1, e2}));
    deltaT = 3 * (gamma(3) * maxE * maxZt + deltaE * maxZt + deltaZ * maxE) * abs(invDet);
    if (t <= deltaT)
        return {};

    return t;
}

// A triangle is flat, so the near and far distance to it are the same one.
func distmin(r : Ray, tri : Triangle) -> Float {
    t = triangle_t(r, tri);
    if t {
        return *t;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    t = triangle_t(r, tri);
    if t {
        return *t;
    }
    return -inf;
}

func intersects(r : Ray, tri : Triangle) -> bool {
    return cast[[bool]](triangle_t(r, tri));
}

// pbrt: Shape, the closed set of things a ray can hit. v4 dispatches this
// through a TaggedPointer over Sphere, Triangle, and the rest; a variant type
// says the same thing without the pointer.
//
// Both shapes are in render space. PBRT keeps a transform per shape and works
// in object space, tracking error bounds through the round trip; placing
// shapes is what brings that back, and nothing here needs it yet.
element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle);

// pbrt: Shape::Intersect and Shape::IntersectP, as one function each that
// matches on which shape it has. The tree the schedule builds calls these
// without knowing a shape has variants at all.
func distmin(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmin(r, s);
        Tri(t) => return distmin(r, t);
    }
}

func distmax(r : Ray, sh : Shape) -> Float {
    match sh {
        Sph(s) => return distmax(r, s);
        Tri(t) => return distmax(r, t);
    }
}

func intersects(r : Ray, sh : Shape) -> bool {
    match sh {
        Sph(s) => return intersects(r, s);
        Tri(t) => return intersects(r, t);
    }
}

// pbrt: the geometric normal at a hit. A sphere's points away from the centre;
// a triangle's is the same everywhere on it.
func normal_at(sh : Shape, p : vec3f) -> vec3f {
    match sh {
        Sph(s) => return (p - s.center) / s.radius;
        Tri(t) => return unit_vector(cross(t.p1 - t.p0, t.p2 - t.p0));
    }
}

extern shapes : set[Shape];

// pbrt: Primitive::Intersect over the whole scene. Written as the question it
// is -- of the shapes this ray hits, which is nearest -- rather than as a
// traversal. The schedule turns it into one.
//
// The epsilon is pbrt's shadow-epsilon in spirit: a hit at zero distance is
// the surface the ray started on.
func trace(r : Ray) =
    argmin(|sh : Shape| distmin(r, sh),
           filter(|sh : Shape| intersects(r, sh) && distmin(r, sh) > 0.001,
                  shapes));

// The geometric normal at the nearest hit, or zero where the ray escapes.
//
// This is what pbrt's `gbuffer` film records in its N channels, which is what
// makes an image from this app comparable against one from pbrt -- see
// compare.sh. It stands in for the integrator until there is a light to
// integrate; turning a normal into a colour is the film's business, and the
// driver does it, exactly as pbrt leaves N unmapped in the EXR.
func li(r : Ray) -> vec3f {
    isect : option[Shape] = trace(r);
    if isect {
        sh = *isect;
        return normal_at(sh, r.o + distmin(r, sh) * r.d);
    }
    return vec3f{0.0, 0.0, 0.0};
}

// pbrt: the render loop, which in v4 is ParallelFor2D over the film tiles.
// One flat loop over pixels rather than two nested ones, because the schedule
// wants a single index to bind.
//
// The film has no size on it: the caller owns the allocation, and how many
// pixels there are is the resolution, which is already here. Naming a length
// as well would be naming the same fact twice and inviting the two to
// disagree.
func [[export]] render(camera : PerspectiveCamera, width : u32, height : u32,
                       out : mut array[vec3f]) -> void {
    parfor p in 0u:(width * height) {
        i = p % width;
        j = p / width;
        // pbrt: GetCameraSample, at the pixel centre with no filter.
        sample = CameraSample{vec2f{cast[[Float]](i) + 0.5,
                                    cast[[Float]](j) + 0.5},
                              vec2f{0.0, 0.0}, 0.0, 1.0};
        out[p] = li(generate_ray(camera, sample));
    }
    return;
}

schedule {
    // pbrt: BVHAggregate. Everything about how the scene is searched lives
    // here -- that it is a BVH at all, that its bounding volume is a sphere,
    // how a node is packed, and that traversal is a loop over a stack of 64
    // rather than recursion. None of it appears in `trace` above.
    tree[[Shape]] ShapeBVH(center : vec3f, radius : Float)
        with Sphere(center, radius) =
    | Interior(left : ShapeBVH, right : ShapeBVH, axis : u8)
    | Leaf(data : array[Shape]) with data = data;

    shapes : ShapeBVH;

    layout shapes {
        pCount : u32;
        prims : array[Shape, pCount];
        nCount : u32;
        group[nCount] index : u32 {
            center : vec3f;
            radius : Float;
            nPrims : u16;
            axis : u8;
            8; // pad bits.
            switch nPrims {
                0 => Interior { offset : u32; left = index + 1; right = index + offset; };
                _ => Leaf { pOffset : u32; data = range(prims, pOffset, cast[[u32]](nPrims)); };
            };
        };
    };

    trace.loopify(64);

    render.bind(p, CPUThread);
}
