# The hair material: pbrt's HairMaterial over its HairBxDF (Chiang et al.
# 2016), before any curve exists to wear it -- on cylinders, whose shading
# frame puts the fibre's direction (the BSDF's x) around the circumference
# and whose v runs along the axis, so h (-1 + 2 v) sweeps the width as the
# camera looks up and down each one. The same numbers on both sides, since
# pbrt builds the BSDF from the same frame.
#
# Six cylinders, one per way the material is given, standing in a row under
# a tube light: nothing (brown, the concentrations 1.3 and 0); bunny-fur's
# `rgb color` with beta_m and beta_n at 0.5 (the wide-roughness branch of
# Mp, with sinh in it); the hair scenes' `eumelanin` 0.3 at beta_m 0.25; an
# `rgb sigma_a` with the scales' tilt turned off; beta_m 0.7 with both
# melanins; and a `spectrum sigma_a`. `volpath`, since the hair scenes name
# it, so pbrt's reference is `--wavefront` (compare.sh --pbrt-wavefront).

Integrator "volpath"
    "integer maxdepth" [ 5 ]

LookAt 0 3.2 11   0 1.1 0   0 1 0
Camera "perspective"
    "float fov" [ 42 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

Film "gbuffer"
    "string filename" [ "hair-material.exr" ]
    "string coordinatesystem" [ "world" ]
    "bool savefp16" false
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0 0 0 ]
    Translate 0 6 1
    Rotate 90 0 1 0
    AreaLightSource "diffuse"
        "rgb L" [ 7 6.6 6 ]
    Shape "cylinder"
        "float radius" [ 0.4 ]
        "float zmin" [ -5 ]
        "float zmax" [ 5 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.45 0.45 0.5 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

# Default: brown hair, SigmaAFromConcentration(1.3, 0).
AttributeBegin
    Material "hair"
    Translate -4 0 0
    Rotate -90 1 0 0
    Shape "cylinder"
        "float radius" [ 0.45 ]
        "float zmin" [ 0 ]
        "float zmax" [ 2.4 ]
AttributeEnd

# bunny-fur's: a colour, worked backwards to an absorption, wide lobes.
AttributeBegin
    Material "hair"
        "rgb color" [ 0.5 0.5 0.5 ]
        "float beta_m" [ 0.5 ]
        "float beta_n" [ 0.5 ]
    Translate -2.4 0 0
    Rotate -90 1 0 0
    Shape "cylinder"
        "float radius" [ 0.45 ]
        "float zmin" [ 0 ]
        "float zmax" [ 2.4 ]
AttributeEnd

# The hair scenes': a eumelanin concentration, narrow longitudinal lobes.
AttributeBegin
    Material "hair"
        "float eumelanin" [ 0.3 ]
        "float beta_m" [ 0.25 ]
    Translate -0.8 0 0
    Rotate -90 1 0 0
    Shape "cylinder"
        "float radius" [ 0.45 ]
        "float zmin" [ 0 ]
        "float zmax" [ 2.4 ]
AttributeEnd

# An absorption given as an rgb, and no scale tilt.
AttributeBegin
    Material "hair"
        "rgb sigma_a" [ 0.2 0.5 1.1 ]
        "float alpha" [ 0 ]
    Translate 0.8 0 0
    Rotate -90 1 0 0
    Shape "cylinder"
        "float radius" [ 0.45 ]
        "float zmin" [ 0 ]
        "float zmax" [ 2.4 ]
AttributeEnd

# Both melanins, the widest roughness, a different index.
AttributeBegin
    Material "hair"
        "float eumelanin" [ 0.5 ]
        "float pheomelanin" [ 1.5 ]
        "float beta_m" [ 0.7 ]
        "float beta_n" [ 0.4 ]
        "float eta" [ 1.7 ]
    Translate 2.4 0 0
    Rotate -90 1 0 0
    Shape "cylinder"
        "float radius" [ 0.45 ]
        "float zmin" [ 0 ]
        "float zmax" [ 2.4 ]
AttributeEnd

# An absorption given as a spectrum.
AttributeBegin
    Material "hair"
        "spectrum sigma_a" [ 400 1.5 550 0.6 700 0.2 ]
        "float beta_n" [ 0.2 ]
    Translate 4 0 0
    Rotate -90 1 0 0
    Shape "cylinder"
        "float radius" [ 0.45 ]
        "float zmin" [ 0 ]
        "float zmax" [ 2.4 ]
AttributeEnd
