# A grid medium: pbrt's `uniformgrid`, a 10x10x10 density with a temperature
# grid that makes its core glow as a blackbody, placed by a transform -- a
# translation, a turn about y and a non-uniform scale -- so that the pull of a
# ray into the medium's space, the clipping to its box and the DDA over the
# 16x16x16 majorant grid are all exercised. The boundary is an `interface`
# box a little larger than the medium's own, under the same transform, as
# smoke-plume's sphere is: a ray through the box's margin never meets the
# medium, which is the no-segments case. Lit by an area light above, over a
# dim floor.

Integrator "volpath"
    "integer maxdepth" [ 5 ]

LookAt 0 2.5 9   0 1.2 0   0 1 0
Camera "perspective"
    "float fov" [ 40 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

Film "gbuffer"
    "string filename" [ "grid-medium.exr" ]
    "string coordinatesystem" [ "world" ]
    "bool savefp16" false
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

# The emitter.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0 0 0 ]
    Translate 0 7 2
    AreaLightSource "diffuse"
        "rgb L" [ 12 11 9 ]
    Shape "sphere"
        "float radius" [ 2.5 ]
AttributeEnd

# The floor.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.4 0.4 0.42 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

# The smoke, declared under its transform, and its boundary.
AttributeBegin
    Translate -1.5 0.2 -1.5
    Rotate 25 0 1 0
    Scale 3 2.4 3
    MakeNamedMedium "smoke"
