# An RGB grid medium: pbrt's `rgbgrid`, a 6x6x6 grid of RGB absorption and
# scattering coefficients -- each voxel its own RGBUnboundedSpectrum, the
# eight about a point sampled and then interpolated, as pbrt does -- with an
# RGB emission (an RGBIlluminantSpectrum) in the core under `Lescale`. The
# absorption reddens towards +x and the scattering is bluish, so the colour of
# the fog changes across it. Placed by a translation and a scale; the boundary
# is an `interface` box around it.

Integrator "volpath"
    "integer maxdepth" [ 5 ]

LookAt 0 2.5 9   0 1.2 0   0 1 0
Camera "perspective"
    "float fov" [ 40 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

Film "gbuffer"
    "string filename" [ "rgb-grid.exr" ]
    "string coordinatesystem" [ "world" ]
    "bool savefp16" false
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

# The emitter.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0 0 0 ]
    Translate 0 7 2
    AreaLightSource "diffuse"
        "rgb L" [ 12 11 9 ]
    Shape "sphere"
        "float radius" [ 2.5 ]
AttributeEnd

# The floor.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.4 0.4 0.42 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

# The fog, declared under its transform, and its boundary.
AttributeBegin
    Translate -1.25 0.3 -1.25
    Scale 2.5 2.5 2.5
    MakeNamedMedium "fog"
        "string type" [ "rgbgrid" ]
        "integer nx" [ 6 ] "integer ny" [ 6 ] "integer nz" [ 6 ]
        "float scale" [ 1 ]
        "float Lescale" [ 8 ]
