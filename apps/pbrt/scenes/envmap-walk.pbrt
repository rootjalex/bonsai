# An environment map found only by flying into it.
#
# `randomwalk` never samples a light, so the sky here arrives entirely through
# `Le` on escaped rays -- no distribution, no shadow ray, no MIS. That makes it
# the control for `envmap.pbrt`, which is the same scene under `path` and
# reaches the same sky by sampling the map instead. The two agree with pbrt
# about the same picture and disagree wildly about how noisy it is, which is
# the entire argument for importance-sampling an environment map: every escaped
# ray here lands on a different texel of a high-frequency sky.
#
# The map is one of pbrt-v4-scenes' own, by absolute path, because it is 24 MB
# and generated files do not live in this repository. A scene that cannot find
# it is refused by the reader rather than rendered dark.

Integrator "randomwalk"
    "integer maxdepth" [ 5 ]

LookAt 0 4 12   0 1 0   0 1 0
Camera "perspective"
    "float fov" [ 50 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

# See dielectric.pbrt for why the film is a gbuffer and the other two are set.
Film "gbuffer"
    "string filename" [ "envmap.exr" ]
    "string coordinatesystem" [ "world" ]
    "bool savefp16" false
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

# The rotation is the point: it is what makes `renderFromLight` not the
# identity, and a map placed by the wrong transform is a sky in the wrong place.
AttributeBegin
    Rotate -90 1 0 0
    LightSource "infinite"
        "string filename" "/home/ajroot/projects/pbrt-v4-scenes/lte-orb/textures/small_rural_road_equiarea.exr"
        "float scale" [ 1.4 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.55 0.55 0.6 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

AttributeBegin
    Material "coateddiffuse"
        "float roughness" [ 0.05 ]
        "rgb reflectance" [ 0.5 0.15 0.15 ]
    Translate -2 1.2 0
    Shape "sphere"
        "float radius" [ 1.2 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.2 0.45 0.25 ]
    Translate 2 1.2 0
    Shape "sphere"
        "float radius" [ 1.2 ]
AttributeEnd
