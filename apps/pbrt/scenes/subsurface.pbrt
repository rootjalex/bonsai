# Subsurface scattering: pbrt's SubsurfaceMaterial, a dielectric boundary over
# a tabulated BSSRDF. A path that refracts into one of these does not go on as
# a ray: a probe segment is sampled from the beam-diffusion profile about the
# entry point, walked for the surface's own hits, one of which -- chosen by a
# reservoir -- is where the path comes back out, with a diffuse-like lobe
# there and the profile's value for what it carried through.
#
# Three of pbrt's four ways of giving the coefficients, on three spheres: a
# named measurement (`Skin1`, sssdragon's form, reduced coefficients so the
# table is for g = 0), a reflectance and a mean free path (head's form,
# roughness given and not remapped), and `sigma_a`/`sigma_s` as RGB with an
# anisotropy, which makes a second table. The fourth, nothing given (whole
# milk), is the small sphere. `Integrator "volpath"`: pbrt's `path` has no
# subsurface branch at all. Compared against `pbrt --wavefront`, whose probe
# reservoir is seeded from the segment's ends; the CPU integrator draws a
# sampler dimension for it instead.

Integrator "volpath"
    "integer maxdepth" [ 10 ]

LookAt 0 4 11   0 1 0   0 1 0
Camera "perspective"
    "float fov" [ 45 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

Film "gbuffer"
    "string filename" [ "subsurface.exr" ]
    "string coordinatesystem" [ "world" ]
    "bool savefp16" false
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

LightSource "infinite"
    "rgb L" [ 0.2 0.2 0.25 ]

# The emitter: a disk facing the floor, off to one side so the spheres are
# lit from above and the light travels through them.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0 0 0 ]
    Translate 2 7 2
    Rotate 90 1 0 0
    AreaLightSource "diffuse"
        "rgb L" [ 12 11 10 ]
    Shape "disk"
        "float radius" [ 2 ]
AttributeEnd

# The floor.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.5 0.5 0.55 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

# Skin, by name.
AttributeBegin
    Material "subsurface"
        "string name" [ "Skin1" ]
        "float scale" [ 2 ]
        "float eta" [ 1.33 ]
    Translate -2.4 1.1 0
    Shape "sphere"
        "float radius" [ 1.1 ]
AttributeEnd

# A reflectance and a mean free path.
AttributeBegin
    Material "subsurface"
        "rgb reflectance" [ 0.8 0.5 0.4 ]
        "rgb mfp" [ 0.3 0.2 0.12 ]
        "float eta" [ 1.33 ]
        "float uroughness" [ 0.05 ]
        "float vroughness" [ 0.05 ]
        "bool remaproughness" false
    Translate 0.2 1.1 0.3
    Shape "sphere"
        "float radius" [ 1.1 ]
AttributeEnd

# Coefficients given, with an anisotropy.
AttributeBegin
    Material "subsurface"
        "rgb sigma_a" [ 0.03 0.1 0.3 ]
        "rgb sigma_s" [ 1.5 1.2 1.0 ]
        "float g" [ 0.3 ]
        "float scale" [ 3 ]
        "float eta" [ 1.5 ]
    Translate 2.8 1 -0.4
    Shape "sphere"
        "float radius" [ 1 ]
AttributeEnd

# Nothing given: whole milk.
AttributeBegin
    Material "subsurface"
    Translate 1.3 0.45 2.6
    Shape "sphere"
        "float radius" [ 0.45 ]
AttributeEnd
