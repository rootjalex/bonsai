# An environment map, sampled.
#
# The scene `envmap-walk.pbrt` renders with a random walk, which finds the sky
# only by flying into it. This one samples it: `SampleLi` draws a direction from
# a distribution built across the map's texels, so a bright patch is found often
# and an even one rarely, and a shadow ray is spent on it. The two renders are
# the same picture and are not remotely the same amount of noise, which is the
# whole argument for importance-sampling an environment map.
#
# `path` also selects the *compensated* distribution: pbrt passes
# `allowIncompletePDF` and an ImageInfiniteLight answers with a second table
# built over `max(0, texel - average)`, so the light sampler spends its effort
# on the part of the sky that is brighter than average and leaves the even part
# to the BSDF sample, which finds it perfectly well. `simplepath` on the same
# scene takes the plain table instead, which is the other branch and is checked
# the same way.
#
# The map is one of pbrt-v4-scenes' own, by absolute path, because it is 24 MB
# and generated files do not live in this repository.

Integrator "path"
    "integer maxdepth" [ 5 ]

LookAt 0 4 12   0 1 0   0 1 0
Camera "perspective"
    "float fov" [ 50 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

Film "rgb"
    "string filename" [ "envmap.exr" ]
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

# The rotation is the point: it is what makes `renderFromLight` not the
# identity, and a map placed by the wrong transform is a sky in the wrong place.
AttributeBegin
    Rotate -90 1 0 0
    LightSource "infinite"
        "string filename" "/home/ajroot/projects/pbrt-v4-scenes/lte-orb/textures/small_rural_road_equiarea.exr"
        "float scale" [ 1.4 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.55 0.55 0.6 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

AttributeBegin
    Material "coateddiffuse"
        "float roughness" [ 0.05 ]
        "rgb reflectance" [ 0.5 0.15 0.15 ]
    Translate -2 1.2 0
    Shape "sphere"
        "float radius" [ 1.2 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.2 0.45 0.25 ]
    Translate 2 1.2 0
    Shape "sphere"
        "float radius" [ 1.2 ]
AttributeEnd
