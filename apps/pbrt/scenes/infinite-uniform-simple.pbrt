# `infinite-uniform.pbrt` under `simplepath`, which takes the other branch of
# every decision that scene describes.
#
# The difference is one flag and it is the whole of what is interesting here.
# `path` passes `allowIncompletePDF`, and a uniform infinite light answers it by
# declining to be sampled at all -- its contribution arrives entirely through
# rays that escape. `simplepath` does not pass it, because it has no second
# estimator to fall back on, so here the same light *is* sampled: a direction
# over the whole sphere, a shadow ray aimed two scene radii out at a point that
# does not exist, and no emission picked up on escape unless the bounce was
# specular.
#
# So the two scenes reach the sky by opposite routes and have to agree with
# pbrt about the same picture. They very nearly agree with each other too,
# which is the point -- two correct estimators of one integral.
#
# The random walk is the third route and needs no scene of its own: it never
# samples a light, so its escape path is the sum with no weight on it, and it
# is checked by rendering either of these two with `--spp` and reading the mean.

Integrator "simplepath"
    "integer maxdepth" [ 5 ]

LookAt 0 4 12   0 1 0   0 1 0
Camera "perspective"
    "float fov" [ 50 ]

Sampler "independent"
    "integer pixelsamples" [ 64 ]

Film "rgb"
    "string filename" [ "infinite-uniform-simple.exr" ]
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

LightSource "infinite"
    "rgb L" [ 0.4 0.45 0.6 ]
    "float scale" [ 1.5 ]

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.55 0.55 0.6 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

AttributeBegin
    Material "coateddiffuse"
        "float roughness" [ 0.05 ]
        "rgb reflectance" [ 0.5 0.15 0.15 ]
    Translate -2 1.2 0
    Shape "sphere"
        "float radius" [ 1.2 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.2 0.45 0.25 ]
    Translate 2 1.2 0
    Shape "sphere"
        "float radius" [ 1.2 ]
AttributeEnd
