# An environment map seen through a window: pbrt's PortalImageInfiniteLight.
#
# The room is a floor and a back wall with a rectangular opening; the sky is
# the same map as envmap.pbrt, but here the scene tells the light the four
# corners of the opening (`portal`), and the light does two things an
# environment map alone cannot: it answers an escaped ray only when the ray
# passes through the opening, and it sends its shadow rays only towards the
# opening -- sampling the map inside the rectangle the window covers as seen
# from the point being lit, which is what makes a room lit by a window
# renderable at all. The corners are ordered so that pbrt's frame for them
# (its `x` along corner 0 to 3, `y` along 0 to 1, `z` their cross product)
# has `z` pointing out of the room: the light is seen from the frame's
# positive side only.
#
# The light is rotated as envmap.pbrt's is, so the map's own transform is not
# the identity and the resampling into the portal's parameterization has to
# undo it; the sphere and the floor catch the light, and the wall's inside is
# lit only through the opening.

Integrator "volpath"
    "integer maxdepth" [ 5 ]

LookAt 0 1.6 4.5   0 1.5 -3   0 1 0
Camera "perspective"
    "float fov" [ 55 ]

Sampler "halton"
    "integer pixelsamples" [ 16 ]

# See dielectric.pbrt for why the film is a gbuffer and the other two are set.
Film "gbuffer"
    "string filename" [ "portal.exr" ]
    "string coordinatesystem" [ "world" ]
    "bool savefp16" false
    "integer xresolution" [ 400 ]
    "integer yresolution" [ 300 ]

WorldBegin

AttributeBegin
    Rotate -90 1 0 0
    LightSource "infinite"
        "string filename" "/home/ajroot/projects/pbrt-v4-scenes/lte-orb/textures/small_rural_road_equiarea.exr"
        "float scale" [ 1.4 ]
        # The opening's corners, in world space, x from 1 to -1 and y from 1 to
        # 2.5 in the wall's plane z = -3: corner 0 at the bottom right, 1 above
        # it, 2 at the top left, 3 at the bottom left.
        "point3 portal" [ 1 1 -3   1 2.5 -3   -1 2.5 -3   -1 1 -3 ]
AttributeEnd

# The floor.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.55 0.55 0.6 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -6 0 -3   6 0 -3   6 0 6   -6 0 6 ]
AttributeEnd

# The back wall, in four pieces around the opening: left of it, right of it,
# below it and above it.
AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.7 0.68 0.6 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -6 0 -3   -1 0 -3   -1 4 -3   -6 4 -3 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ 1 0 -3   6 0 -3   6 4 -3   1 4 -3 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -1 0 -3   1 0 -3   1 1 -3   -1 1 -3 ]
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 2 3 0 ]
        "point3 P" [ -1 2.5 -3   1 2.5 -3   1 4 -3   -1 4 -3 ]
AttributeEnd

# Something in the room to be lit through the window.
AttributeBegin
    Material "coateddiffuse"
        "float roughness" [ 0.1 ]
        "rgb reflectance" [ 0.5 0.15 0.15 ]
    Translate -0.8 0.7 -0.5
    Shape "sphere"
        "float radius" [ 0.7 ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.2 0.45 0.25 ]
    Translate 1.2 0.5 0.5
    Shape "sphere"
        "float radius" [ 0.5 ]
AttributeEnd
