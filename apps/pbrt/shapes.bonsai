// pbrt: the shapes a ray can hit, and the bounding volume a BVH node uses.
//
// Sphere::BasicIntersect, IntersectTriangle and Bounds3::IntersectP, together
// with the Shape variant that dispatches between the first two. The geometry
// deliberately does not come from bonsai's stdlib: stdlib/sphere.bonsai and
// stdlib/intersects.bonsai are derived from Ray Tracing in One Weekend and are
// not numerically what pbrt does, which showed up as pixels disagreeing along
// silhouettes.
import stdlib/numerics;
import apps/pbrt/frame;
import apps/pbrt/interval;
import apps/pbrt/sampling;
import apps/pbrt/transform;

// pbrt: Ray -- the origin and the direction. pbrt's carries a time and a
// medium too; this program has no motion blur, and the medium travels beside
// the ray as an index. The far bound is not a field of the ray, as it is not
// in pbrt: every Intersect takes `(ray, tMax)`, and the bound travels beside
// the ray -- infinity for a path's, `1 - ShadowEpsilon` for a shadow ray's --
// so that a ray in a queue is what pbrt's RayWorkItem holds and no more.
element Ray {
    o : vec3f;
    d : vec3f;
}

// pbrt: the `(Ray, Float tMax)` that Intersect and IntersectP take, as the
// one object a tree query prunes with: the ray, and how far along it a hit
// counts. A spatial relation is between two objects, so the bound has to ride
// with the ray for the query's length; it is built where the query is asked
// and lives no longer.
element RaySegment {
    ray : Ray;
    tmax : Float;
}

// pbrt: Sphere -- a quadric in an object space its transform places, as
// pbrt keeps every quadric: the sphere is at the origin there, and a ray is
// pulled into that space to be tested, the hit pushed back out. `radius`,
// `z_min`, `z_max` and `phi_max` are pbrt's constructor's -- the two heights
// clamped to the radius, phimax in radians clamped to a turn -- and the two
// theta bounds are the arc cosines of the heights over the radius, computed
// once by the converter as the constructor computes them; a full sphere has
// theta from pi at the bottom to zero at the top, so the span the v
// coordinate is measured over is negative.
element Sphere {
    render_from_object : Transform;
    object_from_render : Transform;
    radius : Float;
    z_min : Float;
    z_max : Float;
    theta_z_min : Float;
    theta_z_max : Float;
    phi_max : Float;
    // pbrt: reverseOrientation ^ transformSwapsHandedness, which decides which
    // way a hit's surface normal points. Invisible in the gbuffer, whose
    // normal is turned to face the camera whichever way this falls, and not
    // invisible in a shading frame -- flipping the normal flips the frame's y
    // axis with it, and a layered BSDF is seeded by hashing the direction it
    // is asked about.
    flip : bool = false;
    // pbrt: reverseOrientation alone, which turns a *sampled* point's normal.
    reverse : bool = false;
}

// pbrt: TriangleMesh, and the arrays every mesh in the scene shares.
//
// pbrt keeps one of these per mesh in a global list and a Triangle names the
// list entry; the arrays here are that list's contents laid end to end, so a
// mesh is where its own run of each begins. `vertexIndices` are mesh-local in
// pbrt, which is what `first_vertex` adds back.
//
// The normals and the texture coordinates are separately offset because a mesh
// that has neither contributes nothing to either pool -- and because absence is
// not the same as a default. A mesh with no normals takes a different path
// entirely, where the shading normal is the geometric one; a mesh with no
// texture coordinates gets pbrt's (0,0), (1,0), (1,1), which are per triangle
// rather than per vertex and so cannot be stored in a pool at all.
element TriangleMesh {
    first_index : u32;
    first_vertex : u32;
    first_normal : u32;
    first_uv : u32;
    has_normals : bool;
    has_uv : bool;
    // pbrt: reverseOrientation ^ transformSwapsHandedness. See Sphere above.
    flip : bool;
}

extern meshes : array[TriangleMesh];
extern mesh_indices : array[u32];
extern mesh_positions : array[vec3f];
extern mesh_normals : array[vec3f];
extern mesh_uvs : array[vec2f];

// pbrt: Triangle, which is a mesh index and a triangle index and nothing else.
// The vertex data is fetched from the shared mesh on a hit.
//
// That is the whole of why a primitive here is the size of a sphere rather than
// the size of a triangle's worth of vertices: a triangle used to carry its own
// copy of three positions, three normals and three texture coordinates, and
// every sphere in the scene paid for it too, because a variant is as large as
// its largest arm.
element Triangle {
    mesh : u32;
    tri : u32;
}

// The three vertices of a triangle, which is what pbrt's
// `const int *v = &mesh->vertexIndices[3 * triIndex]` names.
func mesh_corner(m : TriangleMesh, t : Triangle, corner : u32) -> u32 =
    m.first_vertex + mesh_indices[m.first_index + 3u * t.tri + corner];

func triangle_p(t : Triangle, corner : u32) -> vec3f =
    mesh_positions[mesh_corner(meshes[t.mesh], t, corner)];

// The two solutions of the quadratic, each still an interval, so that the
// caller can ask about a bound rather than about a value -- and the ray in
// object space they were solved along, as values (pbrt's `Point3f(oi)` and
// `Vector3f(di)`, the intervals' midpoints), which the hit point is read
// off.
element Roots {
    t0, t1 : Interval;
    o, d : vec3f;
}

// pbrt: Sphere::BasicIntersect, in the interval arithmetic pbrt carries the
// coefficients in.
//
// The intervals are what make the decisions trustworthy at grazing incidence.
// A ray that nearly misses gives a discriminant whose exact sign is lost to
// rounding; asking `discrim.LowerBound() < 0` instead asks whether it is
// *certainly* negative, so a ray is only rejected when no rounding of the
// inputs could have made it hit.
//
// The discriminant is also factored the way pbrt factors it -- the distance
// from the centre to the ray's closest approach, rather than b^2 - 4ac -- so
// that the subtraction happens between two numbers that are not nearly equal.
// Both matter: the factoring keeps the value accurate, the intervals keep the
// comparison honest about what accuracy is left.
func sphere_roots(r : Ray, s : Sphere) -> option[Roots] {
    // pbrt: `(*objectFromRender)(Point3fi(r.o))` and `(Vector3fi(r.d))` --
    // the ray into object space as intervals whose width is the matrix's own
    // rounding (row_point_interval, row_vector_interval). pbrt divides the
    // point by its w where that is not one; a shape's transform is affine and
    // it is one.
    inv = s.object_from_render;
    oix = row_point_interval(inv.r0, r.o);
    oiy = row_point_interval(inv.r1, r.o);
    oiz = row_point_interval(inv.r2, r.o);
    dix = row_vector_interval(inv.r0, r.d);
    diy = row_vector_interval(inv.r1, r.d);
    diz = row_vector_interval(inv.r2, r.d);

    a = iadd(iadd(isqr(dix), isqr(diy)), isqr(diz));
    b = imulf(2.0, iadd(iadd(imul(dix, oix), imul(diy, oiy)),
                        imul(diz, oiz)));
    c = isub(iadd(iadd(isqr(oix), isqr(oiy)), isqr(oiz)),
             isqr(exact(s.radius)));

    // v = oi - (b / 2a) * di, the vector from the centre to the ray's closest
    // approach, and |v| its distance.
    half = idiv(b, imulf(2.0, a));
    vx = isub(oix, imul(half, dix));
    vy = isub(oiy, imul(half, diy));
    vz = isub(oiz, imul(half, diz));
    length = isqrt(iadd(iadd(isqr(vx), isqr(vy)), isqr(vz)));

    // Grouped as pbrt groups it: ((4a)(r + |v|))(r - |v|). Interval
    // multiplication is not associative, so the grouping is part of the answer.
    radius = exact(s.radius);
    discrim = imul(imul(imulf(4.0, a), iadd(radius, length)),
                   isub(radius, length));
    // Certainly negative, rather than negative once rounded.
    if discrim.low < 0.0 {
        return {};
    }

    root_discrim = isqrt(discrim);
    // The pairing that avoids cancelling in whichever root is small.
    q : mut = imulf(-0.5, iadd(b, root_discrim));
    if mid(b) < 0.0 {
        q = imulf(-0.5, isub(b, root_discrim));
    }

    t0 : mut = idiv(q, a);
    t1 : mut = idiv(c, q);
    // Ordered by lower bound, which is the order that survives rounding.
    if t0.low > t1.low {
        swap = t0;
        t0 = t1;
        t1 = swap;
    }

    roots : Roots = {t0, t1, vec3f{mid(oix), mid(oiy), mid(oiz)},
                     vec3f{mid(dix), mid(diy), mid(diz)}};
    return roots;
}

// pbrt: QuadricIntersection, as a sphere fills it: the distance along the
// ray, the hit in object space, and its azimuth about the sphere's axis.
element SphereHit {
    t : Float;
    p_obj : vec3f;
    phi : Float;
}

// pbrt: the hit point a root gives -- `Point3f(oi) + t * Vector3f(di)`,
// refined onto the sphere since t is only as accurate as the quadratic that
// made it, nudged off the axis where phi is undefined -- and its azimuth.
func sphere_point(s : Sphere, o : vec3f, d : vec3f, t : Float) -> SphereHit {
    raw = o + t * d;
    scaled = raw * (s.radius / norm(raw));
    p = select((scaled.x == 0.0) & (scaled.y == 0.0),
               vec3f{0.00001 * s.radius, scaled.y, scaled.z}, scaled);
    phi0 = atan2(p.y, p.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    hit : SphereHit = {t, p, phi};
    return hit;
}

// pbrt: the clipping test against zmin, zmax and phimax; a partial sphere is
// the part of the surface that passes it, and a full one passes everywhere.
func sphere_clipped(s : Sphere, h : SphereHit) -> bool =
    ((s.z_min > -s.radius) & (h.p_obj.z < s.z_min)) |
    ((s.z_max < s.radius) & (h.p_obj.z > s.z_max)) | (h.phi > s.phi_max);

// pbrt: the tail of BasicIntersect, which picks the nearer root that is
// actually ahead of the ray and within tMax, and falls back to the farther
// where the clipping takes the nearer away. Every range test is on a bound
// rather than on the interval's value: a root is only rejected when it is
// certainly out of range, so a hit is never dropped because rounding pushed
// it a few ulp past the boundary. This is the test for a sphere the ray is
// trying to *hit*.
func sphere_hit(r : Ray, tmax : Float, s : Sphere) -> option[SphereHit] {
    found = sphere_roots(r, s);
    if !found {
        return {};
    }
    roots = *found;
    if (roots.t0.high > tmax) | (roots.t1.low <= 0.0) {
        return {};
    }
    near : mut Interval = roots.t0;
    took_far : mut bool = false;
    if roots.t0.low <= 0.0 {
        // The near root is behind the ray, so the far one is the hit -- if it
        // is in range at all.
        if roots.t1.high > tmax {
            return {};
        }
        near = roots.t1;
        took_far = true;
    }
    first = sphere_point(s, roots.o, roots.d, mid(near));
    if !sphere_clipped(s, first) {
        return first;
    }
    // pbrt: `if (tShapeHit == t1) return {}` -- the far root was the one
    // clipped; else the far root, within tMax and not clipped itself.
    if took_far | (roots.t1.high > tmax) {
        return {};
    }
    second = sphere_point(s, roots.o, roots.d, mid(roots.t1));
    if sphere_clipped(s, second) {
        return {};
    }
    return second;
}

// pbrt: Bounds3f, and the bounding volume the schedule gives a BVH node.
element AABB {
    low, high : vec3f;
}

// The stretch of the ray that lies inside a box, which is a different question
// from where it hits a surface.
element Span {
    lo, hi : Float;
}

// pbrt: Bounds3::IntersectP, the overload the BVH traversal calls, which is a
// slab test: the ray is clipped against the pair of parallel planes on each
// axis, and what survives all three is the interval it spends inside the box.
//
// This is deliberately not interval arithmetic, and pbrt does not use it here
// either. A node test only has to be conservative -- never report a miss where
// something inside could be hit -- and it runs at every node of the tree, so
// pbrt buys that conservatism with a single widening of the far bound rather
// than with a proof. The provable bound is spent where it decides something,
// in sphere_hit. Measured on this scene, a node test carrying intervals cost
// 355ms against 50ms for the identical image.
//
// The widening is the whole robustness argument: the divisions and
// subtractions above it can each round the far plane inwards, and a ray
// entering exactly at a face would then be clipped out of a node it really
// does touch. gamma(3) bounds those three roundings, and doubling it is
// pbrt's margin.
func aabb_span(r : Ray, b : AABB) -> option[Span] {
    inv_dir = 1.0 / r.d;
    dir_is_neg = inv_dir < 0.0;

    // Which face of each slab the ray meets first depends on its direction.
    near_face = select(dir_is_neg, b.high, b.low);
    far_face = select(dir_is_neg, b.low, b.high);
    t_near = (near_face - r.o) * inv_dir;
    t_far : mut = (far_face - r.o) * inv_dir;
    t_far *= 1.0 + 2.0 * gamma(3);

    // x against y, then the survivor against z. Ordered as pbrt orders it so
    // that a NaN from a zero direction component falls the same way.
    if (t_near.x > t_far.y) | (t_near.y > t_far.x) {
        return {};
    }
    lo : mut = max(t_near.x, t_near.y);
    hi : mut = min(t_far.x, t_far.y);

    if (lo > t_far.z) | (t_near.z > hi) {
        return {};
    }
    lo = max(lo, t_near.z);
    hi = min(hi, t_far.z);

    span : Span = {lo, hi};
    return span;
}

// What the tree lowering prunes with. `intersects` is pbrt's return value from
// IntersectP; the two distances are the ends of the span, and a miss reports
// an empty interval the wrong way round so that nothing selects it.
func distmin(q : RaySegment, b : AABB) -> Float {
    found = aabb_span(q.ray, b);
    if found {
        span = *found;
        return span.lo;
    }
    return -inf;
}

func distmax(q : RaySegment, b : AABB) -> Float {
    found = aabb_span(q.ray, b);
    if found {
        span = *found;
        return span.hi;
    }
    return inf;
}

func intersects(q : RaySegment, b : AABB) -> bool {
    found = aabb_span(q.ray, b);
    if found {
        span = *found;
        return (span.lo < q.tmax) & (span.hi > 0.0);
    }
    return false;
}

// The other half of what the tree lowering prunes with, and the half only an
// `any` query asks for.
//
// `intersects` is the *necessary* condition -- a node the ray misses holds
// nothing the ray hits, so the traversal can skip it. `contains` is the
// *sufficient* one: a node the ray contains entirely holds nothing the ray
// misses, so an `any` could answer yes without descending into it at all. The
// lowering asks for both and uses whichever its query needs.
//
// For a ray the sufficient condition is never satisfiable and this is always
// false. A ray is a one-dimensional set of points and a box with any extent is
// three-dimensional, so no ray contains a box; the early-out this would license
// cannot fire, and a shadow ray's saving comes from the other direction --
// stopping at the first primitive that answers yes rather than ordering every
// one that could be nearer.
//
// Written out rather than left for the lowering to fail on, because "no ray
// contains a box" is a fact about geometry and this is where this app keeps
// those. A `contains` that guessed `true` would prune away real occluders and
// light the scene through walls.
func contains(q : RaySegment, b : AABB) -> bool = false;

// pbrt: TriangleIntersection, which is where a ray met a triangle: how far
// along, and where in the triangle. The barycentrics are what the shading
// geometry interpolates the vertex normals with, so the intersection has to
// hand them back rather than only the distance.
element TriangleHit {
    t : Float;
    b : vec3f;
}

// pbrt: IntersectTriangle from shapes.cpp, which is watertight: the ray is
// moved to its own coordinate space, the largest component of its direction
// is permuted into z, and the vertices are sheared so that the edge tests are
// exact in sign. The error bounds at the end are pbrt's, and they are what
// keeps a ray from slipping between two triangles that share an edge.
//
// `strict` says whether a candidate is refused where pbrt's test refuses it
// -- outside the triangle by the edge signs, behind the ray or past tmax,
// or nearer than its error bound allows -- which is the test for a ray
// looking for a hit (triangle_hit). With it false only a degenerate triangle
// or a ray in its plane is refused, and the answer is where the ray meets
// the plane in the triangle's barycentrics: what the geometry of a hit the
// hardware already reported is read from (surface_geometry).
func [[inline]] triangle_test(ray : Ray, tmax : Float, tri : Triangle,
                              strict : bool) -> option[TriangleHit] {
    p0 = triangle_p(tri, 0u);
    p1 = triangle_p(tri, 1u);
    p2 = triangle_p(tri, 2u);

    // Degenerate triangles have no interior to hit.
    if (sqlen[[Float]](cross_(p2 - p0, p1 - p0)) == 0)
        return {};

    // Translate the vertices so the ray starts at the origin.
    p0t : mut = p0 - ray.o;
    p1t : mut = p1 - ray.o;
    p2t : mut = p2 - ray.o;

    // Permute so that the ray's dominant direction is z.
    kz : u32 = idxmax(abs(ray.d));
    kx = (kz + 1) % 3;
    ky = (kx + 1) % 3;
    d = permute(ray.d, {kx, ky, kz});
    p0t = permute(p0t, {kx, ky, kz});
    p1t = permute(p1t, {kx, ky, kz});
    p2t = permute(p2t, {kx, ky, kz});

    // Shear, so that the ray becomes +z and the edge tests are 2D.
    //
    // pbrt writes each of these as `p0t.x += Sx * p0t.z`, one statement, which
    // its compiler contracts into a single fused multiply-add. Written as the
    // fma here because the sheared coordinates are what the edge functions are
    // computed from, and an edge function one bit out is a barycentric one bit
    // out -- which is invisible in the distance to the hit and is not invisible
    // in the shading normal interpolated with it, nor in the frame a layered
    // BSDF hashes to seed its walk.
    Sx = -d.x / d.z;
    Sy = -d.y / d.z;
    Sz = 1 / d.z;
    p0t = vec3f{fma(Sx, p0t.z, p0t.x), fma(Sy, p0t.z, p0t.y), p0t.z};
    p1t = vec3f{fma(Sx, p1t.z, p1t.x), fma(Sy, p1t.z, p1t.y), p1t.z};
    p2t = vec3f{fma(Sx, p2t.z, p2t.x), fma(Sy, p2t.z, p2t.y), p2t.z};

    // Edge functions, by a difference of products that does not cancel.
    e0 = prod_diff[[Float]](p1t.x, p2t.y, p1t.y, p2t.x);
    e1 = prod_diff[[Float]](p2t.x, p0t.y, p2t.y, p0t.x);
    e2 = prod_diff[[Float]](p0t.x, p1t.y, p0t.y, p1t.x);

    // TODO: pbrt falls back to double precision when an edge function is
    // exactly zero, which is where a ray meets a shared edge.

    if (strict && (e0 < 0 || e1 < 0 || e2 < 0) && (e0 > 0 || e1 > 0 || e2 > 0))
        return {};
    det = e0 + e1 + e2;
    if (det == 0)
        return {};

    p0t.z *= Sz;
    p1t.z *= Sz;
    p2t.z *= Sz;

    tScaled = e0 * p0t.z + e1 * p1t.z + e2 * p2t.z;
    if (strict && det < 0 && (tScaled >= 0 || tScaled < tmax * det))
        return {};
    else if (strict && det > 0 && (tScaled <= 0 || tScaled > tmax * det))
        return {};

    invDet = 1 / det;
    t = tScaled * invDet;

    // pbrt's bound on the error in t, so that a hit is only reported when it
    // is conservatively in front of the ray.
    maxZt = max(abs(vec3f{p0t.z, p1t.z, p2t.z}));
    deltaZ = gamma(3) * maxZt;
    maxXt = max(abs(vec3f{p0t.x, p1t.x, p2t.x}));
    maxYt = max(abs(vec3f{p0t.y, p1t.y, p2t.y}));
    deltaX = gamma(5) * (maxXt + maxZt);
    deltaY = gamma(5) * (maxYt + maxZt);
    deltaE = 2 * (gamma(2) * maxXt * maxYt + deltaY * maxXt + deltaX * maxYt);
    maxE = max(abs(vec3f{e0, e1, e2}));
    deltaT = 3 * (gamma(3) * maxE * maxZt + deltaE * maxZt + deltaZ * maxE) * abs(invDet);
    if (strict && t <= deltaT)
        return {};

    hit : TriangleHit = {t, vec3f{e0 * invDet, e1 * invDet, e2 * invDet}};
    return hit;
}

// pbrt: IntersectTriangle as a ray asks it, every refusal in force.
func triangle_hit(ray : Ray, tmax : Float, tri : Triangle) -> option[TriangleHit] =
    triangle_test(ray, tmax, tri, true);

// The distance alone, which is all the tree query needs.
func triangle_t(ray : Ray, tmax : Float, tri : Triangle) -> option[Float] {
    hit = triangle_hit(ray, tmax, tri);
    if hit {
        return (*hit).t;
    }
    return {};
}

// A triangle is flat, so the near and far distance to it are the same one.
func distmin(q : RaySegment, tri : Triangle) -> Float {
    t = triangle_t(q.ray, q.tmax, tri);
    if t {
        return *t;
    }
    return inf;
}

func distmax(q : RaySegment, tri : Triangle) -> Float {
    t = triangle_t(q.ray, q.tmax, tri);
    if t {
        return *t;
    }
    return -inf;
}

func intersects(q : RaySegment, tri : Triangle) -> bool {
    return cast[[bool]](triangle_t(q.ray, q.tmax, tri));
}

// pbrt: Disk -- a flat annulus, or a sector of one, in the plane z = height of
// an object space of its own, placed in the scene by a transform, as pbrt's
// every quadric is. The sphere above is admitted by scene_dump only under a
// translation and kept in render space by its centre; a disk is oriented, so
// its transform comes with it, both ways round: a ray is pulled into object
// space by `object_from_render` and the hit is pushed out by
// `render_from_object`, which is pbrt's `(*objectFromRender)(ray)` and
// `(*renderFromObject)(SurfaceInteraction(...))`, and the same two functions
// an instance's tree is entered and left by.
//
// Two flags, because pbrt has two and uses them in different places. `flip` is
// reverseOrientation ^ transformSwapsHandedness, which
// InteractionFromIntersection turns a *hit's* normal by; `reverse` is
// reverseOrientation alone, which `Sample` turns a *sampled* point's normal
// by. Under a transform that mirrors, the two differ, and both are pbrt's.
// `phi_max` is in radians, clamped to a turn, as the constructor leaves it.
element Disk {
    render_from_object : Transform;
    object_from_render : Transform;
    height : Float;
    radius : Float;
    inner_radius : Float;
    phi_max : Float;
    flip : bool;
    reverse : bool;
}

// pbrt: QuadricIntersection, as a disk fills it: the distance along the ray,
// the hit in object space, and its azimuth about the disk's axis.
element DiskHit {
    t : Float;
    p_obj : vec3f;
    phi : Float;
}

// pbrt: Transform::ApplyInverse(const Ray &, Float *tMax), the top of
// TransformedPrimitive::Intersect: the ray moved into the instance's frame, so
// that everything inside the instance's tree is tested against stored
// geometry. `inv` is the inverse matrix, so applying it is `ApplyInverse`.
// (A quadric's `objectFromRender` is applied to a ray by pbrt's
// `operator()(Point3fi)`, which computes the point in these same plain
// floats, paired as below, and then reads it back as the midpoint of the
// interval it wrapped it in -- an ulp apart now and then, so the quadrics
// take row_point_interval and `mid` instead: sphere_roots, disk_hit,
// cylinder_roots.)
//
// The origin is a point and goes through the interval-point arithmetic pbrt
// uses for it -- `(m00 x + m01 y) + (m02 z + m03)`, paired that way -- and the
// direction is a vector, through the same rows without the translation. The
// direction is *not* renormalised, on purpose and as in pbrt: an affine map
// preserves the parameter along a line only when the direction is transformed
// rather than rescaled, and it is that parameter -- the `t` of a hit -- that
// `distmin` answers and that the running best is compared against. Renormalise
// and an instance could no longer prune against a hit found in another one.
//
// pbrt then nudges the origin forward by its rounding error, `o += d * dt`, and
// takes the same `dt` off `tMax` so that the two sides still agree about where
// the best hit so far is. That is not done here. The nudge is against a ray
// re-hitting the surface its origin was rounded onto, which this renderer
// guards with pbrt's own SpawnRay offset, applied in render space before the
// ray reaches any instance; and `tMax` is not a field
// of the query here but the traversal's accumulator, which nothing inside a
// query may alter (see PLAN.md). Without the nudge the identity the whole
// arrangement rests on -- a distance along the pulled ray *is* the distance
// along the original -- holds exactly rather than up to `dt`, and the hit point
// differs from pbrt's by that `dt`: a few units in the last place.
func pull_ray(inv : Transform, r : Ray) -> Ray {
    o = vec3f{fma(inv.r0.y, r.o.y, inv.r0.x * r.o.x) + fma(inv.r0.z, r.o.z, inv.r0.w),
              fma(inv.r1.y, r.o.y, inv.r1.x * r.o.x) + fma(inv.r1.z, r.o.z, inv.r1.w),
              fma(inv.r2.y, r.o.y, inv.r2.x * r.o.x) + fma(inv.r2.z, r.o.z, inv.r2.w)};
    wp = fma(inv.r3.y, r.o.y, inv.r3.x * r.o.x) + fma(inv.r3.z, r.o.z, inv.r3.w);
    out : Ray = {select(wp == 1.0, o, o / wp), apply_vector(inv, r.d)};
    return out;
}

// pbrt: Disk::BasicIntersect. The ray in object space, where the disk is the
// plane z = height: the distance to the plane, the point there, and whether
// it lies between the radii and within phi_max. A ray parallel to the plane
// misses, whatever its origin.
//
// The ray goes into object space as the sphere's does (sphere_roots): pbrt
// transforms `Point3fi(r.o)` and `Vector3fi(r.d)` and reads `Float(di.z)`,
// `Point3f(oi)` and `Vector3f(di)` off the intervals, which is their
// midpoint -- the plain transform's value to within an ulp and not always
// exactly it, since the interval is [next_down(v - err), next_up(v + err)]
// and its midpoint rounds on its own. The disk took the plain transform
// (pull_ray) until a coated disk's albedo disagreed with pbrt's on 177
// pixels: a layered BSDF's walk is seeded by hashing the direction in a
// frame the hit point decides, and an ulp of the hit point is another walk.
func disk_hit(r : Ray, tmax : Float, d : Disk) -> option[DiskHit] {
    inv = d.object_from_render;
    oi = vec3f{mid(row_point_interval(inv.r0, r.o)),
               mid(row_point_interval(inv.r1, r.o)),
               mid(row_point_interval(inv.r2, r.o))};
    di = vec3f{mid(row_vector_interval(inv.r0, r.d)),
               mid(row_vector_interval(inv.r1, r.d)),
               mid(row_vector_interval(inv.r2, r.d))};
    if di.z == 0.0 {
        return {};
    }
    t = (d.height - oi.z) / di.z;
    if (t <= 0.0) | (t >= tmax) {
        return {};
    }
    p = oi + t * di;
    dist2 = sqr(p.x) + sqr(p.y);
    if (dist2 > sqr(d.radius)) | (dist2 < sqr(d.inner_radius)) {
        return {};
    }
    phi0 = atan2(p.y, p.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    if phi > d.phi_max {
        return {};
    }
    hit : DiskHit = {t, p, phi};
    return hit;
}

// pbrt: Cylinder -- the surface x^2 + y^2 = r^2 of its object space between
// z_min and z_max, through phi_max of a turn about the z axis, kept in object
// space under both matrices as every quadric here is. The constructor's
// normalizations (z_min the lesser of the two heights given, phi_max in
// radians clamped to a turn) are the converter's. `flip` and `reverse` as
// the Sphere's: a hit's normal is turned by the first, a sampled point's by
// the second.
element Cylinder {
    render_from_object : Transform;
    object_from_render : Transform;
    radius : Float;
    z_min : Float;
    z_max : Float;
    phi_max : Float;
    flip : bool = false;
    reverse : bool = false;
}

// pbrt: QuadricIntersection, as a cylinder fills it: the distance along the
// ray, the hit in object space, and its azimuth about the cylinder's axis.
element CylinderHit {
    t : Float;
    p_obj : vec3f;
    phi : Float;
}

// pbrt: Cylinder::BasicIntersect's quadratic, in the interval arithmetic
// sphere_roots carries the sphere's in and for the same reasons: the
// cylinder is the circle swept along z, so the quadratic is in the ray's x
// and y alone and the discriminant is factored about the distance from the
// axis to the ray's closest approach *in the plane* -- `4a (r + |v|) (r -
// |v|)` with v two-dimensional, grouped as pbrt groups it. A ray along the
// axis has a = 0: pbrt's interval division by an interval that straddles
// zero is everything (idiv), the roots' bounds are infinite, and the range
// test in cylinder_hit refuses them -- such a ray misses, as pbrt's does.
func cylinder_roots(r : Ray, cyl : Cylinder) -> option[Roots] {
    inv = cyl.object_from_render;
    oix = row_point_interval(inv.r0, r.o);
    oiy = row_point_interval(inv.r1, r.o);
    oiz = row_point_interval(inv.r2, r.o);
    dix = row_vector_interval(inv.r0, r.d);
    diy = row_vector_interval(inv.r1, r.d);
    diz = row_vector_interval(inv.r2, r.d);

    a = iadd(isqr(dix), isqr(diy));
    b = imulf(2.0, iadd(imul(dix, oix), imul(diy, oiy)));
    c = isub(iadd(isqr(oix), isqr(oiy)), isqr(exact(cyl.radius)));

    half = idiv(b, imulf(2.0, a));
    vx = isub(oix, imul(half, dix));
    vy = isub(oiy, imul(half, diy));
    length = isqrt(iadd(isqr(vx), isqr(vy)));

    radius = exact(cyl.radius);
    discrim = imul(imul(imulf(4.0, a), iadd(radius, length)),
                   isub(radius, length));
    if discrim.low < 0.0 {
        return {};
    }

    root_discrim = isqrt(discrim);
    q : mut = imulf(-0.5, iadd(b, root_discrim));
    if mid(b) < 0.0 {
        q = imulf(-0.5, isub(b, root_discrim));
    }

    t0 : mut = idiv(q, a);
    t1 : mut = idiv(c, q);
    if t0.low > t1.low {
        swap = t0;
        t0 = t1;
        t1 = swap;
    }

    roots : Roots = {t0, t1, vec3f{mid(oix), mid(oiy), mid(oiz)},
                     vec3f{mid(dix), mid(diy), mid(diz)}};
    return roots;
}

// pbrt: the hit point a root gives, `Point3f(oi) + t * Vector3f(di)`, its x
// and y refined onto the cylinder's radius (`hitRad` is the distance from
// the axis the quadratic's t put it at), and its azimuth. No nudge off the
// axis as the sphere has: a point on the cylinder is never on it.
func cylinder_point(cyl : Cylinder, o : vec3f, d : vec3f, t : Float) -> CylinderHit {
    raw = o + t * d;
    hit_rad = sqrt(sqr(raw.x) + sqr(raw.y));
    p = vec3f{raw.x * (cyl.radius / hit_rad), raw.y * (cyl.radius / hit_rad),
              raw.z};
    phi0 = atan2(p.y, p.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    hit : CylinderHit = {t, p, phi};
    return hit;
}

// pbrt: `pHit.z < zMin || pHit.z > zMax || phi > phiMax`, the clipping that
// makes a partial cylinder; unlike the sphere's, both heights always apply.
func cylinder_clipped(cyl : Cylinder, h : CylinderHit) -> bool =
    (h.p_obj.z < cyl.z_min) | (h.p_obj.z > cyl.z_max) | (h.phi > cyl.phi_max);

// pbrt: the tail of Cylinder::BasicIntersect, which is the sphere's
// (sphere_hit) over the cylinder's roots and clipping: the nearer root that
// is ahead of the ray and within tmax, the farther where the clipping takes
// the nearer away, every range test on a bound so that a root is refused
// only when it is certainly out of range.
func cylinder_hit(r : Ray, tmax : Float, cyl : Cylinder) -> option[CylinderHit] {
    found = cylinder_roots(r, cyl);
    if !found {
        return {};
    }
    roots = *found;
    if (roots.t0.high > tmax) | (roots.t1.low <= 0.0) {
        return {};
    }
    near : mut Interval = roots.t0;
    took_far : mut bool = false;
    if roots.t0.low <= 0.0 {
        if roots.t1.high > tmax {
            return {};
        }
        near = roots.t1;
        took_far = true;
    }
    first = cylinder_point(cyl, roots.o, roots.d, mid(near));
    if !cylinder_clipped(cyl, first) {
        return first;
    }
    if took_far | (roots.t1.high > tmax) {
        return {};
    }
    second = cylinder_point(cyl, roots.o, roots.d, mid(roots.t1));
    if cylinder_clipped(cyl, second) {
        return {};
    }
    return second;
}

// pbrt: CurveCommon -- what every segment of one `Shape "curve"` shares: the
// cubic Bezier's four control points in object space (a quadratic or a
// b-spline converted by the converter as Curve::Create converts them), the
// widths at its two ends, a ribbon's two normals with the angle between
// them and 1 / sin of it, which kind (0 flat, 1 cylinder, 2 ribbon), and
// which CurveFrame places it. One `curve_commons` entry per curve segment
// of the scene's directive, and a `Crv` shape per split of it into
// 2^splitdepth, as pbrt's CreateCurve makes them.
element CurveCommon {
    p0, p1, p2, p3 : vec3f;
    width0, width1 : Float;
    n0, n1 : vec3f;
    normal_angle, inv_sin_normal_angle : Float;
    kind : i32;
    frame : u32;
}

// pbrt: the two transforms a CurveCommon points at and its two orientation
// flags (the Sphere's `flip` and `reverse`) -- bunny-fur's million and a
// half curves share one, so it is a pool of its own that a common names.
element CurveFrame {
    render_from_object : Transform;
    object_from_render : Transform;
    flip : bool;
    reverse : bool;
}

extern curve_commons : array[CurveCommon];
extern curve_frames : array[CurveFrame];

// pbrt: Curve -- one segment of a curve, [u_min, u_max] of its common's
// parameter.
element Curve {
    common : u32;
    u_min, u_max : Float;
}

// Four control points: a cubic Bezier in some space.
element Bezier {
    c0, c1, c2, c3 : vec3f;
}

// pbrt: EvaluateCubicBezier(cp, u, &deriv)'s two answers.
element BezierPoint {
    p : vec3f;
    dpdu : vec3f;
}

// pbrt: what a curve hit records -- the distance along the ray (`pc.z /
// rayLength`), the parameter u along the common's curve and v across its
// width, and the width there.
element CurveHit {
    t : Float;
    u, v : Float;
    hit_width : Float;
}

// pbrt: Lerp(t, p0, p1) on points, `(1 - t) * p0 + t * p1` per component.
// pbrt: Lerp(t, Point3f, Point3f), `(1 - t) * t0 + t * t1`, as gcc compiles
// it in BlossomCubicBezier and in Curve::RecursiveIntersect's
// EvaluateCubicBezier: the *second* product fused into the first (found by
// fitting the two forms to pbrt's hit distances over the curve scene's
// camera rays, 667 of them; the first-fused form, which Contract.h would
// write, misses on a third of them). lerp_st below, the scalar Lerp of the
// same leaf, fuses the first as Contract.h does -- the choice is gcc's per
// site, and these are the two it made.
func lerp_p(t : Float, a : vec3f, b : vec3f) -> vec3f = fma3(t, b, (1.0 - t) * a);

// pbrt: BlossomCubicBezier -- the blossom of the cubic at (u0, u1, u2), of
// which the control points of a sub-range and the point at a parameter are
// special cases (util/splines.h).
func blossom(c : CurveCommon, u0 : Float, u1 : Float, u2 : Float) -> vec3f {
    a0 = lerp_p(u0, c.p0, c.p1);
    a1 = lerp_p(u0, c.p1, c.p2);
    a2 = lerp_p(u0, c.p2, c.p3);
    b0 = lerp_p(u1, a0, a1);
    b1 = lerp_p(u1, a1, a2);
    return lerp_p(u2, b0, b1);
}

// pbrt: CubicBezierControlPoints -- the segment's own control points from
// its common's, by blossoming at the range's ends.
func bezier_segment(c : CurveCommon, u_min : Float, u_max : Float) -> Bezier {
    b : Bezier = {blossom(c, u_min, u_min, u_min), blossom(c, u_min, u_min, u_max),
                  blossom(c, u_min, u_max, u_max), blossom(c, u_max, u_max, u_max)};
    return b;
}

// pbrt: EvaluateCubicBezier(cp, u, &deriv) -- the point by de Casteljau
// and the derivative from the last two points, three times their
// difference, or the chord where those coincide.
func bezier_at(b : Bezier, u : Float) -> BezierPoint {
    cp10 = lerp_p(u, b.c0, b.c1);
    cp11 = lerp_p(u, b.c1, b.c2);
    cp12 = lerp_p(u, b.c2, b.c3);
    cp20 = lerp_p(u, cp10, cp11);
    cp21 = lerp_p(u, cp11, cp12);
    d = cp21 - cp20;
    deriv = select(sqlen_(d) > 0.0, 3.0 * d, b.c3 - b.c0);
    r : BezierPoint = {lerp_p(u, cp20, cp21), deriv};
    return r;
}

// pbrt: SubdivideCubicBezier, the half asked for: the first four of its
// seven points for the left half, the last four for the right.
func bezier_half(b : Bezier, right : bool) -> Bezier {
    m0 = (b.c0 + b.c1) / 2.0;
    m1 = (b.c0 + 2.0 * b.c1 + b.c2) / 4.0;
    m2 = (b.c0 + 3.0 * b.c1 + 3.0 * b.c2 + b.c3) / 8.0;
    m3 = (b.c1 + 2.0 * b.c2 + b.c3) / 4.0;
    m4 = (b.c2 + b.c3) / 2.0;
    if right {
        rgt : Bezier = {m2, m3, m4, b.c3};
        return rgt;
    }
    left : Bezier = {b.c0, m0, m1, m2};
    return left;
}

// pbrt: Transform::operator()(const Ray &) -- how a curve's ray reaches its
// object space, and not pull_ray's plain arithmetic: the origin goes as an
// interval (row_point_interval, unfused as pbrt's is), the direction as the
// plain vector, and then the origin is moved along the direction by as far
// as its error could have left it short of the surface -- `dt = Dot(Abs(d),
// o.Error()) / LengthSquared(d); o += d * dt` -- the interval shifted end
// by end with pbrt's outward rounding and its midpoint read. The quadrics
// take ApplyInverse's cousin without the nudge (pull_ray's note); the curve
// takes this one because pbrt's Curve::IntersectRay does, and every leaf
// test below is in the nudged ray's own coordinates.
func curve_ray(inv : Transform, r : Ray) -> Ray {
    ox = row_point_interval(inv.r0, r.o);
    oy = row_point_interval(inv.r1, r.o);
    oz = row_point_interval(inv.r2, r.o);
    d = apply_vector(inv, r.d);
    len2 = sqlen_(d);
    o : mut vec3f = vec3f{mid(ox), mid(oy), mid(oz)};
    if len2 > 0.0 {
        err = vec3f{(ox.high - ox.low) / 2.0, (oy.high - oy.low) / 2.0,
                    (oz.high - oz.low) / 2.0};
        dt = dot_(abs(d), err) / len2;
        shift = d * dt;
        o = vec3f{0.5 * (add_round_down(ox.low, shift.x) + add_round_up(ox.high, shift.x)),
                  0.5 * (add_round_down(oy.low, shift.y) + add_round_up(oy.high, shift.y)),
                  0.5 * (add_round_down(oz.low, shift.z) + add_round_up(oz.high, shift.z))};
    }
    out : Ray = {o, d};
    return out;
}

// pbrt: a 4x4 matrix as SquareMatrix<4> holds it (rows), and the pair that
// holds a compensated float (CompensatedFloat: a value and its error).
element Mat4 {
    r0, r1, r2, r3 : vec4f;
}
element Comp {
    v, err : Float;
}

// pbrt: TwoProd and TwoSum, and InnerProduct over products two at a time:
// `TwoProd(a, b)`, then the recursion `sum = TwoSum(ab.v, tp.v); {sum.v,
// ab.err + (tp.err + sum.err)}`, read back as `v + err`.
func two_prod(a : Float, b : Float) -> Comp {
    ab = a * b;
    c : Comp = {ab, fma(a, b, -ab)};
    return c;
}

func two_sum(a : Float, b : Float) -> Comp {
    s = a + b;
    delta = s - a;
    c : Comp = {s, (a - (s - delta)) + (b - delta)};
    return c;
}

func inner_chain(ab : Comp, tp : Comp) -> Comp {
    // `tot`: `sum` is the reduction builtin.
    tot = two_sum(ab.v, tp.v);
    c : Comp = {tot.v, ab.err + (tp.err + tot.err)};
    return c;
}

func inner3(a : Float, b : Float, c : Float, d : Float, e : Float, f : Float) -> Float {
    r = inner_chain(two_prod(a, b), inner_chain(two_prod(c, d), two_prod(e, f)));
    return r.v + r.err;
}

func inner6(a0 : Float, b0 : Float, a1 : Float, b1 : Float, a2 : Float, b2 : Float,
            a3 : Float, b3 : Float, a4 : Float, b4 : Float, a5 : Float, b5 : Float) -> Float {
    r = inner_chain(two_prod(a0, b0),
                    inner_chain(two_prod(a1, b1),
                                inner_chain(two_prod(a2, b2),
                                            inner_chain(two_prod(a3, b3),
                                                        inner_chain(two_prod(a4, b4),
                                                                    two_prod(a5, b5))))));
    return r.v + r.err;
}

// pbrt: Inverse(const SquareMatrix<4> &) -- the cofactor form that shares
// its sub-determinants (Eberly's Laplace expansion, as pbrt credits ion's
// matrixutils), every difference of products compensated and every inner
// product summed with its error terms, then the reciprocal of the
// determinant times each. Written out because LookAt's matrix goes through
// it in pbrt (InvertOrExit) and the curve's ray space is that matrix, so
// the control points land where pbrt's land only if the inverse is pbrt's
// to the bit.
func inverse4(m : Mat4) -> Mat4 {
    s0 = prod_diff[[Float]](m.r0.x, m.r1.y, m.r1.x, m.r0.y);
    s1 = prod_diff[[Float]](m.r0.x, m.r1.z, m.r1.x, m.r0.z);
    s2 = prod_diff[[Float]](m.r0.x, m.r1.w, m.r1.x, m.r0.w);
    s3 = prod_diff[[Float]](m.r0.y, m.r1.z, m.r1.y, m.r0.z);
    s4 = prod_diff[[Float]](m.r0.y, m.r1.w, m.r1.y, m.r0.w);
    s5 = prod_diff[[Float]](m.r0.z, m.r1.w, m.r1.z, m.r0.w);
    c0 = prod_diff[[Float]](m.r2.x, m.r3.y, m.r3.x, m.r2.y);
    c1 = prod_diff[[Float]](m.r2.x, m.r3.z, m.r3.x, m.r2.z);
    c2 = prod_diff[[Float]](m.r2.x, m.r3.w, m.r3.x, m.r2.w);
    c3 = prod_diff[[Float]](m.r2.y, m.r3.z, m.r3.y, m.r2.z);
    c4 = prod_diff[[Float]](m.r2.y, m.r3.w, m.r3.y, m.r2.w);
    c5 = prod_diff[[Float]](m.r2.z, m.r3.w, m.r3.z, m.r2.w);
    det = inner6(s0, c5, -s1, c4, s2, c3, s3, c2, s5, c0, -s4, c1);
    s = 1.0 / det;
    out : Mat4 = {
        vec4f{s * inner3(m.r1.y, c5, m.r1.w, c3, -m.r1.z, c4),
              s * inner3(-m.r0.y, c5, m.r0.z, c4, -m.r0.w, c3),
              s * inner3(m.r3.y, s5, m.r3.w, s3, -m.r3.z, s4),
              s * inner3(-m.r2.y, s5, m.r2.z, s4, -m.r2.w, s3)},
        vec4f{s * inner3(-m.r1.x, c5, m.r1.z, c2, -m.r1.w, c1),
              s * inner3(m.r0.x, c5, m.r0.w, c1, -m.r0.z, c2),
              s * inner3(-m.r3.x, s5, m.r3.z, s2, -m.r3.w, s1),
              s * inner3(m.r2.x, s5, m.r2.w, s1, -m.r2.z, s2)},
        vec4f{s * inner3(m.r1.x, c4, m.r1.w, c0, -m.r1.y, c2),
              s * inner3(-m.r0.x, c4, m.r0.y, c2, -m.r0.w, c0),
              s * inner3(m.r3.x, s4, m.r3.w, s0, -m.r3.y, s2),
              s * inner3(-m.r2.x, s4, m.r2.y, s2, -m.r2.w, s0)},
        vec4f{s * inner3(-m.r1.x, c3, m.r1.y, c1, -m.r1.z, c0),
              s * inner3(m.r0.x, c3, m.r0.z, c0, -m.r0.y, c1),
              s * inner3(-m.r3.x, s3, m.r3.y, s1, -m.r3.z, s0),
              s * inner3(m.r2.x, s3, m.r2.z, s0, -m.r2.y, s1)}};
    return out;
}

// pbrt: LookAt(pos, look, up) -- the camera-to-world matrix by columns
// (right, newUp, dir, pos) and its inverse by inverse4; the curve's ray
// space, `LookAt(ray.o, ray.o + ray.d, dx)`, in which the ray runs up z
// from the origin. Both come back as Transforms: pbrt's `rayFromObject` (its
// m, the computed inverse) and that transform's inverse (the constructed
// matrix), which `Inverse(rayFromObject)` is.
element RaySpace {
    ray_from_object : Transform;
    object_from_ray : Transform;
}

func look_at(pos : vec3f, look : vec3f, up : vec3f) -> RaySpace {
    dir = unit_vector_(look - pos);
    right = unit_vector_(cross_(unit_vector_(up), dir));
    new_up = cross_(dir, right);
    world_from_camera : Mat4 = {vec4f{right.x, new_up.x, dir.x, pos.x},
                                vec4f{right.y, new_up.y, dir.y, pos.y},
                                vec4f{right.z, new_up.z, dir.z, pos.z},
                                vec4f{0.0, 0.0, 0.0, 1.0}};
    camera_from_world = inverse4(world_from_camera);
    rs : RaySpace = {Transform{camera_from_world.r0, camera_from_world.r1,
                               camera_from_world.r2, camera_from_world.r3},
                     Transform{world_from_camera.r0, world_from_camera.r1,
                               world_from_camera.r2, world_from_camera.r3}};
    return rs;
}

// pbrt: Transform::operator()(Point3f) as gcc compiled it in
// Curve::IntersectRay, for the control points into ray space: each row
// `m0 x + m1 y + m2 z + m3` with the *first* product fused into the inner
// sum -- the form apply_row_vector has -- where apply_point (apply_row)
// fuses the second, which is what the camera's instance of the same
// function does. Fitted over the curve scene's camera rays as lerp_p's
// form was: the second-fused rows miss pbrt's distance on 142 more of 667.
func curve_point(t : Transform, p : vec3f) -> vec3f {
    xp = apply_row_vector(t.r0, p) + t.r0.w;
    yp = apply_row_vector(t.r1, p) + t.r1.w;
    zp = apply_row_vector(t.r2, p) + t.r2.w;
    wp = apply_row_vector(t.r3, p) + t.r3.w;
    v = vec3f{xp, yp, zp};
    return select(wp == 1.0, v, v / wp);
}

// The curve's ray space for a ray already in object space: pbrt's `dx =
// Cross(ray.d, cpObj[3] - cpObj[0])`, or a frame about the direction where
// the chord lies along it, and LookAt from the origin along the direction
// with that as "up".
func curve_ray_space(ray : Ray, cp_obj : Bezier) -> RaySpace {
    dx0 = cross_(ray.d, cp_obj.c3 - cp_obj.c0);
    dx : mut vec3f = dx0;
    if sqlen_(dx0) == 0.0 {
        made = coordinate_system(ray.d);
        dx = made.x;
    }
    return look_at(ray.o, ray.o + ray.d, dx);
}

// pbrt: Bounds3f(p1, p2) and Union(Bounds3f(c0, c1), Bounds3f(c2, c3)) --
// the box around four control points, which bounds the Bezier they
// control -- expanded by half the width, and `Overlaps` with the ray's own
// box, the z axis from 0 to its length times tMax. The test pbrt makes of a
// segment at the root and at every node of the recursion.
func curve_box_overlaps(b : Bezier, half_width : Float, z_max : Float) -> bool {
    lo = min(min(b.c0, b.c1), min(b.c2, b.c3)) - half_width;
    hi = max(max(b.c0, b.c1), max(b.c2, b.c3)) + half_width;
    // rayBounds is (0, 0, 0)..(0, 0, z_max); Overlaps is each axis's
    // `b1.pMax >= b2.pMin && b1.pMin <= b2.pMax`.
    return (z_max >= lo.z) & (0.0 <= hi.z) & (0.0 >= lo.x) & (0.0 <= hi.x) &
           (0.0 >= lo.y) & (0.0 <= hi.y);
}

// pbrt: Log2Int(float) -- the exponent, plus one where the significand is
// past the midpoint of the octave (round to nearest in log space), and the
// reciprocal's negated below one.
func log2_int(v_in : Float) -> i32 {
    // pbrt recurses once for `v < 1`, `-Log2Int(1 / v)`; the reciprocal is
    // at least one, so it is one step, written flat here.
    below = v_in < 1.0;
    v = select(below, 1.0 / v_in, v_in);
    bits = reinterpret[[u32]](v);
    exponent = cast[[i32]](bits >> 23u) - 127;
    significand = bits & 0x7FFFFFu;
    l = exponent + select(significand >= 0x3504F3u, 1, 0);
    return select(below, -l, l);
}

// pbrt: the ribbon's normal at u -- the two end normals blended by sines
// (a slerp), or the first where the two agree.
func ribbon_normal(c : CurveCommon, u : Float) -> vec3f {
    if c.normal_angle == 0.0 {
        return c.n0;
    }
    sin0 = sin((1.0 - u) * c.normal_angle) * c.inv_sin_normal_angle;
    sin1 = sin(u * c.normal_angle) * c.inv_sin_normal_angle;
    return sin0 * c.n0 + sin1 * c.n1;
}

// pbrt: the leaf of Curve::RecursiveIntersect -- the segment `b` in ray
// space (the ray up z from the origin), its u range, and whether the ray's
// point lies on the curve's width there: behind neither tangent
// perpendicular at the ends, the closest point on the chord (w), the width
// at the curve's u there (a ribbon's scaled by how edge-on it is to the
// ray), the distance from the curve point at w against half the width,
// and the depth along the ray within tMax. v is which side of the curve's
// tangent the point is, by the edge function.
func curve_leaf(c : CurveCommon, ray : Ray, ray_length : Float, tmax : Float,
                b : Bezier, u0 : Float, u1 : Float) -> option[CurveHit] {
    // pbrt: `(cp[1].y - cp[0].y) * -cp[0].y + cp[0].x * (cp[0].x - cp[1].x)`,
    // which gcc fuses with the *second* product into the first (measured;
    // Contract.h's choice is the other one, so the fma is written out). The
    // sign is all that is read of it, so the form matters less than the
    // point lerps' (lerp_p) and the ray length's (curve_hit), which decide
    // the hit distance's last bits.
    edge0 = fma(b.c0.x, b.c0.x - b.c1.x, (b.c1.y - b.c0.y) * -b.c0.y);
    if edge0 < 0.0 {
        return {};
    }
    edge1 = fma(b.c3.x, b.c3.x - b.c2.x, (b.c2.y - b.c3.y) * -b.c3.y);
    if edge1 < 0.0 {
        return {};
    }
    seg_dir = vec2f{b.c3.x - b.c0.x, b.c3.y - b.c0.y};
    denom = sqr(seg_dir.x) + sqr(seg_dir.y);
    if denom == 0.0 {
        return {};
    }
    // pbrt: `Dot(-Vector2f(cp[0].x, cp[0].y), segmentDir)`, and a Vector2's
    // Dot is SumOfProducts, the compensated form.
    w = sum_of_products(-b.c0.x, seg_dir.x, -b.c0.y, seg_dir.y) / denom;
    u = min(max(lerp_st(w, u0, u1), u0), u1);
    hit_width : mut Float = lerp_st(u, c.width0, c.width1);
    if c.kind == 2 {
        n_hit = ribbon_normal(c, u);
        hit_width = hit_width * (abs(dot_(n_hit, ray.d)) / ray_length);
    }
    at = bezier_at(b, min(max(w, 0.0), 1.0));
    dist2 = sqr(at.p.x) + sqr(at.p.y);
    if dist2 > sqr(hit_width) * 0.25 {
        return {};
    }
    if (at.p.z < 0.0) | (at.p.z > ray_length * tmax) {
        return {};
    }
    dist = sqrt(dist2);
    edge_func = at.dpdu.x * -at.p.y + at.p.x * at.dpdu.y;
    v = select(edge_func > 0.0, 0.5 + dist / hit_width, 0.5 - dist / hit_width);
    hit : CurveHit = {at.p.z / ray_length, u, v, hit_width};
    return hit;
}

// pbrt: Curve::IntersectRay and RecursiveIntersect, as one function without
// the recursion. IntersectRay moves the ray into object space (curve_ray),
// takes the segment's own control points (bezier_segment), builds the ray
// space (curve_ray_space) and moves the control points into it, where the
// ray is the z axis; tests their box; and sets the refinement depth from
// the control polygon's curvature (L0, the largest second difference)
// against a twentieth of the width, log base 4 as half of Log2Int, clamped
// to [0, 10]. RecursiveIntersect then halves the Bezier maxDepth times,
// testing each half's box and leaving a half the ray's box misses, and
// tests the ray against the segment at the leaves (curve_leaf).
//
// pbrt's recursion is a depth-first walk of a binary tree of depth
// maxDepth, left half first, which is how the nearest of several hits is
// kept (`tHit > si->value().tHit` refuses a later farther one). This walks
// the same tree in the same order with the node named by the bits of the
// path from the root (`path`, one bit a level) and its depth, and
// recomputes the node's control points by replaying the halvings from the
// root -- the same SubdivideCubicBezier each time, so the same bits -- and
// its u range by the same midpoints, since the program has no arrays to
// keep a stack of them in. A node's box is tested as pbrt tests a child's
// before descending into it. Every hit is kept to the nearest, where
// pbrt's IntersectP leaves at the first; the answer is the same.
func curve_hit(r : Ray, tmax : Float, seg : Curve) -> option[CurveHit] {
    c = curve_commons[seg.common];
    frame = curve_frames[c.frame];
    ray = curve_ray(frame.object_from_render, r);
    cp_obj = bezier_segment(c, seg.u_min, seg.u_max);
    rs = curve_ray_space(ray, cp_obj);
    root : Bezier = {curve_point(rs.ray_from_object, cp_obj.c0),
                     curve_point(rs.ray_from_object, cp_obj.c1),
                     curve_point(rs.ray_from_object, cp_obj.c2),
                     curve_point(rs.ray_from_object, cp_obj.c3)};

    // pbrt: `Length(ray.d)` at the top of RecursiveIntersect, `Sqr(x) +
    // Sqr(y) + Sqr(z)` with the *second* square fused into the first where
    // gcc compiled it there (fitted as lerp_p's form was; sqlen_ fuses the
    // first, as pbrt's Transform::operator()(Ray) above does). The hit
    // distance is pc.z divided by this, so its last bit is the distance's.
    ray_length = sqrt(fma(ray.d.z, ray.d.z, fma(ray.d.y, ray.d.y, ray.d.x * ray.d.x)));
    z_max = ray_length * tmax;
    w_min = lerp_st(seg.u_min, c.width0, c.width1);
    w_max = lerp_st(seg.u_max, c.width0, c.width1);
    if !curve_box_overlaps(root, 0.5 * max(w_min, w_max), z_max) {
        return {};
    }

    d0 = abs(root.c0 - 2.0 * root.c1 + root.c2);
    d1 = abs(root.c1 - 2.0 * root.c2 + root.c3);
    l0 = max(max(max(d0.x, d0.y), d0.z), max(max(d1.x, d1.y), d1.z));
    max_depth : mut i32 = 0;
    if l0 > 0.0 {
        // `width_eps`: `eps` is a builtin. pbrt's "width / 20".
        width_eps = max(c.width0, c.width1) * 0.05;
        log4 = log2_int(1.41421356237 * 6.0 * l0 / (8.0 * width_eps)) / 2;
        max_depth = min(max(log4, 0), 10);
    }

    best : mut option[CurveHit] = {};
    depth : mut i32 = 0;
    path : mut u32 = 0u;
    done : mut bool = false;
    while !done {
        // The node's control points and u range, replayed from the root.
        b : mut Bezier = root;
        u0 : mut Float = seg.u_min;
        u1 : mut Float = seg.u_max;
        level : mut i32 = 0;
        while level < depth {
            right = ((path >> cast[[u32]](depth - 1 - level)) & 1u) != 0u;
            b = bezier_half(b, right);
            um = (u0 + u1) / 2.0;
            u0 = select(right, um, u0);
            u1 = select(right, u1, um);
            level = level + 1;
        }
        overlaps : mut bool = true;
        if depth > 0 {
            overlaps = curve_box_overlaps(
                b, 0.5 * max(lerp_st(u0, c.width0, c.width1),
                             lerp_st(u1, c.width0, c.width1)), z_max);
        }
        if overlaps & (depth < max_depth) {
            // Down into the left half.
            path = path << 1u;
            depth = depth + 1;
        } else {
            if overlaps {
                leaf = curve_leaf(c, ray, ray_length, tmax, b, u0, u1);
                if leaf {
                    if !best || ((*leaf).t <= (*best).t) {
                        best = leaf;
                    }
                }
            }
            // On: up past every right child, then to the right sibling.
            while (depth > 0) & ((path & 1u) != 0u) {
                path = path >> 1u;
                depth = depth - 1;
            }
            if depth == 0 {
                done = true;
            } else {
                path = path | 1u;
            }
        }
    }
    return best;
}

// pbrt: Shape, the closed set of things a ray can hit. v4 dispatches this
// through a TaggedPointer over Sphere, Triangle, and the rest; a variant type
// says the same thing without the pointer.
//
// The sphere and the triangle are in render space. PBRT keeps a transform per
// shape and works in object space, tracking error bounds through the round
// trip; the disk is the one shape here that does the same, since it is
// oriented and a translation cannot place it.
// pbrt: BilinearPatch -- a mesh index and a patch index, as a Triangle is, and
// the patch's area, which pbrt's constructor computes once (exactly for a
// rectangle, over a 3x3 subdivision for anything else) and which the driver
// computes the same way. The mesh is a `TriangleMesh` record whose indices
// run in fours -- pbrt's BilinearPatchMesh has the same fields -- in pbrt's
// vertex order: p00, p10, p01, p11.
//
// A patch is not two triangles unless it happens to be planar, which is why
// pbrt keeps the shape and why a PLY's quads come here rather than being
// split. `emissionfilename` (an image distribution over an emitting patch)
// is not carried: scene_dump refuses it. The functions are further down,
// after the disk's.
element BilinearPatch {
    mesh : u32;
    patch : u32;
    area : Float;
}

// The patch's records, declared with it since a type is known from its
// declaration on: pbrt's BilinearIntersection (the patch's (u, v) and the
// distance), the two roots of a quadratic, the differential areas at the
// four corners that weight a non-rectangular patch's area sampling, and a
// spherical rectangle's sample with its density.
element PatchHit {
    uv : vec2f;
    t : Float;
}
element QuadraticRoots {
    t0 : Float;
    t1 : Float;
}
element PatchWeights {
    w0, w1, w2, w3 : Float;
}
element SphericalRectangleSample {
    p : vec3f;
    pdf : Float;
}

element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle)
    | Dsk(d : Disk)
    | Blp(b : BilinearPatch)
    | Cyl(c : Cylinder)
    | Crv(cv : Curve);

// pbrt: Shape::Intersect and Shape::IntersectP, as one function each that
// matches on which shape it has. The tree the schedule builds calls these
// without knowing a shape has variants at all.
//
// These are the primitive queries, so the Sph arm goes to sphere_hit, pbrt's
// hit. The bounding-volume overloads above answer for AABB and are a separate
// question -- the node a shape is in, not the shape. A shape that is not hit
// is infinitely far, the same answer the triangle gives.
//
// `[[inline]]` on the three, because a traversal asks two of them of every
// candidate -- `intersects` as the filter, `distmin` as the argmin's key --
// and each is a `match` on the shape around one triangle test. As calls
// they are two functions with a `triangle_hit` apiece, and the tests stay
// two; copied into the traversal the two matches are one (Opt/
// JumpThreading.h) and the two tests one call (Opt/CSE.h), which is pbrt's
// count: `Triangle::Intersect` once per candidate, the closest kept.
func [[inline]] distmin(q : RaySegment, sh : Shape) -> Float {
    match sh {
        Sph(s) => {
            hit = sphere_hit(q.ray, q.tmax, s);
            if hit {
                return (*hit).t;
            }
            return inf;
        }
        Tri(t) => return distmin(q, t);
        Dsk(d) => {
            hit = disk_hit(q.ray, q.tmax, d);
            if hit {
                return (*hit).t;
            }
            return inf;
        }
        Blp(b) => {
            hit = patch_hit(q.ray, q.tmax, b);
            if hit {
                return (*hit).t;
            }
            return inf;
        }
        Cyl(c) => {
            hit = cylinder_hit(q.ray, q.tmax, c);
            if hit {
                return (*hit).t;
            }
            return inf;
        }
        Crv(cv) => {
            hit = curve_hit(q.ray, q.tmax, cv);
            if hit {
                return (*hit).t;
            }
            return inf;
        }
    }
}

func [[inline]] distmax(q : RaySegment, sh : Shape) -> Float {
    match sh {
        Sph(s) => {
            hit = sphere_hit(q.ray, q.tmax, s);
            if hit {
                return (*hit).t;
            }
            return -inf;
        }
        Tri(t) => return distmax(q, t);
        Dsk(d) => {
            hit = disk_hit(q.ray, q.tmax, d);
            if hit {
                return (*hit).t;
            }
            return -inf;
        }
        Blp(b) => {
            hit = patch_hit(q.ray, q.tmax, b);
            if hit {
                return (*hit).t;
            }
            return -inf;
        }
        Cyl(c) => {
            hit = cylinder_hit(q.ray, q.tmax, c);
            if hit {
                return (*hit).t;
            }
            return -inf;
        }
        Crv(cv) => {
            hit = curve_hit(q.ray, q.tmax, cv);
            if hit {
                return (*hit).t;
            }
            return -inf;
        }
    }
}

func [[inline]] intersects(q : RaySegment, sh : Shape) -> bool {
    match sh {
        Sph(s) => return cast[[bool]](sphere_hit(q.ray, q.tmax, s));
        Tri(t) => return intersects(q, t);
        Dsk(d) => return cast[[bool]](disk_hit(q.ray, q.tmax, d));
        Blp(b) => return cast[[bool]](patch_hit(q.ray, q.tmax, b));
        Cyl(c) => return cast[[bool]](cylinder_hit(q.ray, q.tmax, c));
        Crv(cv) => return cast[[bool]](curve_hit(q.ray, q.tmax, cv));
    }
}

// pbrt: what a SurfaceInteraction records about where a ray landed, minus
// everything the gbuffer does not read.
//
// Two normals, because pbrt has two and they answer different questions. `n` is
// the geometric one, which the winding of the surface decides and which the
// film records; `ns` is the shading one, which a mesh's interpolated vertex
// normals decide and which the BSDF is evaluated about. They are the same
// vector for a sphere and for a mesh with no normals of its own.
//
// `dpdus` is the surface's tangent at the hit, and it is here for one reason:
// it is the x axis of the frame a BSDF works in. For a diffuse surface that
// axis cancels out -- the reflectance is the same whichever way round the
// tangent points -- which is why nothing needed it until a layered BSDF turned
// up, whose random walk is seeded by hashing the direction it was asked about
// and so depends on the whole frame and not just its normal.
element SurfaceGeometry {
    n : vec3f;
    ns : vec3f;
    dpdus : vec3f;
    // The shading bitangent, the second axis of the frame `dpdus` is the first
    // of. pbrt's `shading` keeps both and only the first was needed here until
    // bump mapping turned up: a bump map rebuilds the shading frame from two
    // perturbed derivatives, so it needs the one it is perturbing.
    dpdvs : vec3f;
    // pbrt: SurfaceInteraction::uv, and the two partial derivatives of position
    // with respect to it.
    //
    // Nothing needed these until a texture did. A material's parameter can be a
    // texture rather than a number, and where it is, `uv` is where the surface
    // is being asked about -- so a hit that does not carry it can only have
    // constant materials. `dpdu` and `dpdv` are what turn a screen-space
    // footprint into a texture-space one, which is how a texture knows how wide
    // to filter.
    //
    // `dpdus` above is the *shading* tangent, orthogonalized against the
    // shading normal; `dpdu` here is the geometric one the parameterization
    // gives. pbrt keeps both for the same reason: a BSDF is evaluated in the
    // first and a texture is filtered in the second.
    uv : vec2f;
    dpdu : vec3f;
    dpdv : vec3f;
    // pbrt: SurfaceInteraction::shading.dndu and .dndv -- how the *shading*
    // normal turns as the surface is walked in u and in v.
    //
    // Only one thing reads them, and it is worth saying which: propagating ray
    // differentials through a specular bounce. A mirror reflects the
    // neighbouring rays of a differential into directions that depend on how
    // the normal is changing across the surface, not just on the normal at the
    // hit -- so a curved mirror widens or narrows the footprint, and these are
    // what says by how much. Everything else about shading uses the normal
    // itself.
    //
    // Zero for a mesh with no vertex normals, where the shading normal is the
    // face's and does not turn at all within the triangle.
    dndu : vec3f;
    dndv : vec3f;
    // pbrt: Point3fi, the hit point as an interval -- the position and a bound
    // on how far the arithmetic that produced it could have strayed.
    //
    // Carried because the next ray has to start off the surface it is leaving,
    // and how far off is exactly this. pbrt's `gamma(n)` is the relative error
    // a chain of n floating-point operations can accumulate, so the bound is a
    // property of how the hit was computed and differs per shape: five
    // operations for a sphere, seven for a barycentric interpolation.
    p : vec3f;
    p_error : vec3f;
}

// pbrt: Sphere::InteractionFromIntersection, and the SurfaceInteraction
// constructor and transform it ends in. The hit is in object space, where
// the sphere is at the origin (sphere_point refined it there); the
// parameterization is azimuth over phi_max for u and the angle down from
// the pole over the theta span for v; the normal is the cross product of the
// two partials, turned by `flip`; and the point leaves object space with
// pbrt's gamma(5) bound on it, through the same push a disk's hit takes.
func sphere_geometry(s : Sphere, hit : SphereHit) -> SurfaceGeometry {
    p = hit.p_obj;
    phi_max = s.phi_max;
    theta_span = s.theta_z_max - s.theta_z_min;
    u = hit.phi / phi_max;
    // `cos_t`/`sin_t`: `cos_theta` is bxdf.bonsai's spherical accessor.
    cos_t = p.z / s.radius;
    // pbrt: SafeACos, the arc cosine of a cosine that rounding may have pushed
    // a little outside the range it has to be in.
    theta = safe_acos(cos_t);
    v = (theta - s.theta_z_min) / theta_span;

    z_radius = sqrt(sqr(p.x) + sqr(p.y));
    // Not bxdf.bonsai's cos_phi, which is the same angle taken about the
    // shading normal rather than about the sphere's axis.
    phi_cos = p.x / z_radius;
    phi_sin = p.y / z_radius;
    dpdu = vec3f{-phi_max * p.y, phi_max * p.x, 0.0};
    // pbrt: `SafeSqrt(1 - Sqr(cosTheta))`, not the sine of the angle.
    sin_t = safe_sqrt(1.0 - sqr(cos_t));
    dpdv = theta_span * vec3f{p.z * phi_cos, p.z * phi_sin,
                              -s.radius * sin_t};

    // pbrt: the sphere's dndu and dndv, from the first and second fundamental
    // forms of the surface. The second derivatives of position say how the
    // tangent plane turns, and E/F/G with e/f/g resolve that into the two
    // directions the parameterization uses.
    d2pduu = -phi_max * phi_max * vec3f{p.x, p.y, 0.0};
    d2pduv = theta_span * p.z * phi_max * vec3f{-phi_sin, phi_cos, 0.0};
    d2pdvv = -sqr(theta_span) * vec3f{p.x, p.y, p.z};
    form_e = dot_(dpdu, dpdu);
    form_f = dot_(dpdu, dpdv);
    form_g = dot_(dpdv, dpdv);
    form_n = unit_vector_(cross_(dpdu, dpdv));
    coef_e = dot_(form_n, d2pduu);
    coef_f = dot_(form_n, d2pduv);
    coef_g = dot_(form_n, d2pdvv);
    egf2 = prod_diff[[Float]](form_e, form_g, form_f, form_f);
    inv_egf2 = select(egf2 == 0.0, 0.0, 1.0 / egf2);
    dndu = (coef_f * form_f - coef_e * form_g) * inv_egf2 * dpdu +
           (coef_e * form_f - coef_f * form_e) * inv_egf2 * dpdv;
    dndv = (coef_g * form_f - coef_f * form_g) * inv_egf2 * dpdu +
           (coef_f * form_f - coef_g * form_e) * inv_egf2 * dpdv;

    // pbrt: the SurfaceInteraction constructor, which takes the normal from
    // the partial derivatives rather than from the position.
    raw_n = unit_vector(cross_(dpdu, dpdv));
    n = select(s.flip, -raw_n, raw_n);
    // A sphere brings no vertex normals, so its shading geometry is its
    // geometry and the shading bitangent is the geometric one. pbrt: `pError
    // = gamma(5) * Abs(pHit)`, about the refined point in object space; the
    // transform grows it on the way out (push_point).
    g : SurfaceGeometry = {n, n, dpdu, dpdv, vec2f{u, v}, dpdu, dpdv, dndu, dndv,
                           p, gamma(5) * abs(p)};
    return push_surface(s.render_from_object, s.object_from_render, g);
}

// pbrt: one row of Transform::operator()(const Point3fi &), for a point known
// exactly. The value is pbrt's `(m0 x + m1 y) + (m2 z + m3)` -- a different
// association from the plain point transform's -- and the width is pbrt's
// gamma(3) bound over the four terms of the row. A camera ray's origin takes
// this into render space (camera.bonsai); a quadric's ray takes it into
// object space.
//
// The width is not one ulp. It is the gamma(3) bound over the terms of a
// matrix row -- three products and three sums, any of which may round -- and
// it is several times wider than a single step. That width is the whole game
// for a grazing ray at a sphere: it is what makes the discriminant's lower
// bound negative and the ray therefore a miss. Deriving the interval from the
// arithmetic actually performed here, rather than from the matrix pbrt
// performs it with, would give something narrower and so report hits that
// pbrt does not.
//
// Not fused, unlike the plain transforms (apply_row, apply_inverse_row): gcc
// fuses a product into its add only when nothing else reads the product
// (tree-ssa-math-opts.cc, convert_mult_to_fma, which gives up on a
// multiplication with a use it cannot convert), and here every product is
// read again by the error term's `std::abs`. So pbrt's interval point is the
// three roundings of `(m0 x + m1 y) + (m2 z + m3)`, where its plain point is
// the two of the fused form -- the two differ in the last bit now and then,
// and a hit distance found from the interval's midpoint differed from pbrt's
// on 59 of 7,600 disk hits (check_hits.sh) until this was written as pbrt
// compiles it. `--ffp-contract` leaves this alone for the same reason gcc
// does: the products have another use (SSA/Contract.h).
func row_point_interval(row : vec4f, p : vec3f) -> Interval {
    px = row.x * p.x;
    py = row.y * p.y;
    pz = row.z * p.z;
    v = (px + py) + (pz + row.w);
    err = gamma(3) * (((abs(px) + abs(py)) + abs(pz)) + abs(row.w));
    return from_value_and_error(v, err);
}

// pbrt: one row of Transform::operator()(const Vector3fi &), for a vector
// known exactly: the vector transform's expression, unfused as above since
// the error term reads every product, and gamma(3) over the three products
// as its width.
func row_vector_interval(row : vec4f, v : vec3f) -> Interval {
    vx = row.x * v.x;
    vy = row.y * v.y;
    vz = row.z * v.z;
    value = (vx + vy) + vz;
    err = gamma(3) * ((abs(vx) + abs(vy)) + abs(vz));
    return from_value_and_error(value, err);
}

// pbrt: Point3fi -- a point and the bound on how far the arithmetic that made
// it could have strayed.
element BoundedPoint {
    p : vec3f;
    error : vec3f;
}

// pbrt: Transform::operator()(const Point3fi &): the point by the matrix, in
// the association pbrt's interval-point arithmetic pairs it -- `(m00 x + m01 y)
// + (m02 z + m03)` -- and its error grown the way pbrt grows it: the incoming
// error scaled by the matrix's magnitudes, plus the transform's own rounding.
// With no incoming error that is pbrt's `gamma(3) * (|m00 x| + |m01 y| + |m02
// z| + |m03|)`, which is what a sampled point on a disk leaves object space
// with.
func push_point(m : Transform, p : vec3f, e : vec3f) -> BoundedPoint {
    moved = vec3f{fma(m.r0.y, p.y, m.r0.x * p.x) + fma(m.r0.z, p.z, m.r0.w),
                  fma(m.r1.y, p.y, m.r1.x * p.x) + fma(m.r1.z, p.z, m.r1.w),
                  fma(m.r2.y, p.y, m.r2.x * p.x) + fma(m.r2.z, p.z, m.r2.w)};
    wp = fma(m.r3.y, p.y, m.r3.x * p.x) + fma(m.r3.z, p.z, m.r3.w);
    g3 = gamma(3);
    p_error = vec3f{
        (g3 + 1.0) * (abs(m.r0.x) * e.x + abs(m.r0.y) * e.y + abs(m.r0.z) * e.z) +
            g3 * (abs(m.r0.x * p.x) + abs(m.r0.y * p.y) + abs(m.r0.z * p.z) +
                  abs(m.r0.w)),
        (g3 + 1.0) * (abs(m.r1.x) * e.x + abs(m.r1.y) * e.y + abs(m.r1.z) * e.z) +
            g3 * (abs(m.r1.x * p.x) + abs(m.r1.y * p.y) + abs(m.r1.z * p.z) +
                  abs(m.r1.w)),
        (g3 + 1.0) * (abs(m.r2.x) * e.x + abs(m.r2.y) * e.y + abs(m.r2.z) * e.z) +
            g3 * (abs(m.r2.x * p.x) + abs(m.r2.y * p.y) + abs(m.r2.z * p.z) +
                  abs(m.r2.w))};
    out : BoundedPoint = {select(wp == 1.0, moved, moved / wp),
                          select(wp == 1.0, p_error, p_error / abs(wp))};
    return out;
}

// pbrt: Transform::operator()(const SurfaceInteraction &), the bottom of
// TransformedPrimitive::Intersect: the interaction the instance's own geometry
// computed, moved into render space once. Points by the matrix, vectors by its
// upper three by three, normals by the inverse transposed -- pbrt's
// `operator()(Normal3f)` reads the *columns* of the inverse -- and the two
// normals renormalised afterwards, as pbrt's are. `shading.n` is then turned
// to face the geometric normal, which is the last line of pbrt's version.
// A disk's hit leaves object space through this too.
func push_surface(m : Transform, inv : Transform,
                  s : SurfaceGeometry) -> SurfaceGeometry {
    placed = push_point(m, s.p, s.p_error);
    n = unit_vector_(apply_normal_inverse(inv, s.n));
    ns_raw = unit_vector_(apply_normal_inverse(inv, s.ns));
    ns = select(dot(ns_raw, n) < 0.0, -ns_raw, ns_raw);
    out : SurfaceGeometry = {n, ns,
                             apply_vector(m, s.dpdus), apply_vector(m, s.dpdvs),
                             s.uv,
                             apply_vector(m, s.dpdu), apply_vector(m, s.dpdv),
                             apply_normal_inverse(inv, s.dndu),
                             apply_normal_inverse(inv, s.dndv),
                             placed.p, placed.error};
    return out;
}

// pbrt: Disk::InteractionFromIntersection, and the SurfaceInteraction
// constructor and transform it ends in. The parameterization is azimuth over
// phi_max for u and the distance in from the rim over the annulus's width for
// v; the normal is the cross product of the two partials, turned by `flip`;
// the hit is refined onto the plane and, being on it exactly, carries no
// error of its own -- the error it reaches render space with is the
// transform's. A disk is flat, so the normal does not turn: dndu and dndv are
// zero, and the shading geometry is the geometry.
func disk_geometry(d : Disk, hit : DiskHit) -> SurfaceGeometry {
    p_hit = hit.p_obj;
    u = hit.phi / d.phi_max;
    r_hit = sqrt(sqr(p_hit.x) + sqr(p_hit.y));
    v = (d.radius - r_hit) / (d.radius - d.inner_radius);
    dpdu = vec3f{-d.phi_max * p_hit.y, d.phi_max * p_hit.x, 0.0};
    dpdv = vec3f{p_hit.x, p_hit.y, 0.0} * (d.inner_radius - d.radius) / r_hit;
    zero = vec3f{0.0, 0.0, 0.0};
    p_obj = vec3f{p_hit.x, p_hit.y, d.height};
    raw_n = unit_vector(cross_(dpdu, dpdv));
    n = select(d.flip, -raw_n, raw_n);
    g : SurfaceGeometry = {n, n, dpdu, dpdv, vec2f{u, v}, dpdu, dpdv, zero,
                           zero, p_obj, zero};
    return push_surface(d.render_from_object, d.object_from_render, g);
}

// pbrt: Cylinder::InteractionFromIntersection. u the azimuth's fraction of
// phi_max and v the height's of the span; dpdu the circle's tangent scaled by
// phi_max, dpdv the axis scaled by the span; the fundamental forms as the
// sphere's, with the second derivatives in v zero (a cylinder is flat along
// its axis, so dndv comes out zero and dndu the circle's curvature); the
// error bound gamma(3) about the refined x and y, the z being the ray's own.
func cylinder_geometry(cyl : Cylinder, hit : CylinderHit) -> SurfaceGeometry {
    p = hit.p_obj;
    phi_max = cyl.phi_max;
    z_span = cyl.z_max - cyl.z_min;
    u = hit.phi / phi_max;
    v = (p.z - cyl.z_min) / z_span;
    dpdu = vec3f{-phi_max * p.y, phi_max * p.x, 0.0};
    dpdv = vec3f{0.0, 0.0, z_span};

    zero = vec3f{0.0, 0.0, 0.0};
    d2pduu = -phi_max * phi_max * vec3f{p.x, p.y, 0.0};
    form_e = dot_(dpdu, dpdu);
    form_f = dot_(dpdu, dpdv);
    form_g = dot_(dpdv, dpdv);
    form_n = unit_vector_(cross_(dpdu, dpdv));
    coef_e = dot_(form_n, d2pduu);
    coef_f = dot_(form_n, zero);
    coef_g = dot_(form_n, zero);
    egf2 = prod_diff[[Float]](form_e, form_g, form_f, form_f);
    inv_egf2 = select(egf2 == 0.0, 0.0, 1.0 / egf2);
    dndu = (coef_f * form_f - coef_e * form_g) * inv_egf2 * dpdu +
           (coef_e * form_f - coef_f * form_e) * inv_egf2 * dpdv;
    dndv = (coef_g * form_f - coef_f * form_g) * inv_egf2 * dpdu +
           (coef_f * form_f - coef_g * form_e) * inv_egf2 * dpdv;

    raw_n = unit_vector(cross_(dpdu, dpdv));
    n = select(cyl.flip, -raw_n, raw_n);
    g : SurfaceGeometry = {n, n, dpdu, dpdv, vec2f{u, v}, dpdu, dpdv, dndu, dndv,
                           p, gamma(3) * abs(vec3f{p.x, p.y, 0.0})};
    return push_surface(cyl.render_from_object, cyl.object_from_render, g);
}

// pbrt: Rotate(theta, axis) applied to a vector -- the rotation matrix of
// Rotate(sinTheta, cosTheta, axis) about the normalized axis, row by row,
// the angle in degrees as pbrt takes it.
func rotate_vector(theta_deg : Float, axis : vec3f, v : vec3f) -> vec3f {
    sin_t = sin(0.01745329251994329577 * theta_deg);
    cos_t = cos(0.01745329251994329577 * theta_deg);
    a = unit_vector_(axis);
    r0 = vec4f{a.x * a.x + (1.0 - a.x * a.x) * cos_t,
               a.x * a.y * (1.0 - cos_t) - a.z * sin_t,
               a.x * a.z * (1.0 - cos_t) + a.y * sin_t, 0.0};
    r1 = vec4f{a.x * a.y * (1.0 - cos_t) + a.z * sin_t,
               a.y * a.y + (1.0 - a.y * a.y) * cos_t,
               a.y * a.z * (1.0 - cos_t) - a.x * sin_t, 0.0};
    r2 = vec4f{a.x * a.z * (1.0 - cos_t) - a.y * sin_t,
               a.y * a.z * (1.0 - cos_t) + a.x * sin_t,
               a.z * a.z + (1.0 - a.z * a.z) * cos_t, 0.0};
    return vec3f{apply_row_vector(r0, v), apply_row_vector(r1, v),
                 apply_row_vector(r2, v)};
}

// pbrt: the SurfaceInteraction a curve hit makes (the tail of
// RecursiveIntersect's leaf). dpdu is the common's whole curve's derivative
// at u (EvaluateCubicBezier with the derivative); dpdv is, for a ribbon,
// the normal crossed with it at the width, and for a flat or a cylinder
// curve the perpendicular to dpdu in the ray's plane at the width -- dpdu
// taken into ray space by `objectFromRay.ApplyInverse`, turned there,
// brought back -- a cylinder's rotated about dpdu by v from -90 to 90
// degrees so the normal turns across the width as a tube's does. The
// error bound is the width on every axis; the normal is dpdu x dpdv turned
// by `flip`; the point is the object-space ray at t; a curve has no second
// derivatives and no vertex normals, so the shading geometry is the
// geometry. The ray space is rebuilt from the ray, the same bits as the hit
// test's.
func curve_geometry(seg : Curve, r : Ray, hit : CurveHit) -> SurfaceGeometry {
    c = curve_commons[seg.common];
    frame = curve_frames[c.frame];
    ray = curve_ray(frame.object_from_render, r);
    whole : Bezier = {c.p0, c.p1, c.p2, c.p3};
    at = bezier_at(whole, hit.u);
    dpdu = at.dpdu;
    dpdv : mut vec3f = vec3f{0.0, 0.0, 0.0};
    if c.kind == 2 {
        n_hit = ribbon_normal(c, hit.u);
        dpdv = unit_vector_(cross_(n_hit, dpdu)) * hit.hit_width;
    } else {
        rs = curve_ray_space(ray, bezier_segment(c, seg.u_min, seg.u_max));
        dpdu_plane = apply_vector(rs.ray_from_object, dpdu);
        dpdv_plane : mut vec3f =
            unit_vector_(vec3f{-dpdu_plane.y, dpdu_plane.x, 0.0}) * hit.hit_width;
        if c.kind == 1 {
            // pbrt: `Rotate(-theta, dpduPlane)` with theta = Lerp(v, -90, 90).
            theta = lerp_st(hit.v, -90.0, 90.0);
            dpdv_plane = rotate_vector(-theta, dpdu_plane, dpdv_plane);
        }
        dpdv = apply_vector(rs.object_from_ray, dpdv_plane);
    }
    p_obj = ray.o + hit.t * ray.d;
    p_error = vec3f{hit.hit_width, hit.hit_width, hit.hit_width};
    raw_n = unit_vector(cross_(dpdu, dpdv));
    n = select(frame.flip, -raw_n, raw_n);
    zero = vec3f{0.0, 0.0, 0.0};
    g : SurfaceGeometry = {n, n, dpdu, dpdv, vec2f{hit.u, hit.v}, dpdu, dpdv, zero,
                           zero, p_obj, p_error};
    return push_surface(frame.render_from_object, frame.object_from_render, g);
}

// pbrt: Triangle::InteractionFromIntersection.
func triangle_geometry(tri : Triangle, b : vec3f) -> SurfaceGeometry {
    m = meshes[tri.mesh];
    i0 = mesh_corner(m, tri, 0u);
    i1 = mesh_corner(m, tri, 1u);
    i2 = mesh_corner(m, tri, 2u);
    p0 = mesh_positions[i0];
    p1 = mesh_positions[i1];
    p2 = mesh_positions[i2];

    // pbrt substitutes these for a mesh with no texture coordinates of its own.
    // Per triangle rather than per vertex, which is why they cannot live in the
    // pool beside the ones a mesh does bring. An `if`, as pbrt's
    // `mesh->uv ? ... : ...` is, and not a select: a select evaluates both of
    // its arms, and a mesh without texture coordinates has nothing at
    // `mesh_uvs` to read -- the scene need not hand over an address at all.
    uv0 : mut vec2f = vec2f{0.0, 0.0};
    uv1 : mut vec2f = vec2f{1.0, 0.0};
    uv2 : mut vec2f = vec2f{1.0, 1.0};
    if m.has_uv {
        uv0 = mesh_uvs[m.first_uv + i0 - m.first_vertex];
        uv1 = mesh_uvs[m.first_uv + i1 - m.first_vertex];
        uv2 = mesh_uvs[m.first_uv + i2 - m.first_vertex];
    }

    // pbrt: the partial derivatives, from inverting the map that the texture
    // coordinates give from the triangle to the plane.
    duv02 = uv0 - uv2;
    duv12 = uv1 - uv2;
    dp02 = p0 - p2;
    dp12 = p1 - p2;
    determinant = prod_diff[[Float]](duv02.x, duv12.y, duv02.y, duv12.x);
    degenerate_uv = abs(determinant) < 1e-9;

    invdet = 1.0 / determinant;
    dpdu : mut vec3f = prod_diff3(duv12.y, dp02, duv02.y, dp12) * invdet;
    dpdv : mut vec3f = prod_diff3(duv02.x, dp12, duv12.x, dp02) * invdet;
    // A parameterization that says nothing about direction, either because the
    // texture coordinates are degenerate or because the two derivatives came
    // out parallel. pbrt falls back to an arbitrary basis in the tangent plane.
    // Its own further fallback to double precision is for a triangle with no
    // area, which triangle_hit has already rejected.
    if degenerate_uv || (sqlen[[Float]](cross_(dpdu, dpdv)) == 0.0) {
        fallback = coordinate_system(unit_vector(cross_(p2 - p0, p1 - p0)));
        dpdu = fallback.x;
        dpdv = fallback.y;
    }

    raw_n = unit_vector(cross_(dp02, dp12));
    n = select(m.flip, -raw_n, raw_n);

    // pbrt: the hit point and its error, both from the barycentric
    // interpolation rather than from the ray -- `pHit = b0*p0 + b1*p1 + b2*p2`
    // and `pError = gamma(7) * (|b0 p0| + |b1 p1| + |b2 p2|)`. Seven operations
    // because the sum of three scaled points is what the bound is over.
    p_hit = b.x * p0 + b.y * p1 + b.z * p2;
    p_abs_sum = abs(b.x * p0) + abs(b.y * p1) + abs(b.z * p2);
    p_err = gamma(7) * p_abs_sum;
    // pbrt: `Point2f uvHit = b0 * uv[0] + b1 * uv[1] + b2 * uv[2]`, the same
    // barycentric interpolation as the point.
    uv_hit = b.x * uv0 + b.y * uv1 + b.z * uv2;

    if !m.has_normals {
        // pbrt never enters its shading-geometry block for such a mesh, so the
        // shading normal is the geometric one and the tangent is unadjusted.
        // dndu and dndv are zero for a mesh with no normals: the shading
        // normal is the face's and does not turn within the triangle.
        zero = vec3f{0.0, 0.0, 0.0};
        plain : SurfaceGeometry = {n, n, dpdu, dpdv, uv_hit, dpdu, dpdv, zero,
                                   zero, p_hit, p_err};
        return plain;
    }

    // pbrt: the shading normal, interpolated across the triangle and falling
    // back to the geometric one where the three vertex normals cancel.
    //
    // As two fused multiply-adds per component, which is what pbrt's compiler
    // makes of `b0 * n0 + b1 * n1 + b2 * n2`. See dot_ in stdlib/numerics for
    // which multiply pairs with which add and why it is not a detail.
    n0 = mesh_normals[m.first_normal + i0 - m.first_vertex];
    n1 = mesh_normals[m.first_normal + i1 - m.first_vertex];
    n2 = mesh_normals[m.first_normal + i2 - m.first_vertex];
    raw_ns = fma3(b.z, n2, fma3(b.y, n1, b.x * n0));
    ns = select(sqlen_(raw_ns) > 0.0, unit_vector_(raw_ns), n);

    // pbrt: dndu and dndv for the shading geometry, from the same inversion
    // that gave dpdu and dpdv -- the vertex normals interpolate across the
    // triangle exactly as the positions do, so their derivatives come out of
    // the same 2x2 solve with the normal deltas in place of the position ones.
    dn1 = n0 - n2;
    dn2 = n1 - n2;
    dndu : mut vec3f = vec3f{0.0, 0.0, 0.0};
    dndv : mut vec3f = vec3f{0.0, 0.0, 0.0};
    if degenerate_uv {
        // pbrt takes the trouble to answer here rather than giving up, and
        // says why: a differential reflected off a triangle whose texture
        // coordinates are degenerate should still be a reasonable size. The
        // basis is arbitrary but it is the same arbitrary basis dpdu and dpdv
        // fell back to above.
        dn = cross_(n2 - n0, n1 - n0);
        if sqlen[[Float]](dn) != 0.0 {
            dn_basis = coordinate_system(dn);
            dndu = dn_basis.x;
            dndv = dn_basis.y;
        }
    } else {
        dndu = prod_diff3(duv12.y, dn1, duv02.y, dn2) * invdet;
        dndv = prod_diff3(duv02.x, dn2, duv12.x, dn1) * invdet;
    }

    // pbrt: the shading tangent, made perpendicular to the shading normal.
    // Where the two are parallel there is nothing to project, and an arbitrary
    // basis is taken instead.
    ts_raw = cross_(ns, dpdu);
    parallel = sqlen[[Float]](ts_raw) == 0.0;
    fallback = coordinate_system(ns);
    ss = select(parallel, fallback.x, cross_(ts_raw, ns));
    ts = select(parallel, fallback.y, ts_raw);

    // pbrt: SetShadingGeometry, whose loop scales the two derivatives down
    // until they are of a size the differentials can be taken in. It never runs
    // for anything at a sane scale, and it is here because when it does run it
    // changes the frame this all exists to build.
    su : mut vec3f = ss;
    sv : mut vec3f = ts;
    while (sqlen[[Float]](su) > 1e16) || (sqlen[[Float]](sv) > 1e16) {
        su = su / 1e8;
        sv = sv / 1e8;
    }

    // The geometric normal turns to face the shading one, which the film's own
    // FaceForward against the ray then makes invisible -- but not to a BSDF.
    // pbrt: SetShadingGeometry sets dndu and dndv and does *not* put them
    // through the scaling loop above, which only ever touches the tangents.
    g : SurfaceGeometry = {select(dot(n, ns) < 0.0, -n, n), ns, su, sv, uv_hit,
                           dpdu, dpdv, dndu, dndv, p_hit, p_err};
    return g;
}

// pbrt: Shape::Intersect's tail, which turns a hit into the surface it landed
// on.
//
// The intersection is run again here rather than carried out of the tree
// query, because what the query answers is which primitive is nearest and not
// where on it the ray landed. That is one more intersection per camera ray
// against however many the traversal already did, so it is not where the time
// goes -- but it is a question the tree lowering could answer for free, and
// worth revisiting when it can.
//
// Asked of the shape the ray was already found to hit, so a miss here is not a
// case the caller has an answer for; it reports the surface facing the ray,
// which is what a sliver of no area would have given anyway.
// pbrt: OffsetRayOrigin, which is what `interval.bonsai` was written for.
//
// A ray leaving a surface must not hit the surface it left. The usual fix is an
// epsilon, which is wrong in both directions -- too small and the surface
// shadows itself, too large and contact is lost -- and pbrt's is not an epsilon
// at all: the hit point is known to within `p_error`, so the origin is pushed
// out by exactly that bound along the normal, on the side the new ray leaves
// towards.
//
// The rounding afterwards is not decoration. The offset can be smaller than an
// ulp of the coordinate it is added to, in which case the addition returns the
// point unchanged and the push did nothing; nudging each coordinate one float
// further out guarantees it moved.
func offset_ray_origin(p : vec3f, p_error : vec3f, n : vec3f,
                       w : vec3f) -> vec3f {
    d = dot(abs(n), p_error);
    signed = select(dot(w, n) < 0.0, -d, d);
    offset = signed * n;
    po = p + offset;
    return vec3f{
        select(offset.x > 0.0, next_float_up(po.x),
               select(offset.x < 0.0, next_float_down(po.x), po.x)),
        select(offset.y > 0.0, next_float_up(po.y),
               select(offset.y < 0.0, next_float_down(po.y), po.y)),
        select(offset.z > 0.0, next_float_up(po.z),
               select(offset.z < 0.0, next_float_down(po.z), po.z))};
}

// Whether a hit the traversal reported is one pbrt's own test refuses --
// behind the ray, past its bound, or nearer than the error bound allows.
// The RT cores' triangle test has no such bound: a ray spawned off a face is
// pushed out by pbrt's per-component error, and where the face lies near a
// coordinate plane of render space (pbrt's camera-centred world) that push
// is a few ulps of a small coordinate while the hardware rounds at the scale
// of the face's largest ones, so it hands the ray the face it just left at a
// distance of zero. pbrt's CPU drops that hit by its bound; pbrt's GPU does
// not and loops forever re-spawning there, and so did this renderer. Only a
// triangle can be refused this way: the other shapes are tested by this
// program's own code, which already refuses as pbrt refuses.
func hit_refused(sh : Shape, r : Ray) -> bool {
    match sh {
        Tri(tri) => return !cast[[bool]](triangle_hit(r, inf, tri));
        Sph(s) => return false;
        Dsk(d) => return false;
        Blp(b) => return false;
        Cyl(c) => return false;
        Crv(cv) => return false;
    }
}

// The error bound a ray leaving a surface the hardware re-found
// (hit_refused) is pushed off by: pbrt's gamma(7) bound taken at the scale
// of the point's largest coordinate on every axis rather than per axis,
// which is the scale the hardware's test rounds at. The push clears the
// surface; every other spawn keeps pbrt's own bound and is pbrt's to the
// bit.
func wide_error(p : vec3f) -> vec3f {
    e = gamma(7) * max(max(abs(p.x), abs(p.y)), abs(p.z));
    return vec3f{e, e, e};
}

// pbrt: Interaction::SpawnRay. The geometric normal rather than the shading
// one, because what the offset has to clear is where the surface actually is.
func spawn_ray(g : SurfaceGeometry, d : vec3f) -> Ray {
    r : Ray = {offset_ray_origin(g.p, g.p_error, g.n, d), d};
    return r;
}

// pbrt: SpawnRayTo, the shadow ray between two surfaces.
//
// Both ends are pushed off their surfaces, not just the origin: a ray that
// stops exactly on the light would find the light, and one that stops exactly
// on the surface it left would find that. The direction is deliberately *not*
// normalized, so `t` runs from zero at one end to one at the other and the
// bound a shadow ray is traced with, `shadow_tmax`, is a fraction rather than
// a distance -- which is what lets one epsilon work for a light a metre away
// and one a kilometre away.
func spawn_ray_to(from_p : vec3f, from_error : vec3f, from_n : vec3f,
                  to_p : vec3f, to_error : vec3f, to_n : vec3f) -> Ray {
    pf = offset_ray_origin(from_p, from_error, from_n, to_p - from_p);
    pt = offset_ray_origin(to_p, to_error, to_n, pf - to_p);
    r : Ray = {pf, pt - pf};
    return r;
}

// pbrt: the other SpawnRayTo, toward a point rather than a surface -- the
// origin is pushed off its surface and the far end is the point itself. The
// wavefront's TraceTransmittance re-spawns a shadow ray this way at every
// medium boundary it crosses, toward where the first segment ended.
func spawn_ray_to_point(from_p : vec3f, from_error : vec3f, from_n : vec3f,
                        to_p : vec3f) -> Ray {
    d = to_p - from_p;
    r : Ray = {offset_ray_origin(from_p, from_error, from_n, d), d};
    return r;
}

// pbrt: `1 - ShadowEpsilon`, how far along a shadow ray -- `t` from zero at
// one end to one at the other -- a hit still counts as occlusion: the far
// surface itself, a sliver short of `t = 1`, does not.
func shadow_tmax() -> Float = 1.0 - 0.0001;

// pbrt: ShapeSampleContext, the point a shape is being sampled *from*.
//
// A surface asking "where on the light should I look?" -- so the shading normal
// is here as well as the geometric one, and the error bound is here because the
// answer depends on where the shadow ray may start from.
element ShapeSampleContext {
    p : vec3f;
    p_error : vec3f;
    n : vec3f;
    ns : vec3f;
}

// pbrt: ShapeSample -- a point on the shape and the density it was chosen with,
// in solid angle measure about the context's point.
element ShapeSample {
    p : vec3f;
    p_error : vec3f;
    n : vec3f;
    uv : vec2f;
    pdf : Float;
}

// pbrt: ShapeSampleContext::OffsetRayOrigin(Point3f), which offsets towards a
// point rather than along a direction.
func ctx_offset_toward(ctx : ShapeSampleContext, target : vec3f) -> vec3f =
    offset_ray_origin(ctx.p, ctx.p_error, ctx.n, target - ctx.p);

// pbrt: SafeACos, clamped so that a cosine a hair outside [-1,1] -- which
// arithmetic produces -- is an angle rather than a NaN.
// min/max rather than bxdf.bonsai's `clampf`: that file imports this one, not
// the other way about, and a symbol that resolves only because some third file
// imported both is a dependency nothing declares.
func safe_acos(x : Float) -> Float = acos(min(max(x, -1.0), 1.0));

// pbrt: SphericalDirection, from a sine, a cosine and an azimuth.
// `st`/`ct` rather than pbrt's names: `sin_theta` and `cos_theta` are already
// the spherical accessors in bxdf.bonsai, which take a direction.
func spherical_direction(st : Float, ct : Float, phi : Float) -> vec3f {
    s = min(max(st, -1.0), 1.0);
    return vec3f{s * cos(phi), s * sin(phi), min(max(ct, -1.0), 1.0)};
}

// pbrt: Sphere::Area -- `phiMax * radius * (zMax - zMin)`, the whole surface
// for a full sphere and the clipped part for a partial one.
func sphere_area(s : Sphere) -> Float = s.phi_max * s.radius * (s.z_max - s.z_min);

// pbrt: Sphere::Sample(u), a point chosen uniformly over the sphere's area --
// the whole sphere whatever the clipping, as pbrt samples it, with the
// density one over the clipped area all the same; pbrt does not reconcile
// the two, so neither does this. The normal is the object-space position
// pushed through the transform as a normal (pbrt's `(*renderFromObject)
// (Normal3f)`, the inverse's columns), turned by `reverse`; the point goes
// out with its gamma(5) bound.
//
// Only reached when the point being sampled from is *inside* the sphere,
// where the cone below is not defined.
func sphere_sample_area(s : Sphere, u : vec2f) -> ShapeSample {
    dir = sample_uniform_sphere(u);
    p_obj0 = s.radius * dir;
    // pbrt reprojects onto the sphere, since the direction is only as accurate
    // as the trigonometry that made it.
    p_obj = p_obj0 * (s.radius / norm(p_obj0));
    p_obj_error = gamma(5) * abs(p_obj);

    raw_n = unit_vector_(apply_normal_inverse(s.object_from_render, p_obj));
    n = select(s.reverse, -raw_n, raw_n);

    theta = safe_acos(p_obj.z / s.radius);
    phi0 = atan2(p_obj.y, p_obj.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    uv = vec2f{phi / s.phi_max,
               (theta - s.theta_z_min) / (s.theta_z_max - s.theta_z_min)};

    placed = push_point(s.render_from_object, p_obj, p_obj_error);
    ss : ShapeSample = {placed.p, placed.error, n, uv, 1.0 / sphere_area(s)};
    return ss;
}

// pbrt: Sphere::Sample(ctx, u) -- a direction chosen uniformly inside the cone
// the sphere subtends, which is what makes a shadow ray worth tracing: every
// direction it picks is one that can reach the light.
func sphere_sample(s : Sphere, ctx : ShapeSampleContext,
                   u : vec2f) -> option[ShapeSample] {
    // pbrt: `pCenter = (*renderFromObject)(Point3f(0, 0, 0))`, and the
    // object-space radius against render-space distances from here on, as
    // pbrt has it -- exact under a rigid transform, pbrt's own approximation
    // under a scale.
    p_center = sphere_center(s);
    p_origin = ctx_offset_toward(ctx, p_center);
    if sqlen[[Float]](p_origin - p_center) <= sqr(s.radius) {
        // Inside the sphere: the cone is not defined, so sample the area and
        // convert the density to solid angle.
        area = sphere_sample_area(s, u);
        wi0 = area.p - ctx.p;
        if sqlen[[Float]](wi0) == 0.0 {
            return {};
        }
        wi = unit_vector_(wi0);
        denom = abs(dot(area.n, -wi)) / sqlen[[Float]](ctx.p - area.p);
        if denom == 0.0 {
            return {};
        }
        converted : mut ShapeSample = area;
        converted.pdf = area.pdf / denom;
        if converted.pdf == inf {
            return {};
        }
        return converted;
    }

    // The cone the sphere subtends, sampled uniformly in solid angle.
    sin_theta_max = s.radius / norm(ctx.p - p_center);
    sin2_theta_max = sqr(sin_theta_max);
    cos_theta_max = safe_sqrt(1.0 - sin2_theta_max);
    one_minus_cos : mut Float = 1.0 - cos_theta_max;

    // `ct2`/`s2t`: `cos_theta` is bxdf.bonsai's spherical accessor.
    ct2 : mut Float = fma(cos_theta_max - 1.0, u.x, 1.0);
    s2t : mut Float = 1.0 - sqr(ct2);
    // pbrt: sin^2(1.5 degrees). Below that the subtraction above loses most of
    // its significance, and the series is the accurate form.
    if sin2_theta_max < 0.00068523 {
        s2t = sin2_theta_max * u.x;
        ct2 = sqrt(1.0 - s2t);
        one_minus_cos = sin2_theta_max / 2.0;
    }

    // The angle from the sphere's centre to the sampled point on its surface,
    // which is not the same as the angle from the viewer.
    cos_alpha = s2t / sin_theta_max +
                ct2 * safe_sqrt(1.0 - s2t / sqr(sin_theta_max));
    sin_alpha = safe_sqrt(1.0 - sqr(cos_alpha));

    phi = u.y * 6.28318530717958647692;
    w = spherical_direction(sin_alpha, cos_alpha, phi);
    // `unit_vector_` rather than `unit_vector`: pbrt's Normalize divides by a
    // length its compiler computes with fused multiply-adds, and the two differ
    // in the last bit -- which lands in the sampled point.
    sampling_frame = frame_from_z(unit_vector_(p_center - ctx.p));
    raw_n = frame_from_local(sampling_frame, -w);
    // pbrt: `if (reverseOrientation) n *= -1` -- the orientation flag alone,
    // not the hit normal's `flip`.
    n = select(s.reverse, -raw_n, raw_n);
    p = p_center + s.radius * n;

    p_error = gamma(5) * abs(p);

    // The texture coordinates of the sampled point, in the sphere's own
    // space: pbrt's `(*objectFromRender)(p)`, the forward application of
    // that transform.
    p_obj = apply_point(s.object_from_render, p);
    theta = safe_acos(p_obj.z / s.radius);
    sphere_phi0 = atan2(p_obj.y, p_obj.x);
    sphere_phi = select(sphere_phi0 < 0.0,
                        sphere_phi0 + 6.28318530717958647692, sphere_phi0);
    uv = vec2f{sphere_phi / s.phi_max,
               (theta - s.theta_z_min) / (s.theta_z_max - s.theta_z_min)};

    ss : ShapeSample = {p, p_error, n, uv,
                        1.0 / (6.28318530717958647692 * one_minus_cos)};
    return ss;
}

// pbrt: Sphere::PDF(ctx, wi), the density `sphere_sample` draws with. Needed
// for MIS, which weighs this estimator against the BSDF's. From inside the
// sphere the density is the area's, converted to solid angle at the point
// the ray from the context in direction `wi` hits (`ctx.SpawnRay(wi)`, then
// Intersect); from outside it is the cone's.
func sphere_pdf_inside(s : Sphere, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    ray : Ray = {offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi), wi};
    hit = sphere_hit(ray, inf, s);
    if !hit {
        return 0.0;
    }
    g = sphere_geometry(s, *hit);
    pdf = (1.0 / sphere_area(s)) / (abs(dot(g.n, -wi)) / sqlen[[Float]](ctx.p - g.p));
    return select(pdf == inf, 0.0, pdf);
}

func sphere_pdf(s : Sphere, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    p_center = sphere_center(s);
    p_origin = ctx_offset_toward(ctx, p_center);
    if sqlen[[Float]](p_origin - p_center) <= sqr(s.radius) {
        return sphere_pdf_inside(s, ctx, wi);
    }
    sin2_theta_max = sqr(s.radius) / sqlen[[Float]](ctx.p - p_center);
    cos_theta_max = safe_sqrt(1.0 - sin2_theta_max);
    one_minus_cos : mut Float = 1.0 - cos_theta_max;
    if sin2_theta_max < 0.00068523 {
        one_minus_cos = sin2_theta_max / 2.0;
    }
    return 1.0 / (6.28318530717958647692 * one_minus_cos);
}

// pbrt: `(*renderFromObject)(Point3f(0, 0, 0))`, where the sphere's centre
// is in render space: the transform's translation column, which is what the
// point transform of the origin comes to exactly.
func sphere_center(s : Sphere) -> vec3f =
    apply_point(s.render_from_object, vec3f{0.0, 0.0, 0.0});

// pbrt: Disk::Area, the sector of the annulus phi_max covers.
func disk_area(d : Disk) -> Float =
    d.phi_max * 0.5 * (sqr(d.radius) - sqr(d.inner_radius));

// pbrt: Disk::Sample(u), a point chosen uniformly over the disk's area -- the
// unit disk sampled concentrically and scaled to the radius, then pushed into
// render space with the transform's error, and the normal the transform makes
// of the object space's z, turned by `reverse`. The point is sampled over the
// whole disk whatever the inner radius and phi_max, as pbrt's is; the density
// is one over the sector's area all the same. pbrt does not reconcile the two,
// so neither does this.
func disk_sample_area(d : Disk, u : vec2f) -> ShapeSample {
    pd = sample_uniform_disk_concentric(u);
    p_obj = vec3f{pd.x * d.radius, pd.y * d.radius, d.height};
    placed = push_point(d.render_from_object, p_obj, vec3f{0.0, 0.0, 0.0});
    raw_n = unit_vector_(apply_normal_inverse(d.object_from_render,
                                              vec3f{0.0, 0.0, 1.0}));
    n = select(d.reverse, -raw_n, raw_n);
    phi0 = atan2(pd.y, pd.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    radius_sample = sqrt(sqr(p_obj.x) + sqr(p_obj.y));
    uv = vec2f{phi / d.phi_max,
               (d.radius - radius_sample) / (d.radius - d.inner_radius)};
    ss : ShapeSample = {placed.p, placed.error, n, uv, 1.0 / disk_area(d)};
    return ss;
}

// pbrt: Disk::Sample(ctx, u) -- the area sample above, its density converted
// to solid angle about the point it is seen from. A point seen edge-on, or
// coincident, has an infinite density and is declined.
func disk_sample(d : Disk, ctx : ShapeSampleContext,
                 u : vec2f) -> option[ShapeSample] {
    area = disk_sample_area(d, u);
    wi0 = area.p - ctx.p;
    if sqlen[[Float]](wi0) == 0.0 {
        return {};
    }
    wi = unit_vector_(wi0);
    converted : mut ShapeSample = area;
    converted.pdf = area.pdf / (abs(dot(area.n, -wi)) /
                                sqlen[[Float]](ctx.p - area.p));
    if converted.pdf == inf {
        return {};
    }
    return converted;
}

// pbrt: Disk::PDF(ctx, wi), the density `disk_sample` draws `wi` with: the
// disk is intersected along `wi` from the context's point, and the area
// density converted at the hit. Zero for a miss, and zero where the
// conversion overflows.
func disk_pdf(d : Disk, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    r : Ray = {offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi), wi};
    hit = disk_hit(r, inf, d);
    if !hit {
        return 0.0;
    }
    g = disk_geometry(d, *hit);
    pdf = (1.0 / disk_area(d)) /
          (abs(dot(g.n, -wi)) / sqlen[[Float]](ctx.p - g.p));
    return select(pdf == inf, 0.0, pdf);
}

// pbrt: Cylinder::Area, `(zMax - zMin) * radius * phiMax` in that order.
func cylinder_area(cyl : Cylinder) -> Float =
    (cyl.z_max - cyl.z_min) * cyl.radius * cyl.phi_max;

// pbrt: Cylinder::Sample(u), a point chosen uniformly over the clipped
// surface -- a height between the two by the first draw, an azimuth within
// phi_max by the second -- reprojected onto the radius since the
// trigonometry is only so accurate, pushed into render space with the
// gamma(3) bound a hit carries, its normal the object-space (x, y, 0) pushed
// through the transform as a normal and turned by `reverse`.
func cylinder_sample_area(cyl : Cylinder, u : vec2f) -> ShapeSample {
    z = lerp_st(u.x, cyl.z_min, cyl.z_max);
    phi = u.y * cyl.phi_max;
    p0 = vec3f{cyl.radius * cos(phi), cyl.radius * sin(phi), z};
    hit_rad = sqrt(sqr(p0.x) + sqr(p0.y));
    p_obj = vec3f{p0.x * (cyl.radius / hit_rad), p0.y * (cyl.radius / hit_rad),
                  p0.z};
    p_obj_error = gamma(3) * abs(vec3f{p_obj.x, p_obj.y, 0.0});
    placed = push_point(cyl.render_from_object, p_obj, p_obj_error);
    raw_n = unit_vector_(apply_normal_inverse(cyl.object_from_render,
                                              vec3f{p_obj.x, p_obj.y, 0.0}));
    n = select(cyl.reverse, -raw_n, raw_n);
    uv = vec2f{phi / cyl.phi_max, (p_obj.z - cyl.z_min) / (cyl.z_max - cyl.z_min)};
    ss : ShapeSample = {placed.p, placed.error, n, uv, 1.0 / cylinder_area(cyl)};
    return ss;
}

// pbrt: Cylinder::Sample(ctx, u) -- the area sample above, its density
// converted to solid angle about the point it is seen from, as the disk's.
func cylinder_sample(cyl : Cylinder, ctx : ShapeSampleContext,
                     u : vec2f) -> option[ShapeSample] {
    area = cylinder_sample_area(cyl, u);
    wi0 = area.p - ctx.p;
    if sqlen[[Float]](wi0) == 0.0 {
        return {};
    }
    wi = unit_vector_(wi0);
    converted : mut ShapeSample = area;
    converted.pdf = area.pdf / (abs(dot(area.n, -wi)) /
                                sqlen[[Float]](ctx.p - area.p));
    if converted.pdf == inf {
        return {};
    }
    return converted;
}

// pbrt: Cylinder::PDF(ctx, wi), the disk's by the cylinder's hit.
func cylinder_pdf(cyl : Cylinder, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    r : Ray = {offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi), wi};
    hit = cylinder_hit(r, inf, cyl);
    if !hit {
        return 0.0;
    }
    g = cylinder_geometry(cyl, *hit);
    pdf = (1.0 / cylinder_area(cyl)) /
          (abs(dot(g.n, -wi)) / sqlen[[Float]](ctx.p - g.p));
    return select(pdf == inf, 0.0, pdf);
}

// pbrt: AngleBetween(v1, v2), the angle between two unit vectors, computed from
// a chord rather than an arccosine so that it stays accurate near 0 and pi.
func angle_between(a : vec3f, b : vec3f) -> Float {
    if dot(a, b) < 0.0 {
        return 3.14159265358979323846 - 2.0 * safe_asin(norm(a + b) / 2.0);
    }
    return 2.0 * safe_asin(norm(b - a) / 2.0);
}

// pbrt: GramSchmidt(v, w), the part of v orthogonal to the unit vector w.
func gram_schmidt(v : vec3f, w : vec3f) -> vec3f = v - dot(v, w) * w;

// pbrt: DifferenceOfProducts and SumOfProducts, the two-fma forms that carry
// the rounding error of the discarded product back into the result. Defined
// here rather than imported: differentials.bonsai has the first, but shapes
// does not import it, and a symbol that resolves only through a third file's
// imports is a dependency nothing declares.
func diff_of_products(a : Float, b : Float, c : Float, d : Float) -> Float {
    cd = c * d;
    return fma(a, b, -cd) + fma(-c, d, cd);
}
func sum_of_products(a : Float, b : Float, c : Float, d : Float) -> Float {
    cd = c * d;
    return fma(a, b, cd) + fma(c, d, -cd);
}

// pbrt: SphericalTriangleArea, the solid angle three unit directions subtend.
func spherical_triangle_area(a : vec3f, b : vec3f, c : vec3f) -> Float =
    abs(2.0 * atan2(dot(a, cross_(b, c)),
                    1.0 + dot(a, b) + dot(a, c) + dot(b, c)));

// pbrt: Lerp, a linear blend written the way pbrt writes it so the endpoints
// come back exactly.
func lerp_st(t : Float, a : Float, b : Float) -> Float = (1.0 - t) * a + t * b;

// pbrt: SampleLinear, the inverse CDF of a linear density on [0,1]. The
// constant is pbrt's OneMinusEpsilon, the largest float below one, so a sample
// never lands exactly on the far edge.
func sample_linear(u : Float, a : Float, b : Float) -> Float {
    if (u == 0.0) && (a == 0.0) {
        return 0.0;
    }
    x = u * (a + b) / (a + sqrt(lerp_st(u, a * a, b * b)));
    return min(x, 0.99999994);
}

// pbrt: BilinearPDF and SampleBilinear, the cosine-warp that biases the
// spherical-triangle sample towards the corners the shading normal faces.
func bilinear_pdf(p : vec2f, w0 : Float, w1 : Float, w2 : Float,
                  w3 : Float) -> Float {
    if (p.x < 0.0) || (p.x > 1.0) || (p.y < 0.0) || (p.y > 1.0) {
        return 0.0;
    }
    if (w0 + w1 + w2 + w3) == 0.0 {
        return 1.0;
    }
    return 4.0 *
           ((1.0 - p.x) * (1.0 - p.y) * w0 + p.x * (1.0 - p.y) * w1 +
            (1.0 - p.x) * p.y * w2 + p.x * p.y * w3) /
           (w0 + w1 + w2 + w3);
}

func sample_bilinear(u : vec2f, w0 : Float, w1 : Float, w2 : Float,
                     w3 : Float) -> vec2f {
    py = sample_linear(u.y, w0 + w1, w2 + w3);
    px = sample_linear(u.x, lerp_st(py, w0, w2), lerp_st(py, w1, w3));
    return vec2f{px, py};
}

// pbrt: SampleUniformTriangle, uniform barycentrics over a triangle.
func sample_uniform_triangle(u : vec2f) -> vec3f {
    if u.x < u.y {
        b0 = u.x / 2.0;
        return vec3f{b0, u.y - b0, 1.0 - b0 - (u.y - b0)};
    }
    b1 = u.y / 2.0;
    return vec3f{u.x - b1, b1, 1.0 - (u.x - b1) - b1};
}

// pbrt: Triangle::Area, half the parallelogram the two edges span.
func triangle_area(t : Triangle) -> Float {
    p0 = triangle_p(t, 0u);
    return 0.5 * norm(cross_(triangle_p(t, 1u) - p0, triangle_p(t, 2u) - p0));
}

// pbrt: the geometric normal at a sampled point, face-forwarded to the
// interpolated shading normal for a mesh that has them, and flipped by the
// mesh's orientation otherwise -- exactly the block Triangle::Sample runs.
func triangle_face_normal(t : Triangle, b : vec3f) -> vec3f {
    m = meshes[t.mesh];
    i0 = mesh_corner(m, t, 0u);
    i1 = mesh_corner(m, t, 1u);
    i2 = mesh_corner(m, t, 2u);
    p0 = mesh_positions[i0];
    p1 = mesh_positions[i1];
    p2 = mesh_positions[i2];
    n = unit_vector_(cross_(p1 - p0, p2 - p0));
    if !m.has_normals {
        return select(m.flip, -n, n);
    }
    n0 = mesh_normals[m.first_normal + i0 - m.first_vertex];
    n1 = mesh_normals[m.first_normal + i1 - m.first_vertex];
    n2 = mesh_normals[m.first_normal + i2 - m.first_vertex];
    ns = b.x * n0 + b.y * n1 + b.z * n2;
    return select(dot(n, ns) < 0.0, -n, n);
}

// The texture coordinates a mesh brings, or pbrt's per-triangle (0,0),(1,0),
// (1,1) for one that has none, interpolated at the barycentrics. An `if`
// rather than a select, for the reason given in triangle_geometry.
func triangle_uv_at(m : TriangleMesh, i0 : u32, i1 : u32, i2 : u32,
                    b : vec3f) -> vec2f {
    uv0 : mut vec2f = vec2f{0.0, 0.0};
    uv1 : mut vec2f = vec2f{1.0, 0.0};
    uv2 : mut vec2f = vec2f{1.0, 1.0};
    if m.has_uv {
        uv0 = mesh_uvs[m.first_uv + i0 - m.first_vertex];
        uv1 = mesh_uvs[m.first_uv + i1 - m.first_vertex];
        uv2 = mesh_uvs[m.first_uv + i2 - m.first_vertex];
    }
    return b.x * uv0 + b.y * uv1 + b.z * uv2;
}

// pbrt: Triangle::Sample(u), a point chosen uniformly over the triangle's
// area. The unstable-solid-angle fallback of the solid-angle sampler below.
func triangle_sample_area(t : Triangle, u : vec2f) -> ShapeSample {
    m = meshes[t.mesh];
    i0 = mesh_corner(m, t, 0u);
    i1 = mesh_corner(m, t, 1u);
    i2 = mesh_corner(m, t, 2u);
    p0 = mesh_positions[i0];
    p1 = mesh_positions[i1];
    p2 = mesh_positions[i2];
    b = sample_uniform_triangle(u);
    p = b.x * p0 + b.y * p1 + b.z * p2;
    p_abs = abs(b.x * p0) + abs(b.y * p1) + abs((1.0 - b.x - b.y) * p2);
    ss : ShapeSample = {p, gamma(6) * p_abs, triangle_face_normal(t, b),
                        triangle_uv_at(m, i0, i1, i2, b), 1.0 / triangle_area(t)};
    return ss;
}

// pbrt: SampleSphericalTriangle -- barycentrics for a direction drawn uniformly
// in the solid angle the triangle subtends from `p`, plus that solid angle's
// density. The whole of Arvo's spherical-triangle sampling, translated line for
// line. `b` all zero with `pdf` zero is the degenerate answer the caller drops.
element SphTri {
    b : vec3f;
    pdf : Float;
}

func sample_spherical_triangle(p0 : vec3f, p1 : vec3f, p2 : vec3f,
                               p : vec3f, u : vec2f) -> SphTri {
    a = unit_vector_(p0 - p);
    b = unit_vector_(p1 - p);
    c = unit_vector_(p2 - p);
    n_ab0 = cross_(a, b);
    n_bc0 = cross_(b, c);
    n_ca0 = cross_(c, a);
    if (sqlen[[Float]](n_ab0) == 0.0) || (sqlen[[Float]](n_bc0) == 0.0) ||
       (sqlen[[Float]](n_ca0) == 0.0) {
        degenerate : SphTri = {vec3f{0.0, 0.0, 0.0}, 0.0};
        return degenerate;
    }
    n_ab = unit_vector_(n_ab0);
    n_bc = unit_vector_(n_bc0);
    n_ca = unit_vector_(n_ca0);

    alpha = angle_between(n_ab, -n_ca);
    beta = angle_between(n_bc, -n_ab);
    gam = angle_between(n_ca, -n_bc);

    a_pi = alpha + beta + gam;
    ap_pi = lerp_st(u.x, 3.14159265358979323846, a_pi);
    big_a = a_pi - 3.14159265358979323846;
    pdf = select(big_a <= 0.0, 0.0, 1.0 / big_a);

    cos_alpha = cos(alpha);
    sin_alpha = sin(alpha);
    sinp = sin(ap_pi) * cos_alpha - cos(ap_pi) * sin_alpha;
    cosp = cos(ap_pi) * cos_alpha + sin(ap_pi) * sin_alpha;
    k1 = cosp + cos_alpha;
    k2 = sinp - sin_alpha * dot(a, b);
    cos_bp0 = (k2 + diff_of_products(k2, cosp, k1, sinp) * cos_alpha) /
              (sum_of_products(k2, sinp, k1, cosp) * sin_alpha);
    cos_bp = min(max(cos_bp0, -1.0), 1.0);
    sin_bp = safe_sqrt(1.0 - sqr(cos_bp));
    cp = cos_bp * a + sin_bp * unit_vector_(gram_schmidt(c, a));

    cost = 1.0 - u.y * (1.0 - dot(cp, b));
    sint = safe_sqrt(1.0 - sqr(cost));
    w = cost * b + sint * unit_vector_(gram_schmidt(cp, b));

    e1 = p1 - p0;
    e2 = p2 - p0;
    s1 = cross_(w, e2);
    divisor = dot(s1, e1);
    if divisor == 0.0 {
        third : SphTri = {vec3f{0.33333333333333333, 0.33333333333333333,
                                0.33333333333333333}, pdf};
        return third;
    }
    inv = 1.0 / divisor;
    s = p - p0;
    b1 : mut Float = min(max(dot(s, s1) * inv, 0.0), 1.0);
    b2 : mut Float = min(max(dot(w, cross_(s, e1)) * inv, 0.0), 1.0);
    // pbrt divides b1 by the old sum and then b2 by the sum with the new b1 --
    // translated as written rather than corrected.
    if b1 + b2 > 1.0 {
        b1 = b1 / (b1 + b2);
        b2 = b2 / (b1 + b2);
    }
    out : SphTri = {vec3f{1.0 - b1 - b2, b1, b2}, pdf};
    return out;
}

// pbrt: InvertSphericalTriangleSample, the sample that would have produced the
// direction `w`. Used to weight the cosine warp in the PDF.
func invert_spherical_triangle_sample(p0 : vec3f, p1 : vec3f, p2 : vec3f,
                                      p : vec3f, w : vec3f) -> vec2f {
    a = unit_vector_(p0 - p);
    b = unit_vector_(p1 - p);
    c = unit_vector_(p2 - p);
    n_ab0 = cross_(a, b);
    n_bc0 = cross_(b, c);
    n_ca0 = cross_(c, a);
    if (sqlen[[Float]](n_ab0) == 0.0) || (sqlen[[Float]](n_bc0) == 0.0) ||
       (sqlen[[Float]](n_ca0) == 0.0) {
        return vec2f{0.0, 0.0};
    }
    n_ab = unit_vector_(n_ab0);
    n_bc = unit_vector_(n_bc0);
    n_ca = unit_vector_(n_ca0);

    alpha = angle_between(n_ab, -n_ca);
    beta = angle_between(n_bc, -n_ab);
    gam = angle_between(n_ca, -n_bc);

    cp0 = unit_vector_(cross_(cross_(b, w), cross_(c, a)));
    cp = select(dot(cp0, a + c) < 0.0, -cp0, cp0);

    u0 : mut Float = 0.0;
    if dot(a, cp) > 0.99999847691 {
        u0 = 0.0;
    } else {
        n_cpb0 = cross_(cp, b);
        n_acp0 = cross_(a, cp);
        if (sqlen[[Float]](n_cpb0) == 0.0) || (sqlen[[Float]](n_acp0) == 0.0) {
            return vec2f{0.5, 0.5};
        }
        n_cpb = unit_vector_(n_cpb0);
        n_acp = unit_vector_(n_acp0);
        ap = alpha + angle_between(n_ab, n_cpb) + angle_between(n_acp, -n_cpb) -
             3.14159265358979323846;
        big_a = alpha + beta + gam - 3.14159265358979323846;
        u0 = ap / big_a;
    }

    u1 = (1.0 - dot(w, b)) / (1.0 - dot(cp, b));
    return vec2f{min(max(u0, 0.0), 1.0), min(max(u1, 0.0), 1.0)};
}

// pbrt: Triangle::Sample(ctx, u). A direction into the solid angle the triangle
// subtends, warped so a corner the shading normal faces is chosen more often.
// The unstable extremes fall back to area sampling, converted to solid angle.
func triangle_sample(t : Triangle, ctx : ShapeSampleContext,
                     u_in : vec2f) -> option[ShapeSample] {
    p0 = triangle_p(t, 0u);
    p1 = triangle_p(t, 1u);
    p2 = triangle_p(t, 2u);
    solid = spherical_triangle_area(unit_vector_(p0 - ctx.p),
                                    unit_vector_(p1 - ctx.p),
                                    unit_vector_(p2 - ctx.p));
    if (solid < 0.0003) || (solid > 6.22) {
        area = triangle_sample_area(t, u_in);
        wi0 = area.p - ctx.p;
        if sqlen[[Float]](wi0) == 0.0 {
            return {};
        }
        wi = unit_vector_(wi0);
        denom = abs(dot(area.n, -wi)) / sqlen[[Float]](ctx.p - area.p);
        if denom == 0.0 {
            return {};
        }
        conv : mut ShapeSample = area;
        conv.pdf = area.pdf / denom;
        if conv.pdf == inf {
            return {};
        }
        return conv;
    }

    pdf_warp : mut Float = 1.0;
    u : mut vec2f = u_in;
    if sqlen[[Float]](ctx.ns) != 0.0 {
        wa = unit_vector_(p0 - ctx.p);
        wb = unit_vector_(p1 - ctx.p);
        wc = unit_vector_(p2 - ctx.p);
        // pbrt names wi[1] for both of the first two weights -- as written.
        w0 = max(0.01, abs(dot(ctx.ns, wb)));
        w1 = max(0.01, abs(dot(ctx.ns, wb)));
        w2 = max(0.01, abs(dot(ctx.ns, wa)));
        w3 = max(0.01, abs(dot(ctx.ns, wc)));
        u = sample_bilinear(u_in, w0, w1, w2, w3);
        pdf_warp = bilinear_pdf(u, w0, w1, w2, w3);
    }

    sph = sample_spherical_triangle(p0, p1, p2, ctx.p, u);
    if sph.pdf == 0.0 {
        return {};
    }
    bb = sph.b;
    p = bb.x * p0 + bb.y * p1 + bb.z * p2;
    p_abs = abs(bb.x * p0) + abs(bb.y * p1) + abs((1.0 - bb.x - bb.y) * p2);
    m = meshes[t.mesh];
    uv = triangle_uv_at(m, mesh_corner(m, t, 0u), mesh_corner(m, t, 1u),
                        mesh_corner(m, t, 2u), bb);
    ss : ShapeSample = {p, gamma(6) * p_abs, triangle_face_normal(t, bb), uv,
                        pdf_warp * sph.pdf};
    return ss;
}

// pbrt: Triangle::PDF(ctx, wi), the density triangle_sample draws `wi` with.
func triangle_pdf(t : Triangle, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    p0 = triangle_p(t, 0u);
    p1 = triangle_p(t, 1u);
    p2 = triangle_p(t, 2u);
    solid = spherical_triangle_area(unit_vector_(p0 - ctx.p),
                                    unit_vector_(p1 - ctx.p),
                                    unit_vector_(p2 - ctx.p));
    if (solid < 0.0003) || (solid > 6.22) {
        o = offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi);
        ray : Ray = {o, wi};
        hit = triangle_hit(ray, inf, t);
        if !hit {
            return 0.0;
        }
        h = *hit;
        p_is = h.b.x * p0 + h.b.y * p1 + h.b.z * p2;
        denom = abs(dot(triangle_face_normal(t, h.b), -wi)) /
                sqlen[[Float]](ctx.p - p_is);
        if denom == 0.0 {
            return 0.0;
        }
        pdf = (1.0 / triangle_area(t)) / denom;
        if pdf == inf {
            return 0.0;
        }
        return pdf;
    }

    pdf : mut Float = 1.0 / solid;
    if sqlen[[Float]](ctx.ns) != 0.0 {
        u = invert_spherical_triangle_sample(p0, p1, p2, ctx.p, wi);
        wa = unit_vector_(p0 - ctx.p);
        wb = unit_vector_(p1 - ctx.p);
        wc = unit_vector_(p2 - ctx.p);
        w0 = max(0.01, abs(dot(ctx.ns, wb)));
        w1 = max(0.01, abs(dot(ctx.ns, wb)));
        w2 = max(0.01, abs(dot(ctx.ns, wa)));
        w3 = max(0.01, abs(dot(ctx.ns, wc)));
        pdf = pdf * bilinear_pdf(u, w0, w1, w2, w3);
    }
    return pdf;
}

func patch_corner(m : TriangleMesh, b : BilinearPatch, corner : u32) -> u32 =
    m.first_vertex + mesh_indices[m.first_index + 4u * b.patch + corner];

// pbrt: Lerp(Float, Point3f, Point3f), `(1 - t) * p0 + t * p1` a component at
// a time; the contraction pass makes of it what gcc makes (see lerp_st).
func lerp3(t : Float, a : vec3f, b : vec3f) -> vec3f = (1.0 - t) * a + t * b;
func lerp2(t : Float, a : vec2f, b : vec2f) -> vec2f = (1.0 - t) * a + t * b;

func max_abs3(v : vec3f) -> Float = max(max(abs(v.x), abs(v.y)), abs(v.z));

// pbrt: Quadratic over floats (util/math.h) -- the roots in order, or none;
// a zero leading coefficient is the linear case, and the discriminant is the
// two-fma difference of products.
func quadratic_f(a : Float, b : Float, c : Float) -> option[QuadraticRoots] {
    if a == 0.0 {
        if b == 0.0 {
            return {};
        }
        linear : QuadraticRoots = {-c / b, -c / b};
        return linear;
    }
    discrim = diff_of_products(b, b, 4.0 * a, c);
    if discrim < 0.0 {
        return {};
    }
    root = sqrt(discrim);
    q = -0.5 * (b + copysign_(root, b));
    t0 = q / a;
    t1 = c / q;
    roots : QuadraticRoots = {min(t0, t1), max(t0, t1)};
    return roots;
}

// pbrt: SquareMatrix<3>::Determinant of the matrix whose columns are the
// three vectors -- `SquareMatrix<3>(a.x, b.x, c.x, a.y, b.y, c.y, a.z, b.z,
// c.z)` as IntersectBilinearPatch writes it -- with pbrt's minors, each a
// difference of products, and the last term fused.
func det3(a : vec3f, b : vec3f, c : vec3f) -> Float {
    minor12 = diff_of_products(b.y, c.z, c.y, b.z);
    minor02 = diff_of_products(a.y, c.z, c.y, a.z);
    minor01 = diff_of_products(a.y, b.z, b.y, a.z);
    return fma(c.x, minor01, diff_of_products(a.x, minor12, b.x, minor02));
}

// pbrt: IntersectBilinearPatch -- the ray against the two isolines of u the
// quadratic gives, each solved for v and t by Cramer's rule, the nearer one
// kept. The epsilon keeps a hit at the ray's own origin out, as pbrt's does.
func patch_hit(r : Ray, tmax : Float, b : BilinearPatch) -> option[PatchHit] {
    m = meshes[b.mesh];
    p00 = mesh_positions[patch_corner(m, b, 0u)];
    p10 = mesh_positions[patch_corner(m, b, 1u)];
    p01 = mesh_positions[patch_corner(m, b, 2u)];
    p11 = mesh_positions[patch_corner(m, b, 3u)];
    qa = dot_(cross_(p10 - p00, p01 - p11), r.d);
    qc = dot_(cross_(p00 - r.o, r.d), p01 - p00);
    qb = dot_(cross_(p10 - r.o, r.d), p11 - p10) - (qa + qc);
    roots = quadratic_f(qa, qb, qc);
    if !roots {
        return {};
    }
    u1 = (*roots).t0;
    u2 = (*roots).t1;
    // `hit_eps`, not `eps`: that name is the intrinsic's.
    hit_eps = gamma(30) * (max_abs3(r.o) + max_abs3(r.d) + max_abs3(p00) +
                           max_abs3(p10) + max_abs3(p01) + max_abs3(p11));
    t : mut Float = tmax;
    u : mut Float = 0.0;
    v : mut Float = 0.0;
    if (0.0 <= u1) && (u1 <= 1.0) {
        uo = lerp3(u1, p00, p10);
        ud = lerp3(u1, p01, p11) - uo;
        deltao = uo - r.o;
        perp = cross_(r.d, ud);
        p2 = sqlen_(perp);
        v1 = det3(deltao, r.d, perp);
        t1 = det3(deltao, ud, perp);
        if (t1 > p2 * hit_eps) && (0.0 <= v1) && (v1 <= p2) {
            u = u1;
            v = v1 / p2;
            t = t1 / p2;
        }
    }
    if (0.0 <= u2) && (u2 <= 1.0) && (u2 != u1) {
        uo = lerp3(u2, p00, p10);
        ud = lerp3(u2, p01, p11) - uo;
        deltao = uo - r.o;
        perp = cross_(r.d, ud);
        p2 = sqlen_(perp);
        v2 = det3(deltao, r.d, perp);
        t2 = det3(deltao, ud, perp) / p2;
        if (0.0 <= v2) && (v2 <= p2) && (t > t2) && (t2 > hit_eps) {
            t = t2;
            u = u2;
            v = v2 / p2;
        }
    }
    if t >= tmax {
        return {};
    }
    hit : PatchHit = {vec2f{u, v}, t};
    return hit;
}

// pbrt: BilinearPatch::IsRectangle -- four distinct coplanar corners the same
// distance from their centre.
func patch_is_rectangle(p00 : vec3f, p10 : vec3f, p01 : vec3f,
                        p11 : vec3f) -> bool {
    if (sqlen_(p00 - p01) == 0.0) || (sqlen_(p01 - p11) == 0.0) ||
       (sqlen_(p11 - p10) == 0.0) || (sqlen_(p10 - p00) == 0.0) {
        return false;
    }
    n = unit_vector_(cross_(p10 - p00, p01 - p00));
    if abs(dot_(unit_vector_(p11 - p00), n)) > 1e-5 {
        return false;
    }
    centre = (p00 + p01 + p10 + p11) / 4.0;
    d0 = sqlen_(p00 - centre);
    d1 = sqlen_(p01 - centre);
    d2 = sqlen_(p10 - centre);
    d3 = sqlen_(p11 - centre);
    return (abs(d1 - d0) / d0 <= 1e-4) && (abs(d2 - d0) / d0 <= 1e-4) &&
           (abs(d3 - d0) / d0 <= 1e-4);
}

// The normal a patch's point gets: pbrt's `Normalize(Cross(dpdu, dpdv))`,
// turned to face the interpolated vertex normal where the mesh has normals
// (FaceForward) and by the mesh's orientation where it has none.
func patch_face_normal(m : TriangleMesh, b : BilinearPatch, uv : vec2f,
                       dpdu : vec3f, dpdv : vec3f) -> vec3f {
    n = unit_vector_(cross_(dpdu, dpdv));
    if m.has_normals {
        n00 = mesh_normals[m.first_normal + patch_corner(m, b, 0u) - m.first_vertex];
        n10 = mesh_normals[m.first_normal + patch_corner(m, b, 1u) - m.first_vertex];
        n01 = mesh_normals[m.first_normal + patch_corner(m, b, 2u) - m.first_vertex];
        n11 = mesh_normals[m.first_normal + patch_corner(m, b, 3u) - m.first_vertex];
        ns = lerp3(uv.x, lerp3(uv.y, n00, n01), lerp3(uv.y, n10, n11));
        return select(dot_(n, ns) < 0.0, -n, n);
    }
    return select(m.flip, -n, n);
}

// pbrt: the (s, t) texture coordinates at a patch's (u, v) -- the mesh's own
// at the corners interpolated bilinearly, or (u, v) itself.
func patch_st(m : TriangleMesh, b : BilinearPatch, uv : vec2f) -> vec2f {
    if m.has_uv {
        uv00 = mesh_uvs[m.first_uv + patch_corner(m, b, 0u) - m.first_vertex];
        uv10 = mesh_uvs[m.first_uv + patch_corner(m, b, 1u) - m.first_vertex];
        uv01 = mesh_uvs[m.first_uv + patch_corner(m, b, 2u) - m.first_vertex];
        uv11 = mesh_uvs[m.first_uv + patch_corner(m, b, 3u) - m.first_vertex];
        return lerp2(uv.x, lerp2(uv.y, uv00, uv01), lerp2(uv.y, uv10, uv11));
    }
    return uv;
}

// pbrt: BilinearPatch::InteractionFromIntersection. The point and its two
// derivatives from the bilinear interpolation; where the mesh has texture
// coordinates, the derivatives re-expressed against (s, t) through the
// inverse of the coordinates' own bilinear map, kept only where that map is
// not degenerate, and turned so the normal does not flip; dndu and dndv from
// the fundamental forms (the second derivatives along u and along v are zero
// for a bilinear surface, the mixed one is the corner sum); the shading frame
// from the vertex normals, rotated into place by RotateFromTo, where the mesh
// has them.
func patch_geometry(b : BilinearPatch, uv : vec2f) -> SurfaceGeometry {
    m = meshes[b.mesh];
    i00 = patch_corner(m, b, 0u);
    i10 = patch_corner(m, b, 1u);
    i01 = patch_corner(m, b, 2u);
    i11 = patch_corner(m, b, 3u);
    p00 = mesh_positions[i00];
    p10 = mesh_positions[i10];
    p01 = mesh_positions[i01];
    p11 = mesh_positions[i11];
    p = lerp3(uv.x, lerp3(uv.y, p00, p01), lerp3(uv.y, p10, p11));
    dpdu0 = lerp3(uv.y, p10, p11) - lerp3(uv.y, p00, p01);
    dpdv0 = lerp3(uv.x, p01, p11) - lerp3(uv.x, p00, p10);

    st : mut vec2f = uv;
    duds : mut Float = 1.0;
    dudt : mut Float = 0.0;
    dvds : mut Float = 0.0;
    dvdt : mut Float = 1.0;
    dpdu : mut vec3f = dpdu0;
    dpdv : mut vec3f = dpdv0;
    if m.has_uv {
        uv00 = mesh_uvs[m.first_uv + i00 - m.first_vertex];
        uv10 = mesh_uvs[m.first_uv + i10 - m.first_vertex];
        uv01 = mesh_uvs[m.first_uv + i01 - m.first_vertex];
        uv11 = mesh_uvs[m.first_uv + i11 - m.first_vertex];
        st = lerp2(uv.x, lerp2(uv.y, uv00, uv01), lerp2(uv.y, uv10, uv11));
        dstdu = lerp2(uv.y, uv10, uv11) - lerp2(uv.y, uv00, uv01);
        dstdv = lerp2(uv.x, uv01, uv11) - lerp2(uv.x, uv00, uv10);
        duds = select(abs(dstdu.x) < 1e-8, 0.0, 1.0 / dstdu.x);
        dvds = select(abs(dstdv.x) < 1e-8, 0.0, 1.0 / dstdv.x);
        dudt = select(abs(dstdu.y) < 1e-8, 0.0, 1.0 / dstdu.y);
        dvdt = select(abs(dstdv.y) < 1e-8, 0.0, 1.0 / dstdv.y);
        dpds = dpdu0 * duds + dpdv0 * dvds;
        dpdt0 = dpdu0 * dudt + dpdv0 * dvdt;
        if sqlen_(cross_(dpds, dpdt0)) != 0.0 {
            dpdt = select(dot_(cross_(dpdu0, dpdv0), cross_(dpds, dpdt0)) < 0.0,
                          -dpdt0, dpdt0);
            dpdu = dpds;
            dpdv = dpdt;
        }
    }

    // pbrt: the fundamental forms. `e` and `g` are zero -- d2Pduu and d2Pdvv
    // are -- so their terms are written out as the zeroes they are.
    d2pduv = (p00 - p01) + (p11 - p10);
    ee = dot_(dpdu, dpdu);
    ff = dot_(dpdu, dpdv);
    gg = dot_(dpdv, dpdv);
    n_raw = unit_vector_(cross_(dpdu, dpdv));
    f2 = dot_(n_raw, d2pduv);
    egf2 = diff_of_products(ee, gg, ff, ff);
    inv_egf2 = select(egf2 == 0.0, 0.0, 1.0 / egf2);
    dndu_g = (f2 * ff) * inv_egf2 * dpdu + (-(f2 * ee)) * inv_egf2 * dpdv;
    dndv_g = (-(f2 * gg)) * inv_egf2 * dpdu + (f2 * ff) * inv_egf2 * dpdv;
    dnds_g = dndu_g * duds + dndv_g * dvds;
    dndt_g = dndu_g * dudt + dndv_g * dvdt;

    p_abs_sum = abs(p00) + abs(p01) + abs(p10) + abs(p11);
    p_err = gamma(6) * p_abs_sum;
    // pbrt: the SurfaceInteraction's normal, flipped by the mesh's
    // orientation -- `flipNormal` is reverseOrientation ^ swaps handedness.
    n0 = select(m.flip, -n_raw, n_raw);

    if !m.has_normals {
        plain : SurfaceGeometry = {n0, n0, dpdu, dpdv, st, dpdu, dpdv, dnds_g,
                                   dndt_g, p, p_err};
        return plain;
    }

    // pbrt: the shading normal interpolated from the corners' and, where it
    // does not cancel, set as authoritative -- the geometric normal is turned
    // to face it (SetShadingGeometry with orientationIsAuthoritative) -- and
    // the shading tangents are the geometric ones rotated from the geometric
    // normal to the shading one.
    n00 = mesh_normals[m.first_normal + i00 - m.first_vertex];
    n10 = mesh_normals[m.first_normal + i10 - m.first_vertex];
    n01 = mesh_normals[m.first_normal + i01 - m.first_vertex];
    n11 = mesh_normals[m.first_normal + i11 - m.first_vertex];
    ns_raw = lerp3(uv.x, lerp3(uv.y, n00, n01), lerp3(uv.y, n10, n11));
    if sqlen_(ns_raw) <= 0.0 {
        plain : SurfaceGeometry = {n0, n0, dpdu, dpdv, st, dpdu, dpdv, dnds_g,
                                   dndt_g, p, p_err};
        return plain;
    }
    ns = unit_vector_(ns_raw);
    dndu_s = lerp3(uv.y, n10, n11) - lerp3(uv.y, n00, n01);
    dndv_s = lerp3(uv.x, n01, n11) - lerp3(uv.x, n00, n10);
    dnds_s = dndu_s * duds + dndv_s * dvds;
    dndt_s = dndu_s * dudt + dndv_s * dvdt;
    rot = rotate_from_to(unit_vector_(n0), ns);
    dpdus = apply_rot(rot, dpdu);
    dpdvs = apply_rot(rot, dpdv);
    n = select(dot_(n0, ns) < 0.0, -n0, n0);
    shaded : SurfaceGeometry = {n, ns, dpdus, dpdvs, st, dpdu, dpdv, dnds_s,
                                dndt_s, p, p_err};
    return shaded;
}

// pbrt: the differential area at the four corners, the weights of the
// approximately uniform area sampling of a patch that is not a rectangle
// (SampleBilinear over them).
func patch_area_weights(p00 : vec3f, p10 : vec3f, p01 : vec3f,
                        p11 : vec3f) -> PatchWeights {
    w : PatchWeights = {norm(cross_(p10 - p00, p01 - p00)),
                        norm(cross_(p10 - p00, p11 - p10)),
                        norm(cross_(p01 - p00, p11 - p01)),
                        norm(cross_(p11 - p10, p11 - p01))};
    return w;
}

// pbrt: BilinearPatch::Sample(Point2f) -- a point by area: uniform in (u, v)
// on a rectangle, else warped by the corners' differential areas; the
// density per unit area, which is the (u, v) density over |dpdu x dpdv|.
func patch_sample_area(b : BilinearPatch, u : vec2f) -> option[ShapeSample] {
    m = meshes[b.mesh];
    p00 = mesh_positions[patch_corner(m, b, 0u)];
    p10 = mesh_positions[patch_corner(m, b, 1u)];
    p01 = mesh_positions[patch_corner(m, b, 2u)];
    p11 = mesh_positions[patch_corner(m, b, 3u)];
    pdf : mut Float = 1.0;
    uv : mut vec2f = u;
    if !patch_is_rectangle(p00, p10, p01, p11) {
        w = patch_area_weights(p00, p10, p01, p11);
        uv = sample_bilinear(u, w.w0, w.w1, w.w2, w.w3);
        pdf = bilinear_pdf(uv, w.w0, w.w1, w.w2, w.w3);
    }
    pu0 = lerp3(uv.y, p00, p01);
    pu1 = lerp3(uv.y, p10, p11);
    p = lerp3(uv.x, pu0, pu1);
    dpdu = pu1 - pu0;
    dpdv = lerp3(uv.x, p01, p11) - lerp3(uv.x, p00, p10);
    if (sqlen_(dpdu) == 0.0) || (sqlen_(dpdv) == 0.0) {
        return {};
    }
    n = patch_face_normal(m, b, uv, dpdu, dpdv);
    p_err = gamma(6) * (abs(p00) + abs(p01) + abs(p10) + abs(p11));
    ss : ShapeSample = {p, p_err, n, patch_st(m, b, uv),
                        pdf / norm(cross_(dpdu, dpdv))};
    return ss;
}

// pbrt: InvertBilinear (util/vecmath.h, after Inigo Quilez's inverse
// bilinear interpolation) -- the (u, v) at which the four corners' bilinear
// map gives `p`. The corners are pbrt's `vert` in its order: a = vert[0] =
// uv00, b = vert[1] = uv10, c = vert[3] = uv11, d = vert[2] = uv01.
func cross2d(a : vec2f, b : vec2f) -> Float = diff_of_products(a.x, b.y, a.y, b.x);
func invert_bilinear(p : vec2f, uv00 : vec2f, uv10 : vec2f, uv01 : vec2f,
                     uv11 : vec2f) -> vec2f {
    e = uv10 - uv00;
    f = uv01 - uv00;
    g = (uv00 - uv10) + (uv11 - uv01);
    h = p - uv00;
    k2 = cross2d(g, f);
    k1 = cross2d(e, f) + cross2d(h, g);
    k0 = cross2d(h, e);
    if abs(k2) < 0.001 {
        if abs(e.x * k1 - g.x * k0) < 1e-5 {
            return vec2f{(h.y * k1 + f.y * k0) / (e.y * k1 - g.y * k0), -k0 / k1};
        }
        return vec2f{(h.x * k1 + f.x * k0) / (e.x * k1 - g.x * k0), -k0 / k1};
    }
    roots = quadratic_f(k2, k1, k0);
    if !roots {
        return vec2f{0.0, 0.0};
    }
    v0 = (*roots).t0;
    v1 = (*roots).t1;
    u = (h.x - f.x * v0) / (e.x + g.x * v0);
    if (u < 0.0) || (u > 1.0) || (v0 < 0.0) || (v0 > 1.0) {
        return vec2f{(h.x - f.x * v1) / (e.x + g.x * v1), v1};
    }
    return vec2f{u, v0};
}

// pbrt: BilinearPatch::PDF(const Interaction &) -- the area density at a
// point on the patch given by its (s, t): back to (u, v) through the texture
// coordinates where the mesh has them, then the (u, v) density over
// |dpdu x dpdv|.
func patch_pdf_area(b : BilinearPatch, st : vec2f) -> Float {
    m = meshes[b.mesh];
    i00 = patch_corner(m, b, 0u);
    i10 = patch_corner(m, b, 1u);
    i01 = patch_corner(m, b, 2u);
    i11 = patch_corner(m, b, 3u);
    p00 = mesh_positions[i00];
    p10 = mesh_positions[i10];
    p01 = mesh_positions[i01];
    p11 = mesh_positions[i11];
    uv : mut vec2f = st;
    if m.has_uv {
        uv = invert_bilinear(st, mesh_uvs[m.first_uv + i00 - m.first_vertex],
                             mesh_uvs[m.first_uv + i10 - m.first_vertex],
                             mesh_uvs[m.first_uv + i01 - m.first_vertex],
                             mesh_uvs[m.first_uv + i11 - m.first_vertex]);
    }
    pdf : mut Float = 1.0;
    if !patch_is_rectangle(p00, p10, p01, p11) {
        w = patch_area_weights(p00, p10, p01, p11);
        pdf = bilinear_pdf(uv, w.w0, w.w1, w.w2, w.w3);
    }
    pu0 = lerp3(uv.y, p00, p01);
    pu1 = lerp3(uv.y, p10, p11);
    dpdu = pu1 - pu0;
    dpdv = lerp3(uv.x, p01, p11) - lerp3(uv.x, p00, p10);
    return pdf / norm(cross_(dpdu, dpdv));
}

// pbrt: SphericalQuadArea, the solid angle four unit directions subtend --
// the four dihedral angles less two pi, as a spherical triangle's is less pi.
func spherical_quad_area(a : vec3f, b : vec3f, c : vec3f, d : vec3f) -> Float {
    axb = cross_(a, b);
    bxc = cross_(b, c);
    cxd = cross_(c, d);
    dxa = cross_(d, a);
    if (sqlen_(axb) == 0.0) || (sqlen_(bxc) == 0.0) || (sqlen_(cxd) == 0.0) ||
       (sqlen_(dxa) == 0.0) {
        return 0.0;
    }
    axbn = unit_vector_(axb);
    bxcn = unit_vector_(bxc);
    cxdn = unit_vector_(cxd);
    dxan = unit_vector_(dxa);
    alpha = angle_between(dxan, -axbn);
    beta = angle_between(axbn, -bxcn);
    gamma_ = angle_between(bxcn, -cxdn);
    delta = angle_between(cxdn, -dxan);
    return abs(alpha + beta + gamma_ + delta - 2.0 * 3.14159265358979323846);
}

// pbrt: SampleSphericalRectangle (Ureña, Fajardo and King's "An Area-
// Preserving Parametrization for Spherical Rectangles", 2013, as pbrt
// writes it) -- a point on the rectangle `s + u ex + v ey` uniform in the
// solid angle it subtends from `p_ref`, and that solid angle's reciprocal as
// the density. The frame's z is turned to point away from the rectangle, so
// the rectangle sits at negative z0; a solid angle below 1e-3 falls back to
// the point uniform in area, with the density still the solid angle's.
func sample_spherical_rectangle(p_ref : vec3f, s : vec3f, ex : vec3f, ey : vec3f,
                                u : vec2f) -> SphericalRectangleSample {
    exl = norm(ex);
    eyl = norm(ey);
    r0 = frame_from_xy(ex / exl, ey / eyl);
    d_local = frame_to_local(r0, s - p_ref);
    flipped = d_local.z > 0.0;
    r : Frame = {r0.x, r0.y, select(flipped, -r0.z, r0.z)};
    z0 = select(flipped, -d_local.z, d_local.z);
    x0 = d_local.x;
    y0 = d_local.y;
    x1 = x0 + exl;
    y1 = y0 + eyl;
    v00 = vec3f{x0, y0, z0};
    v01 = vec3f{x0, y1, z0};
    v10 = vec3f{x1, y0, z0};
    v11 = vec3f{x1, y1, z0};
    n0 = unit_vector_(cross_(v00, v10));
    n1 = unit_vector_(cross_(v10, v11));
    n2 = unit_vector_(cross_(v11, v01));
    n3 = unit_vector_(cross_(v01, v00));
    g0 = angle_between(-n0, n1);
    g1 = angle_between(-n1, n2);
    g2 = angle_between(-n2, n3);
    g3 = angle_between(-n3, n0);
    pi_ = 3.14159265358979323846;
    solid_angle = g0 + g1 + g2 + g3 - 2.0 * pi_;
    if solid_angle <= 0.0 {
        none : SphericalRectangleSample = {s + u.x * ex + u.y * ey, 0.0};
        return none;
    }
    pdf = max(0.0, 1.0 / solid_angle);
    if solid_angle < 1e-3 {
        small : SphericalRectangleSample = {s + u.x * ex + u.y * ey, pdf};
        return small;
    }
    b0 = n0.z;
    b1 = n2.z;
    au = u.x * (g0 + g1 - 2.0 * pi_) + (u.x - 1.0) * (g2 + g3);
    fu = (cos(au) * b0 - b1) / sin(au);
    cu0 = copysign_(1.0 / sqrt(fu * fu + b0 * b0), fu);
    cu = min(max(cu0, -0.99999994), 0.99999994);
    xu0 = -(cu * z0) / safe_sqrt(1.0 - cu * cu);
    xu = min(max(xu0, x0), x1);
    dd = sqrt(xu * xu + z0 * z0);
    h0 = y0 / sqrt(dd * dd + y0 * y0);
    h1 = y1 / sqrt(dd * dd + y1 * y1);
    hv = h0 + u.y * (h1 - h0);
    hvsq = hv * hv;
    yv = select(hvsq < 1.0 - 1e-6, (hv * dd) / sqrt(1.0 - hvsq), y1);
    out : SphericalRectangleSample = {p_ref + frame_from_local(r, vec3f{xu, yv, z0}),
                                      pdf};
    return out;
}

// pbrt: InvertSphericalRectangleSample -- the (u, v) the sampler above would
// have taken to land on `p_rect`, for the density of a point reached some
// other way. pbrt's own notes on its stability are left where they are; the
// arithmetic is its, the solid angle summed in double as it sums it.
func invert_spherical_rectangle_sample(p_ref : vec3f, s : vec3f, ex : vec3f,
                                       ey : vec3f, p_rect : vec3f) -> vec2f {
    exl = norm(ex);
    eyl = norm(ey);
    r0 = frame_from_xy(ex / exl, ey / eyl);
    d_local = frame_to_local(r0, s - p_ref);
    flipped = d_local.z > 0.0;
    r : Frame = {r0.x, r0.y, select(flipped, -r0.z, r0.z)};
    z0 = select(flipped, -d_local.z, d_local.z);
    z0sq = z0 * z0;
    x0 = d_local.x;
    y0 = d_local.y;
    x1 = x0 + exl;
    y1 = y0 + eyl;
    y0sq = y0 * y0;
    y1sq = y1 * y1;
    v00 = vec3f{x0, y0, z0};
    v01 = vec3f{x0, y1, z0};
    v10 = vec3f{x1, y0, z0};
    v11 = vec3f{x1, y1, z0};
    n0 = unit_vector_(cross_(v00, v10));
    n1 = unit_vector_(cross_(v10, v11));
    n2 = unit_vector_(cross_(v11, v01));
    n3 = unit_vector_(cross_(v01, v00));
    g0 = angle_between(-n0, n1);
    g1 = angle_between(-n1, n2);
    g2 = angle_between(-n2, n3);
    g3 = angle_between(-n3, n0);
    b0 = n0.z;
    b1 = n2.z;
    b0sq = b0 * b0;
    b1sq = b1 * b1;
    pi_ = 3.14159265358979323846;
    two_pi_d : f64 = 6.283185307179586476925;
    solid_angle = cast[[Float]](cast[[f64]](g0) + cast[[f64]](g1) +
                                cast[[f64]](g2) + cast[[f64]](g3) - two_pi_d);
    if solid_angle < 1e-3 {
        pq = p_rect - s;
        return vec2f{dot_(pq, ex) / sqlen_(ex), dot_(pq, ey) / sqlen_(ey)};
    }
    v = frame_to_local(r, p_rect - p_ref);
    xu0 = min(max(v.x, x0), x1);
    xu = select(xu0 == 0.0, 1e-10, xu0);
    yv = v.y;
    invcusq = 1.0 + z0sq / (xu * xu);
    fusq = invcusq - b0sq;
    fu = copysign_(sqrt(fusq), xu);
    sqrt_ = safe_sqrt(diff_of_products(b0, b0, b1, b1) + fusq);
    au0 = atan2(-(b1 * fu) - copysign_(b0 * sqrt_, fu * b0),
                b0 * b1 - sqrt_ * abs(fu));
    au1 = select(au0 > 0.0, au0 - 2.0 * pi_, au0);
    au = select(fu == 0.0, pi_, au1);
    u0 = (au + g2 + g3) / solid_angle;
    ddsq = xu * xu + z0sq;
    dd = sqrt(ddsq);
    h0 = y0 / sqrt(ddsq + y0sq);
    h1 = y1 / sqrt(ddsq + y1sq);
    yvsq = yv * yv;
    root_term = abs(h0 - h1) * sqrt(yvsq * (ddsq + yvsq)) / (ddsq + yvsq);
    denom = (h0 - h1) * (h0 - h1);
    u1a = (diff_of_products(h0, h0, h0, h1) - root_term) / denom;
    u1b = (diff_of_products(h0, h0, h0, h1) + root_term) / denom;
    // pbrt: of the two roots, the one whose y comes back closest to yv.
    hva = lerp_st(u1a, h0, h1);
    hvb = lerp_st(u1b, h0, h1);
    yza = (hva * dd) / sqrt(1.0 - hva * hva);
    yzb = (hvb * dd) / sqrt(1.0 - hvb * hvb);
    u1 = select(abs(yza - yv) < abs(yzb - yv), u1a, u1b);
    return vec2f{min(max(u0, 0.0), 1.0), u1};
}

// pbrt: BilinearPatch::Sample(ctx, u). A rectangle large enough in solid
// angle is sampled as a spherical rectangle, with the cosine warp over its
// four corners where the point has a shading normal; anything else -- a
// patch that is not a rectangle, or a small one -- by area, converted to
// solid angle.
func patch_sample(b : BilinearPatch, ctx : ShapeSampleContext,
                  u_in : vec2f) -> option[ShapeSample] {
    m = meshes[b.mesh];
    p00 = mesh_positions[patch_corner(m, b, 0u)];
    p10 = mesh_positions[patch_corner(m, b, 1u)];
    p01 = mesh_positions[patch_corner(m, b, 2u)];
    p11 = mesh_positions[patch_corner(m, b, 3u)];
    v00 = unit_vector_(p00 - ctx.p);
    v10 = unit_vector_(p10 - ctx.p);
    v01 = unit_vector_(p01 - ctx.p);
    v11 = unit_vector_(p11 - ctx.p);
    if !patch_is_rectangle(p00, p10, p01, p11) ||
       (spherical_quad_area(v00, v10, v11, v01) <= 1e-4) {
        area = patch_sample_area(b, u_in);
        if !area {
            return {};
        }
        ss = *area;
        wi0 = ss.p - ctx.p;
        if sqlen_(wi0) == 0.0 {
            return {};
        }
        wi = unit_vector_(wi0);
        denom = abs(dot_(ss.n, -wi)) / sqlen_(ctx.p - ss.p);
        conv : mut ShapeSample = ss;
        conv.pdf = ss.pdf / denom;
        if conv.pdf == inf {
            return {};
        }
        return conv;
    }
    pdf : mut Float = 1.0;
    u : mut vec2f = u_in;
    if sqlen_(ctx.ns) != 0.0 {
        w0 = max(0.01, abs(dot_(v00, ctx.ns)));
        w1 = max(0.01, abs(dot_(v10, ctx.ns)));
        w2 = max(0.01, abs(dot_(v01, ctx.ns)));
        w3 = max(0.01, abs(dot_(v11, ctx.ns)));
        u = sample_bilinear(u_in, w0, w1, w2, w3);
        pdf = pdf * bilinear_pdf(u, w0, w1, w2, w3);
    }
    eu = p10 - p00;
    ev = p01 - p00;
    sq = sample_spherical_rectangle(ctx.p, p00, eu, ev, u);
    pdf = pdf * sq.pdf;
    uv = vec2f{dot_(sq.p - p00, eu) / sqlen_(p10 - p00),
               dot_(sq.p - p00, ev) / sqlen_(p01 - p00)};
    n = patch_face_normal(m, b, uv, eu, ev);
    // pbrt: `Interaction(p, n, ctx.time, st)` -- a sampled point carries no
    // error bound here.
    ss : ShapeSample = {sq.p, vec3f{0.0, 0.0, 0.0}, n, patch_st(m, b, uv), pdf};
    return ss;
}

// pbrt: BilinearPatch::PDF(ctx, wi) -- the density `patch_sample` would have
// given the point the ray from `ctx` along `wi` reaches, or zero if it reaches
// none.
func patch_pdf(b : BilinearPatch, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    o = offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi);
    ray : Ray = {o, wi};
    hit = patch_hit(ray, inf, b);
    if !hit {
        return 0.0;
    }
    g = patch_geometry(b, (*hit).uv);
    m = meshes[b.mesh];
    p00 = mesh_positions[patch_corner(m, b, 0u)];
    p10 = mesh_positions[patch_corner(m, b, 1u)];
    p01 = mesh_positions[patch_corner(m, b, 2u)];
    p11 = mesh_positions[patch_corner(m, b, 3u)];
    v00 = unit_vector_(p00 - ctx.p);
    v10 = unit_vector_(p10 - ctx.p);
    v01 = unit_vector_(p01 - ctx.p);
    v11 = unit_vector_(p11 - ctx.p);
    quad = spherical_quad_area(v00, v10, v11, v01);
    if !patch_is_rectangle(p00, p10, p01, p11) || (quad <= 1e-4) {
        pdf = patch_pdf_area(b, g.uv) *
              (sqlen_(ctx.p - g.p) / abs(dot_(g.n, -wi)));
        return select(pdf == inf, 0.0, pdf);
    }
    pdf = 1.0 / quad;
    if sqlen_(ctx.ns) != 0.0 {
        w0 = max(0.01, abs(dot_(v00, ctx.ns)));
        w1 = max(0.01, abs(dot_(v10, ctx.ns)));
        w2 = max(0.01, abs(dot_(v01, ctx.ns)));
        w3 = max(0.01, abs(dot_(v11, ctx.ns)));
        u = invert_spherical_rectangle_sample(ctx.p, p00, p10 - p00, p01 - p00,
                                              g.p);
        return bilinear_pdf(u, w0, w1, w2, w3) * pdf;
    }
    return pdf;
}

// pbrt: Shape::Sample and Shape::PDF, dispatched over the variants -- which is
// what pbrt's TaggedPointer does.
func shape_sample(sh : Shape, ctx : ShapeSampleContext,
                  u : vec2f) -> option[ShapeSample] {
    match sh {
        Sph(s) => return sphere_sample(s, ctx, u);
        Tri(t) => return triangle_sample(t, ctx, u);
        Dsk(d) => return disk_sample(d, ctx, u);
        Blp(b) => return patch_sample(b, ctx, u);
        Cyl(c) => return cylinder_sample(c, ctx, u);
        // pbrt: Curve::Sample is `LOG_FATAL("not implemented")`; the
        // converter refuses an emissive curve, so this is never asked.
        Crv(cv) => return {};
    }
}

func shape_pdf(sh : Shape, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    match sh {
        Sph(s) => return sphere_pdf(s, ctx, wi);
        Tri(t) => return triangle_pdf(t, ctx, wi);
        Dsk(d) => return disk_pdf(d, ctx, wi);
        Blp(b) => return patch_pdf(b, ctx, wi);
        Cyl(c) => return cylinder_pdf(c, ctx, wi);
        Crv(cv) => return 0.0;
    }
}

func surface_geometry(sh : Shape, r : Ray) -> SurfaceGeometry {
    away = -r.d;
    missed : SurfaceGeometry = {away, away, vec3f{1.0, 0.0, 0.0},
                                vec3f{0.0, 1.0, 0.0}, vec2f{0.0, 0.0},
                                vec3f{1.0, 0.0, 0.0}, vec3f{0.0, 1.0, 0.0},
                                vec3f{0.0, 0.0, 0.0}, vec3f{0.0, 0.0, 0.0},
                                r.o, vec3f{0.0, 0.0, 0.0}};
    // Unbounded: the ray was found to hit this shape within the query's
    // bound, and the nearest hit ahead of the ray is that one.
    match sh {
        Sph(s) => {
            hit = sphere_hit(r, inf, s);
            if hit {
                return sphere_geometry(s, *hit);
            }
            return missed;
        }
        Tri(tri) => {
            hit = triangle_hit(r, inf, tri);
            if hit {
                return triangle_geometry(tri, (*hit).b);
            }
            // The shape is the query's hit, so this is a hit the hardware's
            // test reported and pbrt's software test refuses -- nearer than
            // its error bound allows, or on an edge the two tests round apart
            // (the RT cores report from 1e-7 on, as pbrt's do). The geometry
            // is still this triangle's at the ray's point in its plane: the
            // same projection without the refusals. Answering `missed` here
            // put the hit at the ray's own origin, and a shadow ray crossing
            // a medium boundary re-spawned from there forever.
            lax = triangle_test(r, inf, tri, false);
            if lax {
                return triangle_geometry(tri, (*lax).b);
            }
            return missed;
        }
        Dsk(d) => {
            hit = disk_hit(r, inf, d);
            if hit {
                return disk_geometry(d, *hit);
            }
            return missed;
        }
        Blp(b) => {
            hit = patch_hit(r, inf, b);
            if hit {
                return patch_geometry(b, (*hit).uv);
            }
            return missed;
        }
        Cyl(c) => {
            hit = cylinder_hit(r, inf, c);
            if hit {
                return cylinder_geometry(c, *hit);
            }
            return missed;
        }
        Crv(cv) => {
            hit = curve_hit(r, inf, cv);
            if hit {
                return curve_geometry(cv, r, *hit);
            }
            return missed;
        }
    }
}

// pbrt: `isect.wo` -- the SurfaceInteraction's own copy of the direction the
// ray came from, which is not `-ray.d`. Interaction's constructor normalizes
// the direction it is handed; a quadric hands it the direction in object
// space (`woObject = (*objectFromRender)(wo)`), and the transform out
// normalizes it again (`ret.wo = Normalize(t(si.wo))`); a triangle or a
// patch hands it the render-space direction, normalized once. Unit to begin
// with and unit after, but not the same bits -- and a layered BSDF's walk is
// seeded by hashing this vector, so where pbrt reads `isect.wo` (the
// visible surface's `rho`, `SampleLd`'s `intr.wo`, MixMaterial's choice,
// everything in the wavefront's kernels) this is what it has to be given.
// Where pbrt writes `-ray.d` (`Le` and `Sample_f` in its CPU integrators),
// the caller keeps that. The instance's transform, where there is one, is
// the caller's to apply after (render.bonsai's hit_wo).
func interaction_wo(sh : Shape, wo : vec3f) -> vec3f {
    match sh {
        Sph(s) => return unit_vector_(apply_vector(
            s.render_from_object,
            unit_vector_(apply_vector(s.object_from_render, wo))));
        Dsk(d) => return unit_vector_(apply_vector(
            d.render_from_object,
            unit_vector_(apply_vector(d.object_from_render, wo))));
        Cyl(c) => return unit_vector_(apply_vector(
            c.render_from_object,
            unit_vector_(apply_vector(c.object_from_render, wo))));
        Tri(t) => return unit_vector_(wo);
        Blp(b) => return unit_vector_(wo);
        // A curve's interaction takes `-ray.d` of the object-space ray (the
        // plain vector transform; the nudge moves the origin alone) and the
        // transform out, the quadric's round trip.
        Crv(cv) => {
            frame = curve_frames[curve_commons[cv.common].frame];
            return unit_vector_(apply_vector(
                frame.render_from_object,
                unit_vector_(apply_vector(frame.object_from_render, wo))));
        }
    }
}
