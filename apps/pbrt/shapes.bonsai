// pbrt: the shapes a ray can hit, and the bounding volume a BVH node uses.
//
// Sphere::BasicIntersect, IntersectTriangle and Bounds3::IntersectP, together
// with the Shape variant that dispatches between the first two. The geometry
// deliberately does not come from bonsai's stdlib: stdlib/sphere.bonsai and
// stdlib/intersects.bonsai are derived from Ray Tracing in One Weekend and are
// not numerically what pbrt does, which showed up as pixels disagreeing along
// silhouettes.
import stdlib/numerics;
import apps/pbrt/frame;
import apps/pbrt/interval;
import apps/pbrt/sampling;
import apps/pbrt/transform;

// pbrt: Ray -- the origin and the direction. pbrt's carries a time and a
// medium too; this program has no motion blur, and the medium travels beside
// the ray as an index. The far bound is not a field of the ray, as it is not
// in pbrt: every Intersect takes `(ray, tMax)`, and the bound travels beside
// the ray -- infinity for a path's, `1 - ShadowEpsilon` for a shadow ray's --
// so that a ray in a queue is what pbrt's RayWorkItem holds and no more.
element Ray {
    o : vec3f;
    d : vec3f;
}

// pbrt: the `(Ray, Float tMax)` that Intersect and IntersectP take, as the
// one object a tree query prunes with: the ray, and how far along it a hit
// counts. A spatial relation is between two objects, so the bound has to ride
// with the ray for the query's length; it is built where the query is asked
// and lives no longer.
element RaySegment {
    ray : Ray;
    tmax : Float;
}

// pbrt: Sphere. pbrt keeps a transform and a radius and works in object space,
// where the sphere is at the origin; these are placed by a translation only,
// so object space is reached by subtracting the centre.
element Sphere {
    center : vec3f;
    radius : Float;
    // pbrt: reverseOrientation ^ transformSwapsHandedness, which decides which
    // way the surface normal points. Invisible in the gbuffer, whose normal is
    // turned to face the camera whichever way this falls, and not invisible in
    // a shading frame -- flipping the normal flips the frame's y axis with it,
    // and a layered BSDF is seeded by hashing the direction it is asked about.
    flip : bool = false;
}

// pbrt: TriangleMesh, and the arrays every mesh in the scene shares.
//
// pbrt keeps one of these per mesh in a global list and a Triangle names the
// list entry; the arrays here are that list's contents laid end to end, so a
// mesh is where its own run of each begins. `vertexIndices` are mesh-local in
// pbrt, which is what `first_vertex` adds back.
//
// The normals and the texture coordinates are separately offset because a mesh
// that has neither contributes nothing to either pool -- and because absence is
// not the same as a default. A mesh with no normals takes a different path
// entirely, where the shading normal is the geometric one; a mesh with no
// texture coordinates gets pbrt's (0,0), (1,0), (1,1), which are per triangle
// rather than per vertex and so cannot be stored in a pool at all.
element TriangleMesh {
    first_index : u32;
    first_vertex : u32;
    first_normal : u32;
    first_uv : u32;
    has_normals : bool;
    has_uv : bool;
    // pbrt: reverseOrientation ^ transformSwapsHandedness. See Sphere above.
    flip : bool;
}

extern meshes : array[TriangleMesh];
extern mesh_indices : array[u32];
extern mesh_positions : array[vec3f];
extern mesh_normals : array[vec3f];
extern mesh_uvs : array[vec2f];

// pbrt: Triangle, which is a mesh index and a triangle index and nothing else.
// The vertex data is fetched from the shared mesh on a hit.
//
// That is the whole of why a primitive here is the size of a sphere rather than
// the size of a triangle's worth of vertices: a triangle used to carry its own
// copy of three positions, three normals and three texture coordinates, and
// every sphere in the scene paid for it too, because a variant is as large as
// its largest arm.
element Triangle {
    mesh : u32;
    tri : u32;
}

// The three vertices of a triangle, which is what pbrt's
// `const int *v = &mesh->vertexIndices[3 * triIndex]` names.
func mesh_corner(m : TriangleMesh, t : Triangle, corner : u32) -> u32 =
    m.first_vertex + mesh_indices[m.first_index + 3u * t.tri + corner];

func triangle_p(t : Triangle, corner : u32) -> vec3f =
    mesh_positions[mesh_corner(meshes[t.mesh], t, corner)];

// The two solutions of the quadratic, each still an interval, so that the
// caller can ask about a bound rather than about a value.
element Roots {
    t0, t1 : Interval;
}

// pbrt: Sphere::BasicIntersect, in the interval arithmetic pbrt carries the
// coefficients in.
//
// The intervals are what make the decisions trustworthy at grazing incidence.
// A ray that nearly misses gives a discriminant whose exact sign is lost to
// rounding; asking `discrim.LowerBound() < 0` instead asks whether it is
// *certainly* negative, so a ray is only rejected when no rounding of the
// inputs could have made it hit.
//
// The discriminant is also factored the way pbrt factors it -- the distance
// from the centre to the ray's closest approach, rather than b^2 - 4ac -- so
// that the subtraction happens between two numbers that are not nearly equal.
// Both matter: the factoring keeps the value accurate, the intervals keep the
// comparison honest about what accuracy is left.
func sphere_roots(r : Ray, s : Sphere) -> option[Roots] {
    // Object space: the sphere is at the origin. These spheres are placed by a
    // translation, so that is the transform whose error the intervals carry.
    oix = point_to_object(r.o.x, s.center.x);
    oiy = point_to_object(r.o.y, s.center.y);
    oiz = point_to_object(r.o.z, s.center.z);
    dix = vector_to_object(r.d.x);
    diy = vector_to_object(r.d.y);
    diz = vector_to_object(r.d.z);

    a = iadd(iadd(isqr(dix), isqr(diy)), isqr(diz));
    b = imulf(2.0, iadd(iadd(imul(dix, oix), imul(diy, oiy)),
                        imul(diz, oiz)));
    c = isub(iadd(iadd(isqr(oix), isqr(oiy)), isqr(oiz)),
             isqr(exact(s.radius)));

    // v = oi - (b / 2a) * di, the vector from the centre to the ray's closest
    // approach, and |v| its distance.
    half = idiv(b, imulf(2.0, a));
    vx = isub(oix, imul(half, dix));
    vy = isub(oiy, imul(half, diy));
    vz = isub(oiz, imul(half, diz));
    length = isqrt(iadd(iadd(isqr(vx), isqr(vy)), isqr(vz)));

    // Grouped as pbrt groups it: ((4a)(r + |v|))(r - |v|). Interval
    // multiplication is not associative, so the grouping is part of the answer.
    radius = exact(s.radius);
    discrim = imul(imul(imulf(4.0, a), iadd(radius, length)),
                   isub(radius, length));
    // Certainly negative, rather than negative once rounded.
    if discrim.low < 0.0 {
        return {};
    }

    root_discrim = isqrt(discrim);
    // The pairing that avoids cancelling in whichever root is small.
    q : mut = imulf(-0.5, iadd(b, root_discrim));
    if mid(b) < 0.0 {
        q = imulf(-0.5, isub(b, root_discrim));
    }

    t0 : mut = idiv(q, a);
    t1 : mut = idiv(c, q);
    // Ordered by lower bound, which is the order that survives rounding.
    if t0.low > t1.low {
        swap = t0;
        t0 = t1;
        t1 = swap;
    }

    roots : Roots = {t0, t1};
    return roots;
}

// pbrt: the tail of BasicIntersect, which picks the nearer root that is
// actually ahead of the ray and within tMax. Every test is on a bound rather
// than on the interval's value: a root is only rejected when it is certainly
// out of range, so a hit is never dropped because rounding pushed it a few ulp
// past the boundary. This is the test for a sphere the ray is trying to *hit*.
func sphere_t(r : Ray, tmax : Float, s : Sphere) -> option[Float] {
    found = sphere_roots(r, s);
    if !found {
        return {};
    }
    roots = *found;
    if (roots.t0.high > tmax) | (roots.t1.low <= 0.0) {
        return {};
    }
    if roots.t0.low <= 0.0 {
        // The near root is behind the ray, so the far one is the hit -- if it
        // is in range at all.
        if roots.t1.high > tmax {
            return {};
        }
        return mid(roots.t1);
    }
    return mid(roots.t0);
}

// pbrt: Bounds3f, and the bounding volume the schedule gives a BVH node.
element AABB {
    low, high : vec3f;
}

// The stretch of the ray that lies inside a box, which is a different question
// from where it hits a surface.
element Span {
    lo, hi : Float;
}

// pbrt: Bounds3::IntersectP, the overload the BVH traversal calls, which is a
// slab test: the ray is clipped against the pair of parallel planes on each
// axis, and what survives all three is the interval it spends inside the box.
//
// This is deliberately not interval arithmetic, and pbrt does not use it here
// either. A node test only has to be conservative -- never report a miss where
// something inside could be hit -- and it runs at every node of the tree, so
// pbrt buys that conservatism with a single widening of the far bound rather
// than with a proof. The provable bound is spent where it decides something,
// in sphere_t. Measured on this scene, a node test carrying intervals cost
// 355ms against 50ms for the identical image.
//
// The widening is the whole robustness argument: the divisions and
// subtractions above it can each round the far plane inwards, and a ray
// entering exactly at a face would then be clipped out of a node it really
// does touch. gamma(3) bounds those three roundings, and doubling it is
// pbrt's margin.
func aabb_span(r : Ray, b : AABB) -> option[Span] {
    inv_dir = 1.0 / r.d;
    dir_is_neg = inv_dir < 0.0;

    // Which face of each slab the ray meets first depends on its direction.
    near_face = select(dir_is_neg, b.high, b.low);
    far_face = select(dir_is_neg, b.low, b.high);
    t_near = (near_face - r.o) * inv_dir;
    t_far : mut = (far_face - r.o) * inv_dir;
    t_far *= 1.0 + 2.0 * gamma(3);

    // x against y, then the survivor against z. Ordered as pbrt orders it so
    // that a NaN from a zero direction component falls the same way.
    if (t_near.x > t_far.y) | (t_near.y > t_far.x) {
        return {};
    }
    lo : mut = max(t_near.x, t_near.y);
    hi : mut = min(t_far.x, t_far.y);

    if (lo > t_far.z) | (t_near.z > hi) {
        return {};
    }
    lo = max(lo, t_near.z);
    hi = min(hi, t_far.z);

    span : Span = {lo, hi};
    return span;
}

// What the tree lowering prunes with. `intersects` is pbrt's return value from
// IntersectP; the two distances are the ends of the span, and a miss reports
// an empty interval the wrong way round so that nothing selects it.
func distmin(q : RaySegment, b : AABB) -> Float {
    found = aabb_span(q.ray, b);
    if found {
        span = *found;
        return span.lo;
    }
    return -inf;
}

func distmax(q : RaySegment, b : AABB) -> Float {
    found = aabb_span(q.ray, b);
    if found {
        span = *found;
        return span.hi;
    }
    return inf;
}

func intersects(q : RaySegment, b : AABB) -> bool {
    found = aabb_span(q.ray, b);
    if found {
        span = *found;
        return (span.lo < q.tmax) & (span.hi > 0.0);
    }
    return false;
}

// The other half of what the tree lowering prunes with, and the half only an
// `any` query asks for.
//
// `intersects` is the *necessary* condition -- a node the ray misses holds
// nothing the ray hits, so the traversal can skip it. `contains` is the
// *sufficient* one: a node the ray contains entirely holds nothing the ray
// misses, so an `any` could answer yes without descending into it at all. The
// lowering asks for both and uses whichever its query needs.
//
// For a ray the sufficient condition is never satisfiable and this is always
// false. A ray is a one-dimensional set of points and a box with any extent is
// three-dimensional, so no ray contains a box; the early-out this would license
// cannot fire, and a shadow ray's saving comes from the other direction --
// stopping at the first primitive that answers yes rather than ordering every
// one that could be nearer.
//
// Written out rather than left for the lowering to fail on, because "no ray
// contains a box" is a fact about geometry and this is where this app keeps
// those. A `contains` that guessed `true` would prune away real occluders and
// light the scene through walls.
func contains(q : RaySegment, b : AABB) -> bool = false;

// pbrt: TriangleIntersection, which is where a ray met a triangle: how far
// along, and where in the triangle. The barycentrics are what the shading
// geometry interpolates the vertex normals with, so the intersection has to
// hand them back rather than only the distance.
element TriangleHit {
    t : Float;
    b : vec3f;
}

// pbrt: IntersectTriangle from shapes.cpp, which is watertight: the ray is
// moved to its own coordinate space, the largest component of its direction
// is permuted into z, and the vertices are sheared so that the edge tests are
// exact in sign. The error bounds at the end are pbrt's, and they are what
// keeps a ray from slipping between two triangles that share an edge.
func triangle_hit(ray : Ray, tmax : Float, tri : Triangle) -> option[TriangleHit] {
    p0 = triangle_p(tri, 0u);
    p1 = triangle_p(tri, 1u);
    p2 = triangle_p(tri, 2u);

    // Degenerate triangles have no interior to hit.
    if (sqlen[[Float]](cross_(p2 - p0, p1 - p0)) == 0)
        return {};

    // Translate the vertices so the ray starts at the origin.
    p0t : mut = p0 - ray.o;
    p1t : mut = p1 - ray.o;
    p2t : mut = p2 - ray.o;

    // Permute so that the ray's dominant direction is z.
    kz : u32 = idxmax(abs(ray.d));
    kx = (kz + 1) % 3;
    ky = (kx + 1) % 3;
    d = permute(ray.d, {kx, ky, kz});
    p0t = permute(p0t, {kx, ky, kz});
    p1t = permute(p1t, {kx, ky, kz});
    p2t = permute(p2t, {kx, ky, kz});

    // Shear, so that the ray becomes +z and the edge tests are 2D.
    //
    // pbrt writes each of these as `p0t.x += Sx * p0t.z`, one statement, which
    // its compiler contracts into a single fused multiply-add. Written as the
    // fma here because the sheared coordinates are what the edge functions are
    // computed from, and an edge function one bit out is a barycentric one bit
    // out -- which is invisible in the distance to the hit and is not invisible
    // in the shading normal interpolated with it, nor in the frame a layered
    // BSDF hashes to seed its walk.
    Sx = -d.x / d.z;
    Sy = -d.y / d.z;
    Sz = 1 / d.z;
    p0t = vec3f{fma(Sx, p0t.z, p0t.x), fma(Sy, p0t.z, p0t.y), p0t.z};
    p1t = vec3f{fma(Sx, p1t.z, p1t.x), fma(Sy, p1t.z, p1t.y), p1t.z};
    p2t = vec3f{fma(Sx, p2t.z, p2t.x), fma(Sy, p2t.z, p2t.y), p2t.z};

    // Edge functions, by a difference of products that does not cancel.
    e0 = prod_diff[[Float]](p1t.x, p2t.y, p1t.y, p2t.x);
    e1 = prod_diff[[Float]](p2t.x, p0t.y, p2t.y, p0t.x);
    e2 = prod_diff[[Float]](p0t.x, p1t.y, p0t.y, p1t.x);

    // TODO: pbrt falls back to double precision when an edge function is
    // exactly zero, which is where a ray meets a shared edge.

    if ((e0 < 0 || e1 < 0 || e2 < 0) && (e0 > 0 || e1 > 0 || e2 > 0))
        return {};
    det = e0 + e1 + e2;
    if (det == 0)
        return {};

    p0t.z *= Sz;
    p1t.z *= Sz;
    p2t.z *= Sz;

    tScaled = e0 * p0t.z + e1 * p1t.z + e2 * p2t.z;
    if (det < 0 && (tScaled >= 0 || tScaled < tmax * det))
        return {};
    else if (det > 0 && (tScaled <= 0 || tScaled > tmax * det))
        return {};

    invDet = 1 / det;
    t = tScaled * invDet;

    // pbrt's bound on the error in t, so that a hit is only reported when it
    // is conservatively in front of the ray.
    maxZt = max(abs(vec3f{p0t.z, p1t.z, p2t.z}));
    deltaZ = gamma(3) * maxZt;
    maxXt = max(abs(vec3f{p0t.x, p1t.x, p2t.x}));
    maxYt = max(abs(vec3f{p0t.y, p1t.y, p2t.y}));
    deltaX = gamma(5) * (maxXt + maxZt);
    deltaY = gamma(5) * (maxYt + maxZt);
    deltaE = 2 * (gamma(2) * maxXt * maxYt + deltaY * maxXt + deltaX * maxYt);
    maxE = max(abs(vec3f{e0, e1, e2}));
    deltaT = 3 * (gamma(3) * maxE * maxZt + deltaE * maxZt + deltaZ * maxE) * abs(invDet);
    if (t <= deltaT)
        return {};

    hit : TriangleHit = {t, vec3f{e0 * invDet, e1 * invDet, e2 * invDet}};
    return hit;
}

// The distance alone, which is all the tree query needs.
func triangle_t(ray : Ray, tmax : Float, tri : Triangle) -> option[Float] {
    hit = triangle_hit(ray, tmax, tri);
    if hit {
        return (*hit).t;
    }
    return {};
}

// A triangle is flat, so the near and far distance to it are the same one.
func distmin(q : RaySegment, tri : Triangle) -> Float {
    t = triangle_t(q.ray, q.tmax, tri);
    if t {
        return *t;
    }
    return inf;
}

func distmax(q : RaySegment, tri : Triangle) -> Float {
    t = triangle_t(q.ray, q.tmax, tri);
    if t {
        return *t;
    }
    return -inf;
}

func intersects(q : RaySegment, tri : Triangle) -> bool {
    return cast[[bool]](triangle_t(q.ray, q.tmax, tri));
}

// pbrt: Disk -- a flat annulus, or a sector of one, in the plane z = height of
// an object space of its own, placed in the scene by a transform, as pbrt's
// every quadric is. The sphere above is admitted by scene_dump only under a
// translation and kept in render space by its centre; a disk is oriented, so
// its transform comes with it, both ways round: a ray is pulled into object
// space by `object_from_render` and the hit is pushed out by
// `render_from_object`, which is pbrt's `(*objectFromRender)(ray)` and
// `(*renderFromObject)(SurfaceInteraction(...))`, and the same two functions
// an instance's tree is entered and left by.
//
// Two flags, because pbrt has two and uses them in different places. `flip` is
// reverseOrientation ^ transformSwapsHandedness, which
// InteractionFromIntersection turns a *hit's* normal by; `reverse` is
// reverseOrientation alone, which `Sample` turns a *sampled* point's normal
// by. Under a transform that mirrors, the two differ, and both are pbrt's.
// `phi_max` is in radians, clamped to a turn, as the constructor leaves it.
element Disk {
    render_from_object : Transform;
    object_from_render : Transform;
    height : Float;
    radius : Float;
    inner_radius : Float;
    phi_max : Float;
    flip : bool;
    reverse : bool;
}

// pbrt: QuadricIntersection, as a disk fills it: the distance along the ray,
// the hit in object space, and its azimuth about the disk's axis.
element DiskHit {
    t : Float;
    p_obj : vec3f;
    phi : Float;
}

// pbrt: Transform::ApplyInverse(const Ray &, Float *tMax), the top of
// TransformedPrimitive::Intersect: the ray moved into the instance's frame, so
// that everything inside the instance's tree is tested against stored
// geometry. `inv` is the inverse matrix, so applying it is `ApplyInverse`.
// A disk's `objectFromRender` is applied to a ray by the same arithmetic --
// pbrt's `operator()(Point3fi)` computes the point in plain floats, paired
// as below, and only the error bound by intervals -- so this is that too.
//
// The origin is a point and goes through the interval-point arithmetic pbrt
// uses for it -- `(m00 x + m01 y) + (m02 z + m03)`, paired that way -- and the
// direction is a vector, through the same rows without the translation. The
// direction is *not* renormalised, on purpose and as in pbrt: an affine map
// preserves the parameter along a line only when the direction is transformed
// rather than rescaled, and it is that parameter -- the `t` of a hit -- that
// `distmin` answers and that the running best is compared against. Renormalise
// and an instance could no longer prune against a hit found in another one.
//
// pbrt then nudges the origin forward by its rounding error, `o += d * dt`, and
// takes the same `dt` off `tMax` so that the two sides still agree about where
// the best hit so far is. That is not done here. The nudge is against a ray
// re-hitting the surface its origin was rounded onto, which this renderer
// guards with pbrt's own SpawnRay offset, applied in render space before the
// ray reaches any instance; and `tMax` is not a field
// of the query here but the traversal's accumulator, which nothing inside a
// query may alter (see PLAN.md). Without the nudge the identity the whole
// arrangement rests on -- a distance along the pulled ray *is* the distance
// along the original -- holds exactly rather than up to `dt`, and the hit point
// differs from pbrt's by that `dt`: a few units in the last place.
func pull_ray(inv : Transform, r : Ray) -> Ray {
    o = vec3f{fma(inv.r0.y, r.o.y, inv.r0.x * r.o.x) + fma(inv.r0.z, r.o.z, inv.r0.w),
              fma(inv.r1.y, r.o.y, inv.r1.x * r.o.x) + fma(inv.r1.z, r.o.z, inv.r1.w),
              fma(inv.r2.y, r.o.y, inv.r2.x * r.o.x) + fma(inv.r2.z, r.o.z, inv.r2.w)};
    wp = fma(inv.r3.y, r.o.y, inv.r3.x * r.o.x) + fma(inv.r3.z, r.o.z, inv.r3.w);
    out : Ray = {select(wp == 1.0, o, o / wp), apply_vector(inv, r.d)};
    return out;
}

// pbrt: Disk::BasicIntersect. The ray in object space, where the disk is the
// plane z = height: the distance to the plane, the point there, and whether
// it lies between the radii and within phi_max. A ray parallel to the plane
// misses, whatever its origin.
func disk_hit(r : Ray, tmax : Float, d : Disk) -> option[DiskHit] {
    pulled = pull_ray(d.object_from_render, r);
    oi = pulled.o;
    di = pulled.d;
    if di.z == 0.0 {
        return {};
    }
    t = (d.height - oi.z) / di.z;
    if (t <= 0.0) | (t >= tmax) {
        return {};
    }
    p = oi + t * di;
    dist2 = sqr(p.x) + sqr(p.y);
    if (dist2 > sqr(d.radius)) | (dist2 < sqr(d.inner_radius)) {
        return {};
    }
    phi0 = atan2(p.y, p.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    if phi > d.phi_max {
        return {};
    }
    hit : DiskHit = {t, p, phi};
    return hit;
}

// pbrt: Shape, the closed set of things a ray can hit. v4 dispatches this
// through a TaggedPointer over Sphere, Triangle, and the rest; a variant type
// says the same thing without the pointer.
//
// The sphere and the triangle are in render space. PBRT keeps a transform per
// shape and works in object space, tracking error bounds through the round
// trip; the disk is the one shape here that does the same, since it is
// oriented and a translation cannot place it.
element Shape =
    | Sph(s : Sphere)
    | Tri(t : Triangle)
    | Dsk(d : Disk);

// pbrt: Shape::Intersect and Shape::IntersectP, as one function each that
// matches on which shape it has. The tree the schedule builds calls these
// without knowing a shape has variants at all.
//
// These are the primitive queries, so the Sph arm goes to sphere_t, pbrt's
// hit. The bounding-volume overloads above answer for AABB and are a separate
// question -- the node a shape is in, not the shape. A shape that is not hit
// is infinitely far, the same answer the triangle gives.
func distmin(q : RaySegment, sh : Shape) -> Float {
    match sh {
        Sph(s) => {
            hit = sphere_t(q.ray, q.tmax, s);
            if hit {
                return *hit;
            }
            return inf;
        }
        Tri(t) => return distmin(q, t);
        Dsk(d) => {
            hit = disk_hit(q.ray, q.tmax, d);
            if hit {
                return (*hit).t;
            }
            return inf;
        }
    }
}

func distmax(q : RaySegment, sh : Shape) -> Float {
    match sh {
        Sph(s) => {
            hit = sphere_t(q.ray, q.tmax, s);
            if hit {
                return *hit;
            }
            return -inf;
        }
        Tri(t) => return distmax(q, t);
        Dsk(d) => {
            hit = disk_hit(q.ray, q.tmax, d);
            if hit {
                return (*hit).t;
            }
            return -inf;
        }
    }
}

func intersects(q : RaySegment, sh : Shape) -> bool {
    match sh {
        Sph(s) => return cast[[bool]](sphere_t(q.ray, q.tmax, s));
        Tri(t) => return intersects(q, t);
        Dsk(d) => return cast[[bool]](disk_hit(q.ray, q.tmax, d));
    }
}

// pbrt: what a SurfaceInteraction records about where a ray landed, minus
// everything the gbuffer does not read.
//
// Two normals, because pbrt has two and they answer different questions. `n` is
// the geometric one, which the winding of the surface decides and which the
// film records; `ns` is the shading one, which a mesh's interpolated vertex
// normals decide and which the BSDF is evaluated about. They are the same
// vector for a sphere and for a mesh with no normals of its own.
//
// `dpdus` is the surface's tangent at the hit, and it is here for one reason:
// it is the x axis of the frame a BSDF works in. For a diffuse surface that
// axis cancels out -- the reflectance is the same whichever way round the
// tangent points -- which is why nothing needed it until a layered BSDF turned
// up, whose random walk is seeded by hashing the direction it was asked about
// and so depends on the whole frame and not just its normal.
element SurfaceGeometry {
    n : vec3f;
    ns : vec3f;
    dpdus : vec3f;
    // The shading bitangent, the second axis of the frame `dpdus` is the first
    // of. pbrt's `shading` keeps both and only the first was needed here until
    // bump mapping turned up: a bump map rebuilds the shading frame from two
    // perturbed derivatives, so it needs the one it is perturbing.
    dpdvs : vec3f;
    // pbrt: SurfaceInteraction::uv, and the two partial derivatives of position
    // with respect to it.
    //
    // Nothing needed these until a texture did. A material's parameter can be a
    // texture rather than a number, and where it is, `uv` is where the surface
    // is being asked about -- so a hit that does not carry it can only have
    // constant materials. `dpdu` and `dpdv` are what turn a screen-space
    // footprint into a texture-space one, which is how a texture knows how wide
    // to filter.
    //
    // `dpdus` above is the *shading* tangent, orthogonalized against the
    // shading normal; `dpdu` here is the geometric one the parameterization
    // gives. pbrt keeps both for the same reason: a BSDF is evaluated in the
    // first and a texture is filtered in the second.
    uv : vec2f;
    dpdu : vec3f;
    dpdv : vec3f;
    // pbrt: SurfaceInteraction::shading.dndu and .dndv -- how the *shading*
    // normal turns as the surface is walked in u and in v.
    //
    // Only one thing reads them, and it is worth saying which: propagating ray
    // differentials through a specular bounce. A mirror reflects the
    // neighbouring rays of a differential into directions that depend on how
    // the normal is changing across the surface, not just on the normal at the
    // hit -- so a curved mirror widens or narrows the footprint, and these are
    // what says by how much. Everything else about shading uses the normal
    // itself.
    //
    // Zero for a mesh with no vertex normals, where the shading normal is the
    // face's and does not turn at all within the triangle.
    dndu : vec3f;
    dndv : vec3f;
    // pbrt: Point3fi, the hit point as an interval -- the position and a bound
    // on how far the arithmetic that produced it could have strayed.
    //
    // Carried because the next ray has to start off the surface it is leaving,
    // and how far off is exactly this. pbrt's `gamma(n)` is the relative error
    // a chain of n floating-point operations can accumulate, so the bound is a
    // property of how the hit was computed and differs per shape: five
    // operations for a sphere, seven for a barycentric interpolation.
    p : vec3f;
    p_error : vec3f;
}

// pbrt: Sphere::InteractionFromIntersection, for the full spheres scene_dump
// lets through -- a partial one has a different phi range and a different
// theta range, and is refused rather than silently closed up.
//
// Object space, where the sphere is at the origin, is reached by subtracting
// the centre from the ray's origin rather than from the hit point: pbrt
// transforms the ray and then evaluates it, and the two round differently.
func sphere_geometry(s : Sphere, r : Ray, t : Float) -> SurfaceGeometry {
    // pbrt: refining the hit onto the sphere, since t is only as accurate as
    // the quadratic that produced it.
    raw = (r.o - s.center) + t * r.d;
    scaled = raw * (s.radius / norm(raw));
    // pbrt nudges a hit exactly on the axis off it, where phi is undefined.
    p = select((scaled.x == 0.0) && (scaled.y == 0.0),
               vec3f{0.00001 * s.radius, scaled.y, scaled.z}, scaled);

    // pbrt: phiMax, which is 2pi for a full sphere, and the theta range, which
    // runs from acos(-1) at the bottom to acos(1) at the top -- so the span the
    // v coordinate is measured over is negative.
    phi_max = 6.28318530717958647692;
    theta_span = 0.0 - 3.14159265358979323846;

    z_radius = sqrt(sqr(p.x) + sqr(p.y));
    // Not bxdf.bonsai's cos_phi, which is the same angle taken about the
    // shading normal rather than about the sphere's axis.
    phi_cos = p.x / z_radius;
    phi_sin = p.y / z_radius;
    dpdu = vec3f{-phi_max * p.y, phi_max * p.x, 0.0};
    // pbrt: SafeACos, the arc cosine of a cosine that rounding may have pushed
    // a little outside the range it has to be in.
    theta = acos(min(max(p.z / s.radius, -1.0), 1.0));
    dpdv = theta_span * vec3f{p.z * phi_cos, p.z * phi_sin,
                              -s.radius * sin(theta)};

    // pbrt: the sphere's dndu and dndv, from the first and second fundamental
    // forms of the surface. The second derivatives of position say how the
    // tangent plane turns, and E/F/G with e/f/g resolve that into the two
    // directions the parameterization uses.
    d2pduu = -phi_max * phi_max * vec3f{p.x, p.y, 0.0};
    d2pduv = theta_span * p.z * phi_max * vec3f{-phi_sin, phi_cos, 0.0};
    d2pdvv = -sqr(theta_span) * vec3f{p.x, p.y, p.z};
    form_e = dot_(dpdu, dpdu);
    form_f = dot_(dpdu, dpdv);
    form_g = dot_(dpdv, dpdv);
    form_n = unit_vector_(cross_(dpdu, dpdv));
    coef_e = dot_(form_n, d2pduu);
    coef_f = dot_(form_n, d2pduv);
    coef_g = dot_(form_n, d2pdvv);
    egf2 = prod_diff[[Float]](form_e, form_g, form_f, form_f);
    inv_egf2 = select(egf2 == 0.0, 0.0, 1.0 / egf2);
    dndu = (coef_f * form_f - coef_e * form_g) * inv_egf2 * dpdu +
           (coef_e * form_f - coef_f * form_e) * inv_egf2 * dpdv;
    dndv = (coef_g * form_f - coef_f * form_g) * inv_egf2 * dpdu +
           (coef_f * form_f - coef_g * form_e) * inv_egf2 * dpdv;

    // pbrt: the SurfaceInteraction constructor, which takes the normal from
    // the partial derivatives rather than from the position.
    raw_n = unit_vector(cross_(dpdu, dpdv));
    n = select(s.flip, -raw_n, raw_n);
    // A sphere carries no per-vertex normals, so its shading geometry is its
    // geometry.
    //
    // pbrt: `pError = gamma(5) * Abs(pHit)`. Object space, where the sphere is
    // at the origin, so the bound is about the refined point above -- and the
    // point itself is in render space, which for a translation is the same
    // error.
    // pbrt: the parametric coordinates, which for a sphere are the angle round
    // the axis and the angle down from the pole. The same two `sphere_sample`
    // computes, and written the same way.
    phi0 = atan2(p.y, p.x);
    phi = select(phi0 < 0.0, phi0 + phi_max, phi0);
    uv = vec2f{phi / phi_max,
               (theta - 3.14159265358979323846) / theta_span};

    // A sphere brings no vertex normals, so its shading geometry is its
    // geometry and the shading bitangent is the geometric one.
    g : SurfaceGeometry = {n, n, dpdu, dpdv, uv, dpdu, dpdv, dndu, dndv,
                           p + s.center, gamma(5) * abs(p)};
    return g;
}

// pbrt: Point3fi -- a point and the bound on how far the arithmetic that made
// it could have strayed.
element BoundedPoint {
    p : vec3f;
    error : vec3f;
}

// pbrt: Transform::operator()(const Point3fi &): the point by the matrix, in
// the association pbrt's interval-point arithmetic pairs it -- `(m00 x + m01 y)
// + (m02 z + m03)` -- and its error grown the way pbrt grows it: the incoming
// error scaled by the matrix's magnitudes, plus the transform's own rounding.
// With no incoming error that is pbrt's `gamma(3) * (|m00 x| + |m01 y| + |m02
// z| + |m03|)`, which is what a sampled point on a disk leaves object space
// with.
func push_point(m : Transform, p : vec3f, e : vec3f) -> BoundedPoint {
    moved = vec3f{fma(m.r0.y, p.y, m.r0.x * p.x) + fma(m.r0.z, p.z, m.r0.w),
                  fma(m.r1.y, p.y, m.r1.x * p.x) + fma(m.r1.z, p.z, m.r1.w),
                  fma(m.r2.y, p.y, m.r2.x * p.x) + fma(m.r2.z, p.z, m.r2.w)};
    wp = fma(m.r3.y, p.y, m.r3.x * p.x) + fma(m.r3.z, p.z, m.r3.w);
    g3 = gamma(3);
    p_error = vec3f{
        (g3 + 1.0) * (abs(m.r0.x) * e.x + abs(m.r0.y) * e.y + abs(m.r0.z) * e.z) +
            g3 * (abs(m.r0.x * p.x) + abs(m.r0.y * p.y) + abs(m.r0.z * p.z) +
                  abs(m.r0.w)),
        (g3 + 1.0) * (abs(m.r1.x) * e.x + abs(m.r1.y) * e.y + abs(m.r1.z) * e.z) +
            g3 * (abs(m.r1.x * p.x) + abs(m.r1.y * p.y) + abs(m.r1.z * p.z) +
                  abs(m.r1.w)),
        (g3 + 1.0) * (abs(m.r2.x) * e.x + abs(m.r2.y) * e.y + abs(m.r2.z) * e.z) +
            g3 * (abs(m.r2.x * p.x) + abs(m.r2.y * p.y) + abs(m.r2.z * p.z) +
                  abs(m.r2.w))};
    out : BoundedPoint = {select(wp == 1.0, moved, moved / wp),
                          select(wp == 1.0, p_error, p_error / abs(wp))};
    return out;
}

// pbrt: Transform::operator()(const SurfaceInteraction &), the bottom of
// TransformedPrimitive::Intersect: the interaction the instance's own geometry
// computed, moved into render space once. Points by the matrix, vectors by its
// upper three by three, normals by the inverse transposed -- pbrt's
// `operator()(Normal3f)` reads the *columns* of the inverse -- and the two
// normals renormalised afterwards, as pbrt's are. `shading.n` is then turned
// to face the geometric normal, which is the last line of pbrt's version.
// A disk's hit leaves object space through this too.
func push_surface(m : Transform, inv : Transform,
                  s : SurfaceGeometry) -> SurfaceGeometry {
    placed = push_point(m, s.p, s.p_error);
    n = unit_vector_(apply_normal_inverse(inv, s.n));
    ns_raw = unit_vector_(apply_normal_inverse(inv, s.ns));
    ns = select(dot(ns_raw, n) < 0.0, -ns_raw, ns_raw);
    out : SurfaceGeometry = {n, ns,
                             apply_vector(m, s.dpdus), apply_vector(m, s.dpdvs),
                             s.uv,
                             apply_vector(m, s.dpdu), apply_vector(m, s.dpdv),
                             apply_normal_inverse(inv, s.dndu),
                             apply_normal_inverse(inv, s.dndv),
                             placed.p, placed.error};
    return out;
}

// pbrt: Disk::InteractionFromIntersection, and the SurfaceInteraction
// constructor and transform it ends in. The parameterization is azimuth over
// phi_max for u and the distance in from the rim over the annulus's width for
// v; the normal is the cross product of the two partials, turned by `flip`;
// the hit is refined onto the plane and, being on it exactly, carries no
// error of its own -- the error it reaches render space with is the
// transform's. A disk is flat, so the normal does not turn: dndu and dndv are
// zero, and the shading geometry is the geometry.
func disk_geometry(d : Disk, hit : DiskHit) -> SurfaceGeometry {
    p_hit = hit.p_obj;
    u = hit.phi / d.phi_max;
    r_hit = sqrt(sqr(p_hit.x) + sqr(p_hit.y));
    v = (d.radius - r_hit) / (d.radius - d.inner_radius);
    dpdu = vec3f{-d.phi_max * p_hit.y, d.phi_max * p_hit.x, 0.0};
    dpdv = vec3f{p_hit.x, p_hit.y, 0.0} * (d.inner_radius - d.radius) / r_hit;
    zero = vec3f{0.0, 0.0, 0.0};
    p_obj = vec3f{p_hit.x, p_hit.y, d.height};
    raw_n = unit_vector(cross_(dpdu, dpdv));
    n = select(d.flip, -raw_n, raw_n);
    g : SurfaceGeometry = {n, n, dpdu, dpdv, vec2f{u, v}, dpdu, dpdv, zero,
                           zero, p_obj, zero};
    return push_surface(d.render_from_object, d.object_from_render, g);
}

// pbrt: Triangle::InteractionFromIntersection.
func triangle_geometry(tri : Triangle, b : vec3f) -> SurfaceGeometry {
    m = meshes[tri.mesh];
    i0 = mesh_corner(m, tri, 0u);
    i1 = mesh_corner(m, tri, 1u);
    i2 = mesh_corner(m, tri, 2u);
    p0 = mesh_positions[i0];
    p1 = mesh_positions[i1];
    p2 = mesh_positions[i2];

    // pbrt substitutes these for a mesh with no texture coordinates of its own.
    // Per triangle rather than per vertex, which is why they cannot live in the
    // pool beside the ones a mesh does bring. An `if`, as pbrt's
    // `mesh->uv ? ... : ...` is, and not a select: a select evaluates both of
    // its arms, and a mesh without texture coordinates has nothing at
    // `mesh_uvs` to read -- the scene need not hand over an address at all.
    uv0 : mut vec2f = vec2f{0.0, 0.0};
    uv1 : mut vec2f = vec2f{1.0, 0.0};
    uv2 : mut vec2f = vec2f{1.0, 1.0};
    if m.has_uv {
        uv0 = mesh_uvs[m.first_uv + i0 - m.first_vertex];
        uv1 = mesh_uvs[m.first_uv + i1 - m.first_vertex];
        uv2 = mesh_uvs[m.first_uv + i2 - m.first_vertex];
    }

    // pbrt: the partial derivatives, from inverting the map that the texture
    // coordinates give from the triangle to the plane.
    duv02 = uv0 - uv2;
    duv12 = uv1 - uv2;
    dp02 = p0 - p2;
    dp12 = p1 - p2;
    determinant = prod_diff[[Float]](duv02.x, duv12.y, duv02.y, duv12.x);
    degenerate_uv = abs(determinant) < 1e-9;

    invdet = 1.0 / determinant;
    dpdu : mut vec3f = prod_diff3(duv12.y, dp02, duv02.y, dp12) * invdet;
    dpdv : mut vec3f = prod_diff3(duv02.x, dp12, duv12.x, dp02) * invdet;
    // A parameterization that says nothing about direction, either because the
    // texture coordinates are degenerate or because the two derivatives came
    // out parallel. pbrt falls back to an arbitrary basis in the tangent plane.
    // Its own further fallback to double precision is for a triangle with no
    // area, which triangle_hit has already rejected.
    if degenerate_uv || (sqlen[[Float]](cross_(dpdu, dpdv)) == 0.0) {
        fallback = coordinate_system(unit_vector(cross_(p2 - p0, p1 - p0)));
        dpdu = fallback.x;
        dpdv = fallback.y;
    }

    raw_n = unit_vector(cross_(dp02, dp12));
    n = select(m.flip, -raw_n, raw_n);

    // pbrt: the hit point and its error, both from the barycentric
    // interpolation rather than from the ray -- `pHit = b0*p0 + b1*p1 + b2*p2`
    // and `pError = gamma(7) * (|b0 p0| + |b1 p1| + |b2 p2|)`. Seven operations
    // because the sum of three scaled points is what the bound is over.
    p_hit = b.x * p0 + b.y * p1 + b.z * p2;
    p_abs_sum = abs(b.x * p0) + abs(b.y * p1) + abs(b.z * p2);
    p_err = gamma(7) * p_abs_sum;
    // pbrt: `Point2f uvHit = b0 * uv[0] + b1 * uv[1] + b2 * uv[2]`, the same
    // barycentric interpolation as the point.
    uv_hit = b.x * uv0 + b.y * uv1 + b.z * uv2;

    if !m.has_normals {
        // pbrt never enters its shading-geometry block for such a mesh, so the
        // shading normal is the geometric one and the tangent is unadjusted.
        // dndu and dndv are zero for a mesh with no normals: the shading
        // normal is the face's and does not turn within the triangle.
        zero = vec3f{0.0, 0.0, 0.0};
        plain : SurfaceGeometry = {n, n, dpdu, dpdv, uv_hit, dpdu, dpdv, zero,
                                   zero, p_hit, p_err};
        return plain;
    }

    // pbrt: the shading normal, interpolated across the triangle and falling
    // back to the geometric one where the three vertex normals cancel.
    //
    // As two fused multiply-adds per component, which is what pbrt's compiler
    // makes of `b0 * n0 + b1 * n1 + b2 * n2`. See dot_ in stdlib/numerics for
    // which multiply pairs with which add and why it is not a detail.
    n0 = mesh_normals[m.first_normal + i0 - m.first_vertex];
    n1 = mesh_normals[m.first_normal + i1 - m.first_vertex];
    n2 = mesh_normals[m.first_normal + i2 - m.first_vertex];
    raw_ns = fma3(b.z, n2, fma3(b.y, n1, b.x * n0));
    ns = select(sqlen_(raw_ns) > 0.0, unit_vector_(raw_ns), n);

    // pbrt: dndu and dndv for the shading geometry, from the same inversion
    // that gave dpdu and dpdv -- the vertex normals interpolate across the
    // triangle exactly as the positions do, so their derivatives come out of
    // the same 2x2 solve with the normal deltas in place of the position ones.
    dn1 = n0 - n2;
    dn2 = n1 - n2;
    dndu : mut vec3f = vec3f{0.0, 0.0, 0.0};
    dndv : mut vec3f = vec3f{0.0, 0.0, 0.0};
    if degenerate_uv {
        // pbrt takes the trouble to answer here rather than giving up, and
        // says why: a differential reflected off a triangle whose texture
        // coordinates are degenerate should still be a reasonable size. The
        // basis is arbitrary but it is the same arbitrary basis dpdu and dpdv
        // fell back to above.
        dn = cross_(n2 - n0, n1 - n0);
        if sqlen[[Float]](dn) != 0.0 {
            dn_basis = coordinate_system(dn);
            dndu = dn_basis.x;
            dndv = dn_basis.y;
        }
    } else {
        dndu = prod_diff3(duv12.y, dn1, duv02.y, dn2) * invdet;
        dndv = prod_diff3(duv02.x, dn2, duv12.x, dn1) * invdet;
    }

    // pbrt: the shading tangent, made perpendicular to the shading normal.
    // Where the two are parallel there is nothing to project, and an arbitrary
    // basis is taken instead.
    ts_raw = cross_(ns, dpdu);
    parallel = sqlen[[Float]](ts_raw) == 0.0;
    fallback = coordinate_system(ns);
    ss = select(parallel, fallback.x, cross_(ts_raw, ns));
    ts = select(parallel, fallback.y, ts_raw);

    // pbrt: SetShadingGeometry, whose loop scales the two derivatives down
    // until they are of a size the differentials can be taken in. It never runs
    // for anything at a sane scale, and it is here because when it does run it
    // changes the frame this all exists to build.
    su : mut vec3f = ss;
    sv : mut vec3f = ts;
    while (sqlen[[Float]](su) > 1e16) || (sqlen[[Float]](sv) > 1e16) {
        su = su / 1e8;
        sv = sv / 1e8;
    }

    // The geometric normal turns to face the shading one, which the film's own
    // FaceForward against the ray then makes invisible -- but not to a BSDF.
    // pbrt: SetShadingGeometry sets dndu and dndv and does *not* put them
    // through the scaling loop above, which only ever touches the tangents.
    g : SurfaceGeometry = {select(dot(n, ns) < 0.0, -n, n), ns, su, sv, uv_hit,
                           dpdu, dpdv, dndu, dndv, p_hit, p_err};
    return g;
}

// pbrt: Shape::Intersect's tail, which turns a hit into the surface it landed
// on.
//
// The intersection is run again here rather than carried out of the tree
// query, because what the query answers is which primitive is nearest and not
// where on it the ray landed. That is one more intersection per camera ray
// against however many the traversal already did, so it is not where the time
// goes -- but it is a question the tree lowering could answer for free, and
// worth revisiting when it can.
//
// Asked of the shape the ray was already found to hit, so a miss here is not a
// case the caller has an answer for; it reports the surface facing the ray,
// which is what a sliver of no area would have given anyway.
// pbrt: OffsetRayOrigin, which is what `interval.bonsai` was written for.
//
// A ray leaving a surface must not hit the surface it left. The usual fix is an
// epsilon, which is wrong in both directions -- too small and the surface
// shadows itself, too large and contact is lost -- and pbrt's is not an epsilon
// at all: the hit point is known to within `p_error`, so the origin is pushed
// out by exactly that bound along the normal, on the side the new ray leaves
// towards.
//
// The rounding afterwards is not decoration. The offset can be smaller than an
// ulp of the coordinate it is added to, in which case the addition returns the
// point unchanged and the push did nothing; nudging each coordinate one float
// further out guarantees it moved.
func offset_ray_origin(p : vec3f, p_error : vec3f, n : vec3f,
                       w : vec3f) -> vec3f {
    d = dot(abs(n), p_error);
    signed = select(dot(w, n) < 0.0, -d, d);
    offset = signed * n;
    po = p + offset;
    return vec3f{
        select(offset.x > 0.0, next_float_up(po.x),
               select(offset.x < 0.0, next_float_down(po.x), po.x)),
        select(offset.y > 0.0, next_float_up(po.y),
               select(offset.y < 0.0, next_float_down(po.y), po.y)),
        select(offset.z > 0.0, next_float_up(po.z),
               select(offset.z < 0.0, next_float_down(po.z), po.z))};
}

// pbrt: Interaction::SpawnRay. The geometric normal rather than the shading
// one, because what the offset has to clear is where the surface actually is.
func spawn_ray(g : SurfaceGeometry, d : vec3f) -> Ray {
    r : Ray = {offset_ray_origin(g.p, g.p_error, g.n, d), d};
    return r;
}

// pbrt: SpawnRayTo, the shadow ray between two surfaces.
//
// Both ends are pushed off their surfaces, not just the origin: a ray that
// stops exactly on the light would find the light, and one that stops exactly
// on the surface it left would find that. The direction is deliberately *not*
// normalized, so `t` runs from zero at one end to one at the other and the
// bound a shadow ray is traced with, `shadow_tmax`, is a fraction rather than
// a distance -- which is what lets one epsilon work for a light a metre away
// and one a kilometre away.
func spawn_ray_to(from_p : vec3f, from_error : vec3f, from_n : vec3f,
                  to_p : vec3f, to_error : vec3f, to_n : vec3f) -> Ray {
    pf = offset_ray_origin(from_p, from_error, from_n, to_p - from_p);
    pt = offset_ray_origin(to_p, to_error, to_n, pf - to_p);
    r : Ray = {pf, pt - pf};
    return r;
}

// pbrt: the other SpawnRayTo, toward a point rather than a surface -- the
// origin is pushed off its surface and the far end is the point itself. The
// wavefront's TraceTransmittance re-spawns a shadow ray this way at every
// medium boundary it crosses, toward where the first segment ended.
func spawn_ray_to_point(from_p : vec3f, from_error : vec3f, from_n : vec3f,
                        to_p : vec3f) -> Ray {
    d = to_p - from_p;
    r : Ray = {offset_ray_origin(from_p, from_error, from_n, d), d};
    return r;
}

// pbrt: `1 - ShadowEpsilon`, how far along a shadow ray -- `t` from zero at
// one end to one at the other -- a hit still counts as occlusion: the far
// surface itself, a sliver short of `t = 1`, does not.
func shadow_tmax() -> Float = 1.0 - 0.0001;

// pbrt: ShapeSampleContext, the point a shape is being sampled *from*.
//
// A surface asking "where on the light should I look?" -- so the shading normal
// is here as well as the geometric one, and the error bound is here because the
// answer depends on where the shadow ray may start from.
element ShapeSampleContext {
    p : vec3f;
    p_error : vec3f;
    n : vec3f;
    ns : vec3f;
}

// pbrt: ShapeSample -- a point on the shape and the density it was chosen with,
// in solid angle measure about the context's point.
element ShapeSample {
    p : vec3f;
    p_error : vec3f;
    n : vec3f;
    uv : vec2f;
    pdf : Float;
}

// pbrt: ShapeSampleContext::OffsetRayOrigin(Point3f), which offsets towards a
// point rather than along a direction.
func ctx_offset_toward(ctx : ShapeSampleContext, target : vec3f) -> vec3f =
    offset_ray_origin(ctx.p, ctx.p_error, ctx.n, target - ctx.p);

// pbrt: SafeACos, clamped so that a cosine a hair outside [-1,1] -- which
// arithmetic produces -- is an angle rather than a NaN.
// min/max rather than bxdf.bonsai's `clampf`: that file imports this one, not
// the other way about, and a symbol that resolves only because some third file
// imported both is a dependency nothing declares.
func safe_acos(x : Float) -> Float = acos(min(max(x, -1.0), 1.0));

// pbrt: SphericalDirection, from a sine, a cosine and an azimuth.
// `st`/`ct` rather than pbrt's names: `sin_theta` and `cos_theta` are already
// the spherical accessors in bxdf.bonsai, which take a direction.
func spherical_direction(st : Float, ct : Float, phi : Float) -> vec3f {
    s = min(max(st, -1.0), 1.0);
    return vec3f{s * cos(phi), s * sin(phi), min(max(ct, -1.0), 1.0)};
}

// pbrt: Sphere::Area, for a full sphere.
func sphere_area(s : Sphere) -> Float =
    6.28318530717958647692 * s.radius * (s.radius - (0.0 - s.radius));

// pbrt: Sphere::Sample(u), a point chosen uniformly over the sphere's area.
//
// Only reached when the point being sampled from is *inside* the sphere, where
// the cone below is not defined. Both scenes here look at their light from
// outside, so this is the branch that is written for completeness and the other
// is the one that runs.
func sphere_sample_area(s : Sphere, u : vec2f) -> ShapeSample {
    dir = sample_uniform_sphere(u);
    p_obj0 = s.radius * dir;
    // pbrt reprojects onto the sphere, since the direction is only as accurate
    // as the trigonometry that made it.
    p_obj = p_obj0 * (s.radius / norm(p_obj0));
    p_obj_error = gamma(5) * abs(p_obj);

    raw_n = unit_vector_(p_obj);
    n = select(s.flip, -raw_n, raw_n);

    theta = safe_acos(p_obj.z / s.radius);
    phi0 = atan2(p_obj.y, p_obj.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    // A full sphere: phiMax is 2pi and theta runs from acos(-1) to acos(1).
    uv = vec2f{phi / 6.28318530717958647692,
               (theta - 3.14159265358979323846) / (0.0 - 3.14159265358979323846)};

    ss : ShapeSample = {p_obj + s.center, p_obj_error, n, uv,
                        1.0 / sphere_area(s)};
    return ss;
}

// pbrt: Sphere::Sample(ctx, u) -- a direction chosen uniformly inside the cone
// the sphere subtends, which is what makes a shadow ray worth tracing: every
// direction it picks is one that can reach the light.
func sphere_sample(s : Sphere, ctx : ShapeSampleContext,
                   u : vec2f) -> option[ShapeSample] {
    p_origin = ctx_offset_toward(ctx, s.center);
    if sqlen[[Float]](p_origin - s.center) <= sqr(s.radius) {
        // Inside the sphere: the cone is not defined, so sample the area and
        // convert the density to solid angle.
        area = sphere_sample_area(s, u);
        wi0 = area.p - ctx.p;
        if sqlen[[Float]](wi0) == 0.0 {
            return {};
        }
        wi = unit_vector_(wi0);
        denom = abs(dot(area.n, -wi)) / sqlen[[Float]](ctx.p - area.p);
        if denom == 0.0 {
            return {};
        }
        converted : mut ShapeSample = area;
        converted.pdf = area.pdf / denom;
        if converted.pdf == inf {
            return {};
        }
        return converted;
    }

    // The cone the sphere subtends, sampled uniformly in solid angle.
    sin_theta_max = s.radius / norm(ctx.p - s.center);
    sin2_theta_max = sqr(sin_theta_max);
    cos_theta_max = safe_sqrt(1.0 - sin2_theta_max);
    one_minus_cos : mut Float = 1.0 - cos_theta_max;

    // `ct2`/`s2t`: `cos_theta` is bxdf.bonsai's spherical accessor.
    ct2 : mut Float = fma(cos_theta_max - 1.0, u.x, 1.0);
    s2t : mut Float = 1.0 - sqr(ct2);
    // pbrt: sin^2(1.5 degrees). Below that the subtraction above loses most of
    // its significance, and the series is the accurate form.
    if sin2_theta_max < 0.00068523 {
        s2t = sin2_theta_max * u.x;
        ct2 = sqrt(1.0 - s2t);
        one_minus_cos = sin2_theta_max / 2.0;
    }

    // The angle from the sphere's centre to the sampled point on its surface,
    // which is not the same as the angle from the viewer.
    cos_alpha = s2t / sin_theta_max +
                ct2 * safe_sqrt(1.0 - s2t / sqr(sin_theta_max));
    sin_alpha = safe_sqrt(1.0 - sqr(cos_alpha));

    phi = u.y * 6.28318530717958647692;
    w = spherical_direction(sin_alpha, cos_alpha, phi);
    // `unit_vector_` rather than `unit_vector`: pbrt's Normalize divides by a
    // length its compiler computes with fused multiply-adds, and the two differ
    // in the last bit -- which lands in the sampled point.
    sampling_frame = frame_from_z(unit_vector_(s.center - ctx.p));
    raw_n = frame_from_local(sampling_frame, -w);
    n = select(s.flip, -raw_n, raw_n);
    p = s.center + s.radius * n;

    p_error = gamma(5) * abs(p);

    // The texture coordinates of the sampled point, in the sphere's own frame.
    p_obj = p - s.center;
    theta = safe_acos(p_obj.z / s.radius);
    sphere_phi0 = atan2(p_obj.y, p_obj.x);
    sphere_phi = select(sphere_phi0 < 0.0,
                        sphere_phi0 + 6.28318530717958647692, sphere_phi0);
    uv = vec2f{sphere_phi / 6.28318530717958647692,
               (theta - 3.14159265358979323846) / (0.0 - 3.14159265358979323846)};

    ss : ShapeSample = {p, p_error, n, uv,
                        1.0 / (6.28318530717958647692 * one_minus_cos)};
    return ss;
}

// pbrt: Sphere::PDF(ctx, wi), the density `sphere_sample` draws with. Needed
// for MIS, which weighs this estimator against the BSDF's.
//
// The inside-the-sphere branch of pbrt's needs an intersection against the
// shape and is not written: nothing reaches it while every light in these
// scenes is looked at from outside, and writing it blind would be a number no
// comparison could check.
func sphere_pdf(s : Sphere, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    sin2_theta_max = sqr(s.radius) / sqlen[[Float]](ctx.p - s.center);
    cos_theta_max = safe_sqrt(1.0 - sin2_theta_max);
    one_minus_cos : mut Float = 1.0 - cos_theta_max;
    if sin2_theta_max < 0.00068523 {
        one_minus_cos = sin2_theta_max / 2.0;
    }
    return 1.0 / (6.28318530717958647692 * one_minus_cos);
}

// pbrt: Disk::Area, the sector of the annulus phi_max covers.
func disk_area(d : Disk) -> Float =
    d.phi_max * 0.5 * (sqr(d.radius) - sqr(d.inner_radius));

// pbrt: Disk::Sample(u), a point chosen uniformly over the disk's area -- the
// unit disk sampled concentrically and scaled to the radius, then pushed into
// render space with the transform's error, and the normal the transform makes
// of the object space's z, turned by `reverse`. The point is sampled over the
// whole disk whatever the inner radius and phi_max, as pbrt's is; the density
// is one over the sector's area all the same. pbrt does not reconcile the two,
// so neither does this.
func disk_sample_area(d : Disk, u : vec2f) -> ShapeSample {
    pd = sample_uniform_disk_concentric(u);
    p_obj = vec3f{pd.x * d.radius, pd.y * d.radius, d.height};
    placed = push_point(d.render_from_object, p_obj, vec3f{0.0, 0.0, 0.0});
    raw_n = unit_vector_(apply_normal_inverse(d.object_from_render,
                                              vec3f{0.0, 0.0, 1.0}));
    n = select(d.reverse, -raw_n, raw_n);
    phi0 = atan2(pd.y, pd.x);
    phi = select(phi0 < 0.0, phi0 + 6.28318530717958647692, phi0);
    radius_sample = sqrt(sqr(p_obj.x) + sqr(p_obj.y));
    uv = vec2f{phi / d.phi_max,
               (d.radius - radius_sample) / (d.radius - d.inner_radius)};
    ss : ShapeSample = {placed.p, placed.error, n, uv, 1.0 / disk_area(d)};
    return ss;
}

// pbrt: Disk::Sample(ctx, u) -- the area sample above, its density converted
// to solid angle about the point it is seen from. A point seen edge-on, or
// coincident, has an infinite density and is declined.
func disk_sample(d : Disk, ctx : ShapeSampleContext,
                 u : vec2f) -> option[ShapeSample] {
    area = disk_sample_area(d, u);
    wi0 = area.p - ctx.p;
    if sqlen[[Float]](wi0) == 0.0 {
        return {};
    }
    wi = unit_vector_(wi0);
    converted : mut ShapeSample = area;
    converted.pdf = area.pdf / (abs(dot(area.n, -wi)) /
                                sqlen[[Float]](ctx.p - area.p));
    if converted.pdf == inf {
        return {};
    }
    return converted;
}

// pbrt: Disk::PDF(ctx, wi), the density `disk_sample` draws `wi` with: the
// disk is intersected along `wi` from the context's point, and the area
// density converted at the hit. Zero for a miss, and zero where the
// conversion overflows.
func disk_pdf(d : Disk, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    r : Ray = {offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi), wi};
    hit = disk_hit(r, inf, d);
    if !hit {
        return 0.0;
    }
    g = disk_geometry(d, *hit);
    pdf = (1.0 / disk_area(d)) /
          (abs(dot(g.n, -wi)) / sqlen[[Float]](ctx.p - g.p));
    return select(pdf == inf, 0.0, pdf);
}

// pbrt: SafeASin, the mirror of safe_acos above.
func safe_asin(x : Float) -> Float = asin(min(max(x, -1.0), 1.0));

// pbrt: AngleBetween(v1, v2), the angle between two unit vectors, computed from
// a chord rather than an arccosine so that it stays accurate near 0 and pi.
func angle_between(a : vec3f, b : vec3f) -> Float {
    if dot(a, b) < 0.0 {
        return 3.14159265358979323846 - 2.0 * safe_asin(norm(a + b) / 2.0);
    }
    return 2.0 * safe_asin(norm(b - a) / 2.0);
}

// pbrt: GramSchmidt(v, w), the part of v orthogonal to the unit vector w.
func gram_schmidt(v : vec3f, w : vec3f) -> vec3f = v - dot(v, w) * w;

// pbrt: DifferenceOfProducts and SumOfProducts, the two-fma forms that carry
// the rounding error of the discarded product back into the result. Defined
// here rather than imported: differentials.bonsai has the first, but shapes
// does not import it, and a symbol that resolves only through a third file's
// imports is a dependency nothing declares.
func diff_of_products(a : Float, b : Float, c : Float, d : Float) -> Float {
    cd = c * d;
    return fma(a, b, -cd) + fma(-c, d, cd);
}
func sum_of_products(a : Float, b : Float, c : Float, d : Float) -> Float {
    cd = c * d;
    return fma(a, b, cd) + fma(c, d, -cd);
}

// pbrt: SphericalTriangleArea, the solid angle three unit directions subtend.
func spherical_triangle_area(a : vec3f, b : vec3f, c : vec3f) -> Float =
    abs(2.0 * atan2(dot(a, cross_(b, c)),
                    1.0 + dot(a, b) + dot(a, c) + dot(b, c)));

// pbrt: Lerp, a linear blend written the way pbrt writes it so the endpoints
// come back exactly.
func lerp_st(t : Float, a : Float, b : Float) -> Float = (1.0 - t) * a + t * b;

// pbrt: SampleLinear, the inverse CDF of a linear density on [0,1]. The
// constant is pbrt's OneMinusEpsilon, the largest float below one, so a sample
// never lands exactly on the far edge.
func sample_linear(u : Float, a : Float, b : Float) -> Float {
    if (u == 0.0) && (a == 0.0) {
        return 0.0;
    }
    x = u * (a + b) / (a + sqrt(lerp_st(u, a * a, b * b)));
    return min(x, 0.99999994);
}

// pbrt: BilinearPDF and SampleBilinear, the cosine-warp that biases the
// spherical-triangle sample towards the corners the shading normal faces.
func bilinear_pdf(p : vec2f, w0 : Float, w1 : Float, w2 : Float,
                  w3 : Float) -> Float {
    if (p.x < 0.0) || (p.x > 1.0) || (p.y < 0.0) || (p.y > 1.0) {
        return 0.0;
    }
    if (w0 + w1 + w2 + w3) == 0.0 {
        return 1.0;
    }
    return 4.0 *
           ((1.0 - p.x) * (1.0 - p.y) * w0 + p.x * (1.0 - p.y) * w1 +
            (1.0 - p.x) * p.y * w2 + p.x * p.y * w3) /
           (w0 + w1 + w2 + w3);
}

func sample_bilinear(u : vec2f, w0 : Float, w1 : Float, w2 : Float,
                     w3 : Float) -> vec2f {
    py = sample_linear(u.y, w0 + w1, w2 + w3);
    px = sample_linear(u.x, lerp_st(py, w0, w2), lerp_st(py, w1, w3));
    return vec2f{px, py};
}

// pbrt: SampleUniformTriangle, uniform barycentrics over a triangle.
func sample_uniform_triangle(u : vec2f) -> vec3f {
    if u.x < u.y {
        b0 = u.x / 2.0;
        return vec3f{b0, u.y - b0, 1.0 - b0 - (u.y - b0)};
    }
    b1 = u.y / 2.0;
    return vec3f{u.x - b1, b1, 1.0 - (u.x - b1) - b1};
}

// pbrt: Triangle::Area, half the parallelogram the two edges span.
func triangle_area(t : Triangle) -> Float {
    p0 = triangle_p(t, 0u);
    return 0.5 * norm(cross_(triangle_p(t, 1u) - p0, triangle_p(t, 2u) - p0));
}

// pbrt: the geometric normal at a sampled point, face-forwarded to the
// interpolated shading normal for a mesh that has them, and flipped by the
// mesh's orientation otherwise -- exactly the block Triangle::Sample runs.
func triangle_face_normal(t : Triangle, b : vec3f) -> vec3f {
    m = meshes[t.mesh];
    i0 = mesh_corner(m, t, 0u);
    i1 = mesh_corner(m, t, 1u);
    i2 = mesh_corner(m, t, 2u);
    p0 = mesh_positions[i0];
    p1 = mesh_positions[i1];
    p2 = mesh_positions[i2];
    n = unit_vector_(cross_(p1 - p0, p2 - p0));
    if !m.has_normals {
        return select(m.flip, -n, n);
    }
    n0 = mesh_normals[m.first_normal + i0 - m.first_vertex];
    n1 = mesh_normals[m.first_normal + i1 - m.first_vertex];
    n2 = mesh_normals[m.first_normal + i2 - m.first_vertex];
    ns = b.x * n0 + b.y * n1 + b.z * n2;
    return select(dot(n, ns) < 0.0, -n, n);
}

// The texture coordinates a mesh brings, or pbrt's per-triangle (0,0),(1,0),
// (1,1) for one that has none, interpolated at the barycentrics. An `if`
// rather than a select, for the reason given in triangle_geometry.
func triangle_uv_at(m : TriangleMesh, i0 : u32, i1 : u32, i2 : u32,
                    b : vec3f) -> vec2f {
    uv0 : mut vec2f = vec2f{0.0, 0.0};
    uv1 : mut vec2f = vec2f{1.0, 0.0};
    uv2 : mut vec2f = vec2f{1.0, 1.0};
    if m.has_uv {
        uv0 = mesh_uvs[m.first_uv + i0 - m.first_vertex];
        uv1 = mesh_uvs[m.first_uv + i1 - m.first_vertex];
        uv2 = mesh_uvs[m.first_uv + i2 - m.first_vertex];
    }
    return b.x * uv0 + b.y * uv1 + b.z * uv2;
}

// pbrt: Triangle::Sample(u), a point chosen uniformly over the triangle's
// area. The unstable-solid-angle fallback of the solid-angle sampler below.
func triangle_sample_area(t : Triangle, u : vec2f) -> ShapeSample {
    m = meshes[t.mesh];
    i0 = mesh_corner(m, t, 0u);
    i1 = mesh_corner(m, t, 1u);
    i2 = mesh_corner(m, t, 2u);
    p0 = mesh_positions[i0];
    p1 = mesh_positions[i1];
    p2 = mesh_positions[i2];
    b = sample_uniform_triangle(u);
    p = b.x * p0 + b.y * p1 + b.z * p2;
    p_abs = abs(b.x * p0) + abs(b.y * p1) + abs((1.0 - b.x - b.y) * p2);
    ss : ShapeSample = {p, gamma(6) * p_abs, triangle_face_normal(t, b),
                        triangle_uv_at(m, i0, i1, i2, b), 1.0 / triangle_area(t)};
    return ss;
}

// pbrt: SampleSphericalTriangle -- barycentrics for a direction drawn uniformly
// in the solid angle the triangle subtends from `p`, plus that solid angle's
// density. The whole of Arvo's spherical-triangle sampling, translated line for
// line. `b` all zero with `pdf` zero is the degenerate answer the caller drops.
element SphTri {
    b : vec3f;
    pdf : Float;
}

func sample_spherical_triangle(p0 : vec3f, p1 : vec3f, p2 : vec3f,
                               p : vec3f, u : vec2f) -> SphTri {
    a = unit_vector_(p0 - p);
    b = unit_vector_(p1 - p);
    c = unit_vector_(p2 - p);
    n_ab0 = cross_(a, b);
    n_bc0 = cross_(b, c);
    n_ca0 = cross_(c, a);
    if (sqlen[[Float]](n_ab0) == 0.0) || (sqlen[[Float]](n_bc0) == 0.0) ||
       (sqlen[[Float]](n_ca0) == 0.0) {
        degenerate : SphTri = {vec3f{0.0, 0.0, 0.0}, 0.0};
        return degenerate;
    }
    n_ab = unit_vector_(n_ab0);
    n_bc = unit_vector_(n_bc0);
    n_ca = unit_vector_(n_ca0);

    alpha = angle_between(n_ab, -n_ca);
    beta = angle_between(n_bc, -n_ab);
    gam = angle_between(n_ca, -n_bc);

    a_pi = alpha + beta + gam;
    ap_pi = lerp_st(u.x, 3.14159265358979323846, a_pi);
    big_a = a_pi - 3.14159265358979323846;
    pdf = select(big_a <= 0.0, 0.0, 1.0 / big_a);

    cos_alpha = cos(alpha);
    sin_alpha = sin(alpha);
    sinp = sin(ap_pi) * cos_alpha - cos(ap_pi) * sin_alpha;
    cosp = cos(ap_pi) * cos_alpha + sin(ap_pi) * sin_alpha;
    k1 = cosp + cos_alpha;
    k2 = sinp - sin_alpha * dot(a, b);
    cos_bp0 = (k2 + diff_of_products(k2, cosp, k1, sinp) * cos_alpha) /
              (sum_of_products(k2, sinp, k1, cosp) * sin_alpha);
    cos_bp = min(max(cos_bp0, -1.0), 1.0);
    sin_bp = safe_sqrt(1.0 - sqr(cos_bp));
    cp = cos_bp * a + sin_bp * unit_vector_(gram_schmidt(c, a));

    cost = 1.0 - u.y * (1.0 - dot(cp, b));
    sint = safe_sqrt(1.0 - sqr(cost));
    w = cost * b + sint * unit_vector_(gram_schmidt(cp, b));

    e1 = p1 - p0;
    e2 = p2 - p0;
    s1 = cross_(w, e2);
    divisor = dot(s1, e1);
    if divisor == 0.0 {
        third : SphTri = {vec3f{0.33333333333333333, 0.33333333333333333,
                                0.33333333333333333}, pdf};
        return third;
    }
    inv = 1.0 / divisor;
    s = p - p0;
    b1 : mut Float = min(max(dot(s, s1) * inv, 0.0), 1.0);
    b2 : mut Float = min(max(dot(w, cross_(s, e1)) * inv, 0.0), 1.0);
    // pbrt divides b1 by the old sum and then b2 by the sum with the new b1 --
    // translated as written rather than corrected.
    if b1 + b2 > 1.0 {
        b1 = b1 / (b1 + b2);
        b2 = b2 / (b1 + b2);
    }
    out : SphTri = {vec3f{1.0 - b1 - b2, b1, b2}, pdf};
    return out;
}

// pbrt: InvertSphericalTriangleSample, the sample that would have produced the
// direction `w`. Used to weight the cosine warp in the PDF.
func invert_spherical_triangle_sample(p0 : vec3f, p1 : vec3f, p2 : vec3f,
                                      p : vec3f, w : vec3f) -> vec2f {
    a = unit_vector_(p0 - p);
    b = unit_vector_(p1 - p);
    c = unit_vector_(p2 - p);
    n_ab0 = cross_(a, b);
    n_bc0 = cross_(b, c);
    n_ca0 = cross_(c, a);
    if (sqlen[[Float]](n_ab0) == 0.0) || (sqlen[[Float]](n_bc0) == 0.0) ||
       (sqlen[[Float]](n_ca0) == 0.0) {
        return vec2f{0.0, 0.0};
    }
    n_ab = unit_vector_(n_ab0);
    n_bc = unit_vector_(n_bc0);
    n_ca = unit_vector_(n_ca0);

    alpha = angle_between(n_ab, -n_ca);
    beta = angle_between(n_bc, -n_ab);
    gam = angle_between(n_ca, -n_bc);

    cp0 = unit_vector_(cross_(cross_(b, w), cross_(c, a)));
    cp = select(dot(cp0, a + c) < 0.0, -cp0, cp0);

    u0 : mut Float = 0.0;
    if dot(a, cp) > 0.99999847691 {
        u0 = 0.0;
    } else {
        n_cpb0 = cross_(cp, b);
        n_acp0 = cross_(a, cp);
        if (sqlen[[Float]](n_cpb0) == 0.0) || (sqlen[[Float]](n_acp0) == 0.0) {
            return vec2f{0.5, 0.5};
        }
        n_cpb = unit_vector_(n_cpb0);
        n_acp = unit_vector_(n_acp0);
        ap = alpha + angle_between(n_ab, n_cpb) + angle_between(n_acp, -n_cpb) -
             3.14159265358979323846;
        big_a = alpha + beta + gam - 3.14159265358979323846;
        u0 = ap / big_a;
    }

    u1 = (1.0 - dot(w, b)) / (1.0 - dot(cp, b));
    return vec2f{min(max(u0, 0.0), 1.0), min(max(u1, 0.0), 1.0)};
}

// pbrt: Triangle::Sample(ctx, u). A direction into the solid angle the triangle
// subtends, warped so a corner the shading normal faces is chosen more often.
// The unstable extremes fall back to area sampling, converted to solid angle.
func triangle_sample(t : Triangle, ctx : ShapeSampleContext,
                     u_in : vec2f) -> option[ShapeSample] {
    p0 = triangle_p(t, 0u);
    p1 = triangle_p(t, 1u);
    p2 = triangle_p(t, 2u);
    solid = spherical_triangle_area(unit_vector_(p0 - ctx.p),
                                    unit_vector_(p1 - ctx.p),
                                    unit_vector_(p2 - ctx.p));
    if (solid < 0.0003) || (solid > 6.22) {
        area = triangle_sample_area(t, u_in);
        wi0 = area.p - ctx.p;
        if sqlen[[Float]](wi0) == 0.0 {
            return {};
        }
        wi = unit_vector_(wi0);
        denom = abs(dot(area.n, -wi)) / sqlen[[Float]](ctx.p - area.p);
        if denom == 0.0 {
            return {};
        }
        conv : mut ShapeSample = area;
        conv.pdf = area.pdf / denom;
        if conv.pdf == inf {
            return {};
        }
        return conv;
    }

    pdf_warp : mut Float = 1.0;
    u : mut vec2f = u_in;
    if sqlen[[Float]](ctx.ns) != 0.0 {
        wa = unit_vector_(p0 - ctx.p);
        wb = unit_vector_(p1 - ctx.p);
        wc = unit_vector_(p2 - ctx.p);
        // pbrt names wi[1] for both of the first two weights -- as written.
        w0 = max(0.01, abs(dot(ctx.ns, wb)));
        w1 = max(0.01, abs(dot(ctx.ns, wb)));
        w2 = max(0.01, abs(dot(ctx.ns, wa)));
        w3 = max(0.01, abs(dot(ctx.ns, wc)));
        u = sample_bilinear(u_in, w0, w1, w2, w3);
        pdf_warp = bilinear_pdf(u, w0, w1, w2, w3);
    }

    sph = sample_spherical_triangle(p0, p1, p2, ctx.p, u);
    if sph.pdf == 0.0 {
        return {};
    }
    bb = sph.b;
    p = bb.x * p0 + bb.y * p1 + bb.z * p2;
    p_abs = abs(bb.x * p0) + abs(bb.y * p1) + abs((1.0 - bb.x - bb.y) * p2);
    m = meshes[t.mesh];
    uv = triangle_uv_at(m, mesh_corner(m, t, 0u), mesh_corner(m, t, 1u),
                        mesh_corner(m, t, 2u), bb);
    ss : ShapeSample = {p, gamma(6) * p_abs, triangle_face_normal(t, bb), uv,
                        pdf_warp * sph.pdf};
    return ss;
}

// pbrt: Triangle::PDF(ctx, wi), the density triangle_sample draws `wi` with.
func triangle_pdf(t : Triangle, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    p0 = triangle_p(t, 0u);
    p1 = triangle_p(t, 1u);
    p2 = triangle_p(t, 2u);
    solid = spherical_triangle_area(unit_vector_(p0 - ctx.p),
                                    unit_vector_(p1 - ctx.p),
                                    unit_vector_(p2 - ctx.p));
    if (solid < 0.0003) || (solid > 6.22) {
        o = offset_ray_origin(ctx.p, ctx.p_error, ctx.n, wi);
        ray : Ray = {o, wi};
        hit = triangle_hit(ray, inf, t);
        if !hit {
            return 0.0;
        }
        h = *hit;
        p_is = h.b.x * p0 + h.b.y * p1 + h.b.z * p2;
        denom = abs(dot(triangle_face_normal(t, h.b), -wi)) /
                sqlen[[Float]](ctx.p - p_is);
        if denom == 0.0 {
            return 0.0;
        }
        pdf = (1.0 / triangle_area(t)) / denom;
        if pdf == inf {
            return 0.0;
        }
        return pdf;
    }

    pdf : mut Float = 1.0 / solid;
    if sqlen[[Float]](ctx.ns) != 0.0 {
        u = invert_spherical_triangle_sample(p0, p1, p2, ctx.p, wi);
        wa = unit_vector_(p0 - ctx.p);
        wb = unit_vector_(p1 - ctx.p);
        wc = unit_vector_(p2 - ctx.p);
        w0 = max(0.01, abs(dot(ctx.ns, wb)));
        w1 = max(0.01, abs(dot(ctx.ns, wb)));
        w2 = max(0.01, abs(dot(ctx.ns, wa)));
        w3 = max(0.01, abs(dot(ctx.ns, wc)));
        pdf = pdf * bilinear_pdf(u, w0, w1, w2, w3);
    }
    return pdf;
}

// pbrt: Shape::Sample and Shape::PDF, dispatched over the variants -- which is
// what pbrt's TaggedPointer does.
func shape_sample(sh : Shape, ctx : ShapeSampleContext,
                  u : vec2f) -> option[ShapeSample] {
    match sh {
        Sph(s) => return sphere_sample(s, ctx, u);
        Tri(t) => return triangle_sample(t, ctx, u);
        Dsk(d) => return disk_sample(d, ctx, u);
    }
}

func shape_pdf(sh : Shape, ctx : ShapeSampleContext, wi : vec3f) -> Float {
    match sh {
        Sph(s) => return sphere_pdf(s, ctx, wi);
        Tri(t) => return triangle_pdf(t, ctx, wi);
        Dsk(d) => return disk_pdf(d, ctx, wi);
    }
}

func surface_geometry(sh : Shape, r : Ray) -> SurfaceGeometry {
    away = -r.d;
    missed : SurfaceGeometry = {away, away, vec3f{1.0, 0.0, 0.0},
                                vec3f{0.0, 1.0, 0.0}, vec2f{0.0, 0.0},
                                vec3f{1.0, 0.0, 0.0}, vec3f{0.0, 1.0, 0.0},
                                vec3f{0.0, 0.0, 0.0}, vec3f{0.0, 0.0, 0.0},
                                r.o, vec3f{0.0, 0.0, 0.0}};
    // Unbounded: the ray was found to hit this shape within the query's
    // bound, and the nearest hit ahead of the ray is that one.
    match sh {
        Sph(s) => {
            t = sphere_t(r, inf, s);
            if t {
                return sphere_geometry(s, r, *t);
            }
            return missed;
        }
        Tri(tri) => {
            hit = triangle_hit(r, inf, tri);
            if hit {
                return triangle_geometry(tri, (*hit).b);
            }
            return missed;
        }
        Dsk(d) => {
            hit = disk_hit(r, inf, d);
            if hit {
                return disk_geometry(d, *hit);
            }
            return missed;
        }
    }
}
