// The geometry of a converted scene, as a FlatBuffer beside the scene text
// (`<scene>.txt.geo`): what scene_dump writes and the renderer's driver
// reads back (scene_io.h, write_geometry and read_geometry).
//
// Why a sidecar, and why FlatBuffers. The scene text parsed at 80-90 MB/s
// whatever the scene -- decimal floats through iostream -- which for
// watercolor's 24 million shapes was 91.6 s of reading before a 0.9 s
// render. Everything large in a scene is an array of fixed-layout records,
// and FlatBuffers stores a vector of structs as the records themselves, read
// in place: a read is the file's bytes and a copy into the renderer's own
// vectors, at memory speed. Protobuf would decode field by field and is
// capped at 2 GB a message; this has 64-bit vectors (`vector64`, since
// FlatBuffers 23.5) for the arrays that can pass that, and they must be the
// root table's own, which is why the two shape lists are flattened into it
// rather than nested. The small, human-readable parts of a scene -- camera,
// materials, lights, textures, spectra -- stay in the text, as the texels
// and the environment map already lived in binary sidecars of their own.
//
// The header this generates is not committed: scene_schema.sh runs flatc
// and prints the flags a program including scene_io.h needs (the generated
// header's directory and FlatBuffers' own include directory).
//
// The structs mirror scene_io.h's records field for field, in the same
// order, so that the copy either way is a line per field. A shape is one of
// four kinds, kept in a vector per kind with the kinds and each shape's slot
// in its vector giving the order the text had -- which the primitives, the
// lights' ordinals and the trees' leaves all index by.

namespace bonsai_scene.geo;

// What every shape carries besides its geometry: bonsai_scene::Shape's
// material, light, light_ordinal, alpha, medium_inside, medium_outside.
// For a mesh, `light_ordinal` is its first primitive's; a mesh's lights are
// consecutive ordinals, one per triangle, in the mesh's order.
struct Placement {
    material : uint32;
    light : int32;
    light_ordinal : int32;
    alpha : int32;
    medium_inside : int32;
    medium_outside : int32;
}

// bonsai_scene::Mesh: one `Shape "trianglemesh"` (or "bilinearmesh")
// statement, as pbrt keeps it -- the mesh's runs of the shared index and
// vertex pools, and the statement's graphics state once for the whole mesh
// (`at`: pbrt's GPU keeps a material, alpha texture, medium interface and
// area-light list per mesh in its hit record, and nothing per triangle). A
// triangle mesh (`kind` 0, `prim_count` triangles, three indices each) is a
// primitive of the scene by itself and has no record per triangle; a
// bilinear patch mesh (`kind` 1, `prim_count` patches, four indices each)
// still has a Patch record per patch, each with the mesh's `at`.
struct Mesh {
    first_index : uint32;
    first_vertex : uint32;
    first_normal : uint32;
    first_uv : uint32;
    has_normals : uint32;
    has_uv : uint32;
    flip : uint32;
    kind : uint32;
    prim_count : uint32;
    at : Placement;
}

struct Patch {
    mesh : uint32;
    patch : uint32;
    area : float;
    at : Placement;
}

// bonsai_scene::Shape for a sphere: PBRT's quadric in its object space,
// placed by its transform (both matrices, 4x4 in row order), with the
// constructor's clipping -- the two heights clamped to the radius, their arc
// cosines, phimax in radians -- and the two orientation flags a disk has.
struct Sphere {
    radius : float;
    z_min : float;
    z_max : float;
    theta_z_min : float;
    theta_z_max : float;
    phi_max : float;
    flip : uint32;
    reverse : uint32;
    render_from_object : [float : 16];
    object_from_render : [float : 16];
    at : Placement;
}

struct Disk {
    height : float;
    radius : float;
    inner_radius : float;
    phi_max : float;
    flip : uint32;
    reverse : uint32;
    render_from_object : [float : 16];
    object_from_render : [float : 16];
    at : Placement;
}
struct Cylinder {
    radius : float;
    z_min : float;
    z_max : float;
    phi_max : float;
    flip : uint32;
    reverse : uint32;
    render_from_object : [float : 16];
    object_from_render : [float : 16];
    at : Placement;
}
// PBRT's Curve: a segment [u_min, u_max] of the CurveCommon `common` names
// (bonsai_scene::CurveCommon), which sits in `curve_commons` below.
struct Curve {
    common : uint32;
    u_min : float;
    u_max : float;
    at : Placement;
}
// PBRT's CurveCommon: the cubic Bezier's four control points in object
// space, the widths at its ends, a ribbon's two normals with the angle
// between them and 1 / sin of it, the kind (0 flat, 1 cylinder, 2 ribbon),
// and which CurveFrame places it.
struct CurveCommon {
    p : [float : 12];
    width0 : float;
    width1 : float;
    n : [float : 6];
    normal_angle : float;
    inv_sin_normal_angle : float;
    kind : uint32;
    frame : uint32;
}
// The two transforms a CurveCommon points at and its orientation flags,
// shared by every curve declared under one transform.
struct CurveFrame {
    render_from_object : [float : 16];
    object_from_render : [float : 16];
    flip : uint32;
    reverse : uint32;
}

struct Instance {
    definition : uint32;
    render_from_instance : [float : 16];
    instance_from_render : [float : 16];
}

// An instance definition: its run of the instance shapes (the shapes that
// are not triangle meshes) and its run of the meshes, both in the order
// the definition's statements had.
struct Definition {
    first_shape : uint32;
    shape_count : uint32;
    first_mesh : uint32;
    mesh_count : uint32;
}

// The shape kinds, as bonsai_scene::ShapeTag numbers them: 0 sphere, 1
// triangle, 2 disk, 3 patch, 4 cylinder, 5 curve.
table Geometry {
    // Bumped when a record's layout changes; the reader refuses another.
    version : uint32;

    meshes : [Mesh];
    indices : [uint32] (vector64);
    positions : [float] (vector64);
    normals : [float] (vector64);
    uvs : [float] (vector64);

    // The scene's own shapes other than its triangle meshes, in order: kind
    // and slot per shape, and the vectors the slots index (the cylinders'
    // after the rest, added later; a table's fields may be added at its
    // end). Until version 3 a triangle was a shape with a record of its own
    // (`triangles`, 32 bytes each: 9 GB of records on kroken's 288 million
    // triangles where pbrt has none) and the file carried pbrt's CPU BVH
    // over those records (`nodes`, `prims`); a triangle mesh is one
    // primitive now, its `at` on the Mesh, and the trees are built by the
    // driver as pbrt's GPU builds its own.
    shape_kinds : [ubyte] (vector64);
    shape_slots : [uint32] (vector64);
    patches : [Patch] (vector64);
    spheres : [Sphere] (vector64);
    disks : [Disk] (vector64);

    // The instance definitions' shapes, the same way.
    instance_shape_kinds : [ubyte] (vector64);
    instance_shape_slots : [uint32] (vector64);
    instance_patches : [Patch] (vector64);
    instance_spheres : [Sphere] (vector64);
    instance_disks : [Disk] (vector64);

    definitions : [Definition];
    instances : [Instance];

    cylinders : [Cylinder] (vector64);
    instance_cylinders : [Cylinder] (vector64);
    curves : [Curve] (vector64);
    instance_curves : [Curve] (vector64);
    curve_commons : [CurveCommon] (vector64);
    curve_frames : [CurveFrame] (vector64);

    // The scene's own meshes: a run of `meshes`, the statements' order (the
    // definitions' runs follow it, each definition's in `Definition`).
    top_first_mesh : uint32;
    top_mesh_count : uint32;
}

root_type Geometry;
file_identifier "BGEO";
