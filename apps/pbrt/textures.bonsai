// pbrt: ImageTexture and the MIPMap under it, from textures.h and
// util/mipmap.cpp.
//
// The pyramid is built by pbrt in scene_dump, with pbrt's own resampling
// filter, and arrives here as levels of linear RGB. What is left is the part
// that runs per lookup: pick a level from how wide the footprint is, bilerp in
// it, and turn the filtered colour into a spectrum.
//
// The default filter is `bilinear` and not EWA -- that is
// `SpectrumImageTexture::Create`'s default, so a scene that names no filter
// gets this path -- which is why there is one level chosen and not two blended.
import stdlib/numerics;
// For `floor_f`, which is pbrt's `pstd::floor` and rounds towards minus
// infinity where a cast towards zero would not.
import apps/pbrt/sampling;
import apps/pbrt/spectrum;
import apps/pbrt/transform;

// pbrt: Lerp and Log2, with pbrt's own constant for the second -- it computes
// a natural log and multiplies, which is not the same last bit as a log2
// intrinsic would give.
// pbrt: Lerp, `(1 - t) * a + t * b`, with the fused multiply-add gcc makes of
// it: the first product into the add, the second as its addend -- measured
// by compiling the expression, standalone and nested three deep as the table
// lookup nests it, with pbrt's own compiler and flags. Written as the fma so
// that it is not left to this compiler's own rule, which happens to agree.
func lerp_(t : Float, a : Float, b : Float) -> Float = fma(1.0 - t, a, t * b);
func log2_(x : Float) -> Float =
    log(x) * 1.442695040888963387004650940071;

// pbrt: WrapMode, for a lookup that falls off the edge of the image.
func wrap_repeat() -> u32 = 0u;
func wrap_clamp() -> u32 = 1u;
func wrap_black() -> u32 = 2u;

// pbrt: TextureEvalContext -- what a texture is asked about: the hit's
// position with its two screen-space derivatives (for a 3D mapping and for
// the octave count of a noise), its normal (for a direction mix), and its
// uv with the four derivatives (for an image's footprint). A hit with no
// footprint, as an alpha test is, leaves the derivatives zero.
element TextureEvalContext {
    p : vec3f;
    dpdx : vec3f;
    dpdy : vec3f;
    n : vec3f;
    uv : vec2f;
    dudx : Float;
    dudy : Float;
    dvdx : Float;
    dvdy : Float;
}

// pbrt: TexCoord2D, a 2D mapping's answer -- where in the image, and how fast
// that moves across the pixel in each direction.
element TexCoord2D {
    st : vec2f;
    dsdx : Float;
    dsdy : Float;
    dtdx : Float;
    dtdy : Float;
}

// pbrt: TextureMapping2D, the four ways a surface point becomes an image
// coordinate. `UV` is the surface's own parameterization, scaled and
// offset; the other three are geometric, through the texture's own frame
// -- `texture_from_render` is the inverse of the transform in force when the
// texture was declared, which the converter composes (scene_dump.cpp).
element Mapping2D =
    | UV(su : Float, sv : Float, du : Float, dv : Float)
    | Spherical(texture_from_render : Transform)
    | Cylindrical(texture_from_render : Transform)
    | Planar(texture_from_render : Transform, vs : vec3f, vt : vec3f,
             ds : Float, dt : Float);

// pbrt: the Map of each. Written as pbrt writes each: `Sqr(x) + Sqr(y)`,
// the divisions as divisions, `Dot` as the fused dot.
func map_2d(m : Mapping2D, ctx : TextureEvalContext) -> TexCoord2D {
    match m {
        UV(su, sv, du, dv) => {
            return TexCoord2D{vec2f{su * ctx.uv.x + du, sv * ctx.uv.y + dv},
                              su * ctx.dudx, su * ctx.dudy, sv * ctx.dvdx,
                              sv * ctx.dvdy};
        }
        Spherical(texture_from_render) => {
            pt = apply_point(texture_from_render, ctx.p);
            x2y2 = pt.x * pt.x + pt.y * pt.y;
            sqrtx2y2 = sqrt(x2y2);
            dsdp = vec3f{-pt.y, pt.x, 0.0} / (2.0 * pi() * x2y2);
            dtdp = (1.0 / (pi() * (x2y2 + pt.z * pt.z))) *
                   vec3f{pt.x * pt.z / sqrtx2y2, pt.y * pt.z / sqrtx2y2,
                         -sqrtx2y2};
            dpdx = apply_vector(texture_from_render, ctx.dpdx);
            dpdy = apply_vector(texture_from_render, ctx.dpdy);
            vec = unit_vector_(pt);
            return TexCoord2D{vec2f{spherical_theta_(vec) * inv_pi(),
                                    spherical_phi_(vec) * (0.5 * inv_pi())},
                              dot_(dsdp, dpdx), dot_(dsdp, dpdy),
                              dot_(dtdp, dpdx), dot_(dtdp, dpdy)};
        }
        Cylindrical(texture_from_render) => {
            pt = apply_point(texture_from_render, ctx.p);
            x2y2 = pt.x * pt.x + pt.y * pt.y;
            dsdp = vec3f{-pt.y, pt.x, 0.0} / (2.0 * pi() * x2y2);
            dtdp = vec3f{0.0, 0.0, 1.0};
            dpdx = apply_vector(texture_from_render, ctx.dpdx);
            dpdy = apply_vector(texture_from_render, ctx.dpdy);
            return TexCoord2D{vec2f{(pi() + atan2(pt.y, pt.x)) * (0.5 * inv_pi()),
                                    pt.z},
                              dot_(dsdp, dpdx), dot_(dsdp, dpdy),
                              dot_(dtdp, dpdx), dot_(dtdp, dpdy)};
        }
        Planar(texture_from_render, vs, vt, ds, dt) => {
            vec = apply_point(texture_from_render, ctx.p);
            dpdx = apply_vector(texture_from_render, ctx.dpdx);
            dpdy = apply_vector(texture_from_render, ctx.dpdy);
            return TexCoord2D{vec2f{ds + dot_(vec, vs), dt + dot_(vec, vt)},
                              dot_(vs, dpdx), dot_(vs, dpdy), dot_(vt, dpdx),
                              dot_(vt, dpdy)};
        }
    }
}

// pbrt: SphericalTheta and SphericalPhi, from util/vecmath.h.
func spherical_theta_(v : vec3f) -> Float = acos(min(max(v.z, -1.0), 1.0));
func spherical_phi_(v : vec3f) -> Float {
    p = atan2(v.y, v.x);
    return select(p < 0.0, p + 2.0 * pi(), p);
}

// pbrt: TexCoord3D and PointTransformMapping, the one 3D mapping: the point
// and its derivatives taken into the texture's frame.
element TexCoord3D {
    p : vec3f;
    dpdx : vec3f;
    dpdy : vec3f;
}

func map_3d(texture_from_render : Transform,
            ctx : TextureEvalContext) -> TexCoord3D {
    return TexCoord3D{apply_point(texture_from_render, ctx.p),
                      apply_vector(texture_from_render, ctx.dpdx),
                      apply_vector(texture_from_render, ctx.dpdy)};
}

// One level of a pyramid: where its texels start and how they are shaped.
// pbrt: Image::PixelFormat and ColorEncoding, as a texel is read. An 8-bit
// image stays 8-bit and is decoded as it is read, which is what pbrt's
// `Image::GetChannel` does with a U256 texel -- through `SRGBToLinearLUT`,
// or over 255 for a linear encoding -- and a float image stays float; a
// texture's levels all share one format, since pbrt's pyramid keeps the
// image's (`Image::GeneratePyramid`). Not an optimization: bistro's
// hundred-odd 2048x2048 PNGs are 1.4 GB as bytes and 5.6 GB as floats.
func texel_float() -> u32 = 0u;
func texel_srgb8() -> u32 = 1u;
func texel_linear8() -> u32 = 2u;

element TextureLevel {
    width : u32;
    height : u32;
    // In texels, into the pool the format names.
    first_texel : u32;
    format : u32;
}

// pbrt: ImageTexture, as the lookup needs it.
element ImageTexture {
    // pbrt: TextureMapping2D, how the hit becomes an image coordinate.
    mapping : Mapping2D;
    // pbrt's `scale`, with any constant `scale` texture over the image folded
    // in, as pbrt folds it (see scene_io.h).
    scale : Float;
    // pbrt: `MIPMap::Bilerp<Float>` on a three-channel image is the average
    // of the three filtered channels; see scene_io.h.
    average_channels : bool;
    invert : bool;
    wrap : u32;
    first_level : u32;
    n_levels : u32;
    // Which texture this is, as `texture_handles` is indexed.
    id : u32;
}

// pbrt: FloatTexture and SpectrumTexture, the TaggedPointers over the kinds
// of texture, as one variant: a texture is read as a number or as a spectrum
// by the parameter that names it, and the kinds that answer only one way --
// a noise is a number, a marble a spectrum -- are refused the other way by
// the converter, as pbrt's parser refuses them by declared type.
//
// The composite kinds name their operands by index into `textures`, which
// makes the table a graph: a `mix` of a `scale` of an image. pbrt evaluates
// it by recursion; here the depth is written out -- `eval_float_0` reads a
// leaf, `eval_float_1` a composite of leaves, and so on to three deep, which
// the converter checks (scene_dump.cpp) -- since a recursion whose two calls
// meet in a lerp is not one the schedule can make a loop of.
//
// `Constant` carries both a number and an rgb: a float constant is read
// through `value`, a spectrum one through `rgb` fitted as an albedo, which
// is pbrt's `SpectrumType::Albedo` -- the only type a constant reaches here,
// as every spectrum texture a material names is a reflectance or an albedo.
// `Scale` is pbrt's FloatScaledTexture, a texture times a float texture; a
// constant scale over an image folds into the image as pbrt folds it
// (scene_dump.cpp), so a `Scale` node is the varying case. `Mix` lerps by a
// float texture, `DirectionMix` by the normal's cosine with a direction in
// render space. The noises map the hit through `texture_from_render`, the
// inverse of the transform the texture was declared under, and count their
// octaves from the mapped footprint (fbm, turbulence below).
element Texture =
    | Image(t : ImageTexture)
    | Constant(value : Float, rgb : vec3f)
    | Scale(tex : i32, scale : i32)
    | Mix(tex1 : i32, tex2 : i32, amount : i32)
    | DirectionMix(tex1 : i32, tex2 : i32, dir : vec3f)
    | FBm(texture_from_render : Transform, octaves : i32, omega : Float)
    | Wrinkled(texture_from_render : Transform, octaves : i32, omega : Float)
    | Windy(texture_from_render : Transform)
    | Marble(texture_from_render : Transform, octaves : i32, omega : Float,
             scale : Float, variation : Float);

extern textures : array[Texture];
extern texture_levels : array[TextureLevel];
extern texture_texels : array[vec3f];
// The 8-bit levels' texels, three bytes each, as the image stored them.
extern texture_bytes : array[u8];
// pbrt: SRGBToLinearLUT, from util/color.cpp -- what an sRGB-encoded byte
// means, for the 256 bytes there are. The driver hands it over from
// apps/pbrt/srgb_table.h, which `scene_dump --check-tables` checks against
// pbrt's own.
extern srgb_to_linear : array[Float, 256];
// pbrt: NoisePerm, from util/noise.cpp -- Perlin's permutation of 0..255,
// twice over so that an index up to 510 needs no wrap. The driver hands it
// over from apps/pbrt/noise_table.h, generated from pbrt's source by
// make_spectrum_tables.py.
extern noise_perm : array[u8, 512];
// The texture units' object for each texture, made by the driver from the
// same pyramid (runtime/bonsai_cuda.h, bonsai_cuda_texture_create), for a
// schedule that binds the lookup to them (schedules/gpu.bonsai); zero, and
// never read, where the render runs on the CPU.
extern texture_handles : array[u64];
// pbrt's RGBToSpectrumTable for sRGB: 64 z nodes then the coefficients.
extern rgb_table : array[Float];

// pbrt: RemapPixelCoords, for the two wrap modes an image texture uses.
//
// `Black` is not a coordinate but a decision not to read, so it is handled by
// the caller -- this answers where to read and whether there is anywhere.
element TexelAt {
    x : i32;
    y : i32;
    inside : bool;
}

func remap_texel(x : i32, y : i32, w : i32, h : i32, wrap : u32) -> TexelAt {
    if wrap == wrap_black() {
        inside = (x >= 0) && (x < w) && (y >= 0) && (y < h);
        return TexelAt{x, y, inside};
    }
    if wrap == wrap_clamp() {
        return TexelAt{min(max(x, 0), w - 1), min(max(y, 0), h - 1), true};
    }
    // pbrt: `Mod(p[c], resolution[c])`, which is the mathematical modulus and
    // not C's remainder -- a negative coordinate has to wrap to the far edge
    // rather than to a negative one.
    mx = x % w;
    my = y % h;
    return TexelAt{select(mx < 0, mx + w, mx), select(my < 0, my + h, my),
                   true};
}

// pbrt: Image::GetChannel with a wrap mode, widened to RGB. A one-channel
// image was widened to three on the way in, so there is one case per
// format here: a float texel as it is, a byte texel decoded as pbrt decodes
// it -- `encoding.ToLinear` on a U256 pixel, which for sRGB is the table and
// for linear is the byte over 255.
func level_texel(level : TextureLevel, x : i32, y : i32,
                 wrap : u32) -> vec3f {
    at = remap_texel(x, y, cast[[i32]](level.width),
                     cast[[i32]](level.height), wrap);
    if !at.inside {
        return vec3f{0.0, 0.0, 0.0};
    }
    texel = level.first_texel + cast[[u32]](at.y) * level.width +
            cast[[u32]](at.x);
    if level.format == texel_float() {
        return texture_texels[texel];
    }
    byte = 3u * texel;
    r = cast[[u32]](texture_bytes[byte]);
    g = cast[[u32]](texture_bytes[byte + 1u]);
    b = cast[[u32]](texture_bytes[byte + 2u]);
    if level.format == texel_srgb8() {
        return vec3f{srgb_to_linear[r], srgb_to_linear[g], srgb_to_linear[b]};
    }
    return vec3f{cast[[Float]](r) / 255.0, cast[[Float]](g) / 255.0,
                 cast[[Float]](b) / 255.0};
}

// pbrt: Image::BilerpChannel, for all three channels at once.
func texture_bilerp(level : TextureLevel, st : vec2f, wrap : u32) -> vec3f {
    x = st.x * cast[[Float]](level.width) - 0.5;
    y = st.y * cast[[Float]](level.height) - 0.5;
    xi = cast[[i32]](floor_f(x));
    yi = cast[[i32]](floor_f(y));
    dx = x - cast[[Float]](xi);
    dy = y - cast[[Float]](yi);
    v00 = level_texel(level, xi, yi, wrap);
    v10 = level_texel(level, xi + 1, yi, wrap);
    v01 = level_texel(level, xi, yi + 1, wrap);
    v11 = level_texel(level, xi + 1, yi + 1, wrap);
    return (1.0 - dx) * (1.0 - dy) * v00 + dx * (1.0 - dy) * v10 +
           (1.0 - dx) * dy * v01 + dx * dy * v11;
}

// pbrt: MIPMap::Filter's choice of level, the non-EWA branch.
//
// The level comes from the footprint: `nLevels - 1 + log2(width)`, so a
// footprint of one texel at the finest level lands on level 0 and each doubling
// climbs one. A footprint wider than the whole image lands past the top of the
// pyramid, where the answer is the single texel the top level has -- reported
// as -1, because pbrt reads that texel differently from how it filters (see
// texture_float).
func filter_level(t : ImageTexture, dstdx : vec2f, dstdy : vec2f) -> i32 {
    width = 2.0 * max(max(abs(dstdx.x), abs(dstdx.y)),
                      max(abs(dstdy.x), abs(dstdy.y)));
    n_levels = cast[[Float]](t.n_levels);
    level = n_levels - 1.0 + log2_(max(width, 1e-8));
    if level >= n_levels - 1.0 {
        return -1;
    }
    return cast[[i32]](max(0.0, floor_f(level)));
}

// pbrt: MIPMap::Filter<RGB> with a bilinear filter: the level's texel at the
// top, the bilinear lookup below it. A one-channel image was shipped as three
// equal channels, so `Bilerp<RGB>`'s widening to grey is already done.
func texture_filter(t : ImageTexture, st : vec2f, dstdx : vec2f,
                    dstdy : vec2f) -> vec3f {
    level = filter_level(t, dstdx, dstdy);
    if level < 0 {
        top = texture_levels[t.first_level + t.n_levels - 1u];
        return level_texel(top, 0, 0, t.wrap);
    }
    return texture_bilerp(texture_levels[t.first_level + cast[[u32]](level)],
                          st, t.wrap);
}

// pbrt: MIPMap::Filter<Float> with a bilinear filter. The same level choice,
// and two different reads of it: `Texel<Float>` at the top is channel 0 of
// the one texel, whatever the image has; `Bilerp<Float>` below it is channel
// 0 of a one-channel image, the *average* of the three filtered channels of a
// three-channel one, and the alpha of a four-channel one. scene_dump shipped
// a one-channel image and an alpha as that channel in all three places, so
// `.x` is them; the three-channel case is the one that averages.
func texture_filter_float(t : ImageTexture, st : vec2f, dstdx : vec2f,
                          dstdy : vec2f) -> Float {
    level = filter_level(t, dstdx, dstdy);
    if level < 0 {
        top = texture_levels[t.first_level + t.n_levels - 1u];
        return level_texel(top, 0, 0, t.wrap).x;
    }
    filtered = texture_bilerp(
        texture_levels[t.first_level + cast[[u32]](level)], st, t.wrap);
    // pbrt: `ImageChannelValues::Average`, a running sum from zero divided by
    // the count -- `((0 + r) + g) + b) / 3`.
    average = ((0.0 + filtered.x) + filtered.y + filtered.z) / 3.0;
    return select(t.average_channels, average, filtered.x);
}

// pbrt: GPUSpectrumImageTexture::Evaluate -- the texture units' sample in
// place of `texture_filter`, for the GPU schedule that binds it there
// (`texture_filter.bind(TextureUnit, ...)` in schedules/gpu.bonsai): pbrt's
// GPU build samples its image textures with `tex2DGrad<float4>(texObj, s,
// 1 - t, (dsdx, dsdy), (dtdx, dtdy))`, and the same texture object, made
// from the same pyramid, is what `texture_handles` holds. The unit picks the
// level from the gradients and filters within it, so its answer is pbrt
// --gpu's and not pbrt CPU's bit for bit -- the two part the same way.
//
// pbrt hands the unit `(dsdx, dsdy)` as the first gradient and `(dtdx,
// dtdy)` as the second, which is the transpose of CUDA's convention (a
// gradient per screen axis); it is what pbrt --gpu computes, so it is what
// this passes.
func texture_filter_unit(handle : u64, st : vec2f, dstdx : vec2f,
                         dstdy : vec2f) -> vec3f {
    s = tex_sample_grad_2d(handle, st, vec2f{dstdx.x, dstdy.x},
                           vec2f{dstdx.y, dstdy.y});
    return vec3f{s.x, s.y, s.z};
}

// pbrt: GPUFloatImageTexture::Evaluate, `tex2DGrad<float>` -- one channel of
// the same object, which scene_dump made the float texture's value in every
// channel (see texture_filter_float); the three-channel case averages, as
// `Bilerp<Float>` does, which over a linear filter is the filter of the
// average.
func texture_filter_float_unit(handle : u64, average_channels : bool,
                               st : vec2f, dstdx : vec2f,
                               dstdy : vec2f) -> Float {
    s = tex_sample_grad_2d(handle, st, vec2f{dstdx.x, dstdy.x},
                           vec2f{dstdx.y, dstdy.y});
    average = ((0.0 + s.x) + s.y + s.z) / 3.0;
    return select(average_channels, average, s.x);
}

// The filtered RGB, before it is made into a spectrum: pbrt's
// `scale * mipmap->Filter(...)`, clamped at zero, and inverted where the
// texture says so.
//
// `t` is flipped first. pbrt's comment says why: texture coordinates put (0,0)
// at the lower left and image coordinates put it at the upper left.
func texture_rgb(t : ImageTexture, ctx : TextureEvalContext) -> vec3f {
    c = map_2d(t.mapping, ctx);
    st = vec2f{c.st.x, 1.0 - c.st.y};
    dstdx = vec2f{c.dsdx, c.dtdx};
    dstdy = vec2f{c.dsdy, c.dtdy};
    rgb = t.scale * texture_filter(t, st, dstdx, dstdy);
    inverted = select(t.invert, vec3f{1.0, 1.0, 1.0} - rgb, rgb);
    // pbrt: ClampZero, componentwise.
    return vec3f{max(inverted.x, 0.0), max(inverted.y, 0.0),
                 max(inverted.z, 0.0)};
}

// pbrt: FloatImageTexture::Evaluate, the same lookup read as one number.
//
// Which number is pbrt's `MIPMap::Bilerp<Float>`: a one-channel image's
// channel, a three-channel image's *average*, a four-channel image's *alpha*
// -- and it is decided per image, so scene_dump decides it, and ships a float
// texture's value in all three components. `.x` here is therefore that value
// after the same filter, and not the red channel of the picture.
func texture_float(t : ImageTexture, ctx : TextureEvalContext) -> Float {
    c = map_2d(t.mapping, ctx);
    st = vec2f{c.st.x, 1.0 - c.st.y};
    dstdx = vec2f{c.dsdx, c.dtdx};
    dstdy = vec2f{c.dsdy, c.dtdy};
    v = t.scale * texture_filter_float(t, st, dstdx, dstdy);
    // A float texture clamps only when inverted; pbrt's spectrum one clamps
    // always. Written the way each is written.
    return select(t.invert, max(0.0, 1.0 - v), v);
}

// pbrt: RGBToSpectrumTable::operator(), the trilinear interpolation that turns
// an RGB into the three coefficients of a sigmoid polynomial.
//
// The table is indexed by which component is largest, then by the other two
// divided by it, then by the largest itself through a non-uniform set of z
// nodes -- a parameterization that spreads the table's resolution where colours
// actually are rather than uniformly over the cube.
// One coefficient of the table, trilinearly interpolated from the eight corners
// around (xi, yi, zi).
//
// A function rather than a lambda inside `rgb_to_sigmoid` because a lambda that
// captures this many values *and* reads an extern array is more than the extern
// lowering can thread through today.
//
// The strides are the table's shape written out: three coefficients per entry,
// `res` entries per row, `res` rows per slice.
func rgb_coeff(base : u32, k : u32, dx : Float, dy : Float,
               dz : Float) -> Float {
    sx = 3u;         // one step in x
    sy = 64u * 3u;   // one step in y
    sz = 64u * 64u * 3u; // one step in z
    return lerp_(dz,
                 lerp_(dy,
                       lerp_(dx, rgb_table[base + k],
                             rgb_table[base + sx + k]),
                       lerp_(dx, rgb_table[base + sy + k],
                             rgb_table[base + sy + sx + k])),
                 lerp_(dy,
                       lerp_(dx, rgb_table[base + sz + k],
                             rgb_table[base + sz + sx + k]),
                       lerp_(dx, rgb_table[base + sz + sy + k],
                             rgb_table[base + sz + sy + sx + k])));
}

// Where in pbrt's table a colour falls: which of the three slices (the largest
// component's), the cell, and the offsets within it that the coefficients are
// interpolated by. Its own function so that check_differentials.sh's `sig`
// rows can print it beside the coefficients.
element RgbCell {
    maxc : u32;
    xi, yi, zi : u32;
    dx, dy, dz : Float;
}

func rgb_cell(rgb : vec3f) -> RgbCell {
    res = 64u;
    maxc : mut u32 = 2u;
    if rgb.x > rgb.y {
        maxc = select(rgb.x > rgb.z, 0u, 2u);
    } else {
        maxc = select(rgb.y > rgb.z, 1u, 2u);
    }
    z = select(maxc == 0u, rgb.x, select(maxc == 1u, rgb.y, rgb.z));
    // `(maxc + 1) % 3` and `(maxc + 2) % 3`, written out.
    c1 = select(maxc == 0u, rgb.y, select(maxc == 1u, rgb.z, rgb.x));
    c2 = select(maxc == 0u, rgb.z, select(maxc == 1u, rgb.x, rgb.y));
    // pbrt: `rgb[(maxc + 1) % 3] * (res - 1) / z` -- the product first, then
    // the divide, as C++ reads it left to right. Scaling by `(res - 1) / z`
    // instead rounds in the other order, and a near-grey colour sits where
    // the table's coefficients change fastest, so the last bit of `x` is a
    // visible difference in the spectrum.
    x = (c1 * cast[[Float]](res - 1u)) / z;
    y = (c2 * cast[[Float]](res - 1u)) / z;

    xi = min(cast[[u32]](x), res - 2u);
    yi = min(cast[[u32]](y), res - 2u);
    // pbrt: `FindInterval(res, [&](int i) { return zNodes[i] < z; })`, the last
    // index whose node is still below z, clamped to leave room for zi + 1.
    zi : mut u32 = 0u;
    i : mut u32 = 1u;
    while i < res - 1u {
        zi = select(rgb_table[i] < z, i, zi);
        i = i + 1u;
    }

    dx = x - cast[[Float]](xi);
    dy = y - cast[[Float]](yi);
    z0 = rgb_table[zi];
    z1 = rgb_table[zi + 1u];
    dz = (z - z0) / (z1 - z0);
    cell : RgbCell = {maxc, xi, yi, zi, dx, dy, dz};
    return cell;
}

func rgb_to_sigmoid(rgb_in : vec3f) -> SigmoidPolynomial {
    res = 64u;
    rgb = clamp(rgb_in, 0.0, 1.0);

    // A grey has no largest component and the fit is exact, so pbrt answers it
    // directly rather than interpolating: the constant whose sigmoid is the
    // grey. For black and for white that constant is a division by zero, and
    // is meant to be: minus and plus infinity, which `sigmoid` reads as
    // reflecting nothing and everything. A guard here that answered zero
    // instead made every black texel reflect half the light -- a textured
    // floor that pbrt left black in a third of its pixels was lit in all of
    // them, twelve percent brighter on average -- so there is no guard, as
    // pbrt has none.
    if (rgb.x == rgb.y) && (rgb.y == rgb.z) {
        s = (rgb.x - 0.5) / sqrt(rgb.x * (1.0 - rgb.x));
        return SigmoidPolynomial{0.0, 0.0, s};
    }

    cell = rgb_cell(rgb);

    // The coefficients start after the 64 z nodes, laid out as
    // [maxc][zi][yi][xi][coefficient].
    base = 64u + ((cell.maxc * res + cell.zi) * res + cell.yi) * res * 3u +
           cell.xi * 3u;

    return SigmoidPolynomial{rgb_coeff(base, 0u, cell.dx, cell.dy, cell.dz),
                             rgb_coeff(base, 1u, cell.dx, cell.dy, cell.dz),
                             rgb_coeff(base, 2u, cell.dx, cell.dy, cell.dz)};
}

// pbrt: `RGBUnboundedSpectrum(cs, rgb).Sample(lambda)` -- an RGB that may
// exceed one, an absorption coefficient say, as a spectrum: the colour is
// scaled by twice its largest component into the table's range, that is
// looked up, and the scale multiplies the sigmoid back out (`scale = 2 * m;
// rsp = cs.ToRGBCoeffs(scale ? rgb / scale : RGB(0, 0, 0))`, and `scale *
// rsp(lambda)`, zero when the scale is). The hair material's sigma_a takes
// this at the hit, from an `rgb sigma_a` or from the melanin concentrations.
func unbounded_rgb_at(rgb : vec3f, lambda : SampledWavelengths) -> vec4f {
    m = max(max(rgb.x, rgb.y), rgb.z);
    scale = 2.0 * m;
    if scale == 0.0 {
        return vec4f{0.0, 0.0, 0.0, 0.0};
    }
    // rgb_to_sigmoid clamps to [0, 1] where pbrt clamps below at zero alone;
    // scaled by twice the largest component nothing is above a half, so the
    // two are the same clamp here.
    return scale * spectrum_at(rgb_to_sigmoid(rgb / scale), lambda);
}

// pbrt: `RGBAlbedoSpectrum(cs, Clamp(rgb, 0, 1)).Sample(lambda)`, which is what
// a `SpectrumType::Albedo` image texture -- a reflectance -- becomes.
func texture_albedo(t : ImageTexture, ctx : TextureEvalContext,
                    lambda : SampledWavelengths) -> vec4f {
    rgb = texture_rgb(t, ctx);
    return spectrum_at(rgb_to_sigmoid(rgb), lambda);
}

// pbrt: Noise, from util/noise.cpp -- Perlin's gradient noise over the
// integer lattice, with pbrt's permutation table and its weight polynomial.
// The coordinates are taken modulo 2^30 first so that the lattice cell fits
// an i32; a coordinate below that in magnitude is itself, which is every
// coordinate a scene has, and the fallback for a larger one is written as
// the remainder rather than as fmod, which this language has not got.
func noise_perm_at(i : i32) -> i32 = cast[[i32]](noise_perm[cast[[u32]](i)]);

func noise_grad(x : i32, y : i32, z : i32, dx : Float, dy : Float,
                dz : Float) -> Float {
    h = noise_perm_at(noise_perm_at(noise_perm_at(x) + y) + z) & 15;
    u = select((h < 8) || (h == 12) || (h == 13), dx, dy);
    v = select((h < 4) || (h == 12) || (h == 13), dy, dz);
    return select((h & 1) != 0, -u, u) + select((h & 2) != 0, -v, v);
}

// pbrt: NoiseWeight, `6 t^5 - 15 t^4 + 10 t^3` with the powers as pbrt's
// `Pow<n>` multiplies them out -- `Pow<n/2>(t)^2 * Pow<n&1>(t)`, so t^3 is
// (t t) t, t^4 is (t t)(t t) and t^5 is that times t -- which is the last
// bit of every noise value, checked against pbrt's numbers by
// tests/bonsai/correctness/llvm/noise.bonsai.
func noise_weight(t : Float) -> Float {
    t2 = t * t;
    t3 = t2 * t;
    t4 = t2 * t2;
    t5 = t4 * t;
    return 6.0 * t5 - 15.0 * t4 + 10.0 * t3;
}

func noise_wrap(x : Float) -> Float {
    m = 1073741824.0;
    return select(abs(x) < m, x, x - floor_f(x / m) * m);
}

func noise(p : vec3f) -> Float {
    x = noise_wrap(p.x);
    y = noise_wrap(p.y);
    z = noise_wrap(p.z);
    fx = floor_f(x);
    fy = floor_f(y);
    fz = floor_f(z);
    dx = x - fx;
    dy = y - fy;
    dz = z - fz;
    ix = cast[[i32]](fx) & 255;
    iy = cast[[i32]](fy) & 255;
    iz = cast[[i32]](fz) & 255;
    w000 = noise_grad(ix, iy, iz, dx, dy, dz);
    w100 = noise_grad(ix + 1, iy, iz, dx - 1.0, dy, dz);
    w010 = noise_grad(ix, iy + 1, iz, dx, dy - 1.0, dz);
    w110 = noise_grad(ix + 1, iy + 1, iz, dx - 1.0, dy - 1.0, dz);
    w001 = noise_grad(ix, iy, iz + 1, dx, dy, dz - 1.0);
    w101 = noise_grad(ix + 1, iy, iz + 1, dx - 1.0, dy, dz - 1.0);
    w011 = noise_grad(ix, iy + 1, iz + 1, dx, dy - 1.0, dz - 1.0);
    w111 = noise_grad(ix + 1, iy + 1, iz + 1, dx - 1.0, dy - 1.0, dz - 1.0);
    wx = noise_weight(dx);
    wy = noise_weight(dy);
    wz = noise_weight(dz);
    x00 = lerp_(wx, w000, w100);
    x10 = lerp_(wx, w010, w110);
    x01 = lerp_(wx, w001, w101);
    x11 = lerp_(wx, w011, w111);
    y0 = lerp_(wy, x00, x10);
    y1 = lerp_(wy, x01, x11);
    return lerp_(wz, y0, y1);
}

// pbrt: DNoise -- the gradient of Noise by forward differences a hundredth
// apart, which the cloud medium (media.bonsai) perturbs its lookup point with.
func dnoise(p : vec3f) -> vec3f {
    delta = 0.01;
    n = noise(p);
    nx = noise(p + vec3f{delta, 0.0, 0.0});
    ny = noise(p + vec3f{0.0, delta, 0.0});
    nz = noise(p + vec3f{0.0, 0.0, delta});
    return vec3f{(nx - n) / delta, (ny - n) / delta, (nz - n) / delta};
}

// pbrt: SmoothStep.
func smooth_step_(x : Float, a : Float, b : Float) -> Float {
    if a == b {
        return select(x < a, 0.0, 1.0);
    }
    t = min(max((x - a) / (b - a), 0.0), 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// pbrt: FBm and Turbulence -- a sum of octaves of noise, each a factor of
// 1.99 finer and `omega` fainter than the last, with as many octaves as the
// footprint can resolve: `-1 - log2(len2) / 2` of them, the last one faded
// in by a smoothstep so that the count does not jump between pixels.
// Turbulence sums the absolute values and adds, for the octaves the footprint
// cannot resolve, the 0.2 each would have averaged to.
func noise_octaves(dpdx : vec3f, dpdy : vec3f, max_octaves : i32) -> Float {
    len2 = max(sqlen_(dpdx), sqlen_(dpdy));
    return min(max(-1.0 - log2_(len2) / 2.0, 0.0), cast[[Float]](max_octaves));
}

func fbm(p : vec3f, dpdx : vec3f, dpdy : vec3f, omega : Float,
         max_octaves : i32) -> Float {
    n = noise_octaves(dpdx, dpdy, max_octaves);
    n_int = cast[[i32]](floor_f(n));
    total : mut Float = 0.0;
    freq : mut Float = 1.0;
    o : mut Float = 1.0;
    for i in 0:n_int {
        total = total + o * noise(freq * p);
        freq = freq * 1.99;
        o = o * omega;
    }
    n_partial = n - cast[[Float]](n_int);
    return total + o * smooth_step_(n_partial, 0.3, 0.7) * noise(freq * p);
}

func turbulence(p : vec3f, dpdx : vec3f, dpdy : vec3f, omega : Float,
                max_octaves : i32) -> Float {
    n = noise_octaves(dpdx, dpdy, max_octaves);
    n_int = cast[[i32]](floor_f(n));
    total : mut Float = 0.0;
    freq : mut Float = 1.0;
    o : mut Float = 1.0;
    for i in 0:n_int {
        total = total + o * abs(noise(freq * p));
        freq = freq * 1.99;
        o = o * omega;
    }
    n_partial = n - cast[[Float]](n_int);
    total = total + o * lerp_(smooth_step_(n_partial, 0.3, 0.7), 0.2,
                              abs(noise(freq * p)));
    for i in n_int:max_octaves {
        total = total + o * 0.2;
        o = o * omega;
    }
    return total;
}

// pbrt: MarbleTexture::Evaluate's spline through its nine colours -- a cubic
// Bezier over the four around `t` (util/math.h, EvaluateCubicBezier) --
// and the sine of the noised height that picks the place on it.
func marble_colour(k : i32) -> vec3f {
    if k == 3 {
        return vec3f{0.5, 0.5, 0.5};
    }
    if k == 4 {
        return vec3f{0.6, 0.59, 0.58};
    }
    if k == 7 {
        return vec3f{0.2, 0.2, 0.33};
    }
    return vec3f{0.58, 0.58, 0.6};
}

func marble_rgb(texture_from_render : Transform, octaves : i32, omega : Float,
                scale : Float, variation : Float,
                ctx : TextureEvalContext) -> vec3f {
    c = map_3d(texture_from_render, ctx);
    p = scale * c.p;
    marble = p.y + variation * fbm(p, scale * c.dpdx, scale * c.dpdy, omega,
                                   octaves);
    t_raw = 0.5 + 0.5 * sin(marble);
    // Nine colours, six segments.
    first = min(cast[[i32]](floor_f(t_raw * 6.0)), 5);
    t = t_raw * 6.0 - cast[[Float]](first);
    c0 = marble_colour(first);
    c1 = marble_colour(first + 1);
    c2 = marble_colour(first + 2);
    c3 = marble_colour(first + 3);
    // pbrt: EvaluateCubicBezier, de Casteljau's three lerps then two then one.
    s0 = (1.0 - t) * c0 + t * c1;
    s1 = (1.0 - t) * c1 + t * c2;
    s2 = (1.0 - t) * c2 + t * c3;
    r0 = (1.0 - t) * s0 + t * s1;
    r1 = (1.0 - t) * s1 + t * s2;
    return 1.5 * ((1.0 - t) * r0 + t * r1);
}

// The leaves of the texture graph, read each way. A composite reaching a
// leaf reader is the converter's error, not a case: it answers nothing.
func eval_float_leaf(t : Texture, ctx : TextureEvalContext) -> Float {
    match t {
        Image(i) => return texture_float(i, ctx);
        Constant(value, rgb) => return value;
        FBm(texture_from_render, octaves, omega) => {
            c = map_3d(texture_from_render, ctx);
            return fbm(c.p, c.dpdx, c.dpdy, omega, octaves);
        }
        Wrinkled(texture_from_render, octaves, omega) => {
            c = map_3d(texture_from_render, ctx);
            return turbulence(c.p, c.dpdx, c.dpdy, omega, octaves);
        }
        Windy(texture_from_render) => {
            // pbrt: WindyTexture::Evaluate -- a coarse fbm for the wind and
            // a fine one for the waves, the first's magnitude scaling the
            // second.
            c = map_3d(texture_from_render, ctx);
            wind = fbm(0.1 * c.p, 0.1 * c.dpdx, 0.1 * c.dpdy, 0.5, 3);
            waves = fbm(c.p, c.dpdx, c.dpdy, 0.5, 6);
            return abs(wind) * waves;
        }
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return 0.0;
        Scale(tex, scale) => return 0.0;
        Mix(tex1, tex2, amount) => return 0.0;
        DirectionMix(tex1, tex2, dir) => return 0.0;
    }
}

func eval_rgb_leaf(t : Texture, ctx : TextureEvalContext) -> vec3f {
    match t {
        Image(i) => return texture_rgb(i, ctx);
        Constant(value, rgb) => return rgb;
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return marble_rgb(texture_from_render, octaves, omega, scale,
                              variation, ctx);
        FBm(texture_from_render, octaves, omega) => {
            v = eval_float_leaf(t, ctx);
            return vec3f{v, v, v};
        }
        Wrinkled(texture_from_render, octaves, omega) => {
            v = eval_float_leaf(t, ctx);
            return vec3f{v, v, v};
        }
        Windy(texture_from_render) => {
            v = eval_float_leaf(t, ctx);
            return vec3f{v, v, v};
        }
        Scale(tex, scale) => return vec3f{0.0, 0.0, 0.0};
        Mix(tex1, tex2, amount) => return vec3f{0.0, 0.0, 0.0};
        DirectionMix(tex1, tex2, dir) => return vec3f{0.0, 0.0, 0.0};
    }
}

// pbrt: a spectrum texture's Evaluate at the wavelengths: an image's
// filtered colour fitted as an albedo (texture_albedo), a constant's rgb
// fitted the same way, a marble's spline colour the same way --
// `RGBAlbedoSpectrum(*RGBColorSpace::sRGB, rgb).Sample(lambda)` in each.
func eval_spectrum_leaf(t : Texture, ctx : TextureEvalContext,
                        lambda : SampledWavelengths) -> vec4f {
    match t {
        Image(i) => return texture_albedo(i, ctx, lambda);
        Constant(value, rgb) => return spectrum_at(rgb_to_sigmoid(rgb), lambda);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return spectrum_at(rgb_to_sigmoid(marble_rgb(texture_from_render,
                                                         octaves, omega, scale,
                                                         variation, ctx)),
                               lambda);
        FBm(texture_from_render, octaves, omega) =>
            return vec4f{0.0, 0.0, 0.0, 0.0};
        Wrinkled(texture_from_render, octaves, omega) =>
            return vec4f{0.0, 0.0, 0.0, 0.0};
        Windy(texture_from_render) => return vec4f{0.0, 0.0, 0.0, 0.0};
        Scale(tex, scale) => return vec4f{0.0, 0.0, 0.0, 0.0};
        Mix(tex1, tex2, amount) => return vec4f{0.0, 0.0, 0.0, 0.0};
        DirectionMix(tex1, tex2, dir) => return vec4f{0.0, 0.0, 0.0, 0.0};
    }
}

// The graph, three levels deep at most. Level zero is a leaf; a level above
// it is a composite whose operands are read one level down, or a leaf. The
// composites are pbrt's: FloatScaledTexture's `sc == 0 ? 0 : tex * sc`,
// FloatMixTexture's `(1 - amt) * t1 + amt * t2` with the operand an amount
// of one or zero would multiply by zero left unread, and the direction mix
// with `AbsDot(ctx.n, dir)` as the amount.
//
// The two composite levels below the root are `[[noinline]]`. The device
// backend folds every function into the kernels that call it unless the
// program says otherwise (CodeGen_PTX.cpp), and a leaf -- the image filter,
// the three noises, the marble -- inlined through three composite levels is
// 1 + 3 + 9 + 27 copies of itself per read, at the twenty-odd reads a hit's
// materials make: the compiler ran out of memory building the material
// kernels. As calls, a level is compiled once. The root keeps its own leaf
// arms inline, so the common case -- an image or a constant with nothing
// above it -- pays no call; a composite's operands are a call each, which
// is what pbrt's GPU pays too, its MixTexture::Evaluate reaching its
// operands through the TaggedPointer dispatch that nvcc cannot unwind.
func eval_float_0(index : i32, ctx : TextureEvalContext) -> Float =
    eval_float_leaf(textures[cast[[u32]](index)], ctx);

func [[noinline]] eval_float_1(index : i32, ctx : TextureEvalContext) -> Float {
    t = textures[cast[[u32]](index)];
    match t {
        Scale(tex, scale) => {
            sc = eval_float_0(scale, ctx);
            if sc == 0.0 {
                return 0.0;
            }
            return eval_float_0(tex, ctx) * sc;
        }
        Mix(tex1, tex2, amount) => {
            amt = eval_float_0(amount, ctx);
            t1 : mut Float = 0.0;
            t2 : mut Float = 0.0;
            if amt != 1.0 {
                t1 = eval_float_0(tex1, ctx);
            }
            if amt != 0.0 {
                t2 = eval_float_0(tex2, ctx);
            }
            return (1.0 - amt) * t1 + amt * t2;
        }
        DirectionMix(tex1, tex2, dir) => {
            amt = abs(dot_(ctx.n, dir));
            t1 : mut Float = 0.0;
            t2 : mut Float = 0.0;
            if amt != 0.0 {
                t1 = eval_float_0(tex1, ctx);
            }
            if amt != 1.0 {
                t2 = eval_float_0(tex2, ctx);
            }
            return amt * t1 + (1.0 - amt) * t2;
        }
        Image(i) => return eval_float_leaf(t, ctx);
        Constant(value, rgb) => return value;
        FBm(texture_from_render, octaves, omega) => return eval_float_leaf(t, ctx);
        Wrinkled(texture_from_render, octaves, omega) =>
            return eval_float_leaf(t, ctx);
        Windy(texture_from_render) => return eval_float_leaf(t, ctx);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return 0.0;
    }
}

func [[noinline]] eval_float_2(index : i32, ctx : TextureEvalContext) -> Float {
    t = textures[cast[[u32]](index)];
    match t {
        Scale(tex, scale) => {
            sc = eval_float_1(scale, ctx);
            if sc == 0.0 {
                return 0.0;
            }
            return eval_float_1(tex, ctx) * sc;
        }
        Mix(tex1, tex2, amount) => {
            amt = eval_float_1(amount, ctx);
            t1 : mut Float = 0.0;
            t2 : mut Float = 0.0;
            if amt != 1.0 {
                t1 = eval_float_1(tex1, ctx);
            }
            if amt != 0.0 {
                t2 = eval_float_1(tex2, ctx);
            }
            return (1.0 - amt) * t1 + amt * t2;
        }
        DirectionMix(tex1, tex2, dir) => {
            amt = abs(dot_(ctx.n, dir));
            t1 : mut Float = 0.0;
            t2 : mut Float = 0.0;
            if amt != 0.0 {
                t1 = eval_float_1(tex1, ctx);
            }
            if amt != 1.0 {
                t2 = eval_float_1(tex2, ctx);
            }
            return amt * t1 + (1.0 - amt) * t2;
        }
        Image(i) => return eval_float_leaf(t, ctx);
        Constant(value, rgb) => return value;
        FBm(texture_from_render, octaves, omega) => return eval_float_leaf(t, ctx);
        Wrinkled(texture_from_render, octaves, omega) =>
            return eval_float_leaf(t, ctx);
        Windy(texture_from_render) => return eval_float_leaf(t, ctx);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return 0.0;
    }
}

// pbrt: FloatTexture::Evaluate, of the texture at `index` -- the root of
// its graph.
func eval_float(index : i32, ctx : TextureEvalContext) -> Float {
    t = textures[cast[[u32]](index)];
    match t {
        Scale(tex, scale) => {
            sc = eval_float_2(scale, ctx);
            if sc == 0.0 {
                return 0.0;
            }
            return eval_float_2(tex, ctx) * sc;
        }
        Mix(tex1, tex2, amount) => {
            amt = eval_float_2(amount, ctx);
            t1 : mut Float = 0.0;
            t2 : mut Float = 0.0;
            if amt != 1.0 {
                t1 = eval_float_2(tex1, ctx);
            }
            if amt != 0.0 {
                t2 = eval_float_2(tex2, ctx);
            }
            return (1.0 - amt) * t1 + amt * t2;
        }
        DirectionMix(tex1, tex2, dir) => {
            amt = abs(dot_(ctx.n, dir));
            t1 : mut Float = 0.0;
            t2 : mut Float = 0.0;
            if amt != 0.0 {
                t1 = eval_float_2(tex1, ctx);
            }
            if amt != 1.0 {
                t2 = eval_float_2(tex2, ctx);
            }
            return amt * t1 + (1.0 - amt) * t2;
        }
        Image(i) => return eval_float_leaf(t, ctx);
        Constant(value, rgb) => return value;
        FBm(texture_from_render, octaves, omega) => return eval_float_leaf(t, ctx);
        Wrinkled(texture_from_render, octaves, omega) =>
            return eval_float_leaf(t, ctx);
        Windy(texture_from_render) => return eval_float_leaf(t, ctx);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return 0.0;
    }
}

// The same three levels for a spectrum. A composite's amount or scale is a
// float texture, read with the float reader one level down.
func eval_spectrum_0(index : i32, ctx : TextureEvalContext,
                     lambda : SampledWavelengths) -> vec4f =
    eval_spectrum_leaf(textures[cast[[u32]](index)], ctx, lambda);

func [[noinline]] eval_spectrum_1(index : i32, ctx : TextureEvalContext,
                                  lambda : SampledWavelengths) -> vec4f {
    t = textures[cast[[u32]](index)];
    zero = vec4f{0.0, 0.0, 0.0, 0.0};
    match t {
        Scale(tex, scale) => {
            sc = eval_float_0(scale, ctx);
            if sc == 0.0 {
                return zero;
            }
            return eval_spectrum_0(tex, ctx, lambda) * sc;
        }
        Mix(tex1, tex2, amount) => {
            amt = eval_float_0(amount, ctx);
            t1 : mut vec4f = zero;
            t2 : mut vec4f = zero;
            if amt != 1.0 {
                t1 = eval_spectrum_0(tex1, ctx, lambda);
            }
            if amt != 0.0 {
                t2 = eval_spectrum_0(tex2, ctx, lambda);
            }
            return (1.0 - amt) * t1 + amt * t2;
        }
        DirectionMix(tex1, tex2, dir) => {
            amt = abs(dot_(ctx.n, dir));
            t1 : mut vec4f = zero;
            t2 : mut vec4f = zero;
            if amt != 0.0 {
                t1 = eval_spectrum_0(tex1, ctx, lambda);
            }
            if amt != 1.0 {
                t2 = eval_spectrum_0(tex2, ctx, lambda);
            }
            return amt * t1 + (1.0 - amt) * t2;
        }
        Image(i) => return eval_spectrum_leaf(t, ctx, lambda);
        Constant(value, rgb) => return eval_spectrum_leaf(t, ctx, lambda);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return eval_spectrum_leaf(t, ctx, lambda);
        FBm(texture_from_render, octaves, omega) => return zero;
        Wrinkled(texture_from_render, octaves, omega) => return zero;
        Windy(texture_from_render) => return zero;
    }
}

func [[noinline]] eval_spectrum_2(index : i32, ctx : TextureEvalContext,
                                  lambda : SampledWavelengths) -> vec4f {
    t = textures[cast[[u32]](index)];
    zero = vec4f{0.0, 0.0, 0.0, 0.0};
    match t {
        Scale(tex, scale) => {
            sc = eval_float_1(scale, ctx);
            if sc == 0.0 {
                return zero;
            }
            return eval_spectrum_1(tex, ctx, lambda) * sc;
        }
        Mix(tex1, tex2, amount) => {
            amt = eval_float_1(amount, ctx);
            t1 : mut vec4f = zero;
            t2 : mut vec4f = zero;
            if amt != 1.0 {
                t1 = eval_spectrum_1(tex1, ctx, lambda);
            }
            if amt != 0.0 {
                t2 = eval_spectrum_1(tex2, ctx, lambda);
            }
            return (1.0 - amt) * t1 + amt * t2;
        }
        DirectionMix(tex1, tex2, dir) => {
            amt = abs(dot_(ctx.n, dir));
            t1 : mut vec4f = zero;
            t2 : mut vec4f = zero;
            if amt != 0.0 {
                t1 = eval_spectrum_1(tex1, ctx, lambda);
            }
            if amt != 1.0 {
                t2 = eval_spectrum_1(tex2, ctx, lambda);
            }
            return amt * t1 + (1.0 - amt) * t2;
        }
        Image(i) => return eval_spectrum_leaf(t, ctx, lambda);
        Constant(value, rgb) => return eval_spectrum_leaf(t, ctx, lambda);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return eval_spectrum_leaf(t, ctx, lambda);
        FBm(texture_from_render, octaves, omega) => return zero;
        Wrinkled(texture_from_render, octaves, omega) => return zero;
        Windy(texture_from_render) => return zero;
    }
}

// pbrt: SpectrumTexture::Evaluate, of the texture at `index`.
func eval_spectrum(index : i32, ctx : TextureEvalContext,
                   lambda : SampledWavelengths) -> vec4f {
    t = textures[cast[[u32]](index)];
    zero = vec4f{0.0, 0.0, 0.0, 0.0};
    match t {
        Scale(tex, scale) => {
            sc = eval_float_2(scale, ctx);
            if sc == 0.0 {
                return zero;
            }
            return eval_spectrum_2(tex, ctx, lambda) * sc;
        }
        Mix(tex1, tex2, amount) => {
            amt = eval_float_2(amount, ctx);
            t1 : mut vec4f = zero;
            t2 : mut vec4f = zero;
            if amt != 1.0 {
                t1 = eval_spectrum_2(tex1, ctx, lambda);
            }
            if amt != 0.0 {
                t2 = eval_spectrum_2(tex2, ctx, lambda);
            }
            return (1.0 - amt) * t1 + amt * t2;
        }
        DirectionMix(tex1, tex2, dir) => {
            amt = abs(dot_(ctx.n, dir));
            t1 : mut vec4f = zero;
            t2 : mut vec4f = zero;
            if amt != 0.0 {
                t1 = eval_spectrum_2(tex1, ctx, lambda);
            }
            if amt != 1.0 {
                t2 = eval_spectrum_2(tex2, ctx, lambda);
            }
            return amt * t1 + (1.0 - amt) * t2;
        }
        Image(i) => return eval_spectrum_leaf(t, ctx, lambda);
        Constant(value, rgb) => return eval_spectrum_leaf(t, ctx, lambda);
        Marble(texture_from_render, octaves, omega, scale, variation) =>
            return eval_spectrum_leaf(t, ctx, lambda);
        FBm(texture_from_render, octaves, omega) => return zero;
        Wrinkled(texture_from_render, octaves, omega) => return zero;
        Windy(texture_from_render) => return zero;
    }
}

// The filtered colour of the texture at `index` before it is read as a
// number or fitted, for check_differentials.sh's `texrgb` rows: only the
// root is read, since the rows are for the image filter.
func eval_rgb(index : i32, ctx : TextureEvalContext) -> vec3f =
    eval_rgb_leaf(textures[cast[[u32]](index)], ctx);
