// pbrt: Transform and PerspectiveCamera, from util/transform.h and cameras.h.
//
// Only what applying a camera needs. What pbrt computes in a camera's
// constructor -- the field of view, the screen window and the resolution
// becoming two matrices -- is computed by scene_dump using pbrt's own Transform
// arithmetic and handed over as data. That is faithful to pbrt's hot path,
// which only ever *applies* them.
import stdlib/numerics;
// For `sample_uniform_disk_concentric`, which is where a lens point comes
// from. bxdf.bonsai does not depend on the camera, so this is not a cycle.
import apps/pbrt/bxdf;
import apps/pbrt/shapes;
import apps/pbrt/spectrum;

// pbrt: Transform, minus the inverse it carries alongside the matrix. Nothing
// here inverts one -- the driver hands over both directions it needs already
// inverted -- so storing mInv would be storing something never read.
//
// Rows rather than a flat 16, so that applying one is four dot products.
element Transform {
    r0, r1, r2, r3 : vec4f;
}

// One row of the matrix against a direction: `m0*x + m1*y + m2*z`, as fused
// multiply-adds because pbrt's compiler fuses them. Not a four-element dot
// product against a homogeneous vector, which is the same number in exact
// arithmetic and a different one in floating point -- and a camera ray a bit
// out lands a bit out, which a layered BSDF turns into different noise. See
// dot_ in stdlib/numerics for which multiply pairs with which add.
func apply_row(row : vec4f, v : vec3f) -> Float =
    fma(row.z, v.z, fma(row.y, v.y, row.x * v.x));

// pbrt: Transform::operator()(Point3f), which divides through by w. The
// perspective transform is the whole reason that divide is here: for an
// affine transform w comes out 1 and PBRT skips it.
func apply_point(t : Transform, p : vec3f) -> vec3f {
    xp = apply_row(t.r0, p) + t.r0.w;
    yp = apply_row(t.r1, p) + t.r1.w;
    zp = apply_row(t.r2, p) + t.r2.w;
    wp = apply_row(t.r3, p) + t.r3.w;
    v = vec3f{xp, yp, zp};
    return select(wp == 1.0, v, v / wp);
}

// pbrt: Transform::operator()(Vector3f). A direction ignores the translation
// column, so this is the upper-left 3x3 and no divide.
func apply_vector(t : Transform, v : vec3f) -> vec3f {
    return vec3f{apply_row(t.r0, v), apply_row(t.r1, v), apply_row(t.r2, v)};
}

// pbrt: CameraSample. With --disable-pixel-jitter every sample sits at the
// pixel's centre and weighs one, so p_lens and time are fixed and the film's
// weighted sum is a plain average -- but they are here because GenerateRay's
// signature is what a jittered sampler fills in.
element CameraSample {
    p_film : vec2f;
    p_lens : vec2f;
    time : Float = 0.0;
    filter_weight : Float = 1.0;
}

// pbrt: RayDifferential's extra members, kept beside a `Ray` rather than on it.
//
// pbrt makes RayDifferential a subclass of Ray and this keeps the same split
// for the same reason: the BVH traversal never reads any of these, and a `Ray`
// is what it copies at every node. Forty-eight more bytes on that would be paid
// per node visited, for something only the shading code wants.
//
// `has_differentials` is false for every ray after a non-specular bounce --
// pbrt's SpawnRay only propagates differentials through specular reflection and
// transmission -- which is why the approximation below is the common path and
// not the fallback it looks like.
element RayDifferential {
    rx_origin : vec3f;
    ry_origin : vec3f;
    rx_direction : vec3f;
    ry_direction : vec3f;
    has_differentials : bool = false;
}

// pbrt: CameraRayDifferential, a ray and its differentials together.
element CameraRay {
    ray : Ray;
    diff : RayDifferential;
}

// pbrt: PerspectiveCamera, and the constants its constructor derives. The two
// transforms come from the field of view, the screen window and the resolution;
// `camera_from_render` is the second one inverted; the rest are what ray
// differentials need. All of them are computed by scene_dump using pbrt's own
// arithmetic -- see the note at the top of this file.
element PerspectiveCamera {
    camera_from_raster : Transform;
    render_from_camera : Transform;
    camera_from_render : Transform;
    // pbrt: dxCamera, dyCamera. One raster pixel, in camera space.
    dx_camera : vec3f;
    dy_camera : vec3f;
    // pbrt: minPosDifferentialX/Y, minDirDifferentialX/Y, from
    // FindMinimumDifferentials.
    min_pos_differential_x : vec3f;
    min_pos_differential_y : vec3f;
    min_dir_differential_x : vec3f;
    min_dir_differential_y : vec3f;
    // pbrt: ProjectiveCamera's lensRadius and focalDistance. A radius of zero
    // is a pinhole and is the common case; anything else puts the ray's origin
    // on the lens and aims it through the point the film is focused on.
    lens_radius : Float = 0.0;
    focal_distance : Float = 1.0e6;
}

// pbrt: PerspectiveCamera::GenerateRayDifferential, both branches.
//
// Every ray leaves the camera's origin and passes through the sample's point on
// the film plane, and the two differential rays pass through the points one
// raster pixel across and one down. With a lens the origins move onto it and
// each ray is re-aimed through where the film is focused, which is what puts
// everything but the focal plane out of focus.
//
// pbrt transforms the whole ray by `RenderFromCamera` at the end. That is done
// per component here, which is the same thing: the transform is applied to the
// origin as a point and to each direction as a vector, exactly as
// `Transform::operator()(const RayDifferential &)` does.
func generate_ray_differential(camera : PerspectiveCamera,
                               sample : CameraSample) -> CameraRay {
    p_film = vec3f{sample.p_film.x, sample.p_film.y, 0.0};
    p_camera = apply_point(camera.camera_from_raster, p_film);
    d_camera = unit_vector_(p_camera);

    if camera.lens_radius <= 0.0 {
        o = apply_point(camera.render_from_camera, vec3f{0.0, 0.0, 0.0});
        d = apply_vector(camera.render_from_camera, d_camera);
        rx_d = apply_vector(camera.render_from_camera,
                            unit_vector_(p_camera + camera.dx_camera));
        ry_d = apply_vector(camera.render_from_camera,
                            unit_vector_(p_camera + camera.dy_camera));
        return CameraRay{Ray{o, d}, RayDifferential{o, o, rx_d, ry_d, true}};
    }

    // pbrt draws the lens point twice -- once for the ray and once, from the
    // same `sample.pLens`, for the differentials -- so the two draws give the
    // same point and the offset rays start where the main one does.
    p_lens = camera.lens_radius * sample_uniform_disk_concentric(sample.p_lens);
    lens_o = vec3f{p_lens.x, p_lens.y, 0.0};

    ft = camera.focal_distance / d_camera.z;
    p_focus = ft * d_camera;
    d_lens = unit_vector_(p_focus - lens_o);

    dx = unit_vector_(p_camera + camera.dx_camera);
    ftx = camera.focal_distance / dx.z;
    p_focus_x = ftx * dx;
    rx_lens_d = unit_vector_(p_focus_x - lens_o);

    dy = unit_vector_(p_camera + camera.dy_camera);
    fty = camera.focal_distance / dy.z;
    p_focus_y = fty * dy;
    ry_lens_d = unit_vector_(p_focus_y - lens_o);

    o = apply_point(camera.render_from_camera, lens_o);
    return CameraRay{Ray{o, apply_vector(camera.render_from_camera, d_lens)},
                     RayDifferential{
                         o, o,
                         apply_vector(camera.render_from_camera, rx_lens_d),
                         apply_vector(camera.render_from_camera, ry_lens_d),
                         true}};
}

// pbrt: PerspectiveCamera::GenerateRay, for the places that want a ray and no
// differentials -- there is nothing to filter along a shadow ray.
func generate_ray(camera : PerspectiveCamera, sample : CameraSample) -> Ray {
    return generate_ray_differential(camera, sample).ray;
}

// pbrt: RayDifferential::ScaleDifferentials, which RenderCPU applies to every
// camera ray before tracing it.
//
// The differentials come out of the camera one pixel apart, and a pixel is
// sampled `spp` times -- so the footprint a texture should filter over is
// narrower than a pixel by roughly 1/sqrt(spp). The 0.125 floor stops a very
// high sample count from asking for a footprint far below one texel, where the
// filtering would cost more than the aliasing it removes.
func scale_differentials(r : Ray, dr : RayDifferential,
                         s : Float) -> RayDifferential {
    return RayDifferential{r.o + (dr.rx_origin - r.o) * s,
                           r.o + (dr.ry_origin - r.o) * s,
                           r.d + (dr.rx_direction - r.d) * s,
                           r.d + (dr.ry_direction - r.d) * s,
                           dr.has_differentials};
}

// pbrt: RenderCPU's `cameraRay->ray.ScaleDifferentials(rayDiffScale)`, where
// `rayDiffScale` is `max(.125, 1 / sqrt(spp))` unless jitter is disabled.
func ray_differential_scale(spp : u32, disable_jitter : bool) -> Float =
    select(disable_jitter, 1.0, max(0.125, 1.0 / sqrt(cast[[Float]](spp))));
