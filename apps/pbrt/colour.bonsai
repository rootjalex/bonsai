// pbrt: the colour conversion a film ends with, from util/spectrum.h and
// util/colorspace.h.
//
// Separate from spectrum.bonsai, which holds the representation itself: this
// file is the one that needs the tabulated matching curves, and a table is an
// extern the driver has to supply. Anything that only wants to evaluate a
// spectrum -- a material working out its own reflectance, say -- should not
// have to be handed four hundred and seventy-one numbers to do it.
import stdlib/numerics;
import apps/pbrt/spectrum;

// The CIE curves and the film's illuminant, tabulated once per nanometre from
// 360 to 830. Generated from pbrt's own source and checked against a running
// pbrt; see make_spectrum_tables.py and `scene_dump --check-tables`.
extern cie_x : array[Float, 471];
extern cie_y : array[Float, 471];
extern cie_z : array[Float, 471];
extern illuminant_d65 : array[Float, 471];

// pbrt: PixelSensor's three response curves and RGBFilm's
// `outputRGBFromSensorRGB`. The camera records a radiance as the integral of it
// against each of its three curves; the film then maps that sensor RGB to the
// output space through one 3x3. The default `cie1931` sensor's curves are X, Y
// and Z and its matrix is pbrt's `RGBFromXYZ`; a named camera sensor has its own
// measured curves and a matrix pbrt fits by least squares. Both are built by
// pbrt's own PixelSensor in scene_dump and handed here, on the same 360..830 nm
// grid as `cie_x`, row-major -- so the radiance path is one shape whatever the
// sensor. These are separate from the CIE curves above, which the *reflectance*
// path (spectrum_to_rgb) still needs and which do not depend on the sensor.
extern sensor_r : array[Float, 471];
extern sensor_g : array[Float, 471];
extern sensor_b : array[Float, 471];
extern output_rgb_from_sensor : array[Float, 9];
// pbrt: RGBColorSpace::RGBFromXYZ, the film's colour space's own matrix from
// XYZ to its RGB, nine floats pbrt computes from the space's primaries and
// white point and the converter copies out (scene_dump). What the gbuffer's
// albedo is converted through (GBufferFilm::AddSample: `albedo.ToRGB(lambda,
// *colorSpace)`), and what a four-digit sRGB matrix written out here used to
// stand in for -- off in the last digits on every albedo pixel (10-25).
extern rgb_from_xyz : array[Float, 9];

// pbrt: DenselySampledSpectrum::operator(), which rounds to the nearest
// nanometre rather than interpolating -- the table is dense enough that it
// does not, and matching means rounding the same way.
func spectrum_at_dense(table : array[Float, 471],
                       w : SampledWavelengths) -> vec4f {
    // Every wavelength SampleVisible produces is already inside the table's
    // range, so this indexes without clamping; a sampler that could stray
    // outside it would need pbrt's zero-outside-the-range answer here.
    //
    // Indexed by the four wavelengths at once: one gather, stated here rather
    // than left for LLVM to assemble from four loads, which its SLP
    // vectorizer did through LLVM 19 and stopped doing in LLVM 23.
    o = cast[[vector[i32, 4]]](round(w.lambda) - 360.0);
    return table[o];
}

// The same, for one of several dense spectra laid end to end in an array
// without a size -- the environment maps' illuminants (render.bonsai's
// `env_illuminants`), 471 values each from `first`.
func spectrum_at_dense_in(table : array[Float], first : i32,
                          w : SampledWavelengths) -> vec4f {
    o = cast[[vector[i32, 4]]](round(w.lambda) - 360.0) + first;
    return table[o];
}

// pbrt: SampledSpectrum::ToXYZ followed by RGBColorSpace::ToRGB.
//
// Each of X, Y and Z is the spectrum against that matching curve, averaged
// over the four samples and divided by the probability each was drawn with --
// a Monte Carlo estimate of an integral, which is what four samples of a
// spectrum can give. The division by the CIE Y integral is what makes a
// perfectly reflecting surface come out at one rather than at 106.
func average_over_pdf(v : vec4f, w : SampledWavelengths) -> Float {
    // pbrt: SafeDiv, because a wavelength can be drawn with zero density.
    return sum(select(w.pdf == 0.0, 0.0, v / w.pdf)) / 4.0;
}

// pbrt: SampledSpectrum::ToXYZ, which divides by the CIE Y integral, and
// PixelSensor::ToSensorRGB, which does not.
//
// The two paths differ by exactly that constant and the difference is not a
// detail: a reflectance is a ratio and has to come out at one for a perfect
// reflector, which is what dividing by 106.857 arranges; a radiance is a
// quantity and pbrt's sensor carries it through unnormalized, scaled instead by
// the imaging ratio -- `exposureTime * ISO / 100`, which is one at pbrt's
// defaults. Normalizing a radiance too makes an image uniformly a hundred times
// too dim, which looks like a light that is too weak rather than like a bug.
func xyz_of(s : vec4f, w : SampledWavelengths) -> vec3f {
    return vec3f{average_over_pdf(spectrum_at_dense(cie_x, w) * s, w),
                 average_over_pdf(spectrum_at_dense(cie_y, w) * s, w),
                 average_over_pdf(spectrum_at_dense(cie_z, w) * s, w)};
}

// pbrt: RGBColorSpace::ToRGB, `RGBFromXYZ * xyz` with the colour space's own
// matrix (`rgb_from_xyz`, from the converter). It was a four-digit sRGB matrix
// written out here, which left no albedo pixel bit-exact against pbrt's.
func rgb_of_xyz(xyz : vec3f) -> vec3f {
    m = rgb_from_xyz;
    return vec3f{m[0] * xyz.x + m[1] * xyz.y + m[2] * xyz.z,
                 m[3] * xyz.x + m[4] * xyz.y + m[5] * xyz.z,
                 m[6] * xyz.x + m[7] * xyz.y + m[8] * xyz.z};
}

// A reflectance, normalized so that a perfect reflector is one.
func spectrum_to_rgb(s : vec4f, w : SampledWavelengths) -> vec3f {
    return rgb_of_xyz(xyz_of(s, w) / 106.856895);
}

// pbrt: PixelSensor::ToSensorRGB's `(bar.Sample(lambda) * L).Average()` for each
// of the three response curves -- the radiance integrated against the sensor,
// not divided by the CIE Y integral the way a reflectance is. For the default
// cie1931 sensor these curves are X, Y and Z, so this is the XYZ estimate; for a
// named camera they are its own responses and this is the camera's raw RGB.
func sensor_rgb_of(s : vec4f, w : SampledWavelengths) -> vec3f {
    return vec3f{average_over_pdf(spectrum_at_dense(sensor_r, w) * s, w),
                 average_over_pdf(spectrum_at_dense(sensor_g, w) * s, w),
                 average_over_pdf(spectrum_at_dense(sensor_b, w) * s, w)};
}

// A radiance, as pbrt's sensor records it: the sensor RGB above, scaled by the
// imaging ratio and mapped to the output space by RGBFilm's own
// `outputRGBFromSensorRGB`. For the default sensor that matrix is pbrt's
// `RGBFromXYZ` and this reduces to the XYZ-to-sRGB the film always did; a named
// sensor folds its least-squares camera-to-XYZ fit into the same matrix, which
// is why nothing here has to know which sensor the scene named.
//
// `imaging_ratio` is pbrt's `exposureTime * ISO / 100`, which is one at its
// defaults -- and was assumed to be one here until a scene set `"float iso"`
// and came out five times too dim. Every test scene had left it alone, so the
// assumption held for as long as nothing tried it.
func radiance_to_rgb(s : vec4f, w : SampledWavelengths,
                     imaging_ratio : Float) -> vec3f {
    return sensor_to_output_rgb(imaging_ratio * sensor_rgb_of(s, w));
}

// pbrt: RGBFilm's `outputRGBFromSensorRGB * rgb` (GetPixelRGB), the sensor's
// RGB taken to the output colour space. Linear, so a film may apply it per
// sample and sum, or sum and apply it once, alike -- but not before the
// per-sample clamp: pbrt's AddSample clamps the *sensor* RGB
// (`maxcomponentvalue`), and a saturated sample's output red can stand above
// the clamp where its XYZ did not (a 2500 K candle at scale 25000 in
// pavilion-night came out 0.55x pbrt's when the film clamped after this
// matrix instead; 10-25).
func sensor_to_output_rgb(c : vec3f) -> vec3f {
    m = output_rgb_from_sensor;
    return vec3f{m[0] * c.x + m[1] * c.y + m[2] * c.z,
                 m[3] * c.x + m[4] * c.y + m[5] * c.z,
                 m[6] * c.x + m[7] * c.y + m[8] * c.z};
}
