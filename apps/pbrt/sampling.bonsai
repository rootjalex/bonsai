// pbrt: util/sampling.h -- the distributions, as distinct from the samplers.
//
// pbrt keeps these apart and so does this app: `sampler.bonsai` is
// `samplers.h`, the objects that hand out uniform numbers, and this is what
// those numbers are warped into. The distinction is not filing: a sampler is
// something a scene names and a schedule cares about, and a warp is arithmetic
// that anything may use.
//
// This file exists because both `shapes.bonsai` and `bxdf.bonsai` need the same
// warps -- a shape samples a direction towards a light, a BSDF samples one
// leaving a surface -- and neither imports the other. Before it, the uniform
// sphere lived in bxdf.bonsai and shapes.bonsai reached it only because
// render.bonsai happened to import both, which is a dependency nothing
// declares and that breaks the moment a file is compiled on its own.
import stdlib/numerics;

// pbrt's constants, as f32. Written out rather than derived: the rounding of
// each is part of the answer, and `2.0 * pi()` is not `two_pi()`. Here rather
// than in bxdf.bonsai, where they started, because this file and the shapes
// use them and bxdf.bonsai imports this one.
func pi() -> Float = 3.14159265358979323846;
func inv_pi() -> Float = 0.31830988618379067154;
func pi_over_2() -> Float = 1.57079632679489661923;
func pi_over_4() -> Float = 0.78539816339744830961;

func sampling_pi() -> Float = 3.14159265358979323846;

// pbrt: SampleUniformSphere, and the constant density that goes with it.
//
// The whole sphere rather than a hemisphere. RandomWalkIntegrator scatters with
// this: it knows nothing about the surface and picks a direction that may well
// go into it, which is why its estimator divides by a density that does not
// depend on the direction at all.
func sample_uniform_sphere(u : vec2f) -> vec3f {
    z = fma(-2.0, u.x, 1.0);
    r = sqrt(max(0.0, 1.0 - sqr(z)));
    phi = 2.0 * sampling_pi() * u.y;
    return vec3f{r * cos(phi), r * sin(phi), z};
}

func uniform_sphere_pdf() -> Float = 1.0 / (4.0 * sampling_pi());

// pbrt: SafeSqrt, the square root of a quantity that is mathematically
// non-negative and can be a few ulp below zero once rounded. Here rather than
// in bxdf.bonsai because a shape's cone sampling needs it too, and neither file
// imports the other.
func safe_sqrt(x : Float) -> Float = sqrt(max(0.0, x));

// pbrt: SafeASin, the arc sine of a sine that rounding may have pushed a
// little outside [-1, 1] (shapes.bonsai's angle_between, the hair BSDF's
// gamma angles).
func safe_asin(x : Float) -> Float = asin(min(max(x, -1.0), 1.0));

// pbrt: FastExp, from util/math.h.
//
// Not a call to `exp`. pbrt's is a polynomial in the fractional part of
// x/ln 2, scaled by a power of two written straight into the exponent field,
// and it disagrees with a correctly rounded exponential in the last few bits.
// A layered walk multiplies its throughput by one of these at every layer
// crossing, so the difference compounds; matching pbrt means matching the
// approximation and not the function it approximates.
//
// Here rather than in bxdf.bonsai, where it started, because the Gaussian
// reconstruction filter in filter.bonsai is built out of it as well and cannot
// import bxdf.bonsai -- that file imports this one.
func floor_f(x : Float) -> Float {
    t = cast[[Float]](cast[[i32]](x));
    // Truncation rounds towards zero, so a negative non-integer lands one
    // above where the floor is.
    return select(t > x, t - 1.0, t);
}

func fast_exp(x : Float) -> Float {
    // e^x = 2^(x log2 e).
    xp = x * 1.442695041;
    fxp = floor_f(xp);
    f = xp - fxp;
    i = cast[[i32]](fxp);

    // pbrt: EvaluatePolynomial, which is Horner built out of fused
    // multiply-adds -- so this is fma and not multiply-then-add.
    two_to_f = fma(f, fma(f, fma(f, 0.0781455737, 0.226173572), 0.695556856),
                   1.0);

    bits = reinterpret[[u32]](two_to_f);
    // pbrt: Exponent, the biased exponent field read back as a power of two.
    exponent = cast[[i32]](bits >> 23u) - 127 + i;
    if exponent < -126 {
        return 0.0;
    }
    if exponent > 127 {
        return inf;
    }
    // The sign and significand of 2^f with the new exponent dropped in.
    scaled = (bits & 0x807fffffu) | (cast[[u32]](exponent + 127) << 23u);
    return reinterpret[[Float]](scaled);
}

// pbrt: std::copysign, which is a bit operation and not a comparison. The
// difference is the two zeroes: `copysign(1, -0)` is -1 where `-0 < 0` is
// false, and an environment map's mirroring lands on exactly that case at the
// seams of the octahedron.
func copysign_(magnitude : Float, sign : Float) -> Float {
    bits = (reinterpret[[u32]](magnitude) & 0x7fffffffu) |
           (reinterpret[[u32]](sign) & 0x80000000u);
    return reinterpret[[Float]](bits);
}

// pbrt: EqualAreaSphereToSquare, from util/math.h -- Clarberg's mapping between
// the unit sphere and the unit square, which is what an environment map is
// stored in.
//
// "Equal area" is the property that makes it worth the trouble: every texel of
// the square covers the same solid angle, so a uniform sample of the square is
// a uniform sample of the sphere and a sum over texels is an integral over
// directions with no Jacobian to carry. A latitude-longitude map has neither
// property -- its texels crowd at the poles -- which is why pbrt refuses to
// treat one as an environment map without converting it first.
//
// The shape of it: fold the sphere onto an octahedron, unfold the octahedron
// onto a square. `r = sqrt(1 - |z|)` is the fold, the polynomial is the angle
// around it, and the two mirrorings at the end put the point back in the
// quadrant its signs came from.
//
// The polynomial is pbrt's own minimax approximation of `atan(b) * 2/pi` over
// [0, 1] and not a call to `atan`. Matching pbrt means matching the
// approximation, exactly as `fast_exp` above does -- and it is evaluated by
// Horner in fused multiply-adds, because pbrt's EvaluatePolynomial is.
func equal_area_sphere_to_square(d : vec3f) -> vec2f {
    x = abs(d.x);
    y = abs(d.y);
    z = abs(d.z);

    // The radius, as the distance from the pole rather than from the axis.
    r = safe_sqrt(1.0 - z);

    // The argument to the arctangent, guarded where the larger of the two is
    // zero and the ratio would be zero over zero.
    a = max(x, y);
    b0 = min(x, y);
    b = select(a == 0.0, 0.0, b0 / a);

    // Innermost first: pbrt's EvaluatePolynomial(b, t1..t7) is Horner from
    // the HIGHEST coefficient, so the innermost fma is `b * t7 + t6`. This
    // once had t6 and t7 swapped -- the two highest terms trading degrees, an
    // error of (t6-t7)*(b^5-b^6), up to half a percent of a quadrant -- and
    // every environment lookup landed texels away from pbrt's wherever the
    // direction was off the axes and diagonals: bistro's sky disagreed with
    // pbrt on 137k pixels, two-sided and tiny, until 2026-10-05.
    phi0 = fma(b, fma(b, fma(b, fma(b, fma(b, fma(b, -0.251390972343483509333252996350e-1,
                                             0.419038818029165735901852432784e-1),
                                        0.881770664775316294736387951347e-1),
                                   -0.247333733281268944196501420480),
                              0.61572017898280213493197203466e-2),
                         0.636226545274016134946890922156),
              0.406758566246788489601959989e-5);
    // Past 45 degrees the roles of the two axes swap, which is the same angle
    // measured from the other side.
    phi = select(x < y, 1.0 - phi0, phi0);

    v0 = phi * r;
    u0 = r - v0;

    // The southern hemisphere is the northern one mirrored through the centre
    // of the square, which is what unfolding the lower half of the octahedron
    // outwards comes to.
    u1 = select(d.z < 0.0, 1.0 - v0, u0);
    v1 = select(d.z < 0.0, 1.0 - u0, v0);

    // And back into the quadrant the signs of x and y name. `copysign` rather
    // than a comparison, because pbrt uses copysign and the two differ at a
    // negative zero.
    u = copysign_(u1, d.x);
    v = copysign_(v1, d.y);
    return vec2f{0.5 * (u + 1.0), 0.5 * (v + 1.0)};
}

func pi_quarter() -> Float = 0.78539816339744830961;

// pbrt: EqualAreaSquareToSphere, the other direction -- a point on the square
// back to the direction it stands for. What sampling an environment map needs,
// where reading one needs the inverse above.
//
// The two are not each other's transcription: this one goes through the signed
// distance from the octahedron's diagonal and a real `cos`/`sin`, where the
// inverse uses a polynomial for the angle. pbrt writes them that way and the
// asymmetry is theirs.
func equal_area_square_to_sphere(p : vec2f) -> vec3f {
    // Onto [-1, 1]^2, and the quadrant folded away.
    u = fma(2.0, p.x, -1.0);
    v = fma(2.0, p.y, -1.0);
    up = abs(u);
    vp = abs(v);

    // How far inside the diagonal `|u| + |v| = 1` the point is. Its sign is
    // which hemisphere, its magnitude is how far from the equator.
    signed_distance = 1.0 - (up + vp);
    d = abs(signed_distance);
    r = 1.0 - d;

    // The angle around the axis. `r == 0` is the pole, where every angle is the
    // same point and pbrt picks one rather than dividing by zero.
    phi = select(r == 0.0, 1.0, (vp - up) / r + 1.0) * (pi_quarter());
    z = copysign_(1.0 - sqr(r), signed_distance);

    cos_phi = copysign_(cos(phi), u);
    sin_phi = copysign_(sin(phi), v);
    ring = r * safe_sqrt(2.0 - sqr(r));
    return vec3f{cos_phi * ring, sin_phi * ring, z};
}

// pbrt: FindInterval, from util/math.h. The last index whose CDF entry is still
// at or below `u`, found by a branchless binary search over a table that is
// known to be sorted.
//
// `base` because every distribution here is a row of one flat array: an array
// of arrays is a pointer to chase, and the filter's conditionals are forty-eight
// tables of forty-nine entries that are better off laid end to end.
//
// pbrt's is written over `size` and `first` rather than over a low and a high
// bound, and the two are not the same search when the predicate is false
// everywhere -- so it is transcribed rather than rewritten as the bisection a
// reader would reach for.
func find_interval(n : i32, cdf : array[Float], base : i32, u : Float) -> i32 {
    size : mut i32 = n - 2;
    first : mut i32 = 1;
    while size > 0 {
        half = size >> 1;
        middle = first + half;
        found = cdf[base + middle] <= u;
        first = select(found, middle + 1, first);
        size = select(found, size - (half + 1), half);
    }
    return min(max(first - 1, 0), n - 2);
}

// Where in a piecewise-constant distribution a uniform sample lands, and which
// of its intervals that was.
element CdfSample {
    x : Float;
    offset : i32;
}

// pbrt: PiecewiseConstant1D::Sample, minus the density.
//
// The density is the caller's because the two distributions that use this do
// not share a function table: a filter's conditional rows are the absolute
// value of the filter itself, and the marginal has a table of its own made of
// their integrals. Returning the interval is what lets the caller look the
// right value up.
//
// `lo` and `hi` are the domain the intervals are spread over, which for a
// filter is its radius either side of zero rather than the unit interval.
func cdf_sample(cdf : array[Float], base : i32, n : i32, lo : Float, hi : Float,
                u : Float) -> CdfSample {
    o = find_interval(n + 1, cdf, base, u);
    width = cdf[base + o + 1] - cdf[base + o];
    du : mut Float = u - cdf[base + o];
    if width > 0.0 {
        du = du / width;
    }
    // pbrt: Lerp(t, min, max), which is `(1 - t) * min + t * max` and not
    // `min + t * (max - min)`. The two differ in the last bit.
    t = (cast[[Float]](o) + du) / cast[[Float]](n);
    s : CdfSample = {(1.0 - t) * lo + t * hi, o};
    return s;
}

// pbrt: PiecewiseConstant2D, as the renderer needs it -- where its tables begin
// and what its marginal integrates to.
//
// The tables themselves are the caller's arrays, because two different things
// want this over the same image: an environment map's texels, and the same
// texels with their own average subtracted. They differ only in the numbers, so
// they differ only in these offsets.
element Dist2D {
    // `nx * ny` values, the function being sampled.
    first_value : i32;
    // `ny * (nx + 1)` entries: one conditional CDF per row, laid end to end,
    // because an array of arrays is a pointer to chase per sample.
    first_cond_cdf : i32;
    // `ny` entries, each row's integral -- which is also the marginal's own
    // function, exactly as PiecewiseConstant2D builds it.
    first_marg_func : i32;
    // `ny + 1` entries.
    first_marg_cdf : i32;
    // pbrt: pMarginal.Integral().
    integral : Float;
}

element Dist2DSample {
    uv : vec2f;
    pdf : Float;
}

// pbrt: PiecewiseConstant2D::Sample over the unit square. The marginal in `v`
// first and then the conditional row it landed in, which is pbrt's order and
// matters -- the two components of `u` are not interchangeable once the
// distribution is not separable.
func dist2d_sample(d : Dist2D, nx : i32, ny : i32, u : vec2f,
                   values : array[Float], cond_cdf : array[Float],
                   marg_func : array[Float],
                   marg_cdf : array[Float]) -> Dist2DSample {
    marg = cdf_sample(marg_cdf, d.first_marg_cdf, ny, 0.0, 1.0, u.y);
    row = marg.offset;
    row_int = marg_func[d.first_marg_func + row];
    pdf_v = select(d.integral > 0.0, row_int / d.integral, 0.0);

    cond = cdf_sample(cond_cdf, d.first_cond_cdf + row * (nx + 1), nx, 0.0, 1.0,
                      u.x);
    pdf_u = select(row_int > 0.0,
                   values[d.first_value + row * nx + cond.offset] / row_int,
                   0.0);

    s : Dist2DSample = {vec2f{cond.x, marg.x}, pdf_u * pdf_v};
    return s;
}

// pbrt: PiecewiseConstant2D::PDF. The density at a point, without sampling to
// get there -- `func[iu] / pMarginal.Integral()`, which is what the sampler's
// two halves multiply to.
func dist2d_pdf(d : Dist2D, nx : i32, ny : i32, uv : vec2f,
                values : array[Float]) -> Float {
    iu = min(max(cast[[i32]](uv.x * cast[[Float]](nx)), 0), nx - 1);
    iv = min(max(cast[[i32]](uv.y * cast[[Float]](ny)), 0), ny - 1);
    return select(d.integral > 0.0,
                  values[d.first_value + iv * nx + iu] / d.integral, 0.0);
}

// pbrt: SampleUniformDiskPolar, SampleUniformDiskConcentric and
// SampleCosineHemisphere, from util/sampling.h. Used by the BSDFs, by the
// camera's lens, and by a disk shape's area sampling, which is why they are
// here rather than in bxdf.bonsai.
func sample_uniform_disk_polar(u : vec2f) -> vec2f {
    r = sqrt(u.x);
    theta = 2.0 * pi() * u.y;
    return vec2f{r * cos(theta), r * sin(theta)};
}

// The concentric map, which sends the square to the disk without the shearing
// a polar map introduces -- the reason pbrt uses this one for a hemisphere and
// the polar one for a microfacet normal.
func sample_uniform_disk_concentric(u : vec2f) -> vec2f {
    offset = 2.0 * u - vec2f{1.0, 1.0};
    if (offset.x == 0.0) && (offset.y == 0.0) {
        return vec2f{0.0, 0.0};
    }
    // Whichever coordinate is larger names the wedge the point falls in.
    r : mut Float = offset.y;
    theta : mut Float = pi_over_2() - pi_over_4() * (offset.x / offset.y);
    if abs(offset.x) > abs(offset.y) {
        r = offset.x;
        theta = pi_over_4() * (offset.y / offset.x);
    }
    return r * vec2f{cos(theta), sin(theta)};
}

func sample_cosine_hemisphere(u : vec2f) -> vec3f {
    d = sample_uniform_disk_concentric(u);
    return vec3f{d.x, d.y, safe_sqrt(1.0 - sqr(d.x) - sqr(d.y))};
}

func cosine_hemisphere_pdf(cos_theta_ : Float) -> Float = cos_theta_ * inv_pi();

// pbrt: Bounds2f -- a rectangle of the unit square, for the window a portal
// light samples inside (the part of its image the portal covers as seen from
// a point).
element Bounds2f {
    lo : vec2f;
    hi : vec2f;
}

// pbrt: Bounds2(p1, p2), the corners taken componentwise, so the order of the
// two points does not matter.
func bounds2f_of(a : vec2f, b : vec2f) -> Bounds2f {
    out : Bounds2f = {min(a, b), max(a, b)};
    return out;
}

// pbrt: Inside(p, b), inclusive on both ends.
func bounds2f_inside(p : vec2f, b : Bounds2f) -> bool =
    (p.x >= b.lo.x) && (p.x <= b.hi.x) && (p.y >= b.lo.y) && (p.y <= b.hi.y);

func ceil_f(x : Float) -> Float = -floor_f(-x);

// pbrt: Clamp(val, low, high) on a Float; stdlib's `clamp` is the vec3f one.
func clamp_f(x : Float, low : Float, high : Float) -> Float =
    min(max(x, low), high);

// pbrt: WindowedPiecewiseConstant2D -- a piecewise-constant distribution over
// the unit square that can be sampled inside any rectangle of it, which is
// what a portal light needs: the part of the sky its portal shows changes
// with the point being lit. Where PiecewiseConstant2D keeps CDFs, this keeps
// the function (`values`) and its summed-area table (`sums`: the sum of the
// function over every rectangle from the origin), from which the integral
// over any window is four lookups. Both are nx*ny long, laid end to end for
// every such light in `env_dist_values` and `env_sat` (render.bonsai); this
// says where the light's start. pbrt sums the table in double and reads it
// back as a float, and so does the driver that builds it.
element WindowedDist2D {
    first_value : i32;
    first_sum : i32;
}

// pbrt: SummedAreaTable::LookupInt -- the table one in from the edge, and
// zero on the edge, a sum over nothing.
func sat_lookup_int(d : WindowedDist2D, nx : i32, ny : i32, x : i32, y : i32,
                    sums : array[Float]) -> Float {
    if (x == 0) || (y == 0) {
        return 0.0;
    }
    xi = min(x - 1, nx - 1);
    yi = min(y - 1, ny - 1);
    return sums[d.first_sum + yi * nx + xi];
}

// pbrt: SummedAreaTable::Lookup -- the table read bilinearly at a point of
// the unit square, which makes the integral below continuous in its window.
func sat_lookup(d : WindowedDist2D, nx : i32, ny : i32, x : Float, y : Float,
                sums : array[Float]) -> Float {
    xs = x * cast[[Float]](nx);
    ys = y * cast[[Float]](ny);
    x0 = cast[[i32]](xs);
    y0 = cast[[i32]](ys);
    v00 = sat_lookup_int(d, nx, ny, x0, y0, sums);
    v10 = sat_lookup_int(d, nx, ny, x0 + 1, y0, sums);
    v01 = sat_lookup_int(d, nx, ny, x0, y0 + 1, sums);
    v11 = sat_lookup_int(d, nx, ny, x0 + 1, y0 + 1, sums);
    dx = xs - cast[[Float]](x0);
    dy = ys - cast[[Float]](y0);
    return (1.0 - dx) * (1.0 - dy) * v00 + (1.0 - dx) * dy * v01 +
           dx * (1.0 - dy) * v10 + dx * dy * v11;
}

// pbrt: SummedAreaTable::Integral -- the function's integral over a window,
// as the four corners' lookups combined in double (the table's entries are
// sums of millions of texels, and the difference of two of them for a small
// window would lose everything in a float), divided by the texel count,
// and never below zero.
func sat_integral(d : WindowedDist2D, nx : i32, ny : i32, b : Bounds2f,
                  sums : array[Float]) -> Float {
    s = (cast[[f64]](sat_lookup(d, nx, ny, b.hi.x, b.hi.y, sums)) -
         cast[[f64]](sat_lookup(d, nx, ny, b.lo.x, b.hi.y, sums))) +
        (cast[[f64]](sat_lookup(d, nx, ny, b.lo.x, b.lo.y, sums)) -
         cast[[f64]](sat_lookup(d, nx, ny, b.hi.x, b.lo.y, sums)));
    return max(cast[[Float]](s / cast[[f64]](nx * ny)), 0.0);
}

// pbrt: WindowedPiecewiseConstant2D::Eval -- the function at a point.
func windowed_eval(d : WindowedDist2D, nx : i32, ny : i32, p : vec2f,
                   values : array[Float]) -> Float {
    xi = min(cast[[i32]](p.x * cast[[Float]](nx)), nx - 1);
    yi = min(cast[[i32]](p.y * cast[[Float]](ny)), ny - 1);
    return values[d.first_value + yi * nx + xi];
}

// pbrt: WindowedPiecewiseConstant2D::SampleBisection, for the marginal along
// x: the CDF is the window's integral up to x over the window's whole
// integral, and the bisection narrows [lo, hi] until it lies within one
// column, then interpolates the CDF across it. `b_int` is the whole window's
// integral, passed in because the caller has it.
func windowed_bisect_x(d : WindowedDist2D, nx : i32, ny : i32, b : Bounds2f,
                       b_int : Float, u : Float, sums : array[Float]) -> Float {
    n = cast[[Float]](nx);
    lo : mut Float = b.lo.x;
    hi : mut Float = b.hi.x;
    while ceil_f(n * hi) - floor_f(n * lo) > 1.0 {
        // (`halfway`, not `mid`: shapes.bonsai has a function of that name,
        // and a statement opening with a function's name is read as a call.)
        halfway = (lo + hi) / 2.0;
        bx : Bounds2f = {b.lo, vec2f{halfway, b.hi.y}};
        if sat_integral(d, nx, ny, bx, sums) / b_int > u {
            hi = halfway;
        } else {
            lo = halfway;
        }
    }
    b_lo : Bounds2f = {b.lo, vec2f{lo, b.hi.y}};
    b_hi : Bounds2f = {b.lo, vec2f{hi, b.hi.y}};
    p_lo = sat_integral(d, nx, ny, b_lo, sums) / b_int;
    p_hi = sat_integral(d, nx, ny, b_hi, sums) / b_int;
    t = (u - p_lo) / (p_hi - p_lo);
    return clamp_f((1.0 - t) * lo + t * hi, lo, hi);
}

// The same along y, inside the column strip the x sample chose.
func windowed_bisect_y(d : WindowedDist2D, nx : i32, ny : i32, b : Bounds2f,
                       b_int : Float, u : Float, sums : array[Float]) -> Float {
    n = cast[[Float]](ny);
    lo : mut Float = b.lo.y;
    hi : mut Float = b.hi.y;
    while ceil_f(n * hi) - floor_f(n * lo) > 1.0 {
        halfway = (lo + hi) / 2.0;
        by : Bounds2f = {b.lo, vec2f{b.hi.x, halfway}};
        if sat_integral(d, nx, ny, by, sums) / b_int > u {
            hi = halfway;
        } else {
            lo = halfway;
        }
    }
    b_lo : Bounds2f = {b.lo, vec2f{b.hi.x, lo}};
    b_hi : Bounds2f = {b.lo, vec2f{b.hi.x, hi}};
    p_lo = sat_integral(d, nx, ny, b_lo, sums) / b_int;
    p_hi = sat_integral(d, nx, ny, b_hi, sums) / b_int;
    t = (u - p_lo) / (p_hi - p_lo);
    return clamp_f((1.0 - t) * lo + t * hi, lo, hi);
}

// pbrt: WindowedPiecewiseConstant2D::Sample -- a point inside the window `b`
// with density proportional to the function there: x from the window's
// marginal, then y from the column strip that x fell in (one texel wide,
// widened to a texel when x lands on a boundary). Nothing when the window
// holds no energy. The density is in the unit square's measure.
func windowed_sample(d : WindowedDist2D, nx : i32, ny : i32, u : vec2f,
                     b : Bounds2f, values : array[Float],
                     sums : array[Float]) -> option[Dist2DSample] {
    b_int = sat_integral(d, nx, ny, b, sums);
    if b_int == 0.0 {
        return {};
    }
    px = windowed_bisect_x(d, nx, ny, b, b_int, u.x, sums);
    n = cast[[Float]](nx);
    c_lo = floor_f(px * n) / n;
    c_hi : mut Float = ceil_f(px * n) / n;
    if c_lo == c_hi {
        c_hi = c_hi + 1.0 / n;
    }
    b_cond : Bounds2f = {vec2f{c_lo, b.lo.y}, vec2f{c_hi, b.hi.y}};
    cond_int = sat_integral(d, nx, ny, b_cond, sums);
    if cond_int == 0.0 {
        return {};
    }
    py = windowed_bisect_y(d, nx, ny, b_cond, cond_int, u.y, sums);
    p = vec2f{px, py};
    s : Dist2DSample = {p, windowed_eval(d, nx, ny, p, values) / b_int};
    return s;
}

// pbrt: WindowedPiecewiseConstant2D::PDF -- the function at the point over
// the window's integral; zero for an empty window.
func windowed_pdf(d : WindowedDist2D, nx : i32, ny : i32, p : vec2f,
                  b : Bounds2f, values : array[Float],
                  sums : array[Float]) -> Float {
    b_int = sat_integral(d, nx, ny, b, sums);
    if b_int == 0.0 {
        return 0.0;
    }
    return windowed_eval(d, nx, ny, p, values) / b_int;
}
