// pbrt: SampledSpectrum and SampledWavelengths, from util/spectrum.h.
//
// The representation only. The tabulated matching curves and the conversion to
// RGB a film ends with are in colour.bonsai, which needs them as externs; this
// file has none, so anything that only wants to evaluate a spectrum -- a
// material working out its own reflectance -- can import it on its own.
//
// A spectrum here is not a curve but four samples of one, at four wavelengths
// chosen per ray. That is v4's central representation and it maps onto a bonsai
// vector exactly, which is why the plan puts spectra early: every function that
// carries radiance has to carry these, and retrofitting them later would be the
// expensive edit.
import stdlib/numerics;

element SampledWavelengths {
    lambda : vec4f;
    pdf : vec4f;
}

// pbrt: SampleVisibleWavelengths and VisibleWavelengthsPDF. A fit to where the
// eye actually responds, so that four samples are spent near the middle of the
// visible range rather than spread evenly across a span whose ends contribute
// almost nothing.
//
// This is what a film samples with -- FilmBase::SampleWavelengths calls
// SampleVisible, and GBufferFilm inherits it. SampleUniform, which is the
// obvious reading of "four wavelengths", belongs to SpectralFilm and gives
// visibly different colours; the difference was measured before it was
// believed.
// The two are written with atanh and cosh rather than with the logarithm and
// the exponential they can be built from, because the algebraically equal forms
// are not equal in floating point: 0.5*log((1+x)/(1-x)) differs from atanh(x)
// in the last bit for about half of all inputs. That last bit would not matter
// if the result were used directly, but a wavelength is rounded to the nearest
// nanometre to index a densely sampled spectrum, so a difference of one ulp
// occasionally picks the neighbouring entry -- which showed up as a scattering
// of pixels, about one in seventy thousand, whose albedo was a percent out.
// pbrt writes this as `538 - 138.888889f * std::atanh(...)`, and the compiler
// it is built with contracts that into a fused multiply-add. Written as the fma
// here for the same reason the Horner evaluation below is: a fused multiply-add
// rounds once where a multiply and a subtract round twice, so the two are not
// the same number, and this one is a wavelength about to be rounded to the
// nearest nanometre.
func sample_visible_wavelengths(u : vec4f) -> vec4f {
    return fma(-138.888889, atanh(0.85691062 - 1.82750197 * u), 538.0);
}

func visible_wavelengths_pdf(lambda : vec4f) -> vec4f {
    c = cosh(0.0072 * (lambda - 538.0));
    density = 0.0039398042 / (c * c);
    outside = (lambda < 360.0) | (lambda > 830.0);
    return select(outside, 0.0, density);
}

// pbrt: SampledWavelengths::SampleVisible. One number becomes four, spread a
// quarter of the way apart through the sample's own space and wrapped, so that
// the four are stratified rather than four draws of the same distribution.
func sample_wavelengths_visible(u : Float) -> SampledWavelengths {
    offsets = vec4f{0.0, 0.25, 0.5, 0.75};
    raw = u + offsets;
    up = select(raw > 1.0, raw - 1.0, raw);
    lambda = sample_visible_wavelengths(up);
    w : SampledWavelengths = {lambda, visible_wavelengths_pdf(lambda)};
    return w;
}

// pbrt: RGBSigmoidPolynomial, the three coefficients an RGB albedo is fitted
// to. The driver runs the fit -- see rgb2spec.h -- exactly as pbrt looks it up
// in a table it generated offline, because a Gauss-Newton solve is not
// something to do per ray.
element SigmoidPolynomial {
    c0, c1, c2 : Float;
}

// pbrt: RGBSigmoidPolynomial::s, the sigmoid that keeps a reflectance inside
// zero and one however the polynomial swings.
func sigmoid(x : vec4f) -> vec4f {
    return 0.5 + x / (2.0 * sqrt(1.0 + x * x));
}

func spectrum_at(p : SigmoidPolynomial, w : SampledWavelengths) -> vec4f {
    // pbrt evaluates the quadratic by Horner, so this does too: the grouping
    // is part of the answer in floating point.
    x = fma(fma(p.c0, w.lambda, p.c1), w.lambda, p.c2);
    return sigmoid(x);
}

