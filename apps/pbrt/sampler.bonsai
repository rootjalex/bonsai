// pbrt: the samplers, from samplers.h.
//
// Reproduced exactly rather than merely in spirit. Two renderers with different
// noise converge to the same image, so at low sample counts no comparison of
// two renders could say which one was pbrt's -- matching the stream is what
// makes the comparison mean anything at all. Every constant and step here is
// checked against pbrt's own sampler in
// tests/bonsai/correctness/llvm/sampler.bonsai.
//
// The generator and the hashes that seed it are in rng.bonsai, because a
// layered BSDF draws from the same generator and wants nothing else from here.
//
// The sampler is a variant rather than one hard-coded kind, so that which one a
// scene asks for is a property of the scene. Adding another is a case here and
// a case in each of the three functions below it, and nothing outside this file
// changes.
import stdlib/numerics;
import apps/pbrt/rng;

// pbrt: the first thousand primes, from util/primes.h, which are the bases the
// Halton sequence uses one per dimension. Generated by the driver rather than
// written down -- a sieve is a loop, and a thousand-line table in the source
// would be a thousand lines nobody can check by reading.
extern primes : array[i32, 1000];

// pbrt: PrimeTableSize, which is where the dimensions wrap round.
func prime_table_size() -> i32 = 1000;

// pbrt: the DigitPermutations the HaltonSampler's constructor builds -- one per
// prime, each a permutation of the digit values in that base for each digit
// position that can still change the answer.
//
// pbrt keeps a `DigitPermutation` per base, holding its own pointer into an
// allocation of `nDigits * base` uint16_t. Here the thousand of them are laid
// end to end and `digit_permutation_offsets[base_index]` says where each one
// begins, for the reason the triangle meshes are laid end to end: an array
// inside an array is a pointer to chase, and this one is read on the hot path
// of every draw.
//
// They are built by `build_digit_permutations` below, into storage the driver
// owns -- the same arrangement the ADT pools have, and what lets a table this
// large exist in a program that refuses to allocate.
extern digit_permutations : array[u16];
extern digit_permutation_offsets : array[i32, 1000];

// pbrt: OneMinusEpsilon, the largest float below one. A radical inverse that
// reached exactly one would put a sample on the far edge of whatever it
// indexes, the same reason RNG::Uniform<Float> is held below one.
func one_minus_epsilon() -> Float = 0.99999994;

// pbrt: RadicalInverse. The digits of `a` in base `primes[base_index]`,
// reflected about the decimal point -- which is the whole of what makes a
// Halton sequence fill the unit interval evenly instead of randomly.
//
// The loop stops at `limit` as well as when the digits run out, because one
// more digit past that point would overflow the accumulator rather than add
// precision.
func radical_inverse(base_index : i32, a : u64) -> Float {
    base = primes[base_index];
    b : u64 = cast[[u64]](base);
    limit = 0xffffffffffffffff / b - b;
    inv_base = 1.0 / cast[[Float]](base);
    inv_base_m : mut Float = 1.0;
    reversed : mut u64 = 0u;
    v : mut u64 = a;
    while (v != 0u) && (reversed < limit) {
        next = v / b;
        digit = v - next * b;
        reversed = reversed * b + digit;
        inv_base_m = inv_base_m * inv_base;
        v = next;
    }
    return min(cast[[Float]](reversed) * inv_base_m, one_minus_epsilon());
}

// pbrt: InverseRadicalInverse. Which index has this radical inverse, given how
// many digits it was written with -- the reflection undone. The Halton sampler
// uses it to find where in the sequence a given pixel's samples begin.
func inverse_radical_inverse(inverse : u64, base : i32, n_digits : i32) -> u64 {
    b : u64 = cast[[u64]](base);
    index : mut u64 = 0u;
    v : mut u64 = inverse;
    for i in 0:n_digits {
        digit = v % b;
        v = v / b;
        index = index * b + digit;
    }
    return index;
}

// pbrt: DigitPermutation, "compute number of digits needed for base".
//
// How many digits of a radical inverse in this base can still change a Float,
// which is how many the permutation has to cover. The expression is the one
// `scrambled_radical_inverse` loops on below, and it has to stay the same
// expression: the two answers being different by a digit is a read past the end
// of that base's permutation.
func digit_permutation_digits(base : i32) -> i32 {
    inv_base = 1.0 / cast[[Float]](base);
    inv_base_m : mut Float = 1.0;
    n : mut i32 = 0;
    while 1.0 - cast[[Float]](base - 1) * inv_base_m < 1.0 {
        n = n + 1;
        inv_base_m = inv_base_m * inv_base;
    }
    return n;
}

// pbrt: ComputeRadicalInversePermutations, and DigitPermutation's constructor
// inside it. Called once, by the driver, with the storage the table lives in.
//
// Two functions rather than one because the driver has to size the allocation
// before it can be filled, and the size is a sum over the bases of a loop that
// only the definition above knows how to run. `digit_permutation_extent` fills
// the offsets and returns the total; `build_digit_permutations` fills the
// table. Neither is on any hot path -- they run before the render does.
//
// Written here rather than in the driver because the driver would then hold a
// second implementation of `permutation_element` and of pbrt's hash, and two
// implementations of a thing this app checks against pbrt is exactly one more
// than it can afford.
func [[export]] digit_permutation_extent(offsets : mut array[i32]) -> i32 {
    total : mut i32 = 0;
    for i in 0:prime_table_size() {
        base = primes[i];
        offsets[i] = total;
        total = total + digit_permutation_digits(base) * base;
    }
    return total;
}

func [[export]] build_digit_permutations(seed : i32, offsets : array[i32],
                                         table : mut array[u16]) -> void {
    parfor i in 0:prime_table_size() {
        base = primes[i];
        n = digit_permutation_digits(base);
        for digit_index in 0:n {
            // pbrt: Hash(base, digitIndex, seed), truncated to the low word
            // where PermutationElement takes it.
            dseed = hash3(base, digit_index, seed);
            for digit_value in 0:base {
                table[offsets[i] + digit_index * base + digit_value] =
                    cast[[u16]](permutation_element(cast[[u32]](digit_value),
                                                    cast[[u32]](base),
                                                    cast[[u32]](dseed)));
            }
        }
    }
}

// pbrt: DigitPermutation::Permute, which is a load and an index.
func permuted_digit(base_index : i32, base : i32, digit_index : i32,
                    digit_value : i32) -> i32 {
    return cast[[i32]](
        digit_permutations[digit_permutation_offsets[base_index] +
                           digit_index * base + digit_value]);
}

// pbrt: ScrambledRadicalInverse, the default randomization.
//
// The plain radical inverse of a low index has a great many leading zero
// digits, so the first samples of every dimension are clustered near zero and
// high dimensions correlate visibly. Permuting the digit values breaks that
// without disturbing the even filling, because a permutation is a bijection on
// each digit.
//
// The loop runs while a digit can still change the answer -- the condition
// pbrt's DigitPermutation uses to decide how many digits to tabulate, so the
// digit indices here line up with the ones it stored.
func scrambled_radical_inverse(base_index : i32, a : u64) -> Float {
    base = primes[base_index];
    b : u64 = cast[[u64]](base);
    limit = 0xffffffffffffffff / b - b;
    inv_base = 1.0 / cast[[Float]](base);
    inv_base_m : mut Float = 1.0;
    reversed : mut u64 = 0u;
    digit_index : mut i32 = 0;
    v : mut u64 = a;
    while (1.0 - cast[[Float]](base - 1) * inv_base_m < 1.0) &&
          (reversed < limit) {
        next = v / b;
        digit_value = cast[[i32]](v - next * b);
        permuted = permuted_digit(base_index, base, digit_index, digit_value);
        reversed = reversed * b + cast[[u64]](permuted);
        inv_base_m = inv_base_m * inv_base;
        digit_index = digit_index + 1;
        v = next;
    }
    return min(inv_base_m * cast[[Float]](reversed), one_minus_epsilon());
}

// pbrt: OwenScrambledRadicalInverse.
//
// A stronger randomization than permuting digits: the permutation applied to a
// digit depends on every digit above it, so two indices that agree in their
// leading digits are scrambled together and two that diverge are scrambled
// independently. That is what makes it a nested -- Owen -- scramble, and it is
// why the hash is folded with `reversed` rather than with the digit index.
func owen_scrambled_radical_inverse(base_index : i32, a : u64,
                                    hash : u32) -> Float {
    base = primes[base_index];
    b : u64 = cast[[u64]](base);
    limit = 0xffffffffffffffff / b - b;
    inv_base = 1.0 / cast[[Float]](base);
    inv_base_m : mut Float = 1.0;
    reversed : mut u64 = 0u;
    v : mut u64 = a;
    while (1.0 - inv_base_m < 1.0) && (reversed < limit) {
        next = v / b;
        digit_value = cast[[i32]](v - next * b);
        digit_hash = cast[[u32]](mix_bits(cast[[u64]](hash) ^ reversed));
        permuted = permutation_element(cast[[u32]](digit_value),
                                       cast[[u32]](base), digit_hash);
        reversed = reversed * b + cast[[u64]](permuted);
        inv_base_m = inv_base_m * inv_base;
        v = next;
    }
    return min(inv_base_m * cast[[Float]](reversed), one_minus_epsilon());
}

// Which sampler a scene asked for.
//
// pbrt dispatches this through a TaggedPointer over its sampler types; a
// variant says the same thing. Both carry the sample count and the seed,
// because every sampler needs them and the renderer should not have to ask
// which kind it has to find out.
//
// Halton is the one every scene in the wild actually asks for, and it is not a
// stream of uniforms at all: it is a deterministic low-discrepancy sequence,
// randomized by permuting the digits of its radical inverses. Sobol and zsobol
// remain unimplemented, and a scene asking for one is refused rather than given
// something that would look reasonable and not be pbrt's.
//
// Halton's arm carries more than the others because pbrt's HaltonSampler does:
// its constructor derives, from the film resolution, how the first two
// dimensions tile the image, and those derived numbers are what StartPixelSample
// needs. The driver computes them exactly where pbrt's constructor does.
element Sampler =
    | Independent(spp : u32, seed : i32)
    | Stratified(x_samples : u32, y_samples : u32, seed : i32, jitter : bool)
    | Halton(spp : u32, seed : i32, randomize : i32,
             base_scale_x : i32, base_scale_y : i32,
             base_exp_x : i32, base_exp_y : i32,
             mult_inv_x : i32, mult_inv_y : i32);

// pbrt: RandomizeStrategy. `permutedigits` is the default a scene gets when it
// says nothing, which is every scene that says nothing.
func randomize_none() -> i32 = 0;
func randomize_permute_digits() -> i32 = 1;
func randomize_owen() -> i32 = 2;

func samples_per_pixel(s : Sampler) -> u32 {
    match s {
        Independent(spp, seed) => return spp;
        Stratified(x_samples, y_samples, seed, jitter) =>
            return x_samples * y_samples;
        Halton(spp, seed, randomize, bsx, bsy, bex, bey, mix, miy) =>
            return spp;
    }
}

func sampler_seed(s : Sampler) -> i32 {
    match s {
        Independent(spp, seed) => return seed;
        Stratified(x_samples, y_samples, seed, jitter) => return seed;
        Halton(spp, seed, randomize, bsx, bsy, bex, bey, mix, miy) =>
            return seed;
    }
}

// What a sampler is part way through.
//
// pbrt's samplers are objects, and these are their members: the generator, the
// pixel and sample they were started on, and how many values have been drawn.
// The stratified sampler needs all of them -- which stratum a draw takes is a
// function of the pixel, the sample and the dimension -- and the independent
// one needs only the generator, but they answer the same questions and so carry
// the same thing.
//
// Separate from the Sampler above, which is what the scene asked for and does
// not change. This is what changes, and it is per pixel and per sample: nothing
// here is shared between two samples, which is what lets the sample loop run in
// whatever order the schedule likes.
element SamplerState {
    rng : RNG;
    // The pixel and sample this was started on, which the stratified sampler
    // hashes and the independent one does not look at again.
    px, py : i32;
    sample : u32;
    // How many values have been drawn. pbrt counts these because a stratified
    // draw has to be stratified independently in each dimension, and because a
    // Halton draw takes its base from the dimension; the independent sampler
    // ignores it.
    dimension : i32;
    // Where in the Halton sequence this pixel and sample sit. Unused by the
    // other two, which have a generator instead -- pbrt keeps this on the
    // HaltonSampler and the generator on the other two, and one state carrying
    // both is what a variant comes to.
    halton_index : i64;
}

// pbrt: MaxHaltonResolution. Above this the first two dimensions stop tiling
// the image one sample per pixel and start repeating, which pbrt accepts
// rather than growing the scales without bound.
func max_halton_resolution() -> i32 = 128;

// What Independent and Stratified both start with: a generator seeded from the
// pixel and jumped ahead to this sample. The two differ in what they do with
// the stream, not in how they seed it.
func seeded_state(x : i32, y : i32, sample : u32, seed : i32) -> SamplerState {
    seq = hash3(x, y, seed);
    r : mut RNG = set_sequence(seq, mix_bits(seq));
    // pbrt: Advance(sampleIndex * 65536 + dimension), at dimension zero.
    advance(r, cast[[u64]](sample) * 65536u);
    zero : i64 = 0;
    st : SamplerState = {r, x, y, sample, 0, zero};
    return st;
}

// pbrt: StartPixelSample, at dimension zero.
//
// Every sampler here starts afresh per sample rather than running one stream
// down the image, which is what makes a sample's draws depend on nothing but
// its own pixel and index -- so the sample loop may be run in any order and
// still produce pbrt's numbers.
//
// Independent and Stratified seed a generator identically. Halton has no
// generator: it computes where in one global sequence this pixel's samples
// begin, which is the point of it -- the sequence is shared across the whole
// image and each pixel takes the entries that land inside it.
func start_pixel_sample(s : Sampler, x : i32, y : i32,
                        sample : u32) -> SamplerState {
    match s {
        Halton(spp, seed, randomize, bsx, bsy, bex, bey, mix, miy) => {
            zero : u64 = 0u;
            r : RNG = {zero, zero};
            stride = bsx * bsy;
            index : mut i64 = 0;
            if stride > 1 {
                // Which sample of the sequence lands on this pixel: the pixel's
                // coordinates are the leading digits of the first two radical
                // inverses, so inverting those gives the offset, and the
                // Chinese remainder theorem -- the multiplicative inverses --
                // combines the two into one index.
                //
                // pbrt's Mod handles a negative left operand; a pixel
                // coordinate is never negative, so this is a plain remainder.
                pmx = x % max_halton_resolution();
                pmy = y % max_halton_resolution();
                d0 = inverse_radical_inverse(cast[[u64]](pmx), 2, bex);
                d1 = inverse_radical_inverse(cast[[u64]](pmy), 3, bey);
                index = cast[[i64]](d0) * cast[[i64]]((stride / bsx) * mix) +
                        cast[[i64]](d1) * cast[[i64]]((stride / bsy) * miy);
                index = index % cast[[i64]](stride);
            }
            index = index + cast[[i64]](sample) * cast[[i64]](stride);
            // Dimensions zero and one are spent on the pixel, so a draw starts
            // at two.
            st : SamplerState = {r, x, y, sample, 2, index};
            return st;
        }
        Independent(spp, seed) => return seeded_state(x, y, sample, seed);
        Stratified(x_samples, y_samples, seed, jitter) =>
            return seeded_state(x, y, sample, seed);
    }
}

// pbrt: HaltonSampler::SampleDimension, which of the three randomizations the
// scene asked for. `permutedigits` is the default and so the usual answer.
//
// Takes what it needs rather than the Sampler, because it is only ever reached
// from a Halton arm that has already unpacked it: matching again would mean
// arms for the other two samplers that cannot happen and have no answer.
// No seed: pbrt's `permutedigits` reads a DigitPermutation that its seed went
// into when it was built, and so does this -- the seed is the driver's argument
// to `build_digit_permutations` and is in the table by the time a draw happens.
func halton_dimension(dim : i32, index : i64, randomize : i32) -> Float {
    a = cast[[u64]](index);
    if randomize == randomize_none() {
        return radical_inverse(dim, a);
    }
    if randomize == randomize_owen() {
        // pbrt: MixBits(1 + (dimension << 4)), a hash of the dimension alone,
        // so that each dimension is scrambled independently of the others.
        h = cast[[u32]](mix_bits(cast[[u64]](1 + (dim << 4))));
        return owen_scrambled_radical_inverse(dim, a, h);
    }
    return scrambled_radical_inverse(dim, a);
}

// pbrt: Get1D.
//
// The independent sampler draws the next uniform. The stratified one divides
// the unit interval into one cell per sample, decides which cell this sample
// takes -- by a permutation of the sample indices chosen by the pixel, the
// dimension and the seed, so that the cells are covered exactly once in an
// order that differs everywhere -- and places the sample inside that cell. That
// is the whole of what stratification is, and it is why a stratified render is
// less noisy than an independent one at the same sample count.
func get_1d(s : Sampler, st : mut SamplerState) -> Float {
    match s {
        Independent(spp, seed) => return next_float(st.rng);
        Stratified(x_samples, y_samples, seed, jitter) => {
            spp = x_samples * y_samples;
            hash = hash4(st.px, st.py, st.dimension, seed);
            stratum = permutation_element(st.sample, spp, cast[[u32]](hash));
            st.dimension = st.dimension + 1;
            // A branch rather than a select, because the draw must happen only
            // when it is used: select is a function and would evaluate both
            // arms, and an unjittered stratified sampler takes nothing from its
            // generator at all. Getting that wrong leaves the stream one value
            // ahead of pbrt's from here on.
            delta : mut Float = 0.5;
            if jitter {
                delta = next_float(st.rng);
            }
            return (cast[[Float]](stratum) + delta) / cast[[Float]](spp);
        }
        Halton(spp, seed, randomize, bsx, bsy, bex, bey, mix, miy) => {
            // The dimensions wrap rather than run out: past the prime table
            // there is no base left to use, and pbrt starts again at two.
            if st.dimension >= prime_table_size() {
                st.dimension = 2;
            }
            dim = st.dimension;
            st.dimension = st.dimension + 1;
            return halton_dimension(dim, st.halton_index, randomize);
        }
    }
}

// pbrt: Get2D. The stratified sampler's two dimensions come from one stratum in
// a grid rather than from two independent strata, which is what makes a pair of
// samples cover the square instead of each axis separately.
func get_2d(s : Sampler, st : mut SamplerState) -> vec2f {
    match s {
        Independent(spp, seed) => {
            u = next_float(st.rng);
            v = next_float(st.rng);
            return vec2f{u, v};
        }
        Stratified(x_samples, y_samples, seed, jitter) => {
            spp = x_samples * y_samples;
            hash = hash4(st.px, st.py, st.dimension, seed);
            stratum = permutation_element(st.sample, spp, cast[[u32]](hash));
            st.dimension = st.dimension + 2;
            sx = stratum % x_samples;
            sy = stratum / x_samples;
            // See get_1d: branches rather than selects, so that an unjittered
            // sampler draws nothing.
            dx : mut Float = 0.5;
            dy : mut Float = 0.5;
            if jitter {
                dx = next_float(st.rng);
                dy = next_float(st.rng);
            }
            return vec2f{(cast[[Float]](sx) + dx) / cast[[Float]](x_samples),
                         (cast[[Float]](sy) + dy) / cast[[Float]](y_samples)};
        }
        Halton(spp, seed, randomize, bsx, bsy, bex, bey, mix, miy) => {
            // Two consecutive dimensions, and both have to exist -- hence the
            // wrap testing dimension + 1 rather than dimension.
            if st.dimension + 1 >= prime_table_size() {
                st.dimension = 2;
            }
            dim = st.dimension;
            st.dimension = st.dimension + 2;
            return vec2f{
                halton_dimension(dim, st.halton_index, randomize),
                halton_dimension(dim + 1, st.halton_index, randomize)};
        }
    }
}

// pbrt: GetPixel2D.
//
// Its own function because a low-discrepancy sampler answers it differently
// from Get2D, and Halton is the reason: dimensions zero and one of the sequence
// are what placed this sample in this pixel in the first place, so the position
// within the pixel is the part of them the pixel's own coordinates did not use.
// Dividing the index by the scales strips the leading digits that chose the
// pixel and leaves the rest -- and it is unscrambled, because a permutation of
// those digits would move the sample into a different pixel.
//
// For the other two the pixel sample is nothing special and this is Get2D.
func get_pixel_2d(s : Sampler, st : mut SamplerState) -> vec2f {
    match s {
        Halton(spp, seed, randomize, bsx, bsy, bex, bey, mix, miy) => {
            a = cast[[u64]](st.halton_index);
            return vec2f{radical_inverse(0, a >> cast[[u64]](bex)),
                         radical_inverse(1, a / cast[[u64]](bsy))};
        }
        Independent(spp, seed) => return get_2d(s, st);
        Stratified(x_samples, y_samples, seed, jitter) => return get_2d(s, st);
    }
}
