schedule {
    tree[[Triangle]] BVH(low high : f32x3) with AABB(low, high)
    = Interior(left : BVH, right : BVH)
    | Leaf(nprims: u32, data : array[Triangle, nprims]);

    triangles1 : BVH;
    triangles2 : BVH;
    
    layout triangles1(index1: u32) {
        primitive_count : u32;
        primitives : array[Triangle, primitive_count];
        node_count : u32;
        group nodes1[size=node_count] by index1 {
            /// An index for first child node or primitive
            /// If the value is positive, it is the index of the first child bv node
            /// If the value is negative, it is -(primitive index + 1)
            first_child : u32;
            /// The start id the primitive belonging to the current node. 
            /// The index is referred to the primitive_indices in BVHModel and from
            /// that we can obtain the primitive's index in original data indirectly.
            first_primitive : u32;
            
            /// The number of primitives belonging to the current node 
            nprims : u32;
            
            /// bounding volume storing the geometry
            low : f32x3;
            high : f32x3;
            
            split first_child[30:31]  {
                3 -> Interior { 
                    left = index1 + 1; 
                    right = index1 + (first_child & 1073741823u);
                };
                _ -> Leaf { 
                    data = primitives[first_child : first_child + nprims];
                };
            };
        };
    };

    build triangles1 {
      build Interior(low: f32x3, high: f32x3, left: BVH, right: BVH) {
        build low;
        build high;
        build nprims = 0;
        recurse left;
        recurse right;
        build first_child = (right - this) | (3u << 30);
        return this;
      };
      build Leaf(low: f32x3, high: f32x3, nprims: u32, data: array[Triangle, nprims]) {
        build low; 
        build high;
        build first_primitive = 0;
        build nprims;
        build first_child = append(data, nprims);
        return this;
      };
    };

    layout triangles2(index2: u32) {
        primitive_count : u32;
        primitives : array[Triangle, primitive_count];
        node_count : u32;
        group nodes2[size=node_count] by index2 {
            /// An index for first child node or primitive
            /// If the value is positive, it is the index of the first child bv node
            /// If the value is negative, it is -(primitive index + 1)
            first_child : u32;
            /// The start id the primitive belonging to the current node. 
            /// The index is referred to the primitive_indices in BVHModel and from
            /// that we can obtain the primitive's index in original data indirectly.
            first_primitive : u32;
            
            /// The number of primitives belonging to the current node 
            nprims : u32;
            
            /// bounding volume storing the geometry
            low : f32x3;
            high : f32x3;
            
            split first_child[30:31]  {
                3 -> Interior { 
                    left = index2 + 1; 
                    right = index2 + (first_child & 1073741823u);
                };
                _ -> Leaf { 
                    data = primitives[first_child : first_child + nprims];
                };
            };
        };
    };

    build triangles2 {
      build Interior(low: f32x3, high: f32x3, left: BVH, right: BVH) {
        build low;
        build high;
        build nprims = 0;
        recurse left;
        recurse right;
        // 2147483648 = 0b1000'0000'0000'0000
        build first_child = (right - this) | (3u << 30);
        return this;
      };
      build Leaf(low: f32x3, high: f32x3, nprims: u32, data: array[Triangle, nprims]) {
        build low; 
        build high;
        build first_primitive = 0;
        build nprims;
        build first_child = append(data, nprims);
        return this;
      };
    };
}