schedule {
    tree[[Triangle]] BVH(low high : f32x3) with AABB(low, high)
    = Interior(left : BVH, right : BVH)
    | Leaf(nprims: u16, data : array[Triangle, nprims]);

    triangles1 : BVH;
    triangles2 : BVH;
    // TODO(cgyurgyik): We should be able to uniquely identify layout members from the layout name already.
    layout triangles1(root1: ptr[nodes1]) {
        primitive_count : u32;
        primitives : array[Triangle, primitive_count];
        node_count : u32;
        
        ptr nodes1 {
            low : f32x3;
            high : f32x3;
            nprims : u16;
            axis : u8;
            8;
            split nprims {
                0 -> Interior { 
                    left: ptr[nodes1];
                    right: ptr[nodes1];
                };
                _ -> Leaf { 
                    poffset : u32; 
                    data = primitives[poffset : poffset + nprims]; 
                };
            };
        };
    };

    build triangles1 {
      build Interior(low: f32x3, high: f32x3, axis: u8, left: BVH, right: BVH) {
        build low;
        build high;
        build nprims = 0;
        build axis = argmax(high - low);
        recurse left;
        recurse right;
        return this;
      };
      build Leaf(low: f32x3, high: f32x3, nprims: u16, data: array[Triangle, nprims]) {
        build low; 
        build high;
        build nprims;
        build axis = argmax(high - low);
        build poffset = append(data, nprims);
        return this;
      };
    };
    
    layout triangles2(root2: ptr[nodes2]) {
        primitive_count : u32;
        primitives : array[Triangle, primitive_count];
        node_count : u32;
        ptr nodes2 {
            low : f32x3;
            high : f32x3;
            nprims : u16;
            axis : u8;
            8;
            split nprims {
                0 -> Interior { 
                    left: ptr[nodes2];
                    right: ptr[nodes2];
                };
                _ -> Leaf { 
                    poffset : u32; 
                    data = primitives[poffset : poffset + nprims]; 
                };
            };
        };
    };

    build triangles2 {
      build Interior(low: f32x3, high: f32x3, axis: u8, left: BVH, right: BVH) {
        build low;
        build high;
        build nprims = 0;
        build axis = argmax(high - low);
        recurse left;
        recurse right;
        return this;
      };
      build Leaf(low: f32x3, high: f32x3, nprims: u16, data: array[Triangle, nprims]) {
        build low; 
        build high;
        build nprims;
        build axis = argmax(high - low);
        build poffset = append(data, nprims);
        return this;
      };
    };
}