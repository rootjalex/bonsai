element Point {
    x, y : f32;
}

extern input0 : set[Point];
extern input1 : set[Point];
extern tree0 : set[Point];
extern tree1 : set[Point];

func [[export]] chebyshev(value : f32) = filter(|a : Point, b : Point| max(abs(a.x - b.x), abs(a.y - a.y)) < value, product(input0, input1));

func [[export]] chebyshev_dual(value : f32) = filter(|a : Point, b : Point| max(abs(a.x - b.x), abs(a.y - a.y)) < value, product(tree0, tree1));

func lookup_chebyshev(value : f32, a : Point) = filter(|b : Point| max(abs(a.x - b.x), abs(a.y - a.y)) < value, tree1);

func [[export]] chebyshev_single(value : f32) = map(|a : Point| (a, lookup_chebyshev(value, a)), input0);


func [[export]] euclidean(radius : f32) = filter(|a : Point, b : Point| sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) < radius, product(input0, input1));

func [[export]] euclidean_dual(radius : f32) = filter(|a : Point, b : Point| sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) < radius, product(tree0, tree1));

func lookup_euclidean(radius : f32, a : Point) = filter(|b : Point| sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) < radius, tree1);

func [[export]] euclidean_single(radius : f32) = map(|a : Point| (a, lookup_euclidean(radius, a)), input0);


// TODO: allow lets in lambdas (need to update predicate analysis though?)
func [[export]] donut(rmin : f32, rmax : f32) = filter(|a : Point, b : Point| {
    sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) >= rmin && sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) <= rmax
}, product(input0, input1));

func [[export]] donut_dual(rmin : f32, rmax : f32) = filter(|a : Point, b : Point| {
    sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) >= rmin && sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) <= rmax
}, product(tree0, tree1));

func lookup_donut(rmin : f32, rmax : f32, a : Point) = filter(|b : Point| {
    sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) >= rmin && sqrt(sqr(a.x - b.x) + sqr(a.y - b.y)) <= rmax
}, tree1);

func [[export]] donut_single(rmin : f32, rmax : f32) = map(|a : Point| (a, lookup_donut(rmin, rmax, a)), input0);


func [[export]] manhattan(value : f32) = filter(|a : Point, b : Point| abs(a.x - b.x) + abs(a.y - b.y) < value, product(input0, input1));

func [[export]] manhattan_dual(value : f32) = filter(|a : Point, b : Point| abs(a.x - b.x) + abs(a.y - b.y) < value, product(tree0, tree1));

func lookup_manhattan(value : f32, a : Point) = filter(|b : Point| abs(a.x - b.x) + abs(a.y - b.y) < value, tree1);

func [[export]] manhattan_single(value : f32) = map(|a : Point| (a, lookup_manhattan(value, a)), input0);


func [[export]] cosine(value : f32) = filter(|a : Point, b : Point| {
    a.x*b.x + a.y*b.y / (sqrt(sqr(a.x) + sqr(a.y)) * sqrt(sqr(b.x) + sqr(b.y))) > value
}, product(input0, input1));

func [[export]] cosine_dual(value : f32) = filter(|a : Point, b : Point| {
    a.x*b.x + a.y*b.y / (sqrt(sqr(a.x) + sqr(a.y)) * sqrt(sqr(b.x) + sqr(b.y))) > value
}, product(tree0, tree1));

func lookup_cosine(value : f32, a : Point) = filter(|b : Point| {
    a.x*b.x + a.y*b.y / (sqrt(sqr(a.x) + sqr(a.y)) * sqrt(sqr(b.x) + sqr(b.y))) > value
}, tree1);

func [[export]] cosine_single(value : f32) = map(|a : Point| (a, lookup_cosine(value, a)), input0);


schedule {
    tree[[Point]] AABBTree(xl xh yl yh : f32) with x in [xl, xh] with y in [yl, yh] =
    | Interior(left : AABBTree, right : AABBTree)
    | Leaf(d : array[Point]) with data = d;

    tree0 : AABBTree;
    tree1 : AABBTree;

    layout tree0 {
        pCount : u64;
        prims : array[Point, pCount];
        nCount : u64;
        group[nCount] index : u64 {
            xl : f32;
            xh : f32;
            yl : f32;
            yh : f32;
            nPrims : u8;
            switch nPrims {
                0 => Interior { offset : u56; left = index + 1; right = index + cast[[u64]](offset); };
                 _ => Leaf { pOffset : u56; d = range(prims, cast[[u64]](pOffset), cast[[u64]](nPrims)); };
            };
        };
    };

    layout tree1 {
        pCount : u64;
        prims : array[Point, pCount];
        nCount : u64;
        group[nCount] index : u64 {
            xl : f32;
            xh : f32;
            yl : f32;
            yh : f32;
            nPrims : u8;
            switch nPrims {
                0 => Interior { offset : u56; left = index + 1; right = index + cast[[u64]](offset); };
                 _ => Leaf { pOffset : u56; d = range(prims, cast[[u64]](pOffset), cast[[u64]](nPrims)); };
            };
        };
    };
}
