element u64x8 = vector[u64, 8];
element u8x3x8 = vector[u8x3, 8];
element u8x8 = vector[u8, 8];

element OBB { 
  // TODO(cgyurgyik): we shouldn't need {obb,aabb}_low.
  // This is an artifact of our path-finding algorithm that assumes paths 
  // are unique only to identifiers. In reality, it should take into 
  // account the variant as well.
  obb_low: f32x3; 
  obb_high: f32x3; 

  // m00 m01 m02 tx
  // m10 m11 m12 ty
  // m20 m21 m22 tz
  // 
  // m00, ..., m22 describe the rotation / scale.
  // tx, ty, tz    describe the translation.
  orientation: f32x4x3; 
}

func intersectsp_ray_obb(r: Ray, b: OBB) -> option[FInterval] {
    // Transform the ray into the OBB's local space.
    ox = b.orientation[0][0] * r.o.x + b.orientation[0][1] * r.o.y + b.orientation[0][2] * r.o.z + b.orientation[0][3];
    oy = b.orientation[1][0] * r.o.x + b.orientation[1][1] * r.o.y + b.orientation[1][2] * r.o.z + b.orientation[1][3];
    oz = b.orientation[2][0] * r.o.x + b.orientation[2][1] * r.o.y + b.orientation[2][2] * r.o.z + b.orientation[2][3];

    dx = b.orientation[0][0] * r.d.x + b.orientation[0][1] * r.d.y + b.orientation[0][2] * r.d.z;
    dy = b.orientation[1][0] * r.d.x + b.orientation[1][1] * r.d.y + b.orientation[1][2] * r.d.z;
    dz = b.orientation[2][0] * r.d.x + b.orientation[2][1] * r.d.y + b.orientation[2][2] * r.d.z;

    inv_dx: f32 = 1.0 / dx;
    inv_dy: f32 = 1.0 / dy;
    inv_dz: f32 = 1.0 / dz;

    t0x = (b.obb_low.x - ox) * inv_dx;
    t1x = (b.obb_high.x - ox) * inv_dx;
    tmin_x = min(t0x, t1x);
    tmax_x = max(t0x, t1x);

    t0y = (b.obb_low.y - oy) * inv_dy;
    t1y = (b.obb_high.y - oy) * inv_dy;
    tmin_y = min(t0y, t1y);
    tmax_y = max(t0y, t1y);

    t0z = (b.obb_low.z - oz) * inv_dz;
    t1z = (b.obb_high.z - oz) * inv_dz;
    tmin_z = min(t0z, t1z);
    tmax_z = max(t0z, t1z);

    tmin: f32 = max(max(tmin_x, tmin_y), tmin_z);
    tmax: f32 = min(min(tmax_x, tmax_y), tmax_z);

    if tmin > tmax { return {}; } 
    if tmax < 0.0 { return {}; }
    
    return FInterval{max(tmin, 0.0), tmax};
}

func intersects_Ray_OBB(r: Ray, b: OBB) -> bool {
    interval = intersectsp_ray_obb(r, b);
    if interval {
        extract = *interval;
        return extract.low < r.tmax & extract.high > 0.0;
    }
    return false;
}

func distmin_Ray_OBB(r : Ray, b : OBB) -> f32 {
    interval: option[FInterval] = intersectsp_ray_obb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return -inf;
}

func to_i8(f: f32) -> i8 {
  f1 : f32 = roundf(f);
  f2: f32 = max(-128.0, min(f1, 127.0));
  return cast[[i8]](f2);
}

func quantize_orientation(x: f32x4x3) -> i8x4x3 {
  return i8x4x3 {
    i8x4 {
      to_i8(x[0][0] * 127.0),
      to_i8(x[0][1] * 127.0),
      to_i8(x[0][2] * 127.0),
      to_i8(x[0][3] * 127.0)
    },
    i8x4 {
      to_i8(x[1][0] * 127.0),
      to_i8(x[1][1] * 127.0),
      to_i8(x[1][2] * 127.0),
      to_i8(x[1][3] * 127.0)
    },
    i8x4 {
      to_i8(x[2][0] * 127.0),
      to_i8(x[2][1] * 127.0),
      to_i8(x[2][2] * 127.0),
      to_i8(x[2][3] * 127.0)
    }
  };
}

func compute_merged_low(low: f32x3x8) -> f32x3 {
  return min(low[0], min(low[1], min(low[2], min(low[3], min(low[4], min(low[5], min(low[6], low[7])))))));
}

func compute_merged_extent(lo: f32x3x8, hi: f32x3x8) -> f32x3 {
  mlo: f32x3 = min(lo[0], min(lo[1], min(lo[2], min(lo[3], min(lo[4], min(lo[5], min(lo[6], lo[7])))))));
  mhi: f32x3 = max(hi[0], max(hi[1], max(hi[2], max(hi[3], max(hi[4], max(hi[5], max(hi[6], hi[7])))))));
  return mhi - mlo;
}

func to_u8_floor(f: f32x3) -> u8x3 {
    f1: f32x3 = floorf(f);
    f2: f32x3 = max(0.0, min(f1, 255.0));
    return cast[[u8x3]](f2);
}

func to_u8_ceil(f: f32x3) -> u8x3 {
    f1: f32x3 = ceilf(f);
    f2: f32x3 = max(0.0, min(f1, 255.0));
    return cast[[u8x3]](f2);
}

func quantize_bounds_low(low: f32x3x8, high: f32x3x8) -> u8x3x8 {
  mlo: f32x3 = compute_merged_low(low);
  mex: f32x3 = compute_merged_extent(low, high);
  rcp: f32x3 = (1.0 / mex) * 255.0;
  return u8x3x8 {
    to_u8_floor((low[0] - mlo) * rcp),
    to_u8_floor((low[1] - mlo) * rcp),
    to_u8_floor((low[2] - mlo) * rcp),
    to_u8_floor((low[3] - mlo) * rcp),
    to_u8_floor((low[4] - mlo) * rcp),
    to_u8_floor((low[5] - mlo) * rcp),
    to_u8_floor((low[6] - mlo) * rcp),
    to_u8_floor((low[7] - mlo) * rcp)
  };
}

func quantize_bounds_high(low: f32x3x8, high: f32x3x8) -> u8x3x8 {
  mlo: f32x3 = compute_merged_low(low);
  mex: f32x3 = compute_merged_extent(low, high);
  rcp: f32x3 = (1.0 / mex) * 255.0;
  return u8x3x8 {
    to_u8_ceil((high[0] - mlo) * rcp),
    to_u8_ceil((high[1] - mlo) * rcp),
    to_u8_ceil((high[2] - mlo) * rcp),
    to_u8_ceil((high[3] - mlo) * rcp),
    to_u8_ceil((high[4] - mlo) * rcp),
    to_u8_ceil((high[5] - mlo) * rcp),
    to_u8_ceil((high[6] - mlo) * rcp),
    to_u8_ceil((high[7] - mlo) * rcp)
  };
}

func dequantize_orientation(x: i8x4x3) -> f32x4x3 {
    return f32x4x3 {
        f32x4 {
            cast[[f32]](x[0][0]) / 127.0,
            cast[[f32]](x[0][1]) / 127.0,
            cast[[f32]](x[0][2]) / 127.0,
            cast[[f32]](x[0][3]) / 127.0
        },
        f32x4 {
          cast[[f32]](x[1][0]) / 127.0,
            cast[[f32]](x[1][1]) / 127.0,
            cast[[f32]](x[1][2]) / 127.0,
            cast[[f32]](x[1][3]) / 127.0
        },
        f32x4 {
            cast[[f32]](x[2][0]) / 127.0,
            cast[[f32]](x[2][1]) / 127.0,
            cast[[f32]](x[2][2]) / 127.0,
            cast[[f32]](x[2][3]) / 127.0
        }
    };
}

func dequantize_bounds(mlo: f32x3, mex: f32x3, q: u8x3x8) -> f32x3x8 {
  rcp: f32 = 1 / 255.0;
  return f32x3x8 { 
    mlo + (cast[[f32x3]](q[0]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[1]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[2]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[3]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[4]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[5]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[6]) * rcp) * mex,
    mlo + (cast[[f32x3]](q[7]) * rcp) * mex

  };
}

schedule {
    tree[[Triangle]] BVH
      = AABBNode(aabb_children: array[BVH, 8], aabb_low: f32x3x8, aabb_high: f32x3x8) with AABB(aabb_low, aabb_high) on aabb_children
      | OBBNode(obb_children: array[BVH, 8], orientation: f32x4x3, obb_low: f32x3x8, obb_high: f32x3x8) with OBB(obb_low, obb_high, orientation) on obb_children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(index: u64 = 1u) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        aabb_count: u64;
        indirect group Aabbs[size=aabb_count, align=16] {
            // full bounding box of the parent is stored directly next to
            // quantized children to reduce memory bandwidth requirements.
            aabb_mlo: f32x3;
            aabb_mex: f32x3; // stored as full precision in CLBVH, but not CWBVH.
            aabb_qlo: u8x3x8;
            aabb_qhi: u8x3x8;
            aabb_low = dequantize_bounds(aabb_mlo, aabb_mex, aabb_qlo);
            aabb_high = dequantize_bounds(aabb_mlo, aabb_mex, aabb_qhi);
            aabb_children: u64x8;
        };

        // quantized, per section 3.5
        obb_count: u64;
        indirect group Obbs[size=obb_count, align=16] {
            obb_mlo: f32x3;           // low of the merged OBB.
            obb_mex: f32x3;           // extent of the merged OBB.
            obb_qlo: u8x3x8;          // quantized low offset of each child.
            obb_qhi: u8x3x8;          // quantized high offset of each child.
            qorientation: i8x4x3; // common orientation for all 8 OBB bounds.
            obb_children: u64x8;

            obb_low = dequantize_bounds(obb_mlo, obb_mex, obb_qlo);
            obb_high = dequantize_bounds(obb_mlo, obb_mex, obb_qhi);
            orientation = dequantize_orientation(qorientation);
        };

        group _ by index {
            split index[0:1] {
                0 -> Leaf {
                    nprims = cast[[u8]](index[2:9] + 1);
                    data = primitives[index[10:63] : index[10:63] + nprims];
                };
                1 -> AABBNode from Aabbs[index[2:63]];
                2 -> OBBNode from Obbs[index[2:63]];
            };
        };
    };

    build triangles {
      build AABBNode(aabb_children: array[BVH, 8], aabb_low: f32x3x8, aabb_high: f32x3x8) {
        build aabb_mlo = compute_merged_low(aabb_low);
        build aabb_mex = compute_merged_extent(aabb_low, aabb_high);
        build aabb_qlo = quantize_bounds_low(aabb_low, aabb_high);
        build aabb_qhi = quantize_bounds_high(aabb_low, aabb_high);
        recurse aabb_children;
        return (this << cast[[u64]](2)) | cast[[u64]](1);
      };

      build OBBNode(obb_children: array[BVH, 8], orientation: f32x4x3, obb_low: f32x3x8, obb_high: f32x3x8) {
        build obb_mlo = compute_merged_low(obb_low);
        build obb_mex = compute_merged_extent(obb_low, obb_high);
        build obb_qlo = quantize_bounds_low(obb_low, obb_high);
        build obb_qhi = quantize_bounds_high(obb_low, obb_high);
        build qorientation = quantize_orientation(orientation);
        recurse obb_children;
        return (this << cast[[u64]](2)) | cast[[u64]](2);
      };

      build Leaf(nprims: u8, data: array[Triangle, nprims]) {
        let poffset: u64 = append(data, nprims);
        return (poffset << cast[[u64]](10)) | ((nprims - cast[[u64]](1)) << cast[[u64]](2)) | cast[[u64]](0);
      };
    };
