element qbox3 {
  lo: u8x3;
  hi: u8x3;
}

element qbox3x8 = vector[qbox3, 8];
element u64x8 = vector[u64, 8];

func dequantize_bounds_lo(mlo: f32x3, mex: f32x3, bound: qbox3x8) -> f32x3x8 {
  return f32x3x8 { 
    mlo + (cast[[f32x3]](bound[0].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[1].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[2].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[3].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[4].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[5].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[6].lo) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[7].lo) / 255.0) * mex
  };
}

func dequantize_bounds_hi(mlo: f32x3, mex: f32x3, bound: qbox3x8) -> f32x3x8 {
  return f32x3x8 { 
    mlo + (cast[[f32x3]](bound[0].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[1].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[2].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[3].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[4].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[5].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[6].hi) / 255.0) * mex,
    mlo + (cast[[f32x3]](bound[7].hi) / 255.0) * mex
  };
}

func compute_merged_low(low: f32x3x8) -> f32x3 {
  return min(low[0], min(low[1], min(low[2], min(low[3], min(low[4], min(low[5], min(low[6], low[7])))))));
}

func compute_merged_extent(lo: f32x3x8, hi: f32x3x8) -> f32x3 {
  mlo: f32x3 = min(lo[0], min(lo[1], min(lo[2], min(lo[3], min(lo[4], min(lo[5], min(lo[6], lo[7])))))));
  mhi: f32x3 = max(hi[0], max(hi[1], max(hi[2], max(hi[3], max(hi[4], max(hi[5], max(hi[6], hi[7])))))));
  return mhi - mlo;
}

func to_u8_floor(f: f32x3) -> u8x3 {
    f1: f32x3 = floorf(f);
    f2: f32x3 = max(0.0, min(f1, 255.0));
    return cast[[u8x3]](f2);
}

func to_u8_ceil(f: f32x3) -> u8x3 {
    f1: f32x3 = ceilf(f);
    f2: f32x3 = max(0.0, min(f1, 255.0));
    return cast[[u8x3]](f2);
}

func quantize_bounds(low: f32x3x8, high: f32x3x8) -> qbox3x8 {
  mlo: f32x3 = compute_merged_low(low);
  mex: f32x3 = compute_merged_extent(low, high);
  rcp: f32x3 = (1.0 / mex) * 255.0;
  return qbox3x8 {
    qbox3 {to_u8_floor((low[0] - mlo) * rcp), to_u8_ceil((high[0] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[1] - mlo) * rcp), to_u8_ceil((high[1] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[2] - mlo) * rcp), to_u8_ceil((high[2] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[3] - mlo) * rcp), to_u8_ceil((high[3] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[4] - mlo) * rcp), to_u8_ceil((high[4] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[5] - mlo) * rcp), to_u8_ceil((high[5] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[6] - mlo) * rcp), to_u8_ceil((high[6] - mlo) * rcp) },
    qbox3 {to_u8_floor((low[7] - mlo) * rcp), to_u8_ceil((high[7] - mlo) * rcp) }
  };
}

schedule {
    tree[[Triangle]] BVH 
      = Interior(children: array[BVH, 8], lo: f32x3x8, hi: f32x3x8) with AABB(lo, hi) on children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(I: u64) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        indirect group Interiors {
            // full bounding box of the parent is stored directly next to
            // quantized children to reduce memory bandwidth requirements.
            mlo: f32x3;
            mex: f32x3; // stored as full precision in CLBVH, but not CWBVH.
            child_bounds: qbox3x8;
            children: u64x8;
            lo = dequantize_bounds_lo(mlo, mex, child_bounds);
            hi = dequantize_bounds_hi(mlo, mex, child_bounds);
        };

        group _ by I {
            split I[0:2] {
                2 -> Interior from Interiors[I[4:63]];
                _ -> Leaf { nprims = cast[[u8]](I[1:4] + 1); data = primitives[I[4:63] : I[4:63] + nprims]; };
            };
        };
    };

    build triangles {
      build Interior(children: array[BVH, 8], lo: f32x3x8, hi: f32x3x8) {
        build mlo = compute_merged_low(lo);
        build mex = compute_merged_extent(lo, hi);
        build child_bounds = quantize_bounds(lo, hi);
        recurse children;
        return (this << cast[[u64]](4)) | cast[[u64]](2);
      };

      build Leaf(nprims: u8, data: array[Triangle, nprims]) {
        let poffset: u64 = append(data, nprims);
        return (poffset << cast[[u64]](4)) | (nprims << cast[[u64]](2));
      };
    };
}
