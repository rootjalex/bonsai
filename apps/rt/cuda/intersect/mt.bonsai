import stdlib/numerics;

element TriangleIntersection {
    b0, b1, b2, t : Float;
}

element Triangle {
    p0, p1, p2 : vec3f;
}

element AABB {
    low, high : vec3f;
}

element Ray {
    o : vec3f;
    d : vec3f;
    tmax : Float = inf;
}

element FInterval {
    low, high : Float;
}

// Möller-Trumbore ray-triangle intersection (the Embree variant)
// https://github.com/RenderKit/embree/blob/e9b8633e1d271aaf084b7befb925bf878e306c54/kernels/geometry/triangle_intersector_moeller.h
func intersectsp_ray_tri(ray : Ray, tri : Triangle) -> option[TriangleIntersection] {
    e1: f32x3 = tri.p0 - tri.p1;
    e2: f32x3 = tri.p2 - tri.p0;
    
    tri_Ng: f32x3 = cross_(e2, e1);
    
    C: f32x3 = tri.p0 - ray.o;
    R: f32x3 = cross_(C, ray.d);
    
    den: f32 = dot(tri_Ng, ray.d);
    
    if den == 0.0 { return {}; }
    
    absDen: f32 = abs(den);
    sgnDen: u32 = bitcast[[u32]](den) & 2147483648u;
    
    U: f32 = bitcast[[f32]](bitcast[[u32]](dot(R, e2)) ^ sgnDen);
    V: f32 = bitcast[[f32]](bitcast[[u32]](dot(R, e1)) ^ sgnDen);
    
    if !(U >= 0.0 && V >= 0.0 && U + V <= absDen) { return {}; }
    
    T: f32 = bitcast[[f32]](bitcast[[u32]](dot(tri_Ng, C)) ^ sgnDen);
    
    if !(absDen * 0.0 < T && T <= absDen * ray.tmax) { return {}; }
    
    invAbsDen: f32 = 1.0 / absDen;
    t: f32 = T * invAbsDen;
    u: f32 = U * invAbsDen;
    v: f32 = V * invAbsDen;
    
    b0: f32 = 1.0 - u - v;
    b1: f32 = u;
    b2: f32 = v;
    
    return TriangleIntersection{b0, b1, b2, t};
}

func intersects(ray : Ray, tri : Triangle) -> bool {
    return cast[[bool]](intersectsp_ray_tri(ray, tri));
}