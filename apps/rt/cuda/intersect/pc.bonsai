import stdlib/numerics;

element TriangleIntersection {
    b0, b1, b2, t : Float;
}

element Triangle {
    p0, p1, p2 : vec3f;
}

element AABB {
    low, high : vec3f;
}

element Ray {
    o : vec3f;
    d : vec3f;
    tmax : Float = inf;
}

element FInterval {
    low, high : Float;
}

// Embree variant of Pluecker coordinates
// https://github.com/RenderKit/embree/blob/e9b8633e1d271aaf084b7befb925bf878e306c54/kernels/geometry/triangle_intersector_pluecker.h
func intersectsp_ray_tri(ray : Ray, tri : Triangle) -> option[TriangleIntersection] {
    v0: f32x3 = tri.p0 - ray.o;
    v1: f32x3 = tri.p1 - ray.o;
    v2: f32x3 = tri.p2 - ray.o;

    e0: f32x3 = v2 - v0;
    e1: f32x3 = v0 - v1;
    e2: f32x3 = v1 - v2;

    U: f32 = dot(cross_(e0, v2 + v0), ray.d);
    V: f32 = dot(cross_(e1, v0 + v1), ray.d);
    W: f32 = dot(cross_(e2, v1 + v2), ray.d);

    UVW: f32 = U + V + W;

    e: f32 = eps[[f32]]() * abs(UVW);

    minUVW: f32 = min(vec3f{U, V, W});
    maxUVW: f32 = max(vec3f{U, V, W});
    
    if !(minUVW >= -e || maxUVW <= e) { return {}; }

    Ng: f32x3 = cross_(e0, e1);
    den: f32 = 2.0 * dot(Ng, ray.d);
    
    T: f32 = 2.0 * dot(v0, Ng);
    t: f32 = T / den;
    
    if !(t >= 0.0 && t <= ray.tmax) { return {}; }
    if den == 0.0 { return {}; }

    invUVW: f32 = 1.0 / UVW;
    b0: f32 = W * invUVW;
    b1: f32 = U * invUVW;
    b2: f32 = V * invUVW;

    if b0 < 0.0 || b1 < 0.0 || b2 < 0.0 { return {}; }

    return TriangleIntersection{b0, b1, b2, t};
}

func intersects(ray : Ray, tri : Triangle) -> bool {
    return cast[[bool]](intersectsp_ray_tri(ray, tri));
}