element u64x8 = vector[u64, 8];

schedule {
    tree[[Triangle]] BVH 
      = Interior(children: array[BVH, 8], lo: f32x3x8, hi: f32x3x8) with AABB(lo, hi) on children
      | Leaf(nprims: u8, data: array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(I: u64 = 1u) {
        primitive_count: u64;
        primitives : array[Triangle, primitive_count];

        interior_count: u64;
        indirect group Interiors[size=interior_count] {
            lo: f32x3x8;
            hi: f32x3x8;
            children: u64x8;
        };

        group _ by I {
            // bits (inclusive)
            //   0-2  : node type [[reserved: 111 for SENTINEL, 000 reserved for LEAF]]
            //   3-6  : primitive count - 1
            //   7-63 : offset
            split I[0:2] {
                1 -> Interior from Interiors[I[7:63]];
                _ -> Leaf { nprims = cast[[u8]](I[3:6] + 1); data = primitives[I[7:63] : I[7:63] + nprims]; };
            };
        };
    };

    build triangles {
      build Interior(children: array[BVH, 8], lo: f32x3x8, hi: f32x3x8) {
        build lo;
        build hi;
        recurse children;
        return (this << cast[[u64]](7)) | cast[[u64]](1);
      };

      build Leaf(nprims: u8, data: array[Triangle, nprims]) {
        let poffset: u64 = append(data, nprims);
        return (poffset << cast[[u64]](7)) | ((nprims - cast[[u64]](1)) << cast[[u64]](3));
      };
    };

    trace.loopify(64);
    chrt.gpu_thread(i0);
}
