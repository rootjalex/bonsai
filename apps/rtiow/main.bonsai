//! flags: -b cpp -o apps/rtiow/main
// clang++ -std=c++20 -O3 main_hook.cpp main.o -o main_runner

func pixel(i : i32, j : i32, c : i32, width : i32, height : i32) {
//    r = cast[[f64]](i) / cast[[f64]](width - 1);
//    g = cast[[f64]](j) / cast[[f64]](height - 1);
//    b = cast[[f64]](0.0);
    if (c == 0) {
        return cast[[i32]](255.999 * (cast[[f64]](i) / cast[[f64]](width - 1)));
    } else if (c == 1) {
        return cast[[i32]](255.999 * (cast[[f64]](j) / cast[[f64]](height - 1)));
    } else {
        return 0;
    }
//    rgb : vector[f64, 3] = {r, g, b};
//    return cast[[vector[i32, 3]]](rgb);
}

func [[export]] image(width : i32, height : i32) = map(|j : i32| map(|i : i32| map(|c : i32| pixel(i, j, c, width, height), iter(3)), iter(width)), iter(height));
