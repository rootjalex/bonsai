// apps/rtq over FCPW's normal cone hierarchy (SNCH): rtq.bonsai's three
// queries over its triangles and the silhouette query over its edges, each
// as a batch -- the program compare.sh compiles for the schedules named
// fcpws* (schedules/fcpws.bonsai over layouts/fcpws.bonsai), against FCPW's
// scalar build with silhouettes computed (Scene::computeSilhouettes, then
// the build, which then makes Bvh<3, SnchNode<3>, Triangle, SilhouetteEdge>:
// each node a box and a normal cone, each leaf its triangles and its
// silhouette edges) and against FCPW's GPU, which traverses the same rows.
// These are the trees the walk on stars of apps/wosx traverses for its ray
// cast and its star radius, isolated.
//
// The silhouette batch is answered with FCPW's record (SilhouetteHit: the
// edge's index, the distance, the closest point on the edge), made once per
// query for the edge the argmin settled on; a miss writes nothing, the
// caller having initialized the records to the miss record (the metric
// file's `no_silhouette`: the index -1, `d` infinite, as FCPW leaves its
// Interaction), rtq.bonsai's contract and the references'.
import apps/rtq/rtq;
import apps/rtq/silhouette;

// The batch as FCPW's records (metrics/fcpw_scalar.bonsai: the query a
// GPUBoundingSphere and WoSX's flip word, its minimum radius and precision
// once for the batch as FCPW's kernel takes them, the answer a
// GPUInteraction), converted at the boundary.
func [[export]] silhouette_all(n : u32, queries : array[SilhouetteQueryRecord, n],
                               min_r2 : Float, precision : Float,
                               hits : mut array[SilhouetteHitRecord, n]) {
    parfor i in 0u:n {
        h = closest_silhouette(query_of(queries[i], min_r2, precision));
        if h {
            found = *h;
            hits[i] = record_of_silhouette(found[1]);
        }
    }
    return;
}
