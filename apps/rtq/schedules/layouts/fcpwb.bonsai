// FCPW's scalar BVH as its CPU reads it: the bytes fcpw::Bvh<3, BvhNode<3>,
// Triangle> traverses, byte for byte, and no others -- the node array
// (flatTree, 32-byte BvhNode rows: the box, the second child's offset or
// the first reference's index, the reference count), the array of
// primitive pointers its leaves index (Bvh::primitives, a Triangle* per
// reference, in the order the build left them), the Triangle objects those
// pointers address (32 bytes: the vtable pointer, the three vertex indices,
// the primitive index, the soup pointer; fcpw/geometry/triangles.h), and
// the polygon soup's positions (12-byte Vector3f) the indices select. The
// driver hands the program FCPW's own memory, wrapped, not a copy
// (apps/rtq/fcpw_bvh.h, built without RTQ_GPU).
//
// A leaf's triangle is read as FCPW's leaf reads it (Triangle::intersect,
// Triangle::findClosestPoint): the pointer out of the reference array, the
// three indices out of the object at that address, the three corners
// gathered from the positions by index (`soup->positions[indices[k]]`),
// and the program's edges made from the corners -- `e1 = pa - pb` is FCPW's
// `ab = pb - pa` negated, to the bit; `e2 = pc - pa` its `ac`. The tile
// stores the pointer and derives everything else, so nothing of a corner is
// copied anywhere: what the leaf loads is what FCPW's leaf loads. The
// derived members chain -- `t = objects[tri]` is the row of the `ptr group`
// at the address, `pa = positions[t.i0].p` a row of the position group by
// the index out of it -- and the compiler binds each read to that group's
// storage (Lower/Layouts.cpp; tests/bonsai/ssa/layout-tile-group-reads.
// bonsai).
//
// fcpwb_gpu.bonsai is the same tree in FCPW's GPU bytes -- GPUTriangle rows,
// the corners stored -- which is what FCPW's GPU reads and so what the GPU
// comparison traverses. Until 2026-10-25 the CPU comparison traversed those
// rows too, an indirection and a gather fewer a triangle than FCPW's CPU
// pays, which favoured every leaf (PLAN.md, "The machine code behind the
// table").
//
// The traversal tests both children's boxes at the parent and enters the
// nearer first (bvh.inl, processSubtreeForClosestPoint, processSubtreeFor
// Intersection): the node bounds its children, and the layout provides the
// children's boxes by reading them out of the children's own rows
// (`this[left].low`), the parent *logically* holding its children's boxes
// while its bytes stay FCPW's -- the device of the PLDI 2026 paper's
// closest-point benchmark (apps/queries/cp/cp.bonsai on the branch
// ajr/pldi-benchmarks), the two-lane vectors built by component. What a
// visit reads is then what FCPW's reads: the node's row and its two
// children's rows.
//
// Imported by the CPU schedules over this tree in apps/rtq (schedules/
// fcpwb.bonsai, the three queries against FCPW's scalar build); the GPU
// schedules import fcpwb_gpu.bonsai.
schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;
    triangles : BVH2;

    layout triangles {
        // FCPW: PolygonSoup::positions, the vertices, 12 bytes each.
        vCount : u32;
        indirect group positions[vCount] {
            p : vec3f;
        };
        // FCPW: the Triangle objects (SceneData::triangleObjects), 32 bytes
        // each, reached by the address a reference holds.
        oCount : u32;
        ptr group objects[oCount] {
            vptr : u64;
            i0 : i32;
            i1 : i32;
            i2 : i32;
            pIndex : i32;
            soup : u64;
        };
        // FCPW: Bvh::primitives, a Triangle* per reference; a leaf's range
        // is over these, and each is the triangle at the address.
        pCount : u32;
        indirect group prims[pCount] {
            group[1] {
                tri : u64;
                t = objects[tri];
                pa = positions[t.i0].p;
                pb = positions[t.i1].p;
                pc = positions[t.i2].p;
                v0 = pa;
                e1 = pa - pb;
                e2 = pc - pa;
                geomID = 0u;
                primID = cast[[u32]](t.pIndex);
            };
        };
        // FCPW: BvhNode<3>.
        nNodes : u32;
        group[nNodes] index : u32 {
            low : vec3f;
            high : vec3f;
            offset : i32;
            nReferences : i32;
            switch nReferences {
                0 => Interior {
                    left = index + 1u;
                    right = index + cast[[u32]](offset);
                    children = vector[u32, 2]{left, right};
                    // The children's boxes, read from the children's rows.
                    lo = vector[vec3f, 2]{vector[f32, 2]{this[left].low.x, this[right].low.x},
                                          vector[f32, 2]{this[left].low.y, this[right].low.y},
                                          vector[f32, 2]{this[left].low.z, this[right].low.z}};
                    hi = vector[vec3f, 2]{vector[f32, 2]{this[left].high.x, this[right].high.x},
                                          vector[f32, 2]{this[left].high.y, this[right].high.y},
                                          vector[f32, 2]{this[left].high.z, this[right].high.z}};
                };
                _ => Leaf {
                    data = range(prims, cast[[u32]](offset), cast[[u32]](nReferences));
                };
            };
        };
    };
}
