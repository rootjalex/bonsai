// Embree's BVH8 over Triangle4 leaves, as a layout: the bytes Embree's
// intersector reads, byte for byte, in Scion's spelling (Gyurgyik, Root and
// Kjolstad, "Decoupling Data Layouts from Bounding Volume Hierarchies", PLDI
// 2026), over the eight-wide tree of trees/bvh8.bonsai -- which FCPW's
// eight-wide layouts (fcpw8w16.bonsai, fcpw8w8.bonsai) share, the tree being
// the same and the bytes another's. Imported by the schedules that follow
// Embree (embree.bonsai, tuned.bonsai); what differs between them is how
// the traversal runs, not what it reads.
//
// The storage. One allocation of bytes, as Embree's allocator hands out one
// address space, holding node rows and leaf blocks wherever their reference
// says. A reference is Embree's NodeRef exactly: an address, with the kind in
// its low four bits -- bit 3 clear an AABB node, whose address the reference
// then is, nothing masked (Embree's `getAABBNode`); bit 3 set a leaf of n
// Triangle4 blocks, n in the three bits below, at the address with the kind
// taken off (`ref[4:63] * 16u`, Embree's `leaf(num)`). The rows are looked up
// in a `ptr group` (ir::Group::Type::Pointer), whose rows are reached by
// address and not by index from a base, so no base is added anywhere, and the
// walk begins at `root`, a field the layout stores: the root's address,
// Embree's `bvh->root`. The allocation itself is only owned and uploaded.
// Each arm of the switch on the kind is a lookup that brings its own shape,
// `Interior from arena[...] { ... }` (ir::Lookup::shape): the row's bytes
// read as that struct, so a node and a leaf can sit in one storage.
//
// A node row is Embree's AABBNode, 256 bytes: the eight children as 64-bit
// references, then the bounds as six vectors of eight floats in Embree's
// order -- lower_x, upper_x, lower_y, upper_y, lower_z, upper_z -- from
// which the tree's `lo` and `hi` are derived, a vector of corners built from
// its component vectors, which costs nothing (a vector of vectors is a struct
// of its component vectors in the generated code). A leaf is Embree's
// TriangleM<4> blocks, 176 bytes each, every field a vector over the four
// triangles -- Scion's array-of-structs-of-arrays, a group nested in a
// group with the inner one the tile -- a run of them beginning where the
// reference says, as many as its kind bits count: `indirect group tiles {
// group[4] { ... }; }` without a size is that run, and `data = range(tiles,
// 0u, n)` the leaf's triangles.
//
// The driver (rtq_hook.cpp) builds the tree with Embree's own builder and
// writes rows and blocks into the allocation as Embree's allocator would
// place them, with every reference the address of what it names, checks the
// struct sizes and offsets against Embree's at compile time, and reproduces
// Embree's relocation of the largest nodes.

import apps/rtq/schedules/trees/bvh8;

schedule {
    layout triangles(ref : u64 = root) {
        root : u64;
        bytes : u64;
        ptr group arena[bytes] { byte : u8; };
        switch ref[3:3] {
            0 => Interior from arena[ref] {
                children : vector[u64, 8];
                lower_x : vector[f32, 8];
                upper_x : vector[f32, 8];
                lower_y : vector[f32, 8];
                upper_y : vector[f32, 8];
                lower_z : vector[f32, 8];
                upper_z : vector[f32, 8];
                lo = vector[vec3f, 8]{lower_x, lower_y, lower_z};
                hi = vector[vec3f, 8]{upper_x, upper_y, upper_z};
            };
            _ => Leaf from arena[ref[4:63] * 16u] {
                // Embree: TriangleM::valid -- a slot of a block that holds
                // fewer than four triangles is all zeros with ids of -1
                // (TriangleM::fill); which lanes are triangles, the ids say.
                indirect group tiles {
                    group[4] {
                        v0 : vec3f;
                        e1 : vec3f;
                        e2 : vec3f;
                        geomID : u32;
                        primID : u32;
                    } where geomID != 4294967295u;
                };
                data = range(tiles, 0u, cast[[u32]](ref[0:2] * 4u));
            };
        };
    };
}
