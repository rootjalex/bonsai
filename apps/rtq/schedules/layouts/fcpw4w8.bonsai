// FCPW's vectorized BVH ("Mbvh") over triangles at a branching factor of 4
// and a leaf width of 8: what FCPW's build makes on an AVX2 machine
// (FCPW_SIMD_WIDTH 8 from enoki's `-mavx2`), its builder making leaves of up
// to eight triangles, over the four-wide tree of trees/bvh4.bonsai.
// fcpw4w16.bonsai describes the storage and the encodings; what differs
// here is the packet -- MbvhLeafNode<8, 3>, 320 bytes: the three vertices
// of eight triangles as three vectors of three vectors of eight floats,
// then eight ids. The node row is the same 112 bytes.
import apps/rtq/schedules/trees/bvh4;

schedule {
    layout triangles {
        nLeafs : u32;
        indirect group packets[nLeafs] {
            group[8] {
                pa : vec3f;
                pb : vec3f;
                pc : vec3f;
                primitiveIndex : i32;
                v0 = pa;
                e1 = pa - pb;
                e2 = pc - pa;
                geomID = 0u;
                primID = cast[[u32]](primitiveIndex);
            };
        };
        nNodes : u32;
        group[nNodes] index : u32 {
            boxMin_x : vector[f32, 4];
            boxMin_y : vector[f32, 4];
            boxMin_z : vector[f32, 4];
            boxMax_x : vector[f32, 4];
            boxMax_y : vector[f32, 4];
            boxMax_z : vector[f32, 4];
            child0 : i32;
            child1 : i32;
            child2 : i32;
            child3 : i32;
            kind = child0[31:31];
            switch kind {
                0 => Interior {
                    children = vector[u32, 4]{cast[[u32]](child0), cast[[u32]](child1),
                                              cast[[u32]](child2), cast[[u32]](child3)};
                    lo = vector[vec3f, 4]{boxMin_x, boxMin_y, boxMin_z};
                    hi = vector[vec3f, 4]{boxMax_x, boxMax_y, boxMax_z};
                };
                _ => Leaf {
                    data = range(packets, cast[[u32]](0 - child0 - 1) * 8u, cast[[u32]](child3));
                };
            };
        };
    };
}
