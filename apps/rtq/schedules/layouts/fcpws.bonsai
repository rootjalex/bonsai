// FCPW's normal cone hierarchy as its CPU reads it: fcpw::Bvh<3, SnchNode<3>,
// Triangle, SilhouetteEdge>'s bytes and no others, as two trees over one
// node array (fcpws_gpu.bonsai says why two: FCPW's one tree holds the
// triangles and the silhouette edges, each leaf referencing its range of
// both, and the program's two sets are two trees reading the same rows).
// The node array is flatTree, 60-byte SnchNode rows (fcpw/aggregates/bvh.h:
// the box, the cone -- axis, half angle, radius -- then the reference
// offset or second child offset, the silhouette reference offset, the
// reference count, the silhouette reference count; the GPU row has the same
// fields with the two counts and the silhouette offset in another order,
// so the two layouts differ in those twelve bytes). The triangles are read
// as fcpwb.bonsai reads them: the pointer array, the Triangle objects by
// address, the positions by index. The silhouette edges likewise: the
// references the leaves index (Bvh::silhouetteRefs, a SilhouetteEdge* per
// reference, an edge referenced once per leaf whose triangles share it),
// each the SilhouetteEdge object at its address (40 bytes: the vtable
// pointer, four vertex indices -- the two ends at 1 and 2, the opposite
// corner of each adjacent face at 3 and 0, -1 where there is no face --
// the edge's index, four bytes of padding, the soup pointer; fcpw/geometry/
// silhouette_edges.h), and the ends from the positions by index. The
// driver hands the program FCPW's own memory, wrapped (apps/rtq/fcpw_snch.h,
// built without RTQ_GPU).
//
// FCPW's CPU edge test (SilhouetteEdge::findClosestSilhouettePoint) reads
// the two ends, and, where the edge has two faces, recomputes both faces'
// unit normals from the positions at every test (SilhouetteEdge::normal:
// `(pb - pa).cross(pc - pa).normalized()`, the corners of face 0 at indices
// 1, 2, 3 and of face 1 at 2, 1, 0); the GPU row stores them. Here the
// normals are derived from the positions as FCPW's are -- Eigen's cross,
// its squared norm (`fma(x, x, fma(y, y, z * z))`), and `normalized()`'s
// division guarded by the squared norm being positive (metrics/fcpw_scalar.
// bonsai, `unit`) -- and the program reads them only where FCPW computes
// them, in the two-face case of the silhouette test (is_silhouette_edge),
// so the two gathers and the two normalizations are paid where FCPW pays
// them and an absent face's index of -1 is never followed.
schedule {
    tree[[Triangle]] SNCH =
    | Interior(children : array[SNCH, 2], lo hi axis : vector[vec3f, 2],
               half_angle radius : vector[f32, 2])
        with ConeBox(lo, hi, axis, half_angle, radius) on children
    | Leaf(data : array[Triangle]) with data = data;
    triangles : SNCH;

    layout triangles {
        // FCPW: PolygonSoup::positions.
        vCount : u32;
        indirect group positions[vCount] {
            p : vec3f;
        };
        // FCPW: the Triangle objects, by address.
        oCount : u32;
        ptr group objects[oCount] {
            vptr : u64;
            i0 : i32;
            i1 : i32;
            i2 : i32;
            pIndex : i32;
            soup : u64;
        };
        // FCPW: Bvh::primitives, a Triangle* per reference.
        pCount : u32;
        indirect group prims[pCount] {
            group[1] {
                tri : u64;
                t = objects[tri];
                pa = positions[t.i0].p;
                pb = positions[t.i1].p;
                pc = positions[t.i2].p;
                v0 = pa;
                e1 = pa - pb;
                e2 = pc - pa;
                geomID = 0u;
                primID = cast[[u32]](t.pIndex);
            };
        };
        // FCPW: SnchNode<3>.
        nNodes : u32;
        group[nNodes] index : u32 {
            low : vec3f;
            high : vec3f;
            cone_axis : vec3f;
            cone_half_angle : f32;
            cone_radius : f32;
            offset : i32;
            silhouetteOffset : i32;
            nReferences : i32;
            nSilhouettes : i32;
            switch nReferences {
                0 => Interior {
                    left = index + 1u;
                    right = index + cast[[u32]](offset);
                    children = vector[u32, 2]{left, right};
                    lo = vector[vec3f, 2]{vector[f32, 2]{this[left].low.x, this[right].low.x},
                                          vector[f32, 2]{this[left].low.y, this[right].low.y},
                                          vector[f32, 2]{this[left].low.z, this[right].low.z}};
                    hi = vector[vec3f, 2]{vector[f32, 2]{this[left].high.x, this[right].high.x},
                                          vector[f32, 2]{this[left].high.y, this[right].high.y},
                                          vector[f32, 2]{this[left].high.z, this[right].high.z}};
                    axis = vector[vec3f, 2]{vector[f32, 2]{this[left].cone_axis.x, this[right].cone_axis.x},
                                            vector[f32, 2]{this[left].cone_axis.y, this[right].cone_axis.y},
                                            vector[f32, 2]{this[left].cone_axis.z, this[right].cone_axis.z}};
                    half_angle = vector[f32, 2]{this[left].cone_half_angle, this[right].cone_half_angle};
                    radius = vector[f32, 2]{this[left].cone_radius, this[right].cone_radius};
                };
                _ => Leaf {
                    data = range(prims, cast[[u32]](offset), cast[[u32]](nReferences));
                };
            };
        };
    };

    // The silhouette edges over the same nodes.
    tree[[Edge]] SNCHE =
    | Interior(children : array[SNCHE, 2], lo hi axis : vector[vec3f, 2],
               half_angle radius : vector[f32, 2])
        with ConeBox(lo, hi, axis, half_angle, radius) on children
    | Leaf(data : array[Edge]) with data = data;
    silhouettes : SNCHE;

    layout silhouettes {
        // FCPW: PolygonSoup::positions again, the same array the triangles'
        // layout wraps (a program's group names are one namespace, so the
        // second name).
        evCount : u32;
        indirect group epositions[evCount] {
            p : vec3f;
        };
        // FCPW: the SilhouetteEdge objects (SceneData::silhouetteEdgeObjects),
        // 40 bytes each, by address.
        eoCount : u32;
        ptr group edge_objects[eoCount] {
            vptr : u64;
            i0 : i32;
            i1 : i32;
            i2 : i32;
            i3 : i32;
            pIndex : i32;
            32;
            soup : u64;
        };
        // FCPW: Bvh::silhouetteRefs, a SilhouetteEdge* per reference.
        eCount : u32;
        indirect group edges[eCount] {
            group[1] {
                edge : u64;
                e = edge_objects[edge];
                pa = epositions[e.i1].p;
                pb = epositions[e.i2].p;
                index = cast[[u32]](e.pIndex);
                one_face = select(e.i3 == -1 || e.i0 == -1, 1u, 0u);
                // FCPW: SilhouetteEdge::normal(0), the face (indices[1],
                // indices[2], indices[3]), and normal(1), the face
                // (indices[2], indices[1], indices[0]): `(pb - pa).cross(pc
                // - pa).normalized()` each, Eigen's arithmetic. Read only
                // where one_face is 0.
                c3 = epositions[e.i3].p;
                c0 = epositions[e.i0].p;
                u0 = pb - pa;
                w0 = c3 - pa;
                x0 = vec3f{u0.y * w0.z - u0.z * w0.y, u0.z * w0.x - u0.x * w0.z, u0.x * w0.y - u0.y * w0.x};
                z0 = fma(x0.x, x0.x, fma(x0.y, x0.y, x0.z * x0.z));
                n0 = select(z0 > 0.0, x0 / sqrt(z0), x0);
                u1 = pa - pb;
                w1 = c0 - pb;
                x1 = vec3f{u1.y * w1.z - u1.z * w1.y, u1.z * w1.x - u1.x * w1.z, u1.x * w1.y - u1.y * w1.x};
                z1 = fma(x1.x, x1.x, fma(x1.y, x1.y, x1.z * x1.z));
                n1 = select(z1 > 0.0, x1 / sqrt(z1), x1);
            };
        };
        sNodes : u32;
        group[sNodes] snode : u32 {
            low : vec3f;
            high : vec3f;
            cone_axis : vec3f;
            cone_half_angle : f32;
            cone_radius : f32;
            offset : i32;
            silhouetteOffset : i32;
            nReferences : i32;
            nSilhouettes : i32;
            switch nReferences {
                0 => Interior {
                    left = snode + 1u;
                    right = snode + cast[[u32]](offset);
                    children = vector[u32, 2]{left, right};
                    lo = vector[vec3f, 2]{vector[f32, 2]{this[left].low.x, this[right].low.x},
                                          vector[f32, 2]{this[left].low.y, this[right].low.y},
                                          vector[f32, 2]{this[left].low.z, this[right].low.z}};
                    hi = vector[vec3f, 2]{vector[f32, 2]{this[left].high.x, this[right].high.x},
                                          vector[f32, 2]{this[left].high.y, this[right].high.y},
                                          vector[f32, 2]{this[left].high.z, this[right].high.z}};
                    axis = vector[vec3f, 2]{vector[f32, 2]{this[left].cone_axis.x, this[right].cone_axis.x},
                                            vector[f32, 2]{this[left].cone_axis.y, this[right].cone_axis.y},
                                            vector[f32, 2]{this[left].cone_axis.z, this[right].cone_axis.z}};
                    half_angle = vector[f32, 2]{this[left].cone_half_angle, this[right].cone_half_angle};
                    radius = vector[f32, 2]{this[left].cone_radius, this[right].cone_radius};
                };
                _ => Leaf {
                    data = range(edges, cast[[u32]](silhouetteOffset), cast[[u32]](nSilhouettes));
                };
            };
        };
    };
}
