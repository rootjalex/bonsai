// The Embree schedule: apps/rtq/rtq.bonsai run the way Embree's
// BVHNIntersector1<8> runs -- the schedule the comparison against Embree is
// made with. Compiled beside the program as a second input:
//
//     ./build/compiler -p ssa --no-heap --ffp-contract \
//         -i apps/rtq/rtq.bonsai -i apps/rtq/schedules/embree.bonsai ...
//
// The tree is the eight-wide one (trees/bvh8.bonsai) in Embree's bytes
// (layouts/embree8.bonsai): a node holds its eight children's boxes, so a
// traversal tests the eight at the node, in a loop over the children the
// tree lowering makes (Lower/Trees.cpp, from_children). What this file adds
// is the order, the eight-wide test and the stack.
import apps/rtq/schedules/layouts/embree8;

schedule {
    // Embree: traverseClosestHit -- of the children hit, the nearest is
    // descended into and the rest are pushed, farthest first, so that the
    // next pop is the next nearest; `tNear`, the distance at which the ray
    // enters each child's box, is the order. The key is written over the
    // node's fields: child i's box is corner i of the eight the node holds,
    // and `distmin` is the slab test's entry distance. The key is computed
    // in the same loop as the tests (Lower/Sorts.cpp), and `i` is that
    // loop's index, in its type, so that the key's reads of the child's box
    // are the test's reads and the slab test is done once. The sort is over
    // the hits alone, as Embree's is: the mask, the keys and the children
    // come out of the loop as vectors, the misses' keys are made infinite,
    // and one vector network orders them with the children following
    // (SSA/SortRecursion.cpp); the hits that wait go to the stack in one
    // compacting store and the nearest is descended into
    // (SSA/QueueRecursion.h).
    //
    // Embree: intersectNode -- the eight children's boxes tested at once,
    // the node's six bound vectors against the ray broadcast. The loop over
    // the children, named by the field through the arm, is vectorized: its
    // eight iterations are the eight lanes, a lane's box is the stored
    // vectors themselves (SSA/Vectorize.cpp), and the mask and the keys come
    // out as vectors.
    //
    // Embree: stackSize = 1 + (N - 1) * maxDepth + 3 for N = 8 and a maximum
    // depth of 80 (bvh.h, bvh_intersector1.h): 564 entries, the most a
    // traversal can have waiting.
    // Embree: TriangleMIntersector1Moeller<4> -- a leaf's Triangle4 block
    // tested as four lanes, and the nearest of the lanes that hit taken
    // (Intersect1EpilogM, select_min). The loop over a leaf's triangles is
    // a loop over its blocks with a loop over the four lanes of each inside
    // (Lower/ForEachs.cpp), named for the field; the lanes' loop is
    // vectorized, and the argmin's update becomes one reduction across the
    // lanes (SSA/Vectorize.cpp).
    trace.sort(triangles.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(triangles.Interior.children)
         .vectorize(triangles.Leaf.data)
         .loopify(564);
    // Embree: MoellerTrumboreIntersector1's `early_out` -- after the edge
    // tests of a Triangle4 block, `if (none(valid)) return`, before the
    // depth test and the reciprocal. The triangle test's early returns are
    // the `if`s written in intersectsp_ray_tri; this puts a test of whether
    // any lane goes on in front of what follows each (SSA/Linearize.h,
    // "Which arms get a gadget"). Measured 2026-10-02: level on primary
    // rays, 5-7% slower on the incoherent ones, where whether any lane of a
    // block survives the edge tests is a coin flip and the mispredictions
    // cost more than the ten instructions skipped. Kept, since this schedule
    // is Embree's structure step for step; tuned.bonsai is where a step is
    // dropped when it measures worse.
    trace.skip(intersectsp_ray_tri);
    // Embree: BVH::prefetch on every hit child as the traversal extracts it
    // from the node, before the sort and the pushes -- four `prefetcht0`,
    // the 256 bytes of a BVH8 node, so that a child popped later is in L1
    // (bvh_traverser1.h, bvh.h). The children's loop prefetches what each
    // hit child refers to: the node row or the leaf's first tile, chosen by
    // the reference's low bits as a visit chooses, 256 bytes either way
    // (Lower/Prefetches.cpp, Lower/Layouts.cpp).
    trace.prefetch(triangles.Interior.children);

    // Embree: traverseAnyHit -- the occlusion test pushes the hit children
    // in their stored order, "simpler in sequence traversal order", and
    // stops at the first triangle hit: `any` stops, and nothing is sorted.
    // The children's test is the same eight-wide one, and the leaf's the
    // same four-wide one.
    occluded.vectorize(triangles.Interior.children)
            .vectorize(triangles.Leaf.data)
            .loopify(564);
    // Embree: the occlusion intersector is the same MoellerTrumbore test
    // with the same `early_out` (TriangleMIntersector1Moeller::occluded),
    // so the leaf's early exits are scheduled here too (same measured cost
    // as above; tuned.bonsai leaves this one out).
    occluded.skip(intersectsp_ray_tri);
    // Embree: traverseAnyHit prefetches the hit children as the closest-hit
    // traversal does (BVH::prefetch on `cur` and on each child pushed).
    occluded.prefetch(triangles.Interior.children);

    // Embree: BVHNIntersector1::pointQuery (bvh_intersector1.cpp) -- the
    // closest-point query walks the tree as the nearest hit does: the eight
    // children tested at the node (pointQuerySphereDistAndMask, the point's
    // squared distance to each child's box), the nearest descended into and
    // the rest pushed by that distance (the same traverseClosestHit), the
    // same stack, a popped node dropped where its distance is beyond the
    // best found, and the hit children prefetched as they are taken. The
    // leaf is where Embree's shape cannot be followed: its point query
    // hands each triangle of a block to the user's callback one at a time
    // (PrimitivePointQuery1, Geometry::pointQuery), a scalar routine over
    // the mesh's own vertices, so the four-wide leaf here, over the block's
    // stored edges, is the query's own form.
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .vectorize(triangles.Interior.children)
           .vectorize(triangles.Leaf.data)
           .loopify(564);
    closest.prefetch(triangles.Interior.children);

    // The parfor over the rays is left unbound, so it lowers to a plain
    // sequential loop: the comparison is single-threaded on both sides
    // (compare.sh), and Embree's rays go through a loop of rtcIntersect1.
}
