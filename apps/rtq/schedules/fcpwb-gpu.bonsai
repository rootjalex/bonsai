// The schedule matching FCPW's GPU over its binary BVH: rtq.bonsai's three
// batches as FCPW's compute shaders run them (fcpw/gpu/bvh.cs.slang:
// rayIntersection, closestPoint -- one thread a query, groups of 256,
// FCPW's nThreadsPerGroup, as many groups as the batch needs), each
// thread's traversal bvh.slang's over the same rows (layouts/fcpwb.bonsai:
// the one tree FCPW puts on a GPU, GPUBvhNode and GPUTriangle rows). The
// reference is FCPW's GPUScene, run by the driver built with RTQ_GPU
// (compare.sh does so for the schedules named *-gpu): its shaders over the
// same tree, the queries uploaded before the clock and the answers read
// back after it, the clock around the dispatch and the wait, as it is
// around the program's launch and wait.
//
// The traversals are bvh.slang's: both children's boxes tested at the
// parent and written out (`unroll`), the nearer entered first by the box
// distance -- for the closest point by d2Min alone (`if
// (distToChildNodes[2] < distToChildNodes[0]) swap`, a tie keeping the
// left child first), where the CPU traversal of fcpwb.bonsai orders two
// children holding the point by their far corners; for the rays by the
// slab entry -- a stack of sixty-four (FCPW_GPU_BVH_MAX_DEPTH), the leaf's
// Voronoi exits. Each batch's loop is split by 256 and bound to the GPU's
// blocks and threads: one launch, one query a thread, the tail block
// guarded.
import apps/rtq/schedules/layouts/fcpwb;

schedule {
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .unroll(triangles.Interior.children)
           .loopify(64);
    closest.skip(closest_point_fcpw);
    trace.sort(triangles.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
               distmin(r, AABB{lo[i], hi[i]}))
         .unroll(triangles.Interior.children)
         .loopify(64);
    occluded.sort(triangles.Interior,
                  |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                  distmin(r, AABB{lo[i], hi[i]}))
            .unroll(triangles.Interior.children)
            .loopify(64);

    trace_all.split(i, i_blk, i_thr, 256, true);
    trace_all.bind(i_blk, GPUBlock);
    trace_all.bind(i_thr, GPUThread);
    occluded_all.split(i, i_blk, i_thr, 256, true);
    occluded_all.bind(i_blk, GPUBlock);
    occluded_all.bind(i_thr, GPUThread);
    closest_all.split(i, i_blk, i_thr, 256, true);
    closest_all.bind(i_blk, GPUBlock);
    closest_all.bind(i_thr, GPUThread);
}
