// The Embree schedule over Embree's four-wide tree: apps/rtq/rtq.bonsai run
// the way Embree's BVHNIntersector1<4> runs -- embree.bonsai with four
// lanes where it has eight, and the stack sized for N = 4. Compiled beside
// the program as a second input:
//
//     ./build/compiler -p ssa --no-heap --ffp-contract \
//         -i apps/rtq/rtq.bonsai -i apps/rtq/schedules/embree4.bonsai ...
//
// The tree is Embree's BVH4 (trees/bvh4.bonsai). The directives are
// embree.bonsai's, and so is what each stands for in Embree's code
// (traverseClosestHit and traverseAnyHit of bvh_traverser1.h, which for N
// = 4 sort two hits by one compare and three or four with sort3 and sort4
// -- the counted arms our sort lowering makes, with no network needed, as
// four lanes are covered by the counts; intersectNode's four-wide test;
// stackSizeSingle = 1 + (N - 1) * maxDepth + 3 = 244).
import apps/rtq/schedules/trees/bvh4;

schedule {
    trace.sort(triangles.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(triangles.Interior.children)
         .vectorize(triangles.Leaf.data)
         .loopify(244);
    trace.skip(intersectsp_ray_tri);
    trace.prefetch(triangles.Interior.children);

    occluded.vectorize(triangles.Interior.children)
            .vectorize(triangles.Leaf.data)
            .loopify(244);
    occluded.skip(intersectsp_ray_tri);
    occluded.prefetch(triangles.Interior.children);

    // The closest-point query as embree.bonsai schedules it, four wide
    // (BVHNIntersector1<4>::pointQuery: the same traverseClosestHit over
    // the children's squared distances, the stack of 244).
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .vectorize(triangles.Interior.children)
           .vectorize(triangles.Leaf.data)
           .loopify(244);
    closest.prefetch(triangles.Interior.children);
}
