// The FCPW schedule over its eight-wide tree with eight-lane leaves (an AVX2
// machine with FCPW_USE_EIGHT_WIDE_BRANCHING): fcpw8w16.bonsai's directives,
// with its departure in the children's order, over layouts/fcpw8w8.bonsai.
//
//     ./build/compiler -p ssa --no-heap --ffp-contract \
//         -i apps/rtq/rtq.bonsai -i apps/rtq/schedules/fcpw8w8.bonsai ...
import apps/rtq/schedules/layouts/fcpw8w8;

schedule {
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .vectorize(triangles.Interior.children)
           .vectorize(triangles.Leaf.data)
           .loopify(154);
    closest.skip(closest_point_fcpw);

    trace.sort(triangles.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(triangles.Interior.children)
         .vectorize(triangles.Leaf.data)
         .loopify(154);
    // FCPW's any hit is its one traversal told to stop at the first hit, so
    // it sorts the children as the nearest hit does (fcpw4w16.bonsai), with
    // the same departure in the eight-wide order as the trace's above.
    occluded.sort(triangles.Interior,
                  |i : u32, r : Ray, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
                  distmin(r, AABB{lo[i], hi[i]}))
            .vectorize(triangles.Interior.children)
            .vectorize(triangles.Leaf.data)
            .loopify(154);
}
