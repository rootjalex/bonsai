// The tuned schedule over Embree's four-wide tree: embree4.bonsai with the
// steps dropped that measure worse here, as tuned.bonsai drops them over
// the eight-wide tree -- the leaf's early exit on both queries (see
// tuned.bonsai for the measurements over the eight-wide tree; this file's
// own are in PLAN.md).
import apps/rtq/schedules/layouts/embree4;

schedule {
    trace.sort(triangles.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(triangles.Interior.children)
         .vectorize(triangles.Leaf.data)
         .loopify(244);
    // Three lines a hit child where Embree fetches two of a BVH4 node
    // (embree4.bonsai): the third is the last of a Triangle4 tile's 144
    // bytes, and measured 2026-10-07 (head, pavilion, ganesha; least of 5,
    // alternated twice) it is level with two on every ray cell and 3%
    // ahead on ganesha's volume batch, the one that visits the most leaves.
    trace.prefetch(triangles.Interior.children, 3);

    occluded.vectorize(triangles.Interior.children)
            .vectorize(triangles.Leaf.data)
            .loopify(244);
    occluded.prefetch(triangles.Interior.children, 3);

    // The closest-point query as embree4.bonsai schedules it but for the
    // prefetch's third line (above): no other step has measured worse here.
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 4], hi : vector[vec3f, 4]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .vectorize(triangles.Interior.children)
           .vectorize(triangles.Leaf.data)
           .loopify(244);
    closest.prefetch(triangles.Interior.children, 3);
}
