// The tuned schedule over FCPW's eight-wide tree with sixteen-lane leaves:
// fcpw8w16.bonsai without the closest point's leaf exits, for the reason
// fcpw4w16t.bonsai gives (the exits are branches that mispredict as FCPW's
// do; the straight-line leaf has none). Measured (2026-10-06, side 1024,
// least of 5, cpu 11; bonsai over FCPW, matching -> tuned): head near 1.13
// -> 1.35x, volume 1.33 -> 1.68x; ganesha near 1.42 -> 1.52x, volume 1.26
// -> 1.07x; dragon near 1.36 -> 1.39x, volume 1.25 -> 1.05x; the ray
// queries within a point either way.
//
// And the hit children prefetched, Embree's step that FCPW never takes:
// over this layout the directive fetches each hit child's node row (224
// bytes, four lines) with no load in the way (PLAN.md, 2026-10-07).
// Measured against none on head, ganesha and dragon (side 1024, least of
// 5, alternated twice): the large meshes gain on every cell -- rays 1-6%,
// the near batch 2-7%, the volume batch 1.08 -> 1.28x and 1.07 -> 1.25-1.28x,
// which puts the tuned closest point level with the matching one's volume
// batch instead of 15-19% behind it -- and head is a wash on its rays
// (within 3% both ways) and 2-4% down on its points. Two lines fetched too
// little for the volume batch, six did no more than the row.
//
//     ./build/compiler -p ssa --no-heap --ffp-contract \
//         -i apps/rtq/rtq.bonsai -i apps/rtq/schedules/fcpw8w16t.bonsai ...
import apps/rtq/schedules/layouts/fcpw8w16;

schedule {
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .vectorize(triangles.Interior.children)
           .vectorize(triangles.Leaf.data)
           .loopify(154);
    closest.prefetch(triangles.Interior.children);

    trace.sort(triangles.Interior,
               |i : u32, r : Ray, lo : vector[vec3f, 8], hi : vector[vec3f, 8]|
               distmin(r, AABB{lo[i], hi[i]}))
         .vectorize(triangles.Interior.children)
         .vectorize(triangles.Leaf.data)
         .loopify(154);
    trace.prefetch(triangles.Interior.children);
    // The any hit unsorted, Embree's traverseAnyHit, where the matching
    // schedule sorts as FCPW's one traversal does; the table says which
    // measures better over FCPW's tree.
    occluded.vectorize(triangles.Interior.children)
            .vectorize(triangles.Leaf.data)
            .loopify(154);
    occluded.prefetch(triangles.Interior.children);
}
