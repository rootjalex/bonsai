// apps/rtq's geometry as Embree computes it, transcribed: the slab test of
// its node test (node_intersector1.h), its Moeller-Trumbore triangle test
// (triangle_intersector_moeller.h), the point-to-box distance of its point
// query (pointQuerySphereDistAndMask) and the closest point on a triangle
// of its closest-point tutorial's callback (tutorials/common/math/
// closest_point.h). Compiled beside rtq.bonsai for every comparison against
// Embree (compare.sh); metrics/fcpw.bonsai is the same set of functions as
// FCPW computes them. Embree's reciprocals are `rcp_embree` below: the
// machine's estimate instruction and Embree's one Newton step, written
// out, so that the bits agree by construction.

element FInterval {
    low, high : Float;
}

// Embree: `rcp` (common/simd/vfloat4_sse2.h, vfloat8_avx.h,
// vfloat16_avx512.h, math/vec3fa.h) -- the estimate instruction, `vrcp14ps`
// with AVX-512VL and `rcpps` without, which is `rcp_approx` here, then one
// Newton step `r + r (1 - a r)` as two fused multiply-adds,
// `fmadd(r, fnmadd(a, r, 1), r)`, which compare.sh's `--ffp-contract` makes
// of this (SSA/Contract.h: `1 - a r` is `fma(-a, r, 1)` and `r + r h` is
// `fma(r, h, r)`). A Vec3fa's reciprocal is the same over the three
// components padded to the register's four (rcp_embree_vec3). Not enoki's
// step, which FCPW uses (metrics/fcpw.bonsai, rcp_fcpw): the two round
// differently in a third of all inputs.
func rcp_embree(a : Float) -> Float {
    r = rcp_approx(a);
    return r + r * (1.0 - a * r);
}

func rcp_embree_vec3(a : vec3f) -> vec3f {
    r = rcp_approx(a);
    return r + r * (1.0 - a * r);
}

// Embree: the smallest magnitude a direction's component is allowed before
// its reciprocal is taken (min_rcp_input, rcp_safe / zero_fix).
func zero_fix(d : vec3f) -> vec3f {
    tiny : Float = 1e-18;
    return select(abs(d) < tiny, vec3f{tiny, tiny, tiny}, d);
}

// Embree: node_intersector1.h, the slab test of `intersectNode` for one
// child's box, as TravRay sets it up -- the reciprocal direction and
// `org * rdir` once per ray, each slab then one fused multiply-subtract --
// and the interval clamped to the ray's segment before the comparison, in
// the form Embree's AVX-512 build (the one this machine runs) writes it:
//
//     tNear = maxi(tNearX, tNearY, tNearZ, tnear)
//     tFar  = mini(tFarX,  tFarY,  tFarZ,  tfar)
//     hit   = asInt(tNear) <= asInt(tFar)
//
// where `maxi` and `mini` are the integer max and min of the floats' bits
// (vfloat8_avx.h: `_mm256_max_epi32` on `_mm256_castps_si256`), paired as
// `maxi(maxi(a, b), maxi(c, d))` (emath.h), and the compare is of the bits.
// The bits of non-negative floats order as the floats do, and with the
// segment clamped to [0, inf) (rtq.bonsai, `clamped`) `tnear` is
// non-negative, so the max is at least it whatever the slab distances are,
// and a negative `tFar` -- a box behind the ray -- fails the compare
// against it however the min ordered the negatives. An integer min and max
// are associative and have no NaN case, which is what lets the compiler
// fold the traversal's running best into `tfar` exactly (SSA/Simplify.cpp);
// a float min is std::min, which neither is nor has. Embree takes the
// reciprocal with `rcp_safe`, `rcp(zero_fix(d))` over the three components
// padded to four, and so does this.
func intersectsp_ray_aabb(r : Ray, b : AABB) -> option[FInterval] {
    rdir = rcp_embree_vec3(zero_fix(r.d));
    org_rdir = r.o * rdir;
    dirIsNeg = rdir < 0.0;
    near = select(dirIsNeg, b.high, b.low);
    far = select(dirIsNeg, b.low, b.high);
    tNearV = near * rdir - org_rdir;
    tFarV = far * rdir - org_rdir;
    tNear = max(max(reinterpret[[i32]](tNearV.x), reinterpret[[i32]](tNearV.y)),
                max(reinterpret[[i32]](tNearV.z), reinterpret[[i32]](r.tnear)));
    tFar = min(min(reinterpret[[i32]](tFarV.x), reinterpret[[i32]](tFarV.y)),
               min(reinterpret[[i32]](tFarV.z), reinterpret[[i32]](r.tfar)));
    if tNear <= tFar {
        return FInterval{reinterpret[[Float]](tNear), reinterpret[[Float]](tFar)};
    }
    return {};
}

func intersects(r : Ray, b : AABB) -> bool = cast[[bool]](intersectsp_ray_aabb(r, b));

// Where the ray enters the box, and infinitely far where it misses: as a
// bound on the metric it says a missed box holds nothing nearer than
// anything, and as a sort key it puts the children the ray misses last.
func distmin(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.low;
    }
    return inf;
}

func distmax(r : Ray, b : AABB) -> Float {
    interval = intersectsp_ray_aabb(r, b);
    if interval {
        extract = *interval;
        return extract.high;
    }
    return inf;
}

// A box never contains a ray, so no subtree is ever hit throughout: what
// settles an `any` without a visit, which for a ray is never.
func contains(r : Ray, b : AABB) -> bool = false;

element TriangleHit {
    t, u, v : Float;
}

// Embree: MoellerTrumboreIntersector1::intersect, through intersectEdge --
// the Moeller-Trumbore test as Embree factors it, with the triangle's
// normal from its two stored edges and the sign of the denominator folded
// into the edge tests by flipping the sign bit (`asInt(..) ^ asInt(sgnDen)`).
// Backface culling off, as Embree builds by default. The depth test is
// against the ray's own segment; the comparison with the nearest hit so far
// is the query's.
func intersectsp_ray_tri(r : Ray, tri : Triangle) -> option[TriangleHit] {
    Ng = cross(tri.e2, tri.e1);
    C = tri.v0 - r.o;
    R = cross(C, r.d);
    den = dot(Ng, r.d);
    absDen = abs(den);
    sgnDen = reinterpret[[u32]](den) & 2147483648u;
    U = reinterpret[[Float]](reinterpret[[u32]](dot(R, tri.e2)) ^ sgnDen);
    V = reinterpret[[Float]](reinterpret[[u32]](dot(R, tri.e1)) ^ sgnDen);
    if !(den != 0.0 && U >= 0.0 && V >= 0.0 && U + V <= absDen) {
        return {};
    }
    T = reinterpret[[Float]](reinterpret[[u32]](dot(Ng, C)) ^ sgnDen);
    if !(absDen * r.tnear < T && T <= absDen * r.tfar) {
        return {};
    }
    // Embree: MoellerTrumboreHitM::finalize, `rcp(absDen)` once and the
    // three scaled by it -- the four lanes of a Triangle4 at once, which is
    // what this is in the vectorized leaf.
    rcpAbsDen = rcp_embree(absDen);
    return TriangleHit{T * rcpAbsDen, U * rcpAbsDen, V * rcpAbsDen};
}

func intersects(r : Ray, tri : Triangle) -> bool = cast[[bool]](intersectsp_ray_tri(r, tri));

func distmin(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return inf;
}

func distmax(r : Ray, tri : Triangle) -> Float {
    hit = intersectsp_ray_tri(r, tri);
    if hit {
        extract = *hit;
        return extract.t;
    }
    return -inf;
}

// Embree: pointQuerySphereDistAndMask (node_intersector1.h) -- the point
// clamped into the box and the squared length of the offset, `v =
// min(max(org, lower), upper) - org; dist = v.v`, the distance Embree's
// point query orders the children by (traverseClosestHit on `dist`) and
// tests them by (`dist <= radius^2`). The closest-point query's metric is a
// squared distance at the box and at the triangle, Embree's own domain at
// the node, where it squares its radius rather than root its distances.
func distmin(q : Point, b : AABB) -> Float {
    v = min(max(q.p, b.low), b.high) - q.p;
    return dot(v, v);
}

// The farthest a point of the box can be from `q`, squared: the farther of
// the two faces along each axis.
func distmax(q : Point, b : AABB) -> Float {
    v = max(abs(q.p - b.low), abs(q.p - b.high));
    return dot(v, v);
}

// Embree: closestPointTriangle (tutorials/common/math/closest_point.h, what
// the closest-point tutorial's callback runs on each triangle the traversal
// hands it) -- Ericson's Voronoi-region test (Real-Time Collision
// Detection, 5.1.5), in Embree's order: the three vertex regions by the
// signs of six dot products, then the three edge regions, else the face,
// where the closest point is interior and given by its barycentrics, with
// true divisions. Over the triangle as the block stores it: `a` is v0, `ab
// = b - a` is the stored edge `e1 = v0 - v1` negated, `ac = c - a` is the
// stored `e2 = v2 - v0`, and `p - b`, `p - c` follow from `p - a` by the
// edges. The callback then takes the distance, `d = distance(q, p)`, a root
// per triangle, and compares it with its radius; the root is taken here
// too, the same computation, and squared back into the node test's domain
// (where Embree squares its radius once per leaf that shrank it). The point
// is made as Embree's routine makes it, `a + ab * v`, and the distance from
// `q - p`, not from the offsets `ap - ab * v` that the subtraction would
// shorten to: the same operations in the same order, so the bits agree.
func closest_point_embree(q : Point, tri : Triangle) -> vec3f {
    a = tri.v0;
    ab = -tri.e1;
    ac = tri.e2;
    ap = q.p - a;
    d1 = dot(ab, ap);
    d2 = dot(ac, ap);
    if d1 <= 0.0 && d2 <= 0.0 {
        return a;
    }
    b = a + ab;
    bp = q.p - b;
    d3 = dot(ab, bp);
    d4 = dot(ac, bp);
    if d3 >= 0.0 && d4 <= d3 {
        return b;
    }
    c = a + ac;
    cp = q.p - c;
    d5 = dot(ab, cp);
    d6 = dot(ac, cp);
    if d6 >= 0.0 && d5 <= d6 {
        return c;
    }
    vc = d1 * d4 - d3 * d2;
    if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
        v_ab = d1 / (d1 - d3);
        return a + ab * v_ab;
    }
    vb = d5 * d2 - d1 * d6;
    if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
        v_ac = d2 / (d2 - d6);
        return a + ac * v_ac;
    }
    va = d3 * d6 - d5 * d4;
    if va <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0 {
        v_bc = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + (c - b) * v_bc;
    }
    denom = 1.0 / (va + vb + vc);
    v = vb * denom;
    w = vc * denom;
    return a + ab * v + ac * w;
}

func distmin(q : Point, tri : Triangle) -> Float {
    diff = q.p - closest_point_embree(q, tri);
    d = sqrt(dot(diff, diff));
    return d * d;
}

// Embree: what rtcIntersect1 leaves in its RTCRayHit for the nearest hit --
// `ray.tfar` the hit's t, `hit.u` and `hit.v` its barycentrics, `hit.Ng` the
// triangle's unnormalized normal (`cross(e2, e1)`, the one the test used),
// and `hit.primID` (with `geomID` and `instID`, one geometry and no
// instances here). MoellerTrumboreHitM::finalize makes t, u and v from the
// test's T, U and V by one reciprocal of absDen, in the leaf, for each hit
// nearer than the ray's best so far; the record is made here once per ray,
// for the triangle the argmin settled on, by the same test run once more
// over that one triangle -- the last finalize's work, the earlier ones (a
// hit later beaten) not repeated.
element Hit {
    primID : u32;
    t, u, v : Float;
    ng : vec3f;
}

func hit_record(r : Ray, tri : Triangle) -> Hit {
    h = intersectsp_ray_tri(r, tri);
    if h {
        e = *h;
        return Hit{tri.primID, e.t, e.u, e.v, cross(tri.e2, tri.e1)};
    }
    return no_hit();
}

// Embree: a miss leaves `geomID` at RTC_INVALID_GEOMETRY_ID and the rest
// untouched.
func no_hit() -> Hit = Hit{4294967295u, inf, 0.0, 0.0, vec3f{0.0, 0.0, 0.0}};

// Embree: what the closest-point tutorial's callback records -- the
// triangle, the closest point on it (closestPointTriangle) and the distance
// to it (`d = distance(q, p)`). The callback makes both for every triangle
// the traversal hands it and keeps the nearest; here they are made once,
// for the triangle the argmin found, by the same routine.
element ClosestHit {
    primID : u32;
    d : Float;
    p : vec3f;
}

func closest_record(q : Point, tri : Triangle) -> ClosestHit {
    p = closest_point_embree(q, tri);
    diff = q.p - p;
    return ClosestHit{tri.primID, sqrt(dot(diff, diff)), p};
}

func no_closest() -> ClosestHit = ClosestHit{4294967295u, inf, vec3f{0.0, 0.0, 0.0}};
