schedule {
    tree[[Triangle]] BVH(low high : f32x3) with AABB(low, high) 
      = Interior(left : BVH, right : BVH, ll lr hl hr: f32x3)
      | Leaf(nprims: u16, data : array[Triangle, nprims]);

    triangles : BVH;

    layout triangles(index: u32) {
        primitive_count : u32;
        primitives : array[Triangle, primitive_count];
        node_count : u32;
        group nodes[size=node_count, align=32] by index {
            low : f32x3;
            high : f32x3;
            nprims : u16;
            16; // axis, technically
            split nprims {
                0 -> Interior { 
                    ll = this[left].low;
                    lr = this[right].low;
                    hl = this[left].high;
                    hr = this[right].high;
                    offset : u32; 
                    left = index + 1; 
                    right = index + offset; 
                };
                _ -> Leaf { 
                    poffset : u32; 
                    data = primitives[poffset : poffset + nprims]; 
                };
            };
        };
    };

    build triangles {
      build Interior(low: f32x3, high: f32x3, left: BVH, right: BVH) {
        build low;
        build high;
        build nprims = 0;
        recurse left;
        recurse right;
        build offset = right - this;
        return this;
      };
      build Leaf(low: f32x3, high: f32x3, nprims: u16, data: array[Triangle, nprims]) {
        build low; 
        build high;
        build nprims;
        build poffset = append(data, nprims);
        return this;
      };
    };
