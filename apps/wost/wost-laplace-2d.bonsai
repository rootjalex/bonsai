import stdlib/ray;

// Implementation code for the WoSt primer [1].
// [1] https://github.com/GeometryCollective/wost-simple/blob/main/code/WoStLaplace2D.cpp

// TODO(cgyurgyik): They use f64, but casting every literal is annoying.
element vec2 = vector[f32, 2];
element polyline = array[vec2];

func clamp<T>(input: T, lo: T, hi: T) -> T {
    return max(min(input, hi), lo);
}

func length(u: vec2) {
    return sqrt(norm(u));
}

// returns the closest point to x on a segment with endpoints a and b.
func closest_point(x: vec2, a: vec2, b: vec2) -> vec2 {
    u: vec2 = b - a;

    t1: f32 = dot(x - a, u);
    t2: f32 = dot(u, u);
    t: f32 = clamp[[f32]](t1 / t2, 0.0, 1.0);
    return (1.0 - t) * a + (t * b);
}

// returns true if the point b on the polyline abc is a silhoutte relative to x
func is_silhouette( x: vec2, a: vec2, b: vec2, c: vec2) -> bool {
    return (cross(b-a, x-a) * cross(c-b, x-b)) < 0;
}

// returns the time t at which the ray x+tv intersects segment ab,
// or infinity if there is no intersection.
func ray_intersection( x: vec2, v: vec2, a: vec2, b: vec2) {
    u: vec2 = b - a;
    w: vec2 = x - a;
    d: f32 = cross(v, u);
    s: f32 = cross(v, w) / d;
    t: f32 = cross(u, w) / d;
    if (t > 0.0 && 0.0 <= s && s <= 1.0) {
        return t;
    }
    return inf;
}

