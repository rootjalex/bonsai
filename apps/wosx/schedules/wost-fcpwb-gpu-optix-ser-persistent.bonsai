// wost-fcpwb-gpu-optix-ser.bonsai with the persistent claim: the walk on
// stars' matching kernel shape -- 131072 workers claiming one walk at a
// time from a counter -- run as one ray-generation launch of that many
// threads (`bind(t, OptixThread)` on the workers' loop) with the walks
// reordered at every step by the cell of the box they stand in
// (walk_keys.bonsai; the sort on the walk's recursive call, written first
// since a function's sorts come before its other directives). On the head
// the plain launch of this walk runs at WoSX's rate where the persistent
// claim runs 1.65x of it -- a walk on stars is long (78 steps on the head)
// with a long tail, and a warp of the plain launch lives as long as its
// longest walk -- and the reordering lifted the plain OptiX launch from
// 0.94x to 1.21x (10-28); this asks whether the two gains add. The
// traversals are kernel/wost_fcpwb.bonsai's written out over the same
// layout, as wost-fcpwb-gpu-optix-ser.bonsai has them.
import apps/wosx/schedules/layouts/fcpw_stars_gpu;
import apps/wosx/walk_keys;

schedule {
    walk_stars.sort(walk_stars,
                    |x : vec3f, problem : StarProblem| walk_sort_key(x, problem.lo, problem.hi));
    walk_stars.loopify();

    closest_absorbing.sort(absorbing.Interior,
                           |i : u32, s : Sphere, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                           distmin(s, AABB{lo[i], hi[i]}))
                     .unroll(absorbing.Interior.children)
                     .loopify(64);
    closest_absorbing.skip(closest_point_fcpw);
    hit_reflecting.sort(reflecting.Interior,
                        |i : u32, r : Ray, lo : vector[vec3f, 2], hi : vector[vec3f, 2],
                         axis : vector[vec3f, 2], half_angle : vector[f32, 2],
                         radius : vector[f32, 2]|
                        distmin(r, AABB{lo[i], hi[i]}))
                  .unroll(reflecting.Interior.children)
                  .loopify(64);
    closest_silhouette.sort(silhouettes.Interior,
                            |i : u32, q : SilhouetteQuery, lo : vector[vec3f, 2], hi : vector[vec3f, 2],
                             axis : vector[vec3f, 2], half_angle : vector[f32, 2],
                             radius : vector[f32, 2]|
                            distmin(q, ConeBox{lo[i], hi[i], axis[i], half_angle[i], radius[i]}))
                      .unroll(silhouettes.Interior.children)
                      .loopify(64);

    solve_stars.reorder(i, w);
    solve_stars.collapse(w, i, k);
    solve_stars.persistent(k, t, 131072);
    solve_stars.bind(t, OptixThread);
}
