// fcpwb-gpu-optix.bonsai with the persistent claim: the matching schedule's
// 131072 workers claiming a walk at a time from a counter, the workers' loop
// bound to OptiX's ray-generation launch, no reordering. Against the
// matching CUDA schedule (fcpwb-gpu) this measures the OptiX launch of the
// same code with the same warps -- a warp's 32 claims are the same 32
// neighbouring walks on both, whatever OptiX makes of a launch index -- so
// what is left between them is OptiX's compilation of the kernel, not the
// launch's thread mapping (the profile of 2026-10-28: the plain OptiX launch
// at 0.75x of the CUDA launch, 67 registers against 50, 2.43 lanes active
// per warp instruction against 2.96). Against fcpwb-gpu-optix-ser-persistent
// it is the reordering's control.
import apps/wosx/schedules/kernel/fcpwb;

schedule {
    solve_all.reorder(i, w);
    solve_all.collapse(w, i, k);
    solve_all.persistent(k, t, 131072);
    solve_all.bind(t, OptixThread);
}
