// FCPW's binary BVH -- the tree of layouts/fcpwb.bonsai -- in another
// layout of its interior nodes, kept as a variant to measure against that
// one: each interior node's row holds its two children's boxes and rows,
// so that a visit reads one row where FCPW's layout reads the node's and
// its two children's (three rows of 32 bytes). The same tree -- FCPW's
// build, its splits, its leaves, its primitive order -- the same
// traversal order (the node bounds its children, as fcpwb's does through
// its reads of the children's rows), the same triangles (FCPW's GPU rows,
// as fcpwb's), the bytes of the nodes the one difference: 56 a row, the
// two boxes component by component (two floats each, as FCPW's own
// four-wide MbvhNode holds its four) then the two children's rows, built
// by the driver (fcpw_bvh2.h) from FCPW's rows at copy time. A leaf row is
// FCPW's Mbvh convention, a negative first slot `-(first + 1)` and the
// count in the second.
schedule {
    tree[[Triangle]] BVH2 =
    | Interior(children : array[BVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;

    triangles : BVH2;

    layout triangles {
        // FCPW: GPUTriangle, one row a triangle, as layouts/fcpwb.bonsai.
        pCount : u32;
        indirect group prims[pCount] {
            group[1] {
                pa : vec3f;
                pb : vec3f;
                pc : vec3f;
                primitiveIndex : u32;
                v0 = pa;
                e1 = pa - pb;
                e2 = pc - pa;
                geomID = 0u;
                primID = primitiveIndex;
            };
        };
        // The nodes, the root at row 0, each interior row holding its two
        // children's boxes and rows.
        nNodes : u32;
        group[nNodes] index : u32 {
            boxMin_x : vector[f32, 2];
            boxMin_y : vector[f32, 2];
            boxMin_z : vector[f32, 2];
            boxMax_x : vector[f32, 2];
            boxMax_y : vector[f32, 2];
            boxMax_z : vector[f32, 2];
            child0 : i32;
            child1 : i32;
            kind = child0[31:31];
            switch kind {
                0 => Interior {
                    children = vector[u32, 2]{cast[[u32]](child0), cast[[u32]](child1)};
                    lo = vector[vec3f, 2]{boxMin_x, boxMin_y, boxMin_z};
                    hi = vector[vec3f, 2]{boxMax_x, boxMax_y, boxMax_z};
                };
                _ => Leaf {
                    data = range(prims, cast[[u32]](0 - child0 - 1), cast[[u32]](child1));
                };
            };
        };
    };
}
