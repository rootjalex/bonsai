// The walk on stars' three sets in the bytes FCPW's CPU reads, for the CPU
// comparison against WoSX on WoSX's default trees (FCPW_USE_ENOKI off,
// FCPW's scalar binary BVHs): FCPW's own arrays, wrapped where they lie by
// the driver (apps/wosx/fcpw_stars_trees.h, wrap_absorbing and
// rtq_snch::wrap_snch, built without WOSX_GPU), nothing copied.
// fcpw_stars_gpu.bonsai is the same three sets in the rows FCPW's GPU
// reads, for the GPU schedules.
//
// The absorbing boundary's triangles are the walk on spheres' tree as
// apps/rtq/schedules/layouts/fcpwb.bonsai reads it: FCPW's BvhNode rows, its
// primitive pointer array, its Triangle objects reached by address (a `ptr
// group`) and the polygon soup's positions, the tile storing the pointer
// and deriving the corners through the object's indices as FCPW's leaf
// gathers them. The reflecting boundary is one FCPW tree with normal cones
// (fcpw::Bvh<3, SnchNode<3>, Triangle, SilhouetteEdge>), read as two trees
// over its one node array as apps/rtq/schedules/layouts/fcpws.bonsai reads
// it: the triangles the rays stop at and the silhouette edges the star
// radius is found among, each leaf referencing its range of both; the
// SnchNode row in FCPW's CPU field order; the edge tile storing the
// SilhouetteEdge pointer and deriving the ends and -- for the two-face case
// alone, where FCPW's SilhouetteEdge::normal computes them -- the two unit
// face normals from the positions, Eigen's cross and guarded normalize. A
// program's group names are one namespace, so each layout's groups carry
// the set's letter.
//
// The node's cone is the children's to test, as the box is: the parent
// holds its children's boxes and cones logically, read out of the
// children's own rows (fcpwb.bonsai says why), and the tree's bounding
// element is apps/rtq's ConeBox (elements.bonsai), whose metrics do FCPW's
// cone test for the silhouette query and the box test alone for the rays
// (metrics/fcpw_scalar.bonsai).
schedule {
    tree[[Triangle]] ABVH2 =
    | Interior(children : array[ABVH2, 2], lo hi : vector[vec3f, 2])
        with AABB(lo, hi) on children
    | Leaf(data : array[Triangle]) with data = data;
    absorbing : ABVH2;

    layout absorbing {
        // FCPW: PolygonSoup::positions, 12 bytes each.
        avCount : u32;
        indirect group apositions[avCount] {
            p : vec3f;
        };
        // FCPW: the Triangle objects, 32 bytes each, by address.
        aoCount : u32;
        ptr group aobjects[aoCount] {
            vptr : u64;
            i0 : i32;
            i1 : i32;
            i2 : i32;
            pIndex : i32;
            soup : u64;
        };
        // FCPW: Bvh::primitives, a Triangle* per reference.
        aCount : u32;
        indirect group aprims[aCount] {
            group[1] {
                tri : u64;
                t = aobjects[tri];
                pa = apositions[t.i0].p;
                pb = apositions[t.i1].p;
                pc = apositions[t.i2].p;
                v0 = pa;
                e1 = pa - pb;
                e2 = pc - pa;
                geomID = 0u;
                primID = cast[[u32]](t.pIndex);
            };
        };
        // FCPW: BvhNode<3>.
        aNodes : u32;
        group[aNodes] anode : u32 {
            low : vec3f;
            high : vec3f;
            offset : i32;
            nReferences : i32;
            switch nReferences {
                0 => Interior {
                    left = anode + 1u;
                    right = anode + cast[[u32]](offset);
                    children = vector[u32, 2]{left, right};
                    lo = vector[vec3f, 2]{vector[f32, 2]{this[left].low.x, this[right].low.x},
                                          vector[f32, 2]{this[left].low.y, this[right].low.y},
                                          vector[f32, 2]{this[left].low.z, this[right].low.z}};
                    hi = vector[vec3f, 2]{vector[f32, 2]{this[left].high.x, this[right].high.x},
                                          vector[f32, 2]{this[left].high.y, this[right].high.y},
                                          vector[f32, 2]{this[left].high.z, this[right].high.z}};
                };
                _ => Leaf {
                    data = range(aprims, cast[[u32]](offset), cast[[u32]](nReferences));
                };
            };
        };
    };

    // The reflecting boundary's triangles over the normal cone hierarchy.
    tree[[Triangle]] SNCH =
    | Interior(children : array[SNCH, 2], lo hi axis : vector[vec3f, 2],
               half_angle radius : vector[f32, 2])
        with ConeBox(lo, hi, axis, half_angle, radius) on children
    | Leaf(data : array[Triangle]) with data = data;
    reflecting : SNCH;

    layout reflecting {
        rvCount : u32;
        indirect group rpositions[rvCount] {
            p : vec3f;
        };
        roCount : u32;
        ptr group robjects[roCount] {
            vptr : u64;
            i0 : i32;
            i1 : i32;
            i2 : i32;
            pIndex : i32;
            soup : u64;
        };
        rCount : u32;
        indirect group rprims[rCount] {
            group[1] {
                tri : u64;
                t = robjects[tri];
                pa = rpositions[t.i0].p;
                pb = rpositions[t.i1].p;
                pc = rpositions[t.i2].p;
                v0 = pa;
                e1 = pa - pb;
                e2 = pc - pa;
                geomID = 0u;
                primID = cast[[u32]](t.pIndex);
            };
        };
        // FCPW: SnchNode<3>, in its CPU field order.
        rNodes : u32;
        group[rNodes] rnode : u32 {
            low : vec3f;
            high : vec3f;
            cone_axis : vec3f;
            cone_half_angle : f32;
            cone_radius : f32;
            offset : i32;
            silhouetteOffset : i32;
            nReferences : i32;
            nSilhouettes : i32;
            switch nReferences {
                0 => Interior {
                    left = rnode + 1u;
                    right = rnode + cast[[u32]](offset);
                    children = vector[u32, 2]{left, right};
                    lo = vector[vec3f, 2]{vector[f32, 2]{this[left].low.x, this[right].low.x},
                                          vector[f32, 2]{this[left].low.y, this[right].low.y},
                                          vector[f32, 2]{this[left].low.z, this[right].low.z}};
                    hi = vector[vec3f, 2]{vector[f32, 2]{this[left].high.x, this[right].high.x},
                                          vector[f32, 2]{this[left].high.y, this[right].high.y},
                                          vector[f32, 2]{this[left].high.z, this[right].high.z}};
                    axis = vector[vec3f, 2]{vector[f32, 2]{this[left].cone_axis.x, this[right].cone_axis.x},
                                            vector[f32, 2]{this[left].cone_axis.y, this[right].cone_axis.y},
                                            vector[f32, 2]{this[left].cone_axis.z, this[right].cone_axis.z}};
                    half_angle = vector[f32, 2]{this[left].cone_half_angle, this[right].cone_half_angle};
                    radius = vector[f32, 2]{this[left].cone_radius, this[right].cone_radius};
                };
                _ => Leaf {
                    data = range(rprims, cast[[u32]](offset), cast[[u32]](nReferences));
                };
            };
        };
    };

    // The reflecting boundary's silhouette edges over the same nodes.
    tree[[Edge]] SNCHE =
    | Interior(children : array[SNCHE, 2], lo hi axis : vector[vec3f, 2],
               half_angle radius : vector[f32, 2])
        with ConeBox(lo, hi, axis, half_angle, radius) on children
    | Leaf(data : array[Edge]) with data = data;
    silhouettes : SNCHE;

    layout silhouettes {
        // FCPW: PolygonSoup::positions again, the reflecting soup's.
        evCount : u32;
        indirect group epositions[evCount] {
            p : vec3f;
        };
        // FCPW: the SilhouetteEdge objects, 40 bytes each, by address.
        eoCount : u32;
        ptr group edge_objects[eoCount] {
            vptr : u64;
            i0 : i32;
            i1 : i32;
            i2 : i32;
            i3 : i32;
            pIndex : i32;
            32;
            soup : u64;
        };
        // FCPW: Bvh::silhouetteRefs, a SilhouetteEdge* per reference.
        eCount : u32;
        indirect group edges[eCount] {
            group[1] {
                edge : u64;
                e = edge_objects[edge];
                pa = epositions[e.i1].p;
                pb = epositions[e.i2].p;
                index = cast[[u32]](e.pIndex);
                one_face = select(e.i3 == -1 || e.i0 == -1, 1u, 0u);
                // FCPW: SilhouetteEdge::normal(0) and normal(1), as
                // apps/rtq/schedules/layouts/fcpws.bonsai derives them. Read
                // only where one_face is 0.
                c3 = epositions[e.i3].p;
                c0 = epositions[e.i0].p;
                u0 = pb - pa;
                w0 = c3 - pa;
                x0 = vec3f{u0.y * w0.z - u0.z * w0.y, u0.z * w0.x - u0.x * w0.z, u0.x * w0.y - u0.y * w0.x};
                z0 = fma(x0.x, x0.x, fma(x0.y, x0.y, x0.z * x0.z));
                n0 = select(z0 > 0.0, x0 / sqrt(z0), x0);
                u1 = pa - pb;
                w1 = c0 - pb;
                x1 = vec3f{u1.y * w1.z - u1.z * w1.y, u1.z * w1.x - u1.x * w1.z, u1.x * w1.y - u1.y * w1.x};
                z1 = fma(x1.x, x1.x, fma(x1.y, x1.y, x1.z * x1.z));
                n1 = select(z1 > 0.0, x1 / sqrt(z1), x1);
            };
        };
        sNodes : u32;
        group[sNodes] snode : u32 {
            low : vec3f;
            high : vec3f;
            cone_axis : vec3f;
            cone_half_angle : f32;
            cone_radius : f32;
            offset : i32;
            silhouetteOffset : i32;
            nReferences : i32;
            nSilhouettes : i32;
            switch nReferences {
                0 => Interior {
                    left = snode + 1u;
                    right = snode + cast[[u32]](offset);
                    children = vector[u32, 2]{left, right};
                    lo = vector[vec3f, 2]{vector[f32, 2]{this[left].low.x, this[right].low.x},
                                          vector[f32, 2]{this[left].low.y, this[right].low.y},
                                          vector[f32, 2]{this[left].low.z, this[right].low.z}};
                    hi = vector[vec3f, 2]{vector[f32, 2]{this[left].high.x, this[right].high.x},
                                          vector[f32, 2]{this[left].high.y, this[right].high.y},
                                          vector[f32, 2]{this[left].high.z, this[right].high.z}};
                    axis = vector[vec3f, 2]{vector[f32, 2]{this[left].cone_axis.x, this[right].cone_axis.x},
                                            vector[f32, 2]{this[left].cone_axis.y, this[right].cone_axis.y},
                                            vector[f32, 2]{this[left].cone_axis.z, this[right].cone_axis.z}};
                    half_angle = vector[f32, 2]{this[left].cone_half_angle, this[right].cone_half_angle};
                    radius = vector[f32, 2]{this[left].cone_radius, this[right].cone_radius};
                };
                _ => Leaf {
                    data = range(edges, cast[[u32]](silhouetteOffset), cast[[u32]](nSilhouettes));
                };
            };
        };
    };
}
