// wost-fcpwb-gpu-parallel.bonsai with the walk fastest and blocks of 64: one
// flat launch, a thread per (walk, point) pair, the pairs numbered with the
// walk fastest so that a block is two warps of ONE point's walks, and
// blocks of 64 rather than 256 so that a mesh of few points still reaches
// every multiprocessor -- fcpwb-gpu-parallel-reorder-blk64.bonsai's
// directives on the walk on stars.
import apps/wosx/schedules/kernel/wost_fcpwb;

schedule {
    solve_stars.reorder(i, w);
    solve_stars.reorder(w, i);
    solve_stars.collapse(i, w, k);
    solve_stars.split(k, k_blk, k_thr, 64, true);
    solve_stars.bind(k_blk, GPUBlock);
    solve_stars.bind(k_thr, GPUThread);
}
