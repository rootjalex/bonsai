// FCPW's binary BVH walked as FCPW walks it: the walk a loop, the
// closest-point traversal on a stack of FCPW's depth with the two children
// tested at their parent and the nearer entered first
// (layouts/fcpwb2.bonsai, where the node holds its children's boxes), the
// leaf's Voronoi arms skipped where the point is not in them -- the
// traversal of WoSX's CPU solver as shipped, one thread against one thread
// here, in FCPW's CPU order (fcpwb.bonsai says the rule: d2Min, the far
// corners where both children contain the point, the left child on a tie).
// Nothing is vectorized: FCPW's scalar traversal tests one box and one
// triangle at a time, and so does this. Beside layouts/fcpwb.bonsai's
// schedule (fcpwb.bonsai) this measures what the layout is worth on the
// binary tree; the GPU schedule over this layout (fcpwb2-gpu.bonsai) takes
// its traversal from kernel/fcpwb2.bonsai, the GPU kernel's order.
import apps/wosx/schedules/layouts/fcpwb2;

schedule {
    walk.loopify();
    closest_within.sort(triangles.Interior,
                        |i : u32, s : Sphere, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                        select(distmin(s, AABB{lo[0u], hi[0u]}) == 0.0 &&
                               distmin(s, AABB{lo[1u], hi[1u]}) == 0.0,
                               distmax(s, AABB{lo[i], hi[i]}),
                               distmin(s, AABB{lo[i], hi[i]})))
                  .unroll(triangles.Interior.children)
                  .loopify(64);
    closest_within.skip(closest_point_fcpw);
}
