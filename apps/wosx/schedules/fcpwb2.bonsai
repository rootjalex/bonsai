// FCPW's binary BVH walked as FCPW walks it: the walk a loop, the
// closest-point traversal on a stack of FCPW's depth with the two children
// tested at their parent and the nearer entered first
// (layouts/fcpwb2.bonsai, where the node holds its children's boxes), the
// leaf's Voronoi arms skipped where the point is not in them -- the
// traversal of WoSX's GPU solver and of its CPU solver as shipped, one
// thread against one thread here. Nothing is vectorized: FCPW's scalar
// traversal tests one box and one triangle at a time, and so does this.
// Beside layouts/fcpwb.bonsai's schedule (fcpwb.bonsai) this measures what
// the nearest-first order is worth on the binary tree; the GPU schedules
// (fcpwb2-gpu*.bonsai) import this one.
import apps/wosx/schedules/layouts/fcpwb2;

schedule {
    walk.loopify();
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .loopify(64);
    closest.skip(closest_point_fcpw);
}
