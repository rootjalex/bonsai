// fcpwb-packet-defer-sort-threads.bonsai with gangs of eight: the sorted
// chunk's drain in gangs of eight lanes rather than sixteen. The lane
// counts of 10-29 put four lanes of sixteen live at a node pass of the
// sorted drain on the head (2.4 on the rover) and two and a half at a
// triangle test: a gang of eight drawn from the same sorted queue holds
// the same four, half full where sixteen was a quarter, for twice the
// passes per round -- each pass a 256-bit instruction where sixteen
// lanes' was 512. Whether the fuller gang or the halved width wins is what
// this measures; the schedule is otherwise the sorted chunk's (the
// fifteen-bit key, chunks of sixty-four points).
import apps/rtq/schedules/layouts/fcpwb;
import apps/wosx/walk_keys;

schedule {
    walk.sort(walk, |x : vec3f, problem : Problem| walk_sort_key(x, problem.lo, problem.hi));
    solve_all.split(i, i_chunk, i_in, 64, true);
    solve_all.reorder(i_in, w);
    solve_all.reorder(w, i_in);
    steps = solve_all.queue(i_chunk);
    solve_all.defer(walk, steps);
    walk.defer(walk, steps);
    solve_all.split(steps, steps_gang, steps_lane, 8, true)
             .vectorize(steps_lane);
    closest_within.sort(triangles.Interior,
                        |i : u32, s : Sphere, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                        select(distmin(s, AABB{lo[0u], hi[0u]}) == 0.0 &&
                               distmin(s, AABB{lo[1u], hi[1u]}) == 0.0,
                               distmax(s, AABB{lo[i], hi[i]}),
                               distmin(s, AABB{lo[i], hi[i]})))
                  .loopify(64);
    closest_within.skip(closest_point_fcpw);
    solve_all.bind(i_chunk, CPUThread);
}
