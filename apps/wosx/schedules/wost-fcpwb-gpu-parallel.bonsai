// wost-fcpwb-gpu.bonsai without the persistent workers: every (walk, point)
// pair is a thread of one launch, in blocks of 256, the hardware's own
// block scheduler handing the blocks to the multiprocessors as earlier
// ones finish -- fcpwb-gpu-parallel.bonsai's directives on the walk on
// stars, whose step is three traversals where the walk on spheres' is one.
// Against wost-fcpwb-gpu it measures what the persistent claim is worth on
// this walk: a warp of the plain launch lives as long as its longest walk,
// its finished lanes idle, where a persistent worker's finished lane
// claims the next walk at once.
import apps/wosx/schedules/kernel/wost_fcpwb;

schedule {
    solve_stars.reorder(i, w);
    solve_stars.collapse(w, i, k);
    solve_stars.split(k, k_blk, k_thr, 256, true);
    solve_stars.bind(k_blk, GPUBlock);
    solve_stars.bind(k_thr, GPUThread);
}
