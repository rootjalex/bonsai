// The packet schedule over the points on WoSX's default tree: FCPW's
// scalar binary BVH in FCPW's bytes (layouts/fcpwb.bonsai), the sample
// points split by 32 and vectorized with each lane's walks a loop inside --
// a gang of neighbouring points, whose first queries are neighbours on the
// slice -- then the closest-point traversal sorted and put on a stack, the
// gang sharing one node, the two children ordered by the majority of the
// lanes' distances to their boxes, each child entered by the lanes whose
// query reaches its box. Single-threaded, pinned, as fcpwb is run.
import apps/wosx/schedules/layouts/fcpwb;

schedule {
    walk.loopify();
    solve_all.split(i, i_gang, i_lane, 32, true)
             .vectorize(i_lane);
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .loopify(64);
    closest.skip(closest_point_fcpw);
}
