// The packet schedule over WoSX's default tree: FCPW's scalar binary BVH
// in FCPW's bytes (layouts/fcpwb.bonsai), a point's walks split by 32 and
// vectorized, then the closest-point traversal sorted and put on a stack --
// one node for the gang, the two children ordered by the majority of the
// lanes' distances to their boxes (the boxes read from the children's
// rows, as the layout says), each child entered by the lanes whose query
// reaches its box, one stack of nodes, per-lane bounds and masks.
// Single-threaded, pinned, as fcpwb is run.
import apps/wosx/schedules/layouts/fcpwb;

schedule {
    walk.loopify();
    solve_all.split(w, w_gang, w_lane, 32, true)
             .vectorize(w_lane);
    closest.sort(triangles.Interior,
                 |i : u32, q : Point, lo : vector[vec3f, 2], hi : vector[vec3f, 2]|
                 distmin(q, AABB{lo[i], hi[i]}))
           .loopify(64);
    closest.skip(closest_point_fcpw);
}
