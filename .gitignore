# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

build
build-dbg
cmake-build-*
.idea
.vscode
venv

# Assembly files
*.asm
*.s
*.ll
*.bir
# A test's hand-written LLVM IR input is source, not output
!tests/**/*.ll

# Build dependencies
deps/llvm-build
deps/llvm-install
# Embree, built from the deps/embree submodule by apps/rtq/build_embree.sh.
deps/embree-build
deps/embree-install
# One LLVM per branch that pins a different release: deps/llvm-build-23,
# deps/llvm-install-23, and the bonsai build against it, build-23.
deps/llvm-build-*
deps/llvm-install-*
build-*

# Images produced from RTIOW
*.ppm

# MacOS debug symbol files
*.dSYM/

.DS_Store

# Generates header/source files
apps/queries/*/*_gen.cpp
apps/queries/*/*_gen.h
apps/queries/*/*.out

# Ignore all *_gen.h and *_gen.cpp files anywhere under apps/
apps/**/*_gen.h
apps/**/*_gen.cpp

# Where apps/rtiow/cpu/compare.sh puts the two builds and their images.
apps/rtiow/cpu/compare-out/

# Where apps/pbrt/compare.sh puts pbrt's reference render and ours. WORK can
# name another directory, which is how comparing several scenes at once keeps
# their outputs apart.
apps/pbrt/compare-out*/
apps/pbrt/bench-out/
eval/out/
eval/plots/

# What apps/pbrt/render.sh leaves beside the source, and what Python leaves
# beside its scripts. scene_dump is built on demand from PBRT's own build tree
# rather than checked in, and scene.txt is what it writes.
apps/pbrt/*.pfm
apps/pbrt/*.png
apps/pbrt/scene_dump
apps/pbrt/scene.txt
apps/pbrt/__pycache__/
eval/__pycache__/

# The headers the C++ backend emits alongside a .o, which the drivers include.
# Generated, so not committed: the scripts that build a driver compile the
# .bonsai first, and what comes out is by definition current. A committed copy
# could only ever drift from what the compiler actually produces.
apps/pbrt/render.h
# flatc's output from apps/pbrt/scene_geometry.fbs (scene_schema.sh).
apps/pbrt/scene_geometry_generated.h
apps/rtiow/cpu/main.h
apps/rtq/rtq.h
# compare.sh's driver objects, compiled once per header within a run and
# removed at its end; left behind only by a run that was killed.
apps/rtq/.rtq_hook-*.o
# The same for apps/wosx: its generated header and objects, left beside the
# source only while compare.sh runs, and the slices the driver draws.
apps/wosx/wosx.h
apps/wosx/.wosx_hook-*.o
apps/wosx/*.ppm

*.csv

# Ignore all .txt files...
*.txt
# ...but keep CMakeLists.txt files
!**/CMakeLists.txt

*.db
*.log

# Each app's scratch directory: an agent's probe scripts, logs and pinned
# worktrees, kept beside the app so a reboot does not take them with /tmp.
apps/*/scratch/
compare-out*

# apps/rtq's measured results and the plots drawn from them (plot.py): data,
# regenerated by the benchmark, kept out of the build directories.
apps/rtq/results/
apps/rtq/plots/
# apps/wosx's likewise (benchmark.sh): the logs, the CSV, the unzipped mesh.
apps/wosx/results/
